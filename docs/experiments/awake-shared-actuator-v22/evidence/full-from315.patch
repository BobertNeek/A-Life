+/// Ephemeral provenance for actual voluntary actuator time, never inferred
+/// from rounded final world-coordinate subtraction.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum VoluntaryTimeProvenance {
+    #[default]
+    NoTranslation,
+    InitialPreemption,
+    FullInterval,
+    GoalArrival,
+    ZeroSpeed,
+    BlockedAttempt,
+    SweptContact,
+}
