diff --git a/crates/alife_training/tests/cpu_collector/shared_actuator.rs b/crates/alife_training/tests/cpu_collector/shared_actuator.rs
index 068fb8d3..9f7e8112 100644
--- a/crates/alife_training/tests/cpu_collector/shared_actuator.rs
+++ b/crates/alife_training/tests/cpu_collector/shared_actuator.rs
