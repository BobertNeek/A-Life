+// Fixed two-object scene. These are raw sensor descriptors, not food/toy labels.
+fn coordination_fixture(confidence: f32) -> CoordinatedTargetScoresV1 {
+    let p = phenotype();
+    let f = frame(&specs());
+    let mut candidates = f.candidates().to_vec();
+    let mut slots = Vec::new();
+    for (index, distance) in [0.0625_f32, 0.375].into_iter().enumerate() {
+        let slot = GroundedObjectSlotV1 {
+            slot_index: index as u16,
+            tracked_object_id: TrackedObjectId(index as u64 + 1),
+            bearing: [0., 1.],
+            distance,
+            relative_velocity: [0.; 3],
+            color: [0.5; 3],
+            material: [0.5; 3],
+            shape: [0.5; 3],
+            chemical: [0.; 3],
+            contact: 0.,
+            proprioception: [0.; 2],
+            temperature: 0.,
+            terrain: [0.; 2],
+            confidence: Confidence::new(confidence).unwrap(),
+        };
+        for (id, kind, family) in [
+            (100, ActionKind::Move, CandidateActionFamily::Approach),
+            (101, ActionKind::Move, CandidateActionFamily::Avoid),
+            (210, ActionKind::Interact, CandidateActionFamily::Ingest),
+            (211, ActionKind::Interact, CandidateActionFamily::Contact),
+            (213, ActionKind::Interact, CandidateActionFamily::Other),
+        ] {
+            candidates.push(
+                ActionCandidate::new(
+                    candidates.len() as u16,
+                    ActionId(id),
+                    kind,
+                    family,
+                    CandidateObservationRef::ObjectSlot(index as u16),
+                    ActionTarget::new(
+                        Some(WorldEntityId(index as u64 + 100)),
+                        Some(Vec3f::new(distance * 8., 0., 0.)),
+                    ),
+                    slot.candidate_features().unwrap(),
+                    slot.confidence,
+                    NormalizedScalar::ZERO,
+                    DurationTicks::new(1),
+                    DurationTicks::new(1),
+                )
+                .unwrap(),
+            );
+        }
+        slots.push(slot);
+    }
+    let f = PerceptionFrame::new(
+        f.organism_id(),
+        f.tick(),
+        f.sensor_profile(),
+        f.sensory().clone(),
+        f.body(),
+        *f.homeostasis(),
+        candidates,
+        SensorProfileProvenance::new(f.sensor_profile(), SensoryAbiVersion::CURRENT, f.tick())
+            .unwrap(),
+        slots,
+    )
+    .unwrap();
+    let n = native(&p, &f);
+    CoordinatedTargetScoresV1::bind(&p, &f, &n, synthetic_source(&p, &f, false)).unwrap()
+}
+fn weighted_distribution(
+    s: &CoordinatedTargetScoresV1,
+    t: f64,
+    weights: [f64; 3],
+) -> (
+    CoordinatedTargetFactorV1,
+    Vec<CoordinationPairFactorV1>,
+    [f64; 3],
+) {
+    let mut n = s.native();
+    n.binding.eligible_mask = s.eligible_mask;
+    let base = n.probabilities(t).unwrap();
+    let mut r = CoordinatedTargetFactorV1::from_native(base.representative);
+    let channels = base
+        .channels
+        .map(|x| x.map(CoordinatedTargetFactorV1::from_native));
+    let (pairs, mean) = s.coordinate(&mut r, &channels, t, weights).unwrap();
+    (r, pairs, mean)
+}
+#[test]
+fn coordination_joint_normalizes_and_exact_gradient_matches_finite_difference() {
+    let s = coordination_fixture(1.);
+    let t = 0.73;
+    let (r, pairs, mean) = weighted_distribution(&s, t, COORDINATION_WEIGHTS_V1);
+    let mut total = 0.;
+    for (ri, pair) in pairs.iter().enumerate() {
+        assert!((pair.probabilities.iter().sum::<f64>() - 1.).abs() < 1e-12);
+        for (pi, p) in pair.probabilities.iter().enumerate() {
+            assert!(*p > 0.);
+            total += r.probabilities[ri] * p;
+            for parameter in 0..3 {
+                let mut plus = COORDINATION_WEIGHTS_V1;
+                let mut minus = plus;
+                plus[parameter] += 1e-5;
+                minus[parameter] -= 1e-5;
+                let (pr, pp, _) = weighted_distribution(&s, t, plus);
+                let (mr, mp, _) = weighted_distribution(&s, t, minus);
+                let numeric = (pr.log_probabilities[ri] + pp[ri].log_probabilities[pi]
+                    - mr.log_probabilities[ri]
+                    - mp[ri].log_probabilities[pi])
+                    / 2e-5;
+                let exact = (pair.features[pi][parameter] - mean[parameter]) / t;
+                assert!(
+                    (numeric - exact).abs() < 1e-8,
+                    "numeric {numeric}, exact {exact}"
+                );
+            }
+        }
+    }
+    assert!((total - 1.).abs() < 1e-12);
+}
+#[test]
+fn coordination_zero_weights_recovers_base_and_uncertainty_preserves_support() {
+    for confidence in [0., 1.] {
+        let s = coordination_fixture(confidence);
+        let t = 1.;
+        let (r, pairs, _) = weighted_distribution(&s, t, [0.; 3]);
+        let mut native = s.native();
+        native.binding.eligible_mask = s.eligible_mask;
+        let base = native.probabilities(t).unwrap();
+        for (a, b) in r
+            .probabilities
+            .iter()
+            .zip(base.representative.probabilities)
+        {
+            assert!((a - b).abs() < 1e-12);
+        }
+        if confidence == 1. {
+            let marginal =
+                |rep: &CoordinatedTargetFactorV1, pairs: &[CoordinationPairFactorV1]| -> f64 {
+                    rep.probabilities
+                        .iter()
+                        .zip(pairs)
+                        .map(|(r, pair)| {
+                            r * pair
+                                .outcomes
+                                .iter()
+                                .zip(&pair.probabilities)
+                                .filter(|(o, _)| match o[1] {
+                                    CoordinatedTargetChoiceV1::Candidate(i) => {
+                                        s.coordination_frame.candidates()[i as usize].features.0[2]
+                                            > 0.2
+                                    }
+                                    _ => false,
+                                })
+                                .map(|(_, p)| p)
+                                .sum::<f64>()
+                        })
+                        .sum()
+                };
+            let before = marginal(&r, &pairs);
+            let (actual, actual_pairs, _) = weighted_distribution(&s, t, COORDINATION_WEIGHTS_V1);
+            let after = marginal(&actual, &actual_pairs);
+            assert!(after > 0. && after < before);
+            println!("COORDINATION_FIXED_REMOTE_MANIPULATION_MASS base={before:.12} candidate={after:.12}");
+        }
+        if confidence == 0. {
+            let (actual, _, _) = weighted_distribution(&s, t, COORDINATION_WEIGHTS_V1);
+            for (a, b) in r.probabilities.iter().zip(actual.probabilities) {
+                assert!((a - b).abs() < 1e-12);
+            }
+        }
+        assert!(pairs
+            .iter()
+            .all(|p| p.probabilities.iter().all(|x| *x > 0.)));
+    }
+}
+#[test]
+fn coordination_binding_rejects_frame_and_parameter_tamper_and_samples_once() {
+    let s = coordination_fixture(1.);
+    let a = s.sample(CONTROL_SEED, 17, 0.73).unwrap();
+    let e = s.evaluate(&a).unwrap();
+    assert!(
+        (e.factor_log_probabilities.iter().sum::<f64>() - a.joint_log_probability()).abs() < 1e-12
+    );
+    assert_eq!(a.draw_factors().iter().filter(|x| **x == 9).count(), 1);
+    assert!(!a.draw_factors().contains(&2));
+    assert!(!a.draw_factors().contains(&4));
+    let bytes = serde_json::to_vec(&s).unwrap();
+    let restored: CoordinatedTargetScoresV1 = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(restored.sample(CONTROL_SEED, 17, 0.73).unwrap(), a);
+    let mut changed = s.clone();
+    changed.coordination_weights[0] += 0.1;
+    assert!(changed.sample(CONTROL_SEED, 17, 0.73).is_err());
+    let mut changed = s.clone();
+    changed.coordination_frame = frame(&specs());
+    assert!(changed.sample(CONTROL_SEED, 17, 0.73).is_err());
+}
