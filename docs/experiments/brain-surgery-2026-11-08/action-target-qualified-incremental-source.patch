+//! Fixed opt-in CPU fixture, not an autonomous experiment or archived life.
+use alife_core::*;
+pub use alife_training::transfer_bounded_genetic_founder_to_grounded_drive;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask};
+use alife_world::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+#[allow(dead_code)]
+#[path = "../src/cpu/grouped_host_fixture.rs"]
+mod recipe;
+const SEED: u64 = 0x004f_5054_564f_4331;
+fn wire(host: &CpuCoordinatedTargetM2HostV1) -> Vec<u8> {
+    host.checkpoint().unwrap().encode().unwrap()
+}
+fn frozen(host: &CpuCoordinatedTargetM2HostV1) -> Value {
+    let bytes = wire(host);
+    let start = bytes.iter().position(|x| *x == b'{').unwrap();
+    let p: Value = serde_json::from_slice(&bytes[start..]).unwrap();
+    assert!(p["founder"].is_object());
+    assert!(p["source_asset"].is_object());
+    let n = &p["canonical"]["residents"][0]["neural"];
+    for key in ["lifetime", "fast", "eligibility", "weight_generation"] {
+        assert!(!n[key].is_null());
+    }
+    json!([
+        p["founder"],
+        p["source_asset"],
+        n["lifetime"],
+        n["fast"],
+        n["eligibility"],
+        n["weight_generation"],
+        n["neural"]["dendrites"]
+    ])
+}
+#[test]
+fn grounded_scene_pair_scores_and_cold_continuation() {
+    let recipe = recipe::build(SEED, true).unwrap();
+    let inputs = recipe.inputs.clone();
+    let mut trainer = CpuFoundationTrainer::new(
+        recipe.phenotype.clone(),
+        recipe.asset.clone(),
+        StageTrainableMask::recurrent_only(&recipe.phenotype).unwrap(),
+        AdamWConfig::default(),
+    )
+    .unwrap();
+    let mut checkpoint = trainer.checkpoint();
+    checkpoint.optimizer_step = 23;
+    checkpoint.update_ages[0] = 23;
+    checkpoint.first_moment[0] = 0.03125;
+    checkpoint.second_moment[0] = 0.0625;
+    trainer =
+        CpuFoundationTrainer::from_checkpoint(recipe.phenotype.clone(), recipe.asset, checkpoint)
+            .unwrap();
+    let mut game =
+        create_grounded_drive_research_new_game(&recipe.config, &recipe.genotype).unwrap();
+    let record = game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .unwrap()
+        .clone();
+    let id = record.organism_id();
+    let mut scene = HeadlessScenarioBuilder::new(SEED)
+        .agent("learner", id, Vec3f::ZERO)
+        .food("near-food", Vec3f::new(0.5, 0., 0.), 0.65)
+        .food("far-food", Vec3f::new(3., 0., 1.), 0.45)
+        .toy("stationary-toy", Vec3f::new(0., 0., 2.), false)
+        .obstacle("solid", Vec3f::new(-2., 0., 1.), 0.2)
+        .build()
+        .unwrap();
+    scene
+        .register_grounded_drive_research_record(record)
+        .unwrap();
+    game.world = scene;
+    let (mut warm, ()) = CpuCoordinatedTargetM2HostV1::new_prepared(
+        game,
+        trainer,
+        inputs.clone(),
+        (SEED ^ (SEED >> 32)) as u32,
+        MediationModeV1::Full,
+        |_| Ok::<(), String>(()),
+    )
+    .unwrap();
+    let before = frozen(&warm);
+    // Exactly three source forwards total: one before restore, warm and cold successors.
+    let first = warm.step_research_observed(0.73).unwrap();
+    assert_eq!(first.step.decisions.len(), 1);
+    assert_eq!(first.world_receipts.len(), 1);
+    let d = &first.step.decisions[0];
+    assert_eq!(d.motor.native.core.source_execution_count, 1);
+    let scores = warm.last_selection_scores(id).unwrap();
+    let probabilities = scores.probabilities(f64::from(0.73_f32)).unwrap();
+    assert!(probabilities
+        .coordination
+        .iter()
+        .any(|p| p.features.iter().any(|x| x[0] > 0.)));
+    let evaluation = scores.evaluate(&d.action).unwrap();
+    assert!(evaluation
+        .coordination_log_probability_gradient
+        .iter()
+        .all(|x| x.is_finite()));
+    assert_eq!(
+        d.patch.selected_bundle(),
+        Some(&first.world_receipts[0].bundle)
+    );
+    assert_eq!(
+        d.patch.outcome().joint.as_ref(),
+        Some(&first.world_receipts[0].joint)
+    );
+    assert_eq!(frozen(&warm), before);
+    let saved = wire(&warm);
+    let mut cold = CpuCoordinatedTargetM2HostV1::restore(
+        CpuCoordinatedTargetM2HostCheckpointV1::decode(&saved).unwrap(),
+        &inputs,
+        MediationModeV1::Full,
+    )
+    .unwrap();
+    assert_eq!(wire(&cold), saved);
+    let a = warm.step_research_observed(0.73).unwrap();
+    let b = cold.step_research_observed(0.73).unwrap();
+    assert_eq!(a.step.decisions.len(), 1);
+    assert_eq!(b.step.decisions.len(), 1);
+    for d in [&a.step.decisions[0], &b.step.decisions[0]] {
+        assert_eq!(d.motor.native.core.source_execution_count, 1);
+    }
+    assert_eq!(a.world_receipts, b.world_receipts);
+    assert_eq!(
+        serde_json::to_vec(&a.step.decisions[0].action).unwrap(),
+        serde_json::to_vec(&b.step.decisions[0].action).unwrap()
+    );
+    assert_eq!(
+        serde_json::to_vec(&a.step.decisions[0].patch).unwrap(),
+        serde_json::to_vec(&b.step.decisions[0].patch).unwrap()
+    );
+    assert_eq!(wire(&warm), wire(&cold));
+    assert_eq!(frozen(&warm), before);
+    assert_eq!(frozen(&cold), before);
+    println!("COORDINATION_INTEGRATED_COUNTS source_forwards=3 bundle_attempts=3 committed_intervals=3 source_execution_count_per_decision=1");
+    println!(
+        "COORDINATION_INTEGRATED_CONTINUATION_SHA256={:x}",
+        Sha256::digest(wire(&warm))
+    );
+}
