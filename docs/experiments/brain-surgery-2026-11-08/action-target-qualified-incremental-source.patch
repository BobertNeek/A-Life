+//! Inherited, parametric coordination energy over the actual joint option.
+//! Never consults WorldObjectKind, food nutrition, ownership, or world positions.
+//! Sensor geometry is only a fallible prediction. World validation and failed
+//! experience remain authoritative, and every finite base option retains support.
+use super::*;
+
+pub const COORDINATION_WEIGHTS_V1: [f64; 3] = [-4.0, 1.0, -1.0];
+pub const COORDINATION_FEATURE_ID_V1: &str =
+    "observed-postmove-reach-excess,observed-progress,remote-target-conflict/v1";
+// Frozen morphology/actuator prior, not a claim of actual displacement. This is
+// the ordinary maximum 2 units/s divided by 20 ticks/s. Obstruction, terrain,
+// effector gain, carried objects and unseen motion can invalidate the estimate.
+const STEP: f64 = 0.1;
+const REACH: f64 = 1.25;
+const VISION_RADIUS: f64 = 8.0;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct CoordinationPairFactorV1 {
+    pub outcomes: Vec<[CoordinatedTargetChoiceV1; 2]>,
+    pub probabilities: Vec<f64>,
+    pub log_probabilities: Vec<f64>,
+    pub features: Vec<[f64; 3]>,
+}
+impl CoordinationPairFactorV1 {
+    pub(super) fn sample(&self, u: f64) -> usize {
+        let mut sum = 0.;
+        for (i, p) in self.probabilities.iter().enumerate() {
+            sum += p;
+            if u < sum {
+                return i;
+            }
+        }
+        self.probabilities.len() - 1
+    }
+}
+#[derive(Clone, Copy)]
+struct Geometry {
+    slot: u16,
+    distance: f64,
+    bearing: [f64; 2],
+    confidence: f64,
+}
+fn observation(
+    frame: &PerceptionFrame,
+    c: &ActionCandidate,
+) -> Result<Option<Geometry>, TrainingError> {
+    let CandidateObservationRef::ObjectSlot(index) = c.observation else {
+        return Ok(None);
+    };
+    let slot = frame
+        .grounded_object_slots()
+        .iter()
+        .find(|s| s.slot_index == index)
+        .ok_or_else(invalid)?;
+    if slot.candidate_features()? != c.features {
+        return Err(invalid());
+    }
+    let norm = f64::from(slot.bearing[0]).hypot(f64::from(slot.bearing[1]));
+    // An uncertain bearing is no permission to read the transport coordinates.
+    if norm < 0.5 {
+        return Ok(None);
+    }
+    let motion = slot
+        .relative_velocity
+        .iter()
+        .map(|x| f64::from(*x).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    Ok(Some(Geometry {
+        slot: index,
+        distance: f64::from(slot.distance) * VISION_RADIUS,
+        bearing: [
+            f64::from(slot.bearing[0]) / norm,
+            f64::from(slot.bearing[1]) / norm,
+        ],
+        confidence: f64::from(slot.confidence.raw().min(c.sensor_confidence.raw())) / (1. + motion),
+    }))
+}
+fn geometry_features(
+    movement: Option<(Geometry, CandidateActionFamily)>,
+    manipulation: Option<Geometry>,
+) -> [f64; 3] {
+    let Some(m) = manipulation else {
+        return [0.; 3];
+    };
+    let mut displacement = [0.; 2];
+    let mut confidence = m.confidence;
+    let mut conflict = 0.;
+    if let Some((l, family)) = movement {
+        confidence = confidence.min(l.confidence);
+        let sign = match family {
+            CandidateActionFamily::Approach => 1.,
+            CandidateActionFamily::Avoid => -1.,
+            _ => 0.,
+        };
+        let length = if sign > 0. {
+            l.distance.min(STEP)
+        } else {
+            STEP
+        };
+        displacement = l.bearing.map(|x| x * sign * length);
+        // A separate target is not inherently incompatible. Penalize only the
+        // remote case, softly; near/held contact remains entirely available.
+        if m.distance > REACH && l.slot != m.slot {
+            conflict = (0.5
+                * (1. - sign * (l.bearing[0] * m.bearing[0] + l.bearing[1] * m.bearing[1])))
+                .clamp(0., 1.);
+        }
+    }
+    let after = (m.bearing[0] * m.distance - displacement[0])
+        .hypot(m.bearing[1] * m.distance - displacement[1]);
+    let excess = (after - REACH).max(0.);
+    [
+        confidence * excess / (REACH + excess),
+        confidence * ((m.distance - after) / STEP).clamp(-1., 1.),
+        confidence * conflict * (excess / STEP).clamp(0., 1.),
+    ]
+}
+fn logsumexp(xs: &[f64]) -> Result<f64, TrainingError> {
+    if xs.is_empty() || xs.iter().any(|x| !x.is_finite()) {
+        return Err(invalid());
+    }
+    let max = xs.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+    Ok(max + xs.iter().map(|x| (x - max).exp()).sum::<f64>().ln())
+}
+impl CoordinatedTargetScoresV1 {
+    fn pair_features(
+        &self,
+        pair: [CoordinatedTargetChoiceV1; 2],
+    ) -> Result<[f64; 3], TrainingError> {
+        let candidate = |choice| -> Result<Option<&ActionCandidate>, TrainingError> {
+            match choice {
+                CoordinatedTargetChoiceV1::Candidate(i) => Ok(Some(
+                    self.coordination_frame
+                        .candidates()
+                        .get(i as usize)
+                        .ok_or_else(invalid)?,
+                )),
+                _ => Ok(None),
+            }
+        };
+        let movement = candidate(pair[0])?
+            .map(|c| observation(&self.coordination_frame, c).map(|g| g.map(|g| (g, c.family))))
+            .transpose()?
+            .flatten();
+        let manipulation = candidate(pair[1])?
+            .map(|c| observation(&self.coordination_frame, c))
+            .transpose()?
+            .flatten();
+        Ok(geometry_features(movement, manipulation))
+    }
+    pub(super) fn coordinate(
+        &self,
+        representative: &mut CoordinatedTargetFactorV1,
+        channels: &[Option<CoordinatedTargetFactorV1>; 6],
+        t: f64,
+        weights: [f64; 3],
+    ) -> Result<(Vec<CoordinationPairFactorV1>, [f64; 3]), TrainingError> {
+        if weights.iter().any(|w| !w.is_finite() || w.abs() > 32.) {
+            return Err(invalid());
+        }
+        let mut pairs = Vec::new();
+        let mut representative_logs = Vec::new();
+        for (r, base_logp) in representative
+            .outcomes
+            .iter()
+            .zip(&representative.log_probabilities)
+        {
+            let choices = |channel: usize| -> Vec<(CoordinatedTargetChoiceV1, f64)> {
+                if self.forced(*r) == Some(channel) {
+                    return vec![(*r, 0.)];
+                }
+                channels[channel].as_ref().map_or_else(
+                    || vec![(CoordinatedTargetChoiceV1::NoOp, 0.)],
+                    |f| {
+                        f.outcomes
+                            .iter()
+                            .copied()
+                            .zip(f.log_probabilities.iter().copied())
+                            .collect()
+                    },
+                )
+            };
+            let mut outcomes = Vec::new();
+            let mut features = Vec::new();
+            let mut logits = Vec::new();
+            for (l, lp) in choices(0) {
+                for (m, mp) in choices(2) {
+                    let pair = [l, m];
+                    let phi = self.pair_features(pair)?;
+                    let energy: f64 = phi.iter().zip(weights).map(|(x, w)| x * w).sum();
+                    outcomes.push(pair);
+                    features.push(phi);
+                    logits.push(lp + mp + energy / t);
+                }
+            }
+            let partition = logsumexp(&logits)?;
+            let log_probabilities: Vec<_> = logits.iter().map(|x| x - partition).collect();
+            let probabilities = log_probabilities.iter().map(|x| x.exp()).collect();
+            pairs.push(CoordinationPairFactorV1 {
+                outcomes,
+                probabilities,
+                log_probabilities,
+                features,
+            });
+            representative_logs.push(base_logp + partition);
+        }
+        let partition = logsumexp(&representative_logs)?;
+        representative.log_probabilities =
+            representative_logs.iter().map(|x| x - partition).collect();
+        representative.probabilities = representative
+            .log_probabilities
+            .iter()
+            .map(|x| x.exp())
+            .collect();
+        let mut mean = [0.; 3];
+        for (r, pair) in representative.probabilities.iter().zip(&pairs) {
+            for (p, phi) in pair.probabilities.iter().zip(&pair.features) {
+                for i in 0..3 {
+                    mean[i] += r * p * phi[i];
+                }
+            }
+        }
+        Ok((pairs, mean))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn g(slot: u16, d: f64) -> Geometry {
+        Geometry {
+            slot,
+            distance: d,
+            bearing: [0., 1.],
+            confidence: 1.,
+        }
+    }
+    #[test]
+    fn fixed_near_far_move_then_reach_and_noop() {
+        assert_eq!(geometry_features(None, None), [0.; 3]);
+        assert_eq!(geometry_features(None, Some(g(1, 0.5))), [0.; 3]);
+        assert!(geometry_features(None, Some(g(1, 3.)))[0] > 0.);
+        assert_eq!(
+            geometry_features(
+                Some((g(1, 1.3), CandidateActionFamily::Approach)),
+                Some(g(1, 1.3))
+            )[0],
+            0.
+        );
+        assert!(
+            geometry_features(
+                Some((g(1, 1.3), CandidateActionFamily::Avoid)),
+                Some(g(1, 1.3))
+            )[0] > 0.
+        );
+    }
+    #[test]
+    fn no_kind_or_mobility_or_held_semantic_oracle() {
+        // Geometry alone gives food, stationary toys, hazards and obstacles the
+        // same prior. Their native neural logits and real outcomes distinguish.
+        let near = geometry_features(
+            Some((g(2, 4.), CandidateActionFamily::Approach)),
+            Some(g(1, 0.5)),
+        );
+        assert_eq!(near[0], 0.);
+        assert_eq!(near[2], 0.);
+        let far = geometry_features(
+            Some((g(2, 4.), CandidateActionFamily::Approach)),
+            Some(g(1, 3.)),
+        );
+        assert_eq!(far[2], 0.);
+        let mut opposite = g(2, 4.);
+        opposite.bearing = [0., -1.];
+        assert_eq!(
+            geometry_features(
+                Some((opposite, CandidateActionFamily::Approach)),
+                Some(g(1, 3.))
+            )[2],
+            1.
+        );
+        assert_eq!(
+            geometry_features(
+                Some((g(2, 4.), CandidateActionFamily::Approach)),
+                Some(g(1, 1.3))
+            )[2],
+            0.
+        );
+        let mut uncertain = g(1, 3.);
+        uncertain.confidence = 0.;
+        assert_eq!(geometry_features(None, Some(uncertain)), [0.; 3]);
+    }
+}
