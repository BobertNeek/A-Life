+#[test]
+fn serialized_own_proof_roundtrip_and_tamper_rejection() {
+    let (_,_,_,input)=fixture(false);let s=ChannelScores::bind(&input).unwrap();
+    let a=s.sample(CONTROL_SEED,17,0.73).unwrap();
+    let restored:ChannelScores=serde_json::from_slice(&serde_json::to_vec(&s).unwrap()).unwrap();
+    let action:BundleAction=serde_json::from_slice(&serde_json::to_vec(&a).unwrap()).unwrap();
+    restored.evaluate(&action).unwrap();assert_eq!(restored.sample(CONTROL_SEED,17,0.73).unwrap(),a);
+    let mut bad=action;bad.proof.counter+=1;
+    // Adjacent counters can legitimately sample the same bundle.  The trusted
+    // host cursor, not resampling alone, authenticates the expected counter.
+    assert!(restored.validate_sampling_context(&bad,CONTROL_SEED,17,0.73).is_err());
+}
