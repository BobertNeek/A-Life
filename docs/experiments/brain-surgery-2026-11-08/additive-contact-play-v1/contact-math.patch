+#[test]
+fn exact_joint_log_probability_and_zero_expected_score() {
+    let (_,_,_,input)=fixture(true);let s=ChannelScores::bind(&input).unwrap();
+    let mut means=vec![0.;s.input.ordinary_bits.len()];let mut group=0.;let mut ops=[0.;2];
+    each_bundle(&s,0.9,|_,_,e|{let p=e.log_probability.exp();
+        for (v,g) in means.iter_mut().zip(e.derivative.ordinary) {*v+=p*g;}
+        group+=p*e.derivative.group;for i in 0..2 {ops[i]+=p*e.derivative.operations[i];}});
+    assert!(means.iter().chain([&group]).chain(ops.iter()).all(|x|x.abs()<1e-12));
+}
+#[test]
+fn all_score_gradients_including_shared_idle_quiet() {
+    let (_,_,_,input)=fixture(true);let s=ChannelScores::bind(&input).unwrap();let t=0.7;let h=1e-5;
+    // All supported bundles, not merely the sampled action; includes Rest/non-Rest.
+    each_bundle(&s,t,|m,o,e|{
+        for index in 0..s.input.ordinary_bits.len()+3 {
+            let mut lo=s.clone();let mut hi=s.clone();
+            let expected=if index<s.input.ordinary_bits.len() {
+                let z=f64::from_bits(s.input.ordinary_bits[index]);
+                lo.input.ordinary_bits[index]=(z-h).to_bits();hi.input.ordinary_bits[index]=(z+h).to_bits();
+                e.derivative.ordinary[index]
+            } else if index==s.input.ordinary_bits.len() {
+                let z=f64::from_bits(s.input.group_bits);lo.input.group_bits=(z-h).to_bits();hi.input.group_bits=(z+h).to_bits();e.derivative.group
+            } else {
+                let i=index-s.input.ordinary_bits.len()-1;let z=f64::from_bits(s.input.operation_bits[i]);
+                lo.input.operation_bits[i]=(z-h).to_bits();hi.input.operation_bits[i]=(z+h).to_bits();e.derivative.operations[i]
+            };
+            let actual=(hi.evaluate_selection(m,o,t).unwrap().log_probability-lo.evaluate_selection(m,o,t).unwrap().log_probability)/(2.*h);
+            assert!((expected-actual).abs()<1e-7,"gradient {index}: {expected} != {actual}");
+        }
+    });
+}
+#[test]
+fn invalid_ungrounded_gesture_and_single_operation_support() {
+    // This exact unsupported fixture failed in V3 before sampling. Preserve
+    // the real profile5 rejection rather than weakening the frame validator.
+    let mut spec=specs();
+    spec.push((401,ActionKind::Gesture,CandidateActionFamily::Other));
+    assert!(matches!(try_frame_edit(&spec, |_| {}),
+        Err(ScaffoldContractError::InvalidPerceptionFrame)));
+
+    // Operation availability is an independent check on the existing legal
+    // native frame. Do not infer that an invented Gesture was admitted.
+    let p=phenotype();
+    let f=try_frame_edit(&specs(), |_| {}).unwrap();
+    f.validate_contract().unwrap();
+    let n=native(&p,&f);
+    let input=OptionalVocalScoresV1::bind(&p,&f,&n,synthetic_source(&p,&f,false)).unwrap();
+    let mut s=ChannelScores::bind(&input).unwrap();
+    s.input.native_binding.eligible_mask &= !(1<<1);
+    s.input.eligible_mask &= !(1<<1);
+    let mut mass=0.;
+    let mut rest_mass=0.;
+    each_bundle(&s,1.,|m,o,e|{
+        let probability=e.log_probability.exp();
+        mass+=probability;
+        if m[4]==Choice::Rest {
+            assert_eq!(o,Some(1));
+            rest_mass+=probability;
+        } else {assert_eq!(o,None);}
+    });
+    assert!((mass-1.).abs()<1e-12);
+    assert!((rest_mass-1./3.).abs()<1e-12);
+}
