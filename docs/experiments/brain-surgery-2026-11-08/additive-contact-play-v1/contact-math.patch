+//! Fixed synthetic sampler controls. No source forward, world tick, or learning.
+//! Present payloads here are fixture data, never claims of autonomous speech.
+use super::*;
+const CONTROL_SEED: u32 = 0x4f56_4331;
+fn phenotype() -> BrainPhenotype {
+    let (inputs, _) = super::super::super::super::tests::source();
+    PhenotypeCompiler::compile_validated(
+        &inputs,
+        &BrainCapacityClass::n2048_grounded_drive_research(),
+    )
+    .unwrap()
+}
+fn specs() -> Vec<(u32, ActionKind, CandidateActionFamily)> {
+    vec![
+        (1, ActionKind::Idle, CandidateActionFamily::Idle),
+        (3, ActionKind::Rest, CandidateActionFamily::Rest),
+        (400, ActionKind::Vocalize, CandidateActionFamily::Other),
+        (103, ActionKind::Move, CandidateActionFamily::Approach),
+        (212, ActionKind::Interact, CandidateActionFamily::Contact),
+        (104, ActionKind::Hold, CandidateActionFamily::Other),
+        (700, ActionKind::Rest, CandidateActionFamily::Rest),
+    ]
+}
+fn frame(spec: &[(u32, ActionKind, CandidateActionFamily)]) -> PerceptionFrame {
+    frame_edit(spec, |_| {})
+}
+fn frame_edit(
+    spec: &[(u32, ActionKind, CandidateActionFamily)],
+    edit: impl FnOnce(&mut Vec<ActionCandidate>),
+) -> PerceptionFrame {
+    try_frame_edit(spec, edit).unwrap()
+}
+fn try_frame_edit(
+    spec: &[(u32, ActionKind, CandidateActionFamily)],
+    edit: impl FnOnce(&mut Vec<ActionCandidate>),
+) -> Result<PerceptionFrame, ScaffoldContractError> {
+    let t = Tick::new(1);
+    let owner = OrganismId(1);
+    let profile = SensorProfile::GroundedObjectSlotsSleepChoiceV1;
+    let mut candidates = spec
+        .iter()
+        .enumerate()
+        .map(|(i, (id, kind, family))| {
+            ActionCandidate::new(
+                i as u16,
+                ActionId(*id),
+                *kind,
+                *family,
+                CandidateObservationRef::None,
+                ActionTarget::NONE,
+                CandidateFeatureVector::zero().with_intrinsic_action_basis(*kind),
+                Confidence::new(1.).unwrap(),
+                NormalizedScalar::ZERO,
+                DurationTicks::new(1),
+                DurationTicks::new(1),
+            )
+            .unwrap()
+        })
+        .collect();
+    edit(&mut candidates);
+    PerceptionFrame::new(
+        owner,
+        t,
+        profile,
+        SensorySnapshot::new(
+            owner,
+            t,
+            Vec3f::ZERO,
+            SensoryChannels::ZERO,
+            Default::default(),
+        )
+        .unwrap(),
+        BodySnapshot {
+            pose: Pose::IDENTITY,
+            velocity: Velocity::ZERO,
+        },
+        HomeostaticSnapshot::baseline(t),
+        candidates,
+        SensorProfileProvenance::new(profile, SensoryAbiVersion::CURRENT, t).unwrap(),
+        vec![],
+    )
+}
+fn synthetic_source(
+    p: &BrainPhenotype,
+    f: &PerceptionFrame,
+    present: bool,
+) -> OptionalVocalSourceV1 {
+    let speech = present.then(|| {
+        SpeechMotorPayload::try_new(
+            SpeechActKind::Declare,
+            vec![LanguageTokenId::new(1).unwrap()],
+            Confidence::new(1.).unwrap(),
+        )
+        .unwrap()
+    });
+    OptionalVocalSourceV1::from_forward(
+        f.organism_id(),
+        f.tick(),
+        p.phenotype_hash(),
+        f.frame_digest(),
+        1,
+        0,
+        &vec![0.; p.neuron_count() as usize],
+        &vec![0.; p.synapses().len()],
+        speech,
+    )
+    .unwrap()
+}
+fn native(p: &BrainPhenotype, f: &PerceptionFrame) -> RecoveryGroupScoresV2 {
+    RecoveryGroupScoresV2 {
+        binding: RecoveryGroupBindingV2::bind(
+            p,
+            f,
+            (1u32 << f.candidates().len()) - 1,
+            [true; 6],
+            0,
+        )
+        .unwrap(),
+        ordinary: vec![0.; f.candidates().len()],
+        group: 0.,
+        operations: [0.; 2],
+    }
+}
+fn fixture(
+    present: bool,
+) -> (
+    BrainPhenotype,
+    PerceptionFrame,
+    RecoveryGroupScoresV2,
+    OptionalVocalScoresV1,
+) {
+    let p = phenotype();
+    let f = frame(&specs());
+    let n = native(&p, &f);
+    let s = OptionalVocalScoresV1::bind(&p, &f, &n, synthetic_source(&p, &f, present)).unwrap();
+    (p, f, n, s)
+}
