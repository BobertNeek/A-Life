+fn each_bundle(scores:&ChannelScores,t:f64,mut visit:impl FnMut([Choice;6],Option<u8>,Evaluation)) {
+    let d=scores.distribution(t).unwrap();
+    fn recurse(s:usize,m:&mut [Choice;6],d:&Distribution,scores:&ChannelScores,t:f64,
+        visit:&mut impl FnMut([Choice;6],Option<u8>,Evaluation)) {
+        if s==6 {
+            if m[4]==Choice::Rest {
+                for o in 0..2 {if d.operation_lp[o].is_some() {
+                    visit(*m,Some(o as u8),scores.evaluate_selection(*m,Some(o as u8),t).unwrap());
+                }}
+            } else {visit(*m,None,scores.evaluate_selection(*m,None,t).unwrap());}
+        } else {for c in &d.channels[s].choices {m[s]=*c;recurse(s+1,m,d,scores,t,visit);}}
+    }
+    let size=d.channels.iter().map(|f|f.choices.len()).product::<usize>()*2;
+    assert!(size<=10000);
+    recurse(0,&mut [Choice::NoOp;6],&d,scores,t,&mut visit);
+}
+#[test]
+fn normalized_support_idle_and_recovery_operations() {
+    let (_,_,_,input)=fixture(true); let s=ChannelScores::bind(&input).unwrap();
+    let d=s.distribution(1.).unwrap();
+    assert!(d.channels[4].choices.contains(&Choice::Candidate(input.idle)));
+    let mut mass=0.;let mut rest=0.;let mut awake=0.;let mut n=0;
+    each_bundle(&s,1.,|m,o,e|{n+=1;let p=e.log_probability.exp();assert!(p>0.);mass+=p;
+        if m[4]==Choice::Rest {rest+=p;} if o==Some(1) {awake+=p;}});
+    assert_eq!(n,8); // two Vocal outcomes times Idle/Hold/BodySleep/AwakeRest
+    assert!((mass-1.).abs()<1e-12);assert!((rest-1./3.).abs()<1e-12);
+    assert!((awake-1./6.).abs()<1e-12);
+}
