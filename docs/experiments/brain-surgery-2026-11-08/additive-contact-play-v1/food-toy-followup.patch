 #[test] fn additive_natural_original() {run_natural_after_contact::<0>();}
 #[test] fn additive_natural_candidate() {run_natural_after_contact::<1>();}
 #[test] fn additive_natural_sham() {run_natural_after_contact::<2>();}
+
+// Fresh ordinary physical scene. Unlike the controlled fixture above, every
+// motor bundle is sampled by the host; no action or drive level is injected.
+fn run_natural_food_toy<const ARM:u8>() {
+    let recipe=recipe::build(FIXTURE_SEED,true).unwrap();
+    let founder=CpuFoundationTrainer::new(recipe.phenotype.clone(),recipe.asset.clone(),StageTrainableMask::recurrent_only(&recipe.phenotype).unwrap(),AdamWConfig::default()).unwrap();
+    let mut game=create_grounded_drive_research_new_game(&recipe.config,&recipe.genotype).unwrap();
+    let newborn=game.world.organism_registry().iter().next().unwrap().clone();
+    let mut world=HeadlessScenarioBuilder::new(FIXTURE_SEED)
+        .agent("learner",newborn.organism_id(),Vec3f::ZERO)
+        .food("root",Vec3f::new(0.6,0.0,0.0),0.65)
+        .toy("toy",Vec3f::new(0.1,0.0,0.0),false)
+        .build().unwrap();
+    world.set_food_variety(world.entity_id("root").unwrap(),FoodVariety::Root).unwrap();
+    world.register_grounded_drive_research_record(newborn).unwrap();
+    game.world=world;
+    let (mut host,())=CpuGroupedM2HostV1::new_prepared_policy::<Natural<ARM>,_,String>(game,founder,recipe.inputs,(FIXTURE_SEED^(FIXTURE_SEED>>32)) as u32,MediationModeV1::Full, |_| Ok(())).unwrap();
+    let frozen_founder=serde_json::to_vec(&host.founder.checkpoint()).unwrap();
+    for tick in 0..32 {
+        let observed=host.host.grouped_policy_step_observed::<Natural<ARM>>(&host.founder,0.73).unwrap();
+        for rec in &observed.world_receipts {
+            let channels:Vec<_>=rec.channel_receipts.iter().map(|c|json!({"primitive":c.command.primitive.raw(),"phase":format!("{:?}",c.phase),"contact":format!("{:?}",c.physical.contact),"stimulation":c.play_stimulation})).collect();
+            println!("ADDITIVE_FOOD_TOY_V1 {}",json!({"arm":ARM,"step":tick,"success":rec.succeeded,"nutrition":rec.body_event.nutrition,"stimulation":rec.body_event.play_stimulation,"hunger_before":rec.biology_before.homeostasis.drives.hunger,"hunger_after":rec.biology_after.homeostasis.drives.hunger,"boredom_before":rec.biology_before.homeostasis.drives.extension[0],"boredom_after":rec.biology_after.homeostasis.drives.extension[0],"channels":channels}));
+        }
+    }
+    assert_eq!(frozen_founder,serde_json::to_vec(&host.founder.checkpoint()).unwrap());
+}
+#[test] fn additive_food_toy_original() {run_natural_food_toy::<0>();}
+#[test] fn additive_food_toy_candidate() {run_natural_food_toy::<1>();}
+#[test] fn additive_food_toy_sham() {run_natural_food_toy::<2>();}
