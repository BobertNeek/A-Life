 #[test] fn additive_food_toy_original_seed3() {run_natural_food_toy::<0, 0x0043_484e_4c48_5333>();}
 #[test] fn additive_food_toy_candidate_seed3() {run_natural_food_toy::<1, 0x0043_484e_4c48_5333>();}
 #[test] fn additive_food_toy_sham_seed3() {run_natural_food_toy::<2, 0x0043_484e_4c48_5333>();}
+
+fn run_long_natural_food_toy<const ARM:u8, const SCENE_SEED:u64>() {
+    let recipe=recipe::build(SCENE_SEED,true).unwrap();
+    let founder=CpuFoundationTrainer::new(recipe.phenotype.clone(),recipe.asset.clone(),StageTrainableMask::recurrent_only(&recipe.phenotype).unwrap(),AdamWConfig::default()).unwrap();
+    let mut game=create_grounded_drive_research_new_game(&recipe.config,&recipe.genotype).unwrap();
+    let newborn=game.world.organism_registry().iter().next().unwrap().clone();
+    let mut world=HeadlessScenarioBuilder::new(SCENE_SEED)
+        .agent("learner",newborn.organism_id(),Vec3f::ZERO)
+        .food("root",Vec3f::new(0.6,0.0,0.0),0.65)
+        .toy("toy",Vec3f::new(0.1,0.0,0.0),false)
+        .build().unwrap();
+    world.set_food_variety(world.entity_id("root").unwrap(),FoodVariety::Root).unwrap();
+    world.register_grounded_drive_research_record(newborn).unwrap();
+    game.world=world;
+    let (mut host,())=CpuGroupedM2HostV1::new_prepared_policy::<Natural<ARM>,_,String>(game,founder,recipe.inputs,(SCENE_SEED^(SCENE_SEED>>32)) as u32,MediationModeV1::Full, |_| Ok(())).unwrap();
+    let frozen_founder=serde_json::to_vec(&host.founder.checkpoint()).unwrap();
+    for tick in 0..256 {
+        let observed=host.host.grouped_policy_step_observed::<Natural<ARM>>(&host.founder,0.73).unwrap();
+        if observed.world_receipts.is_empty() { println!("ADDITIVE_LONG_NO_DECISION_V1 {}",json!({"arm":ARM,"step":tick})); }
+        for rec in &observed.world_receipts {
+            let channels:Vec<_>=rec.channel_receipts.iter().map(|c|json!({"primitive":c.command.primitive.raw(),"phase":format!("{:?}",c.phase),"contact":format!("{:?}",c.physical.contact),"stimulation":c.play_stimulation})).collect();
+            println!("ADDITIVE_LONG_FOOD_TOY_V1 {}",json!({"arm":ARM,"step":tick,"success":rec.succeeded,"nutrition":rec.body_event.nutrition,"stimulation":rec.body_event.play_stimulation,"hunger_before":rec.biology_before.homeostasis.drives.hunger,"hunger_after":rec.biology_after.homeostasis.drives.hunger,"boredom_before":rec.biology_before.homeostasis.drives.extension[0],"boredom_after":rec.biology_after.homeostasis.drives.extension[0],"fatigue_after":rec.biology_after.homeostasis.drives.fatigue,"brain_atp_after":rec.biology_after.homeostasis.drives.brain_atp,"health_after":rec.biology_after.body.health,"energy_after":rec.biology_after.body.energy,"channels":channels}));
+        }
+    }
+    assert_eq!(frozen_founder,serde_json::to_vec(&host.founder.checkpoint()).unwrap());
+}
+#[test] fn additive_long_original() {run_long_natural_food_toy::<0,0x0043_484e_4c48_5331>();}
+#[test] fn additive_long_candidate() {run_long_natural_food_toy::<1,0x0043_484e_4c48_5331>();}
+#[test] fn additive_long_sham() {run_long_natural_food_toy::<2,0x0043_484e_4c48_5331>();}
