+    let (parent,_) = PhenotypeCompiler::compile_n2048_experimental_graph(e.brain_genome,d,SensorProfile::GroundedObjectSlotsV1).unwrap();let anchor_path=std::env::temp_dir().join(format!("research-sensor-generations-{}.json",std::process::id()));fs::write(&anchor_path,serde_json::to_vec(parent.sensor_encoder()).unwrap()).unwrap();std::env::set_var("ALIFE_RESEARCH_SENSOR_ANCHOR",&anchor_path);std::env::set_var("ALIFE_RESEARCH_EQUIVALENT_FOUNDATION_WEIGHTS","1");
+    let ports=|p:&BrainPhenotype|p.sensor_encoder().assignments().iter().map(|a|(a.source_group().raw(),a.source_index(),a.target_neuron())).collect::<std::collections::BTreeSet<_>>();let anchors=ports(&parent);
+    let root=temp_root("research-anchored-generations");let mut lib=LineageLibrary::open(LineageLibraryConfig::profile_default(&root)).unwrap();
+    for generation in 0..10 {let mut child=CreatureGenome::reproduce(&mother,&father,703+generation).unwrap();let e=child.express().unwrap();let d=e.development_state_at(Tick::new(u64::from(e.development.maturation_duration_ticks))).unwrap();let (p,_) = PhenotypeCompiler::compile_n2048_experimental_graph(e.brain_genome.clone(),d.clone(),SensorProfile::GroundedObjectSlotsV1).unwrap();assert!(anchors.is_subset(&ports(&p)));assert!(parent.synapses().iter().zip(p.synapses()).all(|(a,b)|a.source()==b.source()&&a.target()==b.target()&&a.route_index()==b.route_index()&&a.kind()==b.kind()));let rebound=FoundationWeightAsset::from_trained_weights(&p,source.weights().to_vec(),source.manifest().training_stage()).unwrap();assert_eq!(source.weights().iter().map(|x|x.to_bits()).collect::<Vec<_>>(),rebound.weights().iter().map(|x|x.to_bits()).collect::<Vec<_>>());child=child.with_n2048_foundation_candidate(rebound.clone()).unwrap();let (bound,_) = PhenotypeCompiler::compile_n2048_experimental_foundation_candidate(e.brain_genome,d,rebound.clone()).unwrap();let bytes=rebound.encode_canonical().unwrap();let run=format!("research-anchored-{generation}");let digest=lib.archive_composite_birth(CompositeGeneticArchiveInput{source_run_id:&run,organism_id:OrganismId(703+generation),birth_tick:Tick::new(9),creature_genome:&child,phenotype:&bound,foundation_asset_bytes:&bytes}).unwrap();let manifest=lib.load_manifest(digest).unwrap();assert_eq!(lib.load_creature_genome(&manifest).unwrap(),child);println!("generation={generation} anchors={} ports={} weights={} archived=true",anchors.len(),ports(&p).len(),source.weights().len());father=mother;mother=child;}
