+    let mut mother=CreatureGenome::early_mammal_founder(701,identity).unwrap().with_n2048_foundation_candidate(source.clone()).unwrap();let mut father=CreatureGenome::early_mammal_founder(702,identity).unwrap().with_n2048_foundation_candidate(source.clone()).unwrap();
