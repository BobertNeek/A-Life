+//! Disposable cue-outcome experiment. Never reads a user's life.
+#[allow(dead_code)]
+#[path = "probe_weight_space_care.rs"]
+mod base;
+use alife_core::*;
+use alife_runtime::canonical_preparation::foundation_construction_development;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask};
+use alife_world::*;
+use serde_json::{json, Value};
+use std::{error::Error, io::Write};
+type Result<T> = std::result::Result<T, Box<dyn Error>>;
+fn spawn(host: &mut CpuCanonicalHost, own: OrganismId, label: &str, color: [f32;3], dx: f32, dz: f32, hazard: f32) -> Result<WorldEntityId> {
+    let world=host.world_mut();
+    let actor=world.organism_registry().get(own).ok_or("missing owner")?.world_entity_id();
+    let pos=world.entity(actor).ok_or("missing body")?.position;
+    let id=world.editor_spawn_object(WorldEditorSpawnSpec {label:label.into(),kind:WorldObjectKind::Food,organism_id:None,position:Vec3f::new(pos.x+dx,pos.y,pos.z+dz),nutrition:0.6,hazard_pain:hazard,radius:0.25,token_id:None})?;
+    let mut f=world.entity(id).ok_or("missing target")?.grounded_physical;
+    f.color=color; f.material=[0.5;3]; f.shape=[0.5;3]; f.chemical=[0.85,0.,0.]; f.velocity=Vec3f::ZERO; f.surface_temperature=0.5; f.terrain=[0.;2];
+    world.set_grounded_physical_properties(id,f)?; Ok(id)
+}
+fn main()->Result<()> {
+    let args=std::env::args().collect::<Vec<_>>();
+    let path=args.get(1).ok_or("new output path required")?;
+    let seed:u64=args.get(2).ok_or("seed required")?.parse()?;
+    let safe_red:bool=match args.get(3).map(String::as_str) {Some("red")=>true,Some("blue")=>false,_=>return Err("safe color red or blue required".into())};
+    let red_left:bool=match args.get(4).map(String::as_str) {Some("left")=>true,Some("right")=>false,_=>return Err("red side left or right required".into())};
+    let (config,p,source)=base::source(seed,true)?;
+    let (weights,_) = base::whole_care(&p)?;
+    let asset=FoundationWeightAsset::from_trained_weights(&p,weights,source.manifest().training_stage())?;
+    let mut game=create_canonical_new_game_with_n2048_experimental_candidate(&config,&asset)?;
+    let old=game.world.organism_registry().iter().next().ok_or("missing founder")?.clone();
+    let own=old.organism_id(); let cap=BrainCapacityClass::n2048();
+    let development=foundation_construction_development(&old.phenotype().brain_genome,&cap,&old.phenotype().development_state_at(Tick::ZERO)?)?;
+    let (p,_) = PhenotypeCompiler::compile_n2048_experimental_foundation_candidate(old.phenotype().brain_genome.clone(),development,asset.clone())?;
+    let mask=StageTrainableMask::recurrent_only(&p)?;
+    let trainer=CpuFoundationTrainer::new(p,asset,mask,AdamWConfig::default())?;
+    let founder_before=serde_json::to_vec(&trainer.checkpoint())?;
+    let mut world=HeadlessScenarioBuilder::new(seed).agent("learner",own,Vec3f::ZERO).build()?;
+    let mut chemistry=*old.biochemistry(); chemistry.body.set_energy(0.4)?;
+    world.register_organism_record(WorldOrganismRecord::new(own,world.entity_id("learner").ok_or("missing body")?,old.genome().clone(),old.phenotype().clone(),chemistry,old.birth_tick())?)?;
+    game.world=world;
+    let mut host=CpuCanonicalHost::new_cohort(game,&trainer,(seed^(seed>>32)) as u32)?;
+    let initial=host.checkpoint(&trainer)?.residents[0].neural.clone();
+    let red=[0.9,0.1,0.1]; let blue=[0.1,0.1,0.9];
+    let mut exposures:Vec<Value>=Vec::new();
+    let order=[true,false,true,false]; // alternating safe and harmful; color mapping reverses independently.
+    for (episode,safe) in order.into_iter().enumerate() {
+        let is_red=if safe {safe_red} else {!safe_red}; let c=if is_red {red} else {blue};
+        let target=spawn(&mut host,own,&format!("exposure-{episode}"),c,0.25,0.,if safe {0.} else {0.3})?;
+        let mut hit=None; let mut pain=None;
+        for i in 0..64 {
+            let step=host.step(&trainer,1.)?;
+            if host.world().entity(target).ok_or("target lost")?.consumed {
+                hit=Some(i+1); pain=step.decisions.iter().find_map(|d| {let o=d.patch.outcome(); if o.physical.contact==PhysicalContactKind::Consumed && o.physical.target_entity==Some(target) {Some(o.pain_delta)} else {None}}); break;
+            }
+        }
+        exposures.push(json!({"episode":episode,"safe":safe,"is_red":is_red,"target":target.raw(),"consumed_at":hit,"pain_delta":pain}));
+        if hit.is_none() {
+            let report=json!({"schema":"cue-study-pilot-v1","seed":seed,"safe_red":safe_red,"red_left":red_left,"sham":std::env::var_os("ALIFE_RESEARCH_FAST_WRITE_SHAM").is_some(),"censored":"exposure_not_consumed","exposures":exposures});
+            let mut f=std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;f.write_all(&serde_json::to_vec_pretty(&report)?)?;return Ok(());
+        }
+    }
+    let (rz,bz)=if red_left {(-0.3,0.3)} else {(0.3,-0.3)};
+    let red_id=spawn(&mut host,own,"probe-red",red,0.25,rz,0.)?;
+    let blue_id=spawn(&mut host,own,"probe-blue",blue,0.25,bz,0.)?;
+    let mut choice=None; let mut steps=0; let mut trace=Vec::new();
+    for i in 0..64 {
+        let step=host.step(&trainer,1.)?; steps=i+1;
+        for d in &step.decisions { let o=d.patch.outcome(); trace.push(json!({"tick":i+1,"action":d.action,"contact":o.physical.contact,"target":o.physical.target_entity.map(|x|x.raw())})); }
+        let r=host.world().entity(red_id).ok_or("red lost")?.consumed;let b=host.world().entity(blue_id).ok_or("blue lost")?.consumed;
+        if r||b {choice=Some(if r&&b {"both"} else if r {"red"} else {"blue"}); break;}
+    }
+    let checkpoint=host.checkpoint(&trainer)?;let final_neural=&checkpoint.residents.iter().find(|r|r.neural.organism_id==own).ok_or("missing neural owner")?.neural;
+    let fast_changed=initial.fast.iter().zip(&final_neural.fast).filter(|(a,b)|a.to_bits()!=b.to_bits()).count();
+    let bytes=serde_json::to_vec(&checkpoint)?;let mut cold=CpuCanonicalHost::from_checkpoint(serde_json::from_slice(&bytes)?,&trainer)?;let mut warm=host.snapshot();warm.step(&trainer,1.)?;cold.step(&trainer,1.)?;
+    let exact=serde_json::to_vec(&warm.checkpoint(&trainer)?)? == serde_json::to_vec(&cold.checkpoint(&trainer)?)?;
+    let report=json!({"schema":"cue-study-pilot-v1","seed":seed,"safe_red":safe_red,"red_left":red_left,"sham":std::env::var_os("ALIFE_RESEARCH_FAST_WRITE_SHAM").is_some(),"exposures":exposures,"probe_red_id":red_id.raw(),"probe_blue_id":blue_id.raw(),"choice":choice,"choice_was_safe_cue":choice.map(|c| (c=="red") == safe_red),"probe_steps":steps,"fast_changed":fast_changed,"cold_next_exact":exact,"founder_optimizer_unchanged":founder_before==serde_json::to_vec(&trainer.checkpoint())?,"trace":trace});
+    let mut f=std::fs::OpenOptions::new().write(true).create_new(true).open(path)?;f.write_all(&serde_json::to_vec_pretty(&report)?)?;Ok(())
+}
