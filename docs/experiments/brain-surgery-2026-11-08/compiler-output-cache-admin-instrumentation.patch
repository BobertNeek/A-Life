+//! Administrative qualification only; not included in the candidate patch.
+use super::*;
+use std::time::Instant;
+fn uncached_reference(state: &GroupedMotorStateV1, source: &BrainPhenotype) -> Result<(), TrainingError> {
+        let expected = PhenotypeCompiler::compile_validated(
+            &state.source_inputs,
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+        )?;
+        if state.schema != HOST_SCHEMA
+            || state.work_policy != GROUPED_HOST_WORK_POLICY_V1
+            || state.m2_recipe != M2_RECIPE_SHA256
+            || state.group_recipe != RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256
+            || state.mode == MediationModeV1::DirectSource
+            || expected != *source
+            || state.source_hash != source.phenotype_hash()
+            || source.neuron_count() != 2048
+            || source.synapses().len() != 34048
+            || source.foundation_abi().motor_lobe_m0().is_some()
+            || !source
+                .candidate_decoder()
+                .factorized_motor_channels(source)?
+                .contains(&MotorChannel::Posture)
+        {
+            return Err(invalid());
+        }
+        Lowered::pinned(MANIFEST)?;
+        GroupedMotorStateV1::group_recipe()?;
+        for (bank, count, bounded) in [
+            (state.activations.as_slice(), ADDED, false),
+            (state.ema.as_slice(), ADDED, true),
+            (state.metabolic.as_slice(), ADDED, true),
+            (state.group_activations.as_slice(), 16, false),
+            (state.group_ema.as_slice(), 16, true),
+            (state.group_metabolic.as_slice(), 16, true),
+        ] {
+            if bank.len() != count
+                || bank
+                    .iter()
+                    .any(|x| !x.is_finite() || (bounded && !(0. ..=1.).contains(x)))
+            {
+                return Err(invalid());
+            }
+        }
+        match &state.last_receipt {
+            None if state.generation == 0 => (),
+            Some(r) if state.generation > 0 => {
+                let core = &r.native.core;
+                if core.source_hash != state.source_hash
+                    || core.mode != state.mode
+                    || core.final_generation != state.generation
+                    || core.source_generation.checked_add(1) != Some(state.generation)
+                    || core.source_execution_count != 1
+                    || core.appended_activations != state.activations
+                    || r.native.extension_activations != state.group_activations
+                    || r.native.schema != HOST_SCHEMA
+                    || r.native.recipe != state.group_recipe
+                    || core.schema != HOST_SCHEMA
+                    || core.recipe != state.m2_recipe
+                    || r.raw_memory.len() != core.components.len()
+                    || r.raw_cognitive.len() != core.components.len()
+                    || core.work != MediationWorkV1::expected()
+                    || !r.applied_body_energy_debit.is_finite()
+                    || r.applied_body_energy_debit < 0.
+                {
+                    return Err(invalid());
+                }
+                finite(&r.raw_memory)?;
+                finite(&r.raw_cognitive)?;
+                r.native.scores.validate_host_identity(
+                    state.source_hash,
+                    r.frame_digest,
+                    core.source_generation,
+                )?;
+            }
+            _ => return Err(invalid()),
+        }
+        Ok(())
+    }
+
+fn source_with_heads(head_count: u8, zero_priorities: bool) -> (BrainPhenotype, PhenotypeCompilerInputs, FoundationWeightAsset) {
+    let g = BrainGenome::scaffold(
+        0x4752_5031,
+        BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID,
+    );
+    let a = g.cognitive_architecture();
+    let heads = alife_core::genome::CognitiveArchitectureGenomeParameters::try_new_v1(
+        a.attention_capacity(),
+        a.active_concept_limit(),
+        a.active_gap_limit(),
+        a.predictor_capacity(),
+        a.predictor_learning_rate(),
+        head_count,
+        a.motor_head_width(),
+        a.dendritic_branch_capacity(),
+        a.structural_candidate_budget(),
+        a.structural_edit_budget(),
+        a.sleep_trigger_threshold(),
+        a.sleep_replay_rate(),
+        a.sleep_consolidation_rate(),
+        a.attention_learning_rate(),
+        a.concept_learning_rate(),
+        a.motor_learning_rate(),
+        a.structural_learning_rate(),
+    )
+    .unwrap();
+    let mut g = g.with_cognitive_architecture(heads).unwrap();
+    if zero_priorities {
+        g.innate_priority = Default::default();
+    }
+    let d = DevelopmentState::new(g.id, Tick::ZERO, NormalizedScalar::new(1.).unwrap());
+    let (p, i) = PhenotypeCompiler::compile_n2048_grounded_drive_basis(
+        g,
+        d,
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap();
+    let a = FoundationWeightAsset::from_trained_weights(
+        &p,
+        p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::bootstrap(),
+    )
+    .unwrap();
+    let (p, i) = PhenotypeCompiler::compile_n2048_grounded_drive_basis_candidate(
+        i.genome().clone(),
+        i.development().clone(),
+        a.clone(),
+    )
+    .unwrap();
+    (p, i, a)
+}
+
+fn timed(old: bool, state: &GroupedMotorStateV1, source: &BrainPhenotype) -> f64 {
+    let start = Instant::now();
+    if old { uncached_reference(state, source).unwrap(); }
+    else { state.validate(source).unwrap(); }
+    start.elapsed().as_secs_f64() * 1000.
+}
+pub(super) fn run() {
+    let (source, inputs, asset) = source_with_heads(4, false);
+    eprintln!("ADMIN_SOURCE construction=standard_fixed_arithmetic public_compile_entries=2 world_ticks=0 neural_steps=0");
+    let state = GroupedMotorStateV1::fresh(&inputs, &source, MediationModeV1::Full).unwrap();
+    let before = serde_json::to_vec(&state).unwrap();
+    let source_before = serde_json::to_vec(&source).unwrap();
+    let asset_before = asset.encode_canonical().unwrap();
+    let initial_count = GroupedMotorStateV1::validation_compile_count();
+    eprintln!("ADMIN_PROOF {:?}", state.validation_cache.get().unwrap());
+    let mut reference = Vec::new();
+    let mut cached = Vec::new();
+    for pair in 0..8 {
+        let (a, b) = if pair % 2 == 0 {
+            (timed(true, &state, &source), timed(false, &state, &source))
+        } else {
+            let b = timed(false, &state, &source);
+            (timed(true, &state, &source), b)
+        };
+        reference.push(a); cached.push(b);
+        assert_eq!(serde_json::to_vec(&state).unwrap(), before);
+        assert_eq!(serde_json::to_vec(&source).unwrap(), source_before);
+        assert_eq!(asset.encode_canonical().unwrap(), asset_before);
+        assert_eq!(GroupedMotorStateV1::validation_compile_count(), initial_count);
+        eprintln!("ADMIN_PAIR pair={pair} original_ms={a} cached_ms={b} cached_compile_delta=0 state_source_asset_bytes_equal=true");
+    }
+    eprintln!("ADMIN_SUMMARY reference_compile_entries=8 cached_compile_entries=0 original_total_ms={} cached_total_ms={}", reference.iter().sum::<f64>(), cached.iter().sum::<f64>());
+
+    eprintln!("ADMIN_FINISHED source_constructions=1 public_compile_entries=2 world_ticks=0 neural_steps=0 cache_compile_entries_total={}", GroupedMotorStateV1::validation_compile_count());
+}
