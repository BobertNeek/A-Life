+//! Qualification-only requested-live-byte counter. Not in production or timed admin binary.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::sync::atomic::{AtomicIsize, Ordering};
+static LIVE: AtomicIsize = AtomicIsize::new(0);
+pub fn live() -> isize { LIVE.load(Ordering::SeqCst) }
+struct Counted;
+unsafe impl GlobalAlloc for Counted {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let p = unsafe { System.alloc(layout) };
+        if !p.is_null() { LIVE.fetch_add(layout.size() as isize, Ordering::SeqCst); }
+        p
+    }
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        let p = unsafe { System.alloc_zeroed(layout) };
+        if !p.is_null() { LIVE.fetch_add(layout.size() as isize, Ordering::SeqCst); }
+        p
+    }
+    unsafe fn dealloc(&self, p: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(p, layout) };
+        LIVE.fetch_sub(layout.size() as isize, Ordering::SeqCst);
+    }
+    unsafe fn realloc(&self, p: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        let next = unsafe { System.realloc(p, layout, size) };
+        if !next.is_null() { LIVE.fetch_add(size as isize - layout.size() as isize, Ordering::SeqCst); }
+        next
+    }
+}
+#[global_allocator]
+static ALLOCATOR: Counted = Counted;
