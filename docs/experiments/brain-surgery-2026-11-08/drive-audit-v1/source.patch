+    let mut wire = serde_json::to_value(&inputs).unwrap();
+    fn corrupt(v: &mut serde_json::Value) -> bool {
+        match v {
+            serde_json::Value::Object(m) => {
+                if let Some(d) = m.get_mut("recipe_digest") {
+                    d[0] = serde_json::json!(0);
