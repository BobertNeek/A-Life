+                m.values_mut().any(corrupt)
+            }
+            _ => false,
+        }
+    }
+    assert!(corrupt(&mut wire));
+    match serde_json::from_value::<PhenotypeCompilerInputs>(wire) {
+        Ok(inputs) => assert!(
+            PhenotypeCompiler::compile_validated(&inputs, &BrainCapacityClass::n2048()).is_err()
+        ),
