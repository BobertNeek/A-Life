+//! Detached fresh-only biological drive sensitivity audit, never an autonomous life.
+#[path = "support/care_candidate.rs"]
+mod care_candidate;
+#[path = "support/world_swap_legacy_v12.rs"]
+mod world_swap_legacy_v12;
+use alife_core::*;
+use alife_gpu_backend::GpuV11CausalState;
+use alife_training::{
+    cpu::CpuFoundationTrainer, AdamWConfig, StageTrainableMask, TrainingInitialState,
+    TrainingReplayCandidate, TrainingReplayTick, TrainingSequence,
+};
+use serde_json::json;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+fn main() -> Result<()> {
+    let path = std::env::args().nth(1).ok_or("output required")?;
+    let (config, _, _) = care_candidate::source_memory_gain(2026110901)?;
+    let mut asset = world_swap_legacy_v12::construct()?;
+    let game =
+        alife_world::create_canonical_new_game_with_n2048_memory_gain_candidate(&config, &asset)?;
+    let record = game.world.organism_registry().iter().next().unwrap();
+    let genome = record.phenotype().brain_genome.clone();
+    let development = alife_runtime::canonical_preparation::foundation_construction_development(
+        &genome,
+        &BrainCapacityClass::n2048(),
+        &record.phenotype().development_state_at(Tick::ZERO)?,
+    )?;
+    let (p, _) = PhenotypeCompiler::compile_n2048_memory_gain_foundation_candidate(
+        genome,
+        development,
+        asset.clone(),
+    )?;
+    let (_, circuits) = care_candidate::whole_care(&p)?;
+    let offset: f32 = std::env::args().nth(2).map_or(Ok(0.), |s| s.parse())?;
+    let mut repair = serde_json::Value::Null;
+    let mut p = p;
+    if offset != 0. {
+        let mut weights = asset.weights().to_vec();
+        let targets = circuits
+            .iter()
+            .filter(|r| {
+                r["role"] == "need"
+                    && matches!(r["family"].as_str(), Some("Rest" | "Approach" | "Inspect"))
+            })
+            .map(|r| r["motor_neuron"].as_u64().unwrap() as u32)
+            .collect::<Vec<_>>();
+        let motor_start = p.candidate_decoder().motor_start();
+        let mut repairs = Vec::new();
+        for &target in &targets {
+            let edge = p
+                .synapses()
+                .iter()
+                .position(|s| {
+                    s.kind() == CompiledSynapseKind::Recurrent
+                        && s.target() == target
+                        && s.source() >= motor_start
+                        && s.source() < motor_start + 64
+                        && !targets.contains(&s.source())
+                        && p.projections()[s.route_index() as usize].projection_type()
+                            == ProjectionType::LateralInhibition
+                })
+                .ok_or("no saturated inhibitory motor donor")?;
+            weights[edge] = -offset;
+            repairs.push(json!({"offset":offset,"motor_edge":edge,"source":p.synapses()[edge].source(),"target":target,"route":p.synapses()[edge].route_index()}));
+        }
+        repair = json!(repairs);
+        asset = FoundationWeightAsset::from_trained_weights(
+            &p,
+            weights,
+            asset.manifest().training_stage(),
+        )?;
+        let record = game.world.organism_registry().iter().next().unwrap();
+        let genome = record.phenotype().brain_genome.clone();
+        let development =
+            alife_runtime::canonical_preparation::foundation_construction_development(
+                &genome,
+                &BrainCapacityClass::n2048(),
+                &record.phenotype().development_state_at(Tick::ZERO)?,
+            )?;
+        p = PhenotypeCompiler::compile_n2048_memory_gain_foundation_candidate(
+            genome,
+            development,
+            asset.clone(),
+        )?
+        .0;
+    }
+    let trainer = CpuFoundationTrainer::new(
+        p.clone(),
+        asset,
+        StageTrainableMask::recurrent_only(&p)?,
+        AdamWConfig::default(),
+    )?;
+    let before = serde_json::to_vec(&trainer.checkpoint())?;
+    let families = [
+        CandidateActionFamily::Idle,
+        CandidateActionFamily::Rest,
+        CandidateActionFamily::Inspect,
+        CandidateActionFamily::Approach,
+        CandidateActionFamily::Ingest,
+        CandidateActionFamily::Avoid,
+        CandidateActionFamily::Contact,
+        CandidateActionFamily::Other,
+    ];
+    let candidates = families
+        .iter()
+        .flat_map(|&family| {
+            [-0.85, 0.0, 0.85].map(|taste| {
+                let mut features = [0.; 54];
+                features[0] = 1.;
+                features[2] = 0.1;
+                features[6] = 0.5;
+                features[15] = taste;
+                features[18] = 1.;
+                features[23] = 1.;
+                TrainingReplayCandidate {
+                    family,
+                    decoder_inputs: features,
+                    innate_bias: 0.,
+                }
+            })
+        })
+        .collect::<Vec<_>>();
+    let mut initial = TrainingInitialState {
+        activations: vec![0.; p.neuron_count() as usize],
+        activity_ema: vec![0.; p.neuron_count() as usize],
+        metabolic_load: vec![0.; p.neuron_count() as usize],
+        dendrites: GpuV11CausalState::for_phenotype(&p)?
+            .dendritic_branches()
+            .clone(),
+    };
+    let dendrite_gain: f32 = std::env::args().nth(3).map_or(Ok(6.), |s| s.parse())?;
+    if dendrite_gain != 6. {
+        let mut branches = initial.dendrites.branches().to_vec();
+        for branch in &mut branches {
+            branch.output_gain = dendrite_gain;
+        }
+        initial.dendrites = DendriticBranchSet::new(branches)?;
+    }
+    let mut rows = Vec::new();
+    for lane in 0..11 {
+        for value in [0.1, 0.5, 0.9] {
+            let mut homeo = DriveSnapshot::baseline().to_array().to_vec();
+            homeo[lane] = value;
+            homeo.extend(EndocrineSnapshot::baseline().to_array());
+            let mut encoded = vec![0.; p.neuron_count() as usize];
+            for a in p.sensor_encoder().assignments() {
+                if a.source_group() == SensorEncoderSourceGroup::Homeostasis {
+                    let (lo, hi) = a.clamp_range();
+                    encoded[a.target_neuron() as usize] +=
+                        (homeo[a.source_index() as usize] * a.scale() + a.bias()).clamp(lo, hi);
+                }
+            }
+            let tick = TrainingReplayTick {
+                encoded_inputs: encoded,
+                projection_gain: 1.,
+                local_threshold_shift: 0.,
+                microstep_count: 3,
+                enabled_routes: vec![true; p.projections().len()],
+                effective_weight_offsets: vec![0.; p.synapses().len()],
+                structural_synapses: vec![],
+                candidates: candidates.clone(),
+            };
+            let sequence = TrainingSequence {
+                phenotype_hash: p.phenotype_hash(),
+                initial: initial.clone(),
+                ticks: vec![tick; 8],
+                burn_in_ticks: 0,
+                memory_candidate_gain: 12.,
+            };
+            let eval = trainer.evaluate_replay(&sequence)?;
+            rows.push(json!({"lane":lane,"value":value,"logits":eval.candidate_logits,"tonic_activations":eval.final_activations.iter().map(|a|a[383]).collect::<Vec<_>>(),"motor_activations":eval.final_activations.iter().map(|a|a[p.candidate_decoder().motor_start() as usize..(p.candidate_decoder().motor_start()+p.candidate_decoder().motor_width() as u32) as usize].to_vec()).collect::<Vec<_>>()}));
+        }
+    }
+    assert_eq!(before, serde_json::to_vec(&trainer.checkpoint())?);
+    let tonic_source = circuits.iter().find(|r| r["role"] == "tonic").unwrap()["source_neuron"]
+        .as_u64()
+        .unwrap() as u32;
+    assert_eq!(tonic_source, 383);
+    assert_eq!(p.neuron_dynamics()[tonic_source as usize].bias(), 0.);
+    assert!(!p
+        .sensor_encoder()
+        .assignments()
+        .iter()
+        .any(|a| a.target_neuron() == tonic_source));
+    assert!(!p
+        .synapses()
+        .iter()
+        .any(|s| s.kind() == CompiledSynapseKind::Recurrent && s.target() == tonic_source));
+    let mut reachability = Vec::new();
+    for lane in 0..11 {
+        let ports = p
+            .sensor_encoder()
+            .assignments()
+            .iter()
+            .filter(|a| {
+                a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                    && a.source_index() == lane
+            })
+            .map(|a| a.target_neuron())
+            .collect::<std::collections::BTreeSet<_>>();
+        let mut reached = ports.clone();
+        let mut queue = std::collections::VecDeque::from_iter(ports.iter().copied());
+        let mut families = std::collections::BTreeSet::new();
+        while let Some(n) = queue.pop_front() {
+            for (syn, w) in p
+                .synapses()
+                .iter()
+                .zip(trainer.weights())
+                .filter(|(syn, w)| syn.source() == n && w.abs() > 1e-9)
+            {
+                match syn.kind() {
+                    CompiledSynapseKind::Recurrent => {
+                        if reached.insert(syn.target()) {
+                            queue.push_back(syn.target());
+                        }
+                    }
+                    CompiledSynapseKind::Decoder(c)
+                        if c.head() == DecoderHeadKind::ActionCandidate =>
+                    {
+                        families.insert(format!("{:?}", c.family()));
+                    }
+                    _ => {}
+                }
+            }
+        }
+        reachability.push(json!({"lane":lane,"ports":ports,"nonzero_gene_reachable_neurons":reached,"reachable_nonzero_action_readouts":families}));
+    }
+    let report = json!({"scope":"Detached CPU encoded-input sensitivity; native birth dendrites, fixed three microsteps, every route enabled, eight frozen frames, no world actions or learning; not a cadence/ATP-policy assay", "dendrite_gain_intervention":dendrite_gain,"repair":repair,"circuits":circuits,"ports":p.sensor_encoder().assignments().iter().filter(|a|a.source_group()==SensorEncoderSourceGroup::Homeostasis).collect::<Vec<_>>(),"candidates":candidates,"rows":rows,"tonic_source_zero_with_no_global_shift_and_zero_initial_state":tonic_source,"weighted_reachability_necessary_not_sufficient":reachability,"optimizer_unchanged":true});
+    use std::io::Write;
+    std::fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(path)?
+        .write_all(&serde_json::to_vec_pretty(&report)?)?;
+    Ok(())
+}
