+//! Explicitly seeded fresh biological fixtures, not acquired learning or autonomous cohorts.
+#[path = "support/care_candidate.rs"]
+mod care_candidate;
+#[path = "support/drive_balance_candidate.rs"]
+mod drive_balance_candidate;
+#[path = "support/world_swap_legacy_v12.rs"]
+mod world_swap_legacy_v12;
+use alife_core::*;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask, TrainingSequence};
+use alife_world::*;
+use serde_json::json;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+fn main() -> Result<()> {
+    let out = std::env::args().nth(1).ok_or("output required")?;
+    let mode = std::env::args().nth(2).unwrap_or_else(|| "baseline".into());
+    let candidate = mode != "baseline";
+    let recalibrate = mode == "recalibrated" || mode == "geometry" || mode=="distance";
+    let geometry = mode == "geometry";
+    let asset = if candidate {
+        if mode=="distance" {drive_balance_candidate::construct_parameters(true,1.,80./6.)?} else {drive_balance_candidate::construct_factors(recalibrate, geometry)?}
+    } else {
+        world_swap_legacy_v12::construct()?
+    };
+    let (config, _, _) = care_candidate::source_memory_gain(2026110901)?;
+    let new_game = |asset: &FoundationWeightAsset| {
+        if candidate {
+            create_canonical_new_game_with_n2048_drive_balance_candidate(&config, asset)
+        } else {
+            create_canonical_new_game_with_n2048_memory_gain_candidate(&config, asset)
+        }
+    };
+    let base = new_game(&asset)?;
+    let record = base.world.organism_registry().iter().next().unwrap();
+    let genome = record.phenotype().brain_genome.clone();
+    let development = alife_runtime::canonical_preparation::foundation_construction_development(
+        &genome,
+        &BrainCapacityClass::n2048(),
+        &record.phenotype().development_state_at(Tick::ZERO)?,
+    )?;
+    let p = if candidate {
+        PhenotypeCompiler::compile_n2048_drive_balance_foundation_candidate(
+            genome,
+            development,
+            asset.clone(),
+        )?
+        .0
+    } else {
+        PhenotypeCompiler::compile_n2048_memory_gain_foundation_candidate(
+            genome,
+            development,
+            asset.clone(),
+        )?
+        .0
+    };
+    let trainer = CpuFoundationTrainer::new(
+        p.clone(),
+        asset.clone(),
+        StageTrainableMask::recurrent_only(&p)?,
+        AdamWConfig::default(),
+    )?;
+    let ck = serde_json::to_vec(&trainer.checkpoint())?;
+    let (_, circuits) = care_candidate::whole_care(&p)?;
+    let mut bridge_ids = std::collections::BTreeSet::new();
+    for c in &circuits {
+        if let Some(ids) = c["bridge_synapses"].as_array() {
+            for id in ids {
+                bridge_ids.insert(id.as_u64().unwrap() as usize);
+            }
+        }
+        if let Some(id) = c["output_synapse"].as_u64() {
+            bridge_ids.insert(id as usize);
+        }
+    }
