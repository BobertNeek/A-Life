+use alife_core::*;
+use alife_gpu_backend::GpuV11CausalState;
+#[test]
+fn birth_gain_is_identity_scoped_and_restore_keeps_acquired_branches() {
+    let g = BrainGenome::scaffold(0x2048_2026, BrainCapacityClass::N2048_ID);
+    let d = DevelopmentState::new(g.id, Tick::ZERO, NormalizedScalar::new(1.).unwrap());
+    let (old, _) = PhenotypeCompiler::compile_n2048_memory_gain_graph(
+        g.clone(),
+        d.clone(),
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap();
+    let (new, _) = PhenotypeCompiler::compile_n2048_drive_balance_graph(
+        g,
+        d,
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap();
+    let upload = alife_gpu_backend::GpuPhenotypeUpload::try_from(&new).unwrap();
+    assert_eq!(upload.source_indices.len(), 24_576);
+    assert_eq!(upload.neuron_count, 2048);
+    assert_eq!(upload.genetic_weights.len(), 32_768);
+    let old = GpuV11CausalState::for_phenotype(&old).unwrap();
+    let new = GpuV11CausalState::for_phenotype(&new).unwrap();
+    assert_eq!(new.dendritic_branches().branches().len(), 64);
+    for (before, after) in old
+        .dendritic_branches()
+        .branches()
+        .iter()
+        .zip(new.dendritic_branches().branches())
+    {
+        assert_eq!(before.output_gain, 6.0);
+        assert_eq!(after.output_gain, 0.5);
+        let mut expected = before.clone();
+        expected.output_gain = 0.5;
+        assert_eq!(&expected, after);
+    }
+    let mut checkpoint = new.checkpoint();
+    let mut branches = checkpoint.dendritic_branches.branches().to_vec();
+    branches[0].output_gain = 2.25;
+    branches[0].threshold = -0.25;
+    checkpoint.dendritic_branches = DendriticBranchSet::new(branches).unwrap();
+    let bytes = serde_json::to_vec(&checkpoint).unwrap();
+    let restored = GpuV11CausalState::restore(checkpoint).unwrap();
+    assert_eq!(serde_json::to_vec(&restored.checkpoint()).unwrap(), bytes);
+}
