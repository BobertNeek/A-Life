+//! Controlled chemical time-scale envelope, not a living creature or policy assay.
+#[path = "support/care_candidate.rs"]
+mod care_candidate;
+use alife_core::*;
+use alife_world::*;
+use serde_json::json;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+fn main() -> Result<()> {
+    let out = std::env::args().nth(1).ok_or("output required")?;
+    let (config, p, asset) = care_candidate::source_memory_gain(2026110901)?;
+    let game = create_canonical_new_game_with_n2048_memory_gain_candidate(&config, &asset)?;
+    let record = game.world.organism_registry().iter().next().unwrap();
+    let phenotype = record.phenotype();
+    let graph = &phenotype.chemistry.biochemical;
+    let lifetime = PassiveBodyUpkeepPolicy::maximum_lifespan_ticks(phenotype);
+    let mut body = record.biochemistry().body;
+    body.set_energy(0.8)?;
+    let mut state = BiochemicalGraphState::new(graph, Tick::ZERO, 1.)?;
+    let mut rows = vec![json!({"tick":0,"homeostasis":state.derive_homeostasis(graph)?})];
+    for t in 1..=lifetime {
+        state = state
+            .advance(Tick(t), body, BodyEventDelta::zero(), None, graph, 1.)?
+            .0;
+        if t % 250 == 0 || t == lifetime {
+            rows.push(json!({"tick":t,"homeostasis":state.derive_homeostasis(graph)?}));
+        }
+    }
+    let before = state.derive_homeostasis(graph)?;
+    let rest = state
+        .advance(
+            Tick(lifetime + 1),
+            body,
+            BodyEventDelta {
+                sleep_recovery: 1.,
+                ..BodyEventDelta::zero()
+            },
+            None,
+            graph,
+            1.,
+        )?
+        .0
+        .derive_homeostasis(graph)?;
+    let play = state
+        .advance(
+            Tick(lifetime + 1),
+            body,
+            BodyEventDelta {
+                play_stimulation: 1.,
+                ..BodyEventDelta::zero()
+            },
+            None,
+            graph,
+            1.,
+        )?
+        .0
+        .derive_homeostasis(graph)?;
+    let food = state
+        .advance(
+            Tick(lifetime + 1),
+            body,
+            BodyEventDelta {
+                nutrition: 1.,
+                ..BodyEventDelta::zero()
+            },
+            None,
+            graph,
+            1.,
+        )?
+        .0
+        .derive_homeostasis(graph)?;
+    let social = state
+        .advance(
+            Tick(lifetime + 1),
+            body,
+            BodyEventDelta {
+                social_contact: 1.,
+                ..BodyEventDelta::zero()
+            },
+            None,
+            graph,
+            1.,
+        )?
+        .0
+        .derive_homeostasis(graph)?;
+    use std::io::Write;
+    std::fs::OpenOptions::new().create_new(true).write(true).open(out)?.write_all(&serde_json::to_vec_pretty(&json!({"scope":"Upper-expression chemical envelope only: body held awake with fixed energy.8 and no neural cost; no actual world lifetime or choice. Acute event branches use same ending chemical state.","sleep_thresholds":alife_runtime::canonical_preparation::sleep_consolidation_config_for(&p)?,"maximum_lifespan_ticks":lifetime,"body":body,"graph":graph,"rows":rows,"before":before,"rest_event":rest,"play_event":play,"food_event":food,"social_event":social}))?)?;
+    Ok(())
+}
