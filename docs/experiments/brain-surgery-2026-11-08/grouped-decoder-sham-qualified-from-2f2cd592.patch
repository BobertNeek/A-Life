+#!/usr/bin/env python3
+"""Read-only, bounded source witnesses; not a runtime-equivalence proof."""
+import hashlib
+import json
+from pathlib import Path
+import re
+import subprocess
+
+BASE = "2f2cd592ef7a05d199dd1bc3353afdd7f49bcee7"
+ROOT = Path(__file__).resolve().parents[1]
+PREFIX = "crates/alife_training/src/cpu/"
+
+def body(text, name):
+    match = re.search(r"\bfn " + re.escape(name) + r"\b", text)
+    assert match, name
+    start = match.start()
+    brace = text.index("{", match.end())
+    depth = 0
+    # These selected bodies contain balanced braces in their literals/comments.
+    for end in range(brace, len(text)):
+        depth += (text[end] == "{") - (text[end] == "}")
+        if depth == 0:
+            return text[start:end + 1]
+    raise AssertionError(name)
+
+checks = {
+    "grouped_decoder_envelope.rs": None,
+    "grouped_closed_literal_witness.rs": None,
+    "organism.rs": ["stage_selection", "apply_credit", "stage_grouped_closed_selection", "close_grouped_outcome"],
+    "organism_grouped_decoder.rs": ["grouped_decoder_fast_update", "grouped_decoder_work_bound"],
+    "host.rs": ["resident_digest", "resident_authority", "validate_resident_authority"],
+    "motor_mediation/confidence/policy.rs": None,
+}
+results = []
+for file, names in checks.items():
+    path = PREFIX + file
+    old = subprocess.check_output(["git", "show", BASE + ":" + path], cwd=ROOT, text=True)
+    new = (ROOT / path).read_text()
+    for name in names or [None]:
+        left, right = (body(old, name), body(new, name)) if name else (old, new)
+        assert left == right, (path, name)
+        results.append({"source": path, "function": name, "sha256": hashlib.sha256(right.encode()).hexdigest(), "unchanged": True})
+print(json.dumps({"base": BASE, "interpretation": "Exact selected source bodies only; shared mode branches still require native FULL/closed byte witnesses.", "checks": results}, indent=2))
