+#[test]
+fn grouped_decoder_bounded_ordinary_awake_rest_receipt_and_update() {
+    // Fixed existing fresh fixture, 240 ordinary preparation ticks, at most 24
+    // native intervals. No action/concentration override and no seed search.
+    let (mut host, _) = learning_fixture_at(240);
+    let mut found = false;
+    for _ in 0..24 {
+        let step = host.step(0.73).unwrap();
+        for d in &step.decisions {
+            if d.physical.operation == Some(RecoveryOperationV1::AwakeRest)
+                && d.physical.awake_recovery > 0.
+            {
+                let credit = host.last_credit(d.organism_id).unwrap();
+                assert!(credit.nonzero_eligibility > 0 && credit.changed_fast_coordinates > 0);
+                assert!(!d.physical.body_sleeping);
+                let physical = d.diagnostic.physical_transition.unwrap();
+                let sealed = d.patch.outcome().measured_physiology.unwrap();
+                let sealed_credit = OutcomeCreditPacket::from_sealed_patch(&d.patch)
+                    .unwrap()
+                    .with_biochemical_receptors(&d.diagnostic.receptors)
+                    .unwrap();
+                eprintln!(
+                    "GDE1_AWAKE_REST_SEALED_MODULATOR {:?}",
+                    sealed_credit.modulator()
+                );
+                eprintln!("GDE1_REAL_PHYSICAL_AWAKE_REST tick={} recovery_dose={} physical_fatigue_delta={} physical_energy_delta={} sealed_energy_delta={} body_debit={} changed={} (joint feedback includes both physical recovery and computational cost; no isolated channel reward)",step.tick_before.raw(),d.physical.awake_recovery,physical.homeostatic_delta.drives.fatigue,physical.energy_delta.raw(),sealed.energy_delta.raw(),d.motor.applied_body_energy_debit,credit.changed_fast_coordinates);
+                assert!(
+                    physical.homeostatic_delta.drives.fatigue < 0.,
+                    "physical recovery dose did not establish measured fatigue relief"
+                );
+                if let Ok(directory) = std::env::var("ALIFE_GDE1_EVIDENCE_DIR") {
+                    std::fs::create_dir_all(&directory).unwrap();
+                    let evidence = serde_json::json!({"interpretation":"actual physical fatigue relief plus compute-inclusive joint feedback; no isolated channel reward", "physical_transition":physical,"sealed_transition":sealed,"physical_receipt":d.physical,"credit":credit,"sealed_modulator":sealed_credit.modulator(),"patch":d.patch});
+                    std::fs::write(
+                        std::path::Path::new(&directory).join("awake-rest-physical.json"),
+                        serde_json::to_vec_pretty(&evidence).unwrap(),
+                    )
+                    .unwrap();
+                }
+                found = true;
+            }
+        }
+        if found {
+            break;
+        }
+    }
+    assert!(found,"No physical AwakeRest relief+decoder update in declared 24-interval bound; this is an unmet qualification, not permission to retune seed or coefficients");
+}
