+//! Synthetic arithmetic controls only. These are not world-learning evidence.
+use super::*;
+use crate::cpu::CpuDecisionBinding;
+
+fn binding_for(
+    frame: &PerceptionFrame,
+    receipt: &GroupedMotorReceiptV1,
+    action: &RecoveryGroupJointActionV2,
+) -> CpuDecisionBinding {
+    let (representative, slots) = receipt.native.scores.physical_selection(action).unwrap();
+    let candidate = &frame.candidates()[representative as usize];
+    let bundle = MotorCommandBundle::new(
+        frame.organism_id(),
+        ExperienceSequenceId(1),
+        frame.tick(),
+        vec![],
+    )
+    .unwrap();
+    CpuDecisionBinding {
+        sequence_id: ExperienceSequenceId(1),
+        frame_digest: frame.frame_digest(),
+        action_id: candidate.action_id,
+        candidate_feature_digest: candidate.feature_digest().unwrap(),
+        dispatch_generation: receipt.native.core.final_generation,
+        active_activation_side: 0,
+        joint_selection: JointActionSelectionV1::new(
+            slots.map(|i| i.map_or(0, |i| i + 1)),
+            &bundle,
+        )
+        .unwrap(),
+    }
+}
+#[test]
+fn grouped_decoder_sparse_pullback_matches_dense_diagnostic_and_finite_differences() {
+    let (mut motor, founder, mut q, f, receptors, effects) = fixture();
+    motor.enable_decoder_learning_fresh().unwrap();
+    let p = founder.phenotype();
+    let memory_row = p.synapses().iter().position(|s| matches!(s.kind(), CompiledSynapseKind::Decoder(d) if d.head()==DecoderHeadKind::MemoryContext && d.family()==CandidateActionFamily::Rest)).unwrap();
+    let CompiledSynapseKind::Decoder(memory) = p.synapses()[memory_row].kind() else {
+        panic!()
+    };
+    q.ticks[0].effective_weight_offsets[memory_row] = 0.125;
+    q.ticks[0].candidates[1].decoder_inputs[memory.input_lane() as usize] = 0.25;
+    q.ticks[0].candidates[6].decoder_inputs[memory.input_lane() as usize] = 0.75;
+    for mask in [127, (1 << 1) | (1 << 6)] {
+        let mut executed = motor.clone();
+        let tape = executed
+            .forward(
+                p,
+                founder.weights(),
+                &q,
+                &f,
+                &receptors,
+                &effects,
+                [true; 6],
+                mask,
+            )
+            .unwrap();
+        let receipt = executed.last_receipt.as_ref().unwrap();
+        let action = receipt.native.scores.sample(0x47444531, 0, 0.73).unwrap();
+        let binding = binding_for(&f, receipt, &action);
+        let (gradient, _) = receipt
+            .decoder_score_gradient(
+                p,
+                &q.ticks[0],
+                &tape.evaluation.final_activations[0],
+                &action,
+                &f,
+                &binding,
+            )
+            .unwrap();
+        // Independently form the existing diagnostic's dense ordinary/common/
+        // operation Jacobian and compare before any eligibility clipping.
+        let mut ordinary = projected_credit(
+            p,
+            &q.ticks[0],
+            &tape.evaluation.final_activations[0],
+            &receipt.native.core,
+        )
+        .unwrap();
+        for i in receipt.native.scores.binding.operations.iter().flatten() {
+            ordinary[*i].fill(0.);
+        }
+        let canonical =
+            CandidateFeatureVector::zero().with_intrinsic_action_basis(ActionKind::Rest);
+        let mut input = [0.; 54];
+        input[..24].copy_from_slice(&canonical.0);
+        let mut common = vec![0.; p.synapses().len()];
+        let mut operation = [vec![0.; p.synapses().len()], vec![0.; p.synapses().len()]];
+        for (j, s) in p.synapses().iter().enumerate() {
+            let CompiledSynapseKind::Decoder(d) = s.kind() else {
+                continue;
+            };
+            if d.family() != CandidateActionFamily::Rest {
+                continue;
+            }
+            if d.head() == DecoderHeadKind::ActionCandidate {
+                common[j] = receipt.native.group_jacobian[0]
+                    * tape.evaluation.final_activations[0][s.source() as usize]
+                    * input[d.input_lane() as usize];
+            } else if d.head() == DecoderHeadKind::MemoryContext {
+                for (o, row) in operation.iter_mut().enumerate() {
+                    if let Some(i) = receipt.native.scores.binding.operations[o] {
+                        row[j] = receipt.native.operation_context_jacobians[o][0]
+                            * receipt.native.core.upstream_context_slopes[i][0]
+                            * q.ticks[0].candidates[i].decoder_inputs[d.input_lane() as usize];
+                    }
+                }
+            }
+        }
+        let probe = RecoveryGroupProbeResultV2 {
+            source_evaluation: tape.evaluation,
+            receipt: receipt.native.clone(),
+            ordinary_decoder_derivatives: ordinary,
+            group_decoder_derivatives: common,
+            operation_decoder_derivatives: operation,
+        };
+        let dense = probe
+            .decoder_log_probability_gradient(
+                &receipt.native.scores.evaluate(&action).unwrap().gradient,
+            )
+            .unwrap();
+        assert!(gradient
+            .iter()
+            .zip(&dense)
+            .all(|(a, b)| (a - b).abs() < 1e-12));
+        let mut tested = 0;
+        for head in [
+            DecoderHeadKind::ActionCandidate,
+            DecoderHeadKind::MemoryContext,
+        ] {
+            let row = p
+                .synapses()
+                .iter()
+                .enumerate()
+                .filter(
+                    |(_, s)| matches!(s.kind(),CompiledSynapseKind::Decoder(d) if d.head()==head),
+                )
+                .max_by(|(a, _), (b, _)| gradient[*a].abs().total_cmp(&gradient[*b].abs()))
+                .unwrap()
+                .0;
+            if gradient[row].abs() < 1e-8 {
+                continue;
+            }
+            let epsilon = 0.002_f32;
+            let evaluate = |sign: f32| {
+                let mut perturbed = q.clone();
+                perturbed.ticks[0].effective_weight_offsets[row] += sign * epsilon;
+                let mut m = motor.clone();
+                m.forward(
+                    p,
+                    founder.weights(),
+                    &perturbed,
+                    &f,
+                    &receptors,
+                    &effects,
+                    [true; 6],
+                    mask,
+                )
+                .unwrap();
+                m.last_receipt
+                    .unwrap()
+                    .native
+                    .scores
+                    .evaluate(&action)
+                    .unwrap()
+                    .joint_log_probability
+            };
+            let fd = (evaluate(1.) - evaluate(-1.)) / (2. * f64::from(epsilon));
+            assert!(
+                (fd - gradient[row]).abs() < 2e-3 + gradient[row].abs() * 0.02,
+                "head={head:?} row={row} analytic={} fd={fd}",
+                gradient[row]
+            );
+            tested += 1;
+        }
+        assert!(tested > 0);
+        if mask != 127 {
+            assert!(gradient[memory_row].abs() > 1e-6);
+        }
+    }
+}
+#[test]
+fn grouped_decoder_clipped_operation_memory_has_zero_local_derivative() {
+    let (mut motor, founder, mut q, f, receptors, effects) = fixture();
+    motor.enable_decoder_learning_fresh().unwrap();
+    let p = founder.phenotype();
+    let row=p.synapses().iter().position(|s|matches!(s.kind(),CompiledSynapseKind::Decoder(d) if d.head()==DecoderHeadKind::MemoryContext && d.family()==CandidateActionFamily::Rest)).unwrap();
+    let CompiledSynapseKind::Decoder(d) = p.synapses()[row].kind() else {
+        panic!()
+    };
+    q.ticks[0].effective_weight_offsets[row] = 100.;
+    for i in [1, 6] {
+        q.ticks[0].candidates[i].decoder_inputs[d.input_lane() as usize] = 0.75;
+    }
+    let mask = (1 << 1) | (1 << 6);
+    let mut executed = motor.clone();
+    let tape = executed
+        .forward(
+            p,
+            founder.weights(),
+            &q,
+            &f,
+            &receptors,
+            &effects,
+            [true; 6],
+            mask,
+        )
+        .unwrap();
+    let receipt = executed.last_receipt.as_ref().unwrap();
+    assert_eq!(receipt.native.core.upstream_context_slopes[1][0], 0.);
+    assert_eq!(receipt.native.core.upstream_context_slopes[6][0], 0.);
+    let action = receipt.native.scores.sample(0x47444531, 0, 1.37).unwrap();
+    let (gradient, _) = receipt
+        .decoder_score_gradient(
+            p,
+            &q.ticks[0],
+            &tape.evaluation.final_activations[0],
+            &action,
+            &f,
+            &binding_for(&f, receipt, &action),
+        )
+        .unwrap();
+    assert_eq!(gradient[row], 0.);
+    let base = receipt
+        .native
+        .scores
+        .evaluate(&action)
+        .unwrap()
+        .joint_log_probability;
+    q.ticks[0].effective_weight_offsets[row] += 0.01;
+    motor
+        .forward(
+            p,
+            founder.weights(),
+            &q,
+            &f,
+            &receptors,
+            &effects,
+            [true; 6],
+            mask,
+        )
+        .unwrap();
+    assert_eq!(
+        motor
+            .last_receipt
+            .unwrap()
+            .native
+            .scores
+            .evaluate(&action)
+            .unwrap()
+            .joint_log_probability
+            .to_bits(),
+        base.to_bits()
+    );
+}
