+        panic!()
+    };
+    let CompiledSynapseKind::Decoder(ca) = p.synapses()[common_action].kind() else {
+        panic!()
+    };
+    let cases = [
+        (
+            ordinary_action,
+            0,
+            base.native.core.jacobians[ordinary][0]
+                * activation[p.synapses()[ordinary_action].source() as usize]
+                * q.ticks[0].candidates[ordinary].decoder_inputs[oa.input_lane() as usize],
+        ),
+        (
+            ordinary_memory,
+            0,
+            base.native.core.jacobians[ordinary][2]
+                * base.native.core.upstream_context_slopes[ordinary][0]
+                * q.ticks[0].candidates[ordinary].decoder_inputs[om.input_lane() as usize],
+        ),
+        (
+            common_action,
+            1,
+            base.native.group_jacobian[0]
+                * activation[p.synapses()[common_action].source() as usize]
+                * canonical.0[ca.input_lane() as usize],
+        ),
+        (
+            rest_memory,
+            2,
+            base.native.operation_context_jacobians[0][0]
+                * base.native.core.upstream_context_slopes[1][0]
+                * q.ticks[0].candidates[1].decoder_inputs[rm.input_lane() as usize],
+        ),
+        (
+            rest_memory,
+            3,
+            base.native.operation_context_jacobians[1][0]
+                * base.native.core.upstream_context_slopes[6][0]
+                * q.ticks[0].candidates[6].decoder_inputs[rm.input_lane() as usize],
+        ),
+    ];
+    for (row, port, analytic) in cases {
+        assert!(
+            analytic.abs() > 1e-6,
+            "raw chain {port} did not exercise a nonzero derivative"
+        );
+        let get = |sign: f32| {
+            let mut q = q.clone();
+            q.ticks[0].effective_weight_offsets[row] += sign * 0.002;
+            let (r, _) = run(&q);
+            match port {
+                0 => r.native.scores.ordinary[ordinary],
+                1 => r.native.scores.group,
+                2 => r.native.scores.operations[0],
+                3 => r.native.scores.operations[1],
+                _ => unreachable!(),
+            }
+        };
+        let fd = (get(1.) - get(-1.)) / 0.004;
+        assert!(
+            (fd - f64::from(analytic)).abs() < 2e-3 + f64::from(analytic.abs()) * 0.02,
+            "port={port} analytic={analytic} fd={fd}"
+        );
+    }
+}
