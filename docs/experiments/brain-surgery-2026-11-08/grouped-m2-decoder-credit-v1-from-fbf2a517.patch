+#[test]
+fn grouped_decoder_preserves_nonzero_frozen_banks_and_structural_sentinels() {
+    // Synthetic nonzero preservation sentinels, not acquired-learning evidence.
+    let (mut warm, inputs) = learning_fixture();
+    warm.step(0.73).unwrap();
+    inject_frozen_sentinels(&mut warm.inner);
+    let frozen_banks = |host: &CpuGroupedM2DecoderHostV1| {
+        let p = host.inner.founder.phenotype();
+        let r = host.inner.host.residents.values().next().unwrap();
+        let n = r.neural.checkpoint().unwrap();
+        let closed = p
+            .synapses()
+            .iter()
+            .enumerate()
+            .filter(|(_, s)| !grouped_decoder_coordinate(s.kind()))
+            .map(|(i, _)| (i, n.fast[i].to_bits(), n.eligibility[i].to_bits()))
+            .collect::<Vec<_>>();
+        bytes(&(
+            closed,
+            n.lifetime,
+            n.neural.dendrites,
+            r.v11.checkpoint(),
+            host.inner.founder.checkpoint(),
+        ))
+    };
+    let sentinel = frozen_banks(&warm);
+    let wire = warm.checkpoint().unwrap().encode().unwrap();
+    let mut cold = CpuGroupedM2DecoderHostV1::restore(
+        CpuGroupedM2DecoderCheckpointV1::decode(&wire).unwrap(),
+        &inputs,
+        MediationModeV1::Full,
+    )
+    .unwrap();
+    for _ in 0..3 {
+        warm.step(0.73).unwrap();
+        cold.step(0.73).unwrap();
+        assert_eq!(frozen_banks(&warm), sentinel);
+        assert_eq!(frozen_banks(&cold), sentinel);
+        assert_eq!(
+            warm.checkpoint().unwrap().encode().unwrap(),
+            cold.checkpoint().unwrap().encode().unwrap()
+        );
+    }
+}
