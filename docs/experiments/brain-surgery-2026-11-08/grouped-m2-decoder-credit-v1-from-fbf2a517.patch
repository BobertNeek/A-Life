+#[test]
+fn grouped_decoder_specialized_derived_vocal_lane_finite_difference_and_mask() {
+    // Arithmetic fixture only. Lane42 must come from the real profile5 derived
+    // feature function, never a manual input override or reward/action forcing.
+    let (mut motor, founder, q, f, receptors, effects) = fixture();
+    motor.enable_decoder_learning_fresh().unwrap();
+    let p = founder.phenotype();
+    assert_eq!(q.ticks[0].candidates[2].decoder_inputs[42], 1.);
+    let derived = prepare_sleep_choice_grounded_drive_features_v1(&f).unwrap();
+    assert_eq!(derived[2][6], 1.);
+    for mask in [127, 127 & !(1 << 2)] {
+        let mut executed = motor.clone();
+        let tape = executed
+            .forward(
+                p,
+                founder.weights(),
+                &q,
+                &f,
+                &receptors,
+                &effects,
+                [true; 6],
+                mask,
+            )
+            .unwrap();
+        let receipt = executed.last_receipt.as_ref().unwrap();
+        let action = receipt.native.scores.sample(0x47444531, 0, 1.37).unwrap();
+        let (gradient, _) = receipt
+            .decoder_score_gradient(
+                p,
+                &q.ticks[0],
+                &tape.evaluation.final_activations[0],
+                &action,
+                &f,
+                &binding_for(&f, receipt, &action),
+            )
+            .unwrap();
+        let row=p.synapses().iter().enumerate().filter(|(_,s)|matches!(s.kind(),CompiledSynapseKind::Decoder(d) if d.head()==DecoderHeadKind::ActionCandidate && d.family()==CandidateActionFamily::Other && d.input_lane()==42))
+            .max_by(|(a,_),(b,_)| tape.evaluation.final_activations[0][p.synapses()[*a].source() as usize].abs().total_cmp(&tape.evaluation.final_activations[0][p.synapses()[*b].source() as usize].abs())).unwrap().0;
+        let get = |sign: f32| {
+            let mut q = q.clone();
+            q.ticks[0].effective_weight_offsets[row] += sign * 0.002;
+            let mut m = motor.clone();
+            m.forward(
+                p,
+                founder.weights(),
+                &q,
+                &f,
+                &receptors,
+                &effects,
+                [true; 6],
+                mask,
+            )
+            .unwrap();
+            m.last_receipt
+                .unwrap()
+                .native
+                .scores
+                .evaluate(&action)
+                .unwrap()
+                .joint_log_probability
+        };
+        let fd = (get(1.) - get(-1.)) / 0.004;
+        if mask == 127 {
+            assert!(
+                gradient[row].abs() > 1e-6,
+                "derived specialized lane was not meaningfully exercised"
+            );
+            assert!(
+                (fd - gradient[row]).abs() < 2e-3 + gradient[row].abs() * 0.02,
+                "analytic={} finite_difference={fd}",
+                gradient[row]
+            );
+        } else {
+            assert_eq!(gradient[row], 0.);
+            assert_eq!(fd, 0.);
+        }
+    }
+}
