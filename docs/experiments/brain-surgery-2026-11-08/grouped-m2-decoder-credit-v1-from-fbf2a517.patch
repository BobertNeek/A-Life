index 0000000000000000000000000000000000000000..725e8ec1e6ac87257b18e4e765f1de02098c3e48
--- /dev/null
+++ b/crates/alife_training/src/cpu/grouped_decoder_envelope.rs
@@ -0,0 +1,147 @@
+//! Distinct fresh GDE1 admission. The closed and all old checkpoint prefixes
+//! are rejected before any source, world or positional enum decoding.
+use super::*;
+const DECODER_MAGIC: &[u8] =
+    b"ALIFE-GROUPED-M2-DECODER-HOST\0V1\0SCORE-TRACE-FAST1\0PROFILE5\0SAMPLER-BITS1\0";
+pub(super) const DECODER_LINEAGE: &str =
+    "fresh-grouped-m2-decoder-v1/confidence-v2/class5/no-historical-import";
+pub(super) const DECODER_POLICY: &str = "grouped-decoder-score-trace-fast-v1;action-memory-only;one-source-tape;fixed-appendage;no-lifetime-normalization-synaptic-sleep-adam-bptt;canonical-memory-predictor;one-cognitive-debit";
+
+pub struct CpuGroupedM2DecoderHostV1 {
+    pub(super) inner: CpuGroupedM2HostV1,
+}
+#[derive(Debug, Clone)]
+pub struct CpuGroupedM2DecoderCheckpointV1 {
+    payload: GroupedPayloadV1,
+}
+impl CpuGroupedM2DecoderCheckpointV1 {
+    pub fn encode(&self) -> Result<Vec<u8>, CpuHostError> {
+        let mut wire = DECODER_MAGIC.to_vec();
+        wire.extend(serde_json::to_vec(&self.payload)?);
+        Ok(wire)
+    }
+    pub fn decode(wire: &[u8]) -> Result<Self, CpuHostError> {
+        let body = wire.strip_prefix(DECODER_MAGIC).ok_or(CpuHostError::State(
+            "not a fresh grouped decoder V1 envelope",
+        ))?;
+        let metadata: serde_json::Value = serde_json::from_slice(body)?;
+        if metadata["schema_version"] != 1
+            || metadata["source_lineage"] != DECODER_LINEAGE
+            || metadata["policy"] != DECODER_POLICY
+            || metadata["runtime_profile_raw"] != 5
+            || metadata["selector_tag"] != 12
+            || metadata["decoder_stride"] != 55
+            || metadata["recipe_digest"] != RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256
+        {
+            return Err(CpuHostError::State(
+                "grouped decoder outer identity mismatch",
+            ));
+        }
+        let mut payload: GroupedPayloadV1 = serde_json::from_value(metadata.clone())?;
+        payload.restore_sampler_bits()?;
+        if payload
+            .controllers
+            .values()
+            .any(|s| s.decoder_learning.is_none() || !s.motor.decoder_learning())
+            || serde_json::from_slice::<serde_json::Value>(&serde_json::to_vec(&payload)?)?
+                != metadata
+        {
+            return Err(CpuHostError::State("grouped decoder noncanonical state"));
+        }
+        Ok(Self { payload })
+    }
+}
+impl CpuGroupedM2DecoderHostV1 {
+    pub fn new_prepared<T, E: std::fmt::Display>(
+        game: CanonicalNewGame,
+        founder: CpuFoundationTrainer,
+        source_inputs: PhenotypeCompilerInputs,
+        sampling_seed: u32,
+        mode: MediationModeV1,
+        prepare: impl FnOnce(&mut HeadlessWorld) -> Result<T, E>,
+    ) -> Result<(Self, T), CpuHostError> {
+        if founder.phenotype().synapses().iter().any(|s| matches!(s.kind(), CompiledSynapseKind::Decoder(d) if d.head() == DecoderHeadKind::CognitiveContext)) {
+            return Err(CpuHostError::State("GDE1 does not admit a CognitiveContext decoder"));
+        }
+        let (mut inner, prepared) = CpuGroupedM2HostV1::new_prepared(
+            game,
+            founder,
+            source_inputs,
+            sampling_seed,
+            mode,
+            prepare,
+        )?;
+        for r in inner.host.residents.values_mut() {
+            let state = r
+                .grouped
+                .as_mut()
+                .ok_or(CpuHostError::State("missing fresh grouped owner"))?;
+            state.motor.enable_decoder_learning_fresh()?;
+            state.decoder_learning = Some(GroupedDecoderLearningStateV1 {
+                policy: GROUPED_DECODER_CREDIT_POLICY_V1.into(),
+                last_credit: None,
+            });
+            r.sealed_authority = None;
+        }
+        inner.host.seal_all_residents()?;
+        Ok((Self { inner }, prepared))
+    }
+    pub fn world(&self) -> &HeadlessWorld {
+        self.inner.world()
+    }
+    pub fn sleep_state(&self, organism: OrganismId) -> Option<alife_core::sleep::SleepState> {
+        self.inner.sleep_state(organism)
+    }
+    pub fn step(&mut self, temperature: f32) -> Result<CpuGroupedM2HostStepV1, CpuHostError> {
+        self.inner
+            .host
+            .grouped_step(&self.inner.founder, temperature)
+    }
+    pub fn checkpoint(&self) -> Result<CpuGroupedM2DecoderCheckpointV1, CpuHostError> {
+        Ok(CpuGroupedM2DecoderCheckpointV1 {
+            payload: self.inner.checkpoint_for_policy(true)?.payload,
+        })
+    }
+    pub fn restore(
+        checkpoint: CpuGroupedM2DecoderCheckpointV1,
+        expected_source: &PhenotypeCompilerInputs,
+        expected_mode: MediationModeV1,
+    ) -> Result<Self, CpuHostError> {
+        let wire = checkpoint.encode()?;
+        let inner = CpuGroupedM2HostV1::restore_for_policy(
+            CpuGroupedM2HostCheckpointV1 {
+                payload: checkpoint.payload,
+            },
+            expected_source,
+            expected_mode,
+            true,
+        )?;
+        let result = Self { inner };
+        if result.checkpoint()?.encode()? != wire {
+            return Err(CpuHostError::State(
+                "decoder restore rewrote acquired state",
+            ));
+        }
+        Ok(result)
+    }
+    pub fn last_credit(&self, owner: OrganismId) -> Option<&GroupedDecoderCreditReceiptV1> {
+        self.inner
+            .host
+            .residents
+            .get(&owner.raw())?
+            .grouped
+            .as_ref()?
+            .decoder_learning
+            .as_ref()?
+            .last_credit
+            .as_ref()
+    }
+    pub fn actor_optimization(&mut self) -> Result<(), CpuHostError> {
+        Err(CpuHostError::State("GDE1 Adam/BPTT closed"))
+    }
+    pub fn synaptic_sleep_consolidation(&mut self) -> Result<(), CpuHostError> {
+        Err(CpuHostError::State(
+            "GDE1 synaptic sleep closed; memory sleep only",
+        ))
+    }
+}
