+#[test]
+fn grouped_decoder_acquired_state_survives_memory_sleep_and_exact_cold_resume() {
+    // Same existing high-pressure fixture: genes and 1200 ordinary world ticks,
+    // not synthetic concentration, hand-requested sleep or acquired-state injection.
+    let (mut host, inputs) = learning_fixture_at(1200);
+    let mut physical_sleep = false;
+    let mut acquired = false;
+    let mut consolidations = 0;
+    let mut waking = false;
+    let mut resumed = false;
+    for _ in 0..24 {
+        let before = host
+            .inner
+            .host
+            .residents
+            .values()
+            .next()
+            .unwrap()
+            .neural
+            .checkpoint()
+            .unwrap();
+        let step = host.step(0.73).unwrap();
+        let after = host
+            .inner
+            .host
+            .residents
+            .values()
+            .next()
+            .unwrap()
+            .neural
+            .checkpoint()
+            .unwrap();
+        acquired |=
+            after.fast.iter().any(|x| *x != 0.) && after.eligibility.iter().any(|x| *x != 0.);
+        for d in &step.decisions {
+            physical_sleep |= d.physical.successful_stationary_body_sleep;
+            if waking {
+                resumed = true;
+            }
+        }
+        if step.sleep_consolidations > 0 {
+            assert!(
+                acquired,
+                "memory-sleep test lacks actually acquired decoder state"
+            );
+            assert_eq!(
+                before, after,
+                "memory consolidation must not write/decay any source synaptic bank"
+            );
+            let resident = host.inner.host.residents.values().next().unwrap();
+            validate_grouped_sleep_boundary(resident).unwrap();
+            let state = resident.sleep.state();
+            if let ConsolidationState::Committed {
+                cycle_id,
+                output_generation,
+                ..
+            } = state.consolidation
+            {
+                assert_eq!(
+                    cycle_id, output_generation,
+                    "memory output is a cycle, not a forged source weight generation"
+                );
+            } else {
+                panic!("missing memory-only committed boundary");
+            }
+        }
+        consolidations += step.sleep_consolidations;
+        waking |= host
+            .inner
+            .host
+            .residents
+            .values()
+            .any(|r| r.sleep.state().phase == SleepPhase::Waking);
+        let wire = host.checkpoint().unwrap().encode().unwrap();
+        host = CpuGroupedM2DecoderHostV1::restore(
+            CpuGroupedM2DecoderCheckpointV1::decode(&wire).unwrap(),
+            &inputs,
+            MediationModeV1::Full,
+        )
+        .unwrap();
+        assert_eq!(host.checkpoint().unwrap().encode().unwrap(), wire);
+        if consolidations > 0 && waking && resumed {
+            break;
+        }
+    }
+    assert!(physical_sleep && acquired && waking && resumed,"Declared high-pressure bound did not establish the physical-sleep/acquired-state/wake chain");
+    assert_eq!(consolidations, 1);
+}
