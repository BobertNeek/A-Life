@@ -0,0 +1,617 @@
+//! Bounded disposable host fixtures. Never a study seed or retained organism.
+use super::*;
+use crate::cpu::{
+    grouped_decoder_coordinate, CpuGroupedM2DecoderCheckpointV1, CpuGroupedM2DecoderHostV1,
+};
+
+// Test-only fresh admission, before the first decision. There is no public
+// conversion/migration path from a closed checkpoint or existing individual.
+fn learning_fixture() -> (CpuGroupedM2DecoderHostV1, PhenotypeCompilerInputs) {
+    learning_fixture_at(240)
+}
+fn learning_fixture_at(preparation: u64) -> (CpuGroupedM2DecoderHostV1, PhenotypeCompilerInputs) {
+    let (mut inner, inputs) = fixture(preparation);
+    for r in inner.host.residents.values_mut() {
+        assert_eq!(r.next_sequence, 1);
+        let state = r.grouped.as_mut().unwrap();
+        state.motor.enable_decoder_learning_fresh().unwrap();
+        state.decoder_learning = Some(GroupedDecoderLearningStateV1 {
+            policy: GROUPED_DECODER_CREDIT_POLICY_V1.into(),
+            last_credit: None,
+        });
+        r.sealed_authority = None;
+    }
+    inner.host.seal_all_residents().unwrap();
+    (CpuGroupedM2DecoderHostV1 { inner }, inputs)
+}
+#[test]
+fn grouped_decoder_real_own_cost_changes_only_declared_coordinates_and_cold_continues() {
+    let (mut learning, inputs) = learning_fixture();
+    let (mut closed, _) = fixture(240);
+    let p = learning.inner.founder.phenotype().clone();
+    let initial = learning
+        .inner
+        .host
+        .residents
+        .values()
+        .next()
+        .unwrap()
+        .neural
+        .checkpoint()
+        .unwrap();
+    let founder = bytes(&learning.inner.founder.checkpoint());
+    let structural = bytes(
+        &learning
+            .inner
+            .host
+            .residents
+            .values()
+            .next()
+            .unwrap()
+            .v11
+            .checkpoint(),
+    );
+    let result = learning.step(0.73).unwrap();
+    let control = closed.step(0.73).unwrap();
+    assert_eq!(result.decisions.len(), 1);
+    assert_eq!(control.decisions.len(), 1);
+    let d = &result.decisions[0];
+    let c = &control.decisions[0];
+    // Before any outcome update the source and genuine sample are the same.
+    assert_eq!(d.action, c.action);
+    assert_eq!(d.source_diagnostic_logits, c.source_diagnostic_logits);
+    assert_eq!(
+        d.motor.native.core.appended_activations,
+        c.motor.native.core.appended_activations
+    );
+    assert_eq!(
+        d.motor.native.extension_activations,
+        c.motor.native.extension_activations
+    );
+    let work = d.patch.decision().cognitive_work.as_ref().unwrap();
+    assert!(work.learning_ops > 0);
+    assert!(d.motor.applied_body_energy_debit > c.motor.applied_body_energy_debit);
+    assert_eq!(d.motor.native.core.source_execution_count, 1);
+    assert_eq!(
+        d.motor
+            .native
+            .scores
+            .evaluate(&d.action)
+            .unwrap()
+            .joint_log_probability
+            .to_bits(),
+        d.action.old_joint_log_probability.to_bits()
+    );
+    let physical = d.diagnostic.physical_transition.unwrap();
+    let sealed = d.patch.outcome().measured_physiology.unwrap();
+    assert_eq!(physical.before, sealed.before);
+    assert!(sealed.energy_delta.raw() <= physical.energy_delta.raw());
+    let credit_packet = OutcomeCreditPacket::from_sealed_patch(&d.patch)
+        .unwrap()
+        .with_biochemical_receptors(&d.diagnostic.receptors)
+        .unwrap();
+    let receptor = p
+        .synapses()
+        .iter()
+        .find(|s| grouped_decoder_coordinate(s.kind()))
+        .unwrap()
+        .receptor_index();
+    let projection = p.plasticity_receptors()[receptor as usize]
+        .receptor_profile()
+        .project(&credit_packet.modulator().frame())
+        .unwrap();
+    eprintln!("GDE1_COMPUTE_INCLUSIVE_COST physical_energy={} sealed_energy={} learning_debit={} closed_debit={} example_decoder_receptor_projection={projection}",physical.energy_delta.raw(),sealed.energy_delta.raw(),d.motor.applied_body_energy_debit,c.motor.applied_body_energy_debit);
+    let receipt = learning.last_credit(d.organism_id).unwrap();
+    assert!(receipt.nonzero_eligibility > 0);
+    assert!(
+        receipt.changed_fast_coordinates > 0,
+        "real sealed own cost did not update a decoder coordinate"
+    );
+    assert_eq!(receipt.learning_ops, work.learning_ops);
+    assert_eq!(receipt.source_weight_generation, initial.weight_generation);
+    assert_eq!(
+        receipt.output_weight_generation,
+        initial.weight_generation + 1
+    );
+    let acquired = learning
+        .inner
+        .host
+        .residents
+        .values()
+        .next()
+        .unwrap()
+        .neural
+        .checkpoint()
+        .unwrap();
+    for (i, s) in p.synapses().iter().enumerate() {
+        assert_eq!(
+            initial.lifetime[i].to_bits(),
+            acquired.lifetime[i].to_bits()
+        );
+        if !grouped_decoder_coordinate(s.kind()) {
+            assert_eq!(initial.fast[i].to_bits(), acquired.fast[i].to_bits());
+            assert_eq!(
+                initial.eligibility[i].to_bits(),
+                acquired.eligibility[i].to_bits()
+            );
+        }
+    }
+    assert_eq!(
+        bytes(&initial.neural.dendrites),
+        bytes(&acquired.neural.dendrites)
+    );
+    assert_eq!(founder, bytes(&learning.inner.founder.checkpoint()));
+    assert_eq!(
+        structural,
+        bytes(
+            &learning
+                .inner
+                .host
+                .residents
+                .values()
+                .next()
+                .unwrap()
+                .v11
+                .checkpoint()
+        )
+    );
+    assert_eq!(
+        closed
+            .host
+            .residents
+            .values()
+            .next()
+            .unwrap()
+            .neural
+            .checkpoint()
+            .unwrap()
+            .fast,
+        initial.fast
+    );
+    let wire = learning.checkpoint().unwrap().encode().unwrap();
+    assert!(CpuGroupedM2HostCheckpointV1::decode(&wire).is_err());
+    assert!(CpuGroupedM2DecoderCheckpointV1::decode(
+        &closed.checkpoint().unwrap().encode().unwrap()
+    )
+    .is_err());
+    let mut cold = CpuGroupedM2DecoderHostV1::restore(
+        CpuGroupedM2DecoderCheckpointV1::decode(&wire).unwrap(),
+        &inputs,
+        MediationModeV1::Full,
+    )
+    .unwrap();
+    assert_eq!(cold.checkpoint().unwrap().encode().unwrap(), wire);
+    for _ in 0..3 {
+        let a = learning.step(1.17).unwrap();
+        let b = cold.step(1.17).unwrap();
+        assert_eq!(a.decisions.len(), b.decisions.len());
+        for (a, b) in a.decisions.iter().zip(&b.decisions) {
+            assert_eq!(a.action, b.action);
+            assert_eq!(bytes(&a.patch), bytes(&b.patch));
+        }
+        assert_eq!(
+            learning.checkpoint().unwrap().encode().unwrap(),
+            cold.checkpoint().unwrap().encode().unwrap()
+        );
+    }
+}
+#[test]
+fn grouped_decoder_rejects_wrong_policy_and_failed_step_is_atomic() {
+    let (mut learning, inputs) = learning_fixture();
+    let before = learning.checkpoint().unwrap().encode().unwrap();
+    assert!(learning.step(f32::NAN).is_err());
+    assert_eq!(learning.checkpoint().unwrap().encode().unwrap(), before);
+    assert!(learning.inner.checkpoint().is_err());
+    assert!(learning.actor_optimization().is_err());
+    assert!(learning.synaptic_sleep_consolidation().is_err());
+    let mut bad = CpuGroupedM2DecoderCheckpointV1::decode(&before).unwrap();
+    // The public restore cannot relabel a source or mode.
+    assert!(
+        CpuGroupedM2DecoderHostV1::restore(bad.clone(), &inputs, MediationModeV1::DriveSham)
+            .is_err()
+    );
+    let mut wire = bad.encode().unwrap();
+    wire[0] ^= 1;
+    assert!(CpuGroupedM2DecoderCheckpointV1::decode(&wire).is_err());
+    // Keep a used clone available for continuation inspection rather than mutate
+    // the real source checkpoint or turn this into a migration test.
+    bad = CpuGroupedM2DecoderCheckpointV1::decode(&before).unwrap();
+    assert_eq!(bad.encode().unwrap(), before);
+}
+
+#[test]
+fn grouped_decoder_real_credit_changes_same_frame_policy_not_a_trajectory_claim() {
+    let (mut learning, _) = learning_fixture();
+    let initial = learning
+        .inner
+        .host
+        .residents
+        .values()
+        .next()
+        .unwrap()
+        .neural
+        .checkpoint()
+        .unwrap();
+    let mut policy_effect = false;
+    for interval in 0..24 {
+        let result = learning.step(0.73).unwrap();
+        for d in &result.decisions {
+            let before = &d.diagnostic;
+            let frame = d.patch.pre_action().perception();
+            let p = learning.inner.founder.phenotype();
+            let evaluate = |sequence: &crate::TrainingSequence| {
+                let mut motor = before.motor_before.clone();
+                motor
+                    .forward(
+                        p,
+                        learning.inner.founder.weights(),
+                        sequence,
+                        frame,
+                        &before.receptors,
+                        &before.effects,
+                        before.capabilities,
+                        before.attempt_mask,
+                    )
+                    .unwrap();
+                motor.last_receipt.unwrap()
+            };
+            let old = evaluate(&before.sequence);
+            assert_eq!(bytes(&old.native.scores), bytes(&d.motor.native.scores));
+            let mut inherited = before.sequence.clone();
+            inherited.ticks[0].effective_weight_offsets = p
+                .synapses()
+                .iter()
+                .enumerate()
+                .map(|(i, s)| initial.lifetime[i] + s.alpha() * initial.fast[i])
+                .collect();
+            let inherited = evaluate(&inherited);
+            let mut acquired = before.sequence.clone();
+            acquired.ticks[0].effective_weight_offsets = learning
+                .inner
+                .host
+                .residents
+                .get(&d.organism_id.raw())
+                .unwrap()
+                .neural
+                .effective_offsets(p)
+                .unwrap();
+            let new = evaluate(&acquired);
+            // Freeze actual captured neural state, recall/context, source lifetime,
+            // appendage state, frame, mask and sample in all three evaluations.
+            // Only fast differs: inherited initial versus cumulative acquired,
+            // and pre-final-update versus post-final-update. No lived alternative.
+            let logp = |r: &GroupedMotorReceiptV1| {
+                r.native
+                    .scores
+                    .evaluate(&d.action)
+                    .unwrap()
+                    .joint_log_probability
+            };
+            let old_logp = logp(&old);
+            let inherited_logp = logp(&inherited);
+            let new_logp = logp(&new);
+            let component_change = old
+                .native
+                .core
+                .components
+                .iter()
+                .flatten()
+                .zip(new.native.core.components.iter().flatten())
+                .chain(
+                    old.native
+                        .group_components
+                        .iter()
+                        .zip(&new.native.group_components),
+                )
+                .map(|(a, b)| (a - b).abs())
+                .fold(0_f32, f32::max);
+            let scale = if interval == 0 {
+                let acquired_checkpoint = learning
+                    .inner
+                    .host
+                    .residents
+                    .get(&d.organism_id.raw())
+                    .unwrap()
+                    .neural
+                    .checkpoint()
+                    .unwrap();
+                Some(before.staged.diagnose_grouped_decoder_scale_for_test(
+                    &learning.inner.founder,
+                    &d.patch,
+                    &before.receptors,
+                    &acquired_checkpoint,
+                    &d.motor,
+                    &d.action,
+                    frame,
+                ))
+            } else {
+                None
+            };
+            let max_delta = |a: &[f32], b: &[f32]| {
+                a.iter()
+                    .zip(b)
+                    .map(|(a, b)| (a - b).abs())
+                    .fold(0_f32, f32::max)
+            };
+            let port_old = old
+                .native
+                .core
+                .port_activations
+                .iter()
+                .flatten()
+                .flatten()
+                .copied()
+                .collect::<Vec<_>>();
+            let port_new = new
+                .native
+                .core
+                .port_activations
+                .iter()
+                .flatten()
+                .flatten()
+                .copied()
+                .collect::<Vec<_>>();
+            let propagation = serde_json::json!({"raw_component_max_delta":component_change,"m2_port_activation_max_delta":max_delta(&port_old,&port_new),"m2_core_logit_max_delta":max_delta(&old.native.core.core_logits,&new.native.core.core_logits),"group_extension_activation_max_delta":max_delta(&old.native.extension_activations,&new.native.extension_activations),"group_score_changed":old.native.scores.group.to_bits()!=new.native.scores.group.to_bits(),"ordinary_score_changed":old.native.scores.ordinary.iter().zip(&new.native.scores.ordinary).any(|(a,b)|a.to_bits()!=b.to_bits()),"operation_score_changed":old.native.scores.operations.iter().zip(&new.native.scores.operations).any(|(a,b)|a.to_bits()!=b.to_bits())});
+            if interval == 0 {
+                eprintln!(
+                    "GDE1_FIRST_UPDATE_SCALE {} propagation={}",
+                    scale.as_ref().unwrap(),
+                    propagation
+                );
+                assert!(component_change > 0.);
+                // Preserve the first observed quantization limitation explicitly.
+                assert_eq!(old_logp.to_bits(), new_logp.to_bits());
+            }
+            policy_effect |= inherited_logp.to_bits() != new_logp.to_bits();
+            eprintln!("GDE1_FROZEN_FRAME interval={interval} tick={} inherited_logp={inherited_logp:.17} pre_update_logp={old_logp:.17} acquired_logp={new_logp:.17} final_update_raw_change={component_change} cumulative_policy_changed={} final_update_policy_changed={}",result.tick_before.raw(),inherited_logp.to_bits()!=new_logp.to_bits(),old_logp.to_bits()!=new_logp.to_bits());
+            if let Ok(directory) = std::env::var("ALIFE_GDE1_EVIDENCE_DIR") {
+                if interval == 0 || policy_effect {
+                    std::fs::create_dir_all(&directory).unwrap();
+                    let evidence = serde_json::json!({"interpretation":"frozen actual frame; cumulative fast-only contrast; not a live alternative trajectory", "interval":interval,"patch":d.patch,"action":d.action,"credit":learning.last_credit(d.organism_id),"inherited_scores":inherited.native.scores,"pre_update_scores":old.native.scores,"acquired_scores":new.native.scores,"final_update_raw_component_change":component_change,"first_update_scale":scale,"native_propagation":propagation,"log_probability_bits":[inherited_logp.to_bits(),old_logp.to_bits(),new_logp.to_bits()]});
+                    std::fs::write(
+                        std::path::Path::new(&directory)
+                            .join(format!("same-frame-{interval}.json")),
+                        serde_json::to_vec_pretty(&evidence).unwrap(),
+                    )
+                    .unwrap();
+                }
+            }
+        }
+        if policy_effect {
+            break;
+        }
+    }
+    assert!(policy_effect,"No cumulative fast-only same-frame policy change in declared24-interval bound; do not retune coefficients or seed");
+}
