+#[test]
+fn grouped_decoder_sealed_credit_binding_rejects_mismatches_and_duplicate() {
+    let (mut learning, _) = learning_fixture();
+    let result = learning.step(0.73).unwrap();
+    let d = &result.decisions[0];
+    let before = &d.diagnostic;
+    let record = learning
+        .world()
+        .organism_registry()
+        .get(d.organism_id)
+        .unwrap();
+    let development = record
+        .phenotype()
+        .development_state_at(result.tick_before)
+        .unwrap();
+    let parameters = record.phenotype().brain_genome.plasticity_parameters();
+    let apply =
+        |state: &mut CpuOrganismState, patch: &ExperiencePatch, receptors: &NeuralReceptorFrame| {
+            state.apply_grouped_decoder_credit(
+                &learning.inner.founder,
+                patch,
+                receptors,
+                &development,
+                parameters,
+            )
+        };
+    assert!(before.staged.checkpoint().is_err());
+    // Mutate only typed pending test evidence, never a production sealed patch.
+    // The implementation's tests own the private mutation helper below.
+    for kind in 0..9 {
+        let mut invalid = before.staged.clone();
+        invalid.corrupt_grouped_binding_for_test(kind);
+        assert!(
+            apply(&mut invalid, &d.patch, &before.receptors).is_err(),
+            "mismatch {kind}"
+        );
+        assert!(invalid.checkpoint().is_err());
+    }
+    let mut bad_receptors = before.receptors.clone();
+    bad_receptors.source_tick = Tick(before.receptors.source_tick.raw() + 1);
+    let mut pending = before.staged.clone();
+    assert!(apply(&mut pending, &d.patch, &bad_receptors).is_err());
+    let receipt = apply(&mut pending, &d.patch, &before.receptors).unwrap();
+    assert_eq!(&receipt, learning.last_credit(d.organism_id).unwrap());
+    let acquired = pending.checkpoint().unwrap();
+    assert!(apply(&mut pending, &d.patch, &before.receptors).is_err());
+    assert_eq!(acquired, pending.checkpoint().unwrap());
+}
