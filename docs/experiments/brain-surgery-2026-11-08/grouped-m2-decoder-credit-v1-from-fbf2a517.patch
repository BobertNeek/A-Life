+            let factor=r.receptor_profile().project(&modulator).unwrap();
+            let delayed_trace=staged[i]*decay(r.eligibility_decay(),credit.outcome_tick().raw()-pending.tick);
+            serde_json::json!({"coordinate":i,"kind":format!("{:?}",s.kind()),"raw_score_gradient":gradient[i],"staged_trace":staged[i],"outcome_decayed_trace":delayed_trace,"eta":r.learning_rate(),"alpha":s.alpha(),"receptor_factor":factor,"fast_before":self.checkpoint.fast[i],"fast_after":acquired.fast[i],"fast_delta":f64::from(acquired.fast[i])-f64::from(self.checkpoint.fast[i]),"ideal_alpha_times_fast_delta":f64::from(s.alpha())*(f64::from(acquired.fast[i])-f64::from(self.checkpoint.fast[i])),"effective_before":old_effective,"effective_after":new_effective,"native_effective_delta":f64::from(new_effective)-f64::from(old_effective)})
+        }).collect::<Vec<_>>();
+        serde_json::json!({"changed_fast_coordinates":changes.len(),"changed_effective_coordinates":effective_changed,"largest_effective_delta_examples":examples})
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn grouped_decoder_synthetic_zero_and_opposite_credit_controls() {
+        // Injected scalar arithmetic, explicitly not own-world outcome evidence.
+        let zero = grouped_decoder_fast_update(-0., 0.125, 0.5, 0., 0.4, -1., 1.).unwrap();
+        assert_eq!(zero.to_bits(), (-0_f32).to_bits());
+        let positive = grouped_decoder_fast_update(0., 0.125, 0.5, 0.8, 0.4, -1., 1.).unwrap();
+        let negative = grouped_decoder_fast_update(0., 0.125, 0.5, -0.8, 0.4, -1., 1.).unwrap();
+        assert!(positive > 0.);
+        assert_eq!(positive.to_bits(), (-negative).to_bits());
+        assert_eq!(positive, (0.125 * 0.5 * 0.8) * 0.4);
+    }
+}
