diff --git a/crates/alife_training/src/cpu/organism_grouped_decoder.rs b/crates/alife_training/src/cpu/organism_grouped_decoder.rs
new file mode 100644
index 0000000000000000000000000000000000000000..d5ee1abe4359a87b2a4a1d789cfb5f4a95e3376e
--- /dev/null
+++ b/crates/alife_training/src/cpu/organism_grouped_decoder.rs
@@ -0,0 +1,344 @@
+//! GDE1: bounded, outcome-modulated local decoder score traces. Not old Oja,
+//! recurrent BPTT, an Adam optimizer, or isolated per-channel causal rewards.
+use super::*;
+use crate::cpu::{GroupedMotorReceiptV1, RecoveryGroupJointActionV2};
+use alife_core::{MotorCommandBundle, PerceptionFrame};
+
+pub const GROUPED_DECODER_CREDIT_POLICY_V1: &str = "grouped-decoder-score-trace-v1;action-and-memory;fast-and-eligibility-only;no-oja;no-lifetime;no-synaptic-sleep;no-adam-bptt";
+
+pub(crate) fn grouped_decoder_coordinate(kind: CompiledSynapseKind) -> bool {
+    matches!(kind, CompiledSynapseKind::Decoder(d) if matches!(d.head(), DecoderHeadKind::ActionCandidate | DecoderHeadKind::MemoryContext))
+}
+/// Conservative reservation bound, not the charged work. Actual chain terms,
+/// categorical derivative terms, staged traces and sealed updates are counted
+/// by the executed sparse pullback. Administrative scans are never charged.
+pub(crate) fn grouped_decoder_work_bound(
+    p: &BrainPhenotype,
+    candidates: u64,
+) -> Result<u64, TrainingError> {
+    if candidates == 0 || candidates > 32 {
+        return Err(invalid());
+    }
+    let coordinates = p
+        .synapses()
+        .iter()
+        .filter(|s| grouped_decoder_coordinate(s.kind()))
+        .count() as u64;
+    coordinates
+        .checked_mul(candidates + 4)
+        .and_then(|x| x.checked_add(8 * (candidates + 2)))
+        .ok_or_else(invalid)
+}
+
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct GroupedDecoderCreditReceiptV1 {
+    pub policy: String,
+    pub sequence_id: ExperienceSequenceId,
+    pub frame_digest: PerceptionFrameDigest,
+    pub dispatch_generation: u64,
+    pub source_weight_generation: u64,
+    pub output_weight_generation: u64,
+    pub nonzero_eligibility: u32,
+    pub changed_fast_coordinates: u32,
+    pub learning_ops: u64,
+}
+impl CpuOrganismState {
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn stage_grouped_decoder_selection(
+        &mut self,
+        p: &BrainPhenotype,
+        action: &RecoveryGroupJointActionV2,
+        motor: &GroupedMotorReceiptV1,
+        frame: &PerceptionFrame,
+        bundle: &MotorCommandBundle,
+        binding: CpuDecisionBinding,
+    ) -> Result<(), TrainingError> {
+        let pending = self.pending.as_ref().ok_or_else(invalid)?;
+        let (representative, motors) = motor.native.scores.physical_selection(action)?;
+        binding.joint_selection.validate_bundle(bundle)?;
+        if !pending.grouped_learning
+            || !pending.grouped_closed
+            || pending.binding.is_some()
+            || pending.staged.is_some()
+            || self.checkpoint.phenotype_hash != p.phenotype_hash()
+            || self.checkpoint.weight_generation != pending.weight_generation
+            || self.checkpoint.organism_id != frame.organism_id()
+            || bundle.organism_id != frame.organism_id()
+            || bundle.tick != frame.tick()
+            || bundle.sequence_id != binding.sequence_id
+            || frame.tick().raw() != pending.tick
+            || binding.dispatch_generation != self.checkpoint.dispatch_generation
+            || binding.active_activation_side != self.checkpoint.active_activation_side
+            || binding.joint_selection.candidate_slots() != motors.map(|i| i.map_or(0, |i| i + 1))
+        {
+            return Err(invalid());
+        }
+        let (gradient, learning_work) = motor.decoder_score_gradient(
+            p,
+            &pending.context,
+            &self.checkpoint.neural.activations,
+            action,
+            frame,
+            &binding,
+        )?;
+        if learning_work > grouped_decoder_work_bound(p, pending.context.candidates.len() as u64)? {
+            return Err(invalid());
+        }
+        let elapsed = self
+            .checkpoint
+            .last_decision_tick
+            .map_or(0, |old| pending.tick - old);
+        let mut staged = self.checkpoint.eligibility.clone();
+        for (i, s) in p.synapses().iter().enumerate() {
+            if !grouped_decoder_coordinate(s.kind()) {
+                continue;
+            }
+            let r = &p.plasticity_receptors()[s.receptor_index() as usize];
+            let g = gradient[i] as f32;
+            let next = decay(r.eligibility_decay(), elapsed) * staged[i] + g;
+            finite(&[g, next])?;
+            staged[i] = next.clamp(-1., 1.);
+        }
+        let pending = self.pending.as_mut().unwrap();
+        pending.staged = Some(staged);
+        pending.grouped_learning_work = Some(learning_work);
+        pending.representative = Some(representative);
+        pending.binding = Some(binding);
+        Ok(())
+    }
+    pub(crate) fn staged_grouped_decoder_work(&self) -> Result<u64, TrainingError> {
+        self.pending
+            .as_ref()
+            .and_then(|p| p.grouped_learning_work)
+            .ok_or_else(invalid)
+    }
+    pub(crate) fn apply_grouped_decoder_credit(
+        &mut self,
+        founder: &CpuFoundationTrainer,
+        patch: &ExperiencePatch,
+        receptors: &NeuralReceptorFrame,
+        development: &DevelopmentState,
+        parameters: &PlasticityGenomeParameters,
+    ) -> Result<GroupedDecoderCreditReceiptV1, TrainingError> {
+        let p = founder.phenotype();
+        if p.phenotype_hash() != self.checkpoint.phenotype_hash
+            || founder
+                .weights()
+                .iter()
+                .zip(p.synapses())
+                .any(|(w, s)| w.to_bits() != s.genetic_weight().to_bits())
+        {
+            return Err(invalid());
+        }
+        let credit = OutcomeCreditPacket::from_sealed_patch(patch)?;
+        let pending = self.pending.as_ref().ok_or_else(invalid)?;
+        let binding = pending.binding.as_ref().ok_or_else(invalid)?;
+        let staged = pending.staged.as_ref().ok_or_else(invalid)?;
+        binding
+            .joint_selection
+            .validate_decision(patch.decision())?;
+        if !pending.grouped_learning
+            || !pending.grouped_closed
+            || pending.grouped_receptors.as_ref() != Some(receptors)
+            || self.checkpoint.weight_generation != pending.weight_generation
+            || credit.policy_backend() != alife_core::PolicyBackend::NeuralClosedLoopCpu
+            || credit.organism_id() != self.checkpoint.organism_id
+            || credit.phenotype_hash() != self.checkpoint.phenotype_hash
+            || credit.originating_tick().raw() != pending.tick
+            || credit.outcome_tick().raw() < pending.tick
+            || Some(credit.selected_candidate()) != pending.representative
+            || credit.sequence_id() != binding.sequence_id
+            || credit.frame_digest() != binding.frame_digest
+            || credit.selected_action() != binding.action_id
+            || credit.candidate_feature_digest() != binding.candidate_feature_digest
+            || credit.dispatch_generation() != binding.dispatch_generation
+            || credit.active_activation_side() != binding.active_activation_side
+            || pending.context.candidates[credit.selected_candidate() as usize].family
+                != credit.selected_family()
+        {
+            return Err(invalid());
+        }
+        let credit = credit.with_biochemical_receptors(receptors)?;
+        let mut developmental = alife_gpu_backend::GpuDevelopmentalPlasticity::default();
+        developmental.update(p, development, parameters)?;
+        // Existing developmental route scales apply to recurrent synapses only;
+        // the declared decoder rates stay inherited, just as in the native law.
+        let modulator = credit.modulator().frame();
+        let mut next = self.checkpoint.clone();
+        let mut changed = 0;
+        let mut nonzero = 0;
+        for (i, s) in p.synapses().iter().enumerate() {
+            if !grouped_decoder_coordinate(s.kind()) {
+                continue;
+            }
+            let r = &p.plasticity_receptors()[s.receptor_index() as usize];
+            let factor = r.receptor_profile().project(&modulator)?;
+            let trace = staged[i]
+                * decay(
+                    r.eligibility_decay(),
+                    credit.outcome_tick().raw() - pending.tick,
+                );
+            let (min, max) = r.fast_weight_bounds();
+            let updated = grouped_decoder_fast_update(
+                next.fast[i],
+                r.learning_rate(),
+                s.alpha(),
+                factor,
+                trace,
+                min,
+                max,
+            )?;
+            changed += u32::from(updated.to_bits() != next.fast[i].to_bits());
+            nonzero += u32::from(staged[i] != 0.);
+            next.fast[i] = updated;
+            next.eligibility[i] = staged[i];
+        }
+        if changed != 0 {
+            next.weight_generation = next.weight_generation.checked_add(1).ok_or_else(invalid)?;
+        }
+        next.last_decision_tick = Some(pending.tick);
+        next.last_outcome_tick = Some(credit.outcome_tick().raw());
+        let receipt = GroupedDecoderCreditReceiptV1 {
+            policy: GROUPED_DECODER_CREDIT_POLICY_V1.into(),
+            sequence_id: credit.sequence_id(),
+            frame_digest: credit.frame_digest(),
+            dispatch_generation: binding.dispatch_generation,
+            source_weight_generation: pending.weight_generation,
+            output_weight_generation: next.weight_generation,
+            nonzero_eligibility: nonzero,
+            changed_fast_coordinates: changed,
+            learning_ops: pending.grouped_learning_work.ok_or_else(invalid)?,
+        };
+        self.checkpoint = next;
+        self.pending = None;
+        Ok(receipt)
+    }
+}
+fn grouped_decoder_fast_update(
+    fast: f32,
+    rate: f32,
+    alpha: f32,
+    factor: f32,
+    trace: f32,
+    min: f32,
+    max: f32,
+) -> Result<f32, TrainingError> {
+    let delta = rate * alpha * factor * trace;
+    let next = fast + delta;
+    finite(&[delta, next])?;
+    // A zero-credit update preserves exact signed-zero/boundary sentinels.
+    Ok(if delta == 0. {
+        fast
+    } else {
+        next.clamp(min, max)
+    })
+}
