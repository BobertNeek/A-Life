+fn original_science(rows: &[u8]) -> Result<Vec<u8>> {
+    let mut out = Vec::new();
+    for line in rows.split(|c| *c == b'\n').filter(|l| !l.is_empty()) {
+        let mut v: Value = serde_json::from_slice(line)?;
+        if let Some(decisions) = v["decisions"].as_array_mut() {
+            for d in decisions {
+                d["research_world_receipt"] = Value::Null;
+            }
+        }
+        out.extend(serde_json::to_vec(&v)?);
+        out.push(b'\n');
+    }
+    Ok(out)
