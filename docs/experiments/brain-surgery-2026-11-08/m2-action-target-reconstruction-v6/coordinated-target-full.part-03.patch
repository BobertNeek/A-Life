+impl CoordinatedTargetFactorV1 {
+    fn canonical_idle(index: u16) -> Result<ActionCandidate, TrainingError> {
+        Ok(ActionCandidate::new(
+            index,
+            ActionKind::Idle.canonical_id(),
+            ActionKind::Idle,
+            CandidateActionFamily::Idle,
+            CandidateObservationRef::None,
+            ActionTarget::NONE,
+            CandidateFeatureVector::zero().with_intrinsic_action_basis(ActionKind::Idle),
+            Confidence::new(1.)?,
+            NormalizedScalar::new(0.)?,
+            DurationTicks::new(1),
+            DurationTicks::new(1),
+        )?)
+    }
+    fn from_native(d: RecoveryGroupFactorV2) -> Self {
+        Self {
+            outcomes: d.outcomes.into_iter().map(from_native).collect(),
+            probabilities: d.probabilities,
+            log_probabilities: d.log_probabilities,
+        }
+    }
+    fn new(
+        outcomes: Vec<CoordinatedTargetChoiceV1>,
+        logits: Vec<f64>,
+        t: f64,
+    ) -> Result<Self, TrainingError> {
+        valid_temperature(t)?;
+        if outcomes.len() != logits.len()
+            || logits.is_empty()
+            || logits.iter().any(|x| !x.is_finite() || x.abs() > 1e30)
+        {
+            return Err(invalid());
+        }
+        let max = logits.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+        let sum = logits.iter().map(|x| ((x - max) / t).exp()).sum::<f64>();
+        if !sum.is_finite() || sum <= 0. {
+            return Err(invalid());
+        }
+        let log_probabilities: Vec<_> = logits.iter().map(|x| (x - max) / t - sum.ln()).collect();
+        let probabilities = log_probabilities.iter().map(|x| x.exp()).collect();
+        Ok(Self {
+            outcomes,
+            probabilities,
+            log_probabilities,
+        })
+    }
+    fn sample(&self, u: f64) -> CoordinatedTargetChoiceV1 {
+        let mut sum = 0.;
+        for (&o, p) in self.outcomes.iter().zip(&self.probabilities) {
+            sum += p;
+            if u < sum {
+                return o;
+            }
+        }
+        *self.outcomes.last().expect("validated nonempty factor")
+    }
+    fn logp(&self, o: CoordinatedTargetChoiceV1) -> Result<f64, TrainingError> {
+        self.outcomes
+            .iter()
+            .position(|x| *x == o)
+            .map(|i| self.log_probabilities[i])
+            .ok_or_else(invalid)
+    }
+    pub fn probability(&self, o: CoordinatedTargetChoiceV1) -> f64 {
+        self.outcomes
+            .iter()
+            .position(|x| *x == o)
+            .map_or(0., |i| self.probabilities[i])
+    }
+}
