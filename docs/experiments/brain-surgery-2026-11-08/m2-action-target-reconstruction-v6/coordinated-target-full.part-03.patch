+                        serde_json::to_value(eval)?,
+                        receipts.get(i),
+                        None,
+                    )?);
+                }
+                Ok(Step {
+                    tick_before: s.tick_before,
+                    tick_after: s.tick_after,
+                    decisions,
+                    sleeping_organisms: s.sleeping_organisms,
+                    sleep_consolidations: s.sleep_consolidations,
+                })
+            }
+            Self::Optional(h) => {
+                let (s, receipts) = if observe {
+                    let r = h.step_research_observed(t)?;
+                    (r.step, r.world_receipts)
+                } else {
