+#[test]
+fn all_factors_and_complete_joint_normalize_including_representative_forcing() {
+    let (_, _, _, s) = fixture(true);
+    let d = s.probabilities(1.).unwrap();
+    fn walk(
+        s: &CoordinatedTargetScoresV1,
+        d: &CoordinatedTargetProbabilitiesV1,
+        rep: CoordinatedTargetChoiceV1,
+        slot: usize,
+        motors: &mut [CoordinatedTargetChoiceV1; 6],
+        mass: f64,
+        total: &mut [f64; 2],
+    ) {
+        if slot == 6 {
+            let rest = rep == CoordinatedTargetChoiceV1::RestGroup
+                || motors.contains(&CoordinatedTargetChoiceV1::RestGroup);
+            let conditional = if rest {
+                d.conditional_operation.iter().sum()
+            } else {
+                1.
+            };
+            total[0] += mass * conditional;
+            if matches!(motors[3], CoordinatedTargetChoiceV1::Candidate(_)) {
+                total[1] += mass * conditional;
+            }
+        } else if s.forced(rep) == Some(slot) {
+            motors[slot] = rep;
+            walk(s, d, rep, slot + 1, motors, mass, total);
+        } else if let Some(f) = &d.channels[slot] {
+            for (&c, p) in f.outcomes.iter().zip(&f.probabilities) {
+                motors[slot] = c;
+                walk(s, d, rep, slot + 1, motors, mass * p, total);
+            }
+        } else {
+            motors[slot] = CoordinatedTargetChoiceV1::NoOp;
+            walk(s, d, rep, slot + 1, motors, mass, total);
+        }
+    }
+    for f in std::iter::once(&d.representative).chain(d.channels.iter().flatten()) {
+        assert!((f.probabilities.iter().sum::<f64>() - 1.).abs() < 1e-12);
+    }
+    let mut mass = [0.; 2];
+    for (&rep, p) in d
+        .representative
+        .outcomes
+        .iter()
+        .zip(&d.representative.probabilities)
+    {
+        walk(
+            &s,
+            &d,
+            rep,
+            0,
+            &mut [CoordinatedTargetChoiceV1::NoOp; 6],
+            *p,
+            &mut mass,
+        );
+    }
+    assert!((mass[0] - 1.).abs() < 1e-12);
+    assert!((mass[1] - d.actual_vocal_probability).abs() < 1e-12);
+    assert!((d.actual_vocal_probability - 7. / 12.).abs() < 1e-12);
+    assert!((d.actual_quiet_probability - 5. / 12.).abs() < 1e-12);
+}
