+    if distance(actor.position, near.position) > 1.25 || near.nutrition != 0.65 {
+        return Err("ordinary near food not in center reach".into());
+    }
+    let near_row = evidence["objects"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .find(|o| o["label"] == "near-root")
+        .unwrap();
+    for field in [
+        "actor_target_obstacle_clearance",
+        "target_grip_obstacle_clearance",
+    ] {
+        if near_row[field].as_f64().is_none_or(|v| v <= 0.) {
+            return Err("ordinary near-food grip segment obstructed".into());
+        }
+    }
+    for i in 1..actual.len() {
+        for j in i + 1..actual.len() {
+            if distance(actual[i].position, actual[j].position)
+                <= f64::from(actual[i].radius + actual[j].radius)
+            {
+                return Err("non-agent object bounds overlap".into());
+            }
+        }
+    }
+    Ok(evidence)
+}
