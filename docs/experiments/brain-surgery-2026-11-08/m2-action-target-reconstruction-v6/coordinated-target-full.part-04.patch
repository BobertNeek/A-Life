+pub type CpuCoordinatedTargetM2HostStepV1 = CpuGroupedM2HostStepV1<CoordinatedTargetActionV1>;
+pub type CpuCoordinatedTargetM2HostDecisionV1 =
+    CpuGroupedM2HostDecisionV1<CoordinatedTargetActionV1>;
