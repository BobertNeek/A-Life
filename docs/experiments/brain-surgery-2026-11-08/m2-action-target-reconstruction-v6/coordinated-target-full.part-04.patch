+#[test]
+fn coordination_fixed_physical_matrix_preserves_real_failures_and_move_then_reach() {
+    let (host, _) = fresh();
+    let record = host
+        .world()
+        .organism_registry()
+        .iter()
+        .next()
+        .unwrap()
+        .clone();
+    let id = record.organism_id();
+    let scene = |kind: u8, distance: f32, occluded: bool| {
+        let mut builder =
+            HeadlessScenarioBuilder::new(FIXTURE_SEED).agent("learner", id, Vec3f::ZERO);
+        builder = match kind {
+            0 => builder.food("target", Vec3f::new(distance, 0., 0.), 0.65),
+            1 => builder.toy("target", Vec3f::new(distance, 0., 0.), false),
+            _ => builder.obstacle("target", Vec3f::new(distance, 0., 0.), 0.1),
+        };
+        if occluded {
+            builder = builder.obstacle("wall", Vec3f::new(0.5, 0., 0.), 0.2);
+        }
+        let mut w = builder
+            .food("second", Vec3f::new(0.8, 0., 0.25), 0.45)
+            .build()
+            .unwrap();
+        w.register_grounded_drive_research_record(record.clone())
+            .unwrap();
+        w
+    };
+    let command = |w: &HeadlessWorld, label: &str, action: ActionId, kind: ActionKind| {
+        let target = w.entity_id(label).unwrap();
+        ActionCommand::structured(
+            id,
+            action,
+            kind,
+            ActionTarget::new(Some(target), Some(w.entity(target).unwrap().position)),
+            Intensity::new(1.).unwrap(),
+            DurationTicks::new(1),
+            Confidence::new(1.).unwrap(),
+            0,
+            None,
+            None,
+            None,
+        )
+        .unwrap()
+    };
+    let apply = |w: &mut HeadlessWorld, label: &str, action: ActionId| {
+        let c = command(w, label, action, ActionKind::Interact);
+        w.apply_neural_command(&c, None, false).unwrap()
+    };
+    // Six cases, six attempts. Kind failures are intentional and visible.
+    for (kind, distance, action, expected) in [
+        (0, 1., HeadlessActionIds::EAT, true),
+        (0, 3., HeadlessActionIds::EAT, false),
+        (1, 1., HeadlessActionIds::PLAY, true),
+        (1, 3., HeadlessActionIds::PLAY, false),
+        (2, 1., HeadlessActionIds::GRAB, false),
+        (2, 1., HeadlessActionIds::EAT, false),
+    ] {
+        let mut w = scene(kind, distance, false);
+        let result = apply(&mut w, "target", action);
+        assert_eq!(result.execution.succeeded, expected);
+        if !expected {
+            assert!(result.observation.frustration_delta.raw() > 0.);
+            assert_eq!(result.body_event.nutrition, 0.);
+        }
+        if kind == 0 && expected {
+            // First unheld Eat is an actual acquisition phase, not a meal.
+            assert_eq!(result.body_event.nutrition, 0.);
+            assert_eq!(
+                w.entity(w.entity_id("target").unwrap()).unwrap().carried_by,
+                Some(id)
+            );
+            let meal = apply(&mut w, "target", HeadlessActionIds::EAT);
+            assert!(meal.execution.succeeded);
+            assert_eq!(meal.body_event.nutrition, 0.65);
+        }
+    }
+    // Held food is not a toy. Failed Play does not drop it or invent a meal.
+    let mut w = scene(0, 0.5, false);
+    assert!(
+        apply(&mut w, "target", HeadlessActionIds::GRAB)
+            .execution
+            .succeeded
+    );
+    let failure = apply(&mut w, "target", HeadlessActionIds::PLAY);
