+//! Fresh coordinated-target host identity and a shared-loop policy strategy.
+//! No old host conversion, reset, imported checkpoint, or gradient entry point.
+use super::*;
+use crate::cpu::{
+    CoordinatedTargetActionV1, CoordinatedTargetScoresV1, CoordinatedTargetSourceV1,
+    COORDINATED_TARGET_POLICY_V1,
+};
+const OPTIONAL_MAGIC: &[u8] = b"ALIFE-COORDINATED-TARGET-M2-HOST\0V1\0IDLE-QUIET\0SOURCE-PAYLOAD\0SYNAPTIC-CLOSED\0PROFILE5\0BITS1\0";
+const OPTIONAL_LINEAGE: &str = "fresh-coordinated-target-m2-host-v1/class5/no-historical-import";
+const OPTIONAL_RESIDENT: &str = "coordinated-target-m2-resident-v1";
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(in crate::cpu::host) struct CoordinatedTargetResidentV1 {
+    schema: String,
+    last: Option<CoordinatedTargetSelectionV1>,
+}
