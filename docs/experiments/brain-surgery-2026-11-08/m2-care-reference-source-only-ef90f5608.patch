+#[test]
+fn grouped_taste_reference_candidate_probe() {
+    let (mut host, _, _) = matched_food_pair();
+    let first = host.step(TEMPERATURE).unwrap();
+    let d = &first.decisions[0];
+    let p = host.founder.phenotype();
+    let candidate =
+        super::super::recipe::build_matched_reference(super::super::SEED, true).unwrap();
+    let cp = &candidate.phenotype;
+    assert_ne!(p.phenotype_hash(), cp.phenotype_hash());
+    assert_eq!(p.neuron_dynamics(), cp.neuron_dynamics());
+    assert_eq!(p.sensor_encoder(), cp.sensor_encoder());
+    assert_eq!(p.candidate_decoder(), cp.candidate_decoder());
+    assert_eq!(p.synapses().len(), cp.synapses().len());
+    let changed = host
+        .founder
+        .weights()
+        .iter()
+        .zip(candidate.asset.weights())
+        .enumerate()
+        .filter(|(_, (a, b))| a.to_bits() != b.to_bits())
+        .map(|(i, (a, b))| json!({"row":i,"before":a,"after":b}))
+        .collect::<Vec<_>>();
+    assert_eq!(changed.len(), 6);
+    assert!(changed.iter().all(|c| c["before"] == 0.));
+    let base = TrainingSequence {
+        phenotype_hash: p.phenotype_hash(),
+        initial: d.source_trace_initial.clone(),
+        ticks: vec![d.source_trace_tick.clone(); 48],
+        burn_in_ticks: 0,
+        memory_candidate_gain: p
+            .candidate_decoder()
+            .memory_channel()
+            .unwrap()
+            .max_candidate_gain(),
+    };
+    let mut controls = vec![("actual_fixed_context".to_string(), base.clone())];
+    for (name, lane, values) in [
+        ("hunger", 0, [0., 0.35, 0.9]),
+        ("fear", 2, [0., 0.25, 0.9]),
+        ("pain", 3, [0., 0.1, 0.9]),
+    ] {
+        for value in values {
+            let mut q = base.clone();
+            let (n, x) = encoded_home(p, &d.source_trace_effects, lane, value);
+            for t in &mut q.ticks {
+                t.encoded_inputs[n] = x;
+            }
+            controls.push((format!("synthetic_{name}_{value}"), q));
+        }
+    }
+    let mut q = base.clone();
+    for lane in [0, 2, 3, 5] {
+        let (n, x) = encoded_home(p, &d.source_trace_effects, lane, 0.);
+        for t in &mut q.ticks {
+            t.encoded_inputs[n] = x;
+        }
+    }
+    controls.push(("synthetic_all_care_inputs_zero".into(), q));
+    let mut q = base.clone();
+    for t in &mut q.ticks {
+        t.encoded_inputs.fill(0.);
+    }
+    controls.push(("synthetic_all_encoded_inputs_zero".into(), q));
+    for offset in [-0.1_f32, 0.1] {
+        let mut q = base.clone();
+        for t in &mut q.ticks {
+            for x in &mut t.encoded_inputs {
+                *x = (*x + offset).clamp(-1., 1.);
+            }
+        }
+        controls.push((format!("synthetic_common_offset_{offset}"), q));
+    }
+    for threshold in [0., 0.5] {
+        let mut q = base.clone();
+        for t in &mut q.ticks {
+            t.local_threshold_shift = threshold;
+        }
+        controls.push((format!("synthetic_common_threshold_{threshold}"), q));
+    }
+    let cases = controls
+        .into_iter()
+        .map(|(name, q)| {
+            let old = compact_source(p, host.founder.weights(), &q);
+            let mut next = q.clone();
+            next.phenotype_hash = cp.phenotype_hash();
+            let new = compact_source(cp, candidate.asset.weights(), &next);
+            json!({"case":name,"baseline":old,"candidate":new})
+        })
+        .collect::<Vec<_>>();
+    // These are causal native-circuit gates, not a permanent refusal objective.
+    let fields = ["ingest_contrast", "avoid_contrast_sum", "contact_contrast"];
+    for case in &cases {
+        let rows = case["candidate"]["iterations"].as_array().unwrap();
+        for field in fields {
+            assert_eq!(
+                rows[0][field].as_f64().unwrap(),
+                0.,
+                "cold common-mode: {} {field}",
+                case["case"]
+            );
+            assert!(
+                rows.iter().all(|r| r[field].as_f64().unwrap() >= -1e-4),
+                "negative need contrast: {} {field}",
+                case["case"]
+            );
+            if case["case"].as_str().unwrap().contains("inputs_zero") {
+                assert!(
+                    rows.iter().all(|r| r[field].as_f64().unwrap().abs() < 1e-4),
+                    "zero-drive residual: {} {field}",
+                    case["case"]
+                );
+            }
+        }
+    }
+    for (axis, field) in [
+        ("hunger", "ingest_contrast"),
+        ("fear", "avoid_contrast_sum"),
+        ("pain", "avoid_contrast_sum"),
+    ] {
+        let low = cases
+            .iter()
+            .find(|c| c["case"] == format!("synthetic_{axis}_0"))
+            .unwrap();
+        let high = cases
+            .iter()
+            .find(|c| c["case"] == format!("synthetic_{axis}_0.9"))
+            .unwrap();
+        for i in 0..48 {
+            let derivative = |arm: &str| {
+                high[arm]["iterations"][i][field].as_f64().unwrap()
+                    - low[arm]["iterations"][i][field].as_f64().unwrap()
+            };
+            assert!(
+                (derivative("candidate") - derivative("baseline")).abs() < 1e-4,
+                "need derivative changed: {axis} iteration{}",
+                i + 1
+            );
+        }
+        assert!(
+            high["candidate"]["iterations"][47][field].as_f64().unwrap()
+                > low["candidate"]["iterations"][47][field].as_f64().unwrap() + 0.05
+        );
+        if axis == "hunger" {
+            assert!(low["candidate"]["iterations"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .all(|r| r[field].as_f64().unwrap() == 0.));
+        }
+    }
+    eprintln!(
+        "TASTE_REFERENCE_PROBE {}",
+        json!({"schema":"care-matched-reference-six-rows-v1-probe","scope":"authored fresh source, detached native fixed-frame diagnostic, not qualified biological care or learning; one baseline world decision captures input","candidate_metadata":candidate.metadata,"changed_grounded_rows":changed,"old_phenotype":p.phenotype_hash(),"new_phenotype":cp.phenotype_hash(),"source_controller_rows_unchanged":true,"cases":cases})
+    );
+}
