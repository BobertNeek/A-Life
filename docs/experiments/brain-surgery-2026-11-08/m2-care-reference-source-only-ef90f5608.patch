+#[test]
+fn grouped_taste_reference_actual_food_and_cold_continuation() {
+    let mut arms = vec![];
+    for taste in [TASTE_MAGNITUDE, -TASTE_MAGNITUDE] {
+        let recipe =
+            super::super::recipe::build_matched_reference(super::super::SEED, true).unwrap();
+        let (mut host, inputs) = super::super::fixture_from_recipe(240, recipe);
+        let food = add_harmless_food(&mut host, taste);
+        let original = frozen(&host);
+        let mut cold: Option<CpuGroupedM2HostV1> = None;
+        let mut rows = vec![];
+        let mut ingestions = 0;
+        let mut continuations = 0;
+        for interval in 0..INTERVAL_LIMIT {
+            let before = object_state(&host, food);
+            let step = host.step(TEMPERATURE).unwrap();
+            assert_eq!(step.decisions.len(), 1);
+            if let Some(mut restored) = cold.take() {
+                continuations += 1;
+                let repeated = restored.step(TEMPERATURE).unwrap();
+                assert_eq!(repeated.decisions.len(), 1);
+                assert_eq!(
+                    bytes(&repeated.decisions[0].action),
+                    bytes(&step.decisions[0].action)
+                );
+                assert_eq!(
+                    host.checkpoint().unwrap().encode().unwrap(),
+                    restored.checkpoint().unwrap().encode().unwrap()
+                );
+            }
+            for d in step.decisions {
+                let ingest = d
+                    .patch
+                    .pre_action()
+                    .perception()
+                    .candidates()
+                    .iter()
+                    .position(|c| c.family == CandidateActionFamily::Ingest)
+                    .unwrap();
+                let source_s = d.motor.native.core.components[ingest][0];
+                if interval == 0 {
+                    assert_eq!(source_s, 0.);
+                } else if taste > 0. {
+                    assert!(
+                        source_s > 0.,
+                        "positive cue source S must stay positive in this actual context"
+                    );
+                } else {
+                    assert!(
+                        source_s < 0.,
+                        "negative cue source S must stay negative in this actual context"
+                    );
+                }
+                let consumed = d
+                    .patch
+                    .outcome()
+                    .joint
+                    .as_ref()
+                    .unwrap()
+                    .channel_outcomes
+                    .iter()
+                    .any(|c| {
+                        c.physical.contact == PhysicalContactKind::Consumed
+                            && c.physical.target_entity == Some(food)
+                    });
+                ingestions += usize::from(consumed);
+                let transfers=d.source_trace_grip.iter().map(|g|json!({"kind":format!("{:?}",g.kind),"previous_owner":g.previous_owner,"new_owner":g.new_owner,"previous_position":g.previous_position,"new_position":g.new_position})).collect::<Vec<_>>();
+                rows.push(json!({"decision":rows.len()+1,"tick":step.tick_before,"before":before,"after":object_state(&host,food),"consumed_receipt":consumed,"grip_transfers":transfers,"source_logits":d.source_diagnostic_logits,"native_components":d.motor.native.core.components,"probabilities":d.motor.native.scores.probabilities(d.action.temperature).unwrap(),"action":d.action,"bundle":d.patch.selected_bundle(),"physiology":d.patch.outcome().measured_physiology}));
+            }
+            assert_eq!(original, frozen(&host));
+            if interval == 0 {
+                let saved = decode_exact(&host.checkpoint().unwrap());
+                cold = Some(
+                    CpuGroupedM2HostV1::restore(saved, &inputs, MediationModeV1::Full).unwrap(),
+                );
+            }
+            if host.world().entity(food).unwrap().consumed {
+                break;
+            }
+        }
+        assert_eq!(
+            continuations, 1,
+            "cold continuation must execute, not only restore"
+        );
+        assert_eq!(host.world().entity(food).unwrap().consumed, ingestions == 1);
+        if taste > 0. {
+            assert_eq!(
+                ingestions, 1,
+                "matched-reference source lost positive food competence in declared bound"
+            );
+        }
+        arms.push(json!({"chemical0_proposal":taste,"chemical2_oral":host.world().entity(food).unwrap().grounded_physical.chemical[2],"actual_decisions":rows.len(),"physical_ingestions":ingestions,"decisions":rows}));
+    }
+    eprintln!(
+        "TASTE_REFERENCE_WORLD {}",
+        json!({"candidate":"care-matched-reference-six-rows-v1","scope":"fresh native fixed-seed24-interval actual food controls with synapses closed; no permanent negative-cue refusal requirement","arms":arms})
+    );
+}
