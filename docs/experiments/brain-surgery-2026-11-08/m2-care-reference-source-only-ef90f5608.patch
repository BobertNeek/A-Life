+fn compact_source(p: &BrainPhenotype, weights: &[f32], q: &TrainingSequence) -> Value {
+    let tape = SparseGraph::new(p).forward(p, weights, q).unwrap();
+    let steps = p.microstep_count() as usize;
+    json!({"iterations":(0..q.ticks.len()).map(|i| {
+        let a=&tape.a[(i+1)*steps];
+        let tracked=[382,1966,911,1824,1839,1793,1796,1807,1814,1823].map(|n|json!({"neuron":n,"activation":a[n]}));
+        json!({"iteration":i+1,"ingest_contrast":a[1824]-a[1839],"avoid_contrast_sum":a[1793]+a[1796]-2.*a[1807],"contact_contrast":a[1814]-a[1823],"logits":tape.evaluation.candidate_logits[i],"tracked":tracked})
+    }).collect::<Vec<_>>()})
+}
