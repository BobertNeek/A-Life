@@ -0,0 +1,608 @@
+//! Fresh source diagnosis, not a policy or biological hunger intervention.
+//! Exact captured native source inputs are replayed with fixed receptors and
+//! candidate context. Synthetic drive clamps are labelled and never dispatched.
+use super::*;
+use crate::cpu::replay::{route_fires, SparseGraph};
+use crate::TrainingSequence;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+
+const TRACKED: [u32; 20] = [
+    256, 1952, 896, 1824, 1839, 257, 1953, 897, 1793, 260, 1956, 900, 1796, 1807, 383, 1967, 262,
+    1958, 902, 1823,
+];
+
+fn bits(v: &[f32]) -> Vec<u32> {
+    v.iter().map(|v| v.to_bits()).collect()
+}
+fn encoded_home(
+    p: &BrainPhenotype,
+    effects: &NeuralReceptorEffects,
+    lane: u16,
+    value: f32,
+) -> (usize, f32) {
+    let assignments = p
+        .sensor_encoder()
+        .assignments()
+        .iter()
+        .filter(|a| {
+            a.source_group() == SensorEncoderSourceGroup::Homeostasis && a.source_index() == lane
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(assignments.len(), 1);
+    let a = assignments[0];
+    assert_eq!(
+        p.sensor_encoder()
+            .assignments()
+            .iter()
+            .filter(|other| other.target_neuron() == a.target_neuron())
+            .count(),
+        1
+    );
+    let (min, max) = a.clamp_range();
+    let gate =
+        (effects.structural_growth_gate + effects.sleep_gate + effects.consolidation_gate) / 3.;
+    let signal = (value * effects.interoceptive_gain * a.scale() + a.bias()).clamp(min, max);
+    (
+        a.target_neuron() as usize,
+        (signal * effects.regional_excitability + (gate - 0.5) * 0.05).clamp(-1., 1.),
+    )
+}
+fn trace(p: &BrainPhenotype, weights: &[f32], q: &TrainingSequence) -> Value {
+    let tape = SparseGraph::new(p).forward(p, weights, q).unwrap();
+    let steps = p.microstep_count() as usize;
+    let mut rows = vec![];
+    for (iteration, tick) in q.ticks.iter().enumerate() {
+        for microstep in 0..tick.microstep_count as usize {
+            let index = iteration * steps + microstep;
+            let previous = &tape.a[index];
+            let neurons = TRACKED.iter().map(|&neuron| {
+                let target = neuron as usize;
+                let mut products = vec![];
+                let mut recurrent = 0.;
+                for (i,s) in p.synapses().iter().enumerate().filter(|(_,s)| s.kind() == CompiledSynapseKind::Recurrent && s.target() == neuron) {
+                    let effective = weights[i] + tick.effective_weight_offsets[i];
+                    if tick.enabled_routes[s.route_index() as usize] && route_fires(p.projections()[s.route_index() as usize].update_cadence().raw(), microstep) {
+                        let product = previous[s.source() as usize] * effective;
+                        recurrent += product;
+                        if effective != 0. { products.push(json!({"row":i,"source":s.source(),"route":s.route_index(),"weight":effective,"pre":previous[s.source() as usize],"product":product})); }
+                    }
+                }
+                for s in tick.structural_synapses.iter().filter(|s| s.target == neuron) {
+                    if tick.enabled_routes[s.route as usize] && route_fires(s.cadence as u8,microstep) { recurrent += previous[s.source as usize] * s.effective_weight; }
+                }
+                let dendritic = q.initial.dendrites.branches()[q.initial.dendrites.target_span(neuron)].iter().map(|b| crate::cpu::native_kernel::dendritic_activation(previous,b)).sum::<f32>();
+                let d = p.neuron_dynamics()[target];
+                json!({"neuron":neuron,"before":previous[target],"after":tape.a[index+1][target],"encoded":tick.encoded_inputs[target],"recurrent":recurrent,"dendritic":dendritic,"bias":d.bias(),"projection_gain":tick.projection_gain,"threshold":tick.local_threshold_shift,"metabolic_before":tape.m[index][target],"homeostatic_gain":d.homeostatic_gain(),"products":products})
+            }).collect::<Vec<_>>();
+            rows.push(
+                json!({"source_iteration":iteration+1,"microstep":microstep,"neurons":neurons}),
+            );
+        }
+    }
+    json!({"microsteps_per_iteration":q.ticks[0].microstep_count,"compiled_microsteps":steps,"logits":tape.evaluation.candidate_logits,"microsteps":rows,"final_activation_bits":bits(tape.evaluation.final_activations.last().unwrap())})
+}
+
+#[test]
+fn grouped_taste_native_cold_source_diagnosis() {
+    let (mut positive, _, _) = matched_food_pair();
+    let first = positive.step(TEMPERATURE).unwrap();
+    let d = &first.decisions[0];
+    let p = positive.founder.phenotype();
+    let q = TrainingSequence {
+        phenotype_hash: p.phenotype_hash(),
+        initial: d.source_trace_initial.clone(),
+        ticks: vec![d.source_trace_tick.clone(); 12],
+        burn_in_ticks: 0,
+        memory_candidate_gain: p
+            .candidate_decoder()
+            .memory_channel()
+            .unwrap()
+            .max_candidate_gain(),
+    };
+    assert!(q.initial.activations.iter().all(|x| *x == 0.));
+    let tape = SparseGraph::new(p)
+        .forward(p, positive.founder.weights(), &q)
+        .unwrap();
+    assert_eq!(
+        bits(&tape.evaluation.candidate_logits[0]),
+        bits(&d.source_diagnostic_logits)
+    );
+    let body = d.patch.pre_action().perception().homeostasis();
+    for (lane, value) in body.drives.to_array().iter().enumerate() {
+        let (i, v) = encoded_home(p, &d.source_trace_effects, lane as u16, *value);
+        assert_eq!(v.to_bits(), q.ticks[0].encoded_inputs[i].to_bits());
+    }
+    let mut cases = vec![
+        json!({"case":"actual_first_frame_frozen_context","scope":"first iteration matches actual source exactly; iterations2-12 detached fixed-frame recurrence, not a living trajectory","trace":trace(p,positive.founder.weights(),&q)}),
+    ];
+    for (axis, lane, values) in [
+        ("hunger", 0, [0., 0.35, 0.9]),
+        ("fear", 2, [0., 0.25, 0.9]),
+        ("pain", 3, [0., 0.1, 0.9]),
+    ] {
+        for value in values {
+            let mut control = q.clone();
+            let (i, v) = encoded_home(p, &d.source_trace_effects, lane, value);
+            for t in &mut control.ticks {
+                t.encoded_inputs[i] = v;
+            }
+            cases.push(json!({"case":format!("synthetic_{axis}_{value}"),"scope":"detached encoded-drive clamp; actual receptors, other encoded inputs and candidate context held fixed; no world or physiology intervention","axis":axis,"drive":value,"neuron":i,"encoded":v,"trace":trace(p,positive.founder.weights(),&control)}));
+        }
+    }
+    let recipe = super::super::recipe::build(super::super::SEED, true).unwrap();
+    let result = json!({"schema":"grouped-m2-cold-source-diagnosis-v1","source_commit":"32e109372be39a19cabf7d9fc7cbcd9ca7c91c19","unit_seed":super::super::SEED,"source_metadata":recipe.metadata,"source_phenotype":p.phenotype_hash(),"weights_sha256":format!("{:x}",Sha256::digest(serde_json::to_vec(positive.founder.weights()).unwrap())),"source_initial":q.initial,"actual_body":body,"receptor_effects":d.source_trace_effects,"actual_tick":d.source_trace_tick,"cases":cases,"actual_world_decisions":1,"synaptic_updates":0});
+    eprintln!(
+        "TASTE_SOURCE_DIAG {}",
+        serde_json::to_string(&result).unwrap()
+    );
+}
+
+fn object_state(host: &CpuGroupedM2HostV1, food: WorldEntityId) -> Value {
+    let o = host.world().entity(food).unwrap();
+    json!({"held_by":o.carried_by,"position":o.position,"consumed":o.consumed,"chemical0_proposal":o.grounded_physical.chemical[0],"chemical2_oral":o.grounded_physical.chemical[2]})
+}
+#[test]
+fn grouped_taste_native_actual_ownership_diagnosis() {
+    let (positive, negative, food) = matched_food_pair();
+    let mut arms = vec![];
+    for (label, mut host) in [("positive", positive), ("negative", negative)] {
+        let original = frozen(&host);
+        let mut rows = vec![];
+        for _ in 0..INTERVAL_LIMIT {
+            let before = object_state(&host, food);
+            let step = host.step(TEMPERATURE).unwrap();
+            let after = object_state(&host, food);
+            for d in step.decisions {
+                let transfers=d.source_trace_grip.iter().map(|g| json!({"object":g.object,"previous_owner":g.previous_owner,"new_owner":g.new_owner,"previous_position":g.previous_position,"new_position":g.new_position,"kind":format!("{:?}",g.kind)})).collect::<Vec<_>>();
+                rows.push(json!({"tick":step.tick_before,"decision":rows.len()+1,"before":before,"after":after,"grip_transfers":transfers,"bundle":d.patch.selected_bundle(),"physical":d.patch.outcome().physical,"joint":d.patch.outcome().joint,"source_logits":d.source_diagnostic_logits,"components":d.motor.native.core.components,"ordinary_scores":d.motor.native.scores.ordinary,"probabilities":d.motor.native.scores.probabilities(d.action.temperature).unwrap(),"selected":d.action}));
+            }
+            assert_eq!(frozen(&host), original);
+            if host.world().entity(food).unwrap().consumed {
+                break;
+            }
+        }
+        arms.push(json!({"arm":label,"decisions":rows,"final":object_state(&host,food)}));
+    }
+    eprintln!(
+        "TASTE_OWNERSHIP_DIAG {}",
+        json!({"schema":"corrected-c0-ownership-diagnosis-v1","source_commit":"32e109372be39a19cabf7d9fc7cbcd9ca7c91c19","unit_seed":super::super::SEED,"scope":"bounded actual fresh physical fixtures; C0 proposal differs, C2 oral taste matched; no source retune or synaptic learning","arms":arms})
+    );
+}
