+                record.len(),
+                compression.as_micros(),
+                decompression.as_micros(),
+                Sha256::digest(&raw)
+            );
+        }
+        assert_eq!(
+            hash(b"abc"),
+            [
+                0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea, 0x41, 0x41, 0x40, 0xde, 0x5d, 0xae,
+                0x22, 0x23, 0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c, 0xb4, 0x10, 0xff, 0x61,
+                0xf2, 0x00, 0x15, 0xad
+            ]
+        );
+    }
+    #[test]
+    fn malformed_contracts() {
+        let good = encode(7, b"opaque synthetic fixture bytes only", limits()).unwrap();
+        for len in 0..good.len() {
+            assert!(
+                decode(&good[..len], 7, limits()).is_err(),
+                "truncation {len}"
+            );
+        }
+        for at in 0..good.len() {
+            let mut b = good.clone();
+            b[at] ^= 0x80;
+            assert!(decode(&b[..], 7, limits()).is_err(), "mutation {at}");
+        }
+        for at in [24, 32] {
+            let mut b = good.clone();
+            b[at..at + 8].copy_from_slice(&u64::MAX.to_le_bytes());
+            assert!(decode(&b[..], 7, limits()).is_err());
+        }
+        for n in [0, 1, 100] {
+            let mut b = good.clone();
+            b[24..32].copy_from_slice(&(n as u64).to_le_bytes());
+            assert!(decode(&b[..], 7, limits()).is_err());
+        }
+        assert!(decode(&good[..], 8, limits()).is_err());
+        assert!(encode(0, &[1; 100], Limits { raw: 1, ..limits() }).is_err());
+        assert!(encode(
+            0,
+            &[1; 100],
+            Limits {
+                compressed: 13,
+                ..limits()
+            }
+        )
+        .is_err());
+        assert!(decode(
+            &good[..],
+            7,
+            Limits {
+                raw: MAX_RAW + 1,
+                ..limits()
+            }
+        )
+        .is_err());
+        let mut b = good.clone();
+        b.push(0);
+        assert!(decode(&b[..], 7, limits()).is_err());
+        // Correct outer hash and length cannot authorize a second frame.
+        let mut b = good.clone();
+        b.extend_from_slice(&good[HEADER..]);
+        let len = (b.len() - HEADER) as u64;
+        b[32..40].copy_from_slice(&len.to_le_bytes());
+        rehash(&mut b);
+        assert!(decode(&b[..], 7, limits()).is_err());
+        let mut b = good.clone();
+        b[HEADER..HEADER + 4].copy_from_slice(&[0x50, 0x2a, 0x4d, 0x18]);
+        rehash(&mut b);
+        assert!(decode(&b[..], 7, limits()).is_err());
+        // Decoder must reject damaged frame even if outer compressed hash was recomputed.
+        let mut b = good.clone();
+        let last = b.len() - 1;
+        b[last] ^= 1;
+        rehash(&mut b);
+        assert!(decode(&b[..], 7, limits()).is_err());
+        // Bomb declares tiny output but expands to 1 MiB: reject after <=2 output bytes.
+        let mut b = encode(7, &vec![0; 1024 * 1024], limits()).unwrap();
+        b[24..32].copy_from_slice(&1u64.to_le_bytes());
+        assert!(decode(&b[..], 7, limits()).is_err());
+    }
+    #[test]
+    fn publication_claims() {
+        let path = root("publish");
+        let journal = Journal::create(&path, limits()).unwrap();
+        assert!(Journal::create(&path, limits()).is_err());
+        journal.publish(1, b"first opaque snapshot").unwrap();
+        assert!(journal.publish(1, b"replacement").is_err());
+        assert_eq!(
+            read_snapshot(&path, 1, limits()).unwrap().raw,
+            b"first opaque snapshot"
+        );
+        assert!(read_snapshot(&path, 2, limits()).is_err());
+        fs::create_dir(path.join(format!("{:020}.claim", 2))).unwrap();
+        assert!(journal.publish(2, b"partial cannot retry").is_err());
+        journal.publish(3, b"second complete snapshot").unwrap();
+        assert_eq!(
+            read_snapshot(&path, 3, limits()).unwrap().raw,
+            b"second complete snapshot"
+        );
+    }
+    #[test]
+    fn oversized_window_is_rejected() {
+        // Opaque zero stream only. Unknown pledged size forces a normal window header.
+        let mut encoder = zstd::stream::write::Encoder::new(Vec::new(), 1).unwrap();
+        encoder.window_log(24).unwrap();
+        for _ in 0..1024 {
+            encoder.write_all(&[0u8; 16 * 1024]).unwrap();
+        }
+        let frame = encoder.finish().unwrap();
+        let mut record = encode(7, b"", limits()).unwrap();
+        record.truncate(HEADER);
+        record[24..32].copy_from_slice(&(16u64 * 1024 * 1024).to_le_bytes());
+        record[32..40].copy_from_slice(&(frame.len() as u64).to_le_bytes());
+        record.extend_from_slice(&frame);
+        rehash(&mut record);
+        let error = decode(&record[..], 7, Limits::default()).unwrap_err();
+        assert!(error.to_string().contains("too much memory"), "{error}");
+    }
+    #[test]
+    fn concurrent_publish_has_one_winner() {
+        let path = root("race");
+        let journal = std::sync::Arc::new(Journal::create(&path, limits()).unwrap());
+        let barrier = std::sync::Arc::new(std::sync::Barrier::new(2));
+        let handles: Vec<_> = [b"opaque A".as_slice(), b"opaque B".as_slice()]
+            .into_iter()
+            .map(|raw| {
+                let journal = journal.clone();
+                let barrier = barrier.clone();
+                std::thread::spawn(move || {
+                    barrier.wait();
+                    journal.publish(9, raw).is_ok()
+                })
+            })
+            .collect();
+        assert_eq!(
+            handles
+                .into_iter()
+                .filter_map(|h| h.join().ok())
+                .filter(|ok| *ok)
+                .count(),
+            1
+        );
+        let restored = read_snapshot(&path, 9, limits()).unwrap().raw;
+        assert!(restored == b"opaque A" || restored == b"opaque B");
+    }
+    #[test]
+    fn old_or_wrong_owner_is_rejected() {
+        let path = root("owner");
+        fs::create_dir(&path).unwrap();
+        new_synced_file(&path.join("OWNER"), b"old-raw-journal\n").unwrap();
+        assert!(read_snapshot(&path, 0, limits()).is_err());
+        assert!(decode(b"old raw checkpoint bytes".as_slice(), 0, limits()).is_err());
+    }
+    #[test]
+    fn crash_child() {
+        let Ok(phase) = std::env::var("JOURNAL_CRASH_PHASE") else {
+            return;
+        };
+        let phase: u8 = phase.parse().unwrap();
+        let path = PathBuf::from(std::env::var_os("JOURNAL_CRASH_PATH").unwrap());
+        let journal = Journal::create(&path, limits()).unwrap();
+        journal
+            .publish_inner(5, b"complete crash fixture", |p| {
+                if p == phase {
+                    std::process::exit(73)
+                }
+            })
+            .unwrap();
+        panic!("crash phase not reached");
+    }
+    #[test]
+    fn process_failure_boundaries() {
+        for phase in 1..=4 {
+            let path = root(&format!("crash-{phase}"));
+            let status = Command::new(std::env::current_exe().unwrap())
+                .args(["--exact", "tests::crash_child", "--nocapture"])
+                .env("JOURNAL_CRASH_PHASE", phase.to_string())
+                .env("JOURNAL_CRASH_PATH", &path)
+                .status()
+                .unwrap();
+            assert_eq!(status.code(), Some(73));
+            let journal = Journal {
+                root: path.clone(),
+                limits: limits(),
+            };
+            assert!(journal.publish(5, b"retry forbidden").is_err());
+            if phase < 3 {
+                assert!(read_snapshot(&path, 5, limits()).is_err());
+            } else {
+                assert_eq!(
+                    read_snapshot(&path, 5, limits()).unwrap().raw,
+                    b"complete crash fixture"
+                );
+            }
+        }
+    }
+}
