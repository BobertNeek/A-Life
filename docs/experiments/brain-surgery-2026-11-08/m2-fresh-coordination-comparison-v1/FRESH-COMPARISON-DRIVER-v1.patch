+//! Opt-in, opaque-byte research journal. No organism/checkpoint interpretation.
+//! Unix local filesystems only; directory fsync and atomic hard links required.
+//! A private, trusted parent directory is required (not a hostile shared tree).
+use sha2::{Digest, Sha256};
+use std::{
+    fs::{self, File, OpenOptions},
+    io::{self, Read, Write},
+    path::{Path, PathBuf},
+};
+const MAGIC: &[u8; 8] = b"M2ZJNL01";
+const OWNER: &[u8] = b"alife-m2-lossless-research-journal-v1\n";
+const HEADER: usize = 104;
+pub const MAX_RAW: u64 = 64 * 1024 * 1024;
+pub const MAX_COMPRESSED: u64 = 65 * 1024 * 1024;
+const WINDOW_LOG: u32 = 23;
+fn bad(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+fn hash(bytes: &[u8]) -> [u8; 32] {
+    Sha256::digest(bytes).into()
+}
+#[derive(Clone, Copy, Debug)]
+pub struct Limits {
+    pub raw: u64,
+    pub compressed: u64,
+}
+impl Limits {
+    fn check(self) -> io::Result<()> {
+        if self.raw > MAX_RAW || self.compressed > MAX_COMPRESSED || self.compressed < 13 {
+            return Err(bad("unsupported limits"));
+        }
+        Ok(())
+    }
+}
+impl Default for Limits {
+    fn default() -> Self {
+        Self {
+            raw: MAX_RAW,
+            compressed: MAX_COMPRESSED,
+        }
+    }
+}
+#[derive(Debug)]
+pub struct Snapshot {
+    pub sequence: u64,
+    pub raw_sha256: [u8; 32],
+    pub raw: Vec<u8>,
+}
+struct Capped {
+    bytes: Vec<u8>,
+    max: usize,
+}
+impl Write for Capped {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        if bytes.len() > self.max.saturating_sub(self.bytes.len()) {
+            return Err(bad("compressed limit"));
+        }
+        self.bytes.extend_from_slice(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+/// Compression bytes are not scientific identity: identity is the original raw SHA.
+/// Codec upgrades may produce different frames for the same original bytes.
+pub fn encode(sequence: u64, raw: &[u8], limits: Limits) -> io::Result<Vec<u8>> {
+    limits.check()?;
+    if raw.len() as u64 > limits.raw {
+        return Err(bad("raw limit"));
+    }
+    let mut encoder = zstd::stream::write::Encoder::new(
+        Capped {
+            bytes: Vec::new(),
+            max: limits.compressed as usize,
+        },
+        1,
+    )?;
+    encoder.window_log(WINDOW_LOG)?;
+    encoder.include_checksum(true)?;
+    encoder.set_pledged_src_size(Some(raw.len() as u64))?;
+    encoder.write_all(raw)?;
+    let frame = encoder.finish()?.bytes;
+    let mut record = Vec::with_capacity(HEADER + frame.len());
+    record.extend_from_slice(MAGIC);
+    record.extend_from_slice(&1u32.to_le_bytes()); // version
+    record.extend_from_slice(&1u32.to_le_bytes()); // codec: standard single zstd frame
+    record.extend_from_slice(&sequence.to_le_bytes());
+    record.extend_from_slice(&(raw.len() as u64).to_le_bytes());
+    record.extend_from_slice(&(frame.len() as u64).to_le_bytes());
+    record.extend_from_slice(&hash(raw));
+    record.extend_from_slice(&hash(&frame));
+    record.extend_from_slice(&frame);
+    Ok(record)
+}
+/// Bounded input and streaming output; returns no raw bytes until full validation.
+/// Rejects extra frames, skippable frames and trailing bytes, even within the limit.
+pub fn decode(mut reader: impl Read, sequence: u64, limits: Limits) -> io::Result<Snapshot> {
+    limits.check()?;
+    let mut header = [0u8; HEADER];
+    reader.read_exact(&mut header)?;
+    if &header[..8] != MAGIC
+        || header[8..12] != 1u32.to_le_bytes()
+        || header[12..16] != 1u32.to_le_bytes()
+    {
+        return Err(bad("unknown journal format/version/codec"));
+    }
+    let field = |at| u64::from_le_bytes(header[at..at + 8].try_into().unwrap());
+    let raw_len = field(24);
+    let compressed_len = field(32);
+    if field(16) != sequence
+        || raw_len > limits.raw
+        || compressed_len > limits.compressed
+        || compressed_len < 13
+    {
+        return Err(bad("sequence or declared length outside contract"));
+    }
+    let mut frame = vec![0; compressed_len as usize];
+    reader.read_exact(&mut frame)?;
+    let mut extra = [0];
+    if reader.read(&mut extra)? != 0 {
+        return Err(bad("trailing record bytes"));
+    }
+    if hash(&frame) != header[72..104] {
+        return Err(bad("compressed SHA mismatch"));
+    }
+    if frame[..4] != [0x28, 0xb5, 0x2f, 0xfd]
+        || zstd::zstd_safe::find_frame_compressed_size(&frame)
+            .map_err(|_| bad("invalid zstd frame"))?
+            != frame.len()
+    {
+        return Err(bad("expected exactly one standard zstd frame"));
+    }
+    let mut decoder = zstd::stream::read::Decoder::with_buffer(frame.as_slice())?.single_frame();
+    decoder.window_log_max(WINDOW_LOG)?;
+    let mut raw = Vec::new();
+    let mut digest = Sha256::new();
+    let mut chunk = [0u8; 16 * 1024];
+    loop {
+        // Read at most remaining + 1; catches oversized output without an unbounded allocation.
+        let cap = ((raw_len - raw.len() as u64).saturating_add(1)).min(chunk.len() as u64) as usize;
+        let count = decoder.read(&mut chunk[..cap])?;
+        if count == 0 {
+            break;
+        }
+        if count as u64 > raw_len - raw.len() as u64 {
+            return Err(bad("decompressed size exceeds declaration"));
+        }
+        digest.update(&chunk[..count]);
+        raw.extend_from_slice(&chunk[..count]);
+    }
+    if !decoder.finish().is_empty()
+        || raw.len() as u64 != raw_len
+        || digest.finalize().as_slice() != &header[40..72]
+    {
+        return Err(bad("incomplete frame, raw size or SHA mismatch"));
+    }
+    Ok(Snapshot {
+        sequence,
+        raw_sha256: header[40..72].try_into().unwrap(),
+        raw,
+    })
+}
+fn sync_dir(path: &Path) -> io::Result<()> {
+    File::open(path)?.sync_all()
+}
+fn new_synced_file(path: &Path, bytes: &[u8]) -> io::Result<()> {
+    let mut file = OpenOptions::new().create_new(true).write(true).open(path)?;
+    file.write_all(bytes)?;
+    let mut permissions = file.metadata()?.permissions();
+    permissions.set_readonly(true);
+    file.set_permissions(permissions)?;
+    file.sync_all()
+}
+/// No append/resume into old journals. Creation is an exclusive, permanent claim.
+/// Errors may leave a partial directory: do not retry that directory or erase it.
+pub struct Journal {
+    root: PathBuf,
+    limits: Limits,
+}
+impl Journal {
+    pub fn create(root: &Path, limits: Limits) -> io::Result<Self> {
+        limits.check()?;
+        let parent = root
+            .parent()
+            .filter(|p| !p.as_os_str().is_empty())
+            .ok_or_else(|| bad("explicit parent required"))?;
+        fs::create_dir(root)?;
+        sync_dir(parent)?;
+        new_synced_file(&root.join("OWNER"), OWNER)?;
+        sync_dir(root)?;
+        Ok(Self {
+            root: root.to_owned(),
+            limits,
+        })
+    }
+    /// A permanent sequence claim prevents overwrite/retry even after process failure.
+    /// An error after hard_link has uncertain durability; the complete final file can
+    /// already exist. Stop this run and inspect with read_snapshot, never republish.
+    pub fn publish(&self, sequence: u64, raw: &[u8]) -> io::Result<[u8; 32]> {
+        self.publish_inner(sequence, raw, |_| {})
+    }
+    fn publish_inner(
+        &self,
+        sequence: u64,
+        raw: &[u8],
+        mut phase: impl FnMut(u8),
+    ) -> io::Result<[u8; 32]> {
+        let record = encode(sequence, raw, self.limits)?;
+        let claim = self.root.join(format!("{sequence:020}.claim"));
+        fs::create_dir(&claim)?;
+        sync_dir(&self.root)?;
+        phase(1);
+        let staged = claim.join("snapshot.pending");
+        new_synced_file(&staged, &record)?;
+        sync_dir(&claim)?;
+        phase(2);
+        fs::hard_link(&staged, self.root.join(format!("{sequence:020}.m2z")))?;
+        phase(3);
+        sync_dir(&self.root)?;
+        phase(4);
+        // Keep claim and staged hard link as immutable recovery evidence, not a copy.
+        Ok(hash(raw))
+    }
+}
+/// Reads only the explicit new format; never falls back to an old/raw loader.
+pub fn read_snapshot(root: &Path, sequence: u64, limits: Limits) -> io::Result<Snapshot> {
+    let mut owner = Vec::new();
+    File::open(root.join("OWNER"))?
+        .take((OWNER.len() + 1) as u64)
+        .read_to_end(&mut owner)?;
+    if owner != OWNER {
+        return Err(bad("journal owner mismatch"));
+    }
+    decode(
+        File::open(root.join(format!("{sequence:020}.m2z")))?,
+        sequence,
+        limits,
+    )
+}
