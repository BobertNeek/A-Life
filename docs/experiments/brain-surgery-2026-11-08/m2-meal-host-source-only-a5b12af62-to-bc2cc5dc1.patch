@@ -0,0 +1,593 @@
+//! Synthetic CPU contracts, not native host, biological sleep, or world evidence.
+use super::*;
+use crate::predictive::GroundedSuccessorPredictor;
+use crate::sleep::{MealSleepWorkReceiptV1, SleepReplayEvidence, SleepWorkReceipt};
+
+#[derive(Debug, Clone, PartialEq)]
+struct Harness {
+    memory: MemorySidecarState,
+    predictor: GroundedSuccessorPredictor,
+    topology: TopologySidecar,
+}
+
+fn consolidator(limit: usize) -> SleepConsolidator {
+    SleepConsolidator::new(SleepConsolidationConfig {
+        memory_max_records_after: limit,
+        ..SleepConsolidationConfig::reference()
+    })
+    .unwrap()
+}
+
+impl Harness {
+    fn new(capacity: usize) -> Self {
+        Self {
+            memory: MemorySidecarState::new_profiled(OWNER, identity(), config(capacity)).unwrap(),
+            predictor: GroundedSuccessorPredictor::default(),
+            topology: TopologySidecar::new_profiled(
+                OWNER,
+                identity(),
+                TopologicalMapConfig {
+                    max_concepts: 16,
+                    max_edges: 32,
+                    max_simplexes: 16,
+                    max_unresolved_gaps: 8,
+                    edge_decay_per_tick: NormalizedScalar::new(0.05).unwrap(),
+                },
+            )
+            .unwrap(),
+        }
+    }
+
+    fn observe(
+        &mut self,
+        sequence: u64,
+        case: Case,
+    ) -> (
+        SleepReplayEvent,
+        PredictionTargetReceipt,
+        MealMemorySleepProofV1,
+    ) {
+        let (patch, frame) = fixture(sequence, case).unwrap();
+        let transaction = self
+            .memory
+            .observe_sealed_patch_with_meal_v1(&patch, &frame)
+            .unwrap();
+        let (event, target) = meal_sleep_source(&patch);
+        let proof = MealMemorySleepProofV1::capture(&patch, event, &target, transaction).unwrap();
+        (event, target, proof)
+    }
+
+    fn run(
+        &mut self,
+        evidence: &SleepReplayEvidence,
+        proofs: &[MealMemorySleepProofV1],
+    ) -> Result<Option<MealSleepWorkReceiptV1>, ScaffoldContractError> {
+        let consolidator = consolidator(self.memory.bank().capacity());
+        self.memory.run_bounded_sleep_transaction_with_meal_v1(
+            &consolidator,
+            &HomeostaticSnapshot::baseline(Tick::new(100)),
+            Tick::new(100),
+            evidence,
+            proofs,
+            &mut self.predictor,
+            &mut self.topology,
+        )
+    }
+}
+
+fn evidence(pairs: &[(SleepReplayEvent, PredictionTargetReceipt)]) -> SleepReplayEvidence {
+    let capacity = pairs.len().max(1) as u32;
+    let mut journal = SleepReplayJournal::new(
+        ReplayCapturePlan::try_new(vec![3], 1, capacity, capacity).unwrap(),
+    )
+    .unwrap();
+    for (event, _) in pairs {
+        journal.push(*event, &[0.75]).unwrap();
+    }
+    SleepReplayEvidence::new(
+        journal
+            .build_bounded_batch(capacity, capacity, u32::MAX)
+            .unwrap(),
+        pairs.iter().map(|(_, target)| target.clone()).collect(),
+    )
+    .unwrap()
+}
+
+fn retained_case(capacity: usize) -> (Harness, SleepReplayEvidence, MealMemorySleepProofV1) {
+    assert_positive_meal_control();
+    let mut h = Harness::new(capacity);
+    let (event, target, proof) = h.observe(1, Case::default());
+    let evidence = evidence(&[(event, target)]);
+    // Rejecting cases start with a positive sleep control, not just a valid
+    // patch, so unrelated new-path failure cannot pass a rejection test.
+    let receipt = h
+        .clone()
+        .run(&evidence, std::slice::from_ref(&proof))
+        .expect("positive meal sleep transaction")
+        .expect("retained source produces work");
+    assert_eq!(receipt.replay_event_count, 1);
+    assert_eq!(receipt.promoted_memory_ids.len(), 2);
+    receipt.validate_contract().unwrap();
+    (h, evidence, proof)
+}
+
+fn altered_sibling(proof: &MealMemorySleepProofV1) -> MealMemorySleepProofV1 {
+    let mut value = serde_json::to_value(proof).unwrap();
+    value["transaction"]["supplemental"]["proof"]["dispatch_generation"] = serde_json::json!(99);
+    serde_json::from_value(value).unwrap()
+}
+
+#[test]
+fn meal_bounded_sleep_two_ids_count_one_event_sample_and_predictor_update() {
+    let (mut h, evidence, proof) = retained_case(8);
+    let memory_before = h.memory.clone();
+    let evidence_before = evidence.clone();
+    let mut expected_predictor = h.predictor.clone();
+    expected_predictor
+        .observe(&evidence.prediction_targets[0])
+        .unwrap();
+    // The legacy lifetime limit is not a cap on candidate IDs or replay.
+    let receipt = h
+        .memory
+        .run_bounded_sleep_transaction_with_meal_v1(
+            &consolidator(1),
+            &HomeostaticSnapshot::baseline(Tick::new(100)),
+            Tick::new(100),
+            &evidence,
+            std::slice::from_ref(&proof),
+            &mut h.predictor,
+            &mut h.topology,
+        )
+        .unwrap()
+        .unwrap();
+    let ids = proof.resolve_associations(h.memory.bank()).unwrap();
+    assert_eq!(
+        receipt.promoted_memory_ids,
+        ids.into_iter().flatten().collect::<Vec<_>>()
+    );
+    assert_eq!(receipt.replay_event_count, 1);
+    assert_eq!(receipt.replay_eligibility_sample_count, 1);
+    assert_eq!(receipt.predictor_update_count, 1);
+    assert_eq!(receipt.work_units, 5);
+    assert_eq!(h.predictor, expected_predictor);
+    assert_eq!(h.memory, memory_before);
+    assert_eq!(evidence, evidence_before);
+    assert_eq!(
+        receipt.replay_digest,
+        sleep_meal_memory_replay_digest_v1(&evidence, &[proof]).unwrap()
+    );
+    assert_ne!(receipt.replay_digest, evidence.canonical_digest);
+}
+
+#[test]
+fn meal_bounded_sleep_evicted_representative_replays_surviving_meal_once() {
+    let (mut h, evidence, proof) = retained_case(2);
+    let original_ids = proof.resolve_associations(h.memory.bank()).unwrap();
+    let (_, _, replacement) = h.observe(
+        2,
+        Case {
+            meal_contact: PhysicalContactKind::Touch,
+            reward: -0.9,
+            success: false,
+            ..Case::default()
+        },
+    );
+    assert!(replacement.transaction().supplemental.is_none());
+    assert!(matches!(replacement.transaction().representative,
+        MemoryUpdateKind::Evicted { removed, .. } if Some(removed) == original_ids[0]));
+    assert_eq!(
+        proof.resolve_associations(h.memory.bank()).unwrap(),
+        [None, original_ids[1]]
+    );
+    let memory_before = h.memory.clone();
+    let mut expected = h.predictor.clone();
+    expected.observe(&evidence.prediction_targets[0]).unwrap();
+    let receipt = h.run(&evidence, &[proof]).unwrap().unwrap();
+    assert_eq!(receipt.promoted_memory_ids, vec![original_ids[1].unwrap()]);
+    assert_eq!(receipt.replay_event_count, 1);
+    assert_eq!(receipt.replay_eligibility_sample_count, 1);
+    assert_eq!(receipt.predictor_update_count, 1);
+    assert_eq!(receipt.work_units, 4);
+    assert_eq!(h.predictor, expected);
+    assert_eq!(h.memory, memory_before);
+}
+
+#[test]
+fn meal_bounded_sleep_all_evicted_and_empty_batches_do_no_work() {
+    let (mut h, evicted, proof) = retained_case(2);
+    h.observe(
+        2,
+        Case {
+            reward: -0.9,
+            success: false,
+            ..Case::default()
+        },
+    );
+    assert_eq!(
+        proof.resolve_associations(h.memory.bank()).unwrap(),
+        [None, None]
+    );
+    let before = h.clone();
+    assert_eq!(h.run(&evicted, std::slice::from_ref(&proof)).unwrap(), None);
+    assert_eq!(h, before);
+    assert_eq!(h.run(&evidence(&[]), &[]).unwrap(), None);
+    assert_eq!(h, before);
+    assert!(h.run(&evicted, &[altered_sibling(&proof)]).is_err());
+    assert_eq!(h, before);
+}
+
+#[test]
+fn meal_bounded_sleep_merged_sources_deduplicate_ids_not_original_events() {
+    let (mut h, first, first_proof) = retained_case(8);
+    let (middle_event, middle_target, middle_proof) = h.observe(2, Case::default());
+    let (last_event, last_target, last_proof) = h.observe(3, Case::default());
+    assert_eq!(
+        middle_proof.resolve_associations(h.memory.bank()).unwrap(),
+        [None, None]
+    );
+    let mixed = evidence(&[
+        (first.batch.events[0], first.prediction_targets[0].clone()),
+        (middle_event, middle_target),
+        (last_event, last_target),
+    ]);
+    let proofs = [first_proof, middle_proof, last_proof];
+    let mut expected = h.predictor.clone();
+    expected.observe(&mixed.prediction_targets[0]).unwrap();
+    expected.observe(&mixed.prediction_targets[2]).unwrap();
+    let memory_before = h.memory.clone();
+    let receipt = h.run(&mixed, &proofs).unwrap().unwrap();
+    assert_eq!(receipt.promoted_memory_ids.len(), 2);
+    assert_eq!(receipt.replay_event_count, 2);
+    assert_eq!(receipt.replay_eligibility_sample_count, 2);
+    assert_eq!(receipt.predictor_update_count, 2);
+    assert_eq!(receipt.work_units, 8);
+    assert_eq!(h.predictor, expected);
+    assert_eq!(h.memory, memory_before);
+    assert_eq!(mixed.batch.events.len(), 3);
+    assert_eq!(mixed.prediction_targets.len(), 3);
+}
+
+#[test]
+fn meal_bounded_sleep_malformed_unavailable_sibling_rejects_after_valid_source() {
+    let (mut h, first, first_proof) = retained_case(8);
+    let (middle_event, middle_target, middle_proof) = h.observe(2, Case::default());
+    h.observe(3, Case::default());
+    assert_eq!(
+        middle_proof.resolve_associations(h.memory.bank()).unwrap(),
+        [None, None]
+    );
+    assert!(first_proof.resolve_associations(h.memory.bank()).unwrap()[0].is_some());
+    let mixed = evidence(&[
+        (first.batch.events[0], first.prediction_targets[0].clone()),
+        (middle_event, middle_target),
+    ]);
+    let before = h.clone();
+    assert!(h
+        .run(&mixed, &[first_proof, altered_sibling(&middle_proof)])
+        .is_err());
+    assert_eq!(h, before);
+}
+
+#[test]
+fn meal_bounded_sleep_missing_duplicate_and_swapped_proofs_reject_atomically() {
+    let (mut h, first, first_proof) = retained_case(8);
+    let (second_event, second_target, second_proof) = h.observe(2, Case::default());
+    let mixed = evidence(&[
+        (first.batch.events[0], first.prediction_targets[0].clone()),
+        (second_event, second_target),
+    ]);
+    let before = h.clone();
+    for proofs in [
+        vec![first_proof.clone()],
+        vec![first_proof.clone(), first_proof.clone()],
+        vec![second_proof.clone(), first_proof.clone()],
+        vec![first_proof.clone(), second_proof, first_proof.clone()],
+    ] {
+        assert!(h.run(&mixed, &proofs).is_err());
+        assert_eq!(h, before);
+    }
+    assert!(matches!(
+        h.memory
+            .bank()
+            .memory_ids_for_sleep_with_meal_v1(&[first_proof.clone(), first_proof], 8,),
+        Err(ScaffoldContractError::MemoryReplayRejected)
+    ));
+    let mut duplicate_events = mixed;
+    duplicate_events.batch.events[1] = duplicate_events.batch.events[0];
+    assert!(duplicate_events.validate_contract().is_err());
+    assert!(h.run(&duplicate_events, &[]).is_err());
+    assert_eq!(h, before);
+}
