+#[test]
+fn meal_actual_sampled_fixed_scene_reports_physical_and_association_coverage_separately() {
+    let (mut host, _) = fixture(true);
+    let before = frozen(&host);
+    let (mut decisions, mut physical_meals, mut supplements, mut retained_meals) = (0, 0, 0, 0);
+    for _ in 0..8 {
+        let step = host.step(0.73).unwrap();
+        assert_eq!(step.base.tick_after.raw(), step.base.tick_before.raw() + 1);
+        assert_eq!(step.base.decisions.len(), step.meal_transactions.len());
+        for (decision, (owner, write)) in step.base.decisions.iter().zip(&step.meal_transactions) {
+            decisions += 1;
+            physical_meals += consumed(decision);
+            assert_eq!(*owner, decision.organism_id);
+            assert_eq!(
+                write.sealed_sequence_id,
+                decision.patch.header().sequence_id
+            );
+            assert_eq!(write.output_generation, write.input_generation + 1);
+            assert_eq!(decision.motor.native.core.source_execution_count, 1);
+            assert_eq!(
+                decision
+                    .patch
+                    .decision()
+                    .cognitive_work
+                    .as_ref()
+                    .unwrap()
+                    .learning_ops,
+                0
+            );
+            if let Some(meal) = &write.supplemental {
+                supplements += 1;
+                retained_meals += usize::from(retained(meal.kind).is_some());
+                assert_eq!(consumed(decision), 1);
+                assert_eq!(meal.proof.physical_contact, PhysicalContactKind::Consumed);
+            }
+        }
+    }
+    assert_eq!(frozen(&host), before);
+    println!("actual-sampled fixed-source decisions={decisions} physical-consumed={physical_meals} supplemental-proven={supplements} supplemental-retained={retained_meals}; branch-covered={}", supplements > 0);
+    // This is honest coverage reporting, not a forced autonomous-learning pass.
+    // If no supplemental branch was sampled, the native report must say so.
+}
