+#[test]
+fn meal_bounded_sleep_checks_actual_candidate_capacity_before_resolution() {
+    let (h, _evidence, proof) = retained_case(8);
+    let mut bank = h.memory.bank().clone();
+    assert!(bank
+        .memory_ids_for_sleep_with_meal_v1(std::slice::from_ref(&proof), 8)
+        .is_ok());
+    bank.config.capacity = 1;
+    let before = bank.clone();
+    assert!(bank.memory_ids_for_sleep_with_meal_v1(&[proof], 1).is_err());
+    assert_eq!(bank, before);
+}
