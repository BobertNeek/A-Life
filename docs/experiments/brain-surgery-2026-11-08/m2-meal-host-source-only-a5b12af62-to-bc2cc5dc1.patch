+#[test]
+fn meal_bounded_sleep_receipt_keeps_legacy_one_id_validation_and_bytes() {
+    let (mut h, evidence, proof) = retained_case(8);
+    let receipt = h.run(&evidence, &[proof]).unwrap().unwrap();
+    for change in 0..4 {
+        let mut bad = receipt.clone();
+        match change {
+            0 => bad.promoted_memory_ids[1] = bad.promoted_memory_ids[0],
+            1 => {
+                bad.promoted_memory_ids.push(MemoryId(999));
+                bad.work_units += 1;
+            }
+            2 => {
+                bad.predictor_update_count = 2;
+                bad.work_units += 1;
+            }
+            _ => bad.work_units += 1,
+        }
+        bad.canonical_digest = bad.recompute_canonical_digest().unwrap();
+        assert!(bad.validate_contract().is_err());
+    }
+    let mut old: SleepWorkReceipt =
+        serde_json::from_slice(&serde_json::to_vec(&receipt).unwrap()).unwrap();
+    old.schema_version = SLEEP_CONSOLIDATION_SCHEMA_VERSION;
+    old.canonical_digest = old.recompute_canonical_digest().unwrap();
+    assert!(
+        old.validate_contract().is_err(),
+        "legacy cannot admit two IDs for one event"
+    );
+    old.promoted_memory_ids.truncate(1);
+    old.work_units -= 1;
+    old.canonical_digest = old.recompute_canonical_digest().unwrap();
+    old.validate_contract().unwrap();
+    let bytes = serde_json::to_vec(&old).unwrap();
+    let restored: SleepWorkReceipt = serde_json::from_slice(&bytes).unwrap();
+    restored.validate_contract().unwrap();
+    assert_eq!(serde_json::to_vec(&restored).unwrap(), bytes);
+    assert_ne!(old.canonical_digest, receipt.canonical_digest);
+}
+
+#[test]
+fn meal_bounded_sleep_unsupplemented_path_preserves_legacy_bank_and_scoped_work() {
+    assert_positive_meal_control();
+    let mut old = Harness::new(8);
+    let mut meal = old.clone();
+    let (patch, frame) = fixture(
+        1,
+        Case {
+            receipts: 1,
+            ..Case::default()
+        },
+    )
+    .unwrap();
+    let old_write = old.memory.observe_sealed_patch(&patch).unwrap();
+    let meal_write = meal
+        .memory
+        .observe_sealed_patch_with_meal_v1(&patch, &frame)
+        .unwrap();
+    assert!(meal_write.supplemental.is_none());
+    let original_bytes = serde_json::to_vec(old.memory.bank()).unwrap();
+    assert_eq!(
+        serde_json::to_vec(meal.memory.bank()).unwrap(),
+        original_bytes
+    );
+    let (event, target) = meal_sleep_source(&patch);
+    let old_proof = SleepMemorySourceProofV1::capture(&patch, event, &target, old_write).unwrap();
+    let proof = MealMemorySleepProofV1::capture(&patch, event, &target, meal_write).unwrap();
+    let evidence = evidence(&[(event, target)]);
+    let old_receipt = old
+        .memory
+        .run_bounded_sleep_transaction_scoped_v1(
+            &consolidator(8),
+            &HomeostaticSnapshot::baseline(Tick::new(100)),
+            Tick::new(100),
+            &evidence,
+            &[old_proof],
+            &mut old.predictor,
+            &mut old.topology,
+        )
+        .unwrap()
+        .unwrap();
+    let meal_receipt = meal.run(&evidence, &[proof]).unwrap().unwrap();
+    assert_eq!(meal, old);
+    assert_eq!(
+        serde_json::to_vec(meal.memory.bank()).unwrap(),
+        original_bytes
+    );
+    assert_eq!(
+        meal_receipt.replay_event_count,
+        old_receipt.replay_event_count
+    );
+    assert_eq!(
+        meal_receipt.promoted_memory_ids,
+        old_receipt.promoted_memory_ids
+    );
+    assert_eq!(
+        meal_receipt.predictor_update_count,
+        old_receipt.predictor_update_count
+    );
+    assert_eq!(
+        meal_receipt.replay_eligibility_sample_count,
+        old_receipt.replay_eligibility_sample_count
+    );
+    assert_eq!(meal_receipt.concept, old_receipt.concept);
+    assert_eq!(meal_receipt.work_units, old_receipt.work_units);
+    assert_ne!(meal_receipt.replay_digest, old_receipt.replay_digest);
+}
