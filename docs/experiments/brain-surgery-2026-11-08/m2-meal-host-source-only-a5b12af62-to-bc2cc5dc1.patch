+//! Explicit multi-association sleep work for the fresh meal-memory host.
+//! No old receipt, resolver, or pressure-triggered entry point is reinterpreted.
+
+use super::*;
+use crate::memory::{sleep_meal_memory_replay_digest_v1, MealMemorySleepProofV1};
+
+pub const MEAL_SLEEP_WORK_RECEIPT_SCHEMA_V1: u16 = 1;
+
+/// One original event may name two retained associations. These are memory
+/// identities, not extra physical events, eligibility samples, or targets.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MealSleepWorkReceiptV1 {
+    pub schema_version: u16,
+    pub tick: Tick,
+    pub status: SleepWorkStatus,
+    pub fatigue: NormalizedScalar,
+    pub sleep_pressure: NormalizedScalar,
+    pub replay_digest: [u64; 4],
+    pub replay_event_count: u32,
+    pub replay_eligibility_sample_count: u32,
+    pub promoted_memory_ids: Vec<MemoryId>,
+    pub predictor_update_count: u32,
+    pub concept: Option<ConceptConsolidationReport>,
+    pub work_units: u64,
+    pub canonical_digest: [u64; 4],
+}
+
+impl MealSleepWorkReceiptV1 {
+    fn measured_work_units(&self) -> u64 {
+        let concept_work = self.concept.map_or(0, |concept| {
+            u64::from(concept.concepts_considered)
+                + u64::from(concept.simplexes_considered)
+                + u64::from(concept.preserved_gap_count)
+                + u64::from(concept.decayed_gap_count)
+        });
+        u64::from(self.replay_event_count)
+            .saturating_add(u64::from(self.replay_eligibility_sample_count))
+            .saturating_add(u64::try_from(self.promoted_memory_ids.len()).unwrap_or(u64::MAX))
+            .saturating_add(u64::from(self.predictor_update_count))
+            .saturating_add(concept_work)
+    }
+
+    pub fn recompute_canonical_digest(&self) -> Result<[u64; 4], ScaffoldContractError> {
+        let mut digest = CanonicalDigestBuilder::new(b"ALIFE-MEAL-SLEEP-WORK-RECEIPT-V1");
+        digest.write_u16(self.schema_version);
+        digest.write_u64(self.tick.raw());
+        digest.write_u8(self.status as u8);
+        digest.write_f32(self.fatigue.raw())?;
+        digest.write_f32(self.sleep_pressure.raw())?;
+        digest.write_sequence_len(self.replay_digest.len());
+        for word in self.replay_digest {
+            digest.write_u64(word);
+        }
+        digest.write_u32(self.replay_event_count);
+        digest.write_u32(self.replay_eligibility_sample_count);
+        digest.write_sequence_len(self.promoted_memory_ids.len());
+        for memory_id in &self.promoted_memory_ids {
+            digest.write_u64(memory_id.raw());
+        }
+        digest.write_u32(self.predictor_update_count);
+        if let Some(concept) = self.concept {
+            digest.write_u8(1);
+            digest.write_u32(concept.concepts_considered);
+            digest.write_u32(concept.simplexes_considered);
+            digest.write_u32(concept.preserved_gap_count);
+            digest.write_u32(concept.decayed_gap_count);
+            digest.write_u32(concept.curiosity_bias_count);
+        } else {
+            digest.write_u8(0);
+        }
+        digest.write_u64(self.work_units);
+        Ok(digest.finish256())
+    }
+}
+
+impl Validate for MealSleepWorkReceiptV1 {
+    fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        NormalizedScalar::new(self.fatigue.raw())?;
+        NormalizedScalar::new(self.sleep_pressure.raw())?;
+        let mut unique_ids = BTreeSet::new();
+        for memory_id in &self.promoted_memory_ids {
+            memory_id.validate()?;
+            if !unique_ids.insert(memory_id.raw()) {
+                return Err(ScaffoldContractError::ConsolidationGenerationMismatch);
+            }
+        }
+        if self.schema_version != MEAL_SLEEP_WORK_RECEIPT_SCHEMA_V1
+            || self.status != SleepWorkStatus::Consolidated
+            || self.replay_digest == [0; 4]
+            || self.replay_event_count == 0
+            || self.replay_event_count > MAX_SLEEP_TRANSACTION_EVENTS
+            || self.replay_eligibility_sample_count == 0
+            || self.replay_eligibility_sample_count > MAX_SLEEP_TRANSACTION_SAMPLES
+            || self.promoted_memory_ids.is_empty()
+            || self.promoted_memory_ids.len() as u64 > 2 * u64::from(self.replay_event_count)
+            || self.predictor_update_count != self.replay_event_count
+            || self.concept.is_none()
+            || self.work_units != self.measured_work_units()
+            || self.canonical_digest != self.recompute_canonical_digest()?
+        {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch);
+        }
+        Ok(())
+    }
+}
+
+impl SleepConsolidator {
+    /// Called only after the opt-in host admits a real sleep phase. A retained
+    /// association admits its original event exactly once; unavailable events
+    /// are authenticated and skipped. Nothing mutates until all work succeeds.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn run_bounded_transaction_with_meal_v1(
+        &self,
+        homeostasis: &HomeostaticSnapshot,
+        tick: Tick,
+        evidence: &SleepReplayEvidence,
+        proofs: &[MealMemorySleepProofV1],
+        memory: &mut MemoryBank,
+        predictor: &mut GroundedSuccessorPredictor,
+        topology: &mut TopologySidecar,
+    ) -> Result<Option<MealSleepWorkReceiptV1>, ScaffoldContractError> {
+        // Authenticates one proof per event/target, including unavailable ones;
+        // the bounded evidence contract rejects duplicate source sequences.
+        let replay_digest = sleep_meal_memory_replay_digest_v1(evidence, proofs)?;
+        homeostasis.validate_contract()?;
+        let sources = memory
+            .memory_ids_for_sleep_with_meal_v1(proofs, self.config.memory_max_records_after)?;
+        if sources.eligible_event_indices.is_empty() {
+            return Ok(None);
+        }
+
+        let mut next_predictor = predictor.clone();
+        let mut next_topology = topology.clone();
+        let mut predictor_update_count = 0_u32;
+        for &event_index in &sources.eligible_event_indices {
+            next_predictor.observe(&evidence.prediction_targets[event_index])?;
+            predictor_update_count = predictor_update_count.saturating_add(1);
+        }
+        let concept = self.consolidate_topology_sidecar(&mut next_topology, 1)?;
+        let replay_event_count = u32::try_from(sources.eligible_event_indices.len())
+            .map_err(|_| ScaffoldContractError::ScalarOutOfRange)?;
+        let replay_eligibility_sample_count = u32::try_from(
+            evidence
+                .batch
+                .eligibility_samples
+                .iter()
+                .filter(|sample| {
+                    sources
+                        .eligible_event_indices
+                        .contains(&usize::from(sample.event_index))
+                })
+                .count(),
+        )
+        .map_err(|_| ScaffoldContractError::ScalarOutOfRange)?;
+        let mut receipt = MealSleepWorkReceiptV1 {
+            schema_version: MEAL_SLEEP_WORK_RECEIPT_SCHEMA_V1,
+            tick,
+            status: SleepWorkStatus::Consolidated,
+            fatigue: NormalizedScalar::new(homeostasis.drives.fatigue)?,
+            sleep_pressure: NormalizedScalar::new(homeostasis.hormones.sleep_pressure)?,
+            replay_digest,
+            replay_event_count,
+            replay_eligibility_sample_count,
+            promoted_memory_ids: sources.promoted_memory_ids,
+            predictor_update_count,
+            concept: Some(concept),
+            work_units: 0,
+            canonical_digest: [0; 4],
+        };
+        // Preserve the established measured-work formula. Association IDs cost
+        // their own units; cloning/hashing adds no invented biological debit.
+        receipt.work_units = receipt.measured_work_units();
+        receipt.canonical_digest = receipt.recompute_canonical_digest()?;
+        receipt.validate_contract()?;
+
+        // Candidate banks are already bounded by their waking writer. Sleep
+        // only names retained IDs, so bank and sidecar metadata stay untouched.
+        *predictor = next_predictor;
+        *topology = next_topology;
+        Ok(Some(receipt))
+    }
+}
