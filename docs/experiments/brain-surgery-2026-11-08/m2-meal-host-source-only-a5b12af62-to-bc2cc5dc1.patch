+    state.first_moment[0] = 0.03125;
+    state.second_moment[0] = 0.0625;
+    trainer = CpuFoundationTrainer::from_checkpoint(recipe.phenotype, recipe.asset, state).unwrap();
+    let mut game =
+        create_grounded_drive_research_new_game(&recipe.config, &recipe.genotype).unwrap();
+    let newborn = game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .unwrap()
+        .clone();
+    let mut builder =
+        HeadlessScenarioBuilder::new(SEED).agent("learner", newborn.organism_id(), Vec3f::ZERO);
+    if food {
+        builder = builder.food("meal-control", Vec3f::new(0.1, 0.0, 0.0), 0.6);
+    }
+    let mut world = builder.build().unwrap();
+    world
+        .register_grounded_drive_research_record(newborn)
+        .unwrap();
+    game.world = world;
+    (game, trainer, recipe.inputs)
+}
+fn mature(world: &mut HeadlessWorld) -> Result<(), String> {
+    for _ in 0..240 {
+        world.try_advance_tick().map_err(|e| e.to_string())?;
+    }
+    Ok(())
+}
+fn fixture(food: bool) -> (CpuGroupedMealM2HostV1, PhenotypeCompilerInputs) {
+    let (game, trainer, inputs) = setup(food);
+    let (host, ()) = CpuGroupedMealM2HostV1::new_prepared(
+        game,
+        trainer,
+        inputs.clone(),
+        (SEED ^ (SEED >> 32)) as u32,
+        MediationModeV1::Full,
+        mature,
+    )
+    .unwrap();
+    (host, inputs)
