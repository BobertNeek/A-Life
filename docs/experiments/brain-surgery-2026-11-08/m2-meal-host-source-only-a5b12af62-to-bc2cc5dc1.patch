+#[test]
+fn meal_bounded_sleep_never_reinterprets_legacy_fast_or_lifetime_memory() {
+    let (h, evidence, proof) = retained_case(8);
+    let (patch, _) = fixture(1, Case::default()).unwrap();
+    let mut fast = bank(8);
+    fast.insert_from_patch(&patch).unwrap();
+    let mut lifetime = fast.clone();
+    lifetime
+        .promote_fast_memory_to_lifetime(&[patch.header().sequence_id], 8)
+        .unwrap();
+    for mut memory in [fast, lifetime] {
+        let before = memory.clone();
+        let bytes_before = serde_json::to_vec(&memory).unwrap();
+        let mut predictor = h.predictor.clone();
+        let mut topology = h.topology.clone();
+        assert!(matches!(
+            consolidator(8).run_bounded_transaction_with_meal_v1(
+                &HomeostaticSnapshot::baseline(Tick::new(100)),
+                Tick::new(100),
+                &evidence,
+                std::slice::from_ref(&proof),
+                &mut memory,
+                &mut predictor,
+                &mut topology,
+            ),
+            Err(ScaffoldContractError::MemoryModeConflict)
+        ));
+        assert_eq!(memory, before);
+        assert_eq!(serde_json::to_vec(&memory).unwrap(), bytes_before);
+        assert_eq!(predictor, h.predictor);
+        assert_eq!(topology, h.topology);
+    }
+}
