new file mode 100644
index 000000000..e1723dc74
--- /dev/null
+++ b/crates/alife_training/src/cpu/grouped_meal_host_envelope.rs
@@ -0,0 +1,221 @@
+//! Fresh, explicitly opt-in grouped meal-memory envelope. Old envelopes remain exact.
+//! Synapses stay closed. Waking association writes are unpriced like the baseline;
+//! actual later retrieval and unique sleep-association work use existing counters.
+use super::*;
+use serde::{Deserialize, Serialize};
+
+const MAGIC: &[u8] = b"ALIFE-GROUPED-MEAL-M2-HOST\0V1\0SYNAPTIC-CLOSED\0PROFILE5\0";
+const LINEAGE: &str = "fresh-grouped-meal-m2-host-v1/closed-source/no-historical-import";
+const POLICY: &str = "m2-exact-consumed-joint-association-v1;meal-aware-recall-and-familiarity-v1;one-source-event;two-associations-max;typed-meal-sleep-v1;waking-association-writes-unpriced-as-baseline;actual-retrieval-and-sleep-work;no-clone-hash-price;one-cognitive-debit;synaptic-learning-closed";
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct MealResidentV1 {
+    pub(super) proofs: Vec<MealMemorySleepProofV1>,
+}
+impl MealResidentV1 {
+    pub(super) fn validate(&self, resident: &Resident) -> Result<(), CpuHostError> {
+        let base = resident
+            .grouped
+            .as_ref()
+            .ok_or(CpuHostError::State("missing meal grouped owner"))?;
+        if self.proofs.len() != resident.replay.len()
+            || self.proofs.len() != base.memory_proofs.len()
+        {
+            return Err(CpuHostError::State("meal replay proof count mismatch"));
+        }
+        let mut sequences = std::collections::BTreeSet::new();
+        for ((proof, original), event) in self
+            .proofs
+            .iter()
+            .zip(&base.memory_proofs)
+            .zip(&resident.replay)
+        {
+            proof.validate_against(&event.event, &event.target)?;
+            if proof.representative_source() != original
+                || !sequences.insert(event.event.sequence_id.raw())
+            {
+                return Err(CpuHostError::State(
+                    "meal representative or source sequence mismatch",
+                ));
+            }
+            // Audit all retained/unavailable associations, not only a representative.
+            proof.resolve_associations(resident.memory.bank())?;
+        }
+        Ok(())
+    }
+}
+pub(super) fn validate_meal_states(
+    host: &CpuCanonicalHost,
+    states: &BTreeMap<u64, MealResidentV1>,
+) -> Result<(), CpuHostError> {
+    if states.len() != host.residents.len() {
+        return Err(CpuHostError::State("meal owner count mismatch"));
+    }
+    for (&id, resident) in &host.residents {
+        states
+            .get(&id)
+            .ok_or(CpuHostError::State("missing meal owner"))?
+            .validate(resident)?;
+    }
+    Ok(())
+}
+
+/// The inner host is private and cannot be exported as an old checkpoint by this
+/// API. Its existing exact envelope is carried as UTF-8, preserving literal IEEE
+/// sampler bits and all acquired state without a positional-format migration.
+pub struct CpuGroupedMealM2HostV1 {
+    pub(super) inner: CpuGroupedM2HostV1,
+    pub(super) meals: BTreeMap<u64, MealResidentV1>,
+}
+#[derive(Debug, Clone)]
+pub struct CpuGroupedMealM2HostCheckpointV1 {
+    payload: MealPayloadV1,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct MealPayloadV1 {
+    schema_version: u16,
+    source_lineage: String,
+    policy: String,
+    closed_canonical_envelope_utf8: String,
+    meal_sources: BTreeMap<u64, MealResidentV1>,
+}
+impl CpuGroupedMealM2HostCheckpointV1 {
+    pub fn encode(&self) -> Result<Vec<u8>, CpuHostError> {
+        let mut bytes = MAGIC.to_vec();
+        bytes.extend(serde_json::to_vec(&self.payload)?);
+        Ok(bytes)
+    }
+    pub fn decode(bytes: &[u8]) -> Result<Self, CpuHostError> {
+        // Identity is checked before decoding any old nested source/world types.
+        let body = bytes
+            .strip_prefix(MAGIC)
+            .ok_or(CpuHostError::State("not a fresh grouped meal envelope"))?;
+        let metadata: serde_json::Value = serde_json::from_slice(body)?;
+        if metadata["schema_version"] != 1
+            || metadata["source_lineage"] != LINEAGE
+            || metadata["policy"] != POLICY
+        {
+            return Err(CpuHostError::State(
+                "meal envelope policy or lineage mismatch",
+            ));
+        }
+        let payload: MealPayloadV1 = serde_json::from_slice(body)?;
+        if serde_json::from_slice::<serde_json::Value>(&serde_json::to_vec(&payload)?)? != metadata
+        {
+            return Err(CpuHostError::State(
+                "meal envelope omitted or unknown nested field",
+            ));
+        }
+        let closed = CpuGroupedM2HostCheckpointV1::decode(
+            payload.closed_canonical_envelope_utf8.as_bytes(),
+        )?;
+        if closed.encode()? != payload.closed_canonical_envelope_utf8.as_bytes() {
+            return Err(CpuHostError::State(
+                "meal inner envelope changed acquired bytes",
+            ));
+        }
+        Ok(Self { payload })
+    }
+}
+pub struct CpuGroupedMealM2HostStepV1 {
+    pub base: CpuGroupedM2HostStepV1,
+    /// One typed transaction per real decision, including withheld/ignored meal writes.
+    pub meal_transactions: Vec<(OrganismId, MealMemoryTransactionReceiptV1)>,
+}
+impl CpuGroupedMealM2HostV1 {
+    pub fn new_prepared<T, E: std::fmt::Display>(
+        game: CanonicalNewGame,
+        founder: CpuFoundationTrainer,
+        source_inputs: PhenotypeCompilerInputs,
+        sampling_seed: u32,
+        mode: MediationModeV1,
+        prepare: impl FnOnce(&mut HeadlessWorld) -> Result<T, E>,
+    ) -> Result<(Self, T), CpuHostError> {
+        // This constructor alone admits fresh bodies. There is intentionally no
+        // conversion from an acquired old/grouped/decoder host or checkpoint.
+        let (inner, result) = CpuGroupedM2HostV1::new_prepared(
+            game,
+            founder,
+            source_inputs,
+            sampling_seed,
+            mode,
+            prepare,
+        )?;
+        let meals = inner
+            .host
+            .residents
+            .keys()
+            .map(|&id| (id, MealResidentV1::default()))
+            .collect();
+        validate_meal_states(&inner.host, &meals)?;
+        Ok((Self { inner, meals }, result))
+    }
+    pub fn world(&self) -> &HeadlessWorld {
+        self.inner.world()
+    }
+    pub fn sleep_state(&self, organism: OrganismId) -> Option<alife_core::sleep::SleepState> {
+        self.inner.sleep_state(organism)
+    }
+    pub fn checkpoint(&self) -> Result<CpuGroupedMealM2HostCheckpointV1, CpuHostError> {
+        validate_meal_states(&self.inner.host, &self.meals)?;
+        Ok(CpuGroupedMealM2HostCheckpointV1 {
+            payload: MealPayloadV1 {
+                schema_version: 1,
+                source_lineage: LINEAGE.into(),
+                policy: POLICY.into(),
+                closed_canonical_envelope_utf8: String::from_utf8(
+                    self.inner.checkpoint()?.encode()?,
+                )
+                .map_err(|_| CpuHostError::State("non-UTF8 closed envelope"))?,
+                meal_sources: self.meals.clone(),
+            },
+        })
+    }
+    pub fn restore(
+        checkpoint: CpuGroupedMealM2HostCheckpointV1,
+        expected_source: &PhenotypeCompilerInputs,
+        expected_mode: MediationModeV1,
+    ) -> Result<Self, CpuHostError> {
+        let wire = checkpoint.encode()?;
+        let checkpoint = CpuGroupedMealM2HostCheckpointV1::decode(&wire)?;
+        let payload = checkpoint.payload;
+        let inner = CpuGroupedM2HostV1::restore(
+            CpuGroupedM2HostCheckpointV1::decode(
+                payload.closed_canonical_envelope_utf8.as_bytes(),
+            )?,
+            expected_source,
+            expected_mode,
+        )?;
+        let result = Self {
+            inner,
+            meals: payload.meal_sources,
+        };
+        validate_meal_states(&result.inner.host, &result.meals)?;
+        if result.checkpoint()?.encode()? != wire {
+            return Err(CpuHostError::State(
+                "meal restore would rewrite acquired state",
+            ));
+        }
+        Ok(result)
+    }
+    pub fn step(&mut self, temperature: f32) -> Result<CpuGroupedMealM2HostStepV1, CpuHostError> {
+        self.inner
+            .host
+            .grouped_meal_step(&self.inner.founder, temperature, &mut self.meals)
+    }
+    pub fn actor_optimization(&mut self) -> Result<(), CpuHostError> {
+        self.inner.actor_optimization()
+    }
+    pub fn waking_synaptic_plasticity(&mut self) -> Result<(), CpuHostError> {
+        self.inner.waking_synaptic_plasticity()
+    }
+    pub fn synaptic_sleep_consolidation(&mut self) -> Result<(), CpuHostError> {
+        self.inner.synaptic_sleep_consolidation()
+    }
+}
+
+#[cfg(test)]
+#[path = "grouped_meal_host_tests.rs"]
+mod tests;
diff --git a/crates/alife_training/src/cpu/grouped_meal_host_loop.rs b/crates/alife_training/src/cpu/grouped_meal_host_loop.rs
new file mode 100644
index 000000000..99d404dcd
--- /dev/null
+++ b/crates/alife_training/src/cpu/grouped_meal_host_loop.rs
@@ -0,0 +1,911 @@
+//! Separate opt-in meal-memory loop. Legacy closed grouped bodies remain literal.
+//! No new synaptic update, biological debit, or waking write price is introduced.
+use super::grouped_meal_host_envelope::{validate_meal_states, MealResidentV1};
+use super::*;
+impl CpuCanonicalHost {
+    pub(super) fn grouped_meal_step(
+        &mut self,
+        founder: &CpuFoundationTrainer,
+        temperature: f32,
+        meals: &mut BTreeMap<u64, MealResidentV1>,
+    ) -> Result<CpuGroupedMealM2HostStepV1, CpuHostError> {
+        self.validate_founder(founder)?;
+        validate_meal_states(self, meals)?;
+        for (&id, r) in &self.residents {
+            super::grouped_host_envelope::validate_grouped_sleep_boundary(r)?;
+            if r.grouped.is_none() || r.motor.is_some() || r.sleep_choice.is_some() {
+                return Err(CpuHostError::State("not a grouped M2 resident"));
+            }
+            let record = self
+                .world
+                .organism_registry()
+                .get(OrganismId(id))
+                .ok_or(CpuHostError::State("missing grouped canonical organism"))?;
+            validate_resident_authority(record, r, self.sampling_seed, self.sampling_counter)?;
+        }
+        let mut next = self.clone();
+        let mut next_meals = meals.clone();
+        for r in next.residents.values_mut() {
+            r.sealed_authority = None;
+        }
+        let result = next.grouped_meal_step_inner(
+            founder,
+            temperature,
+            &mut |draft, _| Ok(draft),
+            &mut next_meals,
+            #[cfg(test)]
+            None,
+        )?;
+        validate_meal_states(&next, &next_meals)?;
+        *self = next;
+        *meals = next_meals;
+        Ok(result)
+    }
+    pub(super) fn grouped_meal_step_inner(
+        &mut self,
+        founder: &CpuFoundationTrainer,
+        temperature: f32,
+        prepare: &mut impl FnMut(
+            PerceptionFrameDraft,
+            ExperienceSequenceId,
+        ) -> Result<PerceptionFrameDraft, ScaffoldContractError>,
+        meals: &mut BTreeMap<u64, MealResidentV1>,
+        #[cfg(test)] mut scripted: Option<
+            &mut dyn FnMut(
+                &PerceptionFrame,
+                &RecoveryGroupScoresV2,
+                RecoveryGroupJointActionV2,
+            ) -> Result<RecoveryGroupJointActionV2, CpuHostError>,
+        >,
+    ) -> Result<CpuGroupedMealM2HostStepV1, CpuHostError> {
+        let p = founder.phenotype();
+        let tick = self.world.tick();
+        let mut decisions = Vec::new();
+        let mut meal_transactions = Vec::new();
+        let mut sleeping = 0;
+        let mut consolidations = 0;
+        let mut body_events = BTreeMap::new();
+        let mut perception_world = self.world.clone();
+        let ids = self
+            .world
+            .organism_registry()
+            .iter()
+            .filter(|r| r.lifecycle().is_alive())
+            .map(|r| r.organism_id())
+            .collect::<Vec<_>>();
+        for id in ids {
+            let mut record = self
+                .world
+                .organism_registry()
+                .get(id)
+                .cloned()
+                .ok_or(CpuHostError::State("missing organism"))?;
+            let r = self
+                .residents
+                .get_mut(&id.raw())
+                .ok_or(CpuHostError::State("new organism requires brain admission"))?;
+            let phase_before = r.sleep.state().phase;
+            if r.activity
+                .last_world_tick
+                .is_some_and(|last| last.checked_add(1) != Some(tick.raw()))
+            {
+                return Err(CpuHostError::State("CPU activity world clock mismatch"));
+            }
+            r.activity.last_world_tick = Some(tick.raw());
+            r.activity.remaining_atp_q16 =
+                (f64::from(record.biochemistry().homeostasis.drives.brain_atp)
+                    * f64::from(BRAIN_ATP_Q16_MAX))
+                .floor() as u32;
+            let neural_boundary = r.neural.checkpoint()?;
+            let activity_anchor = CpuActivityAnchor {
+                organism_id: id,
+                tick,
+                sequence_cursor: r.next_sequence,
+                previous_dispatch_generation: neural_boundary.dispatch_generation,
+                source_frame_digest: r.activity.source_frame_digest,
+                frame_digest: p.phenotype_hash().0,
+            };
+            let capacity = host_capacity(p)?;
+            let lookahead = cpu_activity_budget(
+                p,
+                activity_anchor,
+                record.biochemistry().homeostasis.drives.brain_atp,
+                u32::from(capacity.execution().max_candidates()),
+                u32::from(capacity.execution().max_memory_context_records()),
+            )?;
+            // Source and appendage share one admission. A resource-limited
+            // living body takes the existing recovery fallback, not a repeated
+            // rollback stall and not a forged voluntary BodySleep receipt.
+            let (_, _, grouped_affordable) = GroupedMotorStateV1::work(
+                p,
+                &lookahead.work,
+                grouped_meal_dynamic_work(p, r, &lookahead)?,
+                lookahead.available_atp_q16,
+            )?;
+            if phase_before == SleepPhase::Awake && !grouped_affordable {
+                r.sleep
+                    .force_sleep(tick, alife_core::SleepTrigger::RecoveryProtocol)?;
+            }
+
+            let config = sleep_consolidation_config_for(p)?;
+            if phase_before == SleepPhase::Awake {
+                {
+                    r.sleep.evaluate_emergency_only(
+                        &record.biochemistry().homeostasis,
+                        HomeostaticParameters::reference(),
+                        tick,
+                    )?;
+                }
+            } else if phase_before != SleepPhase::Waking
+                || (record.biochemistry().homeostasis.drives.fatigue
+                    < config.fatigue_threshold.raw()
+                    && record.biochemistry().homeostasis.hormones.sleep_pressure
+                        < config.sleep_pressure_threshold.raw())
+            {
+                r.sleep.advance(tick)?;
+            }
+            let mut sleep_work_units = 0;
+            if r.sleep.state().phase == SleepPhase::Consolidating
+                && matches!(r.sleep.state().consolidation, ConsolidationState::None)
+            {
+                let evidence = replay_evidence(p, &r.replay)?;
+                if !evidence.batch.events.is_empty() {
+                    // Same scheduled-work pressure projection used by the native
+                    // scheduler; this is work admission, never reward/chemistry.
+                    let mut due_homeostasis = record.biochemistry().homeostasis;
+                    due_homeostasis.drives.fatigue = due_homeostasis
+                        .drives
+                        .fatigue
+                        .max(config.fatigue_threshold.raw());
+                    due_homeostasis.hormones.sleep_pressure = due_homeostasis
+                        .hormones
+                        .sleep_pressure
+                        .max(config.sleep_pressure_threshold.raw());
+                    let work = {
+                        let state = r
+                            .grouped
+                            .as_ref()
+                            .ok_or(CpuHostError::State("missing grouped replay owner"))?;
+                        state.validate_replay(&r.replay)?;
+                        let meal = meals
+                            .get(&id.raw())
+                            .ok_or(CpuHostError::State("missing meal sleep owner"))?;
+                        meal.validate(r)?;
+                        r.memory.run_bounded_sleep_transaction_with_meal_v1(
+                            &SleepConsolidator::new(config)?,
+                            &due_homeostasis,
+                            tick,
+                            &evidence,
+                            &meal.proofs,
+                            &mut r.predictor,
+                            &mut r.topology,
+                        )?
+                    };
+                    if let Some(work) = work {
+                        sleep_work_units = work.work_units;
+                        let receipt = CognitiveWorkCounters::new(
+                            0,
+                            0,
+                            0,
+                            0,
+                            0,
+                            0,
+                            0,
+                            u64::from(work.predictor_update_count),
+                            u64::from(work.replay_event_count)
+                                + u64::from(work.replay_eligibility_sample_count),
+                            0,
+                            0,
+                            work.work_units,
+                        )?
+                        .into_receipt()?;
+                        record.account_cognitive_work(
+                            receipt,
+                            CognitiveWorkCostPolicy::enabled(1.0e-6)?,
+                        )?;
+                    }
+                }
+                meals
+                    .get_mut(&id.raw())
+                    .ok_or(CpuHostError::State("missing meal owner"))?
+                    .proofs
+                    .clear();
+                r.replay.clear();
+                if let Some(state) = &mut r.grouped {
+                    state.memory_proofs.clear();
+                }
+                // Closed synapses have no new weight generation. The committed
+                // output here is the actual memory/predictor/topology cycle,
+                // with the frozen source included, under a distinct identity.
+                let digest = super::grouped_host_envelope::grouped_sleep_output_digest(r)?;
+                let mut state = r.sleep.state();
+                state.consolidation = ConsolidationState::Committed {
+                    cycle_id: state.active_cycle_id,
+                    output_generation: state.active_cycle_id,
+                    output_digest: digest,
+                };
+                r.sleep = SleepController::restore(config, state)?;
+                consolidations += 1;
+            }
+            let state = r.sleep.state();
+            record.seal_sleep_phase(
+                state.phase,
+                state.active_cycle_id.max(state.last_consolidated_cycle_id),
+                tick,
+                sleep_work_units,
+            )?;
+            self.world.replace_organism_record_exact(record.clone())?;
+            if phase_before != SleepPhase::Awake {
+                body_events.insert(
+                    id.raw(),
+                    BodyEventDelta {
+                        sleep_recovery: 1.,
+                        ..BodyEventDelta::zero()
+                    },
+                );
+            }
+            if phase_before != SleepPhase::Awake || state.phase != SleepPhase::Awake {
+                sleeping += 1;
+                continue;
+            }
+            let sequence = ExperienceSequenceId(r.next_sequence);
+            let receptors = record
+                .biochemistry()
+                .neural_receptor_frame(record.phenotype())?;
+            let effects = NeuralReceptorEffects::from_frame(
+                &receptors,
+                &NeuralReceptorPhenotype::compile(p)?,
+            )?;
+            let (draft, candidate_binding) = {
+                let admission =
+                    alife_world::SleepChoiceWorldAdmissionV1::for_organism(&perception_world, id)?;
+                perception_world.perception_sleep_choice_draft_with_bindings(
+                    &admission,
+                    tick,
+                    record.biochemistry().homeostasis,
+                )?
+            };
+            let ordinary = draft.clone().with_semantic_context(None)?;
+            let draft = prepare(draft, sequence)?;
+            if draft.clone().with_semantic_context(None)? != ordinary {
+                return Err(CpuHostError::State(
+                    "semantic preparation changed ordinary perception",
+                ));
+            }
+            let preparation = prepare_canonical_frame_with_meal_v1(
+                &CanonicalPreparationInput {
+                    draft,
+                    candidate_binding,
+                    sequence_id: sequence,
+                    homeostasis: record.biochemistry().homeostasis,
+                    hysteresis: r.hysteresis,
+                    policy: attention_selection_policy_for(p),
+                    neural_receptors: receptors.clone(),
+                    receptor_effects: effects,
+                },
+                &r.memory,
+                &r.topology,
+                &r.predictor,
+                false,
+            );
+            let prepared = preparation.result?;
+            if let Some(h) = preparation.hysteresis {
+                r.hysteresis = h;
+            }
+            let frame = prepared.frame;
+            let recall = prepared.memory_recall;
+            let mut activity = cpu_activity_budget(
+                p,
+                CpuActivityAnchor {
+                    frame_digest: frame.frame_digest().0,
+                    ..activity_anchor
+                },
+                record.biochemistry().homeostasis.drives.brain_atp,
+                frame.candidates().len() as u32,
+                recall.context().candidates.len() as u32,
+            )?;
