+fn bytes<T: Serialize>(value: &T) -> Vec<u8> {
+    serde_json::to_vec(value).unwrap()
+}
+fn frozen(host: &CpuGroupedMealM2HostV1) -> Vec<u8> {
+    let r = host.inner.host.residents.values().next().unwrap();
+    let n = r.neural.checkpoint().unwrap();
+    bytes(&(
+        host.inner.founder.checkpoint(),
+        n.fast,
+        n.lifetime,
+        n.eligibility,
+        n.weight_generation,
+        n.neural.dendrites,
+        r.v11.checkpoint(),
+    ))
+}
+fn retained(kind: MemoryUpdateKind) -> Option<MemoryId> {
+    match kind {
+        MemoryUpdateKind::Inserted { inserted } | MemoryUpdateKind::Evicted { inserted, .. } => {
+            Some(inserted)
+        }
+        MemoryUpdateKind::Merged { into } => Some(into),
+        _ => None,
+    }
+}
+fn consumed(decision: &CpuGroupedM2HostDecisionV1) -> usize {
+    decision
+        .patch
+        .outcome()
+        .joint
+        .as_ref()
+        .unwrap()
+        .channel_outcomes
+        .iter()
+        .filter(|r| {
+            r.channel == MotorChannel::Manipulation
+                && r.physical.contact == PhysicalContactKind::Consumed
+        })
+        .count()
+}
