+        b.candidate_store.records[&expected[1].unwrap().raw()].source_sequence_id,
+        ExperienceSequenceId(1)
+    );
+    // Legacy resolution intentionally retains its old sibling-shadowing error.
+    assert!(proof.representative_source().resolve(&b).is_err());
+    assert_eq!(proof.resolve_associations(&b).unwrap(), expected);
+    let cold: MemoryBank = serde_json::from_slice(&serde_json::to_vec(&b).unwrap()).unwrap();
+    assert_eq!(proof.resolve_associations(&cold).unwrap(), expected);
+}
