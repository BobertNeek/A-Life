+#[test]
+fn meal_bounded_sleep_cold_state_proofs_and_receipts_preserve_bytes_and_outcome() {
+    let (mut warm, evidence, proof) = retained_case(8);
+    warm.predictor
+        .observe(&evidence.prediction_targets[0])
+        .unwrap();
+    let (patch, _) = fixture(1, Case::default()).unwrap();
+    warm.topology.observe_sealed_patch(&patch);
+    warm.topology.validate_contract().unwrap();
+    let active_before = warm.memory.export_active_bank().unwrap();
+    let checkpoint_before = *warm.memory.compaction_checkpoint();
+    let mut cold = Harness {
+        memory: MemorySidecarState::restore_portable(
+            identity(),
+            checkpoint_before,
+            active_before.clone(),
+            None,
+        )
+        .unwrap(),
+        predictor: serde_json::from_slice(&serde_json::to_vec(&warm.predictor).unwrap()).unwrap(),
+        topology: serde_json::from_slice(&serde_json::to_vec(&warm.topology).unwrap()).unwrap(),
+    };
+    let proof_bytes = serde_json::to_vec(&proof).unwrap();
+    let cold_proof: MealMemorySleepProofV1 = serde_json::from_slice(&proof_bytes).unwrap();
+    assert_eq!(serde_json::to_vec(&cold_proof).unwrap(), proof_bytes);
+    let cold_evidence = serde_json::from_slice(&serde_json::to_vec(&evidence).unwrap()).unwrap();
+    let expected = warm.run(&evidence, &[proof]).unwrap().unwrap();
+    let result = cold.run(&cold_evidence, &[cold_proof]).unwrap().unwrap();
+    assert_eq!(result, expected);
+    assert_eq!(cold, warm);
+    assert_eq!(cold.memory.export_active_bank().unwrap(), active_before);
+    assert_eq!(*cold.memory.compaction_checkpoint(), checkpoint_before);
+    let bytes = serde_json::to_vec(&result).unwrap();
+    let restored: MealSleepWorkReceiptV1 = serde_json::from_slice(&bytes).unwrap();
+    restored.validate_contract().unwrap();
