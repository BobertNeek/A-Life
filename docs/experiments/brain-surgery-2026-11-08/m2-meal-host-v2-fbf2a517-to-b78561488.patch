+/// Versioned two-association provenance for one original replay event. The meal
+/// never acquires a synthetic replay event, predictor target, or synaptic update.
+/// Kept outside all legacy host/checkpoint structs until a fresh host is admitted.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MealMemorySleepProofV1 {
+    transaction: MealMemoryTransactionReceiptV1,
+    representative: SleepMemorySourceProofV1,
+    canonical_digest: [u64; 4],
+}
+
+impl MealMemorySleepProofV1 {
+    pub fn capture(
+        patch: &ExperiencePatch,
+        event: SleepReplayEvent,
+        target: &PredictionTargetReceipt,
+        transaction: MealMemoryTransactionReceiptV1,
+    ) -> Result<Self, ScaffoldContractError> {
+        transaction.validate_against_patch(patch)?;
+        let representative = SleepMemorySourceProofV1::capture(
+            patch,
+            event,
+            target,
+            transaction.representative_projection()?,
+        )?;
+        let mut proof = Self {
+            transaction,
+            representative,
+            canonical_digest: [0; 4],
+        };
+        proof.canonical_digest = proof.recompute_digest()?;
+        proof.validate_against(&event, target)?;
+        Ok(proof)
+    }
+
+    pub fn transaction(&self) -> &MealMemoryTransactionReceiptV1 {
+        &self.transaction
+    }
+    pub fn representative_source(&self) -> &SleepMemorySourceProofV1 {
+        &self.representative
+    }
+    pub fn canonical_digest(&self) -> [u64; 4] {
+        self.canonical_digest
+    }
+
+    pub fn validate_against(
+        &self,
+        event: &SleepReplayEvent,
+        target: &PredictionTargetReceipt,
+    ) -> Result<(), ScaffoldContractError> {
+        self.transaction.validate_contract()?;
+        self.representative.validate_against(event, target)?;
+        if self.representative.write != self.transaction.representative_projection()?
+            || self.representative.key != self.transaction.representative_key
+            || self.canonical_digest != self.recompute_digest()?
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(())
+    }
+
+    /// Audit retained association IDs without expanding the replay event list.
+    /// Interior merged observations remain unavailable, not inferred lineage.
+    pub fn resolve_associations(
+        &self,
+        bank: &MemoryBank,
+    ) -> Result<[Option<MemoryId>; 2], ScaffoldContractError> {
+        self.transaction.validate_contract()?;
+        if self.canonical_digest != self.recompute_digest()?
+            || self.representative.canonical_digest != self.representative.recompute_digest()?
+            || self.representative.write != self.transaction.representative_projection()?
+            || self.representative.key != self.transaction.representative_key
+            || self.transaction.output_generation > bank.candidate_store.generation
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        if self.transaction.output_generation == bank.candidate_store.generation
+            && self.transaction.after_digest != bank.candidate_store.digest(bank.config.capacity)?
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        let representative = self.representative.resolve_for_meal_v1(bank)?;
+        let Some(write) = &self.transaction.supplemental else {
+            return Ok([representative, None]);
+        };
+        let Some(id) = super::supplemental_meal::retained_id(write.kind) else {
+            return Ok([representative, None]);
+        };
+        let Some(record) = bank.candidate_store.records.get(&id.raw()) else {
+            return Ok([representative, None]);
+        };
+        record.validate_contract()?;
+        let query = &write.proof.query;
+        let (_, family) = keys_for_query(query);
+        if record.family_key().receipt() != family.receipt()
+            || record.profile() != query.profile()
+            || record.organism_id_raw != query.organism_id().raw()
+            || record.outcome_contact != Some(PhysicalContactKind::Consumed)
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        if record.action_id_raw != query.action_id().raw()
+            || record.action_kind_raw != query.action_kind().raw()
+        {
+            return Ok([representative, None]);
+        }
+        let current = record.source_sequence_id == self.transaction.sealed_sequence_id
+            && record.last_tick == query.tick();
+        let retained_first = record.source_sequence_id.raw()
+            > self.transaction.sealed_sequence_id.raw()
+            && record.first_tick == query.tick()
+            && matches!(
+                write.kind,
+                MemoryUpdateKind::Inserted { .. } | MemoryUpdateKind::Evicted { .. }
+            );
+        Ok([representative, (current || retained_first).then_some(id)])
+    }
+
+    fn recompute_digest(&self) -> Result<[u64; 4], ScaffoldContractError> {
+        let mut d = CanonicalDigestBuilder::new(b"ALIFE-MEAL-MEMORY-SLEEP-PROOF-V1");
+        d.write_u16(self.transaction.schema_version);
+        for word in self.representative.canonical_digest() {
+            d.write_u64(word);
+        }
+        if let Some(write) = &self.transaction.supplemental {
+            d.write_some();
+            let p = &write.proof;
+            d.write_u16(p.schema_version);
+            d.write_u64(p.sealed_sequence_id.raw());
+            for word in p.query.canonical_digest() {
+                d.write_u64(word);
+            }
+            d.write_u16(p.channel.canonical_key());
+            d.write_u64(p.target_entity.raw());
+            d.write_u64(p.dispatch_generation);
+            for word in p.phenotype_hash.0 {
+                d.write_u64(word);
+            }
+            for word in p
+                .frame_digest
+                .0
+                .into_iter()
+                .chain(p.bundle_digest)
+                .chain(p.patch_causal_digest)
+            {
+                d.write_u64(word);
+            }
+            // V1 admits only Consumed. Reject unknown/new phases in validation.
+            d.write_u8(match p.physical_contact {
+                PhysicalContactKind::None => 0,
+                PhysicalContactKind::Touch => 1,
+                PhysicalContactKind::Collision => 2,
+                PhysicalContactKind::Blocked => 3,
+                PhysicalContactKind::Consumed => 4,
+                PhysicalContactKind::Moved => 5,
+            });
+            match write.kind {
+                MemoryUpdateKind::IgnoredLowInformation => d.write_u8(0),
+                MemoryUpdateKind::IgnoredLowerRetention => d.write_u8(1),
+                MemoryUpdateKind::Inserted { inserted } => {
+                    d.write_u8(2);
+                    d.write_u64(inserted.raw());
+                }
+                MemoryUpdateKind::Merged { into } => {
+                    d.write_u8(3);
+                    d.write_u64(into.raw());
+                }
+                MemoryUpdateKind::Evicted { removed, inserted } => {
+                    d.write_u8(4);
+                    d.write_u64(removed.raw());
+                    d.write_u64(inserted.raw());
+                }
+            }
+        } else {
+            d.write_none();
+        }
+        Ok(d.finish256())
+    }
+}
+
+/// Binds exactly one multi-association proof to each original replay event.
+pub fn sleep_meal_memory_replay_digest_v1(
+    evidence: &crate::sleep::SleepReplayEvidence,
+    proofs: &[MealMemorySleepProofV1],
+) -> Result<[u64; 4], ScaffoldContractError> {
+    evidence.validate_contract()?;
+    if proofs.len() != evidence.batch.events.len() {
+        return Err(ScaffoldContractError::InvalidDecisionEvidence);
+    }
+    let mut d = CanonicalDigestBuilder::new(b"ALIFE-SLEEP-MEAL-MEMORY-REPLAY-V1");
+    for word in evidence.canonical_digest {
+        d.write_u64(word);
+    }
+    d.write_sequence_len(proofs.len());
+    for ((proof, event), target) in proofs
+        .iter()
+        .zip(&evidence.batch.events)
+        .zip(&evidence.prediction_targets)
+    {
+        proof.validate_against(event, target)?;
+        for word in proof.canonical_digest() {
+            d.write_u64(word);
+        }
+    }
+    Ok(d.finish256())
+}
