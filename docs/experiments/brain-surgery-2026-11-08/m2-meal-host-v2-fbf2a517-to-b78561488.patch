+//! Private meal-owned wire bridge. No public conversion of old acquired lives.
+//! The old codec/data bodies remain literal; only this bridge may normalize a
+//! validated new inner policy into the old compatible in-memory container.
+use super::*;
+
+const MEAL_INNER_MAGIC_V2: &[u8] = b"ALIFE-GROUPED-MEAL-OWNED-INNER\0V2\0PROOF-OWNER-BOUND\0";
+const MEAL_INNER_LINEAGE_V2: &str = "fresh-grouped-meal-owned-inner-v2/no-old-import";
+const MEAL_INNER_POLICY_V2: &str = "meal-owned-state-v2/exact-proof-owner-digest";
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(in crate::cpu::host) struct MealInnerBindingV2 {
+    pub(in crate::cpu::host) owners: Vec<u64>,
+    pub(in crate::cpu::host) proof_digest: [u64; 4],
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct MealInnerPolicyV2 {
+    schema_version: u16,
+    policy: String,
+    binding: MealInnerBindingV2,
+}
+impl MealInnerPolicyV2 {
+    fn new(binding: &MealInnerBindingV2) -> Self {
+        Self {
+            schema_version: 2,
+            policy: MEAL_INNER_POLICY_V2.into(),
+            binding: binding.clone(),
+        }
+    }
+}
+fn validate_owners(
+    payload: &GroupedPayloadV1,
+    binding: &MealInnerBindingV2,
+) -> Result<(), CpuHostError> {
+    if payload.controllers.keys().copied().collect::<Vec<_>>() != binding.owners {
+        return Err(CpuHostError::State("meal inner proof owner mismatch"));
+    }
+    Ok(())
+}
+fn encode_marked(payload: &GroupedPayloadV1) -> Result<Vec<u8>, CpuHostError> {
+    let mut bytes = MEAL_INNER_MAGIC_V2.to_vec();
+    bytes.extend(serde_json::to_vec(payload)?);
+    Ok(bytes)
+}
+pub(in crate::cpu::host) fn encode_meal_owned_inner_v2(
+    checkpoint: &CpuGroupedM2HostCheckpointV1,
+    binding: &MealInnerBindingV2,
+) -> Result<Vec<u8>, CpuHostError> {
+    let mut payload = checkpoint.payload.clone();
+    if payload.schema_version != 1 || payload.source_lineage != LINEAGE || payload.policy != POLICY
+    {
+        return Err(CpuHostError::State(
+            "meal bridge received foreign base policy",
+        ));
+    }
+    validate_owners(&payload, binding)?;
+    payload.schema_version = 2;
+    payload.source_lineage = MEAL_INNER_LINEAGE_V2.into();
+    payload.policy = serde_json::to_string(&MealInnerPolicyV2::new(binding))?;
+    encode_marked(&payload)
+}
+pub(in crate::cpu::host) fn decode_meal_owned_inner_v2(
+    bytes: &[u8],
+    binding: &MealInnerBindingV2,
+) -> Result<CpuGroupedM2HostCheckpointV1, CpuHostError> {
+    let body = bytes
+        .strip_prefix(MEAL_INNER_MAGIC_V2)
+        .ok_or(CpuHostError::State("not a meal-owned inner envelope"))?;
+    let metadata: serde_json::Value = serde_json::from_slice(body)?;
+    if metadata["schema_version"] != 2 || metadata["source_lineage"] != MEAL_INNER_LINEAGE_V2 {
+        return Err(CpuHostError::State("meal inner schema or lineage mismatch"));
+    }
+    let marker: MealInnerPolicyV2 = serde_json::from_str(
+        metadata["policy"]
+            .as_str()
+            .ok_or(CpuHostError::State("missing meal inner policy"))?,
+    )?;
+    if marker != MealInnerPolicyV2::new(binding) {
+        return Err(CpuHostError::State("meal inner proof binding mismatch"));
+    }
+    // Only after the new identity and entire proof-owner map digest agree may
+    // legacy-compatible source/world fields be decoded. Exact sampler bits and
+    // canonical nested-field checks retain the old codec's strict boundary.
+    let mut payload: GroupedPayloadV1 = serde_json::from_value(metadata.clone())?;
+    payload.restore_sampler_bits()?;
+    validate_owners(&payload, binding)?;
+    if serde_json::from_slice::<serde_json::Value>(&serde_json::to_vec(&payload)?)? != metadata
+        || encode_marked(&payload)? != bytes
+    {
+        return Err(CpuHostError::State("noncanonical meal-owned inner state"));
+    }
+    // This is a process-local private token, never an exported old envelope.
+    // All biological/neural/memory/controller fields are left byte-compatible.
+    payload.schema_version = 1;
+    payload.source_lineage = LINEAGE.into();
+    payload.policy = POLICY.into();
+    let checkpoint = CpuGroupedM2HostCheckpointV1 { payload };
+    CpuGroupedM2HostCheckpointV1::decode(&checkpoint.encode()?)
+}
