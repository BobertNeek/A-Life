+//! Fresh, explicitly opt-in grouped meal-memory envelope. Old envelopes remain exact.
+//! Synapses stay closed. Waking association writes are unpriced like the baseline;
+//! actual later retrieval and unique sleep-association work use existing counters.
+use super::grouped_host_envelope::{
+    decode_meal_owned_inner_v2, encode_meal_owned_inner_v2, MealInnerBindingV2,
+};
+use super::*;
+use serde::{Deserialize, Serialize};
+
+const MAGIC: &[u8] =
+    b"ALIFE-GROUPED-MEAL-M2-HOST\0V2\0PROOF-OWNED-INNER\0SYNAPTIC-CLOSED\0PROFILE5\0";
+const LINEAGE: &str =
+    "fresh-grouped-meal-m2-host-v2/proof-owned-inner/closed-source/no-historical-import";
+const POLICY: &str = "meal-host-v2;proof-owned-inner-v2;m2-exact-consumed-joint-association-v1;meal-aware-recall-and-familiarity-v1;one-source-event;two-associations-max;typed-meal-sleep-v1;waking-association-writes-unpriced-as-baseline;actual-retrieval-and-sleep-work;no-clone-hash-price;one-cognitive-debit;synaptic-learning-closed";
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct MealResidentV1 {
+    pub(super) proofs: Vec<MealMemorySleepProofV1>,
+}
+impl MealResidentV1 {
+    pub(super) fn validate(&self, resident: &Resident) -> Result<(), CpuHostError> {
+        let base = resident
+            .grouped
+            .as_ref()
+            .ok_or(CpuHostError::State("missing meal grouped owner"))?;
+        if self.proofs.len() != resident.replay.len()
+            || self.proofs.len() != base.memory_proofs.len()
+        {
+            return Err(CpuHostError::State("meal replay proof count mismatch"));
+        }
+        let mut sequences = std::collections::BTreeSet::new();
+        for ((proof, original), event) in self
+            .proofs
+            .iter()
+            .zip(&base.memory_proofs)
+            .zip(&resident.replay)
+        {
+            proof.validate_against(&event.event, &event.target)?;
+            if proof.representative_source() != original
+                || !sequences.insert(event.event.sequence_id.raw())
+            {
+                return Err(CpuHostError::State(
+                    "meal representative or source sequence mismatch",
+                ));
+            }
+            // Audit all retained/unavailable associations, not only a representative.
+            proof.resolve_associations(resident.memory.bank())?;
+        }
+        Ok(())
+    }
+}
+pub(super) fn validate_meal_states(
+    host: &CpuCanonicalHost,
+    states: &BTreeMap<u64, MealResidentV1>,
+) -> Result<(), CpuHostError> {
+    if states.len() != host.residents.len() {
+        return Err(CpuHostError::State("meal owner count mismatch"));
+    }
+    for (&id, resident) in &host.residents {
+        states
+            .get(&id)
+            .ok_or(CpuHostError::State("missing meal owner"))?
+            .validate(resident)?;
+    }
+    Ok(())
+}
+
+/// The inner state is carried under a distinct meal-owned schema and policy
+/// bound to every outer proof owner. Unmodified extraction cannot enter the old
+/// public grouped decoder. This is an API boundary, not authentication against
+/// someone rewriting all unauthenticated JSON. No old-life conversion is exposed.
+pub struct CpuGroupedMealM2HostV2 {
+    pub(super) inner: CpuGroupedM2HostV1,
+    pub(super) meals: BTreeMap<u64, MealResidentV1>,
+}
+#[derive(Debug, Clone)]
+pub struct CpuGroupedMealM2HostCheckpointV2 {
+    payload: MealPayloadV2,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct MealPayloadV2 {
+    schema_version: u16,
+    source_lineage: String,
+    policy: String,
+    meal_owned_inner_envelope_utf8: String,
+    meal_sources: BTreeMap<u64, MealResidentV1>,
+}
+fn meal_inner_binding_v2(
+    states: &BTreeMap<u64, MealResidentV1>,
+) -> Result<MealInnerBindingV2, CpuHostError> {
+    Ok(MealInnerBindingV2 {
+        owners: states.keys().copied().collect(),
+        proof_digest: json_digest(
+            b"ALIFE-GROUPED-MEAL-M2-PROOF-OWNERS-V2",
+            &(2_u16, LINEAGE, POLICY, states),
+        )?,
+    })
+}
+impl CpuGroupedMealM2HostCheckpointV2 {
+    pub fn encode(&self) -> Result<Vec<u8>, CpuHostError> {
+        let mut bytes = MAGIC.to_vec();
+        bytes.extend(serde_json::to_vec(&self.payload)?);
+        Ok(bytes)
+    }
+    pub fn decode(bytes: &[u8]) -> Result<Self, CpuHostError> {
+        // Identity is checked before decoding any old nested source/world types.
+        let body = bytes
+            .strip_prefix(MAGIC)
+            .ok_or(CpuHostError::State("not a fresh grouped meal envelope"))?;
+        let metadata: serde_json::Value = serde_json::from_slice(body)?;
+        if metadata["schema_version"] != 2
+            || metadata["source_lineage"] != LINEAGE
+            || metadata["policy"] != POLICY
+        {
+            return Err(CpuHostError::State(
+                "meal envelope policy or lineage mismatch",
+            ));
+        }
+        let payload: MealPayloadV2 = serde_json::from_slice(body)?;
+        if serde_json::from_slice::<serde_json::Value>(&serde_json::to_vec(&payload)?)? != metadata
+        {
+            return Err(CpuHostError::State(
+                "meal envelope omitted or unknown nested field",
+            ));
+        }
+        decode_meal_owned_inner_v2(
+            payload.meal_owned_inner_envelope_utf8.as_bytes(),
+            &meal_inner_binding_v2(&payload.meal_sources)?,
+        )?;
+        Ok(Self { payload })
+    }
+}
+pub struct CpuGroupedMealM2HostStepV2 {
+    pub base: CpuGroupedM2HostStepV1,
+    /// One typed transaction per real decision, including withheld/ignored meal writes.
+    pub meal_transactions: Vec<(OrganismId, MealMemoryTransactionReceiptV1)>,
+}
+impl CpuGroupedMealM2HostV2 {
+    pub fn new_prepared<T, E: std::fmt::Display>(
+        game: CanonicalNewGame,
+        founder: CpuFoundationTrainer,
+        source_inputs: PhenotypeCompilerInputs,
+        sampling_seed: u32,
+        mode: MediationModeV1,
+        prepare: impl FnOnce(&mut HeadlessWorld) -> Result<T, E>,
+    ) -> Result<(Self, T), CpuHostError> {
+        // This constructor alone admits fresh bodies. There is intentionally no
+        // conversion from an acquired old/grouped/decoder host or checkpoint.
+        let (inner, result) = CpuGroupedM2HostV1::new_prepared(
+            game,
+            founder,
+            source_inputs,
+            sampling_seed,
+            mode,
+            prepare,
+        )?;
+        let meals = inner
+            .host
+            .residents
+            .keys()
+            .map(|&id| (id, MealResidentV1::default()))
+            .collect();
+        validate_meal_states(&inner.host, &meals)?;
+        Ok((Self { inner, meals }, result))
+    }
+    pub fn world(&self) -> &HeadlessWorld {
+        self.inner.world()
+    }
+    pub fn sleep_state(&self, organism: OrganismId) -> Option<alife_core::sleep::SleepState> {
+        self.inner.sleep_state(organism)
+    }
+    pub fn checkpoint(&self) -> Result<CpuGroupedMealM2HostCheckpointV2, CpuHostError> {
+        validate_meal_states(&self.inner.host, &self.meals)?;
+        Ok(CpuGroupedMealM2HostCheckpointV2 {
+            payload: MealPayloadV2 {
+                schema_version: 2,
+                source_lineage: LINEAGE.into(),
+                policy: POLICY.into(),
+                meal_owned_inner_envelope_utf8: String::from_utf8(encode_meal_owned_inner_v2(
+                    &self.inner.checkpoint()?,
+                    &meal_inner_binding_v2(&self.meals)?,
+                )?)
+                .map_err(|_| CpuHostError::State("non-UTF8 closed envelope"))?,
+                meal_sources: self.meals.clone(),
+            },
+        })
+    }
+    pub fn restore(
+        checkpoint: CpuGroupedMealM2HostCheckpointV2,
+        expected_source: &PhenotypeCompilerInputs,
+        expected_mode: MediationModeV1,
+    ) -> Result<Self, CpuHostError> {
+        let wire = checkpoint.encode()?;
+        let checkpoint = CpuGroupedMealM2HostCheckpointV2::decode(&wire)?;
+        let payload = checkpoint.payload;
+        let inner = CpuGroupedM2HostV1::restore(
+            decode_meal_owned_inner_v2(
+                payload.meal_owned_inner_envelope_utf8.as_bytes(),
+                &meal_inner_binding_v2(&payload.meal_sources)?,
+            )?,
+            expected_source,
+            expected_mode,
+        )?;
+        let result = Self {
+            inner,
+            meals: payload.meal_sources,
+        };
+        validate_meal_states(&result.inner.host, &result.meals)?;
+        if result.checkpoint()?.encode()? != wire {
+            return Err(CpuHostError::State(
+                "meal restore would rewrite acquired state",
+            ));
+        }
+        Ok(result)
+    }
+    pub fn step(&mut self, temperature: f32) -> Result<CpuGroupedMealM2HostStepV2, CpuHostError> {
+        self.inner
+            .host
+            .grouped_meal_step(&self.inner.founder, temperature, &mut self.meals)
+    }
+    pub fn actor_optimization(&mut self) -> Result<(), CpuHostError> {
+        self.inner.actor_optimization()
+    }
+    pub fn waking_synaptic_plasticity(&mut self) -> Result<(), CpuHostError> {
+        self.inner.waking_synaptic_plasticity()
+    }
+    pub fn synaptic_sleep_consolidation(&mut self) -> Result<(), CpuHostError> {
+        self.inner.synaptic_sleep_consolidation()
+    }
+}
+
