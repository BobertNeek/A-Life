+        .unwrap();
+        let mut old = bank(8);
+        let original = old.observe_sealed_patch(&patch).unwrap();
+        let mut new = bank(8);
+        let receipt = new
+            .observe_sealed_patch_with_meal_v1(&patch, &frame)
+            .unwrap();
+        println!("meal boundary family={family:?} target={target:?} sequence={} old_digest={:?} before_digest={:?} after_digest={:?} old_record_count={} new_record_count={} generation={} representative={:?} supplemental={:?}",
+            receipt.sealed_sequence_id.raw(), original.after_digest, receipt.before_digest,
+            receipt.after_digest, original.record_count, receipt.record_count,
+            receipt.output_generation, receipt.representative,
+            receipt.supplemental.as_ref().map(|write| write.kind));
+        receipt.validate_committed_bank(&new).unwrap();
+        assert_eq!(receipt.schema_version, 1);
+        assert_eq!(receipt.representative, original.kind);
+        let representative = retained_id(original.kind).unwrap();
+        assert_eq!(
+            new.candidate_store.records[&representative.raw()],
+            old.candidate_store.records[&representative.raw()]
+        );
+        let meal = receipt.supplemental.unwrap();
