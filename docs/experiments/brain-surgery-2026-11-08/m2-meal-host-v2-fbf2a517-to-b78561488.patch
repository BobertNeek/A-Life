+        assert_eq!(meal.proof.target_entity, FOOD);
+        assert_eq!(meal.proof.dispatch_generation, 1);
+        assert_eq!(meal.proof.frame_digest, frame.frame_digest());
+        assert_eq!(meal.proof.physical_contact, PhysicalContactKind::Consumed);
+        assert_eq!(
+            meal.proof.query.action_family(),
+            CandidateActionFamily::Ingest
+        );
+        assert_eq!(
+            meal.proof.query.tracked_object_id(),
+            Some(TrackedObjectId(61))
+        );
+        let source = &new.candidate_store.records[&retained_id(meal.kind).unwrap().raw()];
+        assert_eq!(source.outcome_contact, Some(PhysicalContactKind::Consumed));
+        assert_eq!(source.source_sequence_id, patch.header().sequence_id);
+        assert_eq!(source.observation_count, 1);
+        assert_eq!(receipt.input_generation + 1, receipt.output_generation);
+        assert_eq!(new.candidate_store.generation, 1);
+        assert_eq!(
+            new.candidate_store.last_sequence_by_organism[&OWNER.raw()],
+            1
+        );
+        assert_eq!(receipt.sealed_sequence_id, patch.header().sequence_id);
+        assert_eq!(receipt.record_count, 2);
+        assert_ne!(receipt.before_digest, receipt.after_digest);
+    }
+}
