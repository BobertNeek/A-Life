+    );
+    let (event, target) = meal_sleep_source(&patch);
+    let old_proof = SleepMemorySourceProofV1::capture(&patch, event, &target, old_write).unwrap();
+    let proof = MealMemorySleepProofV1::capture(&patch, event, &target, meal_write).unwrap();
+    let evidence = evidence(&[(event, target)]);
+    let old_receipt = old
+        .memory
+        .run_bounded_sleep_transaction_scoped_v1(
+            &consolidator(8),
