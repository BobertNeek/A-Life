+
+fn grouped_meal_dynamic_work(
+    p: &BrainPhenotype,
+    r: &Resident,
+    activity: &CpuActivityBudget,
+) -> Result<u64, CpuHostError> {
+    // The existing generic policy omits dynamic branches/spans and
+    // encoder assignments. V1 prices their actual executed work too.
+    let source_dynamic_q24 = r
+        .v11
+        .dendritic_branches()
+        .branches()
+        .iter()
+        .try_fold(0_u64, |sum, b| {
+            sum.checked_add(16 + 4 * b.inputs.len() as u64)
+        })
+        .and_then(|n| n.checked_mul(u64::from(activity.microsteps)))
+        .and_then(|n| n.checked_add(4 * p.sensor_encoder().assignments().len() as u64))
+        .ok_or(CpuHostError::State("source dynamic work overflow"))?;
+    let structural_ops = r
+        .v11
+        .sparse_spans()
+        .iter()
+        .flat_map(|s| &s.edges)
+        .try_fold(0_u64, |sum, e| {
+            if e.source >= 2048 || e.target >= 2048 || e.route as usize >= p.projections().len() {
+                return Err(CpuHostError::State("dynamic edge enters fixed controller"));
+            }
+            let visits = if activity.enabled_routes[e.route as usize] {
+                (0..activity.microsteps as usize)
+                    .filter(|&step| {
+                        super::super::replay::route_fires(
+                            p.projections()[e.route as usize].update_cadence().raw(),
+                            step,
+                        )
+                    })
+                    .count() as u64
+            } else {
+                0
+            };
+            sum.checked_add(visits)
+                .ok_or(CpuHostError::State("source structural work overflow"))
+        })?;
+    let dynamic = source_dynamic_q24
+        .checked_add(
+            structural_ops
+                .checked_mul(4)
+                .ok_or(CpuHostError::State("structural price overflow"))?,
+        )
+        .ok_or(CpuHostError::State("source dynamic price overflow"))?;
+    Ok(dynamic)
+}
