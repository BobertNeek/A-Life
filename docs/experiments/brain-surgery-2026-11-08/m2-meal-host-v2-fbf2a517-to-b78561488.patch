+#[test]
+fn meal_bounded_sleep_merged_sources_deduplicate_ids_not_original_events() {
+    let (mut h, first, first_proof) = retained_case(8);
+    let (middle_event, middle_target, middle_proof) = h.observe(2, Case::default());
+    let (last_event, last_target, last_proof) = h.observe(3, Case::default());
+    assert_eq!(
+        middle_proof.resolve_associations(h.memory.bank()).unwrap(),
+        [None, None]
+    );
+    let mixed = evidence(&[
+        (first.batch.events[0], first.prediction_targets[0].clone()),
+        (middle_event, middle_target),
+        (last_event, last_target),
+    ]);
+    let proofs = [first_proof, middle_proof, last_proof];
+    let mut expected = h.predictor.clone();
+    expected.observe(&mixed.prediction_targets[0]).unwrap();
