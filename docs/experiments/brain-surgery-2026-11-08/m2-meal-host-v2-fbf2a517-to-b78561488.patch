+#[test]
+fn meal_sleep_wrapper_cold_roundtrip_authenticates_both_ids_and_tampering() {
+    assert_positive_meal_control();
+    let (patch, frame) = fixture(1, Case::default()).unwrap();
+    let mut b = bank(8);
+    let transaction = b.observe_sealed_patch_with_meal_v1(&patch, &frame).unwrap();
+    let expected = [
+        retained_id(transaction.representative),
+        retained_id(transaction.supplemental.as_ref().unwrap().kind),
+    ];
+    let (event, target) = meal_sleep_source(&patch);
+    let proof = MealMemorySleepProofV1::capture(&patch, event, &target, transaction).unwrap();
+    let encoded = serde_json::to_vec(&proof).unwrap();
+    let restored: MealMemorySleepProofV1 = serde_json::from_slice(&encoded).unwrap();
+    restored.validate_against(&event, &target).unwrap();
+    assert_eq!(restored.resolve_associations(&b).unwrap(), expected);
+    assert_eq!(restored.transaction(), proof.transaction());
+    assert_eq!(serde_json::to_vec(&restored).unwrap(), encoded);
+    // A validly shaped but altered proof must not survive its sealed digest.
+    for field in ["dispatch_generation", "target_entity"] {
+        let mut value = serde_json::to_value(&proof).unwrap();
+        value["transaction"]["supplemental"]["proof"][field] = serde_json::json!(99);
+        if let Ok(altered) = serde_json::from_value::<MealMemorySleepProofV1>(value) {
+            assert!(altered.validate_against(&event, &target).is_err());
+            assert!(altered.resolve_associations(&b).is_err());
+        }
+    }
+    let mut wrong = event;
+    wrong.action_id = ActionId(700);
+    assert!(restored.validate_against(&wrong, &target).is_err());
+    let mut wrong_target = target.clone();
+    wrong_target.decision = ActionId(700);
+    assert!(restored.validate_against(&event, &wrong_target).is_err());
+}
