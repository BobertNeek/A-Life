+        )
+        .unwrap()
+        .unwrap();
+    let meal_receipt = meal.run(&evidence, &[proof]).unwrap().unwrap();
+    assert_eq!(meal, old);
+    assert_eq!(
+        serde_json::to_vec(meal.memory.bank()).unwrap(),
+        original_bytes
+    );
+    assert_eq!(
+        meal_receipt.replay_event_count,
+        old_receipt.replay_event_count
+    );
+    assert_eq!(
+        meal_receipt.promoted_memory_ids,
+        old_receipt.promoted_memory_ids
+    );
+    assert_eq!(
+        meal_receipt.predictor_update_count,
+        old_receipt.predictor_update_count
+    );
+    assert_eq!(
+        meal_receipt.replay_eligibility_sample_count,
+        old_receipt.replay_eligibility_sample_count
+    );
+    assert_eq!(meal_receipt.concept, old_receipt.concept);
+    assert_eq!(meal_receipt.work_units, old_receipt.work_units);
+    assert_ne!(meal_receipt.replay_digest, old_receipt.replay_digest);
+}
