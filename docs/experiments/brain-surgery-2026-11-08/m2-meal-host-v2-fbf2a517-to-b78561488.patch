+    assert_eq!(mixed.prediction_targets.len(), 3);
+}
+
+#[test]
+fn meal_bounded_sleep_malformed_unavailable_sibling_rejects_after_valid_source() {
+    let (mut h, first, first_proof) = retained_case(8);
+    let (middle_event, middle_target, middle_proof) = h.observe(2, Case::default());
