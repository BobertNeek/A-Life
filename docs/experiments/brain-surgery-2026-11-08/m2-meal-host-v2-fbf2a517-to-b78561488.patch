+#[test]
+fn meal_object_familiarity_counts_immediate_siblings_once_but_keeps_merged_observations() {
+    assert_positive_meal_control();
+    let mut memory = bank(8);
+    let case = Case {
+        representative: CandidateActionFamily::Inspect,
+        representative_target: Some(FOOD),
+        ..Case::default()
+    };
+    for (sequence, expected_meal, expected_legacy) in
+        [(1, 0.5_f32, 2.0_f32 / 3.0), (2, 2.0 / 3.0, 4.0 / 5.0)]
+    {
+        let (patch, frame) = fixture(sequence, case.clone()).unwrap();
+        let transaction = memory
+            .observe_sealed_patch_with_meal_v1(&patch, &frame)
+            .unwrap();
+        let supplemental = transaction.supplemental.as_ref().unwrap();
+        let representative_id = retained_id(transaction.representative).unwrap();
+        let meal_id = retained_id(supplemental.kind).unwrap();
+        assert_ne!(representative_id, meal_id);
+        assert_eq!(memory.candidate_store.records.len(), 2);
+        for record in memory.candidate_store.records.values() {
+            assert_eq!(record.tracked_object_id_raw, 61);
+            assert_eq!(record.source_sequence_id, ExperienceSequenceId(sequence));
+            assert_eq!(u64::from(record.observation_count), sequence);
+        }
+        if sequence == 2 {
+            assert!(matches!(
+                transaction.representative,
+                MemoryUpdateKind::Merged { .. }
+            ));
+            assert!(matches!(supplemental.kind, MemoryUpdateKind::Merged { .. }));
+        }
+        let bytes_before = serde_json::to_vec(&memory).unwrap();
+        let legacy_before = memory.object_familiarity(OWNER, TrackedObjectId(61), identity());
+        let meal = memory.object_familiarity_with_meal_v1(OWNER, TrackedObjectId(61), identity());
+        assert!((meal - expected_meal).abs() < 1.0e-6);
+        assert!((legacy_before - expected_legacy).abs() < 1.0e-6);
+        assert_eq!(
+            memory.object_familiarity(OWNER, TrackedObjectId(61), identity()),
+            legacy_before
+        );
+        assert_eq!(serde_json::to_vec(&memory).unwrap(), bytes_before);
+        // Only the immediate latest-sequence siblings are grouped here. The
+        // retained maximum preserves repeated observations within each record;
+        // this does not assert independent historical lineage after merges.
+    }
+}
