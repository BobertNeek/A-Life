+fn meal_host_rejects_missing_duplicate_sources_and_rolls_back_late_sampling_failure() {
+    let (mut host, inputs) = fixture(false);
+    // Real committing host positive control, before each corruption family.
+    let positive = host.step(0.73).unwrap();
+    assert_eq!(positive.base.decisions.len(), 1);
+    assert_eq!(host.meals.values().next().unwrap().proofs.len(), 1);
+    let before = host.checkpoint().unwrap().encode().unwrap();
+    assert_owned_inner_boundary(&host, &inputs);
+    assert!(host.step(f32::NAN).is_err());
+    assert_eq!(host.checkpoint().unwrap().encode().unwrap(), before);
+    for duplicate in [false, true] {
+        let mut checkpoint = host.checkpoint().unwrap();
+        let proofs = &mut checkpoint
+            .payload
+            .meal_sources
+            .values_mut()
+            .next()
+            .unwrap()
+            .proofs;
+        if duplicate {
+            proofs.push(proofs[0].clone());
