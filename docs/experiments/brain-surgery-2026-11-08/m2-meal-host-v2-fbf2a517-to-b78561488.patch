+    assert_eq!(receipt.replay_eligibility_sample_count, 2);
+    assert_eq!(receipt.predictor_update_count, 2);
+    assert_eq!(receipt.work_units, 8);
+    assert_eq!(h.predictor, expected);
+    assert_eq!(h.memory, memory_before);
