+fn replace_inner_policy(inner: &str, new_policy: &str) -> String {
+    let start = inner.find('{').unwrap();
+    let metadata: serde_json::Value = serde_json::from_str(&inner[start..]).unwrap();
+    let old = serde_json::to_string(metadata["policy"].as_str().unwrap()).unwrap();
+    let new = serde_json::to_string(new_policy).unwrap();
+    assert_eq!(inner.matches(&old).count(), 1);
+    inner.replacen(&old, &new, 1)
+}
+fn assert_owned_inner_boundary(host: &CpuGroupedMealM2HostV2, inputs: &PhenotypeCompilerInputs) {
+    let valid = host.checkpoint().unwrap();
+    let before = valid.encode().unwrap();
+    let restored = CpuGroupedMealM2HostV2::restore(
+        CpuGroupedMealM2HostCheckpointV2::decode(&before).unwrap(),
+        inputs,
+        MediationModeV1::Full,
+    )
+    .unwrap();
+    assert_eq!(restored.checkpoint().unwrap().encode().unwrap(), before);
+    let inner = &valid.payload.meal_owned_inner_envelope_utf8;
+    let legacy = host.inner.checkpoint().unwrap().encode().unwrap();
+    assert!(CpuGroupedM2HostCheckpointV1::decode(inner.as_bytes()).is_err());
+    // Replacing only the new inner prefix still cannot pass old typed policy
+    // admission. No claim is made against rewriting every unauthenticated field.
+    let start = inner.find('{').unwrap();
+    let old_start = legacy.iter().position(|b| *b == b'{').unwrap();
+    let mut prefix_only = legacy[..old_start].to_vec();
+    prefix_only.extend(&inner.as_bytes()[start..]);
+    assert!(CpuGroupedM2HostCheckpointV1::decode(&prefix_only).is_err());
+    let private_base = decode_meal_owned_inner_v2(
+        inner.as_bytes(),
+        &meal_inner_binding_v2(&host.meals).unwrap(),
+    )
+    .unwrap();
+    assert_eq!(private_base.encode().unwrap(), legacy);
+
+    // The former unprotected prototype has its own rejected outer identity.
+    // This is constructed from this test-owned fresh state, never an old life.
+    let prototype = serde_json::json!({
+        "schema_version": 1,
+        "source_lineage": "fresh-grouped-meal-m2-host-v1/closed-source/no-historical-import",
+        "policy": "m2-exact-consumed-joint-association-v1;meal-aware-recall-and-familiarity-v1;one-source-event;two-associations-max;typed-meal-sleep-v1;waking-association-writes-unpriced-as-baseline;actual-retrieval-and-sleep-work;no-clone-hash-price;one-cognitive-debit;synaptic-learning-closed",
+        "closed_canonical_envelope_utf8": String::from_utf8(legacy.clone()).unwrap(),
+        "meal_sources": &host.meals,
+    });
+    let mut prototype_wire =
+        b"ALIFE-GROUPED-MEAL-M2-HOST\0V1\0SYNAPTIC-CLOSED\0PROFILE5\0".to_vec();
+    prototype_wire.extend(serde_json::to_vec(&prototype).unwrap());
+    assert!(CpuGroupedMealM2HostCheckpointV2::decode(&prototype_wire).is_err());
+
+    let metadata: serde_json::Value = serde_json::from_str(&inner[start..]).unwrap();
+    let marker: serde_json::Value =
+        serde_json::from_str(metadata["policy"].as_str().unwrap()).unwrap();
+    let mut corruptions = vec![
+        replace_inner_policy(inner, ""),
+        String::from_utf8(legacy).unwrap(),
+    ];
+    for mode in 0..4 {
+        let mut changed = marker.clone();
+        match mode {
+            0 => {
+                changed.as_object_mut().unwrap().remove("binding");
+            }
+            1 => {
+                changed["binding"]
+                    .as_object_mut()
+                    .unwrap()
+                    .remove("proof_digest");
+            }
+            2 => {
+                let old = changed["binding"]["proof_digest"][0].as_u64().unwrap();
+                changed["binding"]["proof_digest"][0] = serde_json::json!(old ^ 1);
+            }
+            3 => {
+                changed["binding"]["owners"][0] = serde_json::json!(u64::MAX);
+            }
+            _ => unreachable!(),
+        }
+        corruptions.push(replace_inner_policy(
+            inner,
+            &serde_json::to_string(&changed).unwrap(),
+        ));
+    }
+    corruptions.push(inner.replacen("\"schema_version\":2", "\"schema_version\":1", 1));
+    for changed_inner in &corruptions {
+        assert_ne!(changed_inner, inner);
+        let mut bad = valid.clone();
+        bad.payload.meal_owned_inner_envelope_utf8 = changed_inner.clone();
+        assert!(CpuGroupedMealM2HostCheckpointV2::decode(&bad.encode().unwrap()).is_err());
+        assert!(CpuGroupedMealM2HostV2::restore(bad, inputs, MediationModeV1::Full).is_err());
+        assert_eq!(host.checkpoint().unwrap().encode().unwrap(), before);
+    }
+    println!("MEAL_BOUNDARY_V2 extracted-old-rejected=true prefix-only-old-rejected=true prototype-v1-rejected=true inner-corruptions={} private-normalization-byte-exact=true", corruptions.len());
+}
