+#[test]
+fn meal_reader_is_opt_in_for_previously_valid_same_sequence_legacy_bank() {
+    assert_positive_meal_control();
+    let mut b = bank(8);
+    for (sequence, representative) in [
+        (1, CandidateActionFamily::Inspect),
+        (2, CandidateActionFamily::Ingest),
+    ] {
+        let (patch, _) = fixture(
+            sequence,
+            Case {
+                representative,
+                representative_target: Some(FOOD),
+                receipts: 1,
+                ..Case::default()
+            },
+        )
+        .unwrap();
+        b.observe_sealed_patch(&patch).unwrap();
+    }
+    assert_eq!(b.candidate_store.records.len(), 2);
+    // Literal accepted legacy shape: distinct IDs/families with the same latest
+    // source sequence, no outcome_contact metadata. Old validation permits it.
+    let ids: Vec<_> = b.candidate_store.records.keys().copied().collect();
+    for (index, record) in b.candidate_store.records.values_mut().enumerate() {
+        record.source_sequence_id = ExperienceSequenceId(1);
+        record.target_latent = [if index == 0 { 0.25 } else { 0.75 }; MEMORY_LATENT_V1_COUNT];
+        assert!(record.outcome_contact.is_none());
+    }
+    b.candidate_store.rebuild_indices();
+    b.candidate_store
+        .validate_for_capacity(b.capacity())
+        .unwrap();
+    let literal_bank = include_bytes!("testdata/legacy_same_sequence_bank_fbf.json").to_vec();
+    assert_eq!(serde_json::to_vec(&b).unwrap(), literal_bank);
+    let restored: MemoryBank = serde_json::from_slice(&literal_bank).unwrap();
+    assert_eq!(serde_json::to_vec(&restored).unwrap(), literal_bank);
+    let (_, probe) = fixture(
+        100,
+        Case {
+            representative: CandidateActionFamily::Inspect,
+            representative_target: Some(FOOD),
+            ..Case::default()
+        },
+    )
+    .unwrap();
+    let draft = PerceptionFrameDraft::new(
+        OWNER,
+        probe.tick(),
+        probe.sensor_profile(),
+        probe.sensory().clone(),
+        probe.body(),
+        *probe.homeostasis(),
+        probe.candidates().to_vec(),
+        probe.profile_provenance(),
+        probe.grounded_object_slots().to_vec(),
+    )
+    .unwrap();
+    let ordinary = restored.recall_frame(&draft).unwrap();
+    let meal = restored.recall_frame_with_meal_v1(&draft).unwrap();
+    let (runtime, _) = restored
+        .recall_frame_runtime(&draft, &Default::default(), true)
+        .unwrap();
+    // Independent enumeration of the fbf target scoring contract: weighted
+    // cosine over state 0..40, target 57..81 and legacy profile 81..83, then
+    // descending score and ascending ID on ties. No production recall helper.
+    fn cosine(a: &[f32], b: &[f32], range: std::ops::Range<usize>) -> f32 {
+        let (mut dot, mut aa, mut bb) = (0.0_f32, 0.0_f32, 0.0_f32);
+        for i in range {
+            dot += a[i] * b[i];
+            aa += a[i] * a[i];
+            bb += b[i] * b[i];
+        }
+        if aa == 0.0 && bb == 0.0 {
+            1.0
+        } else if aa == 0.0 || bb == 0.0 {
+            0.0
+        } else {
+            (dot / (aa.sqrt() * bb.sqrt())).clamp(-1.0, 1.0)
+        }
+    }
+    for candidate in draft.candidates() {
+        let query = MemoryQueryEncoderV2::encode_candidate(&draft, candidate).unwrap();
+        let mut scores: Vec<_> = restored
+            .candidate_store
+            .records
+            .values()
+            .map(|record| {
+                let q = query.features();
+                let r = &record.query_features;
+                (
+                    record.memory_id,
+                    0.45 * cosine(q, r, 0..40)
+                        + 0.50 * cosine(q, r, 57..81)
+                        + 0.05 * cosine(q, r, 81..83),
+                )
+            })
+            .collect();
+        assert!(scores.iter().all(|(_, score)| *score >= 0.72));
+        // new() uses tick as age. Tick-4's inherited hormones are closer to
+        // tick-200 than tick-2's. The old ascending-ID tie breaker does not fire.
+        assert!(scores[1].1 > scores[0].1);
+        scores.sort_by(|a, b| b.1.total_cmp(&a.1).then_with(|| a.0.raw().cmp(&b.0.raw())));
+        assert_eq!(
+            scores.iter().map(|(id, _)| *id).collect::<Vec<_>>(),
+            vec![MemoryId(ids[1]), MemoryId(ids[0])]
+        );
+        let total = scores.iter().map(|(_, score)| *score).sum::<f32>();
+        let expected = scores
+            .iter()
+            .map(|(id, score)| {
+                restored.candidate_store.records[&id.raw()].target_latent[0] * (*score / total)
+            })
+            .sum::<f32>();
+        assert_eq!(expected, 0.5003887);
+        println!(
+            "legacy-independent-target-scores candidate={} scores={scores:?} value={expected}",
+            candidate.candidate_index
+        );
+    }
+    // Full literal output from the restored fbf reader, corroborated by the
+    // independent ranking/value derivation above. This covers all values,
+    // confidence/count/source order, and the encoded retrieval context digest.
+    let expected = EpisodicRetrievalContextV1::new(
+        draft.tick(),
+        identity(),
+        vec![
+            CandidateMemoryContextV1 {
+                candidate_index: 0,
+                target_latent: [0.5003887; MEMORY_LATENT_V1_COUNT],
+                family_value: [0.08571429, 1.0, 0.0, -0.099999994],
+                target_confidence: Confidence::new(0.70421875).unwrap(),
+                family_confidence: Confidence::new(0.729412).unwrap(),
+                target_source_count: 2,
+                family_source_count: 1,
+                best_target_source: Some(MemoryId(2)),
+                best_family_source: Some(MemoryId(1)),
+            },
+            CandidateMemoryContextV1 {
+                candidate_index: 1,
+                target_latent: [0.5003887; MEMORY_LATENT_V1_COUNT],
+                family_value: [0.08571429, 1.0, 0.0, -0.099999994],
+                target_confidence: Confidence::new(0.70421875).unwrap(),
+                family_confidence: Confidence::new(0.7396956).unwrap(),
+                target_source_count: 2,
+                family_source_count: 1,
+                best_target_source: Some(MemoryId(2)),
+                best_family_source: Some(MemoryId(2)),
+            },
+        ],
+    )
+    .unwrap();
+    assert_eq!(ordinary.context(), &expected);
+    assert_eq!(runtime.context(), &expected);
+    let expected_digest = expected
+        .to_perception_context_block()
+        .unwrap()
+        .canonical_digest();
+    assert_eq!(ordinary.receipt().context_digest, expected_digest);
+    assert_eq!(runtime.receipt().context_digest, expected_digest);
+    for candidate in &meal.context().candidates {
+        assert_eq!(candidate.target_source_count, 1);
+        assert_eq!(candidate.best_target_source, Some(MemoryId(ids[1])));
+        assert_eq!(candidate.target_latent, [0.75; MEMORY_LATENT_V1_COUNT]);
+    }
+    println!(
+        "legacy-literal-context-digest={expected_digest:?} bank-digest={:?}",
+        ordinary.receipt().bank_digest
+    );
+    assert_eq!(ordinary.receipt().candidates[0].target_matches, 2);
+    assert_eq!(meal.receipt().candidates[0].target_matches, 1);
+    assert_eq!(serde_json::to_vec(&restored).unwrap(), literal_bank);
+    let second = restored.recall_frame(&draft).unwrap();
+    assert_eq!(ordinary.context(), second.context());
+    assert_eq!(ordinary.receipt(), second.receipt());
+    println!(
+        "legacy-same-sequence-bank-bytes={}",
+        String::from_utf8(literal_bank).unwrap()
+    );
+}
