+/// Explicit intervention after one actual source execution. Keep valid frame,
+/// source, action and policy probability bindings, but do not call this a draw.
+fn scripted_rest_and_eat(
+    frame: &PerceptionFrame,
+    scores: &RecoveryGroupScoresV2,
+    mut action: RecoveryGroupJointActionV2,
+) -> Result<RecoveryGroupJointActionV2, CpuHostError> {
+    let eat = frame
+        .candidates()
+        .iter()
+        .find(|c| c.family == CandidateActionFamily::Ingest && c.kind == ActionKind::Interact)
+        .ok_or(CpuHostError::State(
+            "scripted world fixture has no observed ingest candidate",
+        ))?;
+    let distribution = scores.probabilities(action.temperature)?;
+    // This policy represents a populated channel's idle action by its concrete
+    // registered candidate, not the NoOp enum (reserved for empty channels).
+    // Preserve already valid sampled choices for unrelated non-contact channels.
+    let stationary = frame
+        .candidates()
+        .iter()
+        .find(|c| {
+            c.action_id == HeadlessActionIds::NO_LOCOMOTION
+                && c.kind == ActionKind::Move
+                && c.target == ActionTarget::NONE
+        })
+        .ok_or(CpuHostError::State(
+            "scripted fixture lacks registered no-locomotion",
+        ))?;
+    let locomotion = distribution.channels[0]
+        .as_ref()
+        .ok_or(CpuHostError::State(
+            "scripted fixture lacks locomotion factor",
+        ))?;
+    assert!(locomotion
+        .outcomes
+        .contains(&RecoveryGroupChoiceV2::Candidate(
+            stationary.candidate_index
+        )));
+    assert!(!locomotion.outcomes.contains(&RecoveryGroupChoiceV2::NoOp));
+    action.representative = RecoveryGroupChoiceV2::RestGroup;
+    action.motors[0] = RecoveryGroupChoiceV2::Candidate(stationary.candidate_index);
+    action.motors[4] = RecoveryGroupChoiceV2::RestGroup;
+    action.motors[2] = RecoveryGroupChoiceV2::Candidate(eat.candidate_index);
+    action.operation = Some(1); // Inherited AwakeRest, not a chemistry override.
+    action.draw_factors = vec![0];
+    for slot in 0..6 {
+        if slot != 4
+            && distribution.channels[slot]
+                .as_ref()
+                .is_some_and(|f| f.outcomes != [RecoveryGroupChoiceV2::NoOp])
+        {
+            action.draw_factors.push(2 + slot as u32);
+        }
+    }
+    action.draw_factors.push(1);
+    // Preserve a direct rejection witness for the initial fixture error.
+    let mut invalid_enum_noop = action.clone();
+    invalid_enum_noop.motors[0] = RecoveryGroupChoiceV2::NoOp;
+    assert!(scores.evaluate(&invalid_enum_noop).is_err());
+    action.old_joint_log_probability = scores.evaluate(&action)?.joint_log_probability;
+    scores.physical_selection(&action)?;
+    println!(
+        "SCRIPTED_SELECTION registered-no-locomotion={} ingest={} invalid-enum-noop-rejected=true",
+        stationary.action_id.raw(),
+        eat.action_id.raw()
+    );
+    Ok(action)
+}
