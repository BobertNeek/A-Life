+            let p = &write.proof;
+            d.write_u16(p.schema_version);
+            d.write_u64(p.sealed_sequence_id.raw());
+            for word in p.query.canonical_digest() {
+                d.write_u64(word);
+            }
+            d.write_u16(p.channel.canonical_key());
+            d.write_u64(p.target_entity.raw());
+            d.write_u64(p.dispatch_generation);
+            for word in p.phenotype_hash.0 {
+                d.write_u64(word);
+            }
+            for word in p
+                .frame_digest
+                .0
+                .into_iter()
+                .chain(p.bundle_digest)
+                .chain(p.patch_causal_digest)
+            {
+                d.write_u64(word);
+            }
+            // V1 admits only Consumed. Reject unknown/new phases in validation.
+            d.write_u8(match p.physical_contact {
+                PhysicalContactKind::None => 0,
+                PhysicalContactKind::Touch => 1,
+                PhysicalContactKind::Collision => 2,
+                PhysicalContactKind::Blocked => 3,
+                PhysicalContactKind::Consumed => 4,
+                PhysicalContactKind::Moved => 5,
+            });
+            match write.kind {
+                MemoryUpdateKind::IgnoredLowInformation => d.write_u8(0),
+                MemoryUpdateKind::IgnoredLowerRetention => d.write_u8(1),
+                MemoryUpdateKind::Inserted { inserted } => {
+                    d.write_u8(2);
+                    d.write_u64(inserted.raw());
+                }
+                MemoryUpdateKind::Merged { into } => {
+                    d.write_u8(3);
+                    d.write_u64(into.raw());
+                }
+                MemoryUpdateKind::Evicted { removed, inserted } => {
+                    d.write_u8(4);
+                    d.write_u64(removed.raw());
+                    d.write_u64(inserted.raw());
+                }
+            }
+        } else {
+            d.write_none();
+        }
+        Ok(d.finish256())
+    }
+}
+
+/// Binds exactly one multi-association proof to each original replay event.
+pub fn sleep_meal_memory_replay_digest_v1(
+    evidence: &crate::sleep::SleepReplayEvidence,
+    proofs: &[MealMemorySleepProofV1],
+) -> Result<[u64; 4], ScaffoldContractError> {
+    evidence.validate_contract()?;
+    if proofs.len() != evidence.batch.events.len() {
+        return Err(ScaffoldContractError::InvalidDecisionEvidence);
+    }
+    let mut d = CanonicalDigestBuilder::new(b"ALIFE-SLEEP-MEAL-MEMORY-REPLAY-V1");
+    for word in evidence.canonical_digest {
+        d.write_u64(word);
+    }
+    d.write_sequence_len(proofs.len());
+    for ((proof, event), target) in proofs
+        .iter()
+        .zip(&evidence.batch.events)
+        .zip(&evidence.prediction_targets)
+    {
+        proof.validate_against(event, target)?;
+        for word in proof.canonical_digest() {
+            d.write_u64(word);
+        }
+    }
+    Ok(d.finish256())
+}
