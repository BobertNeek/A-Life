+#[test]
+fn meal_actual_consumption_supersedes_contradictory_legacy_unknown_at_capacity_only() {
+    assert_positive_meal_control();
+    let mut b = bank(2);
+    let (legacy, _) = fixture(
+        1,
+        Case {
+            representative: CandidateActionFamily::Ingest,
+            representative_target: Some(FOOD),
+            receipts: 1,
+            reward: -0.99,
+            success: false,
+            ..Case::default()
+        },
+    )
+    .unwrap();
+    let legacy_id = retained_id(b.observe_sealed_patch(&legacy).unwrap().kind).unwrap();
+    let legacy_record = b.candidate_store.records[&legacy_id.raw()].clone();
+    assert_eq!(legacy_record.outcome_contact, None);
+    let (unrelated, _) = fixture(
+        2,
+        Case {
+            representative: CandidateActionFamily::Inspect,
+            representative_target: Some(OTHER),
+            receipts: 1,
+            reward: 0.85,
+            ..Case::default()
+        },
+    )
+    .unwrap();
+    let unrelated_id = retained_id(b.observe_sealed_patch(&unrelated).unwrap().kind).unwrap();
+    assert_eq!(b.candidate_store.records.len(), 2);
+    // Legacy JSON omits the scope field. Restoring it must not manufacture a
+    // consumed label from the old aggregate contact or positive/negative value.
+    let encoded = serde_json::to_vec(&b).unwrap();
+    assert!(!String::from_utf8(encoded.clone())
+        .unwrap()
+        .contains("outcome_contact"));
+    b = serde_json::from_slice(&encoded).unwrap();
+    for (sequence, contact) in [
+        (3, PhysicalContactKind::Touch),
+        (4, PhysicalContactKind::Moved),
+    ] {
+        let (patch, frame) = fixture(
+            sequence,
+            Case {
+                representative: CandidateActionFamily::Inspect,
+                representative_target: Some(OTHER),
+                meal_contact: contact,
+                ..Case::default()
+            },
+        )
+        .unwrap();
+        let write = b.observe_sealed_patch_with_meal_v1(&patch, &frame).unwrap();
+        assert!(write.supplemental.is_none());
+        assert_eq!(retained_id(write.representative), Some(unrelated_id));
+        assert_eq!(b.candidate_store.records[&legacy_id.raw()], legacy_record);
+    }
+    let (consumed, frame) = fixture(
+        6,
+        Case {
+            representative: CandidateActionFamily::Inspect,
+            representative_target: Some(OTHER),
+            ..Case::default()
+        },
+    )
+    .unwrap();
+    let mut ordinary = b.clone();
+    ordinary.observe_sealed_patch(&consumed).unwrap();
+    let write = b
+        .observe_sealed_patch_with_meal_v1(&consumed, &frame)
+        .unwrap();
+    assert_eq!(retained_id(write.representative), Some(unrelated_id));
+    let meal_write = write.supplemental.unwrap();
+    assert!(
+        matches!(meal_write.kind, MemoryUpdateKind::Evicted { removed, .. } if removed == legacy_id)
+    );
+    assert!(!b.candidate_store.records.contains_key(&legacy_id.raw()));
+    assert_eq!(
+        b.candidate_store.records[&unrelated_id.raw()],
+        ordinary.candidate_store.records[&unrelated_id.raw()]
+    );
+    let meal = &b.candidate_store.records[&retained_id(meal_write.kind).unwrap().raw()];
+    assert_eq!(meal.outcome_contact, Some(PhysicalContactKind::Consumed));
+    assert_eq!(meal.observation_count, 1);
+    assert_eq!(meal.source_sequence_id, ExperienceSequenceId(6));
+    assert!(meal.family_value[0] > 0.0);
+}
