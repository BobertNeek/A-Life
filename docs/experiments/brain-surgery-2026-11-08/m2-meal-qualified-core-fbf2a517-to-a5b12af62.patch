+        bank: &MemoryBank,
+    ) -> Result<[Option<MemoryId>; 2], ScaffoldContractError> {
+        self.transaction.validate_contract()?;
+        if self.canonical_digest != self.recompute_digest()?
+            || self.representative.canonical_digest != self.representative.recompute_digest()?
+            || self.representative.write != self.transaction.representative_projection()?
+            || self.representative.key != self.transaction.representative_key
+            || self.transaction.output_generation > bank.candidate_store.generation
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        if self.transaction.output_generation == bank.candidate_store.generation
+            && self.transaction.after_digest != bank.candidate_store.digest(bank.config.capacity)?
