+    assert_eq!(representative.family_raw, supplemental.family_raw);
+    assert_eq!(representative.tracked_object_id_raw, 62);
+    assert_eq!(supplemental.tracked_object_id_raw, 61);
+    assert_eq!(representative.outcome_contact, None);
+    assert_eq!(
+        supplemental.outcome_contact,
+        Some(PhysicalContactKind::Consumed)
+    );
+    let (event, target) = meal_sleep_source(&patch);
+    let proof = MealMemorySleepProofV1::capture(&patch, event, &target, transaction).unwrap();
+    proof.validate_against(&event, &target).unwrap();
+    assert_eq!(
