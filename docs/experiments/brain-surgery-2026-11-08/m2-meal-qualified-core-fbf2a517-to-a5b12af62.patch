+//! Explicit opt-in supplemental meal association. Never called by legacy hosts.
+//!
+//! One sealed world experience may have two indexed associations, not two
+//! physical events, optimizer steps, biology advances, or independent samples.
+use super::*;
+use crate::{DecisionEvidence, MotorChannel, PhenotypeHash, WorldEntityId};
+
+pub const MEAL_MEMORY_TRANSACTION_SCHEMA_V1: u16 = 1;
+pub const MEAL_MEMORY_POLICY_V1: &str = "m2-exact-consumed-joint-association-v1";
+
+/// Transient provenance bound to an exact selected command and finalized frame.
+/// The physiological values remain joint-context association, not Eat causality.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SupplementalMealProofV1 {
+    pub schema_version: u16,
+    pub sealed_sequence_id: ExperienceSequenceId,
+    pub query: CandidateMemoryQueryV2,
+    pub channel: MotorChannel,
+    pub target_entity: WorldEntityId,
+    pub dispatch_generation: u64,
+    pub phenotype_hash: PhenotypeHash,
+    pub frame_digest: PerceptionFrameDigest,
+    pub bundle_digest: [u64; 4],
+    pub patch_causal_digest: [u64; 4],
+    pub physical_contact: PhysicalContactKind,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MealAssociationWriteV1 {
+    pub proof: SupplementalMealProofV1,
+    pub kind: MemoryUpdateKind,
+}
+
+/// Fixed bound: the representative plus zero or one meal association. The
+/// generation/digests describe the whole transaction, never an intermediate bank.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct MealMemoryTransactionReceiptV1 {
+    pub schema_version: u16,
+    pub sealed_sequence_id: ExperienceSequenceId,
+    pub representative_key: EpisodicDecisionKeyV2,
+    pub representative: MemoryUpdateKind,
+    pub supplemental: Option<MealAssociationWriteV1>,
+    pub input_generation: u64,
+    pub output_generation: u64,
+    pub before_digest: [u64; 4],
+    pub after_digest: [u64; 4],
+    pub record_count: u32,
+    pub capacity: u32,
+    pub merge_count: u64,
+    pub eviction_count: u64,
+}
+
+impl SupplementalMealProofV1 {
+    pub fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        self.query.validate_contract()?;
+        self.sealed_sequence_id.validate()?;
+        self.target_entity.validate()?;
+        if self.schema_version != MEAL_MEMORY_TRANSACTION_SCHEMA_V1
+            || self.channel != MotorChannel::Manipulation
+            || self.query.profile().profile_id.raw() != 5
+            || self.query.action_family() != CandidateActionFamily::Ingest
+            || self.query.action_kind() != ActionKind::Interact
+            || self.query.tracked_object_id().is_none()
+            || self.physical_contact != PhysicalContactKind::Consumed
+            || self.dispatch_generation == 0
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(())
+    }
+
+    pub fn validate_against_patch(
+        &self,
+        patch: &ExperiencePatch,
+        frame: &PerceptionFrame,
+    ) -> Result<(), ScaffoldContractError> {
+        self.validate_contract()?;
+        if derive_supplemental_meal(patch, frame)?.as_ref() != Some(self) {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(())
+    }
+}
+
+fn validate_frame_binding(
+    patch: &ExperiencePatch,
+    frame: &PerceptionFrame,
+) -> Result<(), ScaffoldContractError> {
+    patch.validate_contract()?;
+    frame.validate_contract()?;
+    if frame != patch.pre_action().perception()
+        || frame.profile_provenance().identity().profile_id.raw() != 5
+        || !matches!(
+            patch.decision().evidence,
+            DecisionEvidence::NeuralClosedLoopCpu(_)
+        )
+    {
+        return Err(ScaffoldContractError::InvalidDecisionEvidence);
+    }
+    Ok(())
+}
+
+fn derive_supplemental_meal(
+    patch: &ExperiencePatch,
+    frame: &PerceptionFrame,
+) -> Result<Option<SupplementalMealProofV1>, ScaffoldContractError> {
+    validate_frame_binding(patch, frame)?;
+    let Some(bundle) = patch.selected_bundle() else {
+        return Ok(None);
+    };
+    let Some(joint) = patch.outcome().joint.as_ref() else {
+        return Ok(None);
+    };
+    // Legacy receipts can omit the whole channel list. No inference from the
+    // aggregate outcome is allowed; all selected channels need exact receipts.
+    if joint.channel_outcomes.len() != bundle.channels.len() {
+        return Ok(None);
+    }
+    let mut selected = bundle
+        .channels
+        .iter()
+        .filter(|c| c.channel == MotorChannel::Manipulation);
+    let Some(command) = selected.next() else {
+        return Ok(None);
+    };
+    if selected.next().is_some() {
+        return Ok(None);
+    }
+    let Some(binding) = command.target else {
+        return Ok(None);
+    };
+    let Some(target) = binding.entity else {
+        return Ok(None);
+    };
+    let mut candidates = frame
+        .candidates()
+        .iter()
+        .filter(|c| c.action_id == command.primitive && c.target == binding);
+    let Some(candidate) = candidates.next() else {
+        return Ok(None);
+    };
+    if candidates.next().is_some()
+        || candidate.family != CandidateActionFamily::Ingest
+        || candidate.kind != ActionKind::Interact
+    {
+        return Ok(None);
+    }
+    let query = MemoryQueryEncoderV2::encode_from_frame(frame, candidate)?;
+    if query.tracked_object_id().is_none() {
+        return Ok(None);
+    }
+    let mut matching = joint
+        .channel_outcomes
+        .iter()
+        .filter(|r| r.channel == command.channel);
+    let Some(receipt) = matching.next() else {
+        return Ok(None);
+    };
+    if matching.next().is_some()
+        || receipt.physical.contact != PhysicalContactKind::Consumed
+        || receipt.physical.target_entity != Some(target)
+    {
+        return Ok(None);
+    }
+    // Fail closed on competing biologically consequential contact. A targetless
+    // Rest or Inspect elsewhere with no physical contact does not veto the meal.
+    for sibling in &bundle.channels {
+        let mut receipts = joint
+            .channel_outcomes
+            .iter()
+            .filter(|r| r.channel == sibling.channel);
+        let Some(receipt) = receipts.next() else {
+            return Ok(None);
+        };
+        if receipts.next().is_some() {
+            return Ok(None);
+        }
+        if sibling.channel != command.channel
+            && receipt.physical.contact != PhysicalContactKind::None
+            && receipt.physical.target_entity != Some(target)
+        {
+            return Ok(None);
+        }
+    }
+    let original = patch
+        .decision()
+        .episodic_key()
+        .ok_or(ScaffoldContractError::InvalidMemoryQuery)?
+        .query();
+    if original.action_family() == CandidateActionFamily::Ingest
+        && original.action_id() == query.action_id()
+        && original.action_kind() == query.action_kind()
+        && original.tracked_object_id() == query.tracked_object_id()
+        && patch.decision().selected_action.target_entity == Some(target)
+    {
+        return Ok(None);
+    }
+    let evidence = patch.decision().neural_evidence()?;
+    let proof = SupplementalMealProofV1 {
+        schema_version: MEAL_MEMORY_TRANSACTION_SCHEMA_V1,
+        sealed_sequence_id: patch.header().sequence_id,
+        query,
+        channel: command.channel,
+        target_entity: target,
+        dispatch_generation: evidence.dispatch_generation,
+        phenotype_hash: evidence.phenotype_hash,
+        frame_digest: frame.frame_digest(),
+        bundle_digest: bundle.canonical_digest()?,
+        patch_causal_digest: patch.causal_digest()?,
+        physical_contact: receipt.physical.contact,
+    };
+    proof.validate_contract()?;
+    Ok(Some(proof))
+}
+
+pub(super) fn retained_id(kind: MemoryUpdateKind) -> Option<MemoryId> {
+    match kind {
+        MemoryUpdateKind::Inserted { inserted } | MemoryUpdateKind::Evicted { inserted, .. } => {
+            Some(inserted)
+        }
+        MemoryUpdateKind::Merged { into } => Some(into),
+        MemoryUpdateKind::IgnoredLowInformation | MemoryUpdateKind::IgnoredLowerRetention => None,
+    }
+}
+
+impl MealMemoryTransactionReceiptV1 {
+    pub fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        self.sealed_sequence_id.validate()?;
+        self.representative_key.validate_contract()?;
+        if self.schema_version != MEAL_MEMORY_TRANSACTION_SCHEMA_V1
+            || self.output_generation
+                != self
+                    .input_generation
+                    .checked_add(1)
+                    .ok_or(ScaffoldContractError::InvalidDecisionEvidence)?
+            || self.representative_key.query().profile().profile_id.raw() != 5
+            || self.capacity == 0
+            || self.record_count > self.capacity
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        if let Some(id) = retained_id(self.representative) {
+            id.validate()?;
+        }
+        if let Some(supplemental) = &self.supplemental {
+            supplemental.proof.validate_contract()?;
+            let query = &supplemental.proof.query;
+            if supplemental.proof.sealed_sequence_id != self.sealed_sequence_id
+                || query.organism_id() != self.representative_key.query().organism_id()
+                || query.profile() != self.representative_key.query().profile()
+                || query.tick() != self.representative_key.query().tick()
+                || query.base_frame_digest() != self.representative_key.query().base_frame_digest()
+                || supplemental.proof.frame_digest != self.representative_key.final_frame_digest()
+                || (retained_id(supplemental.kind).is_some()
+                    && retained_id(supplemental.kind) == retained_id(self.representative))
+            {
+                return Err(ScaffoldContractError::InvalidDecisionEvidence);
+            }
+            if let Some(id) = retained_id(supplemental.kind) {
+                id.validate()?;
+            }
+            if let MemoryUpdateKind::Evicted { removed, .. } = supplemental.kind {
+                if Some(removed) == retained_id(self.representative) {
+                    return Err(ScaffoldContractError::InvalidDecisionEvidence);
+                }
+            }
+        }
+        Ok(())
+    }
+
+    /// Exact boundary audit, including persistent digest and every retained
+    /// association ID. For later merged/evicted banks use the sleep source proof.
+    pub fn validate_committed_bank(&self, bank: &MemoryBank) -> Result<(), ScaffoldContractError> {
+        self.validate_contract()?;
+        let owner = self.representative_key.query().organism_id().raw();
+        if bank.candidate_store.generation != self.output_generation
+            || bank.candidate_store.digest(bank.config.capacity)? != self.after_digest
+            || bank.candidate_store.records.len() != self.record_count as usize
+            || bank.config.capacity != self.capacity as usize
+            || bank.candidate_store.merge_count != self.merge_count
+            || bank.candidate_store.eviction_count != self.eviction_count
+            || bank.candidate_store.last_sequence_by_organism.get(&owner)
+                != Some(&self.sealed_sequence_id.raw())
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        let validate_row = |query: &CandidateMemoryQueryV2,
+                            kind: MemoryUpdateKind,
+                            consumed: bool| {
+            if let Some(id) = retained_id(kind) {
+                let record = bank
+                    .candidate_store
+                    .records
+                    .get(&id.raw())
+                    .ok_or(ScaffoldContractError::InvalidDecisionEvidence)?;
+                let (_, family) = keys_for_query(query);
+                if record.source_sequence_id != self.sealed_sequence_id
+                    || record.last_tick != query.tick()
+                    || record.family_key().receipt() != family.receipt()
+                    || (consumed && record.outcome_contact != Some(PhysicalContactKind::Consumed))
+                {
+                    return Err(ScaffoldContractError::InvalidDecisionEvidence);
+                }
+            }
+            Ok(())
+        };
+        validate_row(self.representative_key.query(), self.representative, false)?;
+        if let Some(write) = &self.supplemental {
+            validate_row(&write.proof.query, write.kind, true)?;
+        }
+        Ok(())
+    }
+
+    /// Representative-only view of the ONE committed transaction for existing
+    /// replay code. It does not represent an independently committed first write.
+    pub fn representative_projection(&self) -> Result<MemoryUpdateReceipt, ScaffoldContractError> {
+        self.validate_contract()?;
+        let (target, family) = keys_for_query(self.representative_key.query());
+        Ok(MemoryUpdateReceipt {
+            runtime_approximate: false,
+            sealed_sequence_id: self.sealed_sequence_id,
+            organism_id_raw: self.representative_key.query().organism_id().raw(),
+            bucket: family.receipt(),
+            target_bucket: target.receipt(),
+            input_generation: self.input_generation,
+            output_generation: self.output_generation,
+            kind: self.representative,
+            record_count: self.record_count,
+            capacity: self.capacity,
+            merge_count: self.merge_count,
+            eviction_count: self.eviction_count,
+            before_digest: self.before_digest,
+            after_digest: self.after_digest,
+        })
+    }
+
+    pub fn validate_against_patch(
+        &self,
+        patch: &ExperiencePatch,
+    ) -> Result<(), ScaffoldContractError> {
+        self.validate_contract()?;
+        if patch.header().sequence_id != self.sealed_sequence_id
+            || patch.decision().episodic_key() != Some(&self.representative_key)
+            || derive_supplemental_meal(patch, patch.pre_action().perception())?
+                != self.supplemental.as_ref().map(|write| write.proof.clone())
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(())
+    }
+}
+
+impl MemoryBank {
+    /// Fresh opt-in API. Pair with `recall_frame_with_meal_v1` and
+    /// `MealMemorySleepProofV1`; ordinary/cached readers intentionally remain
+    /// legacy, even for accepted old banks containing same-sequence records.
+    /// Old writers, saved layouts and host defaults are unchanged.
+    /// All operations run in a private clone; only the final validated bank is
+    /// committed. No second call to an ordinary same-sequence writer occurs.
+    pub fn observe_sealed_patch_with_meal_v1(
+        &mut self,
+        patch: &ExperiencePatch,
+        frame: &PerceptionFrame,
+    ) -> Result<MealMemoryTransactionReceiptV1, ScaffoldContractError> {
+        let supplemental_proof = derive_supplemental_meal(patch, frame)?;
+        let mut staged = self.clone();
+        // Reuse the original representative policy exactly, including ignore,
+        // phase, merge, contradiction and retention behavior. This is staging.
+        let representative = staged.observe_sealed_patch(patch)?;
+        let supplemental = if let Some(proof) = supplemental_proof {
+            let mut record = candidate_record_from_patch(
+                MemoryId(staged.candidate_store.next_memory_id),
+                patch,
+            )?;
+            let query = &proof.query;
+            record.action_id_raw = query.action_id().raw();
+            record.action_kind_raw = query.action_kind().raw();
+            record.family_raw = u16::from(query.action_family().raw());
+            record.tracked_object_id_raw = query.tracked_object_id().unwrap().raw();
+            record.query_features = query.features().to_vec();
+            record.outcome_contact = Some(PhysicalContactKind::Consumed);
+            record.confidence = patch
+                .selected_bundle()
+                .unwrap()
+                .channels
+                .iter()
+                .find(|command| command.channel == proof.channel)
+                .unwrap()
+                .confidence
+                .raw();
+            // Joint physiological valence is retained, not reassigned channel
+            // reward. Actual physical consumption establishes contact only.
+            record.target_latent[6] = 1.0;
+            record.validate_contract()?;
+            let kind = staged.stage_supplemental_meal_record(
+                query,
+                record,
+                retained_id(representative.kind),
+            )?;
+            Some(MealAssociationWriteV1 { proof, kind })
+        } else {
+            None
+        };
+        let receipt = MealMemoryTransactionReceiptV1 {
+            schema_version: MEAL_MEMORY_TRANSACTION_SCHEMA_V1,
+            sealed_sequence_id: patch.header().sequence_id,
+            representative_key: patch.decision().episodic_key().unwrap().clone(),
+            representative: representative.kind,
+            supplemental,
+            input_generation: representative.input_generation,
+            output_generation: representative.output_generation,
+            before_digest: representative.before_digest,
+            after_digest: staged.candidate_store.digest(staged.config.capacity)?,
+            record_count: u32::try_from(staged.candidate_store.records.len())
+                .map_err(|_| ScaffoldContractError::ScalarOutOfRange)?,
+            capacity: representative.capacity,
+            merge_count: staged.candidate_store.merge_count,
+            eviction_count: staged.candidate_store.eviction_count,
+        };
+        receipt.validate_against_patch(patch)?;
+        receipt.validate_committed_bank(&staged)?;
+        // Rebuild-derived equality catches a stale index before committing any
+        // state. The persistent digest validates every record and source bound.
+        let mut reindexed = staged.candidate_store.clone();
+        reindexed.rebuild_indices();
+        if reindexed != staged.candidate_store {
+            return Err(ScaffoldContractError::InvalidMemoryQuery);
+        }
+        *self = staged;
+        Ok(receipt)
+    }
+
+    fn stage_supplemental_meal_record(
+        &mut self,
+        query: &CandidateMemoryQueryV2,
+        candidate_record: CandidateMemoryRecordV2,
+        protected: Option<MemoryId>,
+    ) -> Result<MemoryUpdateKind, ScaffoldContractError> {
+        let (_, family_key) = keys_for_query(query);
+        let mut merge_id = None;
+        let mut contradiction_id = None;
+        for id in self
+            .candidate_store
+            .family_index
+            .get(&(family_key.clone(), candidate_record.outcome_scope_key()))
+            .into_iter()
+            .flatten()
+            .take(MEMORY_FAMILY_SEARCH_CAP)
+        {
+            if Some(*id) == protected {
+                continue;
+            }
+            let record = &self.candidate_store.records[&id.raw()];
+            if record.identity() != candidate_record.identity()
+                || !record.same_outcome_scope(&candidate_record)
+                || family_similarity(&candidate_record.query_features, &record.query_features)
+                    < MEMORY_MERGE_SIMILARITY
+            {
+                continue;
+            }
+            let selected = if compatible_memory_outcomes(record, &candidate_record) {
+                &mut merge_id
+            } else {
+                &mut contradiction_id
+            };
+            if selected.is_none_or(|previous: MemoryId| id.raw() < previous.raw()) {
+                *selected = Some(*id);
+            }
+        }
+        // Identical existing consumed-vs-legacy-unknown safeguard. Preparation
+        // cannot enter this helper or gain consumed replacement privileges.
+        for id in self
+            .candidate_store
+            .family_index
+            .get(&(family_key, 0))
+            .into_iter()
+            .flatten()
+            .take(MEMORY_FAMILY_SEARCH_CAP)
+        {
+            if Some(*id) != protected
+                && candidate_record
+                    .consumption_supersedes_unknown(&self.candidate_store.records[&id.raw()])
+                && contradiction_id.is_none_or(|previous: MemoryId| id.raw() < previous.raw())
+            {
+                contradiction_id = Some(*id);
+            }
+        }
+        if let Some(into) = merge_id {
+            let old = self.candidate_store.records[&into.raw()].clone();
+            let merged = merge_candidate_records(&old, &candidate_record)?;
+            let count = self
+                .candidate_store
+                .merge_count
+                .checked_add(1)
+                .ok_or(ScaffoldContractError::ScalarOutOfRange)?;
+            self.candidate_store.remove_record_from_indices(&old);
+            self.candidate_store.records.insert(into.raw(), merged);
+            self.candidate_store.insert_record_into_indices(into);
+            self.candidate_store.merge_count = count;
+            // No retrieval corroboration boost: the representative's recalled
+            // family cannot impersonate the selected meal candidate's evidence.
+            return Ok(MemoryUpdateKind::Merged { into });
+        }
+        let inserted = candidate_record.memory_id;
+        let next = self
+            .candidate_store
+            .next_memory_id
+            .checked_add(1)
+            .ok_or(ScaffoldContractError::ScalarOutOfRange)?;
+        let removed = if self.candidate_store.records.len() == self.config.capacity {
+            let chosen = contradiction_id
+                .and_then(|id| self.candidate_store.records.get(&id.raw()))
+                .or_else(|| {
+                    self.candidate_store
+                        .records
+                        .values()
+                        .filter(|record| Some(record.memory_id) != protected)
+                        .min_by_key(|record| {
+                            (
+                                retention_priority(record, query.tick()),
+                                record.last_tick.raw(),
+                                record.memory_id.raw(),
+                            )
+                        })
+                });
+            let Some(chosen) = chosen else {
+                return Ok(MemoryUpdateKind::IgnoredLowerRetention);
+            };
+            if contradiction_id != Some(chosen.memory_id)
+                && retention_priority(&candidate_record, query.tick())
+                    < retention_priority(chosen, query.tick())
+            {
+                return Ok(MemoryUpdateKind::IgnoredLowerRetention);
+            }
+            Some(chosen.clone())
+        } else {
+            None
+        };
+        let kind = if let Some(removed) = removed {
+            let count = self
+                .candidate_store
+                .eviction_count
+                .checked_add(1)
+                .ok_or(ScaffoldContractError::ScalarOutOfRange)?;
+            self.candidate_store.remove_record_from_indices(&removed);
+            self.candidate_store
+                .records
+                .remove(&removed.memory_id.raw());
+            self.candidate_store.eviction_count = count;
+            MemoryUpdateKind::Evicted {
+                removed: removed.memory_id,
+                inserted,
+            }
+        } else {
+            MemoryUpdateKind::Inserted { inserted }
+        };
+        self.candidate_store
+            .records
+            .insert(inserted.raw(), candidate_record);
+        self.candidate_store.insert_record_into_indices(inserted);
+        self.candidate_store.next_memory_id = next;
+        Ok(kind)
+    }
+}
