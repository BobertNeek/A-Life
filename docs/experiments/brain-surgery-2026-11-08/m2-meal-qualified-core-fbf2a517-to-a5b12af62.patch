+            frame_digest: key.final_frame_digest(),
+            candidate_feature_digest: query.candidate_feature_digest(),
+            action_id: query.action_id(),
+            family: query.action_family(),
+            modulator: NeuromodulatorSample::from_components(0.4, 0.1, 0.2, 0.0, 0.3).unwrap(),
+        },
+        patch.prediction_target().unwrap().clone(),
+    )
