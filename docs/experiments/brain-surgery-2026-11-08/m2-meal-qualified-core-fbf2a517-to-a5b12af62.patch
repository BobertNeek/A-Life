+#[test]
+fn meal_sleep_merged_interior_sources_do_not_create_extra_replay_events() {
+    assert_positive_meal_control();
+    let mut b = bank(8);
+    let mut proofs = Vec::new();
+    let mut targets = Vec::new();
+    let mut journal =
+        SleepReplayJournal::new(ReplayCapturePlan::try_new(vec![3], 1, 3, 3).unwrap()).unwrap();
+    for sequence in 1..=3 {
+        let (patch, frame) = fixture(sequence, Case::default()).unwrap();
+        let transaction = b.observe_sealed_patch_with_meal_v1(&patch, &frame).unwrap();
+        let (event, target) = meal_sleep_source(&patch);
+        proofs.push(MealMemorySleepProofV1::capture(&patch, event, &target, transaction).unwrap());
+        journal.push(event, &[0.75]).unwrap();
+        targets.push(target);
+    }
+    let first = proofs[0].resolve_associations(&b).unwrap();
+    assert!(first.iter().all(Option::is_some));
+    assert_ne!(first[0], first[1]);
+    assert_eq!(proofs[1].resolve_associations(&b).unwrap(), [None, None]);
+    assert_eq!(proofs[2].resolve_associations(&b).unwrap(), first);
+    let evidence = crate::sleep::SleepReplayEvidence::new(
+        journal.build_bounded_batch(3, 3, u32::MAX).unwrap(),
+        targets,
+    )
+    .unwrap();
+    assert_eq!(evidence.batch.events.len(), 3);
+    assert_eq!(evidence.prediction_targets.len(), 3);
+    let original = evidence.clone();
+    let digest = sleep_meal_memory_replay_digest_v1(&evidence, &proofs).unwrap();
+    assert_ne!(digest, evidence.canonical_digest);
+    assert_eq!(
+        evidence, original,
+        "association audit does not expand physical replay"
+    );
+    let mut duplicated = proofs.clone();
+    duplicated.push(proofs[0].clone());
+    assert!(sleep_meal_memory_replay_digest_v1(&evidence, &duplicated).is_err());
+    let mut reversed = proofs;
+    reversed.swap(0, 2);
+    assert!(sleep_meal_memory_replay_digest_v1(&evidence, &reversed).is_err());
+}
