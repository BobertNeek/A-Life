+#[cfg(test)]
+mod projection_tests {
+    use super::*;
+    // Deliberately synthetic JSON, not a usable host/world/seed/checkpoint.
+    // Tests exercise the projection boundary only; typed loader validation is
+    // a separate required caller obligation.
+    fn packet(optional: bool) -> Vec<u8> {
+        let mut value = serde_json::json!({
+            "schema_version": 1,
+            "source_lineage": if optional { OPTIONAL_LINEAGE } else { LEGACY_LINEAGE },
+            "policy": if optional { OPTIONAL_POLICY } else { LEGACY_POLICY },
+            "mode": "Full",
+            "source_inputs": {"synthetic_source": [7, 9]},
+            "source_asset": {"weights": [11]},
+            "founder": {"optimizer": {"ages": [9007199254740993u64], "moments": [0]}},
+            "canonical": {
+                "schema_version": if optional { 0x4f56u32 } else { 2 },
+                "sampling_seed": 42, "sampling_counter": 0,
+                "tracked_objects": [{"id": 3, "position": [1, 2]}],
+                "residents": [{"neural": {
+                    "schema_version": if optional { 0x4f56_0001u32 } else { 2 },
+                    "organism_id": 7, "neural": {"activations": [0, 1], "dendrites": [2]},
+                    "inactive_activations": [0], "eligibility": [0], "dispatch_generation": 0
+                }, "memory": [4], "sleep": {"clock": 8}}],
+                "world": {"world": {"tick": 10, "rng": [5, 6], "scene": [{"id": 3}],
+                    "organism_records": [{"body": {"chemicals": [4, 5]},
+                        "state_graph": {"brain": {"content_digest": if optional { 20 } else { 10 }, "other": 17}}}]
+                }}
+            },
+            "controllers": {"7": {"motor": {"mode": "Full", "source_hash": [8], "last_receipt": null},
+                "last_action": null, "memory_proofs": []}},
+            "sampler_bits": {"7": {"ordinary": null, "group": null, "operations": null, "action": null}}
+        });
+        if optional {
+            value["controllers"]["7"]["optional_vocal"] =
+                serde_json::json!({"schema": OPTIONAL_OWNER, "last": null});
+        }
+        let mut result = if optional { OPTIONAL_MAGIC } else { MAGIC }.to_vec();
+        result.extend(serde_json::to_vec(&value).unwrap());
+        result
+    }
+    fn edit(optional: bool, pointer: &str, value: serde_json::Value) -> Vec<u8> {
+        let bytes = packet(optional);
+        let mut json: serde_json::Value =
+            serde_json::from_slice(payload(&bytes).unwrap().0).unwrap();
+        *json.pointer_mut(pointer).unwrap() = value;
+        let mut result = if optional { OPTIONAL_MAGIC } else { MAGIC }.to_vec();
+        result.extend(serde_json::to_vec(&json).unwrap());
+        result
+    }
+    fn projection(bytes: &[u8], optional: bool) -> Result<Vec<u8>> {
+        matched_initial(
+            bytes,
+            if optional {
+                "OptionalVocalM2/Full"
+            } else {
+                "LegacyGroupedM2/Full"
+            },
+        )
+    }
+    #[test]
+    fn exact_known_policy_differences_compare_equal() {
+        assert_eq!(
+            projection(&packet(false), false).unwrap(),
+            projection(&packet(true), true).unwrap()
+        );
+    }
+    #[test]
+    fn every_retained_bank_is_compared() {
+        let expected = projection(&packet(false), false).unwrap();
+        for pointer in [
+            "/canonical/world/world/organism_records/0/body/chemicals/1",
+            "/canonical/world/world/rng/0",
+            "/canonical/world/world/tick",
+            "/canonical/sampling_counter",
+            "/canonical/tracked_objects/0/position/0",
+            "/canonical/world/world/scene/0/id",
+            "/founder/optimizer/ages/0",
+            "/founder/optimizer/moments/0",
+            "/canonical/residents/0/neural/neural/activations/1",
+            "/canonical/residents/0/neural/neural/dendrites/0",
+            "/canonical/residents/0/neural/inactive_activations/0",
+            "/canonical/residents/0/neural/eligibility/0",
+            "/canonical/residents/0/memory/0",
+            "/canonical/residents/0/sleep/clock",
+            "/controllers/7/motor/source_hash/0",
+            "/controllers/7/memory_proofs",
+            "/source_inputs/synthetic_source/0",
+            "/source_asset/weights/0",
+            "/sampler_bits/7/ordinary",
+            "/canonical/world/world/organism_records/0/state_graph/brain/other",
+        ] {
+            assert_ne!(
+                expected,
+                projection(&edit(true, pointer, serde_json::json!(99)), true).unwrap(),
+                "{pointer}"
+            );
