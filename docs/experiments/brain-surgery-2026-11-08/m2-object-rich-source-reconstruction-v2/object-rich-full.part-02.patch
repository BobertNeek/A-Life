+    }
+    #[test]
+    fn owner_schema_and_optional_state_are_not_wildcards() {
+        for pointer in [
+            "/source_lineage",
+            "/policy",
+            "/mode",
+            "/controllers/7/motor/mode",
+            "/controllers/7/optional_vocal/schema",
+        ] {
+            assert!(projection(&edit(true, pointer, serde_json::json!("unknown")), true).is_err());
+        }
+        for pointer in [
+            "/schema_version",
+            "/canonical/schema_version",
+            "/canonical/residents/0/neural/schema_version",
+            "/canonical/residents/0/neural/organism_id",
+        ] {
+            assert!(projection(&edit(true, pointer, serde_json::json!(999)), true).is_err());
+        }
+        for marker in [
+            serde_json::json!(null),
+            serde_json::json!({"schema": OPTIONAL_OWNER}),
+            serde_json::json!({"schema": OPTIONAL_OWNER, "last": {"state": 1}}),
+            serde_json::json!({"schema": OPTIONAL_OWNER, "last": null, "extra_schema": 1}),
+        ] {
+            assert!(
+                projection(&edit(true, "/controllers/7/optional_vocal", marker), true).is_err()
+            );
+        }
+        // Legacy cannot carry even a null optional field; optional cannot omit it.
+        assert!(projection(
+            &edit(
+                false,
+                "/controllers/7",
+                serde_json::json!({
+                    "motor": {"mode": "Full"}, "optional_vocal": null
+                })
+            ),
+            false
+        )
+        .is_err());
+        assert!(projection(
+            &edit(
+                true,
+                "/controllers/7",
+                serde_json::json!({
+                    "motor": {"mode": "Full"}
+                })
+            ),
+            true
+        )
+        .is_err());
+        assert!(matched_initial(&packet(false), "Full").is_err());
+        assert!(projection(&packet(true), false).is_err());
+        assert!(projection(&packet(false), true).is_err());
+    }
+    #[test]
+    fn unrecognized_schema_fields_are_retained_not_exempted() {
+        let original = packet(true);
+        let mut value: serde_json::Value =
+            serde_json::from_slice(payload(&original).unwrap().0).unwrap();
+        value["canonical"]["extra_schema"] = serde_json::json!(1);
+        value["controllers"]["7"]["motor"]["schema_version"] = serde_json::json!(27);
+        let mut changed = OPTIONAL_MAGIC.to_vec();
+        changed.extend(serde_json::to_vec(&value).unwrap());
+        assert_ne!(
+            projection(&original, true).unwrap(),
+            projection(&changed, true).unwrap()
+        );
+    }
+    #[test]
+    fn exact_decimal_tokens_and_array_order_survive() {
+        // Tokens that a float round trip could conflate remain distinct.
+        let original = String::from_utf8(packet(true)).unwrap();
+        for token in ["1.00000000000000001", "1.00000000000000002", "-0.0"] {
+            let changed = original.replace("9007199254740993", token);
+            assert_ne!(
+                projection(original.as_bytes(), true).unwrap(),
+                projection(changed.as_bytes(), true).unwrap()
+            );
+        }
+        let a = original.replace("9007199254740993", "1.00000000000000001");
+        let b = original.replace("9007199254740993", "1.00000000000000002");
+        assert_ne!(
+            projection(a.as_bytes(), true).unwrap(),
+            projection(b.as_bytes(), true).unwrap()
+        );
+        assert_ne!(
+            projection(&packet(true), true).unwrap(),
+            projection(
+                &edit(
+                    true,
+                    "/canonical/world/world/rng",
+                    serde_json::json!([6, 5])
+                ),
+                true
+            )
+            .unwrap()
+        );
+        assert_ne!(
+            projection(&packet(true), true).unwrap(),
+            projection(
+                &edit(
+                    true,
+                    "/canonical/world/world/rng",
+                    serde_json::json!([5, 6, 0])
+                ),
+                true
+            )
+            .unwrap()
+        );
+    }
+}
