+    assert!(CpuCanonicalHost::from_grounded_drive_research_checkpoint(
+        envelope,
+        &host.inner.founder
+    )
+    .is_err());
+    assert_eq!(host.checkpoint().unwrap().encode().unwrap(), wire);
