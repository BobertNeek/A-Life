+        value["weights"][0] = (value["weights"][0].as_f64().unwrap() + 0.25).into();
+        bad.payload.source_asset = serde_json::from_value(value).unwrap();
+        assert!(CpuGroupedM2HostV1::restore(bad, &inputs, MediationModeV1::Full).is_err());
+        let mut bad = checkpoint.clone();
+        if empty {
+            for controller in bad.payload.controllers.values_mut() {
+                controller.motor.clear_validation_cache();
+            }
