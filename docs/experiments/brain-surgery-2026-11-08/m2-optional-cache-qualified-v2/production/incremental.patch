+    let mut value: serde_json::Value = serde_json::from_slice(&source_wire).unwrap();
+    fn positive_zero_path(value: &serde_json::Value, path: &str) -> Option<String> {
+        match value {
+            serde_json::Value::Number(n) if n.is_f64() && n.as_f64().unwrap().to_bits() == 0 => {
+                Some(path.into())
+            }
+            serde_json::Value::Array(values) => values
+                .iter()
+                .enumerate()
+                .find_map(|(i, value)| positive_zero_path(value, &format!("{path}/{i}"))),
+            serde_json::Value::Object(values) => values.iter().find_map(|(key, value)| {
+                let key = key.replace('~', "~0").replace('/', "~1");
+                positive_zero_path(value, &format!("{path}/{key}"))
+            }),
+            _ => None,
+        }
+    }
+    let path = positive_zero_path(&value, "").expect("fixed source contains a positive zero float");
