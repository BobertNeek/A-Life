+#[test]
+fn grouped_cache_identity_distinguishes_exact_bits_and_complete_lengths() {
+    for bits in [0, 0x8000_0000, 1, 0x007f_ffff, 0x3f80_0000, 0x3f80_0001] {
+        let value = f32::from_bits(bits);
+        let identity = ExactIdentity::capture(&value).unwrap();
+        identity.check(&value).unwrap();
+        assert!(identity.check(&f32::from_bits(bits ^ 1)).is_err());
+        assert!(identity.check(&f32::NAN).is_err());
+        assert!(identity.check(&f32::INFINITY).is_err());
+    }
+    assert_eq!(0_f32, -0_f32); // PartialEq would accept this changed binding.
+    assert!(ExactIdentity::capture(&0_f32)
+        .unwrap()
+        .check(&-0_f32)
+        .is_err());
+    assert!(ExactIdentity::capture(&0_f64)
+        .unwrap()
+        .check(&-0_f64)
+        .is_err());
+    let identity = ExactIdentity::capture(&vec![1_u64, 2]).unwrap();
+    assert!(identity.check(&vec![1_u64]).is_err());
+    assert!(identity.check(&vec![1_u64, 2, 3]).is_err());
+    assert!(identity.check(&vec![2_u64, 1]).is_err());
