+//! Source-only successor: cache compiler output, never source validation.
+use super::*;
+#[cfg(test)]
+use serde::ser::SerializeSeq;
+use std::io::{self, Write};
+
+// BrainGenome omits innate_priority when all genes compare equal to zero.
+// Include the raw genes so their -0 bits cannot disappear from the compiler
+// input key. Other skips reachable from admitted inputs are Options only.
+// The source phenotype is deliberately NOT a cache key or validation proof.
+pub(super) fn input_identity(inputs: &PhenotypeCompilerInputs) -> impl Serialize + '_ {
+    (inputs, &inputs.genome().innate_priority)
+}
+#[cfg(test)]
+struct DecoderGainBits<'a>(&'a [CandidateDecoderFamilyPlan]);
+#[cfg(test)]
+impl Serialize for DecoderGainBits<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut seq = serializer.serialize_seq(Some(self.0.len()))?;
+        for family in self.0 {
+            seq.serialize_element(&family.innate_gain().to_bits())?;
+        }
+        seq.end()
+    }
+}
+/// In-memory comparison encoding only, NOT the checkpoint wire format. Every
+/// finite float is emitted as a tagged exact IEEE bit string, including -0.
+/// No digest collision or PartialEq float equivalence can authorize a hit.
+/// Nonfinite values serialize as null and cannot match a validated float.
+struct FloatBits;
+impl serde_json::ser::Formatter for FloatBits {
+    fn write_f32<W: ?Sized + Write>(&mut self, out: &mut W, value: f32) -> io::Result<()> {
+        write!(out, "\"f32:{:08x}\"", value.to_bits())
+    }
+    fn write_f64<W: ?Sized + Write>(&mut self, out: &mut W, value: f64) -> io::Result<()> {
+        write!(out, "\"f64:{:016x}\"", value.to_bits())
+    }
+}
+
+pub(super) struct ExactIdentity(Vec<u8>);
+impl ExactIdentity {
+    pub(super) fn capture<T: Serialize>(value: &T) -> Result<Self, TrainingError> {
+        let mut bytes = Vec::new();
+        value
+            .serialize(&mut serde_json::Serializer::with_formatter(
+                &mut bytes, FloatBits,
+            ))
+            .map_err(|_| invalid())?;
+        Ok(Self(bytes))
+    }
+    pub(super) fn check<T: Serialize>(&self, value: &T) -> Result<(), TrainingError> {
+        let mut comparator = CompareBytes { remaining: &self.0 };
+        value
+            .serialize(&mut serde_json::Serializer::with_formatter(
+                &mut comparator,
+                FloatBits,
+            ))
+            .map_err(|_| invalid())?;
+        if !comparator.remaining.is_empty() {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
+struct CompareBytes<'a> {
+    remaining: &'a [u8],
+}
+impl Write for CompareBytes<'_> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.remaining = self.remaining.strip_prefix(bytes).ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                "grouped immutable identity differs",
+            )
+        })?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+
+/// One immutable compiler output and pinned recipe set per controller. Only the
+/// compiler-input identity is memoized. Every call still compares the actual
+/// current source against the expected typed phenotype with the original guards.
+pub(super) struct CachedGroupedCompilation {
+    binding: ExactIdentity,
+    expected: BrainPhenotype,
+    pub(super) core: Lowered,
+    pub(super) group: GroupRecipe,
+}
+impl std::fmt::Debug for CachedGroupedCompilation {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("CachedGroupedCompilation")
+            .field("binding_bytes", &self.binding.0.len())
+            .field("expected_neurons", &self.expected.neuron_count())
+            .field("expected_synapses", &self.expected.synapses().len())
+            .finish_non_exhaustive()
+    }
+}
+impl CachedGroupedCompilation {
+    pub(super) fn compile(inputs: &PhenotypeCompilerInputs) -> Result<Self, TrainingError> {
+        #[cfg(test)]
+        COMPILE_ATTEMPTS.with(|count| count.set(count.get() + 1));
+        let expected = PhenotypeCompiler::compile_validated(
+            inputs,
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+        )?;
+        Ok(Self {
+            binding: ExactIdentity::capture(&input_identity(inputs))?,
+            expected,
+            core: Lowered::pinned(MANIFEST)?,
+            group: GroupedMotorStateV1::group_recipe()?,
+        })
+    }
+    pub(super) fn matches_inputs(&self, inputs: &PhenotypeCompilerInputs) -> bool {
+        self.binding.check(&input_identity(inputs)).is_ok()
+    }
+    pub(super) fn validate_source(
+        &self,
+        state: &GroupedMotorStateV1,
+        source: &BrainPhenotype,
+    ) -> Result<(), TrainingError> {
+        // This is the original direct source comparison and fixed admission,
+        // not a cached claim about the supplied phenotype. Signed-zero behavior
+        // remains the original contract. No full-source serialization is used.
+        if state.schema != HOST_SCHEMA
+            || state.work_policy != GROUPED_HOST_WORK_POLICY_V1
+            || state.m2_recipe != M2_RECIPE_SHA256
+            || state.group_recipe != RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256
+            || state.mode == MediationModeV1::DirectSource
+            || self.expected != *source
+            || state.source_hash != source.phenotype_hash()
+            || source.neuron_count() != 2048
+            || source.synapses().len() != 34048
+            || source.foundation_abi().motor_lobe_m0().is_some()
+            || !source
+                .candidate_decoder()
+                .factorized_motor_channels(source)?
+                .contains(&MotorChannel::Posture)
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+thread_local! {
+    // Test-thread local, counts only this cache's compiler calls, not other
+    // required admission/restore compilers. Never serialized or production.
+    static COMPILE_ATTEMPTS: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
