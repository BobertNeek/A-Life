+//! Candidate-only tests; no run has been authorized by adding this source.
+use super::*;
+use sha2::{Digest, Sha256};
+
+fn clear(host: &mut CpuGroupedM2HostV1) {
+    for resident in host.host.residents.values_mut() {
+        resident
+            .grouped
+            .as_mut()
+            .unwrap()
+            .motor
+            .clear_validation_cache();
+    }
+}
+fn all_warm(host: &CpuGroupedM2HostV1) -> bool {
+    host.host.residents.values().all(|resident| {
+        resident
+            .grouped
+            .as_ref()
+            .unwrap()
+            .motor
+            .validation_cache_is_warm()
+    })
+}
+fn witness(wire: &[u8], len: usize, sha: &str) {
+    assert_eq!(wire.len(), len);
+    assert_eq!(format!("{:x}", Sha256::digest(wire)), sha);
+}
+fn decision_bytes(step: &CpuGroupedM2HostStepV1) -> Vec<u8> {
+    bytes(&(
+        step.tick_before,
+        step.tick_after,
+        step.sleeping_organisms,
+        step.sleep_consolidations,
+        step.decisions
+            .iter()
+            .map(|d| {
+                (
+                    d.organism_id,
+                    &d.action,
+                    d.sampling_counter,
+                    &d.source_diagnostic_logits,
+                    &d.biological_emissions,
+                    &d.brain_work,
+                    &d.patch,
+                    &d.motor,
+                    &d.physical,
+                    d.sleep_phase,
+                    d.sleep_trigger,
+                )
+            })
+            .collect::<Vec<_>>(),
+    ))
+}
+
+#[test]
+fn grouped_cache_exact_five_file_baseline_witness_and_restore_counts() {
+    let start = GroupedMotorStateV1::validation_compile_count();
+    let (mut host, inputs) = fixture(240);
+    assert!(all_warm(&host));
+    assert_eq!(GroupedMotorStateV1::validation_compile_count(), start + 1);
+    let initial = host.checkpoint().unwrap().encode().unwrap();
+    witness(
+        &initial,
+        2_253_590,
+        "fe6385e4406ce7e99cbc992d4fbde3d44805835992ea9ad07c02a2c3dc6b8594",
+    );
+    let expected = [
+        (
+            51_263,
+            "516d1776531106ba2368242894b1816799e41a84d2e0d54cbbe2c019632e131e",
+            2_375_809,
+            "25b61a7550b424a8391c12960ce3b77a3c22b8ad5013cfe2daf8608bce6e56cf",
+        ),
+        (
+            53_031,
+            "f8f48d90074f7463c96787074b0b4ac66c814153b70f5dbcc5e16845ffa36275",
+            2_383_183,
+            "cde1d9c9a853402a9af2cf955b359c6d24c3ef34fed7926cd917b0e1f2e30d5c",
+        ),
+    ];
+    let mut total = initial.len();
+    for (index, temperature) in [0.73_f32, 1.17].into_iter().enumerate() {
+        let count = GroupedMotorStateV1::validation_compile_count();
+        let step = host.step(temperature).unwrap();
+        let decision = decision_bytes(&step);
+        let checkpoint = host.checkpoint().unwrap();
+        let wire = checkpoint.encode().unwrap();
+        let (decision_len, decision_sha, wire_len, wire_sha) = expected[index];
+        witness(&decision, decision_len, decision_sha);
+        witness(&wire, wire_len, wire_sha);
+        total += decision.len() + wire.len();
+        assert_eq!(GroupedMotorStateV1::validation_compile_count(), count);
+        let decoded = decode_exact(&checkpoint);
+        assert!(decoded
+            .payload
+            .controllers
+            .values()
+            .all(|c| !c.motor.validation_cache_is_warm()));
+        for candidate in [checkpoint, decoded] {
+            let before = GroupedMotorStateV1::validation_compile_count();
+            let restored =
+                CpuGroupedM2HostV1::restore(candidate, &inputs, MediationModeV1::Full).unwrap();
+            assert!(all_warm(&restored));
+            assert_eq!(GroupedMotorStateV1::validation_compile_count(), before + 1);
+            assert_eq!(restored.checkpoint().unwrap().encode().unwrap(), wire);
+            assert_eq!(GroupedMotorStateV1::validation_compile_count(), before + 1);
+        }
+    }
+    assert_eq!(total, 7_116_876);
+}
