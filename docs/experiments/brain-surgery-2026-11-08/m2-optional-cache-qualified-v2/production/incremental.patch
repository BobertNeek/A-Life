+#[test]
+fn grouped_cache_seals_nonzero_banks_body_and_rollback_are_unchanged() {
+    let (mut host, inputs) = fixture(240);
+    host.step(0.73).unwrap();
+    inject_frozen_sentinels(&mut host);
+    let acquired = frozen(&host);
+    let original = host.checkpoint().unwrap();
+    let wire = original.encode().unwrap();
+    let world = bytes(&original.payload.canonical.world);
+    let seals = host
+        .host
+        .residents
+        .values()
+        .map(|r| resident_digest(r, host.host.sampling_seed, host.host.sampling_counter).unwrap())
+        .collect::<Vec<_>>();
+    assert!(all_warm(&host));
+    clear(&mut host);
+    for (r, seal) in host.host.residents.values().zip(&seals) {
+        assert_eq!(
+            &resident_digest(r, host.host.sampling_seed, host.host.sampling_counter).unwrap(),
+            seal
+        );
+    }
+    let count = GroupedMotorStateV1::validation_compile_count();
+    let captured = host.checkpoint().unwrap();
+    assert_eq!(GroupedMotorStateV1::validation_compile_count(), count + 1);
+    assert_eq!(captured.encode().unwrap(), wire);
+    assert_eq!(bytes(&captured.payload.canonical.world), world);
+    assert_eq!(frozen(&host), acquired);
+    for empty in [false, true] {
+        if empty {
+            clear(&mut host);
+        }
+        assert!(host.step(f32::NAN).is_err());
+        assert_eq!(host.checkpoint().unwrap().encode().unwrap(), wire);
+        assert_eq!(frozen(&host), acquired);
+    }
+    let mut cold =
+        CpuGroupedM2HostV1::restore(decode_exact(&original), &inputs, MediationModeV1::Full)
+            .unwrap();
+    let a = host.step(0.73).unwrap();
+    let b = cold.step(0.73).unwrap();
+    assert_eq!(decision_bytes(&a), decision_bytes(&b));
+    assert_eq!(frozen(&host), acquired);
+    assert_eq!(frozen(&cold), acquired);
+    assert_eq!(
+        host.checkpoint().unwrap().encode().unwrap(),
+        cold.checkpoint().unwrap().encode().unwrap()
+    );
+}
