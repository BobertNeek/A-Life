+//! Explicit administrative compatibility prototype, NOT a new neural lobe.
+//! The native recovery-group score supplies demand. Fixed actuator prediction
+//! and a bounded raw-homeostatic escape gate supply a soft compatibility feature.
+//! No post-sample edits, world-truth queries, or acquired-state migration.
+use super::coordination::logsumexp;
+use super::*;
+
+pub const RECOVERY_MOTION_WEIGHT_V1: f64 = -2.;
+pub const RECOVERY_MOTION_FEATURE_V1: &str =
+    "sigmoid-native-group*predicted-motion*recovery*(1-positive-fear-pain)/v1";
+
+#[derive(Debug, Clone, Serialize)]
+pub struct RecoveryPostureFactorV1 {
+    pub locomotion: CoordinatedTargetChoiceV1,
+    pub factor: CoordinatedTargetFactorV1,
+    pub features: Vec<f64>,
+    pub log_partition: f64,
+}
+/// Selected administrative event counters for one distribution construction.
+/// Includes geometric partitions, but not all scalar arithmetic, cache lookup,
+/// allocation, validation, or repeated calls from sample/evaluate. These counters
+/// neither bill body ATP nor imply equal total compute.
+#[derive(Debug, Clone, Default, Serialize)]
+pub struct RecoveryPartitionWorkV1 {
+    pub geometry_feature_evaluations: u64,
+    pub geometry_energy_products: u64,
+    pub posture_feature_evaluations: u64,
+    pub pair_reweights: u64,
+    pub representative_reweights: u64,
+    pub logsumexp_terms: u64,
+    pub exponentials: u64,
+}
+
+fn compatibility(group: f64, fear: f64, pain: f64, motion: f64, recovery: bool) -> f64 {
+    if !recovery {
+        return 0.;
+    }
+    let need = if group >= 0. {
+        1. / (1. + (-group).exp())
+    } else {
+        let e = group.exp();
+        e / (1. + e)
+    };
+    // References match the pinned M2 raw drive references, not a claim that
+    // these are native opponent activations. At maximal fear/pain the extra
+    // recovery constraint vanishes. It never adds a hard escape mask.
+    let escape = ((fear - 0.25) / 0.75)
+        .clamp(0., 1.)
+        .max(((pain - 0.10) / 0.90).clamp(0., 1.));
+    need * motion.clamp(0., 1.) * (1. - escape)
+}
+
+impl CoordinatedTargetScoresV1 {
+    fn predicted_motion(&self, choice: CoordinatedTargetChoiceV1) -> Result<f64, TrainingError> {
+        let CoordinatedTargetChoiceV1::Candidate(i) = choice else {
+            return Ok(0.);
+        };
+        let c = self
+            .coordination_frame
+            .candidates()
+            .get(i as usize)
+            .ok_or_else(invalid)?;
+        // No-target locomotion (the ordinary stationary primitive) is not an
+        // observed-object translation. Do not infer translation from family alone.
+        let CandidateObservationRef::ObjectSlot(index) = c.observation else {
+            return Ok(0.);
+        };
+        let slot = self
+            .coordination_frame
+            .grounded_object_slots()
+            .iter()
+            .find(|s| s.slot_index == index)
+            .ok_or_else(invalid)?;
+        if slot.candidate_features()? != c.features {
+            return Err(invalid());
+        }
+        let confidence = f64::from(slot.confidence.raw().min(c.sensor_confidence.raw()));
+        if f64::from(slot.bearing[0]).hypot(f64::from(slot.bearing[1])) < 0.5 {
+            return Ok(0.);
+        }
+        let step_fraction = match c.family {
+            CandidateActionFamily::Approach => (f64::from(slot.distance) * 8. / 0.1).clamp(0., 1.),
+            CandidateActionFamily::Avoid => 1.,
+            _ => 0.,
+        };
+        Ok(confidence * step_fraction)
+    }
+
+    /// Exact star partition. First use the unchanged geometric L/M factor,
+    /// then integrate Z_posture(L,r), reweight L/M, and reweight representative.
+    /// This equals one Gibbs normalization of the original complete joint law.
+    /// Operation logits remain conditional: the feature applies equally to both
+    /// physical recovery operations, whose normalized mass therefore sums to 1.
+    pub(super) fn coordinate_recovery(
+        &self,
+        representative: &mut CoordinatedTargetFactorV1,
+        channels: &[Option<CoordinatedTargetFactorV1>; 6],
+        t: f64,
+        geometry_weights: [f64; 3],
+        recovery_weight: f64,
+    ) -> Result<
+        (
+            Vec<CoordinationPairFactorV1>,
+            [f64; 3],
+            f64,
+            RecoveryPartitionWorkV1,
+        ),
+        TrainingError,
+    > {
+        if !recovery_weight.is_finite() || recovery_weight.abs() > 32. {
+            return Err(invalid());
+        }
+        let (mut pairs, _) = self.coordinate(representative, channels, t, geometry_weights)?;
+        let geometric_pairs = pairs.iter().map(|p| p.outcomes.len() as u64).sum::<u64>();
+        let mut work = RecoveryPartitionWorkV1 {
+            geometry_feature_evaluations: geometric_pairs,
+            geometry_energy_products: 3 * geometric_pairs,
+            logsumexp_terms: geometric_pairs + pairs.len() as u64,
+            exponentials: 2 * (geometric_pairs + pairs.len() as u64),
+            ..Default::default()
+        };
+        let mut rep_logs = Vec::new();
+        let drives = self.coordination_frame.homeostasis().drives;
+        for (ri, pair) in pairs.iter_mut().enumerate() {
+            let r = representative.outcomes[ri];
+            let base_posture = if self.forced(r) == Some(4) {
+                CoordinatedTargetFactorV1 {
+                    outcomes: vec![r],
+                    probabilities: vec![1.],
+                    log_probabilities: vec![0.],
+                }
+            } else {
+                channels[4].clone().unwrap_or(CoordinatedTargetFactorV1 {
+                    outcomes: vec![CoordinatedTargetChoiceV1::NoOp],
+                    probabilities: vec![1.],
+                    log_probabilities: vec![0.],
+                })
+            };
+            let mut pair_logs = Vec::new();
+            for (pi, choices) in pair.outcomes.iter().enumerate() {
+                let l = choices[0];
+                let index = if let Some(i) = pair.recovery.iter().position(|p| p.locomotion == l) {
+                    i
+                } else {
+                    let motion = self.predicted_motion(l)?;
+                    let features: Vec<_> = base_posture
+                        .outcomes
+                        .iter()
+                        .map(|p| {
+                            compatibility(
+                                f64::from_bits(self.group_bits),
+                                f64::from(drives.fear),
+                                f64::from(drives.pain),
+                                motion,
+                                r == CoordinatedTargetChoiceV1::RestGroup
+                                    || *p == CoordinatedTargetChoiceV1::RestGroup,
+                            )
+                        })
+                        .collect();
+                    let logs: Vec<_> = base_posture
+                        .log_probabilities
+                        .iter()
+                        .zip(&features)
+                        .map(|(p, f)| p + recovery_weight * f / t)
+                        .collect();
+                    work.posture_feature_evaluations += logs.len() as u64;
+                    work.logsumexp_terms += logs.len() as u64;
+                    // One sigmoid exponential per evaluated feature, plus one
+                    // exponential per partition term and normalized probability.
+                    work.exponentials += (2 * logs.len()
+                        + base_posture
+                            .outcomes
+                            .iter()
+                            .filter(|p| {
+                                r == CoordinatedTargetChoiceV1::RestGroup
+                                    || **p == CoordinatedTargetChoiceV1::RestGroup
+                            })
+                            .count()) as u64;
+                    let z = logsumexp(&logs)?;
+                    let log_probabilities: Vec<_> = logs.iter().map(|p| p - z).collect();
+                    let probabilities = log_probabilities.iter().map(|p| p.exp()).collect();
+                    pair.recovery.push(RecoveryPostureFactorV1 {
+                        locomotion: l,
+                        factor: CoordinatedTargetFactorV1 {
+                            outcomes: base_posture.outcomes.clone(),
+                            probabilities,
+                            log_probabilities,
+                        },
+                        features,
+                        log_partition: z,
+                    });
+                    pair.recovery.len() - 1
+                };
+                pair.recovery_index.push(index);
+                pair_logs.push(pair.log_probabilities[pi] + pair.recovery[index].log_partition);
+            }
+            work.pair_reweights += pair_logs.len() as u64;
+            work.logsumexp_terms += pair_logs.len() as u64;
+            work.exponentials += (2 * pair_logs.len()) as u64;
+            let z = logsumexp(&pair_logs)?;
+            pair.log_probabilities = pair_logs.iter().map(|p| p - z).collect();
+            pair.probabilities = pair.log_probabilities.iter().map(|p| p.exp()).collect();
+            rep_logs.push(representative.log_probabilities[ri] + z);
+        }
+        work.representative_reweights = rep_logs.len() as u64;
+        work.logsumexp_terms += rep_logs.len() as u64;
+        work.exponentials += (2 * rep_logs.len()) as u64;
+        let z = logsumexp(&rep_logs)?;
+        representative.log_probabilities = rep_logs.iter().map(|p| p - z).collect();
+        representative.probabilities = representative
+            .log_probabilities
+            .iter()
+            .map(|p| p.exp())
+            .collect();
+        let mut geometric_mean = [0.; 3];
+        let mut recovery_mean = 0.;
+        for (rp, pair) in representative.probabilities.iter().zip(&pairs) {
+            for (pi, pp) in pair.probabilities.iter().enumerate() {
+                for (i, mean) in geometric_mean.iter_mut().enumerate() {
+                    *mean += rp * pp * pair.features[pi][i];
+                }
+                let posture = &pair.recovery[pair.recovery_index[pi]];
+                recovery_mean += rp
+                    * pp
+                    * posture
+                        .factor
+                        .probabilities
+                        .iter()
+                        .zip(&posture.features)
+                        .map(|(p, f)| p * f)
+                        .sum::<f64>();
+            }
+        }
+        Ok((pairs, geometric_mean, recovery_mean, work))
+    }
+}
