+fn recovery_distribution(
+    s: &CoordinatedTargetScoresV1,
+    t: f64,
+    weight: f64,
+) -> (
+    CoordinatedTargetFactorV1,
+    Vec<CoordinationPairFactorV1>,
+    [f64; 3],
+    f64,
+) {
+    let mut native = s.native();
+    native.binding.eligible_mask = s.eligible_mask;
+    let base = native.probabilities(t).unwrap();
+    let mut rep = CoordinatedTargetFactorV1::from_native(base.representative);
+    let channels = base
+        .channels
+        .map(|f| f.map(CoordinatedTargetFactorV1::from_native));
+    let (pairs, gm, rm, _) = s
+        .coordinate_recovery(&mut rep, &channels, t, COORDINATION_WEIGHTS_V1, weight)
+        .unwrap();
+    (rep, pairs, gm, rm)
+}
+#[test]
+fn recovery_star_matches_cartesian_and_zero_weight_legacy() {
+    let s = coordination_fixture(1.);
+    let t = 0.73;
+    let (base_rep, base_pairs, _) = weighted_distribution(&s, t, COORDINATION_WEIGHTS_V1);
+    let (zero_rep, zero_pairs, _, _) = recovery_distribution(&s, t, 0.);
+    for (a, b) in base_rep.probabilities.iter().zip(&zero_rep.probabilities) {
+        assert!((a - b).abs() < 1e-12);
+    }
+    for (a, b) in base_pairs.iter().zip(&zero_pairs) {
+        for (x, y) in a.probabilities.iter().zip(&b.probabilities) {
+            assert!((x - y).abs() < 1e-12);
+        }
+    }
+    let (rep, pairs, _, mean) = recovery_distribution(&s, t, RECOVERY_MOTION_WEIGHT_V1);
+    let mut rows = Vec::new();
+    let mut z = 0.;
+    for (ri, pair) in pairs.iter().enumerate() {
+        for (pi, _) in pair.outcomes.iter().enumerate() {
+            let post = &pair.recovery[pair.recovery_index[pi]];
+            let zero_post = &zero_pairs[ri].recovery[zero_pairs[ri].recovery_index[pi]];
+            for qi in 0..post.factor.outcomes.len() {
+                let raw = base_rep.probabilities[ri]
+                    * base_pairs[ri].probabilities[pi]
+                    * zero_post.factor.probabilities[qi]
+                    * (RECOVERY_MOTION_WEIGHT_V1 * post.features[qi] / t).exp();
+                z += raw;
+                rows.push((ri, pi, qi, raw));
+            }
+        }
+    }
+    let mut total = 0.;
+    let h = 1e-5;
+    let (plus_r, plus_p, _, _) = recovery_distribution(&s, t, RECOVERY_MOTION_WEIGHT_V1 + h);
+    let (minus_r, minus_p, _, _) = recovery_distribution(&s, t, RECOVERY_MOTION_WEIGHT_V1 - h);
+    // Sum latent representative/manipulation paths into the same projected
+    // physical locomotion/posture/operation. Never report one path as this mass.
+    let mut physical = std::collections::BTreeMap::<String, [f64; 4]>::new();
+    for (ri, pi, qi, raw) in rows {
+        let pair = &pairs[ri];
+        let post = &pair.recovery[pair.recovery_index[pi]];
+        let p = rep.probabilities[ri] * pair.probabilities[pi] * post.factor.probabilities[qi];
+        assert!(p > 0.);
+        assert!((p - raw / z).abs() < 1e-12);
+        total += p;
+        let mass = |r: &CoordinatedTargetFactorV1, pairs: &[CoordinationPairFactorV1]| {
+            let pair = &pairs[ri];
+            r.probabilities[ri]
+                * pair.probabilities[pi]
+                * pair.recovery[pair.recovery_index[pi]].factor.probabilities[qi]
+        };
+        let plus = mass(&plus_r, &plus_p);
+        let minus = mass(&minus_r, &minus_p);
+        let derivative = (post.features[qi] - mean) / t;
+        assert!(((plus.ln() - minus.ln()) / (2. * h) - derivative).abs() < 1e-8);
+        let resting = post.factor.outcomes[qi] == CoordinatedTargetChoiceV1::RestGroup;
+        for (op, op_mass) in if resting {
+            vec![(Some(0), 0.5), (Some(1), 0.5)]
+        } else {
+            vec![(None, 1.)]
+        } {
+            let key = format!(
+                "{:?}/{:?}",
+                s.resolve(pair.outcomes[pi][0], op).unwrap(),
+                s.resolve(post.factor.outcomes[qi], op).unwrap()
+            );
+            let v = physical.entry(key).or_default();
+            v[0] += p * op_mass;
+            v[1] += p * op_mass * derivative;
+            v[2] += plus * op_mass;
+            v[3] += minus * op_mass;
+        }
+    }
+    assert!((total - 1.).abs() < 1e-12);
+    for v in physical.values() {
+        assert!(((v[2].ln() - v[3].ln()) / (2. * h) - v[1] / v[0]).abs() < 1e-8);
+    }
+}
