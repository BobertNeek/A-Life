+//! Bounded CPU fixture with production-enumerated static opportunities.
+//! No world interval, private checkpoint, trainer or autonomous policy is executed.
+//! Uses actual compiler, recurrent tape, signed decoder and factor sampler.
+use super::*;
+use crate::cpu::sample_cpu_joint_action;
+use crate::{TrainingInitialState, TrainingReplayCandidate, TrainingReplayTick};
+use alife_core::*;
+use alife_gpu_backend::GpuV11CausalState;
