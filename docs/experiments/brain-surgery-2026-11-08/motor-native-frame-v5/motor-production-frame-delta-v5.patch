+#[test]
+fn motor_production_frame_actual_microsteps_decoder_and_sampler() {
+    let (base, candidate) = graphs();
+    let base_w = weights(&base, false);
+    let candidate_w = weights(&candidate, false);
+    let base_zero = weights(&base, true);
+    let candidate_zero = weights(&candidate, true);
+    for (i, s) in base.synapses().iter().enumerate() {
+        if s.route_index() != 6 {
+            assert_eq!(base_w[i].to_bits(), candidate_w[i].to_bits());
+        }
+    }
+    let cases = [
+        ("quiet_sparse", 0., 0., 0., true),
+        ("quiet_full", 0., 0., 0., false),
+        ("hunger", 0.9, 0., 0., false),
+        ("fatigue", 0., 0.9, 0., false),
+        ("pain", 0., 0., 0.9, false),
+        ("hunger_fatigue", 0.9, 0.9, 0., false),
+        ("hunger_pain", 0.9, 0., 0.9, false),
+        ("fatigue_pain", 0., 0.9, 0.9, false),
+        ("all_conflict", 0.9, 0.9, 0.9, false),
+    ];
+    let mut rows = Vec::new();
+    let mut changed = 0;
+    for birth in [true, false] {
+        for steps in [2, 4] {
+            for (name, h, f, p, quiet) in cases {
+                let frame = frame(h, f, p, quiet);
+                let q_base = sequence(&base, &frame, birth, steps);
+                let q_candidate = sequence(&candidate, &frame, birth, steps);
+                let zero_base = SparseGraph::new(&base)
+                    .forward(&base, &base_zero, &q_base)
+                    .unwrap();
+                let zero_candidate = SparseGraph::new(&candidate)
+                    .forward(&candidate, &candidate_zero, &q_candidate)
+                    .unwrap();
+                assert_eq!(zero_base.a, zero_candidate.a);
+                assert_eq!(zero_base.m, zero_candidate.m);
+                assert_eq!(zero_base.evaluation, zero_candidate.evaluation);
+                let (a, ar) = run(&base, &base_w, &frame, birth, steps);
+                let (b, br) = run(&candidate, &candidate_w, &frame, birth, steps);
+                let (_, zr) = run(&candidate, &candidate_zero, &frame, birth, steps);
+                if a.a != b.a {
+                    changed += 1;
+                }
+                // From zero initialization, recurrence cannot alter the first step.
+                assert_eq!(a.a[1], b.a[1]);
+                rows.push(json!({"case":name,"birth_dendrites":birth,"diagnostic_only_no_dendrites":!birth,"microsteps_per_interval":steps,"unchanged":ar,"candidate":br,"zero_competition":zr,"first_candidate_vs_unchanged_activation_difference_microstep":a.a.iter().zip(&b.a).position(|(a,b)|a!=b),"first_candidate_vs_zero_activation_difference_microstep":b.a.iter().zip(&zero_candidate.a).position(|(a,b)|a!=b)}));
+            }
+        }
+    }
+    // Outcome is measured, never asserted to improve or to suppress valid rest.
+
+    let report = json!({"schema":"motor-family-production-frame-cpu-v5","changed_conditions":changed,"motor_head_count":base.cognitive_architecture().motor_head_count(),"motor_head_width":base.cognitive_architecture().motor_head_width(),"graph":"N2048MotorReconciliationCandidateV1","base":"N2048ExperimentalGraphV1","new_foundation_id":candidate.foundation_abi().foundation_id().unwrap().raw(),"enumerated_frames":cases.iter().map(|(name,h,f,p,q)| { let frame=frame(*h,*f,*p,*q); json!({"case":name,"candidates":frame.candidates()}) }).collect::<Vec<_>>(),"base_phenotype":base.phenotype_hash(),"candidate_phenotype":candidate.phenotype_hash(),"candidate_route_abi":candidate.route_abi_digest(),"route6_edges":1536,"route6_family_pairs":56,"edge_weight":-0.03,"unchanged_drive_decoder_and_activation":true,"zero_route6_controls_bit_exact":true,"deterministic_repeats":true,"execution":"CPU actual compiled graph, SparseGraph::forward and sample_cpu_joint_action; static native perception only, no world intervals, training or GPU dispatch","limitations":["Native GroundedObjectSlotsV1 candidates from a static fresh world; neural inputs remain fixed homeostasis ports, not a whole sensory pipeline","Birth dendrites unchanged; no-dendrite arms are matched diagnostics, not a gain repair","Rest representative is not stationary rest if other sampler factors remain active","Family competition has no target binding; sampled Avoid is not a physical reflex","No executed world intervals, physical receipts or reflex tests; only the actual expressed founder one-head configuration is tested"],"rows":rows});
+    if let Ok(path) = std::env::var("ALIFE_MOTOR_PRODUCTION_FRAME_REPORT") {
+        use std::io::Write;
+        let mut file = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(path)
+            .unwrap();
+        file.write_all(&serde_json::to_vec(&report).unwrap())
+            .unwrap();
+    }
+    println!("motor reconciliation: 36 matched conditions x 3 reported arms; repeated exact CPU tapes; zero controls exact; scalar report emitted only when explicitly requested");
+}
