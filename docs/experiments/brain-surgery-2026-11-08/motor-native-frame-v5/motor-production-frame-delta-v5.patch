+fn sequence(p: &BrainPhenotype, f: &PerceptionFrame, birth: bool, steps: u32) -> TrainingSequence {
+    // Explicit fixed-port stimulation, not a claim of running the whole sensory
+    // pipeline. Homeostatic values pass through the actual compiled assignments.
+    // No sensory/body/context evidence, endogenous chemistry or learned memory.
+    let n = p.neuron_count() as usize;
+    let home = f
+        .homeostasis()
+        .drives
+        .to_array()
+        .into_iter()
+        .chain(f.homeostasis().hormones.to_array())
+        .collect::<Vec<_>>();
+    let mut encoded = vec![0.; n];
+    for a in p.sensor_encoder().assignments() {
+        if a.source_group() == SensorEncoderSourceGroup::Homeostasis {
+            let (low, high) = a.clamp_range();
+            encoded[a.target_neuron() as usize] +=
+                (home[a.source_index() as usize] * a.scale() + a.bias()).clamp(low, high);
+        }
+    }
+    for v in &mut encoded {
+        *v = v.clamp(-1., 1.);
+    }
+    let candidates = f
+        .candidates()
+        .iter()
+        .map(|c| {
+            let mut inputs = [0.; 54];
+            inputs[..24].copy_from_slice(&c.features.0);
+            let family = p
+                .candidate_decoder()
+                .families()
+                .iter()
+                .find(|v| v.family() == c.family)
+                .unwrap();
+            TrainingReplayCandidate {
+                family: c.family,
+                decoder_inputs: inputs,
+                innate_bias: family.innate_contribution(f.homeostasis().drives, c.features),
+            }
+        })
+        .collect();
+    TrainingSequence {
+        phenotype_hash: p.phenotype_hash(),
+        initial: TrainingInitialState {
+            activations: vec![0.; n],
+            activity_ema: vec![0.; n],
+            metabolic_load: vec![0.; n],
+            dendrites: if birth {
+                GpuV11CausalState::for_phenotype(p)
+                    .unwrap()
+                    .dendritic_branches()
+                    .clone()
+            } else {
+                DendriticBranchSet::default()
+            },
+        },
+        ticks: vec![
+            TrainingReplayTick {
+                encoded_inputs: encoded,
+                projection_gain: 1.,
+                local_threshold_shift: 0.,
+                microstep_count: steps,
+                enabled_routes: vec![true; p.projections().len()],
+                effective_weight_offsets: vec![0.; p.synapses().len()],
+                structural_synapses: vec![],
+                candidates
+            };
+            12
+        ],
+        burn_in_ticks: 0,
+        memory_candidate_gain: p
+            .candidate_decoder()
+            .memory_channel()
+            .map_or(0., |m| m.max_candidate_gain()),
+    }
+}
+fn weights(p: &BrainPhenotype, zero: bool) -> Vec<f32> {
+    let mut w = care_candidate::whole_care(p).unwrap().0;
+    if zero {
+        for (id, s) in p.synapses().iter().enumerate() {
+            if s.route_index() == 6 {
+                w[id] = 0.;
+            }
+        }
+    }
+    w
+}
+fn family_summary(p: &BrainPhenotype, a: &[f32]) -> Value {
+    let m = p.candidate_decoder().motor_start() as usize;
+    Value::Array((0..8).map(|f| {let row=&a[m+f*16..m+(f+1)*16];json!({"family":f,"mean":row.iter().sum::<f32>()/16.,"min":row.iter().copied().fold(f32::INFINITY,f32::min),"max":row.iter().copied().fold(f32::NEG_INFINITY,f32::max),"abs_above_095":row.iter().filter(|v|v.abs()>0.95).count()})}).collect())
+}
+fn decoder_terms(p: &BrainPhenotype, w: &[f32], q: &TrainingSequence, a: &[f32]) -> Value {
+    Value::Array(q.ticks[0].candidates.iter().enumerate().map(|(index,c)| {
+        let mut lane_terms=[0f32;24];
+        for (id,s) in p.synapses().iter().enumerate(){
+            if let CompiledSynapseKind::Decoder(coord)=s.kind(){if coord.head()==DecoderHeadKind::ActionCandidate && coord.family()==c.family{
+                lane_terms[coord.input_lane() as usize]+=a[s.source() as usize]*c.decoder_inputs[coord.input_lane() as usize]*w[id];
+            }}
+        }
+        let bias=p.candidate_decoder().families().iter().find(|f|f.family()==c.family).unwrap().bias();
+        json!({"candidate":index,"family":c.family,"innate_bias":c.innate_bias,"family_bias":bias,"signed_lane_contributions":lane_terms.iter().enumerate().filter(|(_,v)|**v!=0.).map(|(lane,v)|json!({"lane":lane,"value":v})).collect::<Vec<_>>(),"sum":bias+c.innate_bias+lane_terms.iter().sum::<f32>()})
+    }).collect())
+}
+fn selection(p: &BrainPhenotype, f: &PerceptionFrame, logits: &[f32], counter: u32) -> Value {
+    let mut representatives = vec![0; logits.len()];
+    let mut full_rest = 0;
+    let mut wholly_inactive = 0;
+    let mut rest_with_activity = 0;
+    let mut mismatched = 0;
+    let mut first = None;
+    let mut sampled_bundles = Vec::with_capacity(32);
+    for seed in 0..32 {
+        let a = sample_cpu_joint_action(p, f, logits, seed, counter, 0.7).unwrap();
+        assert_eq!(
+            a,
+            sample_cpu_joint_action(p, f, logits, seed, counter, 0.7).unwrap()
+        );
+        representatives[a.representative as usize] += 1;
+        sampled_bundles.push(json!({"seed":seed,"counter":counter,"representative":a.representative,"motor_candidates":a.motor_candidates,"selected_primitives":a.motor_candidates.iter().map(|slot|slot.map(|i| { let c = &f.candidates()[i as usize]; json!({"action_id":c.action_id,"kind":c.kind,"family":c.family,"target":c.target}) })).collect::<Vec<_>>(),"log_probability":a.old_joint_log_probability}));
+        let is_rest = matches!(
+            f.candidates()[a.representative as usize].family,
+            CandidateActionFamily::Idle | CandidateActionFamily::Rest
+        );
+        let active = a.motor_candidates.iter().flatten().any(|slot| {
+            let c = &f.candidates()[*slot as usize];
+            !matches!(
+                c.action_id,
+                alife_world::HeadlessActionIds::NO_LOCOMOTION
+                    | alife_world::HeadlessActionIds::NO_MANIPULATION
+                    | alife_world::HeadlessActionIds::NO_POSTURE
+            ) && !matches!(c.kind, ActionKind::Idle | ActionKind::Rest)
+        });
+        if !active {
+            wholly_inactive += 1;
+        }
+        if is_rest && !active {
+            full_rest += 1;
+        }
+        if is_rest && active {
+            rest_with_activity += 1;
+        }
+        if let (Some(l), Some(m)) = (a.motor_candidates[0], a.motor_candidates[2]) {
+            let (l, m) = (&f.candidates()[l as usize], &f.candidates()[m as usize]);
+            if l.family == CandidateActionFamily::Approach
+                && l.target.entity.is_some()
+                && m.family == CandidateActionFamily::Ingest
+                && l.target.entity != m.target.entity
+            {
+                mismatched += 1;
+            }
+        }
+        if first.is_none() {
+            first = Some(
+                json!({"representative":a.representative,"motor_candidates":a.motor_candidates,"selected_primitives":a.motor_candidates.iter().map(|slot|slot.map(|i| { let c = &f.candidates()[i as usize]; json!({"action_id":c.action_id,"kind":c.kind,"family":c.family,"target":c.target}) })).collect::<Vec<_>>(),"log_probability":a.old_joint_log_probability}),
+            );
+        }
+    }
+    json!({"samples":32,"representative_counts":representatives,"valid_rest_bundle":full_rest,"wholly_inactive_bundle":wholly_inactive,"rest_representative_with_other_active_slots":rest_with_activity,"approach_eat_target_mismatch":mismatched,"seed_zero_selection":first,"sampled_bundles":sampled_bundles})
+}
+fn run(
+    p: &BrainPhenotype,
+    w: &[f32],
+    f: &PerceptionFrame,
+    birth: bool,
+    steps: u32,
+) -> (Tape, Value) {
+    let q = sequence(p, f, birth, steps);
+    q.validate_for(p).unwrap();
+    let g = SparseGraph::new(p);
+    let tape = g.forward(p, w, &q).unwrap();
+    let repeat = g.forward(p, w, &q).unwrap();
+    assert_eq!(tape.a, repeat.a);
+    assert_eq!(tape.m, repeat.m);
+    assert_eq!(tape.evaluation, repeat.evaluation);
+    let mut ticks = Vec::new();
+    let stride = p.microstep_count() as usize;
+    for tick in 0..q.ticks.len() {
+        let mut microsteps = Vec::new();
+        for step in 1..=steps as usize {
+            let a = &tape.a[tick * stride + step];
+            // Score this actual intermediate bank through the production replay
+            // decoder, with zero extra recurrence; do not hand-pick actions.
+            let mut probe = q.clone();
+            probe.ticks.truncate(1);
+            probe.initial.activations = a.clone();
+            probe.ticks[0].microstep_count = 0;
+            let logits = g
+                .forward(p, w, &probe)
+                .unwrap()
+                .evaluation
+                .candidate_logits
+                .remove(0);
+            let terms = decoder_terms(p, w, &q, a);
+            for (i, term) in terms.as_array().unwrap().iter().enumerate() {
+                assert!((term["sum"].as_f64().unwrap() as f32 - logits[i]).abs() < 2e-5);
+            }
+            microsteps.push(json!({"step":step,"family_activity":family_summary(p,a),"logits":logits,"signed_contributions":if tick==0||tick+1==q.ticks.len(){terms}else{Value::Null},"selection":selection(p,f,&logits,(tick*stride+step)as u32)}));
+        }
+        ticks.push(
+            json!({"interval":tick,"world_interval_ms_reference":50,"microsteps":microsteps}),
+        );
+    }
+    (tape, json!({"intervals":ticks}))
+}
