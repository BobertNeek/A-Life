+fn frame(hunger: f32, fatigue: f32, pain: f32, quiet: bool) -> PerceptionFrame {
+    let tick = Tick::new(1);
+    let id = OrganismId(777);
+    let mut drives = DriveSnapshot::baseline();
+    drives.hunger = hunger;
+    drives.fatigue = fatigue;
+    drives.pain = pain;
+    drives.fear = 0.;
+    drives.curiosity = 0.;
+    drives.loneliness = 0.;
+    drives.reproductive_drive = 0.;
+    // Static fresh world enumeration only: no body interval or policy is executed.
+    let mut builder =
+        alife_world::HeadlessScenarioBuilder::new(0x7A11).agent("subject", id, Vec3f::ZERO);
+    if !quiet {
+        builder = builder
+            .food("food A", Vec3f::new(0.3, 0., 0.), 0.8)
+            .food("food B", Vec3f::new(1.2, 0., 0.5), 0.6)
+            .hazard("hazard", Vec3f::new(-0.4, 0., 0.), 0.8);
+    }
+    let mut world = builder.build().unwrap();
+    let frame = world
+        .perception_frame(
+            id,
+            tick,
+            SensorProfile::GroundedObjectSlotsV1,
+            HomeostaticSnapshot::new(tick, drives, EndocrineSnapshot::baseline()).unwrap(),
+        )
+        .unwrap();
+    for primitive in [
+        alife_world::HeadlessActionIds::NO_LOCOMOTION,
+        alife_world::HeadlessActionIds::NO_MANIPULATION,
+        alife_world::HeadlessActionIds::NO_POSTURE,
+    ] {
+        assert!(frame
+            .candidates()
+            .iter()
+            .any(|c| c.action_id == primitive && c.target.entity.is_none()));
+    }
+    frame
+}
