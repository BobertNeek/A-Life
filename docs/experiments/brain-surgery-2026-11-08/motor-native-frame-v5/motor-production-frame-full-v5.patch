+//! Bounded CPU fixture with production-enumerated static opportunities.
+//! No world interval, private checkpoint, trainer or autonomous policy is executed.
+//! Uses actual compiler, recurrent tape, signed decoder and factor sampler.
+use super::*;
+use crate::cpu::sample_cpu_joint_action;
+use crate::{TrainingInitialState, TrainingReplayCandidate, TrainingReplayTick};
+use alife_core::*;
+use alife_gpu_backend::GpuV11CausalState;
+use serde_json::{json, Value};
+use std::collections::BTreeSet;
+
+use super::motor_reconciliation_assay::care_candidate;
+
+fn graphs() -> (BrainPhenotype, BrainPhenotype) {
+    let capacity = BrainCapacityClass::n2048();
+    let genome = BrainGenome::scaffold(0x7A11, capacity.id());
+    let founder = CreatureGenome::early_mammal_founder(
+        0x7A11,
+        FoundationGeneticIdentity::new(10, 1, 7, capacity.id()).unwrap(),
+    )
+    .unwrap()
+    .express()
+    .unwrap();
+    assert_eq!(
+        founder
+            .brain_genome
+            .cognitive_architecture()
+            .motor_head_count(),
+        genome.cognitive_architecture().motor_head_count()
+    );
+    assert_eq!(
+        founder
+            .brain_genome
+            .cognitive_architecture()
+            .motor_head_width(),
+        genome.cognitive_architecture().motor_head_width()
+    );
+    assert_eq!(genome.cognitive_architecture().motor_head_count(), 1);
+    let development =
+        DevelopmentState::new(genome.id, Tick::ZERO, NormalizedScalar::new(0.8).unwrap());
+    let base = PhenotypeCompiler::compile_n2048_experimental_graph(
+        genome.clone(),
+        development.clone(),
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap()
+    .0;
+    let candidate = PhenotypeCompiler::compile_n2048_motor_reconciliation_graph(
+        genome,
+        development,
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap()
+    .0;
+    (base, candidate)
+}
+
+#[test]
+fn motor_production_frame_identity_and_coordinates_are_isolated() {
+    let (base, candidate) = graphs();
+    assert_ne!(base.phenotype_hash(), candidate.phenotype_hash());
+    assert_ne!(base.route_abi_digest(), candidate.route_abi_digest());
+    assert_ne!(
+        base.persistent_address_map().digest(),
+        candidate.persistent_address_map().digest()
+    );
+    assert_eq!(base.neuron_dynamics(), candidate.neuron_dynamics());
+    assert_eq!(base.sensor_encoder(), candidate.sensor_encoder());
+    assert_eq!(base.candidate_decoder(), candidate.candidate_decoder());
+    assert_eq!(base.microstep_count(), candidate.microstep_count());
+    assert_eq!(base.synapses().len(), candidate.synapses().len());
+    for (a, b) in base.synapses().iter().zip(candidate.synapses()) {
+        if a.route_index() != 6 {
+            assert_eq!(a, b);
+        }
+    }
+    assert_eq!(candidate.budgets().global.active_tiles, 187);
+    let m = candidate.candidate_decoder().motor_start();
+    for n in m..m + 128 {
+        assert_eq!(
+            candidate
+                .synapses()
+                .iter()
+                .filter(|s| s.route_index() == 6 && s.target() == n)
+                .count(),
+            12
+        );
+        assert_eq!(
+            candidate
+                .synapses()
+                .iter()
+                .filter(|s| s.route_index() == 6 && s.source() == n)
+                .count(),
+            12
+        );
+    }
+    let pairs = candidate
+        .synapses()
+        .iter()
+        .filter(|s| s.route_index() == 6)
+        .map(|s| ((s.source() - m) / 16, (s.target() - m) / 16))
+        .collect::<BTreeSet<_>>();
+    assert_eq!(pairs.len(), 56);
+    assert!(pairs.iter().all(|(a, b)| a != b && *a < 8 && *b < 8));
+    for family in 0..8 {
+        for lane in 0..16 {
+            for other in 0..8 {
+                if other != family {
+                    assert!(candidate.synapses().iter().any(|s| s.route_index() == 6
+                        && s.target() == m + family * 16 + lane
+                        && (s.source() - m) / 16 == other));
+                }
+            }
+        }
+    }
+    let asset = FoundationWeightAsset::from_trained_weights(
+        &candidate,
+        candidate
+            .synapses()
+            .iter()
+            .map(|s| s.genetic_weight())
+            .collect(),
+        TrainingStageManifest::bootstrap(),
+    )
+    .unwrap();
+    let decoded =
+        FoundationWeightAsset::decode_canonical(&asset.encode_canonical().unwrap()).unwrap();
+    // A fresh coordinate graph has no bound asset; only explicit recompile
+    // admits the exported genetic payload.
+    assert!(decoded.validate_against(&candidate).is_err());
+    assert!(decoded.validate_against(&base).is_err());
+    assert!(N2048ExperimentalGraphV1::for_asset(&decoded).is_err());
+    assert!(N2048MemoryGainCandidateV1::for_asset(&decoded).is_err());
+    let capacity = BrainCapacityClass::n2048();
+    let genome = BrainGenome::scaffold(0x7A11, capacity.id());
+    let development =
+        DevelopmentState::new(genome.id, Tick::ZERO, NormalizedScalar::new(0.8).unwrap());
+    let restored = PhenotypeCompiler::compile_n2048_motor_reconciliation_foundation_candidate(
+        genome,
+        development,
+        decoded.clone(),
+    )
+    .unwrap()
+    .0;
+    decoded.validate_against(&restored).unwrap();
+    assert!(FoundationAbiBinding::canonical_for_foundation_asset(&capacity, &decoded).is_err());
+    let round: BrainPhenotype =
+        serde_json::from_slice(&serde_json::to_vec(&restored).unwrap()).unwrap();
+    assert_eq!(restored, round);
+    let mut tampered = serde_json::to_value(&restored).unwrap();
+    tampered["foundation_abi_selection"]["contract"]["recipe_digest"][0] = json!(0);
+    assert!(serde_json::from_value::<BrainPhenotype>(tampered).is_err());
+    assert_eq!(candidate.synapses(), restored.synapses());
+    assert_eq!(candidate.route_abi_digest(), restored.route_abi_digest());
+}
