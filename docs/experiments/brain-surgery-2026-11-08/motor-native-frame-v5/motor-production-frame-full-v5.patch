+/// Opt-in family competition coordinates. This changes only route 6 of the
+/// fresh experimental graph; no old graph is interpreted under these addresses.
+pub(super) fn compile_n2048_motor_reconciliation(
+    genome: &BrainGenome,
+    layout: &LobeLayout,
+    capacity: &BrainCapacityClass,
+) -> Result<RecurrentCompilation, ScaffoldContractError> {
+    let (mut projections, mut synapses, mut receipts) =
+        compile_n2048_experimental(genome, layout, capacity)?;
+    let spec = crate::N2048FoundationLayoutV1::route_specs()[6];
+    let motor = layout
+        .region(LobeKind::ActionPlanning)
+        .ok_or_else(compile_error)?;
+    let (start, count) = projections[6].synapse_range();
+    let mut rows = Vec::with_capacity(count as usize);
+    for family in 0..8u32 {
+        for lane in 0..16u32 {
+            let target = motor.start + family * 16 + lane;
+            // One same-lane edge from every rival family, plus five rotated
+            // adjacent-lane edges. Exactly twelve incoming AND outgoing edges
+            // per neuron avoids changing lane gain through uneven degree.
+            for delta in 1..8u32 {
+                rows.push((motor.start + ((family + delta) % 8) * 16 + lane, target));
+            }
+            for extra in 0..5u32 {
+                let delta = (lane + extra) % 7 + 1;
+                rows.push((
+                    motor.start + ((family + delta) % 8) * 16 + (lane + 1) % 16,
+                    target,
+                ));
+            }
+        }
+    }
+    if rows.len() != count as usize {
+        return Err(compile_error());
+    }
+    rows.sort_unstable();
+    let route = RoutingMask::new(
+        spec.source_lobe(),
+        spec.target_lobe(),
+        spec.projection_type(),
+        spec.active_tile_policy(),
+        spec.update_cadence(),
+        spec.priority(),
+    );
+    for (slot, (from, to)) in synapses[start as usize..(start + count) as usize]
+        .iter_mut()
+        .zip(rows)
+    {
+        *slot = CompiledSynapse::new(
+            from,
+            to,
+            genetic_weight(
+                genome.genetic_prior_seed,
+                6,
+                from,
+                to,
+                spec.projection_type(),
+            ),
+            alpha_for(genome, route, from, to, motor.start),
+            6,
+            CompiledSynapseKind::Recurrent,
+        );
+    }
+    projections[6] = CompiledProjection::new(
+        6,
+        spec.source_lobe(),
+        spec.target_lobe(),
+        spec.projection_type(),
+        spec.active_tile_policy(),
+        spec.update_cadence(),
+        spec.priority(),
+        0,
+        start,
+        count,
+        56,
+    );
+    receipts[6].active_tiles = 56;
+    receipts[6].tile_ceiling = 56;
+    if receipts.iter().map(|r| r.active_tiles).sum::<u32>()
+        > capacity.execution().max_active_tiles()
+    {
+        return Err(compile_error());
+    }
+    Ok((projections, synapses, receipts))
+}
