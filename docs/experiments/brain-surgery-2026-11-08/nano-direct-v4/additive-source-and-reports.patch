+                                effects,
+                                pressure,
+                                sample,
+                                horizon,
+                            ))
+                            .unwrap()
+                        })
+                        .collect::<Vec<_>>();
+                    let logits = evals
+                        .iter()
+                        .map(|e| e.candidate_logits.last().unwrap()[0])
+                        .collect::<Vec<_>>();
+                    assert!(evals[0].final_activations == evals[1].final_activations);
+                    assert!(evals[0].final_activations == evals[2].final_activations);
+                    let source = source(trainers[2].phenotype());
+                    let reference = trainers[2]
+                        .phenotype()
+                        .lobe_layout()
+                        .region(LobeKind::MemoryInterface)
+                        .unwrap()
+                        .start as usize
+                        + 8;
+                    let a = evals[2].final_activations.last().unwrap();
+                    assert!(a[source] > 0. && a[reference] > 0.);
+                    near(logits[1] - logits[0], 0.35 * sample * a[reference], 2e-6);
+                    near(logits[2] - logits[0], 0.35 * sample * a[source], 2e-6);
+                    gains.push((logits[1] - logits[0], logits[2] - logits[0]));
+                    eprintln!("zero_fresh_native_context={context} frames={horizon} microsteps_per_frame={RECORDED_MICROSTEPS} raw_pressure={pressure} synthetic_recall={sample} source={} reference={} constant_delta={} direct_delta={}",a[source],a[reference],gains.last().unwrap().0,gains.last().unwrap().1);
+                }
+                for pair in gains.windows(2) {
+                    near(pair[0].0, pair[1].0, 2e-6);
+                    if sample > 0. {
+                        assert!(pair[1].1 > pair[0].1);
+                    } else if sample < 0. {
+                        assert!(pair[1].1 < pair[0].1);
+                    } else {
+                        near(pair[1].1, 0., 1e-7);
+                    }
+                }
+            }
