+#[test]
+fn native_context_zero_readout_and_direct_controls_preserve_signed_coupling() {
+    let (v3, asset) = support::fixture();
+    let trainers = FACTORS.map(|f| build(&asset, f));
+    let base_recipe = Nano512ActionCreditCandidateV2::new(
+        &asset,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let (baseline, _) =
+        PhenotypeCompiler::compile_nano512_action_credit_candidate(&base_recipe).unwrap();
+    let birth = GpuV11CausalState::for_phenotype(&baseline).unwrap();
+    for t in &trainers {
+        assert!(
+            serde_json::to_vec(
+                GpuV11CausalState::for_phenotype(t.phenotype())
+                    .unwrap()
+                    .dendritic_branches()
+            )
+            .unwrap()
+                == serde_json::to_vec(birth.dendritic_branches()).unwrap()
+        );
+        assert_eq!(
+            NeuralReceptorPhenotype::compile(t.phenotype()).unwrap(),
+            NeuralReceptorPhenotype::compile(&v3).unwrap()
+        );
+        let packed = GpuPhenotypeUpload::try_from(t.phenotype()).unwrap();
+        let gate_source = t.phenotype().synapses()[gate(t.phenotype())].source();
+        assert!(packed
+            .decoder_eligibility_metadata
+            .iter()
+            .filter(|m| m.decoder_head == 5)
+            .all(|m| m.motor_index == gate_source));
+        let mut bucket = GpuClassBucketPlan::new(BrainCapacityClass::n512(), 1).unwrap();
+        bucket.insert_phenotype(0, 1, t.phenotype()).unwrap();
+    }
+    for (context, effects) in recorded_effects().iter().enumerate() {
+        let frame = neutral_perception_at_recorded_tick(&asset, *effects);
+        for horizon in [1, 8, 32] {
+            for sample in [-0.4, 0., 0.4] {
+                let mut gains = Vec::new();
+                for pressure in [0., 0.05, 0.15, 0.8] {
