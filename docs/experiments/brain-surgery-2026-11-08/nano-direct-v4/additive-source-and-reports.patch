+            expected.write_u8(t);
+        }
+        if let Some(s) = selection {
+            expected.write_u64(0x4449524e45454432);
+            expected.write_u32(0.30_f32.to_bits());
+            expected.write_u32(weight.to_bits());
+            expected.write_u8(s);
+            expected.write_u16(3);
+            expected.write_u16(4);
+            expected.write_u16(6);
+            expected.write_u32(8);
+        }
+        assert_eq!(abi.selector_digest(), expected.finish256(), "{factor:?}");
+    }
+}
+
+#[test]
+fn direct_recipe_rejects_unsigned_profile_and_changed_source_and_keeps_v3_exact() {
+    let asset = source();
+    let base = base(&asset);
+    let changed_source = source_with_stage(2);
+    assert_ne!(changed_source.digest(), asset.digest());
+    for factor in factors() {
+        let (bound, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(
+            &base.clone().with_drive_routing(factor),
+        )
+        .unwrap();
+        assert!(changed_source.validate_against(&bound).is_err());
+        let mut wrong = serde_json::to_value(base.clone().with_drive_routing(factor)).unwrap();
+        wrong["action_profile"] = serde_json::json!("SignedConsequences");
+        let recipe = serde_json::from_value::<Nano512ActionCreditCandidateV2>(wrong).unwrap();
+        assert!(PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).is_err());
+    }
+    let (old, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&base).unwrap();
+    let n = old.synapses().len();
+    let sense = need_source(&old);
+    let reference = old
+        .lobe_layout()
+        .region(LobeKind::MemoryInterface)
+        .unwrap()
+        .start
+        + 8;
+    for factor in [
+        NanoDriveRoutingV1::ZeroNeedMemoryGate,
+        NanoDriveRoutingV1::NeedMemoryGate,
+    ] {
+        let (p, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(
+            &base.clone().with_drive_routing(factor),
+        )
+        .unwrap();
+        assert!(&p.synapses()[..n] == old.synapses());
+        assert_eq!(
+            p.neuron_dynamics()[sense as usize],
+            old.neuron_dynamics()[sense as usize]
+        );
+        assert_eq!(p.neuron_dynamics()[reference as usize].bias(), 0.25);
+        assert!(p.synapses()[n..].iter().all(|s| s.source() == reference));
+    }
+}
