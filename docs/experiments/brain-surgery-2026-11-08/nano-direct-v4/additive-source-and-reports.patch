+                .iter()
+                .any(|b| b.target as usize == source));
+            let mut endpoints = Vec::new();
+            for pressure in [0., 1.] {
+                let mut h = *frame.homeostasis();
+                match lane {
+                    0 => h.drives.hunger = pressure,
+                    1 => h.drives.fatigue = pressure,
+                    2 => h.drives.fear = pressure,
+                    3 => h.drives.pain = pressure,
+                    4 => h.drives.loneliness = pressure,
+                    5 => h.drives.curiosity = pressure,
+                    6 => h.drives.brain_atp = pressure,
+                    7 => h.drives.temperature_stress = pressure,
+                    8 => h.drives.reproductive_drive = pressure,
+                    9 | 10 => h.drives.extension[lane - 9] = pressure,
