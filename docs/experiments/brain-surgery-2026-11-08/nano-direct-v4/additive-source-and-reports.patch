+                    let first_branch_max = (isolated_target_max.max(0.)).tanh() * 0.25;
+                    probes.push(json!({"lane":lane,"name":DRIVE_NAMES[lane],"substituted_raw_pressure":pressure,"source_assignments":assignments,"assignment_clamp":[lo,hi],
+                        "source":node_terms(&p,&branches,&effects,&x,source),"reserve":node_terms(&p,&branches,&effects,&x,reserve+lane as u32),
