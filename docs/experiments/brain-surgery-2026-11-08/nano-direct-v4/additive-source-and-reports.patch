@@ -0,0 +1,555 @@
+#![cfg(feature = "cpu-backend")]
+//! No-world fixed-context contracts. Synthetic signed/empty recall is not learned
+//! memory evidence; zero initial neural state is not a restored recorded state.
+use alife_core::*;
+use alife_gpu_backend::{GpuClassBucketPlan, GpuPhenotypeUpload, GpuV11CausalState};
+use alife_training::{
+    cpu::*, AdamWConfig, StageTrainableMask, TrainingInitialState, TrainingReplayCandidate,
+    TrainingReplayTick, TrainingSequence,
+};
+use alife_world::*;
+#[path = "support/need_memory_port.rs"]
+#[allow(dead_code)]
+mod support;
+// All 384 rows in the hash-bound closed receipt used three microsteps.
+// The compiled maximum is four; using it would mislabel one-frame latency.
+const RECORDED_MICROSTEPS: u32 = 3;
+const FACTORS: [NanoDriveRoutingV1; 3] = [
+    NanoDriveRoutingV1::ZeroDirectNeedMemoryGateV2,
+    NanoDriveRoutingV1::ConstantNeedMemoryGateV2,
+    NanoDriveRoutingV1::DirectNeedMemoryGateV2,
+];
+fn source(p: &BrainPhenotype) -> usize {
+    p.sensor_encoder()
+        .assignments()
+        .iter()
+        .find(|a| {
+            a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                && a.source_index() == 4
+                && a.scale() != 0.
+        })
+        .unwrap()
+        .target_neuron() as usize
+}
+fn gate(p: &BrainPhenotype) -> usize {
+    p.synapses().iter().position(|s|matches!(s.kind(),CompiledSynapseKind::Decoder(c) if c.head()==DecoderHeadKind::NeedGatedMemoryContextV1 && c.family()==CandidateActionFamily::Approach)).unwrap()
+}
+fn build(asset: &FoundationWeightAsset, factor: NanoDriveRoutingV1) -> CpuFoundationTrainer {
+    let recipe = Nano512ActionCreditCandidateV2::new(
+        asset,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap()
+    .with_drive_routing(factor);
+    let (p, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+    let mask = StageTrainableMask::from_synapse_indices(&p, &[gate(&p) as u32]).unwrap();
+    CpuFoundationTrainer::new(p, asset.clone(), mask, AdamWConfig::default()).unwrap()
+}
+fn recorded_effects() -> [NeuralReceptorEffects; 2] {
+    let record: serde_json::Value =
+        serde_json::from_str(include_str!("../../../operating-point-summary.json")).unwrap();
+    assert_eq!(
+        record["source_artifact_sha256"],
+        "6f0e21260fec2885bee195cd32b9b7955579fd96e4fd68a49106aa7e27e98a92"
+    );
+    [false, true].map(|peer| {
+        serde_json::from_value(
+            record["contexts"]
+                .as_array()
+                .unwrap()
+                .iter()
+                .find(|c| c["factor"] == "NeedMemoryGate" && c["peer_body_fixture"] == peer)
+                .unwrap()["effects"]
+                .clone(),
+        )
+        .unwrap()
+    })
+}
+fn neutral_perception_at_recorded_tick(
+    asset: &FoundationWeightAsset,
+    effects: NeuralReceptorEffects,
+) -> PerceptionFrame {
+    // Only construct a fresh public birth record for valid sensory/body/candidate
+    // shape. No host/cohort or world interval is executed.
+    let recipe = Nano512ActionCreditCandidateV2::new(
+        asset,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let mut game = create_canonical_new_game_with_nociceptive_candidate(
+        &CanonicalNewGameConfig::phase3(41, 1).unwrap(),
+        &recipe,
+    )
+    .unwrap();
+    let record = game
+        .world
+        .organism_registry()
+        .get(OrganismId(1))
+        .unwrap()
+        .clone();
+    let (draft, _) = game
+        .world
+        .perception_frame_draft_with_bindings(
+            OrganismId(1),
+            Tick::ZERO,
+            SensorProfile::GroundedObjectSlotsV1,
+            record.biochemistry().homeostasis,
+        )
+        .unwrap();
+    let old = draft.finalize(PerceptionContextBlock::empty()).unwrap();
+    let mut h = *old.homeostasis();
+    h.tick = effects.source_tick;
+    // Rebind sensory/provenance ticks through their validated wire representation;
+    // only public synthetic frame construction, never a biological restore.
+    let mut sensory = serde_json::to_value(old.sensory()).unwrap();
+    sensory["tick"] = serde_json::to_value(effects.source_tick).unwrap();
+    let sensory: SensorySnapshot = serde_json::from_value(sensory).unwrap();
+    let mut provenance = serde_json::to_value(old.profile_provenance()).unwrap();
+    provenance["source_tick"] = serde_json::to_value(effects.source_tick).unwrap();
+    PerceptionFrame::new(
+        old.organism_id(),
+        effects.source_tick,
+        old.sensor_profile(),
+        sensory,
+        old.body(),
+        h,
+        old.candidates().to_vec(),
+        serde_json::from_value(provenance).unwrap(),
+        old.grounded_object_slots().to_vec(),
+    )
+    .unwrap()
+}
+fn sequence(
+    p: &BrainPhenotype,
+    frame: &PerceptionFrame,
+    effects: &NeuralReceptorEffects,
+    pressure: f32,
+    sample: f32,
+    ticks: usize,
+) -> TrainingSequence {
+    let mut h = *frame.homeostasis();
+    h.drives.loneliness = pressure;
+    let frame = PerceptionFrame::new(
+        frame.organism_id(),
+        frame.tick(),
+        frame.sensor_profile(),
+        frame.sensory().clone(),
+        frame.body(),
+        h,
+        frame.candidates().to_vec(),
+        frame.profile_provenance(),
+        frame.grounded_object_slots().to_vec(),
+    )
+    .unwrap();
+    let encoded_inputs = encode_cpu_neural_inputs(p, &frame, effects).unwrap();
+    assert!(RECORDED_MICROSTEPS <= u32::from(p.microstep_count()));
+    let n = p.neuron_count() as usize;
+    let mut decoder_inputs = [0.; 54];
+    decoder_inputs[32] = sample;
+    let tick = TrainingReplayTick {
+        encoded_inputs,
+        projection_gain: effects.projection_gain,
+        local_threshold_shift: effects.local_threshold_shift,
+        microstep_count: RECORDED_MICROSTEPS,
+        enabled_routes: vec![true; p.projections().len()],
+        effective_weight_offsets: vec![0.; p.synapses().len()],
+        structural_synapses: vec![],
+        candidates: vec![TrainingReplayCandidate {
+            family: CandidateActionFamily::Approach,
+            decoder_inputs,
+            innate_bias: 0.,
+        }],
+    };
+    TrainingSequence {
+        phenotype_hash: p.phenotype_hash(),
+        initial: TrainingInitialState {
+            activations: vec![0.; n],
+            activity_ema: vec![0.; n],
+            metabolic_load: vec![0.; n],
+            dendrites: GpuV11CausalState::for_phenotype(p)
+                .unwrap()
+                .dendritic_branches()
+                .clone(),
+        },
+        ticks: vec![tick; ticks],
+        burn_in_ticks: 0,
+        memory_candidate_gain: p
+            .candidate_decoder()
+            .memory_channel()
+            .unwrap()
+            .max_candidate_gain(),
+    }
+}
+fn near(a: f32, b: f32, tol: f32) {
+    assert!((a - b).abs() <= tol, "{a} vs {b}, tolerance {tol}");
+}
