+            branches.validate_for_neuron_count(p.neuron_count())?;
+            assert_eq!(&branches, born.dendritic_branches());
+            let receptors = measured.before.neural_receptor_frame(record.phenotype())?;
+            let effects = NeuralReceptorEffects::from_frame(&receptors, &receptor_phenotype)?;
+            let encoded = encode_cpu_neural_inputs(&p, &frame, &effects)?;
+            let source_base = sources
+                .iter()
+                .map(|&id| {
+                    p.neuron_dynamics()[id as usize].bias() + encoded[id as usize]
