+                    frame.body(),
+                    h,
+                    frame.candidates().to_vec(),
+                    frame.profile_provenance(),
+                    frame.grounded_object_slots().to_vec(),
+                )
+                .unwrap();
+                let encoded = encode_cpu_neural_inputs(p, &substituted, effects).unwrap();
+                let base = p.neuron_dynamics()[source].bias() + encoded[source]
+                    - effects.local_threshold_shift;
+                let mut activations = Vec::new();
+                for horizon in [1, 8, 32, 256] {
+                    let mut q = sequence(p, &frame, effects, 0., 0., horizon);
+                    for tick in &mut q.ticks {
+                        tick.encoded_inputs.clone_from(&encoded);
+                    }
+                    let eval = trainer.evaluate_replay(&q).unwrap();
+                    let a = eval.final_activations.last().unwrap()[source];
+                    assert_eq!(a > 0., lane == 4);
+                    if horizon == 256 {
+                        near(a, equilibrium(f64::from(base)) as f32, 2e-6);
+                    }
+                    activations.push(a);
+                    eprintln!("all11_zero_fresh_native context={context} lane={lane} label={name} kind={kind} source={source} pressure={pressure} frames={horizon} microsteps_per_frame={RECORDED_MICROSTEPS} assignment_scale={} bias={} encoded={} base_before_metabolic={base} activation={a} newly_coupled={}", assignment.scale(), p.neuron_dynamics()[source].bias(), encoded[source], lane == 4);
+                }
+                endpoints.push((encoded[source], activations));
+            }
+            near(
+                endpoints[1].0 - endpoints[0].0,
+                effects.interoceptive_gain * effects.regional_excitability,
+                1e-7,
+            );
+            for i in 0..4 {
+                assert!(endpoints[1].1[i] > endpoints[0].1[i]);
