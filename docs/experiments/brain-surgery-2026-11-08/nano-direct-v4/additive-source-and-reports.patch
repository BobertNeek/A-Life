+fn equilibrium(base: f64) -> f64 {
+    let mut a = 0.;
+    let mut m = 0.;
+    for _ in 0..2048 {
+        a = 0.75 * a + 0.25 * (base - m).tanh();
+        m = 0.01 * m + 0.99 * a * a;
+    }
+    a
+}
+#[test]
+fn signed_threshold_one_hop_relay_is_an_explicit_analytical_alternative_only() {
+    for (context, e) in recorded_effects().iter().enumerate() {
+        let offset =
+            ((e.structural_growth_gate + e.sleep_gate + e.consolidation_gate) / 3. - 0.5) * 0.05;
+        let native_base = f64::from(offset - e.local_threshold_shift);
+        let signed_threshold = equilibrium(native_base);
+        let mut prior = None;
+        for pressure in [0., 0.05, 0.15, 0.8] {
+            let native = equilibrium(
+                native_base + f64::from(e.interoceptive_gain * e.regional_excitability) * pressure,
+            );
+            let branch = (native - signed_threshold).max(0.).tanh() * 0.25;
+            let relay = equilibrium(0.30 + native_base + f64::from(e.projection_gain) * branch);
+            let direct = equilibrium(
+                0.30 + native_base
+                    + f64::from(e.interoceptive_gain * e.regional_excitability) * pressure,
+            );
+            if let Some((r, d)) = prior {
+                assert!(relay > r && direct > d);
+            }
+            prior = Some((relay, direct));
+            eprintln!("analytical_only_signed_threshold_relay context={context} raw_pressure={pressure} original_source_equilibrium={native} derived_zero_pressure_threshold={signed_threshold} branch={branch} relay_reader={relay} direct_source={direct}");
+        }
+    }
