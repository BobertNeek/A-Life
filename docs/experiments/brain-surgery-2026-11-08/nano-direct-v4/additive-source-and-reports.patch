@@ -0,0 +1,317 @@
+use alife_core::*;
+
+fn source() -> FoundationWeightAsset {
+    source_with_stage(1)
+}
+fn source_with_stage(stage: u32) -> FoundationWeightAsset {
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let builtin = FoundationWeightAsset::builtin_nano512_v1(profile).unwrap();
+    let (p, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &builtin)
+            .unwrap()
+            .into_runtime_parts();
+    FoundationWeightAsset::from_nano512_readout_candidate(
+        &p,
+        p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::new(stage, 1, 1),
+    )
+    .unwrap()
+}
+fn base(asset: &FoundationWeightAsset) -> Nano512ActionCreditCandidateV2 {
+    Nano512ActionCreditCandidateV2::new(asset, ActionCandidateCreditProfileV1::SignedChoiceReadouts)
+        .unwrap()
+}
+fn need_source(p: &BrainPhenotype) -> u32 {
+    p.sensor_encoder()
+        .assignments()
+        .iter()
+        .find(|a| {
+            a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                && a.source_index() == 4
+                && a.scale() != 0.
+        })
+        .unwrap()
+        .target_neuron()
+}
+fn factors() -> [NanoDriveRoutingV1; 3] {
+    [
+        NanoDriveRoutingV1::ZeroDirectNeedMemoryGateV2,
+        NanoDriveRoutingV1::ConstantNeedMemoryGateV2,
+        NanoDriveRoutingV1::DirectNeedMemoryGateV2,
+    ]
+}
+
+#[test]
+fn direct_controls_append_bound_heads_and_preserve_old_prefix_and_birth_branches() {
+    let asset = source();
+    let base = base(&asset);
+    let (old, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&base).unwrap();
+    let n = old.synapses().len();
+    let sense = need_source(&old);
+    let reference = old
+        .lobe_layout()
+        .region(LobeKind::MemoryInterface)
+        .unwrap()
+        .start
+        + 8;
+    let motor = old.candidate_decoder().motor_start();
+    let original = (0..64)
+        .map(|i| {
+            DendriticBranch::new(
+                motor + i,
+                -1.,
+                6.,
+                vec![
+                    DendriticInputRef::new(motor + i, 1.).unwrap(),
+                    DendriticInputRef::new(motor + i + 1, 1.).unwrap(),
+                ],
+            )
+            .unwrap()
+        })
+        .collect::<Vec<_>>();
+    let mut dynamics = None;
+    let mut identities = std::collections::BTreeSet::new();
+    for factor in factors() {
+        let recipe = base.clone().with_drive_routing(factor);
+        let (p, inputs) =
+            PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+        assert_eq!(p.synapses().len(), n + 8);
+        assert!(&p.synapses()[..n] == old.synapses());
+        assert!(&p.projections()[..old.projections().len()] == old.projections());
+        assert_eq!(p.memory_decoder(), old.memory_decoder());
+        assert_eq!(
+            p.candidate_decoder().families(),
+            old.candidate_decoder().families()
+        );
+        assert_eq!(
+            p.candidate_decoder()
+                .memory_channel()
+                .unwrap()
+                .memory_decoder_synapse_count(),
+            104
+        );
+        assert!(
+            serde_json::to_vec(&factor.canonical_birth_branches(&p, &original).unwrap()).unwrap()
+                == serde_json::to_vec(&original).unwrap()
+        );
+        assert_eq!(
+            p.neuron_dynamics()[sense as usize].bias().to_bits(),
+            0.30_f32.to_bits()
+        );
+        assert_eq!(
+            p.neuron_dynamics()[reference as usize].bias().to_bits(),
+            0.30_f32.to_bits()
+        );
+        for (i, (a, b)) in p
+            .neuron_dynamics()
+            .iter()
+            .zip(old.neuron_dynamics())
+            .enumerate()
+        {
+            if i != sense as usize && i != reference as usize {
+                assert_eq!(a, b);
+            }
+        }
+        if let Some(d) = &dynamics {
+            assert!(p.neuron_dynamics() == d);
+        } else {
+            dynamics = Some(p.neuron_dynamics().to_vec());
+        }
+        let expected_source = if factor == NanoDriveRoutingV1::ConstantNeedMemoryGateV2 {
+            reference
+        } else {
+            sense
+        };
+        let expected_lobe = if factor == NanoDriveRoutingV1::ConstantNeedMemoryGateV2 {
+            LobeKind::MemoryInterface
+        } else {
+            LobeKind::InteroceptiveMotivational
+        };
+        assert_eq!(p.projections().last().unwrap().source_lobe(), expected_lobe);
+        for (family, s) in p.synapses()[n..].iter().enumerate() {
+            assert_eq!(s.source(), expected_source);
+            assert_eq!(s.genetic_weight(), factor.need_memory_weight().unwrap());
+            let CompiledSynapseKind::Decoder(c) = s.kind() else {
+                panic!("missing head")
+            };
+            assert_eq!(c.head(), DecoderHeadKind::NeedGatedMemoryContextV1);
+            assert_eq!(c.input_lane(), 32);
+            assert_eq!(c.family().raw() as usize, family);
+            let receptor = &p.plasticity_receptors()[s.receptor_index() as usize];
+            assert!(receptor.is_delta_enabled());
+            assert_eq!(
+                receptor.receptor_profile(),
+                ActionCandidateCreditProfileV1::SignedChoiceReadouts.receptor_profile()
+            );
+        }
+        assert!(identities.insert(p.foundation_abi().selector_digest()));
+        asset.validate_against(&p).unwrap();
+        assert_eq!(asset.weights().len(), n);
+        let restored: PhenotypeCompilerInputs =
+            serde_json::from_value(serde_json::to_value(inputs).unwrap()).unwrap();
+        assert!(
+            PhenotypeCompiler::compile_validated(&restored, &BrainCapacityClass::n512()).unwrap()
+                == p
+        );
+        let wire = serde_json::to_value(&p).unwrap();
+        let restored: BrainPhenotype = serde_json::from_value(wire.clone()).unwrap();
+        assert!(restored == p);
+        for wrong_source in [
+            if expected_source == sense {
+                reference
+            } else {
+                sense
+            },
+            sense + 1,
+        ] {
+            let mut bad = wire.clone();
+            bad["synapses"][n]["source"] = serde_json::json!(wrong_source);
+            assert!(serde_json::from_value::<BrainPhenotype>(bad).is_err());
+        }
+        let mut bad_weight = wire.clone();
+        bad_weight["synapses"][n]["genetic_weight"] = serde_json::json!(0.36);
+        assert!(serde_json::from_value::<BrainPhenotype>(bad_weight).is_err());
+        let mut missing_head = wire.clone();
+        missing_head["synapses"].as_array_mut().unwrap().pop();
+        assert!(serde_json::from_value::<BrainPhenotype>(missing_head).is_err());
+        for id in [sense, reference] {
+            let mut bad_bias = wire.clone();
+            bad_bias["neuron_dynamics"][id as usize]["bias"] = serde_json::json!(0.31);
+            assert!(serde_json::from_value::<BrainPhenotype>(bad_bias).is_err());
+        }
+        let mut bad_role = wire.clone();
+        let last = p.projections().len() - 1;
+        bad_role["projections"][last]["source_lobe"] =
+            serde_json::json!(if expected_lobe == LobeKind::MemoryInterface {
+                "InteroceptiveMotivational"
+            } else {
+                "MemoryInterface"
+            });
+        assert!(serde_json::from_value::<BrainPhenotype>(bad_role).is_err());
+        let mut bad = wire;
+        bad["foundation_abi_selection"] = serde_json::to_value(old.foundation_abi()).unwrap();
+        assert!(serde_json::from_value::<BrainPhenotype>(bad).is_err());
+    }
+}
+
+#[test]
+fn direct_identity_binds_constants_while_all_earlier_selector_bytes_remain_exact() {
+    let asset = source();
+    let base = base(&asset);
+    let bytes = asset.encode_canonical().unwrap();
+    assert_eq!(
+        NanoDriveRoutingV1::DIRECT_NEED_MEMORY_BIAS_V2.to_bits(),
+        0.30_f32.to_bits()
+    );
+    assert_eq!(
+        NanoDriveRoutingV1::DIRECT_NEED_MEMORY_WEIGHT_V2.to_bits(),
+        0.35_f32.to_bits()
+    );
+    for (factor, tag, selection, weight) in [
+        (None, None, None, 0.),
+        (Some(NanoDriveRoutingV1::ZeroBridge), Some(0), None, 0.),
+        (
+            Some(NanoDriveRoutingV1::AvailabilityBridge),
