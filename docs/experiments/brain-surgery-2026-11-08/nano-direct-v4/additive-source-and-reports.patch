@@ -0,0 +1,303 @@
+//! Bounded disposable fixture, not an autonomous allocation or learned asset.
+use alife_core::*;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask, TrainingSequence};
+use alife_world::*;
+use serde_json::json;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+fn pressure_frame(frame: &PerceptionFrame, pressure: f32) -> Result<PerceptionFrame> {
+    let mut h = *frame.homeostasis();
+    h.drives.loneliness = pressure;
+    Ok(PerceptionFrame::new(
+        frame.organism_id(),
+        frame.tick(),
+        frame.sensor_profile(),
+        frame.sensory().clone(),
+        frame.body(),
+        h,
+        frame.candidates().to_vec(),
+        frame.profile_provenance(),
+        frame.grounded_object_slots().to_vec(),
+    )?)
+}
+fn main() -> Result<()> {
+    let out = std::env::args().nth(1).ok_or("output path required")?;
+    let preflight = std::env::args().nth(2).as_deref() == Some("--preflight");
+    let mut executed_world_intervals = 0_u32;
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let source = FoundationWeightAsset::builtin_nano512_v1(profile)?;
+    let (p, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &source)?
+            .into_runtime_parts();
+    let asset = FoundationWeightAsset::from_nano512_readout_candidate(
+        &p,
+        p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )?;
+    let mut results = Vec::new();
+    let mut matched_initials = std::collections::BTreeMap::new();
+    let mut matched_worlds = std::collections::BTreeMap::new();
+    for factor in [
+        None,
+        Some(NanoDriveRoutingV1::ZeroDirectNeedMemoryGateV2),
+        Some(NanoDriveRoutingV1::ConstantNeedMemoryGateV2),
+        Some(NanoDriveRoutingV1::DirectNeedMemoryGateV2),
+    ] {
+        let mut recipe = Nano512ActionCreditCandidateV2::new(
+            &asset,
+            ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+        )?;
+        if let Some(f) = factor {
+            recipe = recipe.with_drive_routing(f);
+        }
+        let (p, inputs) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe)?;
+        let trainer = CpuFoundationTrainer::new(
+            p.clone(),
+            asset.clone(),
+            StageTrainableMask::recurrent_only(&p)?,
+            AdamWConfig::default(),
+        )?;
+        let new_head_ids: Vec<usize> = p.synapses().iter().enumerate().filter_map(|(id,s)|
+            matches!(s.kind(), CompiledSynapseKind::Decoder(c) if c.head() == DecoderHeadKind::NeedGatedMemoryContextV1).then_some(id)).collect();
+        let pressure_source = p
+            .sensor_encoder()
+            .assignments()
+            .iter()
+            .find(|a| {
+                a.source_group() == SensorEncoderSourceGroup::Homeostasis && a.source_index() == 4
+            })
+            .unwrap()
+            .target_neuron() as usize;
+        let reference_source = (p
+            .lobe_layout()
+            .region(LobeKind::MemoryInterface)
+            .unwrap()
+            .start
+            + 8) as usize;
+        let original_optimizer = serde_json::to_vec(&trainer.checkpoint())?;
+        for peer in [false, true] {
+            for need in [0.0_f32, 0.15] {
+                let config = CanonicalNewGameConfig::phase3(41, 1)?;
+                let mut game =
+                    create_canonical_new_game_with_nociceptive_candidate(&config, &recipe)?;
+                let old = game
+                    .world
+                    .organism_registry()
+                    .get(OrganismId(1))
+                    .unwrap()
+                    .clone();
+                let mut world = HeadlessScenarioBuilder::new(41)
+                    .agent("subject", OrganismId(1), Vec3f::ZERO)
+                    .build()?;
+                let target = if peer {
+                    world.spawn_social_agent(
+                        "observed target",
+                        OrganismId(2),
+                        Vec3f::new(0.2, 0., 0.),
+                        0.,
+                    )?
+                } else {
+                    world.spawn_toy("observed target", Vec3f::new(0.2, 0., 0.), false)?
+                };
+                let props = GroundedPhysicalProperties::deterministic_for_kind(
+                    WorldObjectKind::ActivityToy,
+                    2,
+                );
+                world.set_grounded_physical_properties(target, props)?;
+                let graph = &old.phenotype().chemistry.biochemical;
+                let receptor = graph
+                    .receptors()
+                    .iter()
+                    .find(|r| {
+                        r.target
+                            == BiochemicalTargetLocus::Drive(BiochemicalDriveChannel::Loneliness)
+                    })
+                    .ok_or("missing loneliness receptor")?;
+                let index = graph
+                    .species()
+                    .iter()
+                    .position(|s| s.id == receptor.source)
+                    .unwrap();
+                let concentration =
+                    (receptor.threshold + (need - receptor.nominal) / receptor.gain).clamp(
+                        graph.species()[index].minimum,
+                        graph.species()[index].maximum,
+                    );
+                let mut wire = serde_json::to_value(old.biochemistry())?;
+                wire["graph_state"]["concentrations"][index] = json!(concentration);
+                let state: BiochemicalGraphState =
+                    serde_json::from_value(wire["graph_state"].clone())?;
+                wire["homeostasis"] = serde_json::to_value(state.derive_homeostasis(graph)?)?;
+                let biology: BiochemistryState = serde_json::from_value(wire)?;
+                biology.validate_against(old.phenotype())?;
+                world.register_organism_record(WorldOrganismRecord::new(
+                    OrganismId(1),
+                    world.entity_id("subject").unwrap(),
+                    old.genome().clone(),
+                    old.phenotype().clone(),
+                    biology,
+                    old.birth_tick(),
+                )?)?;
+                let matched = json!({"body":old.phenotype().body,"chemistry":old.phenotype().chemistry,
+                    "development":old.phenotype().development,"reproduction":old.phenotype().reproduction,
+                    "predisposition":old.phenotype().predisposition,"plasticity":old.phenotype().brain_genome.plasticity_parameters(),
+                    "biology":biology});
+                let match_key = format!("peer={peer} need={need}");
+                if factor.is_none() {
+                    matched_initials.insert(match_key.clone(), matched.clone());
+                    matched_worlds.insert(match_key.clone(), world.object_snapshots());
+                } else {
+                    assert_eq!(
+                        matched_worlds.get(&match_key),
+                        Some(&world.object_snapshots()),
+                        "matched typed physical world objects"
+                    );
+                    assert_eq!(
+                        matched_initials.get(&match_key),
+                        Some(&matched),
+                        "matched constructor, biology, learning and physical world"
+                    );
+                }
+                if preflight {
+                    results.push(json!({"factor":factor,"peer":peer,"need":need,"matched_initial_state_verified":true,"phenotype_hash":p.phenotype_hash(),"inputs_digest":inputs.canonical_digest(),"source_asset":asset.digest(),"new_head_initial_genetic_bits":new_head_ids.iter().map(|&id|trainer.weights()[id].to_bits()).collect::<Vec<_>>()}));
+                    continue;
+                }
+                game.world = world;
+                let mut host = CpuCanonicalHost::new_cohort(game, &trainer, 41)?;
+                let mut rows = Vec::new();
+                let mut counterfactuals = Vec::new();
+                let mut last_replay_context = None;
+                let mut new_offset_max = 0.0_f32;
+                let mut new_weight_max = 0.0_f32;
+                for interval in 0..32 {
+                    let step = host.step(&trainer, 1.)?;
+                    executed_world_intervals += 1;
+                    for row in step.decisions {
+                        let eval = trainer.evaluate_replay(&TrainingSequence {
+                            phenotype_hash: p.phenotype_hash(),
+                            initial: row.initial.clone(),
+                            ticks: vec![row.replay_tick.clone()],
+                            burn_in_ticks: 0,
+                            memory_candidate_gain: p
+                                .candidate_decoder()
+                                .memory_channel()
+                                .map_or(0., |m| m.max_candidate_gain()),
+                        })?;
+                        let mut ablated_tick = row.replay_tick.clone();
+                        for &id in &new_head_ids {
+                            ablated_tick.effective_weight_offsets[id] = -trainer.weights()[id];
+                        }
+                        let ablated = trainer.evaluate_replay(&TrainingSequence {
+                            phenotype_hash: p.phenotype_hash(),
+                            initial: row.initial.clone(),
+                            ticks: vec![ablated_tick],
+                            burn_in_ticks: 0,
+                            memory_candidate_gain: p
+                                .candidate_decoder()
+                                .memory_channel()
+                                .map_or(0., |m| m.max_candidate_gain()),
+                        })?;
+                        let new_contributions: Vec<f32> = eval.candidate_logits[0]
+                            .iter()
+                            .zip(&ablated.candidate_logits[0])
+                            .map(|(a, b)| a - b)
+                            .collect();
+                        let contribution_abs_max = new_contributions
+                            .iter()
+                            .map(|v| v.abs())
+                            .fold(0.0_f32, f32::max);
+                        let mut ordered_logits = eval.candidate_logits[0].clone();
+                        ordered_logits.sort_by(|a, b| b.total_cmp(a));
+                        let global_top_gap = (ordered_logits.len() > 1)
+                            .then(|| ordered_logits[0] - ordered_logits[1]);
+                        for &id in &new_head_ids {
+                            new_offset_max = new_offset_max
+                                .max(row.replay_tick.effective_weight_offsets[id].abs());
+                            new_weight_max = new_weight_max.max(
+                                (trainer.weights()[id]
+                                    + row.replay_tick.effective_weight_offsets[id])
+                                    .abs(),
+                            );
+                        }
+                        last_replay_context = Some(TrainingSequence {
+                            phenotype_hash: p.phenotype_hash(),
+                            initial: row.initial.clone(),
+                            ticks: vec![row.replay_tick.clone()],
+                            burn_in_ticks: 0,
+                            memory_candidate_gain: p
+                                .candidate_decoder()
+                                .memory_channel()
+                                .map_or(0., |m| m.max_candidate_gain()),
+                        });
+                        if interval == 31 {
+                            let frame = row.patch.pre_action().perception();
+                            let before = &row
+                                .patch
+                                .outcome()
+                                .measured_physiology
+                                .as_ref()
+                                .ok_or("missing measured physiology")?
+                                .before;
+                            let effects = NeuralReceptorEffects::from_frame(
+                                &before.neural_receptor_frame(old.phenotype())?,
+                                &NeuralReceptorPhenotype::compile(&p)?,
+                            )?;
+                            let encoded = encode_cpu_neural_inputs(&p, frame, &effects)?;
+                            assert_eq!(
+                                encoded, row.replay_tick.encoded_inputs,
+                                "exact actual native encoder reconstruction"
+                            );
+
+                            for pressure in [0.0_f32, 0.05, 0.15, 0.8] {
+                                let changed = pressure_frame(frame, pressure)?;
+                                let encoded = encode_cpu_neural_inputs(&p, &changed, &effects)?;
+                                for clear_recall in [false, true] {
+                                    for zero_effective_new_head in [false, true] {
+                                        let mut tick = row.replay_tick.clone();
+                                        tick.encoded_inputs = encoded.clone();
+                                        if clear_recall {
+                                            for c in &mut tick.candidates {
+                                                c.decoder_inputs[32] = 0.;
+                                            }
+                                        }
+                                        if zero_effective_new_head {
+                                            for &id in &new_head_ids {
+                                                tick.effective_weight_offsets[id] =
+                                                    -trainer.weights()[id];
+                                            }
+                                        }
+                                        for frames in [1_usize, 8, 32] {
+                                            let q = TrainingSequence {
+                                                phenotype_hash: p.phenotype_hash(),
+                                                initial: row.initial.clone(),
+                                                ticks: vec![tick.clone(); frames],
+                                                burn_in_ticks: 0,
+                                                memory_candidate_gain: p
+                                                    .candidate_decoder()
+                                                    .memory_channel()
+                                                    .map_or(0., |m| m.max_candidate_gain()),
+                                            };
+                                            let measured = trainer.evaluate_replay(&q)?;
+                                            counterfactuals.push(json!({"pressure":pressure,"clear_lane32":clear_recall,"zero_effective_new_head":zero_effective_new_head,"frames":frames,
+                                                "microsteps":frames*tick.microstep_count as usize,"actual_recall":tick.candidates.iter().map(|c|(c.family,c.decoder_inputs[32])).collect::<Vec<_>>(),
+                                                "final_logits":measured.candidate_logits.last(),"final_pressure_source":measured.final_activations.last().map(|v|v[pressure_source]),
+                                                "final_reference_source":measured.final_activations.last().map(|v|v[reference_source])}));
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                        rows.push(json!({"action":row.action,"frame":row.patch.pre_action().perception(),"outcome":row.patch.outcome(),"reward":row.biological_reward,"logits":eval.candidate_logits,"brain_work":row.brain_work,"policy_temperature":row.action.temperature,"new_port_contribution":new_contributions,"new_port_contribution_abs_max":contribution_abs_max,"global_candidate_top_gap_not_conditional_sampler_gap":global_top_gap,"new_port_abs_max_over_temperature":contribution_abs_max/row.action.temperature,"microsteps":row.replay_tick.microstep_count,"replay_dendrites":row.initial.dendrites,"memory_inputs":row.replay_tick.candidates.iter().map(|c| (c.family,c.decoder_inputs[32])).collect::<Vec<_>>()}));
+                    }
+                }
+                results.push(json!({"factor":factor,"peer_body_fixture":peer,"requested_loneliness":need,"matched_initial_state_verified":true,"initial_biology":biology,"final_biology":host.world().organism_registry().get(OrganismId(1)).unwrap().biochemistry(),"phenotype_hash":p.phenotype_hash(),"inputs_digest":inputs.canonical_digest(),"rows":rows,"detached_counterfactuals":counterfactuals,"last_replay_context_local_only":last_replay_context,"new_head_effective_offset_abs_max":new_offset_max,"new_head_effective_weight_abs_max":new_weight_max,"new_head_initial_genetic_bits":new_head_ids.iter().map(|&i|trainer.weights()[i].to_bits()).collect::<Vec<_>>()}));
+            }
+        }
+        assert_eq!(
+            original_optimizer,
+            serde_json::to_vec(&trainer.checkpoint())?
+        );
+    }
+    use std::io::Write;
+    std::fs::OpenOptions::new().write(true).create_new(true).open(out)?.write_all(&serde_json::to_vec_pretty(&json!({"scope":"16 fixed disposable native CPU contexts x32 world intervals; zero means inherited initial weight, not disabled lifetime learning; no optimizer update or autonomous allocation; unregistered peer body is a controlled physical fixture", "source":"nano-direct-need-gate-v4","counterfactual_semantics":"last actual replay state and learned offsets/recall held fixed; native encoder drive substitution with actual chemistry effects held fixed; optional exact zero-effective head; not an alternate acted life", "source_asset":asset.digest(),"preflight_only":preflight,"executed_world_intervals":executed_world_intervals,"results":results}))?)?;
+    Ok(())
+}
diff --git a/crates/alife_training/examples/probe_nano_operating_point.rs b/crates/alife_training/examples/probe_nano_operating_point.rs
new file mode 100644
index 0000000..bc21601
--- /dev/null
+++ b/crates/alife_training/examples/probe_nano_operating_point.rs
@@ -0,0 +1,296 @@
+//! Reads a closed public fixture artifact. No world intervals, optimizer, private
+//! checkpoint restore, synthesized recall, or candidate parameters are changed.
+use alife_core::*;
+use alife_gpu_backend::GpuV11CausalState;
+use alife_training::cpu::encode_cpu_neural_inputs;
+use alife_world::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::io::Write;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const DRIVE_NAMES: [&str; 11] = [
+    "hunger",
+    "fatigue",
+    "fear",
+    "pain",
+    "loneliness",
+    "curiosity",
+    "brain_atp",
+    "temperature_stress",
+    "reproductive_drive",
+    "extension0",
+    "extension1",
+];
+
+fn substituted_frame(
+    frame: &PerceptionFrame,
+    lane: usize,
+    pressure: f32,
+) -> Result<PerceptionFrame> {
+    let mut h = *frame.homeostasis();
+    match lane {
+        0 => h.drives.hunger = pressure,
+        1 => h.drives.fatigue = pressure,
+        2 => h.drives.fear = pressure,
+        3 => h.drives.pain = pressure,
+        4 => h.drives.loneliness = pressure,
+        5 => h.drives.curiosity = pressure,
+        6 => h.drives.brain_atp = pressure,
+        7 => h.drives.temperature_stress = pressure,
+        8 => h.drives.reproductive_drive = pressure,
+        9 | 10 => h.drives.extension[lane - 9] = pressure,
+        _ => return Err("invalid drive lane".into()),
+    }
+    // This is only an encoder counterfactual. No recall/context receipt from the
+    // old frame is attached to the changed base, and chemistry effects stay fixed.
+    Ok(PerceptionFrame::new(
+        frame.organism_id(),
+        frame.tick(),
+        frame.sensor_profile(),
+        frame.sensory().clone(),
+        frame.body(),
+        h,
+        frame.candidates().to_vec(),
+        frame.profile_provenance(),
+        frame.grounded_object_slots().to_vec(),
+    )?)
+}
+
+fn node_terms(
+    p: &BrainPhenotype,
+    branches: &DendriticBranchSet,
+    effects: &NeuralReceptorEffects,
+    encoded: &[f32],
+    id: u32,
+) -> Value {
+    let d = &p.neuron_dynamics()[id as usize];
+    let incoming = p.synapses().iter().enumerate().filter_map(|(index, s)| {
+        if s.target() != id || !matches!(s.kind(), CompiledSynapseKind::Recurrent) { return None; }
+        Some(json!({"global_synapse":index,"source":s.source(),"genetic_weight":s.genetic_weight(),
+            "alpha":s.alpha(),"route":s.route_index(),"cadence":p.projections()[s.route_index() as usize].update_cadence(),
+            "somatic_offset":"not recorded; no claim to know actual effective weight"}))
+    }).collect::<Vec<_>>();
+    let base = d.bias() + encoded[id as usize] - effects.local_threshold_shift;
+    json!({"id":id,"dynamics":d,"encoded_input":encoded[id as usize],
+        "bias_plus_encoded_minus_local_threshold":base,
+        "preactivation_interval_if_recurrent_and_dendritic_sums_zero":[base-d.homeostatic_gain(),base],
+        "compiled_recurrent_inputs":incoming,
+        "recorded_dendritic_branches":branches.branches().iter().filter(|b| b.target==id).collect::<Vec<_>>(),
+        "native_update":"a_next=(1-leak)*a+leak*tanh(bias+encoded+projection_gain*(recurrent+dendritic)-homeostatic_gain*metabolic-local_threshold); metabolic_next=clamp(decay*metabolic+(1-decay)*a_next^2,0,1)",
+        "cadence_note":"compiled recurrent route cadence varies; dendritic branches are evaluated every executed microstep"})
+}
+
+fn scalar_fixed_point(base: f32, gain: f32) -> Option<f32> {
+    // A local analytical consistency check only, for a closed branch with no
+    // recurrent sum. At equilibrium m=a^2. Find roots by sign-bracketed bisection.
+    let f = |a: f32| a - (base - gain * a * a).tanh();
+    let mut roots = Vec::new();
+    for i in 0..2000 {
+        let mut lo = -1. + i as f32 / 1000.;
+        let mut hi = lo + 0.001;
+        if f(lo) * f(hi) > 0. {
+            continue;
+        }
+        for _ in 0..32 {
+            let mid = (lo + hi) * 0.5;
+            if f(lo) * f(mid) <= 0. {
+                hi = mid;
+            } else {
+                lo = mid;
+            }
+        }
+        roots.push((lo + hi) * 0.5);
+    }
+    roots.into_iter().min_by(|a, b| a.abs().total_cmp(&b.abs()))
+}
+
+fn main() -> Result<()> {
+    let args = std::env::args().collect::<Vec<_>>();
+    if args.len() != 3 {
+        return Err("usage: probe_nano_operating_point CLOSED_ARTIFACT OUTPUT_NEW_JSON".into());
+    }
+    let raw = std::fs::read(&args[1])?;
+    let input_sha256 = format!("{:x}", Sha256::digest(&raw));
+    assert_eq!(
+        input_sha256,
+        "6f0e21260fec2885bee195cd32b9b7955579fd96e4fd68a49106aa7e27e98a92"
+    );
+    let artifact: Value = serde_json::from_slice(&raw)?;
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let builtin = FoundationWeightAsset::builtin_nano512_v1(profile)?;
+    let (old, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &builtin)?
+            .into_runtime_parts();
+    let asset = FoundationWeightAsset::from_nano512_readout_candidate(
+        &old,
+        old.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )?;
+    assert_eq!(
+        artifact["source_asset"],
+        serde_json::to_value(asset.digest())?
