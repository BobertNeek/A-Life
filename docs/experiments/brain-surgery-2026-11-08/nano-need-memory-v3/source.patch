+                .iter()
+                .map(|s| s.genetic_weight())
+                .collect(),
+            TrainingStageManifest::new(1, 1, 1),
+        )
+        .unwrap();
+        let recipe = Nano512ActionCreditCandidateV2::new(
+            &asset,
+            ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+        )
+        .unwrap()
+        .with_drive_routing(NanoDriveRoutingV1::NeedMemoryGate);
+        let (p, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+        let mask = crate::StageTrainableMask::recurrent_only(&p).unwrap();
+        let founder =
+            CpuFoundationTrainer::new(p, asset, mask, crate::AdamWConfig::default()).unwrap();
+        let p = founder.phenotype();
+        for activation in [-0.6_f32, 0., 0.6] {
+            for sample in [-0.4_f32, 0., 0.4] {
+                let state =
+                    staged_fixture_inputs(&founder, false, false, 0, activation, [sample, -sample]);
+                let staged = state.pending.as_ref().unwrap().staged.as_ref().unwrap();
+                let mut gated = 0;
+                for (i, s) in p.synapses().iter().enumerate() {
+                    let CompiledSynapseKind::Decoder(c) = s.kind() else {
+                        continue;
+                    };
+                    if !matches!(
+                        c.head(),
+                        DecoderHeadKind::MemoryContext | DecoderHeadKind::NeedGatedMemoryContextV1
+                    ) {
+                        continue;
+                    }
+                    let previous = 0.4
+                        * p.plasticity_receptors()[s.receptor_index() as usize]
+                            .eligibility_decay()
+                            .powi(3);
+                    let local = if c.family() != CandidateActionFamily::Inspect {
+                        0.
+                    } else if c.head() == DecoderHeadKind::NeedGatedMemoryContextV1 {
+                        activation.max(0.) * sample
+                    } else {
+                        sample
+                    };
+                    let expected = (previous + local).clamp(-1., 1.);
+                    assert!(
+                        (staged[i] - expected).abs() < 2e-6,
+                        "head={:?}, source={activation}, sample={sample}: {} != {expected}",
+                        c.head(),
+                        staged[i]
+                    );
+                    gated += usize::from(c.head() == DecoderHeadKind::NeedGatedMemoryContextV1);
+                }
+                assert_eq!(gated, 8);
+            }
+        }
+    }
