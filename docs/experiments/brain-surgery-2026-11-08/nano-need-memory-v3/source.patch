+    let (p, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+    let start = p.candidate_decoder().motor_start();
+    let count = usize::from(p.cognitive_architecture_plan().dendritic_branch_capacity())
+        .max(1)
+        .min(usize::from(p.candidate_decoder().motor_width()))
+        .min(64);
+    let mut branches: Vec<_> = (0..count)
+        .map(|i| {
+            let target = start + i as u32;
+            DendriticBranch::new(
+                target,
+                -1.,
+                6.,
+                vec![
+                    DendriticInputRef::new(target, 1.).unwrap(),
+                    DendriticInputRef::new(
+                        if target + 1 < p.neuron_count() {
+                            target + 1
+                        } else {
+                            target - 1
+                        },
+                        1.,
+                    )
+                    .unwrap(),
+                ],
+            )
+            .unwrap()
+        })
+        .collect();
+    if let Some(f) = factor {
+        branches = f.canonical_birth_branches(&p, &branches).unwrap();
+    }
+    (p, DendriticBranchSet::new(branches).unwrap())
+}
+fn diagnostic_drive_lane(lane: usize, value: f32) -> DriveSnapshot {
+    let mut d = DriveSnapshot::baseline();
+    match lane {
+        0 => d.hunger = value,
+        1 => d.fatigue = value,
+        2 => d.fear = value,
+        3 => d.pain = value,
+        4 => d.loneliness = value,
+        5 => d.curiosity = value,
+        6 => d.brain_atp = value,
+        7 => d.temperature_stress = value,
+        8 => d.reproductive_drive = value,
+        9 => d.extension[0] = value,
+        10 => d.extension[1] = value,
+        _ => panic!("drive lane"),
+    };
+    d
+}
+#[test]
+fn nano_drive_routing_repeated_native_availability_and_readout_controls() {
+    for factor in [
+        None,
+        Some(NanoDriveRoutingV1::ZeroBridge),
+        Some(NanoDriveRoutingV1::AvailabilityBridge),
+    ] {
+        let (p, branches) = nano_routing_fixture(factor);
+        let motor = p.lobe_layout().region(LobeKind::ActionPlanning).unwrap();
+        let mut world = HeadlessScenarioBuilder::new(41)
+            .agent("subject", SUBJECT, Vec3f::ZERO)
+            .build()
+            .unwrap();
+        let target = world
+            .spawn_toy("target", Vec3f::new(2., 0., 0.), false)
+            .unwrap();
+        for lane in 0..11 {
+            for frames in [1, 4, 16, 32] {
+                let mut results = Vec::new();
+                for value in [0.1, 0.8] {
+                    let drives = diagnostic_drive_lane(lane, value);
+                    let frame =
+                        draft_profile(&mut world, drives, SensorProfile::GroundedObjectSlotsV1);
+                    let activation = fixed_context_with_branches(&p, &frame, frames, &branches);
+                    let scores: Vec<_> = frame
+                        .candidates()
+                        .iter()
+                        .map(|c| decode(&p, &activation, *c, drives).0)
+                        .collect();
+                    results.push((activation, scores));
+                }
+                let neural = results[0].0[motor.start as usize..motor.end() as usize]
+                    .iter()
+                    .zip(&results[1].0[motor.start as usize..motor.end() as usize])
+                    .map(|(a, b)| (a - b).abs())
+                    .fold(0., f32::max);
+                let deltas: Vec<_> = results[1]
+                    .1
+                    .iter()
+                    .zip(&results[0].1)
+                    .map(|(b, a)| b - a)
+                    .collect();
+                println!("nano bridge factor={factor:?} lane={lane} frames={frames} microsteps={} motor_delta={neural:.9} score_deltas={deltas:?} target={target:?} hash={:?}",u32::from(p.microstep_count())*frames,p.phenotype_hash());
+                assert!(deltas.iter().all(|x| x.is_finite()));
+                if factor == Some(NanoDriveRoutingV1::AvailabilityBridge) && frames >= 4 {
+                    assert!(
+                        neural > 0.,
+                        "lane{lane} bridge must reach actual planning units"
+                    );
+                }
+            }
+        }
+    }
+}
