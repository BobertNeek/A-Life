+                    0xC600_0020,
+                    902,
+                    profile,
+                    true,
+                    1,
+                );
+                let draft = memory_draft_from_frame(&source);
+                let bank = MemoryBank::new(
+                    MemoryBankConfig::new(8, 64, 4, 0.72, Confidence::new(0.).unwrap()).unwrap(),
+                )
+                .unwrap();
+                bank.recall_frame(&draft).unwrap().finalize(draft).unwrap()
+            };
+            let family = u32::from(frame.candidates()[0].family.raw());
+            let metadata = upload
+                .decoder_eligibility_metadata
+                .iter()
+                .find(|m| {
+                    m.decoder_head == DecoderHeadKind::NeedGatedMemoryContextV1.raw()
+                        && m.family == family
