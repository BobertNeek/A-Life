+fn source() -> FoundationWeightAsset {
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let source = FoundationWeightAsset::builtin_nano512_v1(profile).unwrap();
+    let (p, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &source)
+            .unwrap()
+            .into_runtime_parts();
+    FoundationWeightAsset::from_nano512_readout_candidate(
+        &p,
+        p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )
+    .unwrap()
+}
+fn trainer(recipe: &Nano512ActionCreditCandidateV2) -> CpuFoundationTrainer {
+    let (p, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(recipe).unwrap();
+    let mask = StageTrainableMask::recurrent_only(&p).unwrap();
+    CpuFoundationTrainer::new(p, recipe.asset().unwrap(), mask, AdamWConfig::default()).unwrap()
+}
+fn game(recipe: &Nano512ActionCreditCandidateV2) -> CanonicalNewGame {
+    create_canonical_new_game_with_nociceptive_candidate(
+        &CanonicalNewGameConfig::phase3(41, 1).unwrap(),
+        recipe,
+    )
+    .unwrap()
+}
+#[test]
+fn explicit_nano_host_admits_exact_recipe_and_rejects_cross_recipe_restore() {
+    let base = Nano512ActionCreditCandidateV2::new(
+        &source(),
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let zero = base
+        .clone()
+        .with_drive_routing(NanoDriveRoutingV1::ZeroBridge);
+    let active = base
+        .clone()
+        .with_drive_routing(NanoDriveRoutingV1::AvailabilityBridge);
+    let z = trainer(&zero);
+    let a = trainer(&active);
+    assert!(CpuCanonicalHost::new_cohort(game(&zero), &a, 41).is_err());
+    assert!(CpuCanonicalHost::new_cohort(game(&active), &z, 41).is_err());
+    let mut host = CpuCanonicalHost::new_cohort(game(&active), &a, 41).unwrap();
+    let before = host.checkpoint(&a).unwrap();
+    assert!(CpuCanonicalHost::from_checkpoint(before.clone(), &z).is_err());
+    let mut restored = CpuCanonicalHost::from_checkpoint(before, &a).unwrap();
+    host.step(&a, 1.).unwrap();
+    restored.step(&a, 1.).unwrap();
+    assert_eq!(
+        serde_json::to_value(host.checkpoint(&a).unwrap()).unwrap(),
+        serde_json::to_value(restored.checkpoint(&a).unwrap()).unwrap()
+    );
+    let default = create_canonical_new_game(
+        &CanonicalNewGameConfig::phase3(41, 1).unwrap(),
+        &FoundationWeightAsset::builtin_nano512_v1(SensorProfile::GroundedObjectSlotsV1).unwrap(),
+    )
+    .unwrap();
+    assert!(CpuCanonicalHost::new_cohort(default, &a, 41).is_err());
+}
+#[test]
+fn explicit_nano_host_rejects_other_source_asset_and_profile() {
+    let base = Nano512ActionCreditCandidateV2::new(
+        &source(),
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    // This foundation has no terrain-profile asset: rejection occurs before host admission.
+    assert!(
+        FoundationWeightAsset::builtin_nano512_v1(SensorProfile::GroundedTerrainVisionV1).is_err()
+    );
+    let p = PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(
+        SensorProfile::GroundedObjectSlotsV1,
+        &FoundationWeightAsset::builtin_nano512_v1(SensorProfile::GroundedObjectSlotsV1).unwrap(),
+    )
+    .unwrap()
+    .into_runtime_parts()
+    .0;
+    let mut weights = p
+        .synapses()
+        .iter()
+        .map(|s| s.genetic_weight())
+        .collect::<Vec<_>>();
+    let id=p.synapses().iter().position(|s|matches!(s.kind(),CompiledSynapseKind::Decoder(c) if c.head()==DecoderHeadKind::ActionCandidate)).unwrap();
+    weights[id] += 0.01;
+    let different = FoundationWeightAsset::from_nano512_readout_candidate(
+        &p,
+        weights,
+        TrainingStageManifest::new(1, 1, 1),
+    )
+    .unwrap();
+    let other = Nano512ActionCreditCandidateV2::new(
+        &different,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    assert!(CpuCanonicalHost::new_cohort(game(&base), &trainer(&other), 41).is_err());
+}
+
+#[test]
+fn nano_admission_validates_expression_but_preserves_legitimate_inherited_learning() {
+    let base = Nano512ActionCreditCandidateV2::new(
+        &source(),
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let trainer = trainer(&base);
+    let mut fresh = game(&base);
+    let old = fresh
+        .world
+        .organism_registry()
+        .get(OrganismId(1))
+        .unwrap()
+        .clone();
+    let mut genome = old.genome().clone();
+    let mut learning = serde_json::to_value(genome.brain.construction.maternal_learning).unwrap();
+    learning["base_learning_rate"] = serde_json::json!(0.005);
+    let learning: PlasticityGenomeParameters = serde_json::from_value(learning).unwrap();
+    genome.brain.construction.maternal_learning = learning;
+    genome.brain.construction.paternal_learning = learning;
+    let phenotype = genome.express().unwrap();
+    assert_ne!(
+        phenotype.brain_genome.plasticity_parameters(),
+        old.phenotype().brain_genome.plasticity_parameters()
+    );
+    let record = WorldOrganismRecord::newborn(
+        OrganismId(1),
+        old.world_entity_id(),
+        genome,
+        phenotype,
+        Tick::ZERO,
+    )
+    .unwrap();
+    record.validate_contract().unwrap();
+    fresh
+        .world
+        .replace_organism_record_exact(record.clone())
+        .unwrap();
+    let host = CpuCanonicalHost::new_cohort(fresh, &trainer, 41).unwrap();
+    let checkpoint = host.checkpoint(&trainer).unwrap();
+    CpuCanonicalHost::from_checkpoint(checkpoint, &trainer).unwrap();
+    let mut wire = serde_json::to_value(&record).unwrap();
+    let original = serde_json::to_value(&old).unwrap();
+    wire["phenotype"] = original["phenotype"].clone();
+    match serde_json::from_value::<WorldOrganismRecord>(wire) {
+        Err(_) => {}
+        Ok(forged) => assert!(forged.validate_contract().is_err()),
+    }
+}
+
+#[test]
+fn need_memory_gate_checkpoint_rejects_zero_control_and_resumes_exactly() {
+    let base = Nano512ActionCreditCandidateV2::new(
+        &source(),
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
