index 0000000..a3c912d
--- /dev/null
+++ b/crates/alife_core/tests/nano_need_memory_gate.rs
@@ -0,0 +1,77 @@
+use alife_core::*;
+fn source() -> FoundationWeightAsset {
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let a = FoundationWeightAsset::builtin_nano512_v1(profile).unwrap();
+    let (p, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &a)
+            .unwrap()
+            .into_runtime_parts();
+    FoundationWeightAsset::from_nano512_readout_candidate(
+        &p,
+        p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )
+    .unwrap()
+}
+#[test]
+fn explicit_need_port_is_append_only_and_old_memory_semantics_stay_bound() {
+    let recipe = Nano512ActionCreditCandidateV2::new(
+        &source(),
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let (old, old_inputs) =
+        PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+    let n = old.synapses().len();
+    let mut prior = None;
+    for factor in [
+        NanoDriveRoutingV1::ZeroNeedMemoryGate,
+        NanoDriveRoutingV1::NeedMemoryGate,
+    ] {
+        let configured = recipe.clone().with_drive_routing(factor);
+        let (p, inputs) =
+            PhenotypeCompiler::compile_nano512_action_credit_candidate(&configured).unwrap();
+        assert_eq!(p.synapses().len(), n + 8);
+        assert_eq!(&p.synapses()[..n], old.synapses());
+        assert_eq!(
+            &p.projections()[..old.projections().len()],
+            old.projections()
+        );
+        assert_eq!(
+            p.candidate_decoder().families(),
+            old.candidate_decoder().families()
+        );
+        assert_eq!(
+            p.candidate_decoder()
+                .memory_channel()
+                .unwrap()
+                .memory_decoder_synapse_count(),
+            104
+        );
+        assert_ne!(inputs.canonical_digest(), old_inputs.canonical_digest());
+        assert_ne!(p.phenotype_hash(), old.phenotype_hash());
+        let encoded = serde_json::to_vec(&inputs).unwrap();
+        let decoded: PhenotypeCompilerInputs = serde_json::from_slice(&encoded).unwrap();
+        assert_eq!(
+            PhenotypeCompiler::compile_validated(&decoded, &BrainCapacityClass::n512()).unwrap(),
+            p
+        );
+        configured.asset().unwrap().validate_against(&p).unwrap();
+        for s in &p.synapses()[n..] {
+            assert_eq!(s.genetic_weight(), factor.need_memory_weight().unwrap());
+            assert!(
+                matches!(s.kind(),CompiledSynapseKind::Decoder(c) if c.head()==DecoderHeadKind::NeedGatedMemoryContextV1 && c.input_lane()==32)
+            );
+        }
+        if let Some((zero, zero_inputs)) = prior {
+            assert_ne!(p.phenotype_hash(), zero);
+            assert_ne!(inputs.canonical_digest(), zero_inputs);
+        }
+        prior = Some((p.phenotype_hash(), inputs.canonical_digest()));
+        // Wrong identity cannot accept a gated graph merely because its array sizes fit.
+        let mut malformed = serde_json::to_value(&p).unwrap();
+        let plain = serde_json::to_value(&old).unwrap();
+        malformed["foundation_abi_selection"] = plain["foundation_abi_selection"].clone();
+        assert!(serde_json::from_value::<BrainPhenotype>(malformed).is_err());
+    }
+}
