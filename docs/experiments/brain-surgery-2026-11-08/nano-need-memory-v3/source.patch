+/// Explicit fresh-birth routing factor. It changes neither fixed synapse
+/// coordinates nor the interpretation of an existing checkpoint.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum NanoDriveRoutingV1 {
+    ZeroBridge,
+    AvailabilityBridge,
+    ZeroNeedMemoryGate,
+    NeedMemoryGate,
+}
+
+impl NanoDriveRoutingV1 {
+    pub const fn output_gain(self) -> f32 {
+        match self {
+            Self::ZeroBridge => 0.0,
+            Self::AvailabilityBridge | Self::ZeroNeedMemoryGate | Self::NeedMemoryGate => 0.25,
+        }
+    }
+
+    pub const fn uses_need_memory_gate(self) -> bool {
+        matches!(self, Self::ZeroNeedMemoryGate | Self::NeedMemoryGate)
+    }
+    pub const fn need_memory_weight(self) -> Option<f32> {
+        match self {
+            Self::ZeroNeedMemoryGate => Some(0.0),
+            Self::NeedMemoryGate => Some(0.35),
+            _ => None,
+        }
+    }
+
+    /// Replace 22 canonical birth branches with two-hop raw drive availability
+    /// routes. Both factors have identical branch/input work. No action family,
+    /// target kind, social label, temperature direction or mating affordance is
+    /// manufactured here. In particular ATP remains availability, not deficit.
+    pub fn canonical_birth_branches(
+        self,
+        phenotype: &crate::BrainPhenotype,
+        original: &[crate::DendriticBranch],
+    ) -> Result<Vec<crate::DendriticBranch>, ScaffoldContractError> {
+        use crate::{DendriticBranch, DendriticInputRef, LobeKind, SensorEncoderSourceGroup};
+        let identity_matches = matches!(phenotype.foundation_abi(), crate::FoundationAbiSelection::Nano512ActionCreditCandidateV2(candidate) if candidate.drive_routing() == Some(self));
+        if !identity_matches || phenotype.neuron_count() != 512 || original.len() < 22 {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        let reserve = phenotype
+            .lobe_layout()
+            .region(LobeKind::FlexibleReserve)
+            .filter(|r| r.enabled && r.len >= 11)
+            .ok_or(ScaffoldContractError::PhenotypeCompile)?;
+        let motor = phenotype
+            .lobe_layout()
+            .region(LobeKind::ActionPlanning)
+            .filter(|r| r.enabled && r.len >= 11)
+            .ok_or(ScaffoldContractError::PhenotypeCompile)?;
+        let mut result = original.to_vec();
+        for lane in 0..11_u32 {
+            let source = phenotype
+                .sensor_encoder()
+                .assignments()
+                .iter()
+                .find(|a| {
+                    a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                        && u32::from(a.source_index()) == lane
+                        && a.scale() != 0.0
+                })
+                .ok_or(ScaffoldContractError::PhenotypeCompile)?
+                .target_neuron();
+            result[lane as usize] = DendriticBranch::new(
+                reserve.start + lane,
+                0.0,
+                self.output_gain(),
+                vec![
+                    DendriticInputRef::new(source, 1.0)?,
+                    DendriticInputRef::new(reserve.start + lane, 0.0)?,
+                ],
+            )?;
+            let target = if self.uses_need_memory_gate() && lane == 4 {
+                phenotype
+                    .lobe_layout()
+                    .region(LobeKind::MemoryInterface)
+                    .filter(|r| r.enabled && r.len > 8)
+                    .ok_or(ScaffoldContractError::PhenotypeCompile)?
+                    .start
+                    + 8
+            } else {
+                motor.start + lane
+            };
+            let second_gain = if self.uses_need_memory_gate() && lane != 4 {
+                0.0
+            } else {
+                self.output_gain()
+            };
+            result[11 + lane as usize] = DendriticBranch::new(
+                target,
+                0.0,
+                second_gain,
+                vec![
+                    DendriticInputRef::new(reserve.start + lane, 1.0)?,
+                    DendriticInputRef::new(target, 0.0)?,
+                ],
+            )?;
+        }
+        Ok(result)
+    }
+}
