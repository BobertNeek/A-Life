@@ -0,0 +1,256 @@
+#![cfg(feature = "cpu-backend")]
+//! Synthetic neural-port checks. These do not claim organism learning or GPU execution.
+#[path = "support/need_memory_port.rs"]
+mod support;
+use alife_core::*;
+use alife_training::{cpu::CpuFoundationTrainer, AdamWConfig, StageTrainableMask};
+
+fn trainer() -> CpuFoundationTrainer {
+    let (p, asset) = support::fixture();
+    let ids = (0..p.synapses().len() as u32).collect::<Vec<_>>();
+    let mask = StageTrainableMask::from_synapse_indices(&p, &ids).unwrap();
+    CpuFoundationTrainer::new(p, asset, mask, AdamWConfig::default()).unwrap()
+}
+fn near(a: f32, b: f32, tolerance: f32) {
+    assert!(
+        (a - b).abs() <= tolerance,
+        "{a} != {b}, tolerance={tolerance}"
+    );
+}
+
+#[test]
+fn need_memory_forward_and_weight_gradients_preserve_signed_samples_and_old_head() {
+    let mut t = trainer();
+    let gate = support::decoder(t.phenotype(), DecoderHeadKind::NeedGatedMemoryContextV1);
+    let old = support::decoder(t.phenotype(), DecoderHeadKind::MemoryContext);
+    let mut checkpoint = t.checkpoint();
+    checkpoint.weights.fill(0.);
+    checkpoint.weights[gate] = 0.35;
+    checkpoint.weights[old] = 0.2;
+    t.restore_checkpoint(checkpoint.clone()).unwrap();
+    for activation in [-0.7_f32, 0., 0.6] {
+        for sample in [-0.8_f32, 0., 0.8] {
+            let mut q = support::sequence(t.phenotype(), activation, sample);
+            // The gate derivative must use the effective, not genetic-only weight.
+            q.ticks[0].effective_weight_offsets[gate] = -0.1;
+            let observed = t.evaluate_replay(&q).unwrap().candidate_logits[0][0];
+            near(observed, sample * (0.2 + activation.max(0.) * 0.25), 1e-6);
+            let probe = t.probe_replay_gradients(&q, &[vec![1.]]).unwrap();
+            near(probe.gradients[gate], activation.max(0.) * sample, 1e-7);
+            near(probe.gradients[old], sample, 1e-7);
+            for index in [gate, old] {
+                let epsilon = 1e-3;
+                let mut plus = checkpoint.clone();
+                plus.weights[index] += epsilon;
+                t.restore_checkpoint(plus).unwrap();
+                let hi = t.evaluate_replay(&q).unwrap().candidate_logits[0][0];
+                let mut minus = checkpoint.clone();
+                minus.weights[index] -= epsilon;
+                t.restore_checkpoint(minus).unwrap();
+                let lo = t.evaluate_replay(&q).unwrap().candidate_logits[0][0];
+                near((hi - lo) / (2. * epsilon), probe.gradients[index], 2e-5);
+                t.restore_checkpoint(checkpoint.clone()).unwrap();
+            }
+        }
+    }
+}
+
+#[test]
+fn need_memory_shares_the_old_memory_clamp_and_stops_both_gradients() {
+    let mut t = trainer();
+    let gate = support::decoder(t.phenotype(), DecoderHeadKind::NeedGatedMemoryContextV1);
+    let old = support::decoder(t.phenotype(), DecoderHeadKind::MemoryContext);
+    let mut cp = t.checkpoint();
+    cp.weights.fill(0.);
+    cp.weights[old] = 0.6;
+    cp.weights[gate] = 0.6;
+    t.restore_checkpoint(cp).unwrap();
