diff --git a/crates/alife_training/examples/probe_nano_drive_routing.rs b/crates/alife_training/examples/probe_nano_drive_routing.rs
new file mode 100644
index 0000000..914e70d
--- /dev/null
+++ b/crates/alife_training/examples/probe_nano_drive_routing.rs
@@ -0,0 +1,203 @@
+//! Bounded disposable fixture, not an autonomous allocation or learned asset.
+use alife_core::*;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask, TrainingSequence};
+use alife_world::*;
+use serde_json::json;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+fn main() -> Result<()> {
+    let out = std::env::args().nth(1).ok_or("output path required")?;
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let source = FoundationWeightAsset::builtin_nano512_v1(profile)?;
+    let (p, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &source)?
+            .into_runtime_parts();
+    let asset = FoundationWeightAsset::from_nano512_readout_candidate(
+        &p,
+        p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )?;
+    let mut results = Vec::new();
+    for factor in [
+        None,
+        Some(NanoDriveRoutingV1::ZeroNeedMemoryGate),
+        Some(NanoDriveRoutingV1::NeedMemoryGate),
+    ] {
+        let mut recipe = Nano512ActionCreditCandidateV2::new(
+            &asset,
+            ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+        )?;
+        if let Some(f) = factor {
+            recipe = recipe.with_drive_routing(f);
+        }
+        let (p, inputs) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe)?;
+        let trainer = CpuFoundationTrainer::new(
+            p.clone(),
+            asset.clone(),
+            StageTrainableMask::recurrent_only(&p)?,
+            AdamWConfig::default(),
+        )?;
+        let original_optimizer = serde_json::to_vec(&trainer.checkpoint())?;
+        for peer in [false, true] {
+            for need in [0.1_f32, 0.8] {
+                let config = CanonicalNewGameConfig::phase3(41, 1)?;
+                let mut game =
+                    create_canonical_new_game_with_nociceptive_candidate(&config, &recipe)?;
+                let old = game
+                    .world
+                    .organism_registry()
+                    .get(OrganismId(1))
+                    .unwrap()
+                    .clone();
+                let mut world = HeadlessScenarioBuilder::new(41)
+                    .agent("subject", OrganismId(1), Vec3f::ZERO)
+                    .build()?;
+                let target = if peer {
+                    world.spawn_social_agent(
+                        "observed target",
+                        OrganismId(2),
+                        Vec3f::new(0.2, 0., 0.),
+                        0.,
+                    )?
+                } else {
+                    world.spawn_toy("observed target", Vec3f::new(0.2, 0., 0.), false)?
+                };
+                let props = GroundedPhysicalProperties::deterministic_for_kind(
+                    WorldObjectKind::ActivityToy,
+                    2,
+                );
+                world.set_grounded_physical_properties(target, props)?;
+                let graph = &old.phenotype().chemistry.biochemical;
+                let receptor = graph
+                    .receptors()
+                    .iter()
+                    .find(|r| {
+                        r.target
+                            == BiochemicalTargetLocus::Drive(BiochemicalDriveChannel::Loneliness)
+                    })
+                    .ok_or("missing loneliness receptor")?;
+                let index = graph
+                    .species()
+                    .iter()
+                    .position(|s| s.id == receptor.source)
+                    .unwrap();
+                let concentration =
+                    (receptor.threshold + (need - receptor.nominal) / receptor.gain).clamp(
+                        graph.species()[index].minimum,
+                        graph.species()[index].maximum,
+                    );
+                let mut wire = serde_json::to_value(old.biochemistry())?;
+                wire["graph_state"]["concentrations"][index] = json!(concentration);
+                let state: BiochemicalGraphState =
+                    serde_json::from_value(wire["graph_state"].clone())?;
+                wire["homeostasis"] = serde_json::to_value(state.derive_homeostasis(graph)?)?;
+                let biology: BiochemistryState = serde_json::from_value(wire)?;
+                biology.validate_against(old.phenotype())?;
+                world.register_organism_record(WorldOrganismRecord::new(
+                    OrganismId(1),
+                    world.entity_id("subject").unwrap(),
+                    old.genome().clone(),
+                    old.phenotype().clone(),
+                    biology,
+                    old.birth_tick(),
+                )?)?;
+                game.world = world;
+                let mut host = CpuCanonicalHost::new_cohort(game, &trainer, 41)?;
+                let mut rows = Vec::new();
+                let mut counterfactuals = Vec::new();
+                for interval in 0..32 {
+                    let step = host.step(&trainer, 1.)?;
+                    for row in step.decisions {
+                        let eval = trainer.evaluate_replay(&TrainingSequence {
+                            phenotype_hash: p.phenotype_hash(),
+                            initial: row.initial.clone(),
+                            ticks: vec![row.replay_tick.clone()],
+                            burn_in_ticks: 0,
+                            memory_candidate_gain: p
+                                .candidate_decoder()
+                                .memory_channel()
+                                .map_or(0., |m| m.max_candidate_gain()),
+                        })?;
+                        if interval == 31 {
+                            let actual = row
+                                .patch
+                                .pre_action()
+                                .perception()
+                                .homeostasis()
+                                .drives
+                                .loneliness;
+                            for pressure in [0.0_f32, 0.1, 0.8] {
+                                for clear_recall in [false, true] {
+                                    let mut tick = row.replay_tick.clone();
+                                    // Detached causal probe of the declared lane encoder, not a world mutation.
+                                    for a in p.sensor_encoder().assignments().iter().filter(|a| {
+                                        a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                                            && a.source_index() == 4
+                                    }) {
+                                        let (lo, hi) = a.clamp_range();
+                                        let before = (actual * a.scale() + a.bias()).clamp(lo, hi);
+                                        let after = (pressure * a.scale() + a.bias()).clamp(lo, hi);
+                                        let id = a.target_neuron() as usize;
+                                        tick.encoded_inputs[id] =
+                                            (tick.encoded_inputs[id] - before + after)
+                                                .clamp(-1., 1.);
+                                    }
+                                    if clear_recall {
+                                        for c in &mut tick.candidates {
+                                            c.decoder_inputs[32] = 0.;
+                                        }
+                                    }
+                                    for gate_input_off in [false, true] {
+                                        let mut initial = row.initial.clone();
+                                        if gate_input_off {
+                                            let reserve = p
+                                                .lobe_layout()
+                                                .region(LobeKind::FlexibleReserve)
+                                                .unwrap()
+                                                .start
+                                                + 4;
+                                            let mut branches =
+                                                initial.dendrites.branches().to_vec();
+                                            for b in &mut branches {
+                                                if b.target == reserve {
+                                                    b.output_gain = 0.;
+                                                }
+                                            }
+                                            initial.dendrites = DendriticBranchSet::new(branches)?;
+                                        }
+                                        for frames in [1_usize, 8, 32] {
+                                            let q = TrainingSequence {
+                                                phenotype_hash: p.phenotype_hash(),
+                                                initial: initial.clone(),
+                                                ticks: vec![tick.clone(); frames],
+                                                burn_in_ticks: 0,
+                                                memory_candidate_gain: p
+                                                    .candidate_decoder()
+                                                    .memory_channel()
+                                                    .map_or(0., |m| m.max_candidate_gain()),
+                                            };
+                                            let measured = trainer.evaluate_replay(&q)?;
+                                            counterfactuals.push(json!({"gate_input_off":gate_input_off,"pressure":pressure,"clear_lane32":clear_recall,"frames":frames,
+                                            "microsteps":frames * tick.microstep_count as usize,
+                                            "actual_recall":tick.candidates.iter().map(|c| (c.family,c.decoder_inputs[32])).collect::<Vec<_>>(),
+                                            "final_logits":measured.candidate_logits.last(),
+                                            "final_gate_activation":measured.final_activations.last().map(|v| v[(p.lobe_layout().region(LobeKind::MemoryInterface).unwrap().start+8) as usize])}));
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                        rows.push(json!({"action":row.action,"frame":row.patch.pre_action().perception(),"outcome":row.patch.outcome(),"reward":row.biological_reward,"logits":eval.candidate_logits,"brain_work":row.brain_work,"microsteps":row.replay_tick.microstep_count,"replay_dendrites":row.initial.dendrites,"memory_inputs":row.replay_tick.candidates.iter().map(|c| (c.family,c.decoder_inputs[32])).collect::<Vec<_>>()}));
+                    }
+                }
+                results.push(json!({"factor":factor,"peer_body_fixture":peer,"requested_loneliness":need,"initial_biology":biology,"final_biology":host.world().organism_registry().get(OrganismId(1)).unwrap().biochemistry(),"phenotype_hash":p.phenotype_hash(),"inputs_digest":inputs.canonical_digest(),"rows":rows,"detached_counterfactuals":counterfactuals}));
+            }
+        }
+        assert_eq!(
+            original_optimizer,
+            serde_json::to_vec(&trainer.checkpoint())?
+        );
+    }
+    use std::io::Write;
+    std::fs::OpenOptions::new().write(true).create_new(true).open(out)?.write_all(&serde_json::to_vec_pretty(&json!({"scope":"12 fixed disposable native CPU contexts x32 world intervals; no optimizer update or autonomous allocation; unregistered peer body is a controlled physical fixture", "source":"nano-need-memory-gate-v3", "source_asset":asset.digest(),"results":results}))?)?;
+    Ok(())
+}
