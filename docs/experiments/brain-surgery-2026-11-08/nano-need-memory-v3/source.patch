+#[cfg(test)]
+mod nano_drive_routing_tests {
+    use super::*;
+    use alife_core::{
+        ActionCandidateCreditProfileV1, FoundationWeightAsset, Nano512ActionCreditCandidateV2,
+        NanoDriveRoutingV1, PhenotypeCompiler, SensorProfile, TrainingStageManifest,
+    };
+
+    #[test]
+    fn canonical_birth_routes_are_identity_bound_and_restorable_without_reindexing() {
+        let profile = SensorProfile::GroundedObjectSlotsV1;
+        let source = FoundationWeightAsset::builtin_nano512_v1(profile).unwrap();
+        let (p, _, _) =
+            PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &source)
+                .unwrap()
+                .into_runtime_parts();
+        let asset = FoundationWeightAsset::from_nano512_readout_candidate(
+            &p,
+            p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+            TrainingStageManifest::new(1, 1, 1),
+        )
+        .unwrap();
+        let recipe = Nano512ActionCreditCandidateV2::new(
+            &asset,
+            ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+        )
+        .unwrap();
+        let (plain, _) =
+            PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+        let baseline = GpuV11Checkpoint::canonical_for_phenotype(&plain).unwrap();
+        let mut controls = Vec::new();
+        for factor in [
+            NanoDriveRoutingV1::ZeroBridge,
+            NanoDriveRoutingV1::AvailabilityBridge,
+        ] {
+            let (p, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(
+                &recipe.clone().with_drive_routing(factor),
+            )
+            .unwrap();
+            let state = GpuV11CausalState::for_phenotype(&p).unwrap();
+            let checkpoint = state.checkpoint();
+            assert_eq!(
+                state,
+                GpuV11CausalState::restore(checkpoint.clone()).unwrap()
+            );
+            assert_eq!(
+                checkpoint.dendritic_branches.branches().len(),
+                baseline.dendritic_branches.branches().len()
+            );
+            for original in &baseline.dendritic_branches.branches()[22..] {
+                assert!(checkpoint.dendritic_branches.branches().contains(original));
+            }
+            assert_eq!(
+                checkpoint.dendritic_branches.branches(),
+                DendriticBranchSet::new(
+                    factor
+                        .canonical_birth_branches(&p, baseline.dendritic_branches.branches())
+                        .unwrap()
+                )
+                .unwrap()
+                .branches()
+            );
+            controls.push(checkpoint);
+        }
+        for (zero, active) in controls[0]
+            .dendritic_branches
+            .branches()
+            .iter()
+            .zip(controls[1].dendritic_branches.branches())
+        {
+            assert_eq!(zero.target, active.target);
+            assert_eq!(zero.inputs, active.inputs);
+            assert_eq!(zero.threshold, active.threshold);
+        }
+        assert_eq!(
+            GpuV11Checkpoint::canonical_for_phenotype(&plain).unwrap(),
+            baseline
+        );
+    }
+}
