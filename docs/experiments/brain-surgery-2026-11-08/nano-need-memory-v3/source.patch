+//! Synthetic neural-port contract fixture, not organism-life or learning evidence.
+use alife_core::*;
+use alife_training::{
+    TrainingInitialState, TrainingReplayCandidate, TrainingReplayTick, TrainingSequence,
+};
+
+pub fn fixture() -> (BrainPhenotype, FoundationWeightAsset) {
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let builtin = FoundationWeightAsset::builtin_nano512_v1(profile).unwrap();
+    let (baseline, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &builtin)
+            .unwrap()
+            .into_runtime_parts();
+    let asset = FoundationWeightAsset::from_nano512_readout_candidate(
+        &baseline,
+        baseline
+            .synapses()
+            .iter()
+            .map(|s| s.genetic_weight())
+            .collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )
+    .unwrap();
+    let recipe = Nano512ActionCreditCandidateV2::new(
+        &asset,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap()
+    .with_drive_routing(NanoDriveRoutingV1::NeedMemoryGate);
+    let (phenotype, _) =
+        PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+    (phenotype, asset)
+}
+
+pub fn decoder(p: &BrainPhenotype, head: DecoderHeadKind) -> usize {
+    p.synapses().iter().position(|s| matches!(s.kind(), CompiledSynapseKind::Decoder(c)
+        if c.head() == head && c.family() == CandidateActionFamily::Approach && c.input_lane() == 32)).unwrap()
+}
+
+pub fn sequence(p: &BrainPhenotype, activation: f32, sample: f32) -> TrainingSequence {
+    let n = p.neuron_count() as usize;
+    let gate = decoder(p, DecoderHeadKind::NeedGatedMemoryContextV1);
+    let mut activations = vec![0.; n];
+    activations[p.synapses()[gate].source() as usize] = activation;
+    let mut decoder_inputs = [0.; 54];
+    decoder_inputs[32] = sample;
+    let q = TrainingSequence {
+        phenotype_hash: p.phenotype_hash(),
+        initial: TrainingInitialState {
+            activations,
+            activity_ema: vec![0.; n],
+            metabolic_load: vec![0.; n],
+            dendrites: Default::default(),
+        },
+        ticks: vec![TrainingReplayTick {
+            encoded_inputs: vec![0.; n],
+            projection_gain: 1.,
+            local_threshold_shift: 0.,
+            microstep_count: 0,
+            enabled_routes: vec![true; p.projections().len()],
+            effective_weight_offsets: vec![0.; p.synapses().len()],
+            structural_synapses: vec![],
+            candidates: vec![TrainingReplayCandidate {
+                family: CandidateActionFamily::Approach,
+                decoder_inputs,
+                innate_bias: 0.,
+            }],
+        }],
+        burn_in_ticks: 0,
+        memory_candidate_gain: p
+            .candidate_decoder()
+            .memory_channel()
+            .unwrap()
+            .max_candidate_gain(),
+    };
+    q.validate_for(p).unwrap();
+    q
+}
