diff --git a/crates/alife_core/tests/nano_drive_routing.rs b/crates/alife_core/tests/nano_drive_routing.rs
new file mode 100644
index 0000000..3c3df2b
--- /dev/null
+++ b/crates/alife_core/tests/nano_drive_routing.rs
@@ -0,0 +1,166 @@
+use alife_core::*;
+
+fn asset() -> FoundationWeightAsset {
+    let source =
+        FoundationWeightAsset::builtin_nano512_v1(SensorProfile::GroundedObjectSlotsV1).unwrap();
+    let (baseline, _, _) = PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(
+        SensorProfile::GroundedObjectSlotsV1,
+        &source,
+    )
+    .unwrap()
+    .into_runtime_parts();
+    FoundationWeightAsset::from_nano512_readout_candidate(
+        &baseline,
+        baseline
+            .synapses()
+            .iter()
+            .map(|s| s.genetic_weight())
+            .collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )
+    .unwrap()
+}
+fn original(p: &BrainPhenotype) -> Vec<DendriticBranch> {
+    let start = p.candidate_decoder().motor_start();
+    let count = usize::from(p.cognitive_architecture_plan().dendritic_branch_capacity())
+        .max(1)
+        .min(usize::from(p.candidate_decoder().motor_width()))
+        .min(64);
+    (0..count)
+        .map(|i| {
+            let target = start + i as u32;
+            DendriticBranch::new(
+                target,
+                -1.0,
+                6.0,
+                vec![
+                    DendriticInputRef::new(target, 1.0).unwrap(),
+                    DendriticInputRef::new(
+                        if target + 1 < p.neuron_count() {
+                            target + 1
+                        } else {
+                            target - 1
+                        },
+                        1.0,
+                    )
+                    .unwrap(),
+                ],
+            )
+            .unwrap()
+        })
+        .collect()
+}
+#[test]
+fn routing_identity_preserves_old_payload_coordinates_and_roundtrips() {
+    let asset = asset();
+    let base = Nano512ActionCreditCandidateV2::new(
+        &asset,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let old_wire = serde_json::to_value(&base).unwrap();
+    assert!(old_wire.get("drive_routing").is_none());
+    let (unchanged, old_inputs) =
+        PhenotypeCompiler::compile_nano512_action_credit_candidate(&base).unwrap();
+    let mut hashes = std::collections::BTreeSet::new();
+    hashes.insert(unchanged.phenotype_hash().0);
+    for factor in [
+        NanoDriveRoutingV1::ZeroBridge,
+        NanoDriveRoutingV1::AvailabilityBridge,
+    ] {
+        let candidate = base.clone().with_drive_routing(factor);
+        let bytes = serde_json::to_vec(&candidate).unwrap();
+        let restored: Nano512ActionCreditCandidateV2 = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(restored, candidate);
+        let (p, inputs) =
+            PhenotypeCompiler::compile_nano512_action_credit_candidate(&restored).unwrap();
+        assert_eq!(p.synapses(), unchanged.synapses());
+        assert_eq!(p.projections(), unchanged.projections());
+        assert_eq!(p.neuron_dynamics(), unchanged.neuron_dynamics());
+        assert_eq!(p.sensor_encoder(), unchanged.sensor_encoder());
+        assert_eq!(p.candidate_decoder(), unchanged.candidate_decoder());
+        assert_ne!(inputs.canonical_digest(), old_inputs.canonical_digest());
+        assert!(hashes.insert(p.phenotype_hash().0));
+        let original = original(&p);
+        let branches = factor.canonical_birth_branches(&p, &original).unwrap();
+        assert_eq!(branches.len(), original.len());
+        assert!(branches.iter().all(|b| b.inputs.len() == 2));
+        assert_eq!(&branches[22..], &original[22..]);
+        assert!(factor
+            .canonical_birth_branches(&unchanged, &original)
+            .is_err());
+        let wrong = match factor {
+            NanoDriveRoutingV1::ZeroBridge => NanoDriveRoutingV1::AvailabilityBridge,
+            _ => NanoDriveRoutingV1::ZeroBridge,
+        };
+        assert!(wrong.canonical_birth_branches(&p, &original).is_err());
+        let round: PhenotypeCompilerInputs =
+            serde_json::from_slice(&serde_json::to_vec(&inputs).unwrap()).unwrap();
+        assert_eq!(
+            PhenotypeCompiler::compile_validated(&round, &BrainCapacityClass::n512()).unwrap(),
+            p
+        );
+    }
+    assert_eq!(serde_json::to_value(&base).unwrap(), old_wire);
+}
+
+#[test]
+fn each_raw_drive_has_a_two_hop_budget_matched_availability_path() {
+    let base = Nano512ActionCreditCandidateV2::new(
+        &asset(),
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let mut work = None;
+    for factor in [
+        NanoDriveRoutingV1::ZeroBridge,
+        NanoDriveRoutingV1::AvailabilityBridge,
+    ] {
+        let (p, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(
+            &base.clone().with_drive_routing(factor),
+        )
+        .unwrap();
+        let branches =
+            DendriticBranchSet::new(factor.canonical_birth_branches(&p, &original(&p)).unwrap())
+                .unwrap();
+        for lane in 0..11_u16 {
+            let input = p
+                .sensor_encoder()
+                .assignments()
+                .iter()
+                .find(|a| {
+                    a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                        && a.source_index() == lane
+                })
+                .unwrap()
+                .target_neuron();
+            let motor = p
+                .lobe_layout()
+                .region(LobeKind::ActionPlanning)
+                .unwrap()
+                .start
+                + u32::from(lane);
+            let mut initial = vec![0.; 512];
+            initial[input as usize] = 0.5;
+            let mut one = vec![0.; 512];
+            let receipt = apply_dendritic_conjunctions(&initial, &mut one, &branches).unwrap();
+            if let Some(expected) = work {
+                assert_eq!(receipt.work_units, expected);
+            } else {
+                work = Some(receipt.work_units);
+            }
+            let mut two = vec![0.; 512];
+            apply_dendritic_conjunctions(&one, &mut two, &branches).unwrap();
+            // Measure isolated changed branches; unchanged motor-neighbor
+            // branches can themselves activate after the first step.
+            let bridge = DendriticBranchSet::new(branches.branches()[..22].to_vec()).unwrap();
+            let mut isolated = vec![0.; 512];
+            apply_dendritic_conjunctions(&one, &mut isolated, &bridge).unwrap();
+            if factor == NanoDriveRoutingV1::AvailabilityBridge {
+                assert!(isolated[motor as usize] > 0.0);
+            } else {
+                assert_eq!(isolated[motor as usize], 0.0);
+            }
+        }
+    }
+}
