+//! Adapter-free packing/identity checks for the opt-in need-memory decoder.
+use alife_core::*;
+use alife_gpu_backend::{GpuClassBucketPlan, GpuPhenotypeUpload};
+
+fn fixture() -> (BrainPhenotype, BrainPhenotype) {
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let builtin = FoundationWeightAsset::builtin_nano512_v1(profile).unwrap();
+    let (baseline, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &builtin)
+            .unwrap()
+            .into_runtime_parts();
+    let asset = FoundationWeightAsset::from_nano512_readout_candidate(
+        &baseline,
+        baseline
+            .synapses()
+            .iter()
+            .map(|s| s.genetic_weight())
+            .collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )
+    .unwrap();
+    let recipe = Nano512ActionCreditCandidateV2::new(
+        &asset,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap();
+    let (old, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe).unwrap();
+    let (gated, _) = PhenotypeCompiler::compile_nano512_action_credit_candidate(
+        &recipe.with_drive_routing(NanoDriveRoutingV1::NeedMemoryGate),
+    )
+    .unwrap();
+    (old, gated)
+}
+
+#[test]
+fn need_memory_head_ids_and_old_packed_coordinates_are_unchanged() {
+    for (head, raw) in [
+        (DecoderHeadKind::ActionCandidate, 1),
+        (DecoderHeadKind::MemoryContext, 2),
+        (DecoderHeadKind::SpeechPayload, 3),
+        (DecoderHeadKind::CognitiveContext, 4),
+        (DecoderHeadKind::NeedGatedMemoryContextV1, 5),
+    ] {
+        assert_eq!(head.raw(), raw);
+        assert_eq!(DecoderHeadKind::try_from_raw(raw).unwrap(), head);
+        assert_eq!(
+            serde_json::from_slice::<DecoderHeadKind>(&serde_json::to_vec(&head).unwrap()).unwrap(),
+            head
+        );
+    }
+    assert!(DecoderHeadKind::try_from_raw(6).is_err());
+    let (old, gated) = fixture();
+    let a = GpuPhenotypeUpload::try_from(&old).unwrap();
+    let b = GpuPhenotypeUpload::try_from(&gated).unwrap();
+    assert_eq!(
+        a.decoder_eligibility_metadata,
+        b.decoder_eligibility_metadata[..a.decoder_eligibility_metadata.len()]
+    );
+    assert_eq!(
+        a.genetic_weights,
+        b.genetic_weights[..a.genetic_weights.len()]
+    );
+    assert_eq!(a.alpha, b.alpha[..a.alpha.len()]);
+    assert_eq!(gated.memory_decoder(), old.memory_decoder());
+    assert_eq!(b.memory_channel_plans[0].memory_decoder_synapse_count, 104);
+    assert_eq!(b.memory_weight_indices.len(), 104);
+    let recurrent = b.source_indices.len() as u32;
+    let mut unique = std::collections::BTreeSet::new();
+    for (family, rows) in b
+        .memory_weight_indices
+        .as_chunks::<13>()
+        .0
+        .iter()
+        .enumerate()
+    {
+        let mut heads = [0; 2];
+        for &global in rows {
+            assert!(unique.insert(global));
+            let metadata = &b.decoder_eligibility_metadata[(global - recurrent) as usize];
+            assert_eq!(metadata.family as usize, family);
+            match metadata.decoder_head {
+                2 => heads[0] += 1,
+                5 => {
+                    heads[1] += 1;
+                    assert_eq!(metadata.input_lane, 32);
+                    assert_eq!(
+                        metadata.motor_index,
+                        gated
+                            .lobe_layout()
+                            .region(LobeKind::MemoryInterface)
+                            .unwrap()
+                            .start
+                            + 8
+                    );
+                }
+                _ => panic!("non-memory head entered memory map"),
+            }
+        }
+        assert_eq!(heads, [12, 1]);
+    }
+    let mut plan = GpuClassBucketPlan::new(BrainCapacityClass::n512(), 1).unwrap();
+    plan.insert_phenotype(0, 1, &gated).unwrap();
+}
+
+#[test]
+fn need_memory_shared_lifetime_scale_preserves_legacy_policy_wire() {
+    let policy = DecoderLifetimeRatePolicyV1::default()
+        .with_head_scale(DecoderHeadKind::MemoryContext, 0.4)
+        .unwrap();
+    assert_eq!(
+        policy.scale_for(
+            DecoderHeadKind::NeedGatedMemoryContextV1,
+            CandidateActionFamily::Approach
+        ),
+        0.4
+    );
+    let wire = serde_json::to_value(policy).unwrap();
+    assert!(wire.get("need_gated_memory_context_scale").is_none());
+    let restored: DecoderLifetimeRatePolicyV1 = serde_json::from_value(wire).unwrap();
+    assert_eq!(restored, policy);
+}
+
+#[test]
+fn need_memory_live_and_replay_shaders_validate_without_an_adapter() {
+    for source in [
+        alife_gpu_backend::CLOSED_LOOP_MEMORY_CONTEXT_WGSL,
