+#[test]
+fn need_memory_backpropagates_through_the_positive_neural_gate_only() {
+    let mut t = trainer();
+    let p = t.phenotype();
+    let gate = support::decoder(p, DecoderHeadKind::NeedGatedMemoryContextV1);
+    let gate_source = p.synapses()[gate].source();
+    let recurrent = p
+        .synapses()
+        .iter()
+        .position(|s| {
+            s.kind() == CompiledSynapseKind::Recurrent
+                && s.source() != s.target()
+                && s.source() != gate_source
+                && s.target() != gate_source
+        })
+        .unwrap();
+    let edge = p.synapses()[recurrent];
+    let mut q = support::sequence(p, 0.2, 0.7);
+    q.initial.activations[edge.source() as usize] = 0.4;
+    q.initial.dendrites = DendriticBranchSet::new(vec![DendriticBranch::new(
+        gate_source,
+        -0.1,
+        0.5,
+        vec![DendriticInputRef::new(edge.target(), 1.).unwrap()],
+    )
+    .unwrap()])
+    .unwrap();
+    q.ticks[0].microstep_count = 2;
+    q.ticks[0].encoded_inputs[edge.source() as usize] = 0.3;
+    q.ticks[0].encoded_inputs[edge.target() as usize] = 0.2;
+    q.ticks[0].effective_weight_offsets[gate] = 0.2;
+    let mut cp = t.checkpoint();
+    cp.weights.fill(0.);
+    cp.weights[gate] = 0.15;
+    cp.weights[recurrent] = 0.2;
+    t.restore_checkpoint(cp.clone()).unwrap();
+    let result = t.evaluate_replay(&q).unwrap();
+    assert!(result.final_activations[0][gate_source as usize] > 0.);
+    let probe = t.probe_replay_gradients(&q, &[vec![1.]]).unwrap();
+    assert!(
+        probe.gradients[recurrent].abs() > 1e-6,
+        "the gate must carry an upstream learning signal"
+    );
+    let epsilon = 1e-3;
+    let mut plus = cp.clone();
+    plus.weights[recurrent] += epsilon;
+    t.restore_checkpoint(plus).unwrap();
+    let hi = t.evaluate_replay(&q).unwrap().candidate_logits[0][0];
+    let mut minus = cp.clone();
+    minus.weights[recurrent] -= epsilon;
+    t.restore_checkpoint(minus).unwrap();
+    let lo = t.evaluate_replay(&q).unwrap().candidate_logits[0][0];
+    near((hi - lo) / (2. * epsilon), probe.gradients[recurrent], 2e-5);
+    t.restore_checkpoint(cp).unwrap();
+    q.initial.activations[gate_source as usize] = -1.;
+    q.ticks[0].encoded_inputs[gate_source as usize] = -1.;
+    assert!(t.evaluate_replay(&q).unwrap().final_activations[0][gate_source as usize] < 0.);
+    let probe = t.probe_replay_gradients(&q, &[vec![1.]]).unwrap();
+    assert_eq!(probe.gradients[recurrent], 0.);
+    assert_eq!(probe.gradients[gate], 0.);
+    q.ticks[0].candidates[0].decoder_inputs[32] = 0.;
+    assert!(t
+        .probe_replay_gradients(&q, &[vec![1.]])
+        .unwrap()
+        .gradients
+        .iter()
+        .all(|g| *g == 0.));
+}
