+#[test]
+fn need_memory_factorial_control_separates_neural_coupling_from_generic_valence_gain() {
+    // Synthetic 2x2 lesion assay, with identical neurons/edges/work in each arm.
+    // It proves a neural-port interaction, not that loneliness or social policy
+    // is learned. Only the two actual inherited loneliness relay branches remain.
+    let mut t = trainer();
+    let p = t.phenotype();
+    let gate = support::decoder(p, DecoderHeadKind::NeedGatedMemoryContextV1);
+    let gate_source = p.synapses()[gate].source() as usize;
+    let relay_source = p
+        .sensor_encoder()
+        .assignments()
+        .iter()
+        .find(|a| {
+            a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                && a.source_index() == 4
+                && a.scale() != 0.
+        })
+        .unwrap()
+        .target_neuron() as usize;
+    let reserve = p
+        .lobe_layout()
+        .region(LobeKind::FlexibleReserve)
+        .unwrap()
+        .start
+        + 4;
+    let inherited = alife_gpu_backend::GpuV11Checkpoint::canonical_for_phenotype(p).unwrap();
+    let first = inherited
+        .dendritic_branches
+        .branches()
+        .iter()
+        .find(|b| b.target == reserve)
+        .unwrap()
+        .clone();
+    let second = inherited
+        .dendritic_branches
+        .branches()
+        .iter()
+        .find(|b| b.target == gate_source as u32 && b.inputs.iter().any(|i| i.source == reserve))
+        .unwrap()
+        .clone();
+    assert!(first.output_gain > 0. && second.output_gain > 0.);
+    let mut q = support::sequence(p, 0., 0.7);
+    q.ticks[0].microstep_count = u32::from(p.microstep_count());
+    assert!(q.ticks[0].microstep_count >= 3);
+    let mut cp = t.checkpoint();
+    cp.weights.fill(0.);
+    let mut arms = Vec::new();
+    for routing in [false, true] {
+        for readout in [false, true] {
+            let mut branches = vec![first.clone(), second.clone()];
+            if !routing {
+                for branch in &mut branches {
+                    branch.output_gain = 0.;
+                }
+            }
+            q.initial.dendrites = DendriticBranchSet::new(branches).unwrap();
+            cp.weights[gate] = if readout { 0.35 } else { 0. };
+            t.restore_checkpoint(cp.clone()).unwrap();
+            let mut pair = Vec::new();
+            for pressure in [0., 1.] {
+                q.ticks[0].encoded_inputs[relay_source] = pressure;
+                let result = t.evaluate_replay(&q).unwrap();
+                let source = result.final_activations[0][gate_source];
+                let logit = result.candidate_logits[0][0];
+                near(logit, source.max(0.) * 0.7 * cp.weights[gate], 1e-6);
+                pair.push((source, logit));
+            }
+            eprintln!(
+                "need-memory factorial routing={routing} readout={readout}: low={:?}, high={:?}",
+                pair[0], pair[1]
+            );
+            if routing {
+                assert!(pair[1].0 > pair[0].0 + 1e-5);
+            } else {
+                assert_eq!(pair[1].0.to_bits(), pair[0].0.to_bits());
+            }
+            if !readout {
+                assert_eq!((pair[0].1, pair[1].1), (0., 0.));
+            } else {
+                assert!(
+                    pair[0].1 > 0.,
+                    "the fixed reader operating point gives a measurable generic valence gain"
+                );
+            }
+            arms.push(pair);
+        }
+    }
+    // Order: neither, readout only, routing only, both.
+    let effect = |arm: usize| arms[arm][1].1 - arms[arm][0].1;
+    assert_eq!(effect(0), 0.);
+    assert_eq!(effect(1), 0.);
+    assert_eq!(effect(2), 0.);
+    assert!(
+        effect(3) > 1e-5,
+        "a generic valence gain alone cannot explain pressure dependence"
+    );
+    q.ticks[0].encoded_inputs[relay_source] = 1.;
+    q.ticks[0].candidates[0].decoder_inputs[32] = -0.7;
+    near(
+        t.evaluate_replay(&q).unwrap().candidate_logits[0][0],
+        -arms[3][1].1,
+        1e-6,
+    );
+    q.ticks[0].candidates[0].decoder_inputs[32] = 0.;
+    assert_eq!(t.evaluate_replay(&q).unwrap().candidate_logits[0][0], 0.);
+}
