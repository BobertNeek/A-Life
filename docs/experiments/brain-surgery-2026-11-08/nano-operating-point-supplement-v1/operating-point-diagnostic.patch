diff --git a/crates/alife_training/tests/cpu_encoder_inputs.rs b/crates/alife_training/tests/cpu_encoder_inputs.rs
new file mode 100644
index 0000000..a8aa62f
--- /dev/null
+++ b/crates/alife_training/tests/cpu_encoder_inputs.rs
@@ -0,0 +1,224 @@
+#![cfg(feature = "cpu-backend")]
+//! Extraction equivalence only, no world intervals or neural training.
+use alife_core::*;
+use alife_runtime::canonical_preparation::*;
+use alife_training::cpu::{encode_cpu_frame, encode_cpu_neural_inputs};
+use alife_world::*;
+#[path = "support/need_memory_port.rs"]
+#[allow(dead_code)]
+mod support;
+
+// Frozen spelling from 27c01b6 input.rs, retained only as an independent oracle.
+fn previous_encoder(
+    p: &BrainPhenotype,
+    frame: &PerceptionFrame,
+    effects: &NeuralReceptorEffects,
+) -> Vec<f32> {
+    let sensory = frame.sensory().channels.as_flat_array();
+    let body = frame.body().neural_projection(frame.sensor_profile());
+    let t = body.pose.translation;
+    let r = body.pose.rotation;
+    let v = body.velocity.linear;
+    let a = body.velocity.angular;
+    let body = [
+        t.x, t.y, t.z, r.x, r.y, r.z, r.w, v.x, v.y, v.z, a.x, a.y, a.z,
+    ];
+    let homeostasis = frame.homeostasis();
+    let home = homeostasis
+        .drives
+        .to_array()
+        .into_iter()
+        .chain(homeostasis.hormones.to_array())
+        .collect::<Vec<_>>();
+    let language = frame.sensory().language_prior_neural_lanes();
+    let mut encoded = vec![0.; p.neuron_count() as usize];
+    for assignment in p.sensor_encoder().assignments() {
+        let index = assignment.source_index() as usize;
+        let source = match assignment.source_group() {
+            SensorEncoderSourceGroup::SensoryChannel => {
+                sensory.get(index).map(|x| x * effects.attention_gain)
+            }
+            SensorEncoderSourceGroup::Body => body.get(index).copied(),
+            SensorEncoderSourceGroup::Homeostasis => {
+                home.get(index).map(|x| x * effects.interoceptive_gain)
+            }
+            SensorEncoderSourceGroup::HeardLanguage => language.get(index).copied(),
+            SensorEncoderSourceGroup::SemanticPrior => language.get(128 + index).copied(),
+        }
+        .unwrap();
+        let (min, max) = assignment.clamp_range();
+        encoded[assignment.target_neuron() as usize] +=
+            (source * assignment.scale() + assignment.bias()).clamp(min, max);
+    }
+    let gate =
+        (effects.structural_growth_gate + effects.sleep_gate + effects.consolidation_gate) / 3.;
+    for value in &mut encoded {
+        *value = (*value * effects.regional_excitability + (gate - 0.5) * 0.05).clamp(-1., 1.);
+    }
+    encoded
+}
+
+fn fixture() -> (BrainPhenotype, CanonicalNewGame) {
+    let (p, asset) = support::fixture();
+    let recipe = Nano512ActionCreditCandidateV2::new(
+        &asset,
+        ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+    )
+    .unwrap()
+    .with_drive_routing(NanoDriveRoutingV1::NeedMemoryGate);
+    let game = create_canonical_new_game_with_nociceptive_candidate(
+        &CanonicalNewGameConfig::phase3(41, 1).unwrap(),
+        &recipe,
+    )
+    .unwrap();
+    (p, game)
+}
+
+#[test]
+fn extracted_encoder_is_bit_identical_with_non_neutral_receptors_and_pressure() {
+    let (p, mut game) = fixture();
+    let record = game
+        .world
+        .organism_registry()
+        .get(OrganismId(1))
+        .unwrap()
+        .clone();
+    let (draft, _) = game
+        .world
+        .perception_frame_draft_with_bindings(
+            record.organism_id(),
+            game.world.tick(),
+            p.sensor_profile(),
+            record.biochemistry().homeostasis,
+        )
+        .unwrap();
+    let frame = draft.finalize(PerceptionContextBlock::empty()).unwrap();
+    let native = NeuralReceptorEffects::from_frame(
+        &record
+            .biochemistry()
+            .neural_receptor_frame(record.phenotype())
+            .unwrap(),
+        &NeuralReceptorPhenotype::compile(&p).unwrap(),
+    )
+    .unwrap();
+    let varied = NeuralReceptorEffects {
+        interoceptive_gain: 1.2,
+        regional_excitability: 0.83,
+        projection_gain: 0.72,
+        local_threshold_shift: -0.13,
+        attention_gain: 1.34,
+        structural_growth_gate: 0.2,
+        sleep_gate: 0.7,
+        consolidation_gate: 0.4,
+        ..native
+    };
+    for effects in [native, varied] {
+        for pressure in [0., 0.1, 0.8, 1.] {
+            let mut h = *frame.homeostasis();
+            h.drives.loneliness = pressure;
+            let changed = PerceptionFrame::new(
+                frame.organism_id(),
+                frame.tick(),
+                frame.sensor_profile(),
+                frame.sensory().clone(),
+                frame.body(),
+                h,
+                frame.candidates().to_vec(),
+                frame.profile_provenance(),
+                frame.grounded_object_slots().to_vec(),
+            )
+            .unwrap();
+            let expected = previous_encoder(&p, &changed, &effects);
+            let observed = encode_cpu_neural_inputs(&p, &changed, &effects).unwrap();
+            assert_eq!(
+                expected.iter().map(|v| v.to_bits()).collect::<Vec<_>>(),
+                observed.iter().map(|v| v.to_bits()).collect::<Vec<_>>()
+            );
+        }
+    }
+    let mut wrong_tick = native;
+    wrong_tick.source_tick = Tick::new(1);
+    assert!(encode_cpu_neural_inputs(&p, &frame, &wrong_tick).is_err());
+    let mut invalid = native;
+    invalid.regional_excitability = f32::NAN;
+    assert!(encode_cpu_neural_inputs(&p, &frame, &invalid).is_err());
+}
+
+#[test]
+fn full_frame_encoder_calls_shared_helper_on_canonical_preparation() {
+    let (p, mut game) = fixture();
+    let record = game
+        .world
+        .organism_registry()
+        .get(OrganismId(1))
+        .unwrap()
+        .clone();
+    let (draft, binding) = game
+        .world
+        .perception_frame_draft_with_bindings(
+            record.organism_id(),
+            game.world.tick(),
+            p.sensor_profile(),
+            record.biochemistry().homeostasis,
+        )
+        .unwrap();
+    let identity = draft.profile_provenance().identity();
+    let memory = MemorySidecarState::new_profiled(
+        record.organism_id(),
+        identity,
+        MemoryBankConfig::new(256, 64, 4, 0.72, Confidence::new(0.).unwrap()).unwrap(),
+    )
+    .unwrap();
+    let topology = TopologySidecar::new_profiled(
+        record.organism_id(),
+        identity,
+        TopologicalMapConfig::default(),
+    )
+    .unwrap();
+    let predictor = predictor_for_phenotype(&p).unwrap();
+    let receptors = record
+        .biochemistry()
+        .neural_receptor_frame(record.phenotype())
+        .unwrap();
+    let effects = NeuralReceptorEffects::from_frame(
+        &receptors,
+        &NeuralReceptorPhenotype::compile(&p).unwrap(),
+    )
+    .unwrap();
+    let input = CanonicalPreparationInput {
+        draft,
+        candidate_binding: binding,
+        sequence_id: ExperienceSequenceId(1),
+        homeostasis: record.biochemistry().homeostasis,
+        hysteresis: HysteresisState::default(),
+        policy: attention_selection_policy_for(&p),
+        neural_receptors: receptors,
+        receptor_effects: effects,
+    };
+    let prepared = prepare_canonical_frame(&input, &memory, &topology, &predictor, false)
+        .result
+        .unwrap();
+    let native = encode_cpu_frame(
+        &p,
+        &prepared.frame,
+        &prepared.memory_recall,
+        &effects,
+        vec![true; p.projections().len()],
+        vec![],
+    )
+    .unwrap();
+    let extracted = encode_cpu_neural_inputs(&p, &prepared.frame, &effects).unwrap();
+    assert_eq!(native.encoded_inputs, extracted);
+    assert_eq!(
+        native.encoded_inputs,
+        previous_encoder(&p, &prepared.frame, &effects)
+    );
+    assert_eq!(
+        native.projection_gain.to_bits(),
+        effects.projection_gain.to_bits()
+    );
+    assert_eq!(
+        native.local_threshold_shift.to_bits(),
+        effects.local_threshold_shift.to_bits()
+    );
+}
