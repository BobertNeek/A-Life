@@ -0,0 +1,296 @@
+//! Reads a closed public fixture artifact. No world intervals, optimizer, private
+//! checkpoint restore, synthesized recall, or candidate parameters are changed.
+use alife_core::*;
+use alife_gpu_backend::GpuV11CausalState;
+use alife_training::cpu::encode_cpu_neural_inputs;
+use alife_world::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::io::Write;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const DRIVE_NAMES: [&str; 11] = [
+    "hunger",
+    "fatigue",
+    "fear",
+    "pain",
+    "loneliness",
+    "curiosity",
+    "brain_atp",
+    "temperature_stress",
+    "reproductive_drive",
+    "extension0",
+    "extension1",
+];
+
+fn substituted_frame(
+    frame: &PerceptionFrame,
+    lane: usize,
+    pressure: f32,
+) -> Result<PerceptionFrame> {
+    let mut h = *frame.homeostasis();
+    match lane {
+        0 => h.drives.hunger = pressure,
+        1 => h.drives.fatigue = pressure,
+        2 => h.drives.fear = pressure,
+        3 => h.drives.pain = pressure,
+        4 => h.drives.loneliness = pressure,
+        5 => h.drives.curiosity = pressure,
+        6 => h.drives.brain_atp = pressure,
+        7 => h.drives.temperature_stress = pressure,
+        8 => h.drives.reproductive_drive = pressure,
+        9 | 10 => h.drives.extension[lane - 9] = pressure,
+        _ => return Err("invalid drive lane".into()),
+    }
+    // This is only an encoder counterfactual. No recall/context receipt from the
+    // old frame is attached to the changed base, and chemistry effects stay fixed.
+    Ok(PerceptionFrame::new(
+        frame.organism_id(),
+        frame.tick(),
+        frame.sensor_profile(),
+        frame.sensory().clone(),
+        frame.body(),
+        h,
+        frame.candidates().to_vec(),
+        frame.profile_provenance(),
+        frame.grounded_object_slots().to_vec(),
+    )?)
+}
+
+fn node_terms(
+    p: &BrainPhenotype,
+    branches: &DendriticBranchSet,
+    effects: &NeuralReceptorEffects,
+    encoded: &[f32],
+    id: u32,
+) -> Value {
+    let d = &p.neuron_dynamics()[id as usize];
+    let incoming = p.synapses().iter().enumerate().filter_map(|(index, s)| {
+        if s.target() != id || !matches!(s.kind(), CompiledSynapseKind::Recurrent) { return None; }
+        Some(json!({"global_synapse":index,"source":s.source(),"genetic_weight":s.genetic_weight(),
+            "alpha":s.alpha(),"route":s.route_index(),"cadence":p.projections()[s.route_index() as usize].update_cadence(),
+            "somatic_offset":"not recorded; no claim to know actual effective weight"}))
+    }).collect::<Vec<_>>();
+    let base = d.bias() + encoded[id as usize] - effects.local_threshold_shift;
+    json!({"id":id,"dynamics":d,"encoded_input":encoded[id as usize],
+        "bias_plus_encoded_minus_local_threshold":base,
+        "preactivation_interval_if_recurrent_and_dendritic_sums_zero":[base-d.homeostatic_gain(),base],
+        "compiled_recurrent_inputs":incoming,
+        "recorded_dendritic_branches":branches.branches().iter().filter(|b| b.target==id).collect::<Vec<_>>(),
+        "native_update":"a_next=(1-leak)*a+leak*tanh(bias+encoded+projection_gain*(recurrent+dendritic)-homeostatic_gain*metabolic-local_threshold); metabolic_next=clamp(decay*metabolic+(1-decay)*a_next^2,0,1)",
+        "cadence_note":"compiled recurrent route cadence varies; dendritic branches are evaluated every executed microstep"})
+}
+
+fn scalar_fixed_point(base: f32, gain: f32) -> Option<f32> {
+    // A local analytical consistency check only, for a closed branch with no
+    // recurrent sum. At equilibrium m=a^2. Find roots by sign-bracketed bisection.
+    let f = |a: f32| a - (base - gain * a * a).tanh();
+    let mut roots = Vec::new();
+    for i in 0..2000 {
+        let mut lo = -1. + i as f32 / 1000.;
+        let mut hi = lo + 0.001;
+        if f(lo) * f(hi) > 0. {
+            continue;
+        }
+        for _ in 0..32 {
+            let mid = (lo + hi) * 0.5;
+            if f(lo) * f(mid) <= 0. {
+                hi = mid;
+            } else {
+                lo = mid;
+            }
+        }
+        roots.push((lo + hi) * 0.5);
+    }
+    roots.into_iter().min_by(|a, b| a.abs().total_cmp(&b.abs()))
+}
+
+fn main() -> Result<()> {
+    let args = std::env::args().collect::<Vec<_>>();
+    if args.len() != 3 {
+        return Err("usage: probe_nano_operating_point CLOSED_ARTIFACT OUTPUT_NEW_JSON".into());
+    }
+    let raw = std::fs::read(&args[1])?;
+    let input_sha256 = format!("{:x}", Sha256::digest(&raw));
+    assert_eq!(
+        input_sha256,
+        "6f0e21260fec2885bee195cd32b9b7955579fd96e4fd68a49106aa7e27e98a92"
+    );
+    let artifact: Value = serde_json::from_slice(&raw)?;
+    let profile = SensorProfile::GroundedObjectSlotsV1;
+    let builtin = FoundationWeightAsset::builtin_nano512_v1(profile)?;
+    let (old, _, _) =
+        PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(profile, &builtin)?
+            .into_runtime_parts();
+    let asset = FoundationWeightAsset::from_nano512_readout_candidate(
+        &old,
+        old.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        TrainingStageManifest::new(1, 1, 1),
+    )?;
+    assert_eq!(
+        artifact["source_asset"],
+        serde_json::to_value(asset.digest())?
+    );
+    assert_eq!(artifact["source"], "nano-need-memory-gate-v3");
+    let contexts = artifact["results"].as_array().ok_or("missing results")?;
+    assert_eq!(contexts.len(), 12);
+    let mut results = Vec::new();
+    for context in contexts {
+        let factor: Option<NanoDriveRoutingV1> = serde_json::from_value(context["factor"].clone())?;
+        assert!(factor.is_none() || factor.is_some_and(NanoDriveRoutingV1::uses_need_memory_gate));
+        let mut recipe = Nano512ActionCreditCandidateV2::new(
+            &asset,
+            ActionCandidateCreditProfileV1::SignedChoiceReadouts,
+        )?;
+        if let Some(f) = factor {
+            recipe = recipe.with_drive_routing(f);
+        }
+        let (p, inputs) = PhenotypeCompiler::compile_nano512_action_credit_candidate(&recipe)?;
+        assert_eq!(
+            context["phenotype_hash"],
+            serde_json::to_value(p.phenotype_hash())?
+        );
+        assert_eq!(
+            context["inputs_digest"],
+            serde_json::to_value(inputs.canonical_digest())?
+        );
+        // Instantiate only the deterministic birth record to recover expressed
+        // chemistry/receptor identity. No host is constructed or world advanced.
+        let game = create_canonical_new_game_with_nociceptive_candidate(
+            &CanonicalNewGameConfig::phase3(41, 1)?,
+            &recipe,
+        )?;
+        let record = game
+            .world
+            .organism_registry()
+            .get(OrganismId(1))
+            .ok_or("missing birth record")?;
+        record.validate_contract()?;
+        let receptor_phenotype = NeuralReceptorPhenotype::compile(&p)?;
+        let born = GpuV11CausalState::for_phenotype(&p)?;
+        let rows = context["rows"].as_array().ok_or("missing rows")?;
+        assert_eq!(rows.len(), 32);
+        let sources = (0..11)
+            .map(|lane| {
+                p.sensor_encoder()
+                    .assignments()
+                    .iter()
+                    .find(|a| {
+                        a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                            && a.source_index() == lane
+                            && a.scale() != 0.
+                    })
+                    .map(|a| a.target_neuron())
+                    .ok_or("missing drive port")
+            })
+            .collect::<std::result::Result<Vec<_>, _>>()?;
+        let reserve = p
+            .lobe_layout()
+            .region(LobeKind::FlexibleReserve)
+            .ok_or("missing reserve")?
+            .start;
+        let gate = p
+            .lobe_layout()
+            .region(LobeKind::MemoryInterface)
+            .ok_or("missing memory")?
+            .start
+            + 8;
+        let mut all_row_terms = Vec::new();
+        for (index, row) in rows.iter().enumerate() {
+            let frame: PerceptionFrame = serde_json::from_value(row["frame"].clone())?;
+            let outcome: PostActionOutcome = serde_json::from_value(row["outcome"].clone())?;
+            let measured = outcome
+                .measured_physiology
+                .ok_or("missing measured physiology")?;
+            measured.validate_contract()?;
+            measured.before.validate_against(record.phenotype())?;
+            measured.after.validate_against(record.phenotype())?;
+            assert_eq!(
+                measured.before.source_genome_id,
+                record.biochemistry().source_genome_id
+            );
+            assert_eq!(frame.tick().raw(), index as u64);
+            assert_eq!(frame.organism_id(), record.organism_id());
+            assert_eq!(measured.before.tick, frame.tick());
+            assert_eq!(measured.before.homeostasis, *frame.homeostasis());
+            let branches: DendriticBranchSet =
+                serde_json::from_value(row["replay_dendrites"].clone())?;
+            branches.validate_for_neuron_count(p.neuron_count())?;
+            assert_eq!(&branches, born.dendritic_branches());
+            let receptors = measured.before.neural_receptor_frame(record.phenotype())?;
+            let effects = NeuralReceptorEffects::from_frame(&receptors, &receptor_phenotype)?;
+            let encoded = encode_cpu_neural_inputs(&p, &frame, &effects)?;
+            let source_base = sources
+                .iter()
+                .map(|&id| {
+                    p.neuron_dynamics()[id as usize].bias() + encoded[id as usize]
+                        - effects.local_threshold_shift
+                })
+                .collect::<Vec<_>>();
+            all_row_terms.push(json!({"tick":frame.tick(),"microsteps":row["microsteps"],"effects":effects,"all_drive_base_terms":source_base}));
+            if index != rows.len() - 1 {
+                continue;
+            }
+            let mut probes = Vec::new();
+            for (lane, &source) in sources.iter().enumerate() {
+                for pressure in [
+                    frame.homeostasis().drives.to_array()[lane],
+                    0.,
+                    0.1,
+                    0.8,
+                    1.,
+                ] {
+                    let changed = substituted_frame(&frame, lane, pressure)?;
+                    let x = encode_cpu_neural_inputs(&p, &changed, &effects)?;
+                    let (lo, hi) = p
+                        .sensor_encoder()
+                        .assignments()
+                        .iter()
+                        .find(|a| {
+                            a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                                && a.source_index() as usize == lane
+                                && a.target_neuron() == source
+                        })
+                        .ok_or("missing source assignment")?
+                        .clamp_range();
+                    let assignments=p.sensor_encoder().assignments().iter().filter(|a|a.target_neuron()==source).map(|a|json!({"group":a.source_group(),"lane":a.source_index(),"scale":a.scale(),"bias":a.bias(),"clamp":a.clamp_range()})).collect::<Vec<_>>();
+                    let source_base = p.neuron_dynamics()[source as usize].bias()
+                        + x[source as usize]
+                        - effects.local_threshold_shift;
+                    let isolated_target_max = source_base.tanh();
+                    let first_branch_max = (isolated_target_max.max(0.)).tanh() * 0.25;
+                    probes.push(json!({"lane":lane,"name":DRIVE_NAMES[lane],"substituted_raw_pressure":pressure,"source_assignments":assignments,"assignment_clamp":[lo,hi],
+                        "source":node_terms(&p,&branches,&effects,&x,source),"reserve":node_terms(&p,&branches,&effects,&x,reserve+lane as u32),
+                        "isolated_source_activation_target_upper_bound_metabolic_zero":isolated_target_max,
+                        "first_hop_upper_bound_if_no_other_incoming_inputs":first_branch_max,
+                        "bound_caveat":"conditional on zero other inputs; inspect listed recurrent inputs and branches. This is not a reconstructed actual activation.",
+                        "memory_reader":if lane==4 {node_terms(&p,&branches,&effects,&x,gate)} else {Value::Null}}));
+                }
+            }
+            let d = &p.neuron_dynamics()[gate as usize];
+            let base = d.bias() + encoded[gate as usize] - effects.local_threshold_shift;
+            let fixed = scalar_fixed_point(base, d.homeostatic_gain());
+            let saved = context["detached_counterfactuals"]
+                .as_array()
+                .ok_or("missing closed probes")?;
+            let gate_records=saved.iter().map(|v|json!({"nominal_pressure":v["pressure"],"frames":v["frames"],"gate_input_off":v["gate_input_off"],"clear_lane32":v["clear_lane32"],"recorded_gate":v["final_gate_activation"]})).collect::<Vec<_>>();
+            results.push(json!({"factor":factor,"peer_body_fixture":context["peer_body_fixture"],"requested_initial_loneliness":context["requested_loneliness"],
+                "validated_phenotype_hash":p.phenotype_hash(),"validated_source_genome_id":measured.before.source_genome_id,
+                "frame_tick":frame.tick(),"frame_digest":frame.frame_digest(),"before_chemistry_tick":measured.before.tick,
+                "actual_drives":frame.homeostasis().drives,"receptors":receptors,"receptor_expression":receptor_phenotype,"effects":effects,
+                "global_encoded_offset":((effects.structural_growth_gate+effects.sleep_gate+effects.consolidation_gate)/3.-0.5)*0.05,
+                "all_11_lane_encoder_probes":probes,"reader_actual_encoder_terms":node_terms(&p,&branches,&effects,&encoded,gate),
+                "reader_closed_input_scalar_equilibrium_nearest_zero":fixed,
+                "scalar_equilibrium_scope":"analytical consistency only: tanh(base-homeostatic_gain*a^2)=a, assumes zero recurrent+dendritic sum; not actual neural-state reconstruction",
+                "previous_v3_nominal_raw_input_probes":gate_records,
+                "all_recorded_row_encoder_terms":all_row_terms}));
+        }
+    }
+    std::fs::OpenOptions::new().write(true).create_new(true).open(&args[2])?.write_all(&serde_json::to_vec_pretty(&json!({
+        "scope":"closed artifact encoder/receptor reconstruction and conditional analytical bounds only; no world intervals or neural replay",
+        "base_commit":"27c01b6f258604a307c5c359ad41c7e91ae3ae0b","source_artifact":args[1],"source_artifact_sha256":input_sha256,"source_asset":asset.digest(),
+        "counterfactual_scope":"one raw homeostatic lane substituted in detached validated frame; chemistry-derived receptor effects held at recorded before-state values, not a new biological trajectory",
+        "missing_state":"artifact has no neural initial activations, metabolic loads, somatic weights, enabled-route flags or structural edges; none reconstructed or silently defaulted",
+        "v3_probe_correction":"V3 detached pressure probes changed nominal raw encoder contribution without native interoceptive/regional gains; these are not exact re-encodings",
+        "results":results}))?)?;
+    Ok(())
+}
