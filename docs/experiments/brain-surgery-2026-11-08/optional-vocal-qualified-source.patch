+            0 => c[0].features.0[0] = 0.25,
+            1 => c[0].sensor_confidence = Confidence::new(0.5).unwrap(),
+            2 => c[0].required_effort = NormalizedScalar::new(0.25).unwrap(),
+            _ => {
+                c[0].min_duration = DurationTicks::new(2);
