+        _: &mut CpuOrganismState,
+        _: &CpuFoundationTrainer,
+        _: &ExperiencePatch,
+        _: &NeuralReceptorFrame,
+    ) -> Result<(), CpuHostError> {
+        panic!("stage must reject before physical execution")
+    }
