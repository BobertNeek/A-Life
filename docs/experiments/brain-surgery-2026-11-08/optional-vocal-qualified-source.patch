+                            .with_intrinsic_action_basis(ActionKind::Idle),
+                        Confidence::new(1.).unwrap(),
+                        NormalizedScalar::ZERO,
+                        DurationTicks::new(1),
+                        DurationTicks::new(1),
+                    ),
+                    Err(alife_core::ScaffoldContractError::InvalidActionCandidate)
+                ));
+                continue;
+            }
+            _ => spec.push((99, ActionKind::Idle, CandidateActionFamily::Idle)),
+        }
+        let f = frame(&spec);
