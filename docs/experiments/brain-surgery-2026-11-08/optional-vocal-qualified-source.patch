+//! Closed optional Vocal factor. Quiet is a policy choice, never a world primitive.
+//! The native confidence-V2 circuit supplies scores, not V2 sampling ownership.
+use super::*;
+use alife_core::{LanguageTokenId, SpeechActKind, SpeechMotorPayload};
+
+pub const OPTIONAL_VOCAL_POLICY_V1: &str = "m2-optional-vocal-v1;closed;idle-mediated-quiet;source-payload-removal;cooldown-physical;no-gradient";
+const RNG_DOMAIN: u32 = 0x4f56_4331;
+
+/// Exact source-output evidence. Only the resident's pending forward constructs it.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct OptionalVocalSourceV1 {
+    policy: String,
+    owner: OrganismId,
+    tick: Tick,
+    source: PhenotypeHash,
+    frame: PerceptionFrameDigest,
+    dispatch_generation: u64,
+    activation_side: u8,
+    output_digest: [u8; 32],
+    payload: Option<PayloadBits>,
+}
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PayloadBits {
+    act: u8,
+    tokens: Vec<u16>,
+    confidence: u32,
+}
+impl OptionalVocalSourceV1 {
+    #[allow(clippy::too_many_arguments)]
+    pub(in crate::cpu) fn from_forward(
+        owner: OrganismId,
+        tick: Tick,
+        source: PhenotypeHash,
+        frame: PerceptionFrameDigest,
+        dispatch_generation: u64,
+        activation_side: u8,
+        activations: &[f32],
+        offsets: &[f32],
+        speech: Option<SpeechMotorPayload>,
+    ) -> Result<Self, TrainingError> {
+        finite(activations)?;
+        finite(offsets)?;
+        let payload = speech.map(|p| PayloadBits {
+            act: p.speech_act.raw(),
+            tokens: p.tokens.iter().map(|t| t.raw()).collect(),
+            confidence: p.confidence.raw().to_bits(),
+        });
+        let mut hasher = Sha256::new();
+        hasher.update(OPTIONAL_VOCAL_POLICY_V1.as_bytes());
+        for bank in [activations, offsets] {
+            hasher.update((bank.len() as u64).to_le_bytes());
+            for x in bank {
+                hasher.update(x.to_bits().to_le_bytes());
+            }
+        }
+        let result = Self {
+            policy: OPTIONAL_VOCAL_POLICY_V1.into(),
+            owner,
+            tick,
+            source,
+            frame,
+            dispatch_generation,
+            activation_side,
+            output_digest: hasher.finalize().into(),
+            payload,
+        };
+        result.validate()?;
+        Ok(result)
+    }
+    fn validate(&self) -> Result<(), TrainingError> {
+        if self.policy != OPTIONAL_VOCAL_POLICY_V1
+            || self.dispatch_generation == 0
+            || self.activation_side > 1
+        {
+            return Err(invalid());
+        }
+        self.owner.validate()?;
+        self.speech()?;
+        Ok(())
+    }
+    pub fn speech(&self) -> Result<Option<SpeechMotorPayload>, TrainingError> {
+        self.payload
+            .as_ref()
+            .map(|p| {
+                Ok(SpeechMotorPayload::try_new(
+                    SpeechActKind::try_from_raw(p.act)?,
+                    p.tokens
+                        .iter()
+                        .map(|&t| LanguageTokenId::new(t))
+                        .collect::<Result<_, _>>()?,
+                    Confidence::new(f32::from_bits(p.confidence))?,
+                )?)
+            })
+            .transpose()
+    }
+    pub fn payload_present(&self) -> bool {
+        self.payload.is_some()
+    }
+    pub(in crate::cpu) fn validate_identity(
+        &self,
+        owner: OrganismId,
+        tick: Tick,
+        source: PhenotypeHash,
+        frame: PerceptionFrameDigest,
+        generation: u64,
+        side: u8,
+    ) -> Result<(), TrainingError> {
+        self.validate()?;
+        if (
+            self.owner,
+            self.tick,
+            self.source,
+            self.frame,
+            self.dispatch_generation,
+            self.activation_side,
+        ) != (owner, tick, source, frame, generation, side)
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
