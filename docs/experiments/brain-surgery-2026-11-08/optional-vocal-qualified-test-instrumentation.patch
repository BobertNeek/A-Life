@@ -0,0 +1,27 @@
+//! Qualification-only operation counters. No production policy or state changes.
+use std::sync::atomic::{AtomicU64, Ordering};
+static COUNTS: [AtomicU64; 7] = [const { AtomicU64::new(0) }; 7];
+pub(super) fn add(slot: usize) {
+    COUNTS[slot].fetch_add(1, Ordering::SeqCst);
+}
+pub(super) struct Report(&'static str);
+pub(super) fn report(name: &'static str) -> Report {
+    for count in &COUNTS {
+        count.store(0, Ordering::SeqCst);
+    }
+    Report(name)
+}
+impl Drop for Report {
+    fn drop(&mut self) {
+        let counts: Vec<u64> = COUNTS.iter().map(|n| n.load(Ordering::SeqCst)).collect();
+        println!(
+            "OPTIONAL_VOCAL_QUALIFICATION_COUNTS={}",
+            serde_json::json!({
+                "test": self.0, "source_attempts": counts[0], "source_completed": counts[1],
+                "bundle_attempts": counts[2], "bundle_completed": counts[3],
+                "committed_intervals": counts[4], "direct_speech_attempts": counts[5],
+                "world_advance_completed": counts[6]
+            })
+        );
+    }
+}
