+// Separately frozen research comparison, not a production store API.
+fn detached_near_context_score_v2(
+    source_frame: &PerceptionFrame,
+    source_candidate: &ActionCandidate,
+    source_after: Tick,
+    current_frame: &PerceptionFrame,
+    current_candidate: &ActionCandidate,
+) -> Option<f32> {
+    let source = NeedConsequenceQueryV1::from_frame(source_frame, source_candidate).unwrap();
+    let current = NeedConsequenceQueryV1::from_frame(current_frame, current_candidate).unwrap();
+    if source.organism_id() != current.organism_id()
+        || source.profile() != current.profile()
+        || source.action_family() != current.action_family()
+        || source.tracked_target().is_none()
+        || source.tracked_target() != current.tracked_target()
+        || source.target_entity() != current.target_entity()
+        || source_candidate.action_id != current_candidate.action_id
+        || source_candidate.kind != current_candidate.kind
+        || current_frame.tick().raw().checked_sub(source_after.raw())? > 1
+    {
+        return None;
+    }
+    let encode = |frame: &PerceptionFrame, candidate: &ActionCandidate| {
+        let draft = PerceptionFrameDraft::new(
+            frame.organism_id(),
+            frame.tick(),
+            frame.sensor_profile(),
+            frame.sensory().clone(),
+            frame.body(),
+            *frame.homeostasis(),
+            frame.candidates().to_vec(),
+            frame.profile_provenance(),
+            frame.grounded_object_slots().to_vec(),
+        )
+        .unwrap();
+        MemoryQueryEncoderV2::encode_candidate(&draft, candidate).unwrap()
+    };
+    let a = encode(source_frame, source_candidate);
+    let b = encode(current_frame, current_candidate);
+    let cosine = |range: std::ops::Range<usize>| {
+        let (mut dot, mut aa, mut bb) = (0.0_f32, 0.0_f32, 0.0_f32);
+        for i in range {
+            let x = a.features()[i];
+            let y = b.features()[i];
+            dot += x * y;
+            aa += x * x;
+            bb += y * y;
+        }
+        if aa == 0. && bb == 0. {
+            1.
+        } else if aa == 0. || bb == 0. {
+            0.
+        } else {
+            (dot / (aa.sqrt() * bb.sqrt())).clamp(-1., 1.)
+        }
+    };
+    let score = 0.30 * cosine(0..40)
+        + 0.10 * cosine(40..49)
+        + 0.20 * cosine(49..57)
+        + 0.35 * cosine(57..81)
+        + 0.05 * cosine(81..83);
+    (score >= alife_core::memory::MEMORY_MIN_SIMILARITY).then_some(score)
+}
+
+fn altered_query_frame(
+    frame: &PerceptionFrame,
+    candidates: Vec<ActionCandidate>,
+    tick: Tick,
+    profile: SensorProfile,
+) -> PerceptionFrame {
+    let mut sensory = frame.sensory().clone();
+    sensory.tick = tick;
+    let mut h = *frame.homeostasis();
+    h.tick = tick;
+    let provenance = SensorProfileProvenance::new(profile, sensory.abi_version, tick).unwrap();
+    PerceptionFrameDraft::new(
+        frame.organism_id(),
+        tick,
+        profile,
+        sensory,
+        frame.body(),
+        h,
+        candidates,
+        provenance,
+        frame.grounded_object_slots().to_vec(),
+    )
+    .unwrap()
+    .finalize(frame.context().clone())
+    .unwrap()
+}
