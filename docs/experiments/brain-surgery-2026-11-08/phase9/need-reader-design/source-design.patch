+  evidence: Unknown | Measured(NeedReaderObservationV1),
+  support: Exact | DetachedLocal(receipt) | Unsupported(reason),
+  age_ticks, context_similarity: Option<f32>, pressure_distance: [f32;11]
+}
+NeedReaderFeaturesV1 {
