+        require(
+            bytes(&trainer.checkpoint())? == checkpoint_before
+                && bytes(&life.host.checkpoint(&life.trainer)?)? == host_before
+                && bytes(&life.trainer.checkpoint())? == trainer_before,
+            "after_shadow_preservation",
+        )?;
+    }
+    let physical:Vec<Value>=audit.motor.channel_receipts.iter().map(|c|json!({"action":c.command.primitive.0,"target":role(life,c.command.target.and_then(|t|t.entity)),"succeeded":c.succeeded,"contact_consumed":c.physical.contact==PhysicalContactKind::Consumed,"displacement":[c.physical.displacement.x,c.physical.displacement.y,c.physical.displacement.z],"transfers":c.grip_transfers.iter().map(|t|json!({"target":role(life,Some(t.object)),"kind":match t.kind {GripTransferKind::Acquired=>"acquired",GripTransferKind::Released=>"released",GripTransferKind::Placed=>"placed",GripTransferKind::Consumed=>"consumed"}})).collect::<Vec<_>>()})).collect();
+    require(
+        bytes(&life.host.checkpoint(&life.trainer)?)? == host_before
+            && bytes(&life.trainer.checkpoint())? == trainer_before,
+        "projection_preservation",
+    )?;
+    Ok(
+        json!({"sequence":audit.sequence.raw(),"sampling_counter":row.sampling_counter,"baseline_replay_matches_actual":true,"preservation":true,"variants":variant_rows,"actual_physical":physical}),
+    )
+}
+fn run(scene: Scene, asset: &FoundationWeightAsset, sink: &mut Sink) -> Result<Value> {
+    sink.stage = "construction";
+    sink.emit(json!({"kind":"life_attempt","seed":scene.seed}))?;
+    let mut prep_attempts = 0u16;
+    let mut prep_returned = 0u16;
+    let mut life = make_life_observed::<PREPARATION_TICKS>(scene, asset, |returned| {
+        if returned {
+            prep_returned += 1;
+        } else {
+            prep_attempts += 1;
+        }
+        sink.stage = "preparation";
+        sink.emit(json!({"kind":"preparation_progress","seed":scene.seed,"attempted":prep_attempts,"returned":prep_returned}))
+    })?;
+    require(
+        prep_attempts == 600 && prep_returned == 600,
+        "preparation_count",
+    )?;
+    let mut meals = [0u16; 2];
+    let mut steps = 0u16;
+    let mut decisions = 0u16;
+    let mut stop = "tick_budget";
+    let founder_before = bytes(&life.trainer.checkpoint())?;
+    sink.emit(json!({"kind":"life_prepared","seed":scene.seed,"world_tick":life.host.world().tick().raw(),"sampling_seed":life.sampling_seed,"initial_body_sha256":digest(&life.initial_body_biology),"initial_scene_sha256":digest(&life.initial_scene),"off_asset_sha256":digest(&asset.encode_canonical()?)}))?;
+    for index in 0..PRIMARY_TICKS {
+        sink.stage = "host_step";
+        sink.emit(json!({"kind":"step_attempt","seed":scene.seed,"primary_step":index+1,"returned_steps":steps}))?;
+        let step = life.host.step_with_swap_audit(&life.trainer, TEMPERATURE)?;
+        steps += 1;
+        sink.emit(json!({"kind":"step_returned","seed":scene.seed,"primary_step":steps}))?;
+        require(
+            step.decisions.len() <= 1 && step.decisions.len() == step.swap_audits.len(),
+            "population",
+        )?;
+        let mut projections = Vec::new();
+        for (row, audit) in step.decisions.iter().zip(&step.swap_audits) {
+            decisions += 1;
+            sink.stage = "passive_replay";
+            projections.push(project(&life, row, audit)?);
+            for (i, target) in life.targets.iter().enumerate() {
+                if audit.motor.channel_receipts.iter().any(|c| {
+                    c.physical.contact == PhysicalContactKind::Consumed
+                        && c.physical.target_entity == Some(*target)
+                }) {
+                    meals[i] += 1;
+                }
+            }
+        }
+        require(
+            bytes(&life.trainer.checkpoint())? == founder_before,
+            "founder_mutation",
+        )?;
+        let record = life
+            .host
+            .world()
+            .organism_registry()
+            .get(life.own)
+            .ok_or("organism")?;
+        let body = record.biochemistry().body;
+        let alive = record.lifecycle().is_alive();
+        finite(body.health)?;
+        finite(body.injury)?;
+        finite(body.energy)?;
+        sink.stage = "public_projection";
+        sink.emit(json!({"kind":"step","seed":scene.seed,"primary_step":steps,"world_tick":life.host.world().tick().raw(),"health":body.health,"injury":body.injury,"energy":body.energy,"alive":alive,"sleeping":step.sleeping_organisms,"consolidations":step.sleep_consolidations,"meals_h_s":meals,"decisions":projections}))?;
+        if !alive {
+            stop = "death";
+            break;
+        }
+        if body.health < 0.70 {
+            stop = "health";
+            break;
+        }
+        if body.injury > 0.25 {
+            stop = "injury";
+            break;
+        }
+        if meals[0] >= 3 {
+            stop = "third_harmful_meal";
+            break;
+        }
+    }
+    let summary = json!({"kind":"life_complete","seed":scene.seed,"preparation_ticks":prep_returned,"primary_steps":steps,"decisions":decisions,"meals_h_s":meals,"stop":stop});
+    sink.emit(summary.clone())?;
+    Ok(summary)
+}
+fn execute() -> Result<()> {
+    let root = std::env::args().nth(1).ok_or("output_path")?;
+    std::fs::create_dir(&root)?;
+    let file = std::fs::OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(std::path::Path::new(&root).join("events.ndjson"))?;
+    let mut sink = Sink {
+        file,
+        written: 0,
+        deadline: std::time::Instant::now(),
+        stage: "asset_construction",
+    };
+    sink.emit(json!({"kind":"invocation","seeds":[2026112401u64,2026112402u64],"gains":[0.,0.0625,0.25,1.,4.],"max_lives":2,"max_preparation_per_life":600,"max_primary_per_life":256,"max_public_bytes":64*1024*1024,"backend":"CPU","variant_actions_applied":false}))?;
+    let result = (|| -> Result<()> {
+        let (_, asset) = candidate_gain(2026110901, 0.)?;
+        for scene in SCENES {
+            run(scene, &asset, &mut sink)?;
+        }
+        Ok(())
+    })();
+    match result {
+        Ok(()) => {
+            sink.emit(json!({"kind":"invocation_complete"}))?;
+            println!("shadow_probe_complete");
+            Ok(())
+        }
+        Err(error) => {
+            let stage = sink.stage;
+            let code = error
+                .downcast_ref::<Gate>()
+                .map_or("closed_native_failure", |e| e.0);
+            let _=sink.emit(json!({"kind":"invocation_failed","stage":stage,"error":code,"retry_permitted":false}));
+            Err("closed_native_failure".into())
+        }
+    }
+}
+fn main() {
+    std::panic::set_hook(Box::new(|_| eprintln!("closed_native_panic")));
+    if execute().is_err() {
+        eprintln!("closed_shadow_failure");
+        std::process::exit(1);
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn bounded_scalar_probability() {
+        assert_eq!(probability(&[0., 0.], 0, 3), 0.5);
+        assert_eq!(probability(&[0., 0.], 1, 1), 0.);
+        assert_eq!(probability(&[0., 0.], 0, 1), 1.);
+    }
+    #[test]
+    fn detached_nonzero_components_offsets_and_gain_identity() -> Result<()> {
+        use alife_training::{TrainingInitialState, TrainingReplayCandidate, TrainingReplayTick};
+        let (base, base_asset) = candidate_gain(2026110901, 0.)?;
+        let mut baseline_recurrent = None;
+        let mut cap_seen = false;
+        for gain in [0., 0.0625, 4.] {
+            let (p, asset) = candidate_gain(2026110901, gain)?;
+            let repacked = FoundationWeightAsset::from_trained_weights(
+                &p,
+                asset.weights().to_vec(),
+                TrainingStageManifest::bootstrap(),
+            )?;
+            assert_eq!(repacked.digest(), asset.digest());
+            let changed = base_asset
+                .weights()
+                .iter()
+                .zip(asset.weights())
+                .filter(|(a, b)| a.to_bits() != b.to_bits())
+                .count();
+            assert_eq!(changed, if gain == 0. { 0 } else { 16 });
+            assert_eq!(p.projections(), base.projections());
+            for (a, b) in p.synapses().iter().zip(base.synapses()) {
+                assert_eq!(a.kind(), b.kind());
+                assert_eq!(a.source(), b.source());
+                assert_eq!(a.target(), b.target());
+            }
+            let n = p.neuron_count() as usize;
+            let q = TrainingSequence {
+                phenotype_hash: p.phenotype_hash(),
+                initial: TrainingInitialState {
+                    activations: vec![0.13; n],
+                    activity_ema: vec![0.11; n],
+                    metabolic_load: vec![0.01; n],
+                    dendrites: DendriticBranchSet::new(Vec::new())?,
+                },
+                ticks: vec![TrainingReplayTick {
+                    encoded_inputs: vec![0.02; n],
+                    projection_gain: 1.,
+                    local_threshold_shift: 0.,
+                    microstep_count: u32::from(p.microstep_count()),
+                    enabled_routes: vec![true; p.projections().len()],
+                    effective_weight_offsets: p
+                        .synapses()
+                        .iter()
+                        .map(|s| {
+                            if matches!(s.kind(), CompiledSynapseKind::Decoder(_)) {
+                                0.0137
+                            } else {
+                                0.
+                            }
+                        })
+                        .collect(),
+                    structural_synapses: Vec::new(),
+                    candidates: [
+                        CandidateActionFamily::Contact,
+                        CandidateActionFamily::Other,
+                        CandidateActionFamily::Ingest,
+                    ]
+                    .iter()
+                    .map(|family| {
+                        let mut inputs = [0.; 54];
+                        for (i, v) in inputs.iter_mut().enumerate() {
+                            *v = (i as f32 - 10.) * 0.01;
+                        }
+                        inputs[53] = if *family == CandidateActionFamily::Ingest {
+                            0.
+                        } else {
+                            0.9
+                        };
+                        TrainingReplayCandidate {
+                            family: *family,
+                            decoder_inputs: inputs,
+                            innate_bias: 0.17,
+                        }
+                    })
+                    .collect(),
+                }],
+                burn_in_ticks: 0,
+                memory_candidate_gain: 12.,
+            };
+            let trainer = CpuFoundationTrainer::new(
+                p.clone(),
+                asset,
+                StageTrainableMask::recurrent_only(&p)?,
+                AdamWConfig::default(),
+            )?;
+            let before = bytes(&trainer.checkpoint())?;
+            let output = trainer.evaluate_replay(&q)?;
+            let recurrence = bytes(&(
+                &output.final_activations,
+                &output.final_activity_ema,
+                &output.final_metabolic_load,
+            ))?;
+            if gain == 0. {
+                baseline_recurrent = Some(recurrence);
+            } else {
+                assert_eq!(Some(recurrence), baseline_recurrent);
+            }
+            for i in 0..3 {
+                let c = components(
+                    &p,
+                    trainer.weights(),
+                    &q.ticks[0],
+                    &output.final_activations[0],
+                    i,
+                )?;
+                assert_eq!(c.total.to_bits(), output.candidate_logits[0][i].to_bits());
+                assert_ne!(c.action, 0.);
+                assert_ne!(c.memory, 0.);
+                assert_ne!(c.family, 0.);
+                if i < 2 {
+                    assert_ne!(c.effective_coeff[2], c.inherited_coeff[2]);
+                }
+                cap_seen |= c.memory.abs() > 12.;
+            }
+            assert_eq!(bytes(&trainer.checkpoint())?, before);
+        }
+        assert!(cap_seen);
+        Ok(())
+    }
+}
