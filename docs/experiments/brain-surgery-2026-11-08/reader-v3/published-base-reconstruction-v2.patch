+                .iter()
+                .map(|mask| probability(logits, i, *mask))
+                .collect();
+            for v in logits
+                .iter()
+                .chain(inherited_coeff.iter())
+                .chain(effective_coeff.iter())
+                .chain(motor_probability.iter())
+                .chain([memory, cognitive, action, op, target, family, total].iter())
+            {
+                finite(*v)?;
+            }
+            let source = evidence.best_family_source.as_ref();
+            candidates.push(json!({"index":i,"target":role(life,candidate.target.entity),"action":candidate.action_id.0,"family":candidate.family.raw(),"input53":finite(input.decoder_inputs[53])?,"input25":finite(input.decoder_inputs[25])?,"input26":finite(input.decoder_inputs[26])?,"input32":finite(input.decoder_inputs[32])?,"memory_raw":memory,"memory_clamped":memory.clamp(-12.,12.),"operation_component":op,"target25_26_component":target,"family32_component":family,"action_component":action,"cognitive_raw":cognitive,"cognitive_clamped":cognitive.clamp(-12.,12.),"innate":input.innate_bias,"family_bias":family_bias,"logit":logits[i],"inherited_coeff25_26_53":inherited_coeff,"effective_coeff25_26_53":effective_coeff,"representative_probability":finite(probability(logits,i,choice.representative_mask))?,"motor_conditional_probabilities":motor_probability,"selected_motor_slots":choice.motor_candidates.map(|c|c==Some(i as u16)),"selected_representative":choice.representative==i as u16,"family_confidence":evidence.family_confidence,"target_confidence":evidence.target_confidence,"family_sources":evidence.family_source_count,"target_sources":evidence.target_source_count,"source_sequence":source.map(|s|s.sequence),"source_ingest_family":source.is_some_and(|s|s.family==u16::from(CandidateActionFamily::Ingest.raw())),"source_exact_consumed":source.is_some_and(|s|s.contact==Some(PhysicalContactKind::Consumed)),"source_same_tracked_target":source.is_some_and(|s|Some(TrackedObjectId(s.tracked_target))==evidence.tracked_target),"held":evidence.physical.owner==SwapOwner::ThisOrganism,"held_count":evidence.physical.self_held_object_count,"contact_reachable":evidence.physical.physical_contact_reachable,"grasp_reachable":evidence.physical.grasp_reachable}));
+        }
