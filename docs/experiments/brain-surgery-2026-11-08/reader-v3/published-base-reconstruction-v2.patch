+    #[test]
+    fn detached_gain_ladder_exact_v1_contexts() {
+        let inputs: Vec<serde_json::Value> =
+            serde_json::from_str(include_str!("support/grip_utility_contexts_v1.json")).unwrap();
+        assert_eq!(inputs.len(), 24);
+        let (baseline, baseline_asset) = candidate_gain(2026110901, 0.).unwrap();
+        let mut output = Vec::new();
+        for gain in [0., 1. / 16., 1. / 4., 1., 4.] {
+            let (p, asset) = candidate_gain(2026110901, gain).unwrap();
+            let mut changes = 0;
+            for ((base, new), synapse) in baseline_asset
+                .weights()
+                .iter()
+                .zip(asset.weights())
+                .zip(p.synapses())
+            {
+                if base.to_bits() != new.to_bits() {
+                    let CompiledSynapseKind::Decoder(c) = synapse.kind() else {
+                        panic!("unexpected change")
+                    };
+                    assert_eq!(c.head(), DecoderHeadKind::MemoryContext);
+                    assert_eq!(c.input_lane(), 53);
+                    assert_eq!(*base, 0.);
+                    assert_eq!(
+                        *new,
+                        if c.family() == CandidateActionFamily::Contact {
+                            gain
+                        } else {
+                            assert_eq!(c.family(), CandidateActionFamily::Other);
+                            -gain
+                        }
+                    );
+                    changes += 1;
+                }
+            }
+            assert_eq!(changes, if gain == 0. { 0 } else { 16 });
+            assert_eq!(p.projections(), baseline.projections());
+            assert_eq!(p.neuron_dynamics(), baseline.neuron_dynamics());
+            for (a, b) in p.synapses().iter().zip(baseline.synapses()) {
+                assert_eq!(a.kind(), b.kind());
+                assert_eq!(a.source(), b.source());
+                assert_eq!(a.target(), b.target());
+            }
+            let asset_hex = asset
+                .digest()
+                .bytes()
+                .iter()
+                .map(|b| format!("{b:02x}"))
+                .collect::<String>();
+            let weights = asset.weights().to_vec();
+            let trainer = CpuFoundationTrainer::new(
+                p.clone(),
+                asset,
+                StageTrainableMask::recurrent_only(&p).unwrap(),
+                AdamWConfig::default(),
+            )
+            .unwrap();
+            let before = serde_json::to_vec(&trainer.checkpoint()).unwrap();
+            for (row_index, input) in inputs.iter().enumerate() {
+                let number = |key: &str| input[key].as_f64().unwrap() as f32;
+                let close = input["action_id"] == 2201;
+                let family = if close {
+                    CandidateActionFamily::Contact
+                } else {
+                    CandidateActionFamily::Other
+                };
+                let port = number("lane53");
+                let mut q = sequence(
+                    &p,
+                    &[
+                        (family, number("own_family_lane32"), port),
+                        (CandidateActionFamily::Other, -0.25, 0.),
+                    ],
+                );
+                q.ticks[0].candidates[0].decoder_inputs[26] = number("target_lane26");
+                q.ticks[0].candidates[0].innate_bias = number("task_prior");
+                q.ticks[0].candidates[1].innate_bias = number("ordinary_other_prior");
+                if input["case"] == "unrelated_pain_no_target_evidence" {
+                    q.ticks[0].encoded_inputs[0] = 0.125;
+                }
+                let evaluation = trainer.evaluate_replay(&q).unwrap();
+                let logits = &evaluation.candidate_logits[0];
+                let mut memory_raw = 0.;
+                let mut port_raw = 0.;
+                let mut coefficient = 0.;
+                let mut own_family = 0.;
+                let mut target = 0.;
+                for (synapse, weight) in p.synapses().iter().zip(&weights) {
+                    if let CompiledSynapseKind::Decoder(c) = synapse.kind() {
