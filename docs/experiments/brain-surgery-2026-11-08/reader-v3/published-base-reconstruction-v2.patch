+use serde_json::{json, Value};
+use std::io::Write;
+struct Sink {
+    file: std::fs::File,
+    written: usize,
+    deadline: std::time::Instant,
+    stage: &'static str,
+}
+impl Sink {
+    fn emit(&mut self, value: Value) -> Result<()> {
+        require(self.deadline.elapsed().as_secs() < 1800, "deadline")?;
+        let mut raw = serde_json::to_vec(&value)?;
+        raw.push(b'\n');
+        require(
+            raw.len() <= 512 * 1024 && self.written + raw.len() <= 64 * 1024 * 1024,
+            "output_bound",
+        )?;
+        self.file.write_all(&raw)?;
+        self.file.sync_data()?;
+        self.written += raw.len();
+        Ok(())
+    }
+}
