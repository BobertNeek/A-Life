+use serde_json::{json, Value};
+use std::io::Write;
+struct Sink {
+    file: std::fs::File,
+    written: usize,
+    deadline: std::time::Instant,
+    stage: &'static str,
+}
+impl Sink {
+    fn emit(&mut self, value: Value) -> Result<()> {
+        require(self.deadline.elapsed().as_secs() < 1800, "deadline")?;
+        let mut raw = serde_json::to_vec(&value)?;
+        raw.push(b'\n');
+        require(
+            raw.len() <= 512 * 1024 && self.written + raw.len() <= 64 * 1024 * 1024,
+            "output_bound",
+        )?;
+        self.file.write_all(&raw)?;
+        self.file.sync_data()?;
+        self.written += raw.len();
+        Ok(())
+    }
+}
+fn role(life: &Life, target: Option<WorldEntityId>) -> &'static str {
+    match target {
+        Some(t) if t == life.targets[0] => "h",
+        Some(t) if t == life.targets[1] => "s",
+        None => "none",
+        _ => "other",
+    }
+}
+fn finite(x: f32) -> Result<f32> {
+    require(x.is_finite(), "nonfinite")?;
+    Ok(x)
+}
+fn probability(logits: &[f32], index: usize, mask: u32) -> f32 {
+    if mask & (1 << index) == 0 {
+        return 0.;
+    }
+    let max = logits
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| mask & (1 << i) != 0)
+        .map(|(_, v)| *v)
+        .fold(f32::NEG_INFINITY, f32::max);
+    let total: f32 = logits
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| mask & (1 << i) != 0)
+        .map(|(_, v)| (*v - max).exp())
+        .sum();
+    (logits[index] - max).exp() / total
+}
+struct Components {
+    memory: f32,
+    cognitive: f32,
+    action: f32,
+    op: f32,
+    target: f32,
+    family: f32,
+    inherited_coeff: [f32; 3],
+    effective_coeff: [f32; 3],
+    family_bias: f32,
+    total: f32,
+}
+fn components(
+    p: &BrainPhenotype,
+    weights: &[f32],
+    tick: &alife_training::TrainingReplayTick,
+    activations: &[f32],
+    index: usize,
+) -> Result<Components> {
+    let input = &tick.candidates[index];
+    let family_bias = p
+        .candidate_decoder()
+        .families()
+        .iter()
+        .find(|f| f.family() == input.family)
+        .ok_or("family")?
+        .bias();
+    let mut total = family_bias + input.innate_bias;
+    let mut memory = 0.;
+    let mut cognitive = 0.;
+    let mut action = 0.;
+    let mut op = 0.;
+    let mut target = 0.;
+    let mut family = 0.;
+    let mut inherited_coeff = [0.; 3];
+    let mut effective_coeff = [0.; 3];
+    for (j, synapse) in p.synapses().iter().enumerate() {
+        let CompiledSynapseKind::Decoder(c) = synapse.kind() else {
+            continue;
+        };
+        if c.family() != input.family {
+            continue;
+        }
+        let effective = weights[j] + tick.effective_weight_offsets[j];
+        let v = input.decoder_inputs[c.input_lane() as usize] * effective;
+        match c.head() {
+            DecoderHeadKind::MemoryContext => {
+                memory += v;
+                if c.input_lane() == 53 {
+                    op += v;
+                }
+                if [25, 26].contains(&c.input_lane()) {
+                    target += v;
+                }
+                if c.input_lane() == 32 {
+                    family += v;
+                }
+                for (k, lane) in [25, 26, 53].into_iter().enumerate() {
+                    if c.input_lane() == lane {
+                        inherited_coeff[k] += weights[j];
+                        effective_coeff[k] += effective;
+                    }
+                }
+            }
+            DecoderHeadKind::CognitiveContext => cognitive += v,
+            DecoderHeadKind::ActionCandidate => {
+                let contribution = activations[synapse.source() as usize] * v;
+                action += contribution;
+                total += contribution;
+            }
+            _ => {}
+        }
+    }
+    total += memory.clamp(-12., 12.) + cognitive.clamp(-12., 12.);
+    Ok(Components {
+        memory,
+        cognitive,
+        action,
+        op,
+        target,
+        family,
+        inherited_coeff,
+        effective_coeff,
+        family_bias,
+        total,
+    })
+}
+fn project(life: &Life, row: &CpuCollectedDecision, audit: &CpuSwapAudit) -> Result<Value> {
+    let host_before = bytes(&life.host.checkpoint(&life.trainer)?)?;
+    let trainer_before = bytes(&life.trainer.checkpoint())?;
+    let frame = row.patch.pre_action().perception();
+    require(
+        frame.frame_digest() == audit.frame_digest
+            && audit.candidates.len() == frame.candidates().len(),
+        "audit_binding",
+    )?;
+    require(frame.candidates().len() <= 32, "candidate_bound")?;
+    let mut variant_rows = Vec::new();
+    let mut baseline_final = None;
+    for (gain, trainer) in &life.shadows {
+        let checkpoint_before = bytes(&trainer.checkpoint())?;
+        require(
+            bytes(&life.host.checkpoint(&life.trainer)?)? == host_before
+                && bytes(&life.trainer.checkpoint())? == trainer_before,
+            "before_shadow_preservation",
+        )?;
+        let p = trainer.phenotype();
+        let q = TrainingSequence {
+            phenotype_hash: p.phenotype_hash(),
+            initial: row.initial.clone(),
+            ticks: vec![row.replay_tick.clone()],
+            burn_in_ticks: 0,
+            memory_candidate_gain: 12.,
+        };
+        let output = trainer.evaluate_replay(&q)?;
+        let logits = &output.candidate_logits[0];
+        let choice = sample_cpu_joint_action(
+            p,
+            frame,
+            logits,
+            life.sampling_seed,
+            row.sampling_counter.ok_or("counter")?,
+            TEMPERATURE,
+        )?;
+        if *gain == 0. {
+            require(
+                bytes(&choice)? == bytes(&row.action)?,
+                "actual_replay_mismatch",
+            )?;
+            baseline_final = Some(bytes(&(
+                &output.final_activations,
+                &output.final_activity_ema,
+                &output.final_metabolic_load,
+            ))?);
+        } else {
+            require(
+                Some(bytes(&(
+                    &output.final_activations,
+                    &output.final_activity_ema,
+                    &output.final_metabolic_load,
+                ))?) == baseline_final,
+                "recurrent_shadow_mismatch",
+            )?;
+        }
+        let mut candidates = Vec::new();
+        for (i, (candidate, input)) in frame
+            .candidates()
+            .iter()
+            .zip(&row.replay_tick.candidates)
+            .enumerate()
+        {
+            let evidence = &audit.candidates[i];
+            require(
+                evidence.candidate_index as usize == i
+                    && evidence.world_target == candidate.target.entity,
+                "candidate_binding",
+            )?;
+            let Components {
+                memory,
+                cognitive,
+                action,
+                op,
+                target,
+                family,
+                inherited_coeff,
+                effective_coeff,
+                family_bias,
+                total,
+            } = components(
+                p,
+                trainer.weights(),
+                &row.replay_tick,
+                &output.final_activations[0],
+                i,
+            )?;
+            require(
+                total.to_bits() == logits[i].to_bits(),
+                "score_decomposition",
+            )?;
+            let motor_probability: Vec<f32> = choice
+                .motor_masks
+                .iter()
+                .map(|mask| probability(logits, i, *mask))
+                .collect();
+            for v in logits
+                .iter()
+                .chain(inherited_coeff.iter())
+                .chain(effective_coeff.iter())
+                .chain(motor_probability.iter())
+                .chain([memory, cognitive, action, op, target, family, total].iter())
+            {
+                finite(*v)?;
+            }
+            let source = evidence.best_family_source.as_ref();
