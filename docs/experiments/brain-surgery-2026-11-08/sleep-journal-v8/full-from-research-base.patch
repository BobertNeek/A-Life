+#[test]
+fn baseline_readable_explicit_sequence_does_not_consume_enclosing_sentinel() {
+    // Decoder compatibility only: explicit None avoids the pre-existing nested
+    // physiology codec limitation. The old encoder skips this None field, so
+    // this controlled sequence is not claimed as an old encoder roundtrip.
+    let mut outcome = measured_v12_outcome(v12_joint_outcome());
+    outcome.measured_physiology = None;
+    let bytes = encode(&Envelope {
+        outcome: ExplicitOutcomeSequence(&outcome),
+        sentinel: 0xf1e2d3c4b5a69788,
+    })
+    .unwrap();
+    // First prove this exact nested format was supported by the old wire.
+    let old: Envelope<BaselinePostActionOutcome> = decode(&bytes).unwrap();
+    let new: Envelope<PostActionOutcome> = decode(&bytes).unwrap();
+    assert_eq!(new.sentinel, old.sentinel);
+    assert_eq!(new.outcome, outcome);
+    assert_eq!(
+        bytes,
+        encode(&Envelope {
+            outcome: ExplicitOutcomeSequence(&outcome),
+            sentinel: old.sentinel
+        })
+        .unwrap()
+    );
+}
