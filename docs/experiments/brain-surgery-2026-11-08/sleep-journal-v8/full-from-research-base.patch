+fn canonical_version3_non_interruption_edge(
+    source: SleepState,
+    target: SleepState,
+    tick: Tick,
+) -> bool {
+    use alife_core::SleepPhase;
+    if source.schema_version != alife_core::SLEEP_INTERRUPTION_SCHEMA_VERSION
+        || target.schema_version != source.schema_version
+    {
+        return false;
+    }
+    match (source.consolidation, target.consolidation) {
+        (ConsolidationState::None, ConsolidationState::None) => {
+            target.phase_started_tick == tick && canonical_pre_pending_phase_edge(source, target)
+        }
+        (ConsolidationState::None, ConsolidationState::Pending { .. })
+        | (ConsolidationState::Pending { .. }, ConsolidationState::Prepared { .. })
+        | (ConsolidationState::Prepared { .. }, ConsolidationState::Submitted { .. })
+        | (ConsolidationState::Completed { .. }, ConsolidationState::Committed { .. }) => {
+            sleep_identity_unchanged_except_consolidation(source, target)
+        }
+        (ConsolidationState::Committed { .. }, ConsolidationState::Committed { .. }) => {
+            source.phase == SleepPhase::Consolidating
