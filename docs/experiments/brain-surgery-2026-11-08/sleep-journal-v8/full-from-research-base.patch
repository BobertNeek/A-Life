+fn old_map_duplicate_unknown_and_numeric_field_behavior_is_preserved() {
+    let old = measured_v12_outcome(v12_joint_outcome());
+    let text = serde_json::to_string(&old).unwrap();
+    let duplicate = text.replacen("{", &format!("{{\"abi_version\":{},", old.abi_version), 1);
+    assert!(serde_json::from_str::<BaselinePostActionOutcome>(&duplicate).is_err());
+    assert!(serde_json::from_str::<PostActionOutcome>(&duplicate).is_err());
+    let mut value = serde_json::to_value(&old).unwrap();
+    value["unknown_future_field"] = serde_json::json!([1, 2, 3]);
+    assert!(serde_json::from_value::<BaselinePostActionOutcome>(value.clone()).is_ok());
+    assert_eq!(
+        serde_json::from_value::<PostActionOutcome>(value).unwrap(),
+        old
+    );
+    // Numeric field identifiers are exercised through serde's value adapters,
+    // independent of JSON (whose object keys can only be strings).
+    let map = serde_json::to_value(&old).unwrap();
+    let names = [
+        "abi_version",
+        "organism_id",
+        "sequence_id",
+        "outcome_tick",
+        "success",
+        "physical",
+        "homeostatic_delta",
+        "reward_valence",
+        "frustration_delta",
+        "pain_delta",
+        "energy_delta",
+        "prediction_error",
+        "contradiction_observed",
+        "concept_hints",
+        "memory_hints",
+        "teacher_feedback",
+        "joint",
+        "cognitive_work",
+        "measured_physiology",
+    ];
+    let full_fields: Vec<_> = names
+        .iter()
+        .enumerate()
+        .filter_map(|(i, name)| map.get(*name).map(|value| (i as u64, value.clone())))
+        .collect();
+    let old_full =
+        BaselinePostActionOutcome::deserialize(serde::de::value::MapDeserializer::<
+            _,
+            serde_json::Error,
+        >::new(full_fields.clone().into_iter()))
+        .unwrap();
+    let new_full = PostActionOutcome::deserialize(serde::de::value::MapDeserializer::<
+        _,
+        serde_json::Error,
+    >::new(full_fields.into_iter()))
+    .unwrap();
+    assert_eq!(new_full, old);
+    assert_eq!(
+        serde_json::to_value(old_full).unwrap(),
+        serde_json::to_value(new_full).unwrap()
+    );
+    let fields = [(0u64, old.abi_version)];
+    let old_error = BaselinePostActionOutcome::deserialize(serde::de::value::MapDeserializer::<
+        _,
+        serde::de::value::Error,
+    >::new(fields.into_iter()))
+    .unwrap_err();
+    let new_error = PostActionOutcome::deserialize(serde::de::value::MapDeserializer::<
+        _,
+        serde::de::value::Error,
+    >::new(fields.into_iter()))
+    .unwrap_err();
+    assert_eq!(old_error.to_string(), new_error.to_string());
+    assert!(old_error.to_string().contains("organism_id"));
+}
