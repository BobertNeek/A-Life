+#[test]
+fn cpu_acute_contact_interrupts_then_resumes_the_same_unfinished_cycle() {
+    let (mut host, trainer) = prepared(true);
+    let id = host.world().organism_entity_ids()[0].0;
+    host.request_recovery_sleep(id).unwrap();
+    let original = host.checkpoint(&trainer).unwrap();
+    let cycle = original.residents[0].sleep.state().active_cycle_id;
+    let step = host
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    assert!(step.decisions.is_empty());
+    let interrupted = host.checkpoint(&trainer).unwrap();
+    let sleep = interrupted.residents[0].sleep.state();
+    assert_eq!(sleep.phase, SleepPhase::InterruptedForcedRecoverySleep);
+    assert_eq!(sleep.active_cycle_id, cycle);
+    assert_eq!(sleep.cycles_completed, 0);
+    assert_eq!(
+        interrupted.residents[0].neural,
+        original.residents[0].neural
+    );
+    assert_eq!(
+        interrupted.residents[0].next_sequence,
+        original.residents[0].next_sequence
+    );
+    let mut restored = CpuCanonicalHost::from_checkpoint(interrupted.clone(), &trainer).unwrap();
+    // Removing actual contact is an ordinary scene edit; no neural or biology override.
+    for candidate in [&mut host, &mut restored] {
+        let hazards = candidate
+            .world()
+            .object_snapshots()
+            .into_iter()
+            .filter(|o| o.kind == WorldObjectKind::Hazard)
+            .map(|o| o.id)
+            .collect::<Vec<_>>();
+        for hazard in hazards {
+            candidate.world_mut().editor_remove_object(hazard).unwrap();
+        }
+    }
+    let aroused = host
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    let restored_aroused = restored
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    assert_eq!(
+        aroused.decisions.len(),
+        1,
+        "affordable aroused cognition gets one real decision"
+    );
+    assert_eq!(restored_aroused.decisions.len(), 1);
+    let resumed = host.checkpoint(&trainer).unwrap();
+    assert_eq!(
+        serde_json::to_vec(&resumed).unwrap(),
+        serde_json::to_vec(&restored.checkpoint(&trainer).unwrap()).unwrap()
+    );
+    assert_eq!(
+        resumed.residents[0].next_sequence,
+        interrupted.residents[0].next_sequence + 1
+    );
+    assert_eq!(
+        resumed.residents[0].sleep.state().phase,
+        SleepPhase::ForcedRecoverySleep
+    );
+    assert_eq!(resumed.residents[0].sleep.state().active_cycle_id, cycle);
+    assert_eq!(resumed.residents[0].sleep.state().cycles_completed, 0);
+    assert_eq!(aroused.sleep_consolidations, 0);
+    // The real replay remains and is consolidated only after resuming actual sleep.
+    let mut consolidations = 0;
+    for _ in 0..32 {
+        let step = host
+            .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+            .unwrap();
+        consolidations += step.sleep_consolidations;
+        let state = host.checkpoint(&trainer).unwrap().residents[0]
+            .sleep
+            .state();
+        if state.phase == SleepPhase::Awake {
+            assert_eq!(state.cycles_completed, 1);
+            assert_eq!(state.last_consolidated_cycle_id, cycle);
+            break;
+        }
+    }
+    assert_eq!(consolidations, 1);
+    assert_eq!(
+        host.checkpoint(&trainer).unwrap().residents[0]
+            .sleep
+            .state()
+            .cycles_completed,
+        1
+    );
+}
+
+#[test]
+fn cpu_restored_interrupt_releases_when_candidate_option_is_not_repeated() {
+    let (mut source, trainer) = prepared(true);
+    let id = source.world().organism_entity_ids()[0].0;
+    source.request_recovery_sleep(id).unwrap();
+    source
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    let checkpoint = source.checkpoint(&trainer).unwrap();
+    assert!(checkpoint.residents[0].sleep.state().phase.is_interrupted());
+    let cycle = checkpoint.residents[0].sleep.state().active_cycle_id;
+    let mut restored = CpuCanonicalHost::from_checkpoint(checkpoint.clone(), &trainer).unwrap();
+    let mut control = CpuCanonicalHost::from_checkpoint(checkpoint, &trainer).unwrap();
+    // The mode is per-call and is not a checkpoint option. A restored armed
+    // interruption may permit one real decision, but must not latch forever.
+    let first = restored.step(&trainer, 1.0).unwrap();
+    control.step(&trainer, 1.0).unwrap();
+    assert_eq!(first.decisions.len(), 1);
+    let released = restored.checkpoint(&trainer).unwrap();
+    assert_eq!(
+        released.residents[0].sleep.state().phase,
+        SleepPhase::ForcedRecoverySleep
+    );
+    assert_eq!(released.residents[0].sleep.state().active_cycle_id, cycle);
+    assert_eq!(released.residents[0].sleep.state().cycles_completed, 0);
+    assert_eq!(
+        serde_json::to_vec(&released).unwrap(),
+        serde_json::to_vec(&control.checkpoint(&trainer).unwrap()).unwrap()
+    );
+    let second = restored.step(&trainer, 1.0).unwrap();
+    assert!(second.decisions.is_empty());
+    assert_eq!(second.sleep_consolidations, 0);
+}
