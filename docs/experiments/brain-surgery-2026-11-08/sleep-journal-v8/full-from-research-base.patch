+#[derive(Debug, Serialize, Deserialize)]
+struct Envelope<T> {
+    outcome: T,
+    sentinel: u64,
+}
+
+/// Explicit positional fixture, not a copy of the production serializer.
+struct ExplicitOutcomeSequence<'a>(&'a PostActionOutcome);
+impl Serialize for ExplicitOutcomeSequence<'_> {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        use serde::ser::SerializeTuple;
+        let v13 = self.0.abi_version == PostActionOutcome::V13_ABI_VERSION;
+        let mut tuple = serializer.serialize_tuple(if v13 { 20 } else { 19 })?;
+        tuple.serialize_element(&self.0.abi_version)?;
+        tuple.serialize_element(&self.0.organism_id)?;
+        tuple.serialize_element(&self.0.sequence_id)?;
+        tuple.serialize_element(&self.0.outcome_tick)?;
+        tuple.serialize_element(&self.0.success)?;
+        tuple.serialize_element(&self.0.physical)?;
+        tuple.serialize_element(&self.0.homeostatic_delta)?;
+        tuple.serialize_element(&self.0.reward_valence)?;
+        tuple.serialize_element(&self.0.frustration_delta)?;
+        tuple.serialize_element(&self.0.pain_delta)?;
+        tuple.serialize_element(&self.0.energy_delta)?;
+        tuple.serialize_element(&self.0.prediction_error)?;
+        tuple.serialize_element(&self.0.contradiction_observed)?;
+        tuple.serialize_element(&self.0.concept_hints)?;
+        tuple.serialize_element(&self.0.memory_hints)?;
+        tuple.serialize_element(&self.0.teacher_feedback)?;
+        tuple.serialize_element(&self.0.joint)?;
+        tuple.serialize_element(&self.0.cognitive_work)?;
+        tuple.serialize_element(&self.0.measured_physiology)?;
+        if v13 {
+            tuple.serialize_element(&self.0.contact_withdrawal)?;
+        }
+        tuple.end()
+    }
+}
