+//! Fresh, fixed CPU integration fixtures. No retained creature exposure.
+use super::*;
+
+pub(super) fn prepared(painful: bool) -> (CpuCanonicalHost, CpuFoundationTrainer) {
+    let (game, trainer) = new_game_fixture(None);
+    let (host, ()) = CpuCanonicalHost::new_prepared_cohort(game, &trainer, 0x5271, |world| {
+        // Remove unrelated painful geometry so the fixture has exactly one cause.
+        let hazards = world
+            .object_snapshots()
+            .into_iter()
+            .filter(|o| o.kind == WorldObjectKind::Hazard)
+            .map(|o| o.id)
+            .collect::<Vec<_>>();
+        for id in hazards {
+            world.editor_remove_object(id)?;
+        }
+        if painful {
+            let (_, body) = world.organism_entity_ids()[0];
+            let p = world.entity(body).unwrap().position;
+            world.editor_spawn_object(WorldEditorSpawnSpec {
+                label: "reflex-fixture-contact".into(),
+                kind: WorldObjectKind::Hazard,
+                organism_id: None,
+                position: Vec3f::new(p.x + 0.2, p.y, p.z),
+                nutrition: 0.0,
+                hazard_pain: 0.12,
+                radius: 0.6,
+                token_id: None,
+            })?;
+        }
+        Ok::<_, ScaffoldContractError>(())
+    })
+    .unwrap();
+    (host, trainer)
+}
+
+#[test]
+fn cpu_contact_withdrawal_candidate_seals_one_actual_reflex_and_restores_exactly() {
+    let (mut host, trainer) = prepared(true);
+    let mut baseline = host.clone();
+    let founder_before = trainer.checkpoint();
+    let before = host.checkpoint(&trainer).unwrap();
+    let voluntary = baseline.step(&trainer, 1.0).unwrap();
+    let step = host
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    assert_eq!(step.decisions.len(), 1);
+    let patch = &step.decisions[0].patch;
+    patch.validate_contract().unwrap();
+    let reflex = patch.outcome().contact_withdrawal.as_ref().unwrap();
+    assert_eq!(patch.header().abi_version, ExperiencePatch::V13_ABI_VERSION);
+    assert_eq!(
+        reflex.direction_basis,
+        ContactWithdrawalDirectionBasis::LocalizedContact
+    );
+    assert!(!reflex.blocked);
+    assert_eq!(
+        patch.selected_bundle(),
+        voluntary.decisions[0].patch.selected_bundle()
+    );
+    assert_eq!(
+        patch.outcome().joint.as_ref().unwrap().channel_outcomes,
+        voluntary.decisions[0]
+            .patch
+            .outcome()
+            .joint
+            .as_ref()
+            .unwrap()
+            .channel_outcomes
+    );
+    let movement = voluntary.decisions[0].patch.outcome().physical.displacement;
+    assert_eq!(
+        patch.outcome().physical.displacement,
+        Vec3f::new(
+            movement.x + reflex.displacement.x,
+            movement.y + reflex.displacement.y,
+            movement.z + reflex.displacement.z
+        )
+    );
+    let after = host.checkpoint(&trainer).unwrap();
+    assert_eq!(after.sampling_counter, before.sampling_counter + 1);
+    assert_eq!(
+        after.residents[0].next_sequence,
+        before.residents[0].next_sequence + 1
+    );
+    assert_eq!(
+        after.residents[0].neural.weight_generation,
+        before.residents[0].neural.weight_generation + 1
+    );
+    assert_eq!(
+        trainer.checkpoint(),
+        founder_before,
+        "founder weights, moments and optimizer ages stay untouched"
+    );
+    let row: CpuCollectedDecision =
+        serde_json::from_slice(&serde_json::to_vec(&step.decisions[0]).unwrap()).unwrap();
+    assert_eq!(row.patch, *patch);
+    let after: CpuCanonicalCheckpoint =
+        serde_json::from_slice(&serde_json::to_vec(&after).unwrap()).unwrap();
+    let mut restored = CpuCanonicalHost::from_checkpoint(after, &trainer).unwrap();
+    let a = host
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    let b = restored
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    assert_eq!(
+        serde_json::to_vec(&a.decisions).unwrap(),
+        serde_json::to_vec(&b.decisions).unwrap()
+    );
+    assert_eq!(
+        serde_json::to_vec(&host.checkpoint(&trainer).unwrap()).unwrap(),
+        serde_json::to_vec(&restored.checkpoint(&trainer).unwrap()).unwrap()
+    );
+    assert_eq!(trainer.checkpoint(), founder_before);
+}
