+#[test]
+fn v13_reflex_export_rejects_tampering_and_duplicate_admission_without_optimizer_changes() {
+    let (mut host, trainer) = super::contact_withdrawal::prepared(true);
+    let (_, value, inputs) = fixture();
+    let mut decisions = Vec::new();
+    for _ in 0..4 {
+        decisions.extend(
+            host.step_with_contact_withdrawal_candidate(&trainer, config().temperature)
+                .unwrap()
+                .decisions,
+        );
+    }
+    assert_eq!(decisions.len(), 4);
+    assert_eq!(
+        decisions[0].patch.header().abi_version,
+        ExperiencePatch::V13_ABI_VERSION
+    );
+    let final_record = host
+        .world()
+        .organism_registry()
+        .get(decisions[0].organism_id)
+        .unwrap()
+        .clone();
+    let source = CpuCollectorShardV1::seal(
+        CpuCollectionSnapshotV1::capture(&trainer, &value, &inputs, config(), VERSION).unwrap(),
+        CpuCollectorAssignmentV1 {
+            collector_run_id: "v13-reflex".into(),
+            backend: FoundationTrainingBackendV1::NativeCpu,
+            producer_revision: "fixed-v13-reflex-guard".into(),
+            world_seed: 0x7A1123,
+            sampling_seed: 0x5271,
+            sampling_counter_start: 0,
+            sampling_counter_end: 4,
+            lesson: "fixed-v13-reflex-guard".into(),
+            episode_config_sha256: [2; 32],
+        },
+        vec![CpuCollectorTrajectoryV1 {
+            final_record,
+            decisions,
+        }],
+    )
+    .unwrap();
+    let before_actor = trainer.checkpoint();
+    let before_value = value.checkpoint();
+    // Valid V13 evidence is admissible before any adversarial mutation.
+    assert!(admit(&trainer, &value, &inputs, vec![source.clone()]).is_ok());
+    let mut tampered = source.clone();
+    let mut wire = serde_json::to_value(&tampered.trajectories[0].decisions[0].patch).unwrap();
+    wire["outcome"]["contact_withdrawal"]["displacement"]["x"] = serde_json::json!(-99.0);
+    tampered.trajectories[0].decisions[0].patch = serde_json::from_value(wire).unwrap();
+    for shards in [
+        vec![tampered.clone()],
+        vec![reseal(tampered)],
+        vec![source.clone(), source.clone()],
+    ] {
+        assert!(admit(&trainer, &value, &inputs, shards).is_err());
+        assert_eq!(trainer.checkpoint(), before_actor);
+        assert_eq!(value.checkpoint(), before_value);
+    }
+    let mut downgraded = source;
+    let mut wire = serde_json::to_value(&downgraded.trajectories[0].decisions[0].patch).unwrap();
+    wire["header"]["abi_version"] = serde_json::json!(ExperiencePatch::ABI_VERSION);
+    wire.as_object_mut().unwrap().remove("prediction_target");
+    wire.as_object_mut().unwrap().remove("cognitive_work");
+    downgraded.trajectories[0].decisions[0].patch = serde_json::from_value(wire).unwrap();
+    assert!(admit(&trainer, &value, &inputs, vec![reseal(downgraded)]).is_err());
+    assert_eq!(trainer.checkpoint(), before_actor);
+    assert_eq!(value.checkpoint(), before_value);
+}
