+#[test]
+fn cpu_body_only_reflex_does_not_invent_credit_or_complete_cognitive_sleep() {
+    let (game, trainer) = new_game_fixture(Some(0.0));
+    let (mut host, ()) = CpuCanonicalHost::new_prepared_cohort(game, &trainer, 0x5272, |world| {
+        let hazards = world
+            .object_snapshots()
+            .into_iter()
+            .filter(|o| o.kind == WorldObjectKind::Hazard)
+            .map(|o| o.id)
+            .collect::<Vec<_>>();
+        for id in hazards {
+            world.editor_remove_object(id)?;
+        }
+        let (_, body) = world.organism_entity_ids()[0];
+        let p = world.entity(body).unwrap().position;
+        world.editor_spawn_object(WorldEditorSpawnSpec {
+            label: "sleep-reflex-fixture".into(),
+            kind: WorldObjectKind::Hazard,
+            organism_id: None,
+            position: Vec3f::new(p.x + 0.2, p.y, p.z),
+            nutrition: 0.0,
+            hazard_pain: 0.12,
+            radius: 0.6,
+            token_id: None,
+        })?;
+        Ok::<_, ScaffoldContractError>(())
+    })
+    .unwrap();
+    let first = host.step(&trainer, 1.0).unwrap();
+    assert!(first.decisions.is_empty());
+    let second = host.step(&trainer, 1.0).unwrap();
+    assert!(second.decisions.is_empty());
+    let before = host.checkpoint(&trainer).unwrap();
+    assert_eq!(
+        before.residents[0].sleep.state().phase,
+        SleepPhase::ForcedRecoverySleep
+    );
+    let organism = host.world().organism_entity_ids()[0].0;
+    assert!(
+        host.world()
+            .organism_registry()
+            .get(organism)
+            .unwrap()
+            .biochemistry()
+            .body
+            .sleeping
+    );
+    let founder = trainer.checkpoint();
+    let mut restored = CpuCanonicalHost::from_checkpoint(before.clone(), &trainer).unwrap();
+    let step = host
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    let replay = restored
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    assert!(step.decisions.is_empty());
+    assert_eq!(step.sleep_consolidations, 0);
+    assert_eq!(step.body_only_contact_responses.len(), 1);
+    let response = &step.body_only_contact_responses[0];
+    assert!(response.sleep_recovery_interrupted);
+    assert!(response.withdrawal.as_ref().is_some_and(|r| !r.blocked));
+    let after = host.checkpoint(&trainer).unwrap();
+    assert_eq!(
+        after.residents[0].next_sequence,
+        before.residents[0].next_sequence
+    );
+    assert_eq!(after.residents[0].neural, before.residents[0].neural);
+    assert_eq!(
+        after.residents[0].sleep.state().cycles_completed,
+        before.residents[0].sleep.state().cycles_completed
+    );
+    assert_ne!(after.residents[0].sleep.state().phase, SleepPhase::Awake);
+    assert!(
+        !host
+            .world()
+            .organism_registry()
+            .get(response.organism_id)
+            .unwrap()
+            .biochemistry()
+            .body
+            .sleeping
+    );
+    assert_eq!(
+        step.body_only_contact_responses,
+        replay.body_only_contact_responses
+    );
+    assert_eq!(
+        serde_json::to_vec(&after).unwrap(),
+        serde_json::to_vec(&restored.checkpoint(&trainer).unwrap()).unwrap()
+    );
+    assert_eq!(trainer.checkpoint(), founder);
+}
