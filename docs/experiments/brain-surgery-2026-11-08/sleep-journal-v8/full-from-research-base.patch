+/// Physical origin of an involuntary response, with no semantic target selection.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ContactWithdrawalDirectionBasis {
+    LocalizedContact,
+    AcuteDamageHeadingFallback,
+}
+
+/// Bounded world-observed withdrawal evidence. Sources are physical entity IDs.
 #[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ContactWithdrawalEvidence {
+    pub schema_version: u16,
+    pub direction_basis: ContactWithdrawalDirectionBasis,
+    pub sources: Vec<WorldEntityId>,
+    pub displacement: Vec3f,
+    pub blocked: bool,
+    pub energy_cost: f32,
+}
+
+impl ContactWithdrawalEvidence {
+    pub const SCHEMA_VERSION: u16 = 1;
+    pub const MAX_SOURCES: usize = 256;
+
+    pub fn new(
+        direction_basis: ContactWithdrawalDirectionBasis,
+        sources: Vec<WorldEntityId>,
+        displacement: Vec3f,
+        blocked: bool,
+        energy_cost: f32,
+    ) -> Result<Self, ScaffoldContractError> {
+        let evidence = Self {
+            schema_version: Self::SCHEMA_VERSION,
+            direction_basis,
+            sources,
+            displacement,
+            blocked,
+            energy_cost,
+        };
+        evidence.validate_contract()?;
+        Ok(evidence)
+    }
+}
+
+impl Validate for ContactWithdrawalEvidence {
+    fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        self.displacement.validate()?;
+        NormalizedScalar::new(self.energy_cost)?;
+        if self.schema_version != Self::SCHEMA_VERSION
+            || self.sources.len() > Self::MAX_SOURCES
+            || (self.direction_basis == ContactWithdrawalDirectionBasis::LocalizedContact
+                && self.sources.is_empty())
+            || (self.blocked && self.displacement != Vec3f::ZERO)
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        for (index, source) in self.sources.iter().enumerate() {
+            source.validate()?;
+            if self.sources[..index].contains(source) {
+                return Err(ScaffoldContractError::InvalidDecisionEvidence);
+            }
+        }
+        Ok(())
+    }
+}
