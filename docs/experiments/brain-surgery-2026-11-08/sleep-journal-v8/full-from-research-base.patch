+#[test]
+fn interrupted_scheduler_drains_without_new_intent_or_duplicate_cycle() {
+    let id = OrganismId(7_303);
+    for target_kind in 1..=5 {
+        let mut scheduler = GpuSleepScheduler::new(SleepConsolidationConfig::reference()).unwrap();
+        let mut driver = RecordingConsolidationDriver::with_phase_data(id, true);
+        let mut tick = 0;
+        while scheduler.state().consolidation.kind_raw() != target_kind {
+            scheduler
+                .scheduled_tick(
+                    id,
+                    &fatigued_homeostasis(Tick::new(tick)),
+                    HomeostaticParameters::reference(),
+                    Tick::new(tick),
+                    &mut driver,
+                )
+                .unwrap();
+            tick += 1;
+            assert!(tick < 20);
+        }
+        let before = scheduler.state();
+        let cadence_before = serde_json::to_value(scheduler).unwrap();
+        scheduler
+            .interrupt_for_acute_pain(Tick::new(tick))
+            .unwrap()
+            .unwrap();
+        let mut cadence_after = serde_json::to_value(scheduler).unwrap();
+        let mut cadence_before = cadence_before;
+        cadence_before.as_object_mut().unwrap().remove("controller");
+        cadence_after.as_object_mut().unwrap().remove("controller");
+        assert_eq!(cadence_before, cadence_after);
+        assert_eq!(scheduler.state().consolidation, before.consolidation);
+        assert_eq!(scheduler.state().active_cycle_id, before.active_cycle_id);
+        let bytes = serde_json::to_vec(&scheduler).unwrap();
+        let mut restored: GpuSleepScheduler = serde_json::from_slice(&bytes).unwrap();
+        let mut replay_driver = RecordingConsolidationDriver::with_phase_data(id, true);
+        let intents = driver.intents.len();
+        while scheduler.state().requires_interrupted_drain() {
+            tick += 1;
+            let event = scheduler
+                .scheduled_tick(
+                    id,
+                    &fatigued_homeostasis(Tick::new(tick)),
+                    HomeostaticParameters::reference(),
+                    Tick::new(tick),
+                    &mut driver,
+                )
+                .unwrap();
+            let replay = restored
+                .scheduled_tick(
+                    id,
+                    &fatigued_homeostasis(Tick::new(tick)),
+                    HomeostaticParameters::reference(),
+                    Tick::new(tick),
+                    &mut replay_driver,
+                )
+                .unwrap();
+            assert_eq!(event, replay);
+            assert_eq!(scheduler, restored);
+            assert_eq!(
+                event.motor_eligible,
+                scheduler.state().permits_neural_activity()
+            );
+            assert_eq!(event.sleep_work_units, 0);
+            assert!(event.phase_receipt.due_work.is_empty());
+            assert_eq!(scheduler.state().cycles_completed, 0);
+        }
+        assert!(scheduler.state().permits_neural_activity());
+        assert_eq!(driver.intents.len(), intents);
+        assert!(replay_driver.intents.is_empty());
+        assert_eq!(driver.bounded_calls, 0);
+        assert_eq!(replay_driver.bounded_calls, 0);
+        assert_eq!(
+            scheduler.state().phase,
+            SleepPhase::InterruptedConsolidating
+        );
+        scheduler
+            .resume_interrupted_sleep(Tick::new(tick + 1))
+            .unwrap();
+        for next in tick + 2..tick + 10 {
+            scheduler
+                .scheduled_tick(
+                    id,
+                    &fatigued_homeostasis(Tick::new(next)),
+                    HomeostaticParameters::reference(),
+                    Tick::new(next),
+                    &mut driver,
+                )
+                .unwrap();
+            if scheduler.state().phase == SleepPhase::Awake {
+                break;
+            }
+        }
+        assert_eq!(scheduler.state().cycles_completed, 1);
+        assert_eq!(driver.intents.len(), intents);
+    }
+}
