+#[test]
+fn cpu_v13_completed_reflex_credit_cannot_be_applied_twice() {
+    let (mut host, trainer) = prepared(true);
+    let step = host
+        .step_with_contact_withdrawal_candidate(&trainer, 1.0)
+        .unwrap();
+    let patch = &step.decisions[0].patch;
+    assert_eq!(patch.header().abi_version, ExperiencePatch::V13_ABI_VERSION);
+    let checkpoint = host.checkpoint(&trainer).unwrap();
+    let mut neural = CpuOrganismState::from_checkpoint(
+        trainer.phenotype(),
+        checkpoint.residents[0].neural.clone(),
