+#[test]
+fn fresh_developing_bodies_reach_normal_sleep_gate_across_expressed_lifespans() {
+    for lifespan in [0.0, 0.475, 1.0] {
+        let mut g = genome(Some(0.001));
+        g.body.lifespan = ContinuousLocus::mean(lifespan, lifespan).unwrap();
+        let p = g.express().unwrap();
+        let max_age = PassiveBodyUpkeepPolicy::maximum_lifespan_ticks(&p);
+        let mut state = BiochemistryState::new(&p, Tick::ZERO).unwrap();
+        let mut config = SleepConsolidationConfig::reference();
+        // The separate actual N2048 canonical fixture reports .6. This core
+        // fixture deliberately verifies that measured gate, not a brain policy.
+        config.sleep_pressure_threshold = NormalizedScalar::new(0.6).unwrap();
+        let mut controller = SleepController::new(config).unwrap();
+        let mut entry = None;
+        for t in 1..=max_age {
+            // Controlled adequate reserves. This is not a free-feeding policy or
+            // survival assay; body metabolism still executes on every tick.
+            state.body.set_energy(0.8).unwrap();
+            state = state.advance(Tick(t), BodyEventDelta::zero(), &p).unwrap();
+            let transition = controller
+                .evaluate_homeostasis(
+                    &state.homeostasis,
+                    p.chemistry.endocrine.parameters,
+                    Tick(t),
+                )
+                .unwrap();
+            if transition.is_some() {
+                assert_eq!(controller.state().phase, SleepPhase::EnteringSleep);
+                entry = Some(t);
+                break;
+            }
+        }
+        println!("lifespan={max_age} developing_body_sleep_entry={entry:?}");
+        assert!(entry.unwrap() < max_age / 2);
+    }
+}
