+    /// Explicit construction-only calibration. Parameters are stored in emitter
+    /// genes, so ordinary genome serialization/identity binds the actual recipe.
+    /// This does not edit concentrations or install itself in existing founders.
+    pub(crate) fn with_waking_recovery_calibration(
+        self,
+        awake_gain: f32,
+        recovery_gain: f32,
+    ) -> Result<Self, ScaffoldContractError> {
+        validate_finite_values(&[awake_gain, recovery_gain])?;
+        if !(0.0..=1.0).contains(&awake_gain) || !(0.0..=1.0).contains(&recovery_gain) {
+            return Err(ScaffoldContractError::ScalarOutOfRange);
+        }
+        let mut value = self.with_waking_recovery()?;
+        for row in &mut value.emitters {
+            if matches!(row.target, ids::FATIGUE | ids::SLEEP_PRESSURE) {
+                match row.source {
+                    BiochemicalSourceLocus::Awake => row.gain = awake_gain,
+                    BiochemicalSourceLocus::SleepRecovery => row.gain = -recovery_gain,
+                    _ => {}
+                }
+            }
+        }
+        value.compile()?;
+        Ok(value)
+    }
