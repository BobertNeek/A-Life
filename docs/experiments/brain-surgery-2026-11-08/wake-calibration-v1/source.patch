+#[test]
+fn rest_does_not_manufacture_reserve_or_direct_atp_and_preserves_food_independence() {
+    let p = genome(Some(0.001)).express().unwrap();
+    let graph = &p.chemistry.biochemical;
+    assert!(!graph
+        .emitters()
+        .iter()
+        .any(|e| e.source == BiochemicalSourceLocus::SleepRecovery
+            && e.target == ChemicalSpeciesId(7)));
+    let mut start = BiochemistryState::new(&p, Tick(600)).unwrap();
+    start.body.set_energy(0.8).unwrap();
+    let mut awake = start;
+    for t in 601..=900 {
+        awake = awake.advance(Tick(t), BodyEventDelta::zero(), &p).unwrap();
+    }
+    let tired = awake;
+    let mut rested = tired;
+    for t in 901..=960 {
+        rested = rested
+            .advance(
+                Tick(t),
+                BodyEventDelta {
+                    sleep_recovery: 1.0,
+                    ..BodyEventDelta::zero()
+                },
+                &p,
+            )
+            .unwrap();
+        awake = awake.advance(Tick(t), BodyEventDelta::zero(), &p).unwrap();
+    }
+    assert!(rested.body.energy <= tired.body.energy);
+    assert!(rested.body.energy > awake.body.energy);
+    assert!(rested.homeostasis.drives.fatigue < tired.homeostasis.drives.fatigue);
+    let meal = tired
+        .advance(
+            Tick(901),
+            BodyEventDelta {
+                nutrition: 0.2,
+                ..BodyEventDelta::zero()
+            },
+            &p,
+        )
+        .unwrap();
+    let no_meal = tired
+        .advance(Tick(901), BodyEventDelta::zero(), &p)
+        .unwrap();
+    assert_eq!(
+        meal.homeostasis.drives.fatigue,
+        no_meal.homeostasis.drives.fatigue
+    );
+    assert!(meal.body.energy > no_meal.body.energy);
+}
