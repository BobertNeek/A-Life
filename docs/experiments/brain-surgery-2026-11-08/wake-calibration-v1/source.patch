+#[test]
+fn bounded_gain_grid_reaches_pressure_before_lifetime_without_one_tick_recovery() {
+    // Analytic proposal: a .4 pressure rise over ~400 mature ticks (20 seconds)
+    // needs .001/tick; .01 recovery/event takes tens of events rather than one.
+    // Bracket gains by 2x each way rather than optimizing a policy outcome.
+    for gain in [0.0005, 0.001, 0.002] {
+        let p = genome(Some(gain)).express().unwrap();
+        let graph = &p.chemistry.biochemical;
+        let mut body = BiochemistryState::new(&p, Tick::ZERO).unwrap().body;
+        body.set_energy(0.8).unwrap();
+        for expression in [0.25, 0.5, 1.0] {
+            let mut state = BiochemicalGraphState::new(graph, Tick::ZERO, expression).unwrap();
+            let mut entry = None;
+            for t in 1..=5472 {
+                // lifespan envelope: 1824 * (2 + lifespan_scale), scale <= 1
+                state = state
+                    .advance(
+                        Tick(t),
+                        body,
+                        BodyEventDelta::zero(),
+                        None,
+                        graph,
+                        expression,
+                    )
+                    .unwrap()
+                    .0;
+                if state
+                    .derive_homeostasis(graph)
+                    .unwrap()
+                    .hormones
+                    .sleep_pressure
+                    >= 0.6
+                {
+                    entry = Some(t);
+                    break;
+                }
+            }
+            println!("gain={gain} expression={expression} first_pressure_0.6={entry:?}");
+            if gain >= 0.001 {
+                assert!(entry.unwrap() < 3648);
+            }
+            if let Some(t) = entry {
+                let before = state.derive_homeostasis(graph).unwrap();
+                body.sleeping = true;
+                state = state
+                    .advance(
+                        Tick(t + 1),
+                        body,
+                        BodyEventDelta {
+                            sleep_recovery: 1.0,
+                            ..BodyEventDelta::zero()
+                        },
+                        None,
+                        graph,
+                        expression,
+                    )
+                    .unwrap()
+                    .0;
+                let after = state.derive_homeostasis(graph).unwrap();
+                assert!(after.hormones.sleep_pressure < before.hormones.sleep_pressure);
+                assert!(after.hormones.sleep_pressure > 0.55);
+                for offset in 2..=200 {
+                    state = state
+                        .advance(
+                            Tick(t + offset),
+                            body,
+                            BodyEventDelta {
+                                sleep_recovery: 1.0,
+                                ..BodyEventDelta::zero()
+                            },
+                            None,
+                            graph,
+                            expression,
+                        )
+                        .unwrap()
+                        .0;
+                }
+                let recovered = state.derive_homeostasis(graph).unwrap();
+                assert!(recovered.hormones.sleep_pressure < 0.6);
+                assert!(recovered.drives.fatigue < 0.9);
+                body.sleeping = false;
+            }
+        }
+    }
+}
