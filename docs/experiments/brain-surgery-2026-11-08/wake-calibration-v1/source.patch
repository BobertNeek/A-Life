+//! Disposable chemistry/body fixtures, not autonomous lifetimes or policy evidence.
+use alife_core::*;
+
+fn genome(gain: Option<f32>) -> CreatureGenome {
+    let mut g = CreatureGenome::early_mammal_founder(
+        0xE10_8001,
+        FoundationGeneticIdentity::new(10, 1, 7, BrainCapacityClass::N512_ID).unwrap(),
+    )
+    .unwrap();
+    for side in [AlleleSide::Maternal, AlleleSide::Paternal] {
+        g.chemistry.graph = match gain {
+            Some(gain) => g
+                .chemistry
+                .graph
+                .with_waking_recovery_calibration(side, gain, 0.01),
+            None => g.chemistry.graph.with_waking_recovery(side),
+        }
+        .unwrap();
+    }
+    g
+}
+
+#[test]
+fn calibration_is_explicit_serialized_and_rejects_invalid_parameters() {
+    let old = genome(None);
+    let candidate = genome(Some(0.001));
+    let bytes = serde_json::to_vec(&candidate).unwrap();
+    assert_ne!(serde_json::to_vec(&old).unwrap(), bytes);
+    let restored: CreatureGenome = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(bytes, serde_json::to_vec(&restored).unwrap());
+    assert_eq!(
+        candidate.express().unwrap().chemistry.biochemical,
+        restored.express().unwrap().chemistry.biochemical
+    );
+    for (wake, recovery) in [
+        (f32::NAN, 0.01),
+        (-0.1, 0.01),
+        (1.1, 0.01),
+        (0.001, f32::INFINITY),
+        (0.001, -0.1),
+    ] {
+        assert!(old
+            .chemistry
+            .graph
+            .clone()
+            .with_waking_recovery_calibration(AlleleSide::Maternal, wake, recovery)
+            .is_err());
+    }
+    let phenotype = old.express().unwrap();
+    let state = BiochemistryState::new(&phenotype, Tick(600)).unwrap();
+    let saved = serde_json::to_vec(&state).unwrap();
+    let loaded: BiochemistryState = serde_json::from_slice(&saved).unwrap();
+    assert_eq!(saved, serde_json::to_vec(&loaded).unwrap());
+    assert_eq!(
+        serde_json::to_vec(&old).unwrap(),
+        serde_json::to_vec(&genome(None)).unwrap()
+    );
+}
