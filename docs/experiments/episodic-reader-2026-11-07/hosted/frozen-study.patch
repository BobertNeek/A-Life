+    assert_eq!(
+        serde_json::to_vec(&hot.checkpoint(&trainer).unwrap()).unwrap(),
+        bytes
+    );
+    let mut cold =
+        CpuCanonicalHost::from_checkpoint(serde_json::from_slice(&bytes).unwrap(), &trainer)
+            .unwrap();
+    let hot_step = hot.step(&trainer, 0.9).unwrap();
