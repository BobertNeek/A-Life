+        serde_json::to_vec(&cold_step.decisions).unwrap()
+    );
+    assert_eq!(
+        serde_json::to_vec(&hot.checkpoint(&trainer).unwrap()).unwrap(),
+        serde_json::to_vec(&cold.checkpoint(&trainer).unwrap()).unwrap()
+    );
+    assert_eq!(
+        serde_json::to_vec(&trainer.checkpoint()).unwrap(),
+        before_actor
+    );
+}
