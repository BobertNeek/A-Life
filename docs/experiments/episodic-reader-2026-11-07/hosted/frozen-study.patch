+        for (sequence, reward, contact) in [
+            (1, old, PhysicalContactKind::Consumed),
+            (2, 0.01, PhysicalContactKind::Touch),
+            (3, new, PhysicalContactKind::Consumed),
+            (4, 0.01, PhysicalContactKind::Touch),
