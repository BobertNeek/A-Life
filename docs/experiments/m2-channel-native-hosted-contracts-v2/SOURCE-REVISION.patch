+// Fixed post-physical fault: generic staged host must discard source, body,
+// counter, memory and private-bank changes together. No old validator is changed.
+struct FailAfterPhysical;
+impl GroupedPolicyStrategy for FailAfterPhysical {
+    type Action=ChannelNativeActionV1;
+    const OPTIONAL:bool=false;
+    const CHANNEL_NATIVE:bool=true;
+    const MAGIC:&'static [u8]=CHANNEL_MAGIC;
+    const LINEAGE:&'static str=CHANNEL_LINEAGE;
+    const POLICY:&'static str=CHANNEL_NATIVE_POLICY_V1;
