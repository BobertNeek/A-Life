+    }
+    fn stage(r:&mut Resident,p:&BrainPhenotype,a:&Self::Action,b:CpuDecisionBinding)->Result<(),CpuHostError> {ChannelNativePolicy::stage(r,p,a,b)}
+    fn close(_n:&mut CpuOrganismState,_f:&CpuFoundationTrainer,_p:&ExperiencePatch,_r:&NeuralReceptorFrame)->Result<(),CpuHostError> {
+        Err(CpuHostError::State("fixed channel-native fault after physical transaction"))
+    }
