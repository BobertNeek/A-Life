+        let (branch_gain, branch_threshold) = source.foundation_abi().fresh_dendritic_parameters();
+        let dendrites = DendriticBranchSet::new(
+            (0..64)
+                .map(|i| {
+                    DendriticBranch::new(
+                        motor + i,
+                        branch_threshold,
+                        branch_gain,
+                        vec![
+                            DendriticInputRef::new(motor + i, 1.)?,
+                            DendriticInputRef::new(motor + i + 1, 1.)?,
+                        ],
+                    )
+                })
+                .collect::<Result<Vec<_>, ScaffoldContractError>>()?,
+        )?;
+        let state = MediationDetachedSnapshotV1 {
+            schema: SCHEMA.into(),
+            recipe: M2_RECIPE_SHA256.into(),
+            source_hash: source.phenotype_hash(),
+            source_asset: serde_json::to_vec(&asset.digest()).map_err(|_| invalid())?,
+            mode,
+            generation: 0,
+            source: TrainingInitialState {
+                activations: vec![0.; START],
+                activity_ema: vec![0.; START],
+                metabolic_load: vec![0.; START],
+                dendrites,
+            },
+            activations: vec![0.; ADDED],
+            ema: vec![0.; ADDED],
+            metabolic: vec![0.; ADDED],
+        };
