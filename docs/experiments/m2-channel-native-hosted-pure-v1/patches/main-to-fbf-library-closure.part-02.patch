+#[test]
+fn native_extension_all_context_and_common_jacobians_match_finite_differences() {
+    let e = fresh();
+    let r = run(&mut fresh(), &frame());
+    let m = MediationModulationV1::default();
+    let binding = &r.receipt.scores.binding;
+    let mut base = r.receipt.core.clone();
+    let common = [0.3, -0.2, 0., 0., 0.1];
+    let calculate = |base: &MediationReceiptV1, common: [f32; 5]| {
+        extension_forward(&e.recipe, &mut e.snapshot(), base, binding, common, m).unwrap()
+    };
+    let (g, j, z, oj, pj) = calculate(&base, common);
+    assert!(g.is_finite() && z.iter().all(|x| x.is_finite()));
+    for port in 0..5 {
+        let h = 0.001;
+        let mut plus = common;
+        let mut minus = common;
+        plus[port] += h;
+        minus[port] -= h;
+        let fd = (calculate(&base, plus).0 - calculate(&base, minus).0) / (2. * h);
+        close(f64::from(fd), f64::from(j[port]), 0.0004);
+    }
+    // Port-pair activation finite difference chains exactly to M/C raw values;
+    // these are synthetic arithmetic ports, not source cognitive rows.
+    for o in 0..2 {
+        let c = binding.operations[o].unwrap();
+        for port in [2, 3] {
+            let h = 0.001;
+            let v = 0.2;
+            let mut q = base.clone();
+            let set = |q: &mut MediationReceiptV1, value: f32| {
+                let b = m.offset - m.threshold;
+                q.port_activations[c][port] = [
+                    (b + value / DIVISORS[port]).tanh(),
+                    (b - value / DIVISORS[port]).tanh(),
+                ];
+                q.port_clip_slopes[c][port] = [1.; 2];
+            };
+            set(&mut q, v);
+            let expected = calculate(&q, common).3[o][port - 2];
+            set(&mut q, v + h);
+            let p = calculate(&q, common).2[o];
+            set(&mut q, v - h);
+            let n = calculate(&q, common).2[o];
+            close(f64::from((p - n) / (2. * h)), f64::from(expected), 0.0004);
+        }
+    }
+    let h = 0.001;
+    base.appended_activations[57] += h;
+    let p = calculate(&base, common).2;
+    base.appended_activations[57] -= 2. * h;
+    let n = calculate(&base, common).2;
+    for o in 0..2 {
+        close(
+            f64::from((p[o] - n[o]) / (2. * h)),
+            f64::from(pj[o]),
+            0.0004,
+        );
+    }
+    let _ = oj;
+}
