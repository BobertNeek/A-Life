+#[test]
+fn literal_neutral_seven_candidate_prior_and_no_duplicate_noops() {
+    let s = synthetic(127, [true; 6]);
+    let d = s.probabilities(1.).unwrap();
+    assert_eq!(d.representative.outcomes.len(), 6);
+    assert_eq!(d.channels[4].as_ref().unwrap().outcomes.len(), 2);
+    close(d.representative_rest_probability, 1. / 6., 1e-15);
+    close(d.posture_rest_probability, 0.5, 1e-15);
+    close(d.actual_posture_rest_probability, 5. / 12., 1e-15);
+    for channel in [0, 2, 3] {
+        assert_eq!(d.channels[channel].as_ref().unwrap().outcomes.len(), 1);
+    }
+    assert!(d.channels[1].is_none());
+    assert!(d.channels[5].is_none());
+    // Legacy ungrouped neutral mass: 2/7 + (3/7)*(2/3) = 4/7.
+    assert!(d.actual_posture_rest_probability < 4. / 7.);
+}
+#[test]
+fn conditional_preference_temperature_and_operation_count_leave_rest_mass_invariant() {
+    let mut s = synthetic(127, [true; 6]);
+    s.group = 0.7;
+    s.ordinary[5] = -0.2;
+    for t in [1e-6, 0.1, 0.7, 1., 3., 40., 1e6] {
+        let expected = s.probabilities(t).unwrap();
+        for z in [-1000., -40., 0., 40., 1000.] {
+            s.operations = [z, -z];
+            let d = s.probabilities(t).unwrap();
