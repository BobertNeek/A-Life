+    let mut e = fresh();
+    let f = frame();
+    let t = tick(&e, &f);
+    let rows = e.bind_rows(&f, &t).unwrap();
+    let before = e.snapshot();
+    assert!(e
+        .step(
+            &f,
+            t.clone(),
+            &rows,
+            MediationModulationV1::default(),
+            127,
+            [true; 6],
+            0
+        )
+        .is_err());
+    assert_eq!(before, e.snapshot());
+    let mut control = MediationDetachedCpuV1::fresh(&i, &a, MediationModeV1::Full).unwrap();
+    let cr = control.bind_rows(&f, &t).unwrap();
+    let c = control
+        .step(&f, t, &cr, MediationModulationV1::default(), u64::MAX)
+        .unwrap();
+    let r = run(&mut e, &f);
+    assert_eq!(r.receipt.core.source_execution_count, 1);
+    assert_eq!(
+        r.source_evaluation.final_activations,
+        c.source_evaluation.final_activations
+    );
+    assert_eq!(r.receipt.core.core_logits, c.receipt.core_logits);
+    assert_eq!(r.receipt.extension_activations.len(), 16);
+    assert_eq!(r.receipt.group_components[2..4], [0., 0.]);
+    assert_eq!(
+        r.receipt.extension_arithmetic_q24,
+        1016 + r.receipt.extension_source_products * 4
+    );
+    let mut restored =
+        RecoveryGroupDetachedCpuV1::restore(&i, &a, MediationModeV1::Full, e.snapshot()).unwrap();
+    let x = run(&mut e, &f);
+    let y = run(&mut restored, &f);
+    assert_eq!(
+        serde_json::to_vec(&x.receipt).unwrap(),
+        serde_json::to_vec(&y.receipt).unwrap()
+    );
+    assert!(serde_json::from_str::<RecoveryGroupSnapshotV1>(
+        &serde_json::to_string(&control.snapshot()).unwrap()
+    )
+    .is_err());
+    assert!(serde_json::from_str::<MediationDetachedSnapshotV1>(
+        &serde_json::to_string(&e.snapshot()).unwrap()
+    )
+    .is_err());
+    let mut bad = e.snapshot();
+    bad.recipe = "old".into();
+    assert!(RecoveryGroupDetachedCpuV1::restore(&i, &a, MediationModeV1::Full, bad).is_err());
+    assert!(e.actor_optimization().is_err());
+    assert!(e.waking_outcome_plasticity().is_err());
+    assert!(RecoveryGroupDetachedCpuV1::fresh(&i, &a, MediationModeV1::DirectSource).is_err());
+    let low = run(&mut fresh(), &make_frame(&specs(), 0., 0.));
+    let high = run(&mut fresh(), &make_frame(&specs(), 0., 1.));
+    assert!(low.receipt.group_components[4] <= 0.);
+    assert!(high.receipt.group_components[4] > 0.);
+    assert!(high.receipt.scores.group > low.receipt.scores.group);
+    assert!(high.receipt.scores.operations[0] > high.receipt.scores.operations[1]);
+    assert!(low.receipt.scores.operations[0] < low.receipt.scores.operations[1]);
