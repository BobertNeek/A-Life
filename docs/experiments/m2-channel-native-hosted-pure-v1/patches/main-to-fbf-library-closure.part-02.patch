+#[test]
+fn native_lesions_sham_washout_and_reference_mismatch() {
+    let mut d = MotorLobeM0V1::SETPOINTS;
+    d[1] = 0.9;
+    let mut full = run(MotorLobeProbeControl::Full, d, 64);
+    let mut sham = run(MotorLobeProbeControl::EqualWorkSham, d, 64);
+    assert!(delta(&full, 1, 23) > 0.);
+    assert_eq!(delta(&sham, 1, 23), 0.);
+    assert_eq!(
+        &full.state().activations[..2048],
+        &sham.state().activations[..2048]
+    );
+    let cs = candidates();
+    let a = full.step(d, Default::default(), &cs, 4).unwrap();
+    let b = sham.step(d, Default::default(), &cs, 4).unwrap();
+    assert_eq!(a.incremental_work, b.incremental_work);
+    for _ in 0..32 {
+        full.step(MotorLobeM0V1::SETPOINTS, Default::default(), &cs, 4)
+            .unwrap();
+    }
+    assert!(delta(&full, 1, 23).abs() < 1e-6);
+    let motor = run(MotorLobeProbeControl::MotorMediationCut, d, 64);
+    assert_eq!(delta(&motor, 1, 23), 0.);
+    let mut mixed = d;
+    mixed[0] = 0.6;
+    mixed[2] = 0.6;
+    let reconciled = run(MotorLobeProbeControl::Full, mixed, 64);
+    let recurrence_cut = run(MotorLobeProbeControl::ControllerRecurrenceCut, mixed, 64);
+    assert!(reconciled.state().activations[2094..2100]
+        .iter()
+        .zip(&recurrence_cut.state().activations[2094..2100])
+        .any(|(a, b)| (a - b).abs() > 1e-5));
+    let mut readout = run(MotorLobeProbeControl::ReadoutCut, d, 64);
+    let mut source = run(MotorLobeProbeControl::SourceCut, d, 64);
+    let r = readout.step(d, Default::default(), &cs, 4).unwrap();
+    let s = source.step(d, Default::default(), &cs, 4).unwrap();
+    assert_eq!(r.evaluation.candidate_logits, s.evaluation.candidate_logits);
+    let mut d = MotorLobeM0V1::SETPOINTS;
+    d[6] = 0.6;
+    let good = run(MotorLobeProbeControl::Full, d, 64);
+    let wrong = run(MotorLobeProbeControl::ReferenceMismatch, d, 64);
+    assert_eq!(
+        good.state().activations[2092] - good.state().activations[2093],
+        0.
+    );
+    assert!(wrong.state().activations[2092] - wrong.state().activations[2093] > 0.);
