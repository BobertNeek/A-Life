+    let mut body_sleep = false;
+    let mut resumed = false;
+    let mut native = 0;
+    let mut consolidated = 0;
+    let mut saw_waking = false;
+    for _ in 0..24 {
+        let step = host.step(0.73).unwrap();
+        if saw_waking && !step.decisions.is_empty() {
+            resumed = true;
+        }
+        body_sleep |= step
+            .decisions
+            .iter()
+            .any(|d| d.physical.successful_stationary_body_sleep);
+        if body_sleep && !injected {
+            inject_frozen_sentinels(&mut host);
+            before = frozen(&host);
+            injected = true;
+        }
+        native += step.decisions.len();
+        consolidated += step.sleep_consolidations;
+        if step.sleep_consolidations > 0 {
+            let resident = host.host.residents.values().next().unwrap();
+            validate_grouped_sleep_boundary(resident).unwrap();
+            let config = sleep_consolidation_config_for(host.founder.phenotype()).unwrap();
+            for variant in 0..3 {
+                let mut wrong = resident.clone();
+                let mut state = wrong.sleep.state();
+                if let ConsolidationState::Committed {
+                    cycle_id,
+                    output_generation,
+                    output_digest,
+                } = state.consolidation
+                {
+                    state.consolidation = match variant {
+                        0 => ConsolidationState::Committed {
+                            cycle_id,
+                            output_generation: output_generation + 1,
+                            output_digest,
+                        },
+                        1 => ConsolidationState::Committed {
+                            cycle_id,
+                            output_generation,
+                            output_digest: [1; 4],
+                        },
+                        _ => ConsolidationState::Pending {
+                            intent: ConsolidationIntent { cycle_id },
+                            replay_digest: [1; 4],
+                            replay_event_count: 0,
+                            replay_eligibility_sample_count: 0,
+                        },
+                    };
+                    wrong.sleep = SleepController::restore(config, state).unwrap();
+                    assert!(validate_grouped_sleep_boundary(&wrong).is_err());
+                } else {
+                    panic!("closed memory transaction was not committed");
+                }
+            }
+        }
+
+        saw_waking |= host
+            .host
+            .residents
+            .values()
+            .any(|r| r.sleep.state().phase == SleepPhase::Waking);
+        for d in &step.decisions {
+            eprintln!(
+                "GROUPED_HOST_PHYSICAL tick={} operation={:?} phase={:?} debit={}",
+                step.tick_before.raw(),
+                d.physical.operation,
+                d.sleep_phase,
+                d.motor.applied_body_energy_debit
+            );
+        }
+        assert!(frozen(&host) == before, "frozen source state changed");
+        let checkpoint = host.checkpoint().unwrap();
+        let wire = checkpoint.encode().unwrap();
+        host =
+            CpuGroupedM2HostV1::restore(decode_exact(&checkpoint), &inputs, MediationModeV1::Full)
+                .unwrap();
+        assert!(
+            host.checkpoint().unwrap().encode().unwrap() == wire,
+            "cold bytes differ"
+        );
+        if consolidated > 0 && saw_waking && resumed {
+            break;
+        }
+    }
+    assert!(native > 0);
+    assert!(
+        body_sleep && injected,
+        "fixed highP fixture never physically slept"
+    );
+    assert_eq!(
+        consolidated, 1,
+        "exactly one closed-memory consolidation expected"
+    );
+    assert!(
+        saw_waking && resumed,
+        "fixed highP fixture did not wake and resume"
+    );
+    eprintln!("GROUPED_HOST_BOUNDED native={native} consolidations={consolidated} waking={saw_waking}; no action forced and no sleep success inferred if absent");
+}
