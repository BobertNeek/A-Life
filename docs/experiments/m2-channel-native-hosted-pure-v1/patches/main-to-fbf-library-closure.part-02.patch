+            graph: SparseGraph::new(&source),
+            weights: asset.weights().to_vec(),
+            source,
+            recipe: Lowered::pinned(MANIFEST)?,
+            pressure_reference: inputs
+                .genome()
+                .cognitive_architecture()
+                .sleep_trigger_threshold(),
+            state,
+        })
+    }
