+    assert!(RecoveryGroupDetachedCpuV1::restore(
+        &inputs,
+        &asset,
+        MediationModeV1::Full,
+        serde_json::from_value(s2).unwrap()
+    )
+    .is_err());
+    let act1 = a.receipt.scores.sample(42, 0, 1.).unwrap();
+    let act2 = b.receipt.scores.sample(42, 0, 1.).unwrap();
+    let wire1 = serde_json::to_value(act1).unwrap();
+    let wire2 = serde_json::to_value(act2).unwrap();
+    assert!(b
+        .receipt
+        .scores
+        .evaluate(&serde_json::from_value(wire1).unwrap())
