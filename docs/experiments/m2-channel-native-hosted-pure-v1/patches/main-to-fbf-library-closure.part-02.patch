+//! Fixed fresh CPU fixtures only. No seed sweep, cohort, behavioral optimization,
+//! or trained private-life input is used here.
+use super::*;
+use crate::{AdamWConfig, StageTrainableMask};
+use alife_world::*;
+// The new-game constructor multiplies its seed by 16. The original mnemonic
+// 0x5343_4D31_4658_0001 overflowed before constructing any organism or decision;
+// its high nibble is cleared to fit that documented domain, not selected by outcome.
+const FIXTURE_SEED: u64 = 0x0343_4D31_4658_0001;
+
+#[derive(Clone, Copy)]
+enum FixedBodyPreparation {
+    Ordinary240,
+    // Separate controlled mechanism context. This changes only the existing
+    // age-death option at birth, never the genotype, chemistry or neural state.
+    AgeDisabled10000,
+}
+fn fixture() -> (CpuSleepChoiceHostV1, PhenotypeCompilerInputs) {
+    fixture_with_preparation(FixedBodyPreparation::Ordinary240)
+}
+fn fixture_with_preparation(
+    preparation: FixedBodyPreparation,
+) -> (CpuSleepChoiceHostV1, PhenotypeCompilerInputs) {
+    let mut config = CanonicalNewGameConfig::phase3(FIXTURE_SEED, 1).unwrap();
+    config.brain_class = BrainScaleTier::Standard2048;
+    let builtin = FoundationWeightAsset::builtin_n2048_v1(config.sensor_profile).unwrap();
+    let ordinary = create_canonical_new_game_with_n2048_candidate(&config, &builtin).unwrap();
+    let record = ordinary.world.organism_registry().iter().next().unwrap();
+    // Author the new fixture genotype before its expression. Four inherited
+    // heads are required to expose Posture; the earlier one-head fixture was
+    // ineligible and its 32-tick non-sleep trace is retained as failed evidence.
+    let mut source_genotype = record.genome().clone();
+    let a = source_genotype.brain.construction.maternal_architecture;
+    let architecture = alife_core::genome::CognitiveArchitectureGenomeParameters::try_new_v1(
+        a.attention_capacity(),
+        a.active_concept_limit(),
+        a.active_gap_limit(),
+        a.predictor_capacity(),
+        a.predictor_learning_rate(),
+        4,
+        a.motor_head_width(),
+        a.dendritic_branch_capacity(),
+        a.structural_candidate_budget(),
+        a.structural_edit_budget(),
+        a.sleep_trigger_threshold(),
+        a.sleep_replay_rate(),
+        a.sleep_consolidation_rate(),
+        a.attention_learning_rate(),
+        a.concept_learning_rate(),
+        a.motor_learning_rate(),
+        a.structural_learning_rate(),
+    )
+    .unwrap();
+    source_genotype.brain.construction.maternal_architecture = architecture;
+    source_genotype.brain.construction.paternal_architecture = architecture;
+    source_genotype.chemistry.graph = source_genotype
+        .chemistry
+        .graph
+        .with_awake_rest_recovery_v1(AlleleSide::Maternal)
+        .unwrap()
+        .with_awake_rest_recovery_v1(AlleleSide::Paternal)
+        .unwrap();
+    let expression = source_genotype.express().unwrap();
+    let genome = expression.brain_genome.clone();
+    let development = foundation_construction_development(
+        &genome,
+        &BrainCapacityClass::n2048(),
+        &expression.development_state_at(Tick::ZERO).unwrap(),
+    )
+    .unwrap();
