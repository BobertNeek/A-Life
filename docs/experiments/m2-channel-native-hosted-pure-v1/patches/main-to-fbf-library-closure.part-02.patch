+#[test]
+fn separate_fixed_head_matches_native_logits_in_bounded_batches() {
+    let mut drives = MotorLobeM0V1::SETPOINTS;
+    for (i, d) in drives.iter_mut().enumerate() {
+        *d = if i == 6 { 0.1 } else { 0.9 };
+    }
+    let mut full = run(MotorLobeProbeControl::Full, drives, 64);
+    let mut cut = run(MotorLobeProbeControl::ReadoutCut, drives, 64);
+    let all = (0..8)
+        .flat_map(|f| [23, 36, 37, 38, 39, 40, 41, 42, 43].map(|l| candidate(f, l)))
+        .collect::<Vec<_>>();
+    let before = full.state().clone();
+    assert!(full.step(drives, Default::default(), &all, 4).is_err());
+    assert_eq!(before, *full.state());
+    for batch in all.chunks(32) {
+        let a = full.step(drives, Default::default(), batch, 4).unwrap();
+        let b = cut.step(drives, Default::default(), batch, 4).unwrap();
+        assert_eq!(a.incremental_work, b.incremental_work);
+        assert_eq!(full.state(), cut.state());
+        for (i, c) in batch.iter().enumerate() {
+            let lane = c.decoder_inputs.iter().position(|x| *x == 1.).unwrap();
+            let expected = delta(&full, c.family.raw(), lane);
+            assert!(
+                (a.evaluation.candidate_logits[0][i]
+                    - b.evaluation.candidate_logits[0][i]
+                    - expected)
+                    .abs()
+                    < 2e-5
+            );
+        }
+    }
