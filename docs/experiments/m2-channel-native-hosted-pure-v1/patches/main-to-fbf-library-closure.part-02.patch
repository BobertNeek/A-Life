+#[test]
+fn v2_warm_cold_and_mode_boundaries_are_exact() {
+    let (i, a) = source();
+    for mode in [MediationModeV1::Full, MediationModeV1::DriveSham] {
+        let mut e = RecoveryGroupDetachedCpuV2::fresh(&i, &a, mode).unwrap();
+        let f = frame();
+        run(&mut e, &f);
+        let state = e.snapshot();
+        let opposite = if mode == MediationModeV1::Full {
+            MediationModeV1::DriveSham
+        } else {
+            MediationModeV1::Full
+        };
+        assert!(RecoveryGroupDetachedCpuV2::restore(&i, &a, opposite, state.clone()).is_err());
+        let mut cold = RecoveryGroupDetachedCpuV2::restore(&i, &a, mode, state).unwrap();
+        let warm = run(&mut e, &f);
+        let cold_result = run(&mut cold, &f);
+        assert_eq!(
+            serde_json::to_vec(&warm.receipt).unwrap(),
+            serde_json::to_vec(&cold_result.receipt).unwrap()
+        );
+        assert_eq!(e.snapshot(), cold.snapshot());
+    }
+}
