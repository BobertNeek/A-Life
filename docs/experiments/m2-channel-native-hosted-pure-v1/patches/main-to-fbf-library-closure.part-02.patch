+            (&snapshot.source.activations, START, false),
+            (&snapshot.source.activity_ema, START, true),
+            (&snapshot.source.metabolic_load, START, true),
+            (&snapshot.activations, ADDED, false),
+            (&snapshot.ema, ADDED, true),
+            (&snapshot.metabolic, ADDED, true),
+        ] {
+            if bank.len() != size
+                || bank
+                    .iter()
+                    .any(|x| !x.is_finite() || (bounded && !(0. ..=1.).contains(x)))
