+        let source_products=self.core.source.synapses().iter().filter(|s|matches!(s.kind(),CompiledSynapseKind::Decoder(d) if d.family()==CandidateActionFamily::Rest&&d.head()==DecoderHeadKind::ActionCandidate)).count() as u64;
+        let extension_cost = 1016_u64
+            .checked_add(source_products.checked_mul(4).ok_or_else(invalid)?)
+            .ok_or_else(invalid)?;
+        let core_budget = available_arithmetic_q24
+            .checked_sub(extension_cost)
+            .ok_or_else(invalid)?;
+        // Whole decision transactional even if a late extension validation fails.
+        let before = self.core.snapshot();
+        let result = self.step_inner(
+            frame,
+            tick,
+            rows,
+            modulation,
+            binding,
+            source_products,
+            extension_cost,
+            core_budget,
