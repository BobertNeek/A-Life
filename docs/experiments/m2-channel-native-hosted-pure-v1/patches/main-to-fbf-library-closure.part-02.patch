+impl RecoveryGroupProbeResultV2 {
+    /// Derivative through this extension's pressure afferent only, holding the
+    /// already executed source tape fixed. It is NOT a full hormone-to-policy
+    /// derivative through upstream encoding/recurrent state.
+    pub fn frozen_source_pressure_log_probability_derivative(
+        &self,
+        gradient: &RecoveryGroupGradientV2,
+    ) -> Result<f64, TrainingError> {
+        if gradient.binding != self.receipt.scores.binding
+            || gradient.ordinary.len() != self.receipt.scores.ordinary.len()
+            || gradient
+                .ordinary
+                .iter()
+                .chain([&gradient.group])
+                .chain(gradient.operations.iter())
+                .any(|x| !x.is_finite())
+        {
+            return Err(invalid());
+        }
+        if self.receipt.core.mode == MediationModeV1::DriveSham {
+            return Ok(0.);
+        }
+        let m = self.receipt.core.modulation;
+        let gain = 4. * m.interoceptive_gain * m.regional_gain;
+        let raw = gain * (self.receipt.core.raw_drives[11] - self.receipt.core.references[11]);
+        let signed = m.projection_gain * gain * (1. - raw.tanh().powi(2));
+        // Exact reference has the frozen zero derivative for rectification.
+        let positive = if raw > 0. { signed } else { 0. };
+        let result = gradient.group * f64::from(self.receipt.group_jacobian[4] * positive)
+            + (0..2)
+                .map(|o| {
+                    gradient.operations[o]
+                        * f64::from(self.receipt.operation_pressure_jacobians[o] * signed)
+                })
+                .sum::<f64>();
+        if !result.is_finite() {
+            return Err(invalid());
+        }
+        Ok(result)
+    }
+    /// Full sampled log-probability decoder derivative, not a local eligibility
+    /// or recurrent BPTT implementation. No weights/state are written.
+    pub fn decoder_log_probability_gradient(
+        &self,
+        gradient: &RecoveryGroupGradientV2,
+    ) -> Result<Vec<f64>, TrainingError> {
+        let width = self.group_decoder_derivatives.len();
+        if gradient.binding != self.receipt.scores.binding
+            || width == 0
+            || gradient.ordinary.len() != self.ordinary_decoder_derivatives.len()
+            || gradient
+                .ordinary
+                .iter()
+                .chain([&gradient.group])
+                .chain(gradient.operations.iter())
+                .any(|x| !x.is_finite())
+            || self
+                .ordinary_decoder_derivatives
+                .iter()
+                .chain(self.operation_decoder_derivatives.iter())
+                .any(|row| row.len() != width || row.iter().any(|x| !x.is_finite()))
+            || self
+                .group_decoder_derivatives
+                .iter()
+                .any(|x| !x.is_finite())
+        {
+            return Err(invalid());
+        }
+        let mut result = vec![0.; self.group_decoder_derivatives.len()];
+        for (j, v) in result.iter_mut().enumerate() {
+            *v = gradient.group * f64::from(self.group_decoder_derivatives[j]);
+            for (g, row) in gradient
+                .ordinary
+                .iter()
+                .zip(&self.ordinary_decoder_derivatives)
+            {
+                *v += g * f64::from(row[j]);
+            }
+            for o in 0..2 {
+                *v += gradient.operations[o] * f64::from(self.operation_decoder_derivatives[o][j]);
+            }
+        }
+        if result.iter().any(|x| !x.is_finite()) {
+            return Err(invalid());
+        }
+        Ok(result)
+    }
+}
