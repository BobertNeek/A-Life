+#[test]
+fn sleep_choice_neutral_repertoire_prior_is_measured_not_attributed_to_pressure() {
+    let (host, _) = fixture();
+    let record = host.world().organism_registry().iter().next().unwrap();
+    let mut world = host.world().clone();
+    let cap = SleepChoiceWorldAdmissionV1::for_organism(&world, record.organism_id()).unwrap();
+    let (draft, _) = world
+        .perception_sleep_choice_draft_with_bindings(
+            &cap,
+            world.tick(),
+            record.biochemistry().homeostasis,
+        )
+        .unwrap();
+    let frame = draft.finalize(PerceptionContextBlock::empty()).unwrap();
+    let rest: Vec<_> = frame
+        .candidates()
+        .iter()
+        .enumerate()
+        .filter(|(_, candidate)| candidate.family == CandidateActionFamily::Rest)
+        .collect();
+    assert_eq!(rest.len(), 2);
+    assert_eq!(
+        rest.iter()
+            .map(|(_, c)| c.action_id.raw())
+            .collect::<std::collections::BTreeSet<_>>(),
+        [3, 700].into_iter().collect()
+    );
+    let count = frame.candidates().len();
+    assert!(count > 2);
+    // Exact neutral logits, not a neural output or empirical choice frequency.
+    let logits = vec![0.; count];
+    let action = super::super::super::input::sample_cpu_sleep_choice_joint_action(
+        host.founder.phenotype(),
+        &frame,
+        &logits,
+        1,
+        0,
+        1.,
+    )
+    .unwrap();
+    assert_eq!(action.representative_mask.count_ones() as usize, count);
+    let old_mass = 0_f64.exp();
+    let new_mass = 2. * 0_f64.exp();
+    assert_eq!(new_mass, 2. * old_mass);
+    let old_probability = old_mass / (count - 1) as f64;
+    let new_probability = new_mass / count as f64;
+    assert!(new_probability > old_probability);
+    let rest_mask = rest
+        .iter()
+        .fold(0_u32, |mask, (index, _)| mask | (1 << index));
+    assert_eq!(action.motor_masks[4] & rest_mask, rest_mask);
+    eprintln!(
+        "M1_NEUTRAL_PRIOR candidates={} rest_candidates=2 old_projected_candidates={} old_rest_mass={} new_rest_mass={} old_representative_rest_probability={} new_representative_rest_probability={} posture_mask={:#x}; no repertoire normalization; conditional factorized posture is distinct from representative probability",
+        count,
+        count - 1,
+        old_mass,
+        new_mass,
+        old_probability,
+        new_probability,
+        action.motor_masks[4]
+    );
+}
