+// Separate literal pre-refactor equations, not another caller of the shared
+// helper. Covers all soma functions, nonzero state and real branch primitives.
+#[test]
+fn native_kernel_matches_literal_prechange_equations_bit_for_bit() {
+    let e = fresh(MediationModeV1::Full);
+    let previous: Vec<_> = (0..START).map(|i| (i % 19) as f32 / 31. - 0.3).collect();
+    for (i, d) in e.source.neuron_dynamics().iter().enumerate() {
+        let state = CellState {
+            activation: previous[i],
+            ema: 0.12,
+            metabolic: 0.34,
+        };
+        let recurrent = (i % 13) as f32 / 29. - 0.2;
+        let mut dendritic = 0.;
+        for b in
+            &e.state.source.dendrites.branches()[e.state.source.dendrites.target_span(i as u32)]
+        {
+            let sum = b
+                .inputs
+                .iter()
+                .map(|r| previous[r.source as usize] * r.weight)
+                .sum::<f32>();
+            let value = (sum - b.threshold).max(0.).tanh() * b.output_gain;
+            assert_eq!(
+                value.to_bits(),
+                native_kernel::dendritic_activation(&previous, b).to_bits()
+            );
+            dendritic += value;
+        }
+        let x = d.bias() + 0.17 + 0.63 * (recurrent + dendritic)
+            - d.homeostatic_gain() * state.metabolic
+            - 0.21;
+        let activated = match d.activation().raw() {
+            0 => x,
+            1 => x.max(0.),
+            2 => x.tanh(),
+            3 => 1. / (1. + (-x).exp()),
+            _ => 0.,
+        };
+        let next = (1. - d.leak()) * state.activation + d.leak() * activated;
+        let metabolic = (d.metabolic_decay() * state.metabolic
+            + (1. - d.metabolic_decay()) * next * next)
+            .clamp(0., 1.);
+        let ema = (d.activity_ema_decay() * state.ema + (1. - d.activity_ema_decay()) * next.abs())
+            .clamp(0., 1.);
+        let got = native_kernel::neuron_step(d, state, 0.17, recurrent, dendritic, 0.63, 0.21);
+        assert_eq!(
+            [
+                got.activated.to_bits(),
+                got.state.activation.to_bits(),
+                got.state.metabolic.to_bits(),
+                got.state.ema.to_bits()
+            ],
+            [
+                activated.to_bits(),
+                next.to_bits(),
+                metabolic.to_bits(),
+                ema.to_bits()
+            ]
+        );
+    }
+}
+fn frame(cs: &[TrainingReplayCandidate], tick: u64) -> PerceptionFrame {
+    let tick = Tick::new(tick);
+    let profile = SensorProfile::GroundedObjectSlotsSleepChoiceV1;
+    let mut slots = Vec::new();
+    let candidates = cs
+        .iter()
+        .enumerate()
+        .map(|(i, c)| {
+            let kind = match c.family {
+                CandidateActionFamily::Rest => ActionKind::Rest,
+                CandidateActionFamily::Idle => ActionKind::Idle,
+                CandidateActionFamily::Inspect => ActionKind::Inspect,
+                CandidateActionFamily::Approach | CandidateActionFamily::Avoid => ActionKind::Move,
+                _ => ActionKind::Interact,
+            };
+            let id = if c.family == CandidateActionFamily::Rest {
+                if i % 2 == 0 {
+                    3
+                } else {
+                    700
+                }
+            } else {
+                200
+            };
+            let target = if c.family == CandidateActionFamily::Rest {
+                ActionTarget::NONE
+            } else {
+                ActionTarget::new(Some(WorldEntityId(i as u64 + 2)), None)
+            };
+            let mut f = CandidateFeatureVector::zero();
+            f.0.copy_from_slice(&c.decoder_inputs[..24]);
+            let observation = if c.family == CandidateActionFamily::Rest {
+                CandidateObservationRef::None
+            } else {
+                let v = &c.decoder_inputs;
+                let si = slots.len() as u16;
+                slots.push(GroundedObjectSlotV1 {
+                    slot_index: si,
+                    tracked_object_id: TrackedObjectId(i as u64 + 2),
+                    bearing: [v[0], v[1]],
+                    distance: v[2],
+                    relative_velocity: v[3..6].try_into().unwrap(),
+                    color: v[6..9].try_into().unwrap(),
+                    material: v[9..12].try_into().unwrap(),
+                    shape: v[12..15].try_into().unwrap(),
+                    chemical: v[15..18].try_into().unwrap(),
+                    contact: v[18],
+                    proprioception: v[19..21].try_into().unwrap(),
+                    temperature: v[21],
+                    terrain: v[22..24].try_into().unwrap(),
+                    confidence: Confidence::new(1.).unwrap(),
+                });
+                CandidateObservationRef::ObjectSlot(si)
+            };
+            ActionCandidate::new(
+                i as u16,
+                ActionId(id),
+                kind,
+                c.family,
+                observation,
+                target,
+                f,
+                Confidence::new(1.).unwrap(),
+                NormalizedScalar::new(0.).unwrap(),
+                DurationTicks::new(1),
+                DurationTicks::new(1),
+            )
+            .unwrap()
+        })
+        .collect();
+    PerceptionFrame::new(
+        OrganismId(1),
+        tick,
+        profile,
+        SensorySnapshot::new(
+            OrganismId(1),
+            tick,
+            Vec3f::ZERO,
+            SensoryChannels::ZERO,
+            Default::default(),
+        )
+        .unwrap(),
+        BodySnapshot {
+            pose: Pose::IDENTITY,
+            velocity: Velocity::ZERO,
+        },
+        HomeostaticSnapshot::baseline(tick),
+        candidates,
+        SensorProfileProvenance::new(profile, SensoryAbiVersion::CURRENT, tick).unwrap(),
+        slots,
+    )
+    .unwrap()
+}
+fn tick(
+    e: &MediationDetachedCpuV1,
+    mut cs: Vec<TrainingReplayCandidate>,
+    frame: &PerceptionFrame,
+) -> TrainingReplayTick {
+    for (c, derived) in cs
+        .iter_mut()
+        .zip(prepare_sleep_choice_grounded_drive_features_v1(frame).unwrap())
+    {
+        c.decoder_inputs[36..46].copy_from_slice(&derived);
+    }
+    TrainingReplayTick {
+        encoded_inputs: (0..START).map(|i| (i % 13) as f32 / 31. - 0.1).collect(),
+        projection_gain: 0.5,
+        local_threshold_shift: 0.25,
+        microstep_count: 4,
+        enabled_routes: vec![true; e.source.projections().len()],
+        effective_weight_offsets: vec![0.; e.weights.len()],
+        structural_synapses: vec![],
+        candidates: cs,
+    }
+}
