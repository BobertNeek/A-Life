+#[test]
+fn v2_native_bounded_operation_memory_and_zero_cognitive_context() {
+    let e = fresh();
+    let cap = e
+        .source()
+        .candidate_decoder()
+        .memory_channel()
+        .unwrap()
+        .max_candidate_gain();
+    let m = MediationModulationV1::default();
+    assert_eq!(cap, 0.5);
+    let memory: Vec<_> = e.source().synapses().iter().enumerate().filter(|(_,s)| matches!(s.kind(),CompiledSynapseKind::Decoder(d) if d.family()==CandidateActionFamily::Rest && d.head()==DecoderHeadKind::MemoryContext)).collect();
+    assert!(!memory.is_empty());
+    assert!(memory.iter().all(|(j, _)| e.core.weights[*j] == 0.));
+    // Preserved first fixture failure exposed zero inherited memory readouts.
+    // Nonzero M here is an explicit intervention at the bounded native port,
+    // not source-produced recall, a learned episode or a source-weight change.
+    let mut old_weight_control: GroupRecipe = serde_json::from_str(GROUP_RECIPE).unwrap();
+    old_weight_control.operation_final_readouts = [[2., -2.]; 2];
+    for p in [0.1, 0.6, 0.7] {
+        let f = make_frame(&specs(), 0., p);
+        let r = run(&mut fresh(), &f);
+        assert_eq!(r.receipt.core.components[1][2..4], [0., 0.]);
+        assert_eq!(r.receipt.core.components[6][2..4], [0., 0.]);
+        for signs in [[-1., 1.], [0., 0.], [1., -1.], [1., 1.], [-1., -1.]] {
+            let mut base = r.receipt.core.clone();
+            for (o, c) in [1, 6].into_iter().enumerate() {
+                let value = signs[o] * cap;
+                base.components[c][2] = value;
+                for (side, sign) in [(0, 1.), (1, -1.)] {
+                    let node = &e.core.recipe.manifest.nodes[PORT_BASE + c * 12 + 4 + side];
+                    assert_eq!(node.id, START + PORT_BASE + c * 12 + 4 + side);
+                    let n = native_kernel::neuron_step(
+                        &node.dynamics,
+                        CellState {
+                            activation: 0.,
+                            ema: 0.,
+                            metabolic: 0.,
+                        },
+                        sign * value / DIVISORS[2] + m.offset,
+                        0.,
+                        0.,
+                        m.projection_gain,
+                        m.threshold,
+                    );
+                    base.port_activations[c][2][side] = n.state.activation;
+                    base.port_clip_slopes[c][2][side] = 1.;
+                }
+            }
+            let mut old_state = e.snapshot();
+            let mut new_state = e.snapshot();
+            let old = extension_forward(
+                &old_weight_control,
+                &mut old_state,
+                &base,
+                &r.receipt.scores.binding,
+                r.receipt.group_components,
+                m,
+            )
+            .unwrap();
+            let new = extension_forward(
+                &e.recipe,
+                &mut new_state,
+                &base,
+                &r.receipt.scores.binding,
+                r.receipt.group_components,
+                m,
+            )
+            .unwrap();
+            assert_eq!(old_state, new_state);
+            assert_eq!(old.0.to_bits(), new.0.to_bits());
+            let mut old_scores = r.receipt.scores.clone();
+            old_scores.group = f64::from(old.0);
+            old_scores.operations = old.2.map(f64::from);
+            let mut new_scores = old_scores.clone();
+            new_scores.operations = new.2.map(f64::from);
+            for o in 0..2 {
+                assert_eq!((old.2[o] * 4.).to_bits(), new.2[o].to_bits());
+            }
+            let old_d = old_scores.probabilities(1.).unwrap();
+            let d = new_scores.probabilities(1.).unwrap();
+            assert_eq!(
+                old_d.actual_posture_rest_probability.to_bits(),
+                d.actual_posture_rest_probability.to_bits()
+            );
+            assert!(d.conditional_operation.iter().all(|x| *x > 0. && *x < 1.));
+            if p == 0.6 && signs[0] == signs[1] {
+                close(d.conditional_operation[0], 0.5, 1e-15);
+            }
+            println!(
+                "BOUNDED_MEMORY_NATIVE_FIXTURE {}",
+                serde_json::json!({"pressure":p,"memory_cap":cap,"memory":signs.map(|s|s*cap),"cognitive":[0.,0.],"scope":"injected bounded M port via native neuron_step, not source-produced recall; baseline control uses native V1 readout weights on identical graph", "source_memory_rows_zero":true,"all_predecode_state_equal":true,"operation_scores_v1_weight_control":old.2,"operation_scores_v2":new.2,"probabilities_v1_weight_control":old_d,"probabilities_v2":d})
+            );
+        }
+    }
+}
