+fn grouped_host_envelope_rejects_cross_mode_recipe_missing_and_extra_state() {
+    let (mut host, inputs) = fixture(240);
+    host.step(0.73).unwrap();
+    let c = host.checkpoint().unwrap();
+    let wire = c.encode().unwrap();
+    assert!(CpuGroupedM2HostCheckpointV1::decode(&wire[MAGIC.len()..]).is_err());
+    assert!(CpuSleepChoiceHostCheckpointV1::decode(&wire).is_err());
+    assert!(CpuGroupedM2HostV1::restore(c.clone(), &inputs, MediationModeV1::DriveSham).is_err());
+    assert!(host
+        .host
+        .grounded_drive_research_checkpoint(&host.founder)
+        .is_err());
+    assert!(host.host.step(&host.founder, 1.).is_err());
+    for field in [
+        "recipe_digest",
+        "policy",
+        "source_lineage",
+        "selector_tag",
+        "runtime_profile_raw",
+    ] {
+        let mut value = serde_json::to_value(&c.payload).unwrap();
+        value[field] = serde_json::Value::Null;
+        let mut wire = MAGIC.to_vec();
+        wire.extend(bytes(&value));
+        assert!(
+            CpuGroupedM2HostCheckpointV1::decode(&wire).is_err(),
+            "{field}"
+        );
+    }
+    host.step(0.73).unwrap();
+    let mut mixed = host.checkpoint().unwrap();
+    mixed.payload.controllers = c.payload.controllers.clone();
+    mixed.payload.sampler_bits = c.payload.sampler_bits.clone();
+    let error = CpuGroupedM2HostV1::restore(mixed, &inputs, MediationModeV1::Full)
+        .err()
+        .expect("mixed source/append boundaries must reject");
+    assert!(
+        error
+            .to_string()
+            .contains("grouped/source generation mismatch"),
+        "{error}"
+    );
+    for field in ["clock", "frame"] {
+        let mut wrong = c.clone();
+        let resident = &mut wrong.payload.canonical.residents[0];
+        if field == "clock" {
+            resident.neural.last_decision_tick = Some(239);
+        } else {
+            resident.activity.source_frame_digest = [7; 4];
+        }
+        let error = CpuGroupedM2HostV1::restore(wrong, &inputs, MediationModeV1::Full)
+            .err()
+            .expect("source boundary differs");
+        assert!(
+            error
+                .to_string()
+                .contains("grouped/source frame or clock mismatch"),
+            "{error}"
+        );
+    }
+    let mut bit_corrupt = c.clone();
+    *bit_corrupt
+        .payload
+        .sampler_bits
+        .values_mut()
+        .next()
+        .unwrap()
+        .group
+        .as_mut()
+        .unwrap() ^= 1;
+    assert!(CpuGroupedM2HostV1::restore(bit_corrupt, &inputs, MediationModeV1::Full).is_err());
+    // Numeric mirrors and IEEE identity are both mandatory, not alternate
+    // sources of truth. Neither may be silently overwritten after tampering.
+    for mutate_bits in [false, true] {
+        let mut value: serde_json::Value = serde_json::from_slice(&wire[MAGIC.len()..]).unwrap();
+        let owner = c.payload.controllers.keys().next().unwrap().to_string();
+        if mutate_bits {
+            value["sampler_bits"][&owner]["action"][0] = (1.5_f64.to_bits()).into();
+        } else {
+            value["controllers"][&owner]["last_action"]["temperature"] = 1.5.into();
+        }
+        let mut corrupt = MAGIC.to_vec();
+        corrupt.extend(bytes(&value));
+        assert!(CpuGroupedM2HostCheckpointV1::decode(&corrupt).is_err());
+    }
+    for invalid in [f64::NAN.to_bits(), f64::INFINITY.to_bits()] {
+        let mut value: serde_json::Value = serde_json::from_slice(&wire[MAGIC.len()..]).unwrap();
+        let owner = c.payload.controllers.keys().next().unwrap().to_string();
+        value["sampler_bits"][&owner]["action"][0] = invalid.into();
+        let mut corrupt = MAGIC.to_vec();
+        corrupt.extend(bytes(&value));
+        assert!(CpuGroupedM2HostCheckpointV1::decode(&corrupt).is_err());
+    }
+    let mut missing = c.clone();
+    missing.payload.controllers.clear();
+    assert!(CpuGroupedM2HostV1::restore(missing, &inputs, MediationModeV1::Full).is_err());
+    let mut extra = c.clone();
+    let controller = extra.payload.controllers.values().next().unwrap().clone();
+    extra.payload.controllers.insert(u64::MAX, controller);
+    assert!(CpuGroupedM2HostV1::restore(extra, &inputs, MediationModeV1::Full).is_err());
+    let mut wrong = c.clone();
+    wrong
+        .payload
+        .controllers
+        .values_mut()
+        .next()
+        .unwrap()
+        .last_action
+        .as_mut()
+        .unwrap()
+        .counter += 1;
+    assert!(CpuGroupedM2HostV1::restore(wrong, &inputs, MediationModeV1::Full).is_err());
+    let mut unknown = serde_json::to_value(&c.payload).unwrap();
+    unknown["unknown"] = true.into();
+    let mut wire = MAGIC.to_vec();
+    wire.extend(bytes(&unknown));
+    assert!(CpuGroupedM2HostCheckpointV1::decode(&wire).is_err());
+}
