+    pub fn fresh(
+        inputs: &PhenotypeCompilerInputs,
+        asset: &FoundationWeightAsset,
+        mode: MediationModeV1,
+    ) -> Result<Self, TrainingError> {
+        let source = PhenotypeCompiler::compile_validated(
+            inputs,
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+        )?;
+        asset.validate_against(&source)?;
+        if asset
+            .weights()
+            .iter()
+            .zip(source.synapses())
+            .any(|(w, row)| w.to_bits() != row.genetic_weight().to_bits())
+        {
+            return Err(invalid());
+        }
+        if source.neuron_count() != START as u32
+            || source.synapses().len() != 34048
+            || source.foundation_abi().motor_lobe_m0().is_some()
+        {
+            return Err(invalid());
+        }
