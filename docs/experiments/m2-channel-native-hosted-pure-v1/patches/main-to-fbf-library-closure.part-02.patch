+#[test]
+fn all_eleven_pairs_and_gain_offset_threshold_envelope() {
+    let cases = [
+        (0., 1., 0., 0.25),
+        (0.1, 0.5, -0.2, 0.9),
+        (1., 1., 0., 0.25),
+        (2., 0.5, 0.2, -0.75),
+        (4., 4., 4., 4.),
+        (1., 1., -4., -4.),
+    ];
+    for (intero, regional, offset, threshold) in cases {
+        for drive in 0..11 {
+            let mut e = evaluator(MotorLobeProbeControl::Full);
+            let mut drives = MotorLobeM0V1::SETPOINTS;
+            drives[drive] = (drives[drive] + 0.2).min(1.);
+            let m = MotorLobeProbeModulation {
+                interoceptive_gain: intero,
+                regional_gain: regional,
+                afferent_offset: offset,
+                local_threshold: threshold,
+                ..Default::default()
+            };
+            for _ in 0..4 {
+                e.step(drives, m, &[candidate(0, 23)], 4).unwrap();
+                for d in 0..11 {
+                    assert!(
+                        e.state().activations[2070 + 2 * d] - e.state().activations[2071 + 2 * d]
+                            >= -2e-7
+                    );
+                }
+            }
+            if intero == 1. && offset == 0. {
+                assert!(
+                    e.state().activations[2070 + 2 * drive]
+                        - e.state().activations[2071 + 2 * drive]
+                        > 1e-5
+                );
+            }
+        }
+    }
