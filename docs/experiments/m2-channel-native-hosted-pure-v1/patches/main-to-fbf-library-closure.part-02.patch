+    #[allow(clippy::too_many_arguments)]
+    fn step_inner(
+        &mut self,
+        frame: &PerceptionFrame,
+        tick: TrainingReplayTick,
+        rows: &[MediationRowV1],
+        m: MediationModulationV1,
+        binding: RecoveryGroupBindingV2,
+        source_products: u64,
+        extension_cost: u64,
+        core_budget: u64,
+    ) -> Result<RecoveryGroupProbeResultV2, TrainingError> {
+        let input_tick = tick.clone();
+        let base = self.core.step(frame, tick, rows, m, core_budget)?;
+        let p = &self.core.source;
+        let activation = &base.source_evaluation.final_activations[0];
+        let canonical =
+            CandidateFeatureVector::zero().with_intrinsic_action_basis(ActionKind::Rest);
+        let mut input = [0.; 54];
+        input[..24].copy_from_slice(&canonical.0);
+        let family = p
+            .candidate_decoder()
+            .families()
+            .iter()
+            .find(|f| f.family() == CandidateActionFamily::Rest)
+            .ok_or_else(invalid)?;
+        let mut common = [
+            family.bias(),
+            family.innate_contribution(frame.homeostasis().drives, canonical),
+            0.,
+            0.,
+            0.,
+        ];
+        for (j, s) in p.synapses().iter().enumerate() {
+            if let CompiledSynapseKind::Decoder(d) = s.kind() {
+                if d.family() == CandidateActionFamily::Rest
+                    && d.head() == DecoderHeadKind::ActionCandidate
+                {
+                    common[0] += activation[s.source() as usize]
+                        * (input[d.input_lane() as usize] * self.core.weights[j]);
+                }
+            }
+        }
