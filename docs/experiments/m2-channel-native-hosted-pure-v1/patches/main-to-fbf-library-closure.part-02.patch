+            [0., play_innate, 0., 0., 0.],
+            [1.6424918, rest_innate, 0., 0., 0.],
+        ];
+        let full = synthetic(&cs, &values, drives, Default::default());
+        let mut e = fresh(MediationModeV1::DriveSham);
+        let mut v = values;
+        let sham = run_partitions(
+            &e.recipe,
+            &mut e.state,
+            &mut v,
+            &cs,
+            drives,
+            e.pressure_reference,
+            Default::default(),
+        )
+        .unwrap();
+        let mut cut_values = values;
+        for v in &mut cut_values {
+            v[0] = 0.;
+        }
+        let cut = synthetic(&cs, &cut_values, drives, Default::default());
+        assert_eq!(full.work, sham.work);
+        assert_eq!(full.work, cut.work);
