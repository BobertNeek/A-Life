+impl MediationRowV1 {
+    fn bind(
+        frame: &PerceptionFrame,
+        index: usize,
+        prefix: &TrainingReplayCandidate,
+        generation: u64,
+        source_hash: PhenotypeHash,
+    ) -> Result<Self, TrainingError> {
+        if frame.sensor_profile() != SensorProfile::GroundedObjectSlotsSleepChoiceV1
+            || frame.candidates().len() > SLOTS
+        {
+            return Err(invalid());
+        }
+        let c = frame.candidates().get(index).ok_or_else(invalid)?;
+        let derived = prepare_sleep_choice_grounded_drive_features_v1(frame)?;
+        if prefix.decoder_inputs[36..46]
+            .iter()
+            .zip(derived[index])
+            .any(|(a, b)| a.to_bits() != b.to_bits())
+        {
+            return Err(invalid());
+        }
+        if prefix.family != c.family
+            || prefix.decoder_inputs[..24]
+                .iter()
+                .zip(c.features.0)
+                .any(|(a, b)| a.to_bits() != b.to_bits())
+            || !prefix.innate_bias.is_finite()
+            || prefix
+                .decoder_inputs
+                .iter()
+                .any(|x| !x.is_finite() || !(-1. ..=1.).contains(x))
+        {
+            return Err(invalid());
+        }
+        Ok(Self {
+            source_generation: generation,
+            source_hash,
+            recipe: M2_RECIPE_SHA256.into(),
+            frame_digest: frame.frame_digest(),
+            candidate_index: index,
+            action_id: c.action_id,
+            target: c.target,
+            features: c.features,
+            feature_digest: c.feature_digest()?,
+            operation: RecoveryOperationV1::for_candidate(c)?,
+            prefix: prefix.clone(),
+        })
+    }
+    fn validate(
+        &self,
+        frame: &PerceptionFrame,
+        index: usize,
+        prefix: &TrainingReplayCandidate,
+        generation: u64,
+        source_hash: PhenotypeHash,
+    ) -> Result<(), TrainingError> {
+        let expected = Self::bind(frame, index, prefix, generation, source_hash)?;
+        if serde_json::to_vec(self).map_err(|_| invalid())?
+            != serde_json::to_vec(&expected).map_err(|_| invalid())?
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
