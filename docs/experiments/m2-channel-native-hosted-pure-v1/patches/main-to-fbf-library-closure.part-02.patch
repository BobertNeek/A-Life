+            MediationModulationV1::default(),
+            127,
+            [true; 6],
+            u64::MAX,
+        )
+        .unwrap();
+    let b = v2
+        .step(
+            &f,
+            t,
+            &r2,
+            MediationModulationV1::default(),
+            127,
+            [true; 6],
+            u64::MAX,
+        )
+        .unwrap();
+    assert_eq!(
+        serde_json::to_vec(&a.receipt.core).unwrap(),
+        serde_json::to_vec(&b.receipt.core).unwrap()
+    );
+    assert_eq!(
+        a.source_evaluation.final_activations,
+        b.source_evaluation.final_activations
+    );
+    assert_eq!(
+        a.receipt.extension_activations.map(f32::to_bits),
+        b.receipt.extension_activations.map(f32::to_bits)
+    );
+    assert_eq!(a.receipt.group_components, b.receipt.group_components);
+    assert_eq!(a.receipt.group_jacobian, b.receipt.group_jacobian);
+    assert_eq!(a.group_decoder_derivatives, b.group_decoder_derivatives);
+    assert_eq!(
+        a.ordinary_decoder_derivatives,
+        b.ordinary_decoder_derivatives
+    );
+    assert_eq!(
+        a.receipt.scores.group.to_bits(),
+        b.receipt.scores.group.to_bits()
+    );
+    for o in 0..2 {
+        assert_eq!(
+            (a.receipt.scores.operations[o] * 4.).to_bits(),
+            b.receipt.scores.operations[o].to_bits()
+        );
+        for (x, y) in a.operation_decoder_derivatives[o]
+            .iter()
+            .zip(&b.operation_decoder_derivatives[o])
+        {
+            assert_eq!((x * 4.).to_bits(), y.to_bits());
+        }
+    }
+    let s1 = serde_json::to_value(v1.snapshot()).unwrap();
+    let s2 = serde_json::to_value(v2.snapshot()).unwrap();
+    for key in ["core_json", "activations", "ema", "metabolic"] {
+        assert_eq!(s1[key], s2[key]);
