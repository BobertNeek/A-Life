+        let mut ordinary = base.projected_core_decoder_derivatives;
+        for i in scores.binding.operations.iter().flatten() {
+            ordinary[*i] = vec![0.; p.synapses().len()];
+        }
+        let mut group_derivatives = vec![0.; p.synapses().len()];
+        let mut op_derivatives = [vec![0.; p.synapses().len()], vec![0.; p.synapses().len()]];
+        for (j, s) in p.synapses().iter().enumerate() {
+            let CompiledSynapseKind::Decoder(d) = s.kind() else {
+                continue;
+            };
+            if d.family() != CandidateActionFamily::Rest {
+                continue;
+            }
+            if d.head() == DecoderHeadKind::ActionCandidate {
+                group_derivatives[j] =
+                    group_jac[0] * activation[s.source() as usize] * input[d.input_lane() as usize];
+            }
+            for o in 0..2 {
+                if let Some(i) = scores.binding.operations[o] {
+                    let context = match d.head() {
+                        DecoderHeadKind::MemoryContext => Some(0),
+                        DecoderHeadKind::CognitiveContext => Some(1),
+                        _ => None,
+                    };
+                    if let Some(c) = context {
+                        op_derivatives[o][j] = op_jac[o][c]
+                            * base.receipt.upstream_context_slopes[i][c]
+                            * input_tick.candidates[i].decoder_inputs[d.input_lane() as usize];
+                    }
+                }
+            }
+        }
+        next.core_json = serde_json::to_string(&self.core.snapshot()).map_err(|_| invalid())?;
+        let receipt = RecoveryGroupNativeReceiptV2 {
+            schema: GROUP_SCHEMA.into(),
+            recipe: RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256.into(),
+            core: base.receipt,
+            group_components: common,
+            group_jacobian: group_jac,
+            operation_context_jacobians: op_jac,
+            operation_pressure_jacobians: pressure_jac,
+            extension_activations: next.activations,
+            extension_source_products: source_products,
+            extension_arithmetic_q24: extension_cost,
+            scores,
+        };
+        self.state = next;
+        Ok(RecoveryGroupProbeResultV2 {
+            source_evaluation: base.source_evaluation,
+            receipt,
+            ordinary_decoder_derivatives: ordinary,
+            group_decoder_derivatives: group_derivatives,
+            operation_decoder_derivatives: op_derivatives,
+        })
+    }
+}
+// Group score/J, operation scores/context J, and signed-pressure J.
+type ExtensionReadout = (f32, [f32; 5], [f32; 2], [[f32; 2]; 2], [f32; 2]);
+// The same native soma function as SparseGraph and M2; no bespoke activation engine.
+fn extension_forward(
+    recipe: &GroupRecipe,
+    state: &mut RecoveryGroupSnapshotV2,
+    base: &MediationReceiptV1,
+    binding: &RecoveryGroupBindingV2,
+    common: [f32; 5],
+    m: MediationModulationV1,
+) -> Result<ExtensionReadout, TrainingError> {
+    extension_forward_banks(
+        recipe,
+        &mut state.activations,
+        &mut state.ema,
+        &mut state.metabolic,
+        base,
+        binding,
+        common,
+        m,
+    )
+}
+#[allow(clippy::too_many_arguments)]
+fn extension_forward_banks(
+    recipe: &GroupRecipe,
+    activations: &mut [f32; 16],
+    ema: &mut [f32; 16],
+    metabolic: &mut [f32; 16],
+    base: &MediationReceiptV1,
+    binding: &RecoveryGroupBindingV2,
+    common: [f32; 5],
+    m: MediationModulationV1,
+) -> Result<ExtensionReadout, TrainingError> {
+    finite(&common)?;
+    let mut encoded = [m.offset; 16];
+    for port in 0..5 {
+        for (side, sign) in [(0, 1.), (1, -1.)] {
+            encoded[port * 2 + side] =
+                (sign * common[port] / DIVISORS[port]).clamp(-8., 8.) + m.offset;
+        }
+    }
+    for phase in [5, 6] {
+        let previous = *activations;
+        for (i, node) in recipe
+            .nodes
+            .iter()
+            .enumerate()
+            .filter(|(_, n)| n.phase == phase)
+        {
+            let mut recurrent = 0.;
+            if i == 10 || i == 11 {
+                let sign = if i == 10 { 1. } else { -1. };
+                for port in 0..5 {
+                    recurrent += previous[port * 2] * (sign * BOUND_WEIGHTS[port] * 0.5);
+                    recurrent += previous[port * 2 + 1] * (-sign * BOUND_WEIGHTS[port] * 0.5);
+                }
+            }
+            if i >= 12 {
+                let o = (i - 12) / 2;
+                let side = if i % 2 == 0 { 1. } else { -1. };
+                // Fixed six signed rows per soma. Absent operation uses zero
+                // context but still pays padded work; no target-slot state reuse.
+                for (port, w) in [(2, 0.25), (3, 0.125)] {
+                    let pair =
+                        binding.operations[o].map_or([0.; 2], |c| base.port_activations[c][port]);
+                    recurrent += pair[0] * (side * w);
+                    recurrent += pair[1] * (-side * w);
+                }
+                let sign = if o == 0 { side } else { -side };
+                recurrent += base.appended_activations[57] * sign;
+                recurrent += base.appended_activations[58] * -sign;
+            }
+            let result = native_kernel::neuron_step(
+                &node.dynamics,
+                CellState {
+                    activation: previous[i],
+                    ema: ema[i],
+                    metabolic: metabolic[i],
+                },
+                encoded[i],
+                recurrent,
+                0.,
+                m.projection_gain,
+                m.threshold,
+            );
+            activations[i] = result.state.activation;
+            ema[i] = result.state.ema;
+            metabolic[i] = result.state.metabolic;
+        }
+    }
+    finite(activations)?;
+    let a = *activations;
+    let pair_slope = |i: usize| {
+        2. * m.projection_gain * ((1. - a[i] * a[i]).max(0.) + (1. - a[i + 1] * a[i + 1]).max(0.))
+    };
+    let mut jac = [0.; 5];
+    for p in 0..5 {
+        let slope = ((1. - a[p * 2] * a[p * 2]).max(0.) * clip_slope(common[p] / DIVISORS[p], 8.)
+            + (1. - a[p * 2 + 1] * a[p * 2 + 1]).max(0.)
+                * clip_slope(-common[p] / DIVISORS[p], 8.))
+            / (2. * DIVISORS[p]);
+        jac[p] = pair_slope(10) * BOUND_WEIGHTS[p] * slope;
+    }
+    // Fixed native decoder row weights. Neural soma state is unchanged;
+    // scale enters before the categorical, never as posthoc probabilities.
+    let operation_slope = |o: usize| {
+        let i = 12 + o * 2;
+        let w = recipe.operation_final_readouts[o];
+        m.projection_gain
+            * (w[0] * (1. - a[i] * a[i]).max(0.) - w[1] * (1. - a[i + 1] * a[i + 1]).max(0.))
+    };
+    let mut oj = [[0.; 2]; 2];
+    let mut pj = [0.; 2];
+    for o in 0..2 {
+        pj[o] = operation_slope(o) * if o == 0 { 1. } else { -1. };
+        if let Some(c) = binding.operations[o] {
+            for (p, w) in [(2, 0.5), (3, 0.25)] {
+                let q = base.port_activations[c][p];
+                let clip = base.port_clip_slopes[c][p];
+                oj[o][p - 2] = operation_slope(o)
+                    * w
+                    * ((1. - q[0] * q[0]).max(0.) * clip[0] + (1. - q[1] * q[1]).max(0.) * clip[1])
+                    / (2. * DIVISORS[p]);
+            }
+        }
+    }
+    Ok((
+        2. * a[10] - 2. * a[11],
+        jac,
+        std::array::from_fn(|o| {
+            let w = recipe.operation_final_readouts[o];
+            w[0] * a[12 + 2 * o] + w[1] * a[13 + 2 * o]
+        }),
+        oj,
+        pj,
+    ))
+}
