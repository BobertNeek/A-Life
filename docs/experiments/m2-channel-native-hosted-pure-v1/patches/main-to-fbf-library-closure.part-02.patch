+#[test]
+fn exact_joint_logp_gradient_and_no_double_operation_or_credit() {
+    let mut s = synthetic(127, [true; 6]);
+    s.ordinary = [0.1, 99., -0.3, 0.5, -0.4, 0.8, -99.].to_vec();
+    s.group = 0.25;
+    s.operations = [0.7, -0.2];
+    for t in [0.4, 1., 2.5] {
+        let mut representative = false;
+        let mut secondary = false;
+        for counter in 0..100 {
+            let a = s.sample(42, counter, t).unwrap();
+            let e = s.evaluate(&a).unwrap();
+            assert_eq!(a, s.sample(42, counter, t).unwrap());
+            close(
+                e.factor_log_probabilities.iter().sum(),
+                e.joint_log_probability,
+                1e-12,
+            );
+            assert!(
+                a.draw_factors
+                    .iter()
+                    .filter(|f| **f == 1 || **f == 8)
+                    .count()
+                    <= 1
+            );
+            let mut unique = e.selected_physical_candidates_once.clone();
+            unique.sort();
+            unique.dedup();
+            assert_eq!(unique.len(), e.selected_physical_candidates_once.len());
+            representative |= a.representative == RecoveryGroupChoiceV1::RestGroup;
+            secondary |= a.representative != RecoveryGroupChoiceV1::RestGroup
+                && a.motors[4] == RecoveryGroupChoiceV1::RestGroup;
+            for i in 0..10 {
+                let h = 1e-5;
+                let mut plus = s.clone();
+                let mut minus = s.clone();
+                let expected = if i < 7 {
+                    plus.ordinary[i] += h;
+                    minus.ordinary[i] -= h;
+                    e.gradient.ordinary[i]
+                } else if i == 7 {
+                    plus.group += h;
+                    minus.group -= h;
+                    e.gradient.group
+                } else {
+                    plus.operations[i - 8] += h;
+                    minus.operations[i - 8] -= h;
+                    e.gradient.operations[i - 8]
+                };
+                let fd = (plus.evaluate(&a).unwrap().joint_log_probability
+                    - minus.evaluate(&a).unwrap().joint_log_probability)
+                    / (2. * h);
+                close(fd, expected, 1e-8);
+            }
+        }
+        assert!(representative && secondary);
+    }
+}
