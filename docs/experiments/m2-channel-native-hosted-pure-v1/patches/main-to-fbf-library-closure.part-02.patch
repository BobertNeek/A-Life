+fn tick(e: &RecoveryGroupDetachedCpuV1, f: &PerceptionFrame) -> TrainingReplayTick {
+    let derived = prepare_sleep_choice_grounded_drive_features_v1(f).unwrap();
+    let cs = f
+        .candidates()
+        .iter()
+        .enumerate()
+        .map(|(i, c)| {
+            let mut x = [0.; 54];
+            x[..24].copy_from_slice(&c.features.0);
+            x[36..46].copy_from_slice(&derived[i]);
+            let family = e
+                .source()
+                .candidate_decoder()
+                .families()
+                .iter()
+                .find(|x| x.family() == c.family)
+                .unwrap();
+            TrainingReplayCandidate {
+                family: c.family,
+                decoder_inputs: x,
+                innate_bias: family.innate_contribution(f.homeostasis().drives, c.features),
+            }
+        })
+        .collect();
+    TrainingReplayTick {
+        encoded_inputs: (0..2048).map(|i| (i % 13) as f32 / 31. - 0.1).collect(),
+        projection_gain: 0.5,
+        local_threshold_shift: 0.25,
+        microstep_count: 4,
+        enabled_routes: vec![true; e.source().projections().len()],
+        effective_weight_offsets: vec![0.; e.source().synapses().len()],
+        structural_synapses: vec![],
+        candidates: cs,
+    }
+}
+fn run(e: &mut RecoveryGroupDetachedCpuV1, f: &PerceptionFrame) -> RecoveryGroupProbeResultV1 {
+    let t = tick(e, f);
+    let rows = e.bind_rows(f, &t).unwrap();
+    e.step(
+        f,
+        t,
+        &rows,
+        MediationModulationV1::default(),
+        u32::MAX >> (32 - f.candidates().len()),
+        [true; 6],
+        u64::MAX,
+    )
+    .unwrap()
+}
