+fn inject_frozen_sentinels(host: &mut CpuGroupedM2HostV1) {
+    let p = host.founder.phenotype();
+    let (index, synapse) = p
+        .synapses()
+        .iter()
+        .enumerate()
+        .find(|(_, s)| s.kind() == CompiledSynapseKind::Recurrent && s.alpha() != 0.)
+        .unwrap();
+    let r = host.host.residents.values_mut().next().unwrap();
+    let mut n = r.neural.checkpoint().unwrap();
+    n.fast[index] = 0.03125;
+    n.lifetime[index] = 0.0625;
+    n.eligibility[index] = 0.125;
+    let mut branches = n.neural.dendrites.branches().to_vec();
+    let old = branches[0].clone();
+    branches[0] = DendriticBranch::new(old.target, 0.03125, 0.875, old.inputs).unwrap();
+    n.neural.dendrites = DendriticBranchSet::new(branches).unwrap();
+    let mut v = r.v11.checkpoint();
+    v.dendritic_branches = n.neural.dendrites.clone();
+    v.sparse_spans = vec![alife_gpu_backend::GpuV11SparseSpan {
+        target: synapse.target(),
+        edges: vec![alife_gpu_backend::GpuV11SparseEdge {
+            source: synapse.source(),
+            target: synapse.target(),
+            route: u32::from(synapse.route_index()),
+            weight: 0.875,
+        }],
+    }];
+    r.v11 = GpuV11CausalState::restore(v).unwrap();
+    r.neural = CpuOrganismState::from_checkpoint(p, n).unwrap();
+    // Explicit synthetic test sentinel and self-consistent reseal, not learning.
+    host.host.seal_all_residents().unwrap();
+}
