+        for r in &self.core.recipe.manifest.drive_proposal_readouts {
+            common[4] += base.receipt.appended_activations[r.source - START]
+                * (cue(r, &virtual_candidate) * r.weight);
+        }
+        let mut next = self.state.clone();
+        let (group, group_jac, operations, op_jac, pressure_jac) =
+            extension_forward(&self.recipe, &mut next, &base.receipt, &binding, common, m)?;
+        let scores = RecoveryGroupScoresV2 {
+            binding,
+            ordinary: base
+                .receipt
+                .core_logits
+                .iter()
+                .map(|x| f64::from(*x))
+                .collect(),
+            group: f64::from(group),
+            operations: operations.map(f64::from),
+        };
