+fn source() -> (PhenotypeCompilerInputs, FoundationWeightAsset) {
+    static SOURCE: OnceLock<(PhenotypeCompilerInputs, FoundationWeightAsset)> = OnceLock::new();
+    SOURCE
+        .get_or_init(|| {
+            let g =
+                BrainGenome::scaffold(0x4d32, BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID);
+            let d = DevelopmentState::new(g.id, Tick::ZERO, NormalizedScalar::new(1.).unwrap());
+            let (p, i) = PhenotypeCompiler::compile_n2048_grounded_drive_basis(
+                g,
+                d,
+                SensorProfile::GroundedObjectSlotsV1,
+            )
+            .unwrap();
+            let a = FoundationWeightAsset::from_trained_weights(
+                &p,
+                p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+                TrainingStageManifest::bootstrap(),
+            )
+            .unwrap();
+            let (_, bound_inputs) =
+                PhenotypeCompiler::compile_n2048_grounded_drive_basis_candidate(
+                    i.genome().clone(),
+                    i.development().clone(),
+                    a.clone(),
+                )
