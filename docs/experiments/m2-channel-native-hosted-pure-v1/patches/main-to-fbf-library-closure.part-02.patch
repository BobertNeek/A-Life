+            unique.dedup();
+            assert_eq!(unique.len(), e.selected_physical_candidates_once.len());
+            representative |= a.representative == RecoveryGroupChoiceV2::RestGroup;
+            secondary |= a.representative != RecoveryGroupChoiceV2::RestGroup
+                && a.motors[4] == RecoveryGroupChoiceV2::RestGroup;
