+        .replace_organism_record_exact(registry.get(id).unwrap().clone())
+        .unwrap();
+    probe.host.seal_all_residents().unwrap();
+    let observed = probe.step(0.73).unwrap();
+    let total = observed.decisions[0].motor.reservation_q16;
+    let record = host.world().organism_registry().iter().next().unwrap();
+    let id = record.organism_id();
+    let r = host.host.residents.values().next().unwrap();
+    let p = host.founder.phenotype();
+    let capacity = host_capacity(p).unwrap();
+    let lookahead = cpu_activity_budget(
+        p,
+        CpuActivityAnchor {
+            organism_id: id,
+            tick: host.world().tick(),
+            sequence_cursor: r.next_sequence,
+            previous_dispatch_generation: r.neural.checkpoint().unwrap().dispatch_generation,
+            source_frame_digest: r.activity.source_frame_digest,
+            frame_digest: p.phenotype_hash().0,
+        },
+        0.1,
+        u32::from(capacity.execution().max_candidates()),
+        u32::from(capacity.execution().max_memory_context_records()),
+    )
+    .unwrap();
+    eprintln!(
+        "GROUPED_BUDGET total={total} lookahead={}",
+        lookahead.debit_atp_q16
+    );
+    assert!(total > lookahead.debit_atp_q16 + 2);
+    let available = (total + lookahead.debit_atp_q16) / 2;
+    // Deliberately synthetic budget boundary, separate from behavioral fixtures.
+    // Canonical registry mutation reseals biology; no behavioral conclusion.
+    let mut registry = host.world().organism_registry().clone();
+    registry
+        .with_biology_mut(id, |bio| {
+            bio.homeostasis.drives.brain_atp = available as f32 / BRAIN_ATP_Q16_MAX as f32;
+            Ok(())
