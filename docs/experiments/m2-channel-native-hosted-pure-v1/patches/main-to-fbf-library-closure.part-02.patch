+fn bytes<T: serde::Serialize>(v: &T) -> Vec<u8> {
+    serde_json::to_vec(v).unwrap()
+}
+fn decode_exact(checkpoint: &CpuGroupedM2HostCheckpointV1) -> CpuGroupedM2HostCheckpointV1 {
+    let wire = checkpoint.encode().unwrap();
+    let raw: GroupedPayloadV1 = serde_json::from_value(
+        serde_json::from_slice::<serde_json::Value>(&wire[MAGIC.len()..]).unwrap(),
+    )
+    .unwrap();
+    let raw_bits = grouped_sampler_bits(&raw.controllers);
+    if raw_bits != checkpoint.payload.sampler_bits {
+        eprintln!(
+            "GROUPED_EXACT_SAMPLER repaired_decimal_rounding raw={raw_bits:?} exact={:?}",
+            checkpoint.payload.sampler_bits
+        );
+    }
+    let decoded = CpuGroupedM2HostCheckpointV1::decode(&wire).unwrap();
+    assert!(
+        bytes(&decoded.payload) == bytes(&checkpoint.payload),
+        "exact envelope decode changed source/controller state"
+    );
+    decoded
+}
