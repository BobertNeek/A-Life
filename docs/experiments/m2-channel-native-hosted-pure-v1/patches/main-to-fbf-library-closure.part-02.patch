+//! Fresh detached M2 arithmetic. No production phenotype, optimizer, sampling,
+//! breeding, export, acquired-state import or fallback. The pinned graph uses
+//! the identical native soma/dendrite functions as SparseGraph. Its signed
+//! edges are private modulatory rows, never illegal MotorProposal edges.
+use super::{
+    finite, invalid,
+    native_kernel::{self, CellState},
+    replay::SparseGraph,
+};
+use crate::{
+    TrainingError, TrainingInitialState, TrainingReplayCandidate, TrainingReplayEvaluation,
+    TrainingReplayTick, TrainingSequence,
+};
+use alife_core::*;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+const MANIFEST: &str =
+    include_str!("../../../../docs/experiments/motor-mediation-m2-design-v1/recipe.json");
+pub const M2_RECIPE_SHA256: &str =
+    "285841b7e9a6d26c60142b6e2dd25f04a0bef0bec943c6203834155e89af0278";
+const START: usize = 2048;
