+    /// Only the new detached envelope, never the ordinary checkpoint codec.
+    pub fn restore(
+        inputs: &PhenotypeCompilerInputs,
+        asset: &FoundationWeightAsset,
+        mode: MediationModeV1,
+        snapshot: MediationDetachedSnapshotV1,
+    ) -> Result<Self, TrainingError> {
+        let mut fresh = Self::fresh(inputs, asset, mode)?;
+        if snapshot.schema != SCHEMA
+            || snapshot.recipe != M2_RECIPE_SHA256
+            || snapshot.source_hash != fresh.state.source_hash
+            || snapshot.source_asset != fresh.state.source_asset
+            || snapshot.mode != mode
+            || snapshot.source.dendrites != fresh.state.source.dendrites
