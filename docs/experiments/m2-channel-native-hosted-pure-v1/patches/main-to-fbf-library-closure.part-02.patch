+    for i in [1, 6] {
+        t.candidates[i].decoder_inputs[24] = if i == 1 { 0.2 } else { -0.1 };
+    }
+    let rows = e.bind_rows(&f, &t).unwrap();
+    let r = e
+        .step(
+            &f,
+            t.clone(),
+            &rows,
+            MediationModulationV1::default(),
+            127,
+            [true; 6],
+            u64::MAX,
+        )
+        .unwrap();
+    let a = (0..100)
+        .map(|n| r.receipt.scores.sample(75, n, 1.7).unwrap())
+        .find(|a| a.operation.is_some())
+        .unwrap();
+    let g = r.receipt.scores.evaluate(&a).unwrap().gradient;
+    let dg = r.decoder_log_probability_gradient(&g).unwrap();
+    let mut tested = [false; 2];
+    for (j, row) in e.source().synapses().iter().enumerate() {
+        let CompiledSynapseKind::Decoder(d) = row.kind() else {
+            continue;
+        };
+        if d.family() != CandidateActionFamily::Rest {
+            continue;
+        }
+        let k = match d.head() {
+            DecoderHeadKind::ActionCandidate => 0,
+            DecoderHeadKind::MemoryContext => 1,
+            _ => continue,
+        };
+        if tested[k] || dg[j].abs() < 1e-5 {
+            continue;
+        }
+        let h = 0.002;
+        let run_weight = |delta: f32| {
+            let mut q = fresh();
+            q.core.weights[j] += delta;
+            let rr = q.bind_rows(&f, &t).unwrap();
+            q.step(
+                &f,
+                t.clone(),
+                &rr,
+                MediationModulationV1::default(),
+                127,
+                [true; 6],
+                u64::MAX,
+            )
+            .unwrap()
+        };
+        let plus = run_weight(h);
+        let minus = run_weight(-h);
+        let fd = (plus
+            .receipt
+            .scores
+            .evaluate(&a)
+            .unwrap()
+            .joint_log_probability
+            - minus
+                .receipt
+                .scores
+                .evaluate(&a)
+                .unwrap()
+                .joint_log_probability)
+            / f64::from(2. * h);
+        close(fd, dg[j], 0.0002);
+        tested[k] = true;
+    }
+    assert!(tested[0]);
+    assert!(tested[1]);
+    assert!(!e.source().synapses().iter().any(|s|matches!(s.kind(),CompiledSynapseKind::Decoder(d)if d.head()==DecoderHeadKind::CognitiveContext)));
+}
