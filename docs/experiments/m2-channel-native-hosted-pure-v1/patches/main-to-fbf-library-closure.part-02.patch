+            serde_json::json!({"case":name,"scope":"synthetic input-only recorded source proposal scales, NOT a current native source frame or physiological life", "order":["Ingest","Other/Play-candidate-no-adapter","Rest"],"old_play_appended_for_context_only":0.012442939,"inputs":values,"full":full.core_logits,"drive_sham":sham.core_logits,"source_cut":cut.core_logits,"drive_components":full.components.iter().map(|v|v[4]).collect::<Vec<_>>(),"work":full.work})
+        );
+        if name == "satisfied_hunger_high_boredom" {
+            assert!(full.core_logits[0] < full.core_logits[1]);
+            assert!(sham.core_logits[0] > sham.core_logits[1]);
+        }
+        if name == "archived_hunger_high_boredom" {
+            assert!(full.core_logits[0] > full.core_logits[1]);
