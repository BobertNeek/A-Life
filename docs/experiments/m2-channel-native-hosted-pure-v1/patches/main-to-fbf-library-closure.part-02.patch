@@ -0,0 +1,208 @@
+//! Fresh B1 plus explicitly inherited bounded memory reader and four motor heads.
+//! No archived life, learned checkpoint, concentration patch or training input.
+#[allow(dead_code)]
+#[path = "../../examples/support/grounded_r0_dedicated_fatigue.rs"]
+mod dedicated;
+#[allow(dead_code)]
+#[path = "../../examples/support/multidrive_frozen.rs"]
+mod frozen;
+#[allow(dead_code)]
+#[path = "../../examples/support/grounded_r0_motor_operating_point.rs"]
+mod readout;
+use alife_core::*;
+use alife_runtime::canonical_preparation::foundation_construction_development;
+use alife_world::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+pub type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+pub struct Recipe {
+    pub config: CanonicalNewGameConfig,
+    pub genotype: CreatureGenome,
+    pub phenotype: BrainPhenotype,
+    pub asset: FoundationWeightAsset,
+    pub inputs: PhenotypeCompilerInputs,
+    pub metadata: Value,
+}
+pub fn build(seed: u64, timer: bool) -> Result<Recipe> {
+    let mut config = CanonicalNewGameConfig::phase3(seed, 1)?;
+    config.brain_class = BrainScaleTier::Standard2048;
+    let builtin = FoundationWeightAsset::builtin_n2048_v1(config.sensor_profile)?;
+    let original = create_canonical_new_game_with_n2048_candidate(&config, &builtin)?;
+    let mut genotype = original
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("missing newborn")?
+        .genome()
+        .clone();
+    // These are new inherited genes before this source's expression/compilation.
+    let a = genotype.brain.construction.maternal_architecture;
+    let heads = alife_core::genome::CognitiveArchitectureGenomeParameters::try_new_v1(
+        a.attention_capacity(),
+        a.active_concept_limit(),
+        a.active_gap_limit(),
+        a.predictor_capacity(),
+        a.predictor_learning_rate(),
+        4,
+        a.motor_head_width(),
+        a.dendritic_branch_capacity(),
+        a.structural_candidate_budget(),
+        a.structural_edit_budget(),
+        a.sleep_trigger_threshold(),
+        a.sleep_replay_rate(),
+        a.sleep_consolidation_rate(),
+        a.attention_learning_rate(),
+        a.concept_learning_rate(),
+        a.motor_learning_rate(),
+        a.structural_learning_rate(),
+    )?;
+    genotype.brain.construction.maternal_architecture = heads;
+    genotype.brain.construction.paternal_architecture = heads;
+    genotype.chemistry.graph = genotype
+        .chemistry
+        .graph
+        .with_awake_rest_recovery_v1(AlleleSide::Maternal)?
+        .with_awake_rest_recovery_v1(AlleleSide::Paternal)?;
+    if timer {
+        genotype.chemistry.graph = genotype
+            .chemistry
+            .graph
+            .with_recovery_timescale_v1(AlleleSide::Maternal)?
+            .with_recovery_timescale_v1(AlleleSide::Paternal)?;
+    }
+    let expressed = genotype.express()?;
+    let genome = expressed.brain_genome.clone();
+    let development = foundation_construction_development(
+        &genome,
+        &BrainCapacityClass::n2048(),
+        &expressed.development_state_at(Tick::ZERO)?,
+    )?;
+    let (bounded, _) = PhenotypeCompiler::compile_n2048_bounded_founder(
+        genome.clone(),
+        development.clone(),
+        config.sensor_profile,
+    )?;
+    let (weights, circuits) = frozen::whole_care(&bounded)?;
+    let (weights, differential) = readout::counterbalance(&bounded, &weights, &circuits, 0., true)?;
+    let (weights, references) =
+        dedicated::full_reference_calibration(&bounded, &weights, &circuits, true)?;
+    let (mut weights, dedicated_b) =
+        dedicated::build(&bounded, &weights, dedicated::Factor::Dedicated)?;
+    let mut reader = Vec::new();
+    for (index, synapse) in bounded.synapses().iter().enumerate() {
+        if matches!(synapse.kind(), CompiledSynapseKind::Decoder(c) if c.head() == DecoderHeadKind::MemoryContext)
+        {
+            if weights[index] != 0. {
+                return Err("archived B1 reader is no longer zero".into());
+            }
+            weights[index] = synapse.genetic_weight();
+            reader.push(json!({"bounded_index":index,"address":bounded.persistent_address_map().synapses()[index].address(),"b1":0.,"composed":weights[index]}));
+        }
+    }
+    if reader.len() != 4096
+        || reader
+            .iter()
+            .filter(|r| r["composed"].as_f64() != Some(0.))
+            .count()
+            != 592
+    {
+        return Err("qualified bounded reader coordinates changed".into());
+    }
+    let source_asset = FoundationWeightAsset::from_trained_weights(
+        &bounded,
+        weights,
+        TrainingStageManifest::bootstrap(),
+    )?;
+    let m = source_asset.manifest();
+    genotype.foundation = FoundationGeneticIdentity::new(
+        m.foundation_id().raw(),
+        m.foundation_version().raw() as u16,
+        m.compatibility_family_id().raw(),
+        BrainCapacityClass::N2048_ID,
+    )?;
+    genotype.n2048_foundation_candidate = Some(source_asset.clone());
+    genotype.validate_contract()?;
+    if genotype.express()?.brain_genome != genome {
+        return Err("asset binding changed inherited brain".into());
+    }
+    let (source, source_inputs) = PhenotypeCompiler::compile_n2048_bounded_founder_candidate(
+        genome,
+        development,
+        source_asset.clone(),
+    )?;
+    let transfer = crate::transfer_bounded_genetic_founder_to_grounded_drive(
+        &source,
+        &source_inputs,
+        &source_asset,
+    )?;
+    if transfer.added_zero_rows != 1280 {
+        return Err("grounded transfer changed".into());
+    }
+    for row in &mut reader {
+        let index = row["bounded_index"]
+            .as_u64()
+            .ok_or("reader index missing")? as u32;
+        let (_, target) = transfer
+            .source_to_target
+            .iter()
+            .find(|(source, _)| *source == index)
+            .ok_or("reader transfer row missing")?;
+        let weight = transfer.asset.weights()[*target as usize];
+        if weight.to_bits() != source_asset.weights()[index as usize].to_bits() {
+            return Err("reader weight changed during transfer".into());
+        }
+        row["grounded_index"] = json!(target);
+        row["grounded_address"] = json!(transfer.phenotype.persistent_address_map().synapses()
+            [*target as usize]
+            .address());
+    }
+    let reader_max = reader
+        .iter()
+        .map(|r| r["composed"].as_f64().unwrap().abs())
+        .fold(0_f64, f64::max) as f32;
+    if reader_max.to_bits() != 0.01375_f32.to_bits() {
+        return Err("bounded reader maximum differs".into());
+    }
+    let reader_sha256 = format!("{:x}", Sha256::digest(serde_json::to_vec(&reader)?));
+    let genotype = CreatureGenome::from_n2048_grounded_drive_transfer(
+        &genotype,
+        &transfer.inputs,
+        transfer.asset.clone(),
+    )?;
+    genotype.validate_n2048_grounded_drive_inputs(&transfer.inputs)?;
+    if transfer
+        .phenotype
+        .cognitive_architecture()
+        .motor_head_count()
+        != 4
+        || !transfer
+            .phenotype
+            .candidate_decoder()
+            .factorized_motor_channels(&transfer.phenotype)?
+            .contains(&MotorChannel::Posture)
+        || genotype
+            .express_n2048_grounded_drive_research()?
+            .chemistry
+            .biochemical
+            .value_profile()
+            .hormones[8]
+            != 0.
+    {
+        return Err("composed birth capability or valuation mismatch".into());
+    }
+    let metadata = json!({"recipe":"B1+bounded-reader+four-head+awake-rest-v1", "seed":seed,"timer":timer,
+        "b1_recipe":"whole-care6/counterbalance/full references/dedicated fatigue B/tonic-on",
+        "reader_is_authored_not_learned":true,"reader_rows":reader,"reader_sha256":reader_sha256,"differential":differential,"references":references,"dedicated_b":dedicated_b,
+        "source_asset":source_asset.digest(),"target_asset":transfer.asset.digest(),"inputs":transfer.inputs.canonical_digest(),
+        "phenotype":transfer.phenotype.phenotype_hash(),"added_zero_rows":transfer.added_zero_rows,
+        "reader_max_abs":reader_max,"genotype_sha256":format!("{:x}",Sha256::digest(serde_json::to_vec(&genotype)?)),"expressed_graph":genotype.express_n2048_grounded_drive_research()?.chemistry.biochemical,"pressure_value":0.,"world_steps":0,"neural_steps":0,"optimizer_steps":0});
+    Ok(Recipe {
+        config,
+        genotype,
+        phenotype: transfer.phenotype,
+        asset: transfer.asset,
+        inputs: transfer.inputs,
+        metadata,
+    })
+}
diff --git a/crates/alife_training/src/cpu/grouped_host_food_tests.rs b/crates/alife_training/src/cpu/grouped_host_food_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8979d0ed0014306b0db64838ac065e147847052e
--- /dev/null
+++ b/crates/alife_training/src/cpu/grouped_host_food_tests.rs
@@ -0,0 +1,339 @@
+//! Two fixed, matched harmless-Food fixtures. Link as a child of
+//! grouped_host_tests.rs so its existing fixture(240) is the only constructor.
+//! No source/body edits, forced actions, hazard legality confound, seed search,
+//! coefficient tuning, checkpoint import, or concentration patch is used.
+//!
+//! Sensing limitation: profile5 wraps GroundedObjectSlotsV1, not TerrainVision.
+//! Its object slots expose raw chemical[0] before ingestion and even at distance.
+//! These are regressions of that existing interface, not contact-only tasting,
+//! learned food preference, poisoned-food avoidance, or ecological qualification.
+use super::*;
+
+const FOOD_POSITION: Vec3f = Vec3f {
+    x: 0.6,
+    y: 0.,
+    z: 0.,
+};
+const FOOD_NUTRITION: f32 = 0.6;
+const TASTE_MAGNITUDE: f32 = 0.8;
+const INTERVAL_LIMIT: usize = 24;
+const TEMPERATURE: f32 = 0.73;
+
+fn add_harmless_food(host: &mut CpuGroupedM2HostV1, taste: f32) -> WorldEntityId {
+    let id = host
+        .host
+        .world
+        .editor_spawn_object(WorldEditorSpawnSpec {
+            label: "matched-harmless-food".into(),
+            kind: WorldObjectKind::Food,
+            organism_id: None,
+            position: FOOD_POSITION,
+            nutrition: FOOD_NUTRITION,
+            hazard_pain: 0.,
+            radius: 0.25,
+            token_id: None,
+        })
+        .unwrap();
+    let mut properties = host.world().entity(id).unwrap().grounded_physical;
+    // Existing public physical-property provider validates signed chemistry.
+    // Only the taste coordinate differs; smell, nutrition, and hazard stay fixed.
+    properties.chemical[0] = taste;
+    host.host
+        .world
+        .set_grounded_physical_properties(id, properties)
+        .unwrap();
+    id
+}
+fn draft(host: &CpuGroupedM2HostV1) -> PerceptionFrameDraft {
+    let mut world = host.host.world.clone();
+    let record = world.organism_registry().iter().next().unwrap();
+    let id = record.organism_id();
+    let homeostasis = record.biochemistry().homeostasis;
+    let admission = SleepChoiceWorldAdmissionV1::for_organism(&world, id).unwrap();
+    let tick = world.tick();
+    world
+        .perception_sleep_choice_draft_with_bindings(&admission, tick, homeostasis)
+        .unwrap()
+        .0
+}
+fn matched_food_pair() -> (CpuGroupedM2HostV1, CpuGroupedM2HostV1, WorldEntityId) {
+    let (mut positive, _) = super::fixture(240);
+    let (mut negative, _) = super::fixture(240);
+    assert!(
+        positive.checkpoint().unwrap().encode().unwrap()
+            == negative.checkpoint().unwrap().encode().unwrap(),
+        "matched initial state differs"
+    );
+    let food = add_harmless_food(&mut positive, TASTE_MAGNITUDE);
+    assert_eq!(add_harmless_food(&mut negative, -TASTE_MAGNITUDE), food);
+    let p = positive.world().entity(food).unwrap();
+    let mut n = negative.world().entity(food).unwrap().clone();
+    assert_eq!(p.kind, WorldObjectKind::Food);
+    assert_eq!(p.hazard_pain, 0.);
+    assert_eq!(n.hazard_pain, 0.);
+    assert_eq!(p.nutrition, n.nutrition);
+    assert_eq!(p.position, n.position);
+    assert!(!p.consumed && p.carried_by.is_none());
+    n.grounded_physical.chemical[0] = p.grounded_physical.chemical[0];
+    assert_eq!(p, &n, "only raw taste coordinate may differ");
+    let p = draft(&positive);
+    let n = draft(&negative);
+    assert_eq!(p.homeostasis(), n.homeostasis());
+    assert_eq!(p.body(), n.body());
+    // Compare the entire offered action/target list, not only a food affordance.
+    // Chemical features may differ; world-owned identity and legality must not.
+    let identities = |d: &PerceptionFrameDraft| {
+        d.candidates()
+            .iter()
+            .map(|c| (c.action_id, c.kind, c.family, c.target))
+            .collect::<Vec<_>>()
+    };
+    assert_eq!(identities(&p), identities(&n));
+    assert!(
+        p.candidates()
+            .iter()
+            .any(|c| c.action_id == HeadlessActionIds::EAT && c.target.entity == Some(food)),
+        "fixture must offer real reachable ingestion, not a hazard or unreachable target"
+    );
+    assert!(p
+        .grounded_object_slots()
+        .iter()
+        .any(|s| s.chemical[0] == TASTE_MAGNITUDE));
+    assert!(n
+        .grounded_object_slots()
+        .iter()
+        .any(|s| s.chemical[0] == -TASTE_MAGNITUDE));
+    for (draft, taste) in [(p, TASTE_MAGNITUDE), (n, -TASTE_MAGNITUDE)] {
+        let frame = draft.finalize(PerceptionContextBlock::empty()).unwrap();
+        let derived = prepare_sleep_choice_grounded_drive_features_v1(&frame).unwrap();
+        for (index, candidate) in frame.candidates().iter().enumerate() {
+            if candidate.target.entity == Some(food) {
+                assert_eq!(
+                    candidate.features.0[15], taste,
+                    "primary observed taste lane15"
+                );
+                assert_eq!(derived[index][1], taste.max(0.), "positive taste lane37");
+                assert_eq!(derived[index][2], (-taste).max(0.), "negative taste lane38");
+            }
+        }
+    }
+    (positive, negative, food)
+}
+#[derive(Debug, Default)]
+struct FoodTrace {
+    decisions: usize,
+    offered_ingestion: usize,
+    selected_ingestion: usize,
+    physical_ingestions: usize,
+    consumed: bool,
+}
+/// Read-only witnesses on an already executed actual frame. No neural rerun,
+/// replacement sample, counter advance, or physical dispatch is performed here.
+fn log_food_policy_witness(
+    phenotype: &BrainPhenotype,
+    decision: &CpuGroupedM2HostDecisionV1,
+    label: &str,
+    ordinal: usize,
+) {
+    let frame = decision.patch.pre_action().perception();
+    let action = &decision.action;
+    let scores = &decision.motor.native.scores;
+    let probabilities = scores.probabilities(action.temperature).unwrap();
+    let (representative, motors) = scores.physical_selection(action).unwrap();
+    let action_id = |index: u16| frame.candidates()[index as usize].action_id.raw();
+    let choice_id = |choice: RecoveryGroupChoiceV2| match choice {
+        RecoveryGroupChoiceV2::Candidate(index) => Some(action_id(index)),
+        RecoveryGroupChoiceV2::NoOp | RecoveryGroupChoiceV2::RestGroup => None,
+    };
+    let derived = prepare_sleep_choice_grounded_drive_features_v1(frame).unwrap();
+    let rows = frame
+        .candidates()
+        .iter()
+        .enumerate()
+        .filter(|(_, candidate)| {
+            matches!(
+                candidate.family,
+                CandidateActionFamily::Ingest | CandidateActionFamily::Avoid
+            ) || candidate.action_id == HeadlessActionIds::NO_MANIPULATION
+        })
+        .map(|(index, candidate)| {
+            serde_json::json!({
+                "index": index,
+                "action_id": candidate.action_id.raw(),
+                "family": candidate.family,
+                "observed_primary_taste_lane15": candidate.features.0[15],
+                "derived_positive_taste_lane37": derived[index][1],
+                "derived_negative_taste_lane38": derived[index][2],
+                "source_logit": decision.source_diagnostic_logits[index],
+                "native_components_S_I_M_C_D": decision.motor.native.core.components[index],
+                "native_ordinary_score": scores.ordinary[index],
+            })
+        })
+        .collect::<Vec<_>>();
+    // This matches the native policy's representative-to-channel mapping.
+    // A representative Interact/Write forces Manip and contributes no second
+    // categorical draw or log probability for that forced motor slot.
+    let forced_manip = match action.representative {
+        RecoveryGroupChoiceV2::Candidate(index) => matches!(
+            frame.candidates()[index as usize].kind,
+            ActionKind::Interact | ActionKind::Write
+        ),
+        RecoveryGroupChoiceV2::NoOp | RecoveryGroupChoiceV2::RestGroup => false,
+    };
+    let manip = probabilities.channels[2].as_ref();
+    let unforced_distribution = manip.map(|factor| {
+        factor
+            .outcomes
+            .iter()
+            .enumerate()
+            .map(|(index, choice)| {
+                serde_json::json!({
+                    "choice": choice,
+                    "action_id": choice_id(*choice),
+                    "p": factor.probabilities[index],
+                    "logp": factor.log_probabilities[index],
+                })
+            })
+            .collect::<Vec<_>>()
+    });
+    let (actual_manip_p, actual_manip_logp) = if let (false, Some(factor)) = (forced_manip, manip) {
+        let index = factor
+            .outcomes
+            .iter()
+            .position(|choice| *choice == action.motors[2])
+            .unwrap();
+        (factor.probabilities[index], factor.log_probabilities[index])
+    } else {
+        (1., 0.)
+    };
+    let representative_index = probabilities
+        .representative
+        .outcomes
+        .iter()
+        .position(|choice| *choice == action.representative)
+        .unwrap();
+    let oldsource = crate::cpu::input::sample_cpu_sleep_choice_joint_action(
+        phenotype,
+        frame,
+        &decision.source_diagnostic_logits,
+        action.seed,
+        action.counter,
+        TEMPERATURE,
+    )
+    .unwrap();
+    eprintln!(
+        "GROUPED_FOOD_POLICY_WITNESS {}",
+        serde_json::json!({
+            "arm": label,
+            "actual_decision_ordinal": ordinal,
+            "tick": frame.tick().raw(),
+            "frame_digest": frame.frame_digest(),
+            "seed": action.seed,
+            "counter": action.counter,
+            "temperature": action.temperature,
+            "rows": rows,
+            "native": {
+                "representative_choice": action.representative,
+                "physical_representative_action_id": action_id(representative),
+                "representative_p": probabilities.representative.probabilities[representative_index],
+                "representative_logp": probabilities.representative.log_probabilities[representative_index],
+                "selected_manip_action_id": motors[2].map(action_id),
+                "representative_forces_manip": forced_manip,
+                "manip_channel_enabled": manip.is_some(),
+                "actual_conditional_manip_p": actual_manip_p,
+                "actual_conditional_manip_logp": actual_manip_logp,
+                "unforced_manip_distribution_diagnostic_only": unforced_distribution,
+                "joint_logp": action.old_joint_log_probability,
+                "draw_factors": action.draw_factors,
+                "accounting": "forced Manip has p=1/logp=0; unforced distribution not added again to joint logp"
+            },
+            "oldsource_same_frame_witness": {
+                "representative_action_id": action_id(oldsource.representative),
+                "selected_manip_action_id": oldsource.motor_candidates[2].map(action_id),
+                "all_motor_action_ids": oldsource.motor_candidates.map(|index|index.map(action_id)),
+                "joint_logp": oldsource.old_joint_log_probability,
+                "scope": "same actual frame/logits/seed/counter; different policy RNG domain; no source rerun or world effect; NOT an alternate world trajectory"
+            },
+            "objective_status": "Corrected primary chemical[0] control. Prior chemical[2] trace did not test taste discrimination and cannot establish a brain regression. No pre-attribution of this outcome."
+        })
+    );
+}
+fn run_food(mut host: CpuGroupedM2HostV1, food: WorldEntityId, label: &str) -> FoodTrace {
+    let before = frozen(&host);
+    let mut trace = FoodTrace::default();
+    for interval in 0..INTERVAL_LIMIT {
+        let step = host.step(TEMPERATURE).unwrap();
+        for d in step.decisions {
+            trace.decisions += 1;
+            let frame = d.patch.pre_action().perception();
+            trace.offered_ingestion +=
+                usize::from(frame.candidates().iter().any(|c| {
+                    c.action_id == HeadlessActionIds::EAT && c.target.entity == Some(food)
+                }));
+            let bundle = d
+                .patch
+                .selected_bundle()
+                .expect("native canonical physical bundle");
+            trace.selected_ingestion += usize::from(bundle.channels.iter().any(|c| {
+                c.primitive == HeadlessActionIds::EAT
+                    && c.target.is_some_and(|t| t.entity == Some(food))
+            }));
+            let outcome = d.patch.outcome();
+            let ingested = outcome.joint.as_ref().is_some_and(|j| {
+                j.channel_outcomes.iter().any(|c| {
+                    c.physical.contact == PhysicalContactKind::Consumed
+                        && c.physical.target_entity == Some(food)
+                })
+            }) || (outcome.physical.contact == PhysicalContactKind::Consumed
+                && outcome.physical.target_entity == Some(food));
+            if ingested {
+                trace.physical_ingestions += 1;
+                assert!(host.world().entity(food).unwrap().consumed);
+                assert!(outcome.measured_physiology.is_some());
+                eprintln!("GROUPED_FOOD_INGESTION arm={label} interval={interval} tick={} receipt={} bundle={} sampled_action={}",
+                    step.tick_before.raw(),String::from_utf8(bytes(outcome)).unwrap(),
+                    String::from_utf8(bytes(bundle)).unwrap(),String::from_utf8(bytes(&d.action)).unwrap());
+            }
+            if trace.decisions <= 2 {
+                log_food_policy_witness(host.founder.phenotype(), &d, label, trace.decisions);
+            }
+        }
+        assert!(
+            frozen(&host) == before,
+            "food changes may not open synaptic learning"
+        );
+        trace.consumed = host.world().entity(food).unwrap().consumed;
+        if trace.consumed {
+            break;
+        }
+    }
+    assert!(trace.decisions > 0 && trace.offered_ingestion > 0);
+    assert_eq!(
+        trace.consumed,
+        trace.physical_ingestions > 0,
+        "a consumed food without an actual ingestion receipt is not acceptable evidence"
+    );
+    assert!(
+        trace.physical_ingestions <= 1,
+        "one food cannot be ingested twice"
+    );
+    eprintln!("GROUPED_FOOD_BOUND arm={label} bound={INTERVAL_LIMIT} trace={trace:?}; raw object-slot taste-at-distance; no learned-preference or toxicity claim");
+    trace
+}
+#[test]
+fn grouped_host_reachable_positive_food_requires_real_native_ingestion() {
+    let (positive, _, food) = matched_food_pair();
+    let trace = run_food(positive, food, "positive-taste");
+    // This is an explicit qualification gate, not assumed success. If the fixed
+    // source fails it, retain/report failure; do not tune, sweep, or force Eat.
+    assert_eq!(trace.physical_ingestions,1,
+        "UNQUALIFIED: fixed positive-food fixture produced no actual ingestion in its 24-interval bound");
+}
+#[test]
+fn grouped_host_reachable_negative_food_reports_actual_native_outcome() {
+    let (_, negative, food) = matched_food_pair();
+    let trace = run_food(negative, food, "negative-taste");
+    // Avoidance is not fabricated as a green assertion. This arm reports whether
+    // the same harmless food was actually consumed, never a hazardous rejection.
+    eprintln!("GROUPED_FOOD_NEGATIVE consumed={} physical_ingestions={}; compare with positive arm, do not interpret a bounded non-ingestion alone as learned avoidance",trace.consumed,trace.physical_ingestions);
+}
diff --git a/crates/alife_training/src/cpu/grouped_host_loop.rs b/crates/alife_training/src/cpu/grouped_host_loop.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0c4aef0369bc26fc42ec99a93a73f96411482bab
--- /dev/null
+++ b/crates/alife_training/src/cpu/grouped_host_loop.rs
@@ -0,0 +1,856 @@
+//! Separate typed grouped world loop. The legacy flat-policy collector is untouched.
+use super::*;
+impl CpuCanonicalHost {
+    pub(super) fn grouped_step(
+        &mut self,
+        founder: &CpuFoundationTrainer,
+        temperature: f32,
+    ) -> Result<CpuGroupedM2HostStepV1, CpuHostError> {
+        self.validate_founder(founder)?;
+        for (&id, r) in &self.residents {
+            super::grouped_host_envelope::validate_grouped_sleep_boundary(r)?;
+            if r.grouped.is_none() || r.motor.is_some() || r.sleep_choice.is_some() {
+                return Err(CpuHostError::State("not a grouped M2 resident"));
+            }
+            let record = self
+                .world
+                .organism_registry()
+                .get(OrganismId(id))
+                .ok_or(CpuHostError::State("missing grouped canonical organism"))?;
+            validate_resident_authority(record, r, self.sampling_seed, self.sampling_counter)?;
+        }
+        let mut next = self.clone();
+        for r in next.residents.values_mut() {
+            r.sealed_authority = None;
+        }
+        let result = next.grouped_step_inner(founder, temperature, &mut |draft, _| Ok(draft))?;
+        *self = next;
+        Ok(result)
+    }
+    pub(super) fn grouped_step_inner(
+        &mut self,
+        founder: &CpuFoundationTrainer,
+        temperature: f32,
+        prepare: &mut impl FnMut(
+            PerceptionFrameDraft,
+            ExperienceSequenceId,
+        ) -> Result<PerceptionFrameDraft, ScaffoldContractError>,
+    ) -> Result<CpuGroupedM2HostStepV1, CpuHostError> {
+        let p = founder.phenotype();
+        let tick = self.world.tick();
+        let mut decisions = Vec::new();
+        let mut sleeping = 0;
+        let mut consolidations = 0;
+        let mut body_events = BTreeMap::new();
+        let mut perception_world = self.world.clone();
+        let ids = self
+            .world
+            .organism_registry()
+            .iter()
+            .filter(|r| r.lifecycle().is_alive())
+            .map(|r| r.organism_id())
+            .collect::<Vec<_>>();
+        for id in ids {
+            let mut record = self
+                .world
+                .organism_registry()
+                .get(id)
+                .cloned()
+                .ok_or(CpuHostError::State("missing organism"))?;
+            let r = self
+                .residents
+                .get_mut(&id.raw())
+                .ok_or(CpuHostError::State("new organism requires brain admission"))?;
+            let phase_before = r.sleep.state().phase;
+            if r.activity
+                .last_world_tick
+                .is_some_and(|last| last.checked_add(1) != Some(tick.raw()))
+            {
+                return Err(CpuHostError::State("CPU activity world clock mismatch"));
+            }
+            r.activity.last_world_tick = Some(tick.raw());
+            r.activity.remaining_atp_q16 =
+                (f64::from(record.biochemistry().homeostasis.drives.brain_atp)
+                    * f64::from(BRAIN_ATP_Q16_MAX))
+                .floor() as u32;
+            let neural_boundary = r.neural.checkpoint()?;
+            let activity_anchor = CpuActivityAnchor {
+                organism_id: id,
+                tick,
+                sequence_cursor: r.next_sequence,
+                previous_dispatch_generation: neural_boundary.dispatch_generation,
+                source_frame_digest: r.activity.source_frame_digest,
+                frame_digest: p.phenotype_hash().0,
+            };
+            let capacity = host_capacity(p)?;
+            let lookahead = cpu_activity_budget(
+                p,
+                activity_anchor,
+                record.biochemistry().homeostasis.drives.brain_atp,
+                u32::from(capacity.execution().max_candidates()),
+                u32::from(capacity.execution().max_memory_context_records()),
+            )?;
+            // Source and appendage share one admission. A resource-limited
+            // living body takes the existing recovery fallback, not a repeated
+            // rollback stall and not a forged voluntary BodySleep receipt.
+            let (_, _, grouped_affordable) = GroupedMotorStateV1::work(
+                p,
+                &lookahead.work,
+                grouped_dynamic_work(p, r, &lookahead)?,
+                lookahead.available_atp_q16,
+            )?;
+            if phase_before == SleepPhase::Awake && !grouped_affordable {
+                r.sleep
+                    .force_sleep(tick, alife_core::SleepTrigger::RecoveryProtocol)?;
+            }
+
+            let config = sleep_consolidation_config_for(p)?;
+            if phase_before == SleepPhase::Awake {
+                {
+                    r.sleep.evaluate_emergency_only(
+                        &record.biochemistry().homeostasis,
+                        HomeostaticParameters::reference(),
+                        tick,
+                    )?;
+                }
+            } else if phase_before != SleepPhase::Waking
+                || (record.biochemistry().homeostasis.drives.fatigue
+                    < config.fatigue_threshold.raw()
+                    && record.biochemistry().homeostasis.hormones.sleep_pressure
+                        < config.sleep_pressure_threshold.raw())
+            {
+                r.sleep.advance(tick)?;
+            }
+            let mut sleep_work_units = 0;
+            if r.sleep.state().phase == SleepPhase::Consolidating
+                && matches!(r.sleep.state().consolidation, ConsolidationState::None)
+            {
+                let evidence = replay_evidence(p, &r.replay)?;
+                if !evidence.batch.events.is_empty() {
+                    // Same scheduled-work pressure projection used by the native
+                    // scheduler; this is work admission, never reward/chemistry.
+                    let mut due_homeostasis = record.biochemistry().homeostasis;
+                    due_homeostasis.drives.fatigue = due_homeostasis
+                        .drives
+                        .fatigue
+                        .max(config.fatigue_threshold.raw());
+                    due_homeostasis.hormones.sleep_pressure = due_homeostasis
+                        .hormones
+                        .sleep_pressure
+                        .max(config.sleep_pressure_threshold.raw());
+                    let work = {
+                        let state = r
+                            .grouped
+                            .as_ref()
+                            .ok_or(CpuHostError::State("missing grouped replay owner"))?;
+                        state.validate_replay(&r.replay)?;
+                        r.memory.run_bounded_sleep_transaction_scoped_v1(
+                            &SleepConsolidator::new(config)?,
+                            &due_homeostasis,
+                            tick,
+                            &evidence,
+                            &state.memory_proofs,
+                            &mut r.predictor,
+                            &mut r.topology,
+                        )?
+                    };
+                    if let Some(work) = work {
+                        sleep_work_units = work.work_units;
+                        let receipt = CognitiveWorkCounters::new(
+                            0,
+                            0,
+                            0,
+                            0,
+                            0,
+                            0,
+                            0,
+                            u64::from(work.predictor_update_count),
+                            u64::from(work.replay_event_count)
+                                + u64::from(work.replay_eligibility_sample_count),
+                            0,
+                            0,
+                            work.work_units,
+                        )?
+                        .into_receipt()?;
+                        record.account_cognitive_work(
+                            receipt,
+                            CognitiveWorkCostPolicy::enabled(1.0e-6)?,
+                        )?;
+                    }
+                }
+                r.replay.clear();
+                if let Some(state) = &mut r.grouped {
+                    state.memory_proofs.clear();
+                }
+                // Closed synapses have no new weight generation. The committed
+                // output here is the actual memory/predictor/topology cycle,
+                // with the frozen source included, under a distinct identity.
+                let digest = super::grouped_host_envelope::grouped_sleep_output_digest(r)?;
+                let mut state = r.sleep.state();
+                state.consolidation = ConsolidationState::Committed {
+                    cycle_id: state.active_cycle_id,
+                    output_generation: state.active_cycle_id,
+                    output_digest: digest,
+                };
+                r.sleep = SleepController::restore(config, state)?;
+                consolidations += 1;
+            }
+            let state = r.sleep.state();
+            record.seal_sleep_phase(
+                state.phase,
+                state.active_cycle_id.max(state.last_consolidated_cycle_id),
+                tick,
+                sleep_work_units,
+            )?;
+            self.world.replace_organism_record_exact(record.clone())?;
+            if phase_before != SleepPhase::Awake {
+                body_events.insert(
+                    id.raw(),
+                    BodyEventDelta {
+                        sleep_recovery: 1.,
+                        ..BodyEventDelta::zero()
+                    },
+                );
+            }
+            if phase_before != SleepPhase::Awake || state.phase != SleepPhase::Awake {
+                sleeping += 1;
+                continue;
+            }
+            let sequence = ExperienceSequenceId(r.next_sequence);
+            let receptors = record
+                .biochemistry()
+                .neural_receptor_frame(record.phenotype())?;
+            let effects = NeuralReceptorEffects::from_frame(
+                &receptors,
+                &NeuralReceptorPhenotype::compile(p)?,
+            )?;
+            let (draft, candidate_binding) = {
+                let admission =
+                    alife_world::SleepChoiceWorldAdmissionV1::for_organism(&perception_world, id)?;
+                perception_world.perception_sleep_choice_draft_with_bindings(
+                    &admission,
+                    tick,
+                    record.biochemistry().homeostasis,
+                )?
+            };
+            let ordinary = draft.clone().with_semantic_context(None)?;
+            let draft = prepare(draft, sequence)?;
+            if draft.clone().with_semantic_context(None)? != ordinary {
+                return Err(CpuHostError::State(
+                    "semantic preparation changed ordinary perception",
+                ));
+            }
+            let preparation = prepare_canonical_frame(
+                &CanonicalPreparationInput {
+                    draft,
+                    candidate_binding,
+                    sequence_id: sequence,
+                    homeostasis: record.biochemistry().homeostasis,
+                    hysteresis: r.hysteresis,
+                    policy: attention_selection_policy_for(p),
+                    neural_receptors: receptors.clone(),
+                    receptor_effects: effects,
+                },
+                &r.memory,
+                &r.topology,
+                &r.predictor,
+                false,
+            );
+            let prepared = preparation.result?;
+            if let Some(h) = preparation.hysteresis {
+                r.hysteresis = h;
+            }
+            let frame = prepared.frame;
+            let recall = prepared.memory_recall;
+            let mut activity = cpu_activity_budget(
+                p,
+                CpuActivityAnchor {
+                    frame_digest: frame.frame_digest().0,
+                    ..activity_anchor
+                },
+                record.biochemistry().homeostasis.drives.brain_atp,
+                frame.candidates().len() as u32,
+                recall.context().candidates.len() as u32,
+            )?;
+            let motor_reservation_q24;
+            {
+                let dynamic = grouped_dynamic_work(p, r, &activity)?;
+                let (total, debit, affordable) = GroupedMotorStateV1::work(
+                    p,
+                    &activity.work,
+                    dynamic,
+                    activity.available_atp_q16,
+                )?;
+                motor_reservation_q24 = total;
+                activity.debit_atp_q16 = debit;
+                activity.affordable = affordable;
+                let extra = GroupedMotorStateV1::append_work(p)?;
+                activity.work.neuron_updates += extra.neuron_updates;
+                activity.work.synapse_ops += extra.synapse_products;
+            }
+            if !activity.affordable {
+                return Err(CpuHostError::State(
+                    "CPU neural work exceeds canonical ATP availability",
+                ));
+            }
+            let encode = super::super::input::encode_cpu_sleep_choice_frame;
+            let mut context = encode(
+                p,
+                &frame,
+                &recall,
+                &effects,
+                activity.enabled_routes.clone(),
+                r.v11
+                    .sparse_spans()
+                    .iter()
+                    .flat_map(|s| {
+                        s.edges.iter().map(|e| crate::TrainingFrozenSynapse {
+                            source: e.source,
+                            target: e.target,
+                            route: e.route,
+                            cadence: u32::from(
+                                p.projections()[e.route as usize].update_cadence().raw(),
+                            ),
+                            effective_weight: e.weight,
+                        })
+                    })
+                    .collect(),
+            )?;
+            context.microstep_count = u32::from(activity.microsteps);
+            let channels = p.candidate_decoder().factorized_motor_channels(p)?;
+            let mut capabilities = [false; 6];
+            for channel in &channels {
+                let slot = match channel {
+                    MotorChannel::Locomotion => 0,
+                    MotorChannel::Orientation => 1,
+                    MotorChannel::Manipulation => 2,
+                    MotorChannel::Vocal => 3,
+                    MotorChannel::Posture => 4,
+                    MotorChannel::SpeciesSpecific(_) => 5,
+                };
+                let effector = match channel {
+                    MotorChannel::Locomotion => Some(EffectorCapability::Translation),
+                    MotorChannel::Orientation => Some(EffectorCapability::Rotation),
+                    MotorChannel::Manipulation => Some(EffectorCapability::Manipulation),
+                    MotorChannel::Vocal => Some(EffectorCapability::Vocalization),
+                    MotorChannel::Posture => Some(EffectorCapability::Rest),
+                    MotorChannel::SpeciesSpecific(_) => None,
+                };
+                capabilities[slot] = record.lifecycle().is_alive()
+                    && effector.is_some_and(|e| record.embodiment().effector_gain(e) > 0.);
+            }
+            let n = frame.candidates().len();
+            if n == 0 || n > 32 {
+                return Err(CpuHostError::State("grouped candidate count"));
+            }
+            let attempt_mask = if n == 32 { u32::MAX } else { (1u32 << n) - 1 };
+            let state = r
+                .grouped
+                .as_mut()
+                .ok_or(CpuHostError::State("missing grouped controller"))?;
+            let output = r.neural.advance_grouped(
+                founder,
+                context,
+                &effects,
+                &mut state.motor,
+                &frame,
+                &receptors,
+                capabilities,
+                attempt_mask,
+            )?;
+            let motor = state
+                .motor
+                .last_receipt
+                .as_mut()
+                .ok_or(CpuHostError::State("missing grouped neural receipt"))?;
+            motor.reservation_q24 = motor_reservation_q24;
+            motor.reservation_q16 = activity.debit_atp_q16;
+            motor.available_atp_q16 = activity.available_atp_q16;
+            r.activity.remaining_atp_q16 = activity.available_atp_q16 - activity.debit_atp_q16;
+            r.activity.source_frame_digest = frame.frame_digest().0;
+            let sampling_counter = self.sampling_counter;
+            let scores = r
+                .grouped
+                .as_ref()
+                .unwrap()
+                .motor
+                .last_receipt
+                .as_ref()
+                .unwrap()
+                .native
+                .scores
+                .clone();
+            let action =
+                scores.sample(self.sampling_seed, sampling_counter, f64::from(temperature))?;
+            let (index, motor_candidates) = scores.physical_selection(&action)?;
+            r.grouped.as_mut().unwrap().last_action = Some(action.clone());
+            self.sampling_counter = self
+                .sampling_counter
+                .checked_add(1)
+                .ok_or(CpuHostError::State("sampling counter overflow"))?;
+            let speech = if motor_candidates[3].is_some() {
+                decode_cpu_speech(
+                    founder,
+                    &r.neural.neural_state().activations,
+                    &output.replay_tick.effective_weight_offsets,
+                )?
+            } else {
+                None
+            };
+            let candidate = &frame.candidates()[index as usize];
+            let confidence =
+                Confidence::new((candidate.sensor_confidence.raw() * 65535.).round() / 65535.)?;
+            let command = candidate.to_command(id, confidence)?;
+            let channels = p.candidate_decoder().factorized_motor_channels(p)?;
+            let slots = motor_candidates.map(|i| i.map_or(0, |i| i + 1));
+            let prompted = frame
+                .sensory()
+                .language_context
+                .heard_tokens
+                .iter()
+                .flatten()
+                .any(|t| t.source_kind == UtteranceSourceKind::Player);
+            let bundle = factorized_motor_bundle_for_candidates(
+                id,
+                sequence,
+                tick,
+                &frame,
+                slots,
+                &channels,
+                &command,
+                index,
+                speech.as_ref(),
+                prompted,
+            )?;
+            let joint = JointActionSelectionV1::new(slots, &bundle)?;
+            let development = record.phenotype().development_state_at(tick)?;
+            let pre = PreActionSnapshot::from_cpu_neural_frame(
+                sequence,
+                p.brain_class_id(),
+                p.phenotype_hash(),
+                record.phenotype().brain_genome.id,
+                record.phenotype().brain_genome.schema_version,
+                development.clone(),
+                frame.clone(),
+            )?;
+            let work_neurons = activity.work.neuron_updates;
+            let work_synapses = activity.work.synapse_ops;
+            let decision = DecisionSnapshot::from_cpu_neural_selection(
+                sequence,
+                p.phenotype_hash(),
+                output.dispatch_generation,
+                output.active_activation_side,
+                &frame,
+                NeuralActionSelection {
+                    candidate_index: index,
+                    // Source physical-row signal also drives RegionalArousal.
+                    // It is not a flat grouped logit or sampling probability.
+                    logit: output.candidate_logits[index as usize],
+                    confidence,
+                    active_tiles: u32::try_from(activity.work.tile_visits)
+                        .map_err(|_| CpuHostError::State("CPU tile work overflow"))?,
+                    active_synapses: u32::try_from(work_synapses)
+                        .map_err(|_| CpuHostError::State("CPU synapse work overflow"))?,
+                },
+                command,
+            )?
+            .with_finalized_memory_recall(&frame, &recall, index)?;
+            r.neural.stage_grouped_closed_selection(
+                p,
+                &action,
+                &scores,
+                CpuDecisionBinding {
+                    sequence_id: sequence,
+                    frame_digest: frame.frame_digest(),
+                    action_id: candidate.action_id,
+                    candidate_feature_digest: candidate.feature_digest()?,
+                    dispatch_generation: output.dispatch_generation,
+                    active_activation_side: output.active_activation_side,
+                    joint_selection: joint,
+                },
+            )?;
+            let mut cognitive = recall
+                .cognitive_context()
+                .cloned()
+                .ok_or(CpuHostError::State("missing canonical cognitive context"))?;
+            let pre_context = cognitive.clone();
+            let source = grounded_semantic_state_from_frame(&frame)?;
+            let motor_condition = JointMotorCondition::from_bundle(&bundle)?;
+            let mut forecast = r.predictor.predict(&source, &motor_condition)?;
+            forecast.source_digest = frame.frame_digest().0;
+            let mut neural_emissions = vec![
+                NeuralEmission::new(
+                    NeuralEmissionClass::RegionalArousal,
+                    // Versioned source-driven biological arousal, deliberately
+                    // distinct from the hierarchical grouped sampling scores.
+                    output.candidate_logits[index as usize].abs().tanh(),
+                    confidence.raw(),
+                )?,
+                NeuralEmission::new(
+                    NeuralEmissionClass::MotorCommitment,
+                    confidence.raw(),
+                    confidence.raw(),
+                )?,
+                NeuralEmission::new(NeuralEmissionClass::ExecutiveSustain, confidence.raw(), 1.)?,
+            ];
+            neural_emissions.extend(recall.recognized_social_emission());
+            let emissions =
+                NeuralEmissionFrame::new(tick, output.dispatch_generation, neural_emissions)?;
+            let object_novelty = bundle
+                .channels
+                .iter()
+                .filter_map(|c| c.target.and_then(|t| t.entity))
+                .filter_map(|entity| {
+                    let key = perception_world
+                        .entity(entity)?
+                        .tracking_provenance
+                        .canonical_key();
+                    let tracked = perception_world
+                        .tracked_objects()
+                        .records_for(id)?
+                        .find(|r| r.tracking_key == key)?;
+                    pre_context
+                        .peripheral
+                        .summaries
+                        .iter()
+                        .find(|s| {
+                            s.identity
+                                == StableFocusIdentity::TrackedObject(tracked.tracked_object_id)
+                        })
+                        .map(|s| (entity, s.salience.novelty.raw()))
+                })
+                .collect::<Vec<_>>();
+            let receipt = {
+                let state = r
+                    .grouped
+                    .as_mut()
+                    .ok_or(CpuHostError::State("missing grouped physical owner"))?;
+                let admission =
+                    alife_world::SleepChoiceWorldAdmissionV1::for_organism(&self.world, id)?;
+                let request = alife_world::RecoveryRequestV1::new(&admission, &frame, &bundle)?;
+                let physical = self
+                    .world
+                    .apply_sleep_choice_motor_bundle_in_staged_tick(
+                        &request,
+                        &emissions,
+                        frame.sensory().channels.novelty_signal.raw(),
+                        &object_novelty,
+                    )
+                    .map_err(|_| {
+                        CpuHostError::State("grouped M2 recovery motor transaction rejected")
+                    })?;
+                state.observe_physical(&frame, &bundle, &physical, &mut r.sleep)?;
+                if physical.successful_stationary_body_sleep {
+                    let phase = r.sleep.state();
+                    let mut actual = self
+                        .world
+                        .organism_registry()
+                        .get(id)
+                        .cloned()
+                        .ok_or(CpuHostError::State("grouped M2 sleep organism missing"))?;
+                    actual.seal_sleep_phase(
+                        phase.phase,
+                        phase.active_cycle_id,
+                        physical.motor.outcome_tick,
+                        0,
+                    )?;
+                    self.world.replace_organism_record_exact(actual)?;
+                }
+                physical.motor
+            };
+            let successor = grounded_successor_state(
+                &self.world,
+                record.world_entity_id(),
+                &receipt.biology_after,
+                frame.sensor_profile(),
+            )?;
+            let target = PredictionTargetReceipt::for_successor(
+                id,
+                sequence,
+                candidate.action_id,
+                tick,
+                frame.frame_digest().0,
+                source,
+                motor_condition,
+                successor,
+            )?;
+            let prediction = r.predictor.observe_frozen(&target, &forecast)?;
+            let error = apply_prediction_evidence(
+                &mut cognitive,
+                &target,
+                &prediction.error,
+                prediction.prediction.category_coverage,
+            )?;
+            let memory = recall.receipt();
+            let mut dendritic_work = r
+                .v11
+                .dendritic_branches()
+                .branches()
+                .iter()
+                .map(|b| 1 + b.inputs.len() as u64)
+                .sum::<u64>()
+                * u64::from(activity.microsteps);
+            dendritic_work += GroupedMotorStateV1::append_work(p)?.other_work
+                + p.sensor_encoder().assignments().len() as u64;
+            let structural_work = r
+                .v11
+                .sparse_spans()
+                .iter()
+                .flat_map(|s| &s.edges)
+                .map(|e| {
+                    if !activity.enabled_routes[e.route as usize] {
+                        return 0;
+                    }
+                    (0..activity.microsteps as usize)
+                        .filter(|&step| {
+                            super::super::replay::route_fires(
+                                p.projections()[e.route as usize].update_cadence().raw(),
+                                step,
+                            )
+                        })
+                        .count() as u64
+                })
+                .sum::<u64>();
+            let work = CognitiveWorkCounters::new(
+                work_neurons,
+                work_synapses,
+                dendritic_work,
+                // Existing semantic attention work; unpriced machine bookkeeping
+                // is deliberately absent from biological work counters.
+                cognitive.attention.budget_receipt.work_units,
+                u64::from(memory.exact_bucket_reads)
+                    + u64::from(memory.neighbor_bucket_reads)
+                    + u64::from(memory.similarity_evaluations),
+                cognitive.concept.active_concepts.len() as u64,
+                cognitive.gap.active_gaps.len() as u64,
+                prediction.error.len() as u64,
+                0,
+                structural_work,
+                0,
+                0,
+            )?
+            .into_receipt()?;
+            let mut after = self
