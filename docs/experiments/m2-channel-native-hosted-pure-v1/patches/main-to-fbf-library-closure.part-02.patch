+        .replace_organism_record_exact(registry.get(id).unwrap().clone())
+        .unwrap();
+    host.host.seal_all_residents().unwrap();
+    let before = frozen(&host);
+    let tick = host.world().tick();
+    let counter = host.host.sampling_counter;
+    let result = host.step(0.73).unwrap();
+    assert!(result.decisions.is_empty());
+    assert_eq!(result.sleeping_organisms, 1);
+    assert_eq!(result.tick_after.raw(), tick.raw() + 1);
+    assert_eq!(host.host.sampling_counter, counter);
+    assert!(frozen(&host) == before);
+    assert_eq!(
+        host.host
+            .residents
+            .values()
+            .next()
+            .unwrap()
+            .sleep
+            .state()
+            .phase,
+        SleepPhase::ForcedRecoverySleep
+    );
+    eprintln!("GROUPED_BUDGET_FALLBACK source_lookahead={} sampled_full={} injected_available={} phase=ForcedRecoverySleep; actual world advance, not an error rollback",lookahead.debit_atp_q16,total,available);
+}
