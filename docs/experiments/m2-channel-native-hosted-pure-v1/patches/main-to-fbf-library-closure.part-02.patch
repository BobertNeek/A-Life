+        drives[2] = fear;
+        drives[3] = pain;
+        drives[6] = atp;
+        drives[9] = 0.9;
+        drives[11] = pressure;
+        let rest_innate = if f > 0.55 { 1.344 } else { 0. };
+        let values = [
