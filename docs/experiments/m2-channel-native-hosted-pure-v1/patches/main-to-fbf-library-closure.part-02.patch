+impl MotorHostStateV1 {
+    pub(super) fn fresh(
+        source: &PhenotypeCompilerInputs,
+        mode: MotorHostModeV1,
+    ) -> Result<Self, TrainingError> {
+        let (p, _) = PhenotypeCompiler::compile_motor_lobe_m0(source)?;
+        Ok(Self {
+            schema_version: 1,
+            source_inputs: source.clone(),
+            mode,
+            recipe_digest: MotorLobeM0V1::recipe_digest(),
+            composite_hash: p.phenotype_hash(),
+            activations: vec![0.; 96],
+            inactive: vec![0.; 96],
+            ema: vec![0.; 96],
+            metabolic: vec![0.; 96],
+            last_receipt: None,
+        })
+    }
+    pub(super) fn matches(&self, source: &PhenotypeCompilerInputs, mode: MotorHostModeV1) -> bool {
+        &self.source_inputs == source && self.mode == mode
+    }
+    pub(super) fn validate(
+        &self,
+        source: &BrainPhenotype,
+    ) -> Result<BrainPhenotype, TrainingError> {
+        let (p, _) = PhenotypeCompiler::compile_motor_lobe_m0(&self.source_inputs)?;
+        let source_compiled = PhenotypeCompiler::compile_validated(
+            &self.source_inputs,
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+        )?;
+        if self.schema_version != 1
+            || self.recipe_digest != MotorLobeM0V1::recipe_digest()
+            || self.composite_hash != p.phenotype_hash()
+            || source_compiled != *source
+            || p.synapses()[..MotorLobeM0V1::BASE_SYNAPSES] != *source.synapses()
+            || p.neuron_dynamics()[..2048] != *source.neuron_dynamics()
+            || self
+                .ema
+                .iter()
+                .chain(&self.metabolic)
+                .any(|v| !(0. ..=1.).contains(v))
+        {
+            return Err(invalid());
+        }
+        for bank in [
+            &self.activations,
+            &self.inactive,
+            &self.ema,
+            &self.metabolic,
+        ] {
+            if bank.len() != 96 {
+                return Err(invalid());
+            }
+            finite(bank)?;
+        }
+        Ok(p)
+    }
+    pub(super) fn validate_partition(
+        &self,
+        initial: &crate::TrainingInitialState,
+    ) -> Result<(), TrainingError> {
+        initial.dendrites.validate_for_neuron_count(2048)?;
+        let capacity = usize::from(
+            self.source_inputs
+                .genome()
+                .cognitive_architecture()
+                .dendritic_branch_capacity(),
+        );
+        if initial
+            .dendrites
+            .branches()
+            .len()
+            .checked_add(MotorLobeM0V1::NEW_BRANCHES)
+            .is_none_or(|n| n > capacity)
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+    /// One native forward, never a second prefix pass. Prefix validation occurs
+    /// before joining; dynamic edges and branches cannot enter the fixed region.
+    pub(super) fn forward(
+        &mut self,
+        source: &BrainPhenotype,
+        weights: &[f32],
+        q: &TrainingSequence,
+        frame: &PerceptionFrame,
+        receptors: &NeuralReceptorFrame,
+        effects: &NeuralReceptorEffects,
+    ) -> Result<Tape, TrainingError> {
+        q.validate_for(source)?;
+        self.validate_partition(&q.initial)?;
+        let p = self.validate(source)?;
+        receptors.validate_contract()?;
+        let expected_effects = NeuralReceptorEffects::from_frame(
+            receptors,
+            &NeuralReceptorPhenotype::compile(source)?,
+        )?;
+        if q.ticks.len() != 1
+            || q.initial.activations.len() != 2048
+            || weights.len() != MotorLobeM0V1::BASE_SYNAPSES
+            || *effects != expected_effects
+            || effects.source_tick != frame.tick()
+            || frame.sensor_profile() != source.sensor_profile()
+            || q.ticks[0].candidates.len() != frame.candidates().len()
+            || q.initial
+                .dendrites
+                .branches()
+                .iter()
+                .any(|b| b.target >= 2048 || b.inputs.iter().any(|i| i.source >= 2048))
+            || q.ticks[0].structural_synapses.iter().any(|e| {
+                e.source >= 2048
+                    || e.target >= 2048
+                    || e.route as usize >= source.projections().len()
+            })
+        {
+            return Err(invalid());
+        }
+        let mut joined = q.clone();
+        joined.phenotype_hash = p.phenotype_hash();
+        joined.initial.activations.extend(&self.activations);
+        joined.initial.activity_ema.extend(&self.ema);
+        joined.initial.metabolic_load.extend(&self.metabolic);
+        let mut branches = q.initial.dendrites.branches().to_vec();
+        branches.extend(
+            p.foundation_abi()
+                .motor_lobe_m0()
+                .ok_or_else(invalid)?
+                .fixed_branches()?
+                .branches()
+                .iter()
+                .cloned(),
+        );
+        joined.initial.dendrites = DendriticBranchSet::new(branches)?;
+        let t = &mut joined.ticks[0];
+        let offset =
+            ((effects.structural_growth_gate + effects.sleep_gate + effects.consolidation_gate)
+                / 3.
+                - 0.5)
+                * 0.05;
+        // Preserve the old encoder byte-for-byte. Appended unused cells receive
+        // the same canonical afferent offset, just as the native encoder does.
+        t.encoded_inputs.resize(2144, offset.clamp(-1., 1.));
+        let drives = frame.homeostasis().drives.to_array();
+        for a in p
+            .sensor_encoder()
+            .assignments()
+            .iter()
+            .filter(|a| a.target_neuron() >= 2048)
+        {
+            let target = a.target_neuron() as usize;
+            let lane = (target - 2048) / 2;
+            let raw = if self.mode == MotorHostModeV1::EqualWorkSham {
+                MotorLobeM0V1::SETPOINTS[lane]
+            } else {
+                drives[a.source_index() as usize]
+            };
+            let (lo, hi) = a.clamp_range();
+            let affine = (raw * a.scale() + a.bias()).clamp(lo, hi);
+            t.encoded_inputs[target] =
+                (affine * effects.interoceptive_gain * effects.regional_excitability + offset)
+                    .clamp(-1., 1.);
+        }
+        t.enabled_routes.push(true);
+        t.effective_weight_offsets.resize(p.synapses().len(), 0.);
+        let mut execution_weights = weights.to_vec();
+        execution_weights.extend(
+            p.synapses()[MotorLobeM0V1::BASE_SYNAPSES..]
+                .iter()
+                .map(|s| s.genetic_weight()),
+        );
+        let t = &joined.ticks[0];
+        let mut tape = SparseGraph::new(&p).forward(&p, &execution_weights, &joined)?;
+        let steps = t.microstep_count as usize;
+        let activations = &tape.evaluation.final_activations[0];
+        let products = t
+            .candidates
+            .iter()
+            .map(|c| MotorLobeM0V1::readout_count(c.family) as u64)
+            .sum();
+        // These are the actual accumulators from the one native forward, not
+        // another telemetry-only multiplication of the fixed readout head.
+        let contributions = tape.fixed_motor_head[0].clone();
+        let receipt = MotorHostFrameReceiptV1 {
+            tick: frame.tick(),
+            frame_digest: frame.frame_digest(),
+            chemistry_version: effects.source_chemistry_version,
+            configured_microsteps: source.microstep_count(),
+            live_maturation: 0.,
+            reservation_q24: 0,
+            reservation_q16: 0,
+            available_atp_q16: 0,
+            applied_body_energy_debit: 0.,
+            candidate_logits: tape.evaluation.candidate_logits[0].clone(),
+            source_candidate_logits: tape.source_candidate_logits[0].clone(),
+            innate_contributions: t.candidates.iter().map(|c| c.innate_bias).collect(),
+            family_biases: t
+                .candidates
+                .iter()
+                .map(|c| {
+                    source
+                        .candidate_decoder()
+                        .families()
+                        .iter()
+                        .find(|f| f.family() == c.family)
+                        .map_or(0., |f| f.bias())
+                })
+                .collect(),
+            memory_contributions: tape.memory[0]
+                .iter()
+                .map(|v| v.clamp(-q.memory_candidate_gain, q.memory_candidate_gain))
+                .collect(),
+            cognitive_contributions: tape.cognitive[0]
+                .iter()
+                .map(|v| v.clamp(-q.memory_candidate_gain, q.memory_candidate_gain))
+                .collect(),
+            raw_drives: drives,
+            reference: MotorLobeM0V1::SETPOINTS,
+            interoceptive_gain: effects.interoceptive_gain,
+            regional_gain: effects.regional_excitability,
+            offset,
+            encoded_pairs: t.encoded_inputs[2048..2070].as_chunks::<2>().0.to_vec(),
+            pressure_pairs: activations[2070..2094].as_chunks::<2>().0.to_vec(),
+            appended_activations: activations[2048..].to_vec(),
+            fixed_candidate_contributions: contributions,
+            work: MotorLobeWorkV1::checked(steps as u64, 1, products)?,
+        };
+        self.activations = activations[2048..].to_vec();
+        if steps > 0 {
+            self.inactive = tape.a[steps - 1][2048..].to_vec();
+        }
+        self.ema = tape.evaluation.final_activity_ema[0][2048..].to_vec();
+        self.metabolic = tape.evaluation.final_metabolic_load[0][2048..].to_vec();
+        self.last_receipt = Some(receipt);
+        // The ordinary plasticity machinery sees only its original coordinates.
+        for bank in &mut tape.a {
+            bank.truncate(2048);
+        }
+        for bank in &mut tape.m {
+            bank.truncate(2048);
+        }
+        for bank in &mut tape.evaluation.final_activations {
+            bank.truncate(2048);
+        }
+        for bank in &mut tape.evaluation.final_activity_ema {
+            bank.truncate(2048);
+        }
+        for bank in &mut tape.evaluation.final_metabolic_load {
+            bank.truncate(2048);
+        }
+        Ok(tape)
+    }
+}
+
+/// One conversion after every term, including zero-valued fixed operations.
+pub(super) fn reserve_work(
+    source: &BrainWorkCounters,
+    source_dynamic_q24: u64,
+    appended: &MotorLobeWorkV1,
+    available_q16: u32,
+) -> Result<(u64, u32, bool), ScaffoldContractError> {
+    let cost = BrainActivityPolicyV1::grounded_drive_research_v1().cost;
+    let total = cost
+        .neural_cost_q24(source)?
+        .checked_add(source_dynamic_q24)
+        .and_then(|n| n.checked_add(appended.cost_q24().ok()?))
+        .ok_or(ScaffoldContractError::BrainActivityPolicyMismatch)?;
+    let debit = cost.q24_to_atp_q16_round_half_up(total)?;
+    Ok((total, debit, available_q16 >= debit))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn motor_host_reservation_one_unit_boundaries_and_all_cadences() {
+        for steps in [0, 1, 2, 3, 4] {
+            for products in [0, 50, 32 * 50] {
+                let source = BrainWorkCounters {
+                    microsteps: steps,
+                    neuron_updates: 2048 * u64::from(steps),
+                    ..Default::default()
+                };
+                let extra = MotorLobeWorkV1::checked(u64::from(steps), 1, products).unwrap();
+                let cost = BrainActivityPolicyV1::grounded_drive_research_v1().cost;
+                let (total, debit, _) =
+                    reserve_work(&source, 105, &extra, BRAIN_ATP_Q16_MAX).unwrap();
+                assert_eq!(
+                    total,
+                    cost.neural_cost_q24(&source).unwrap() + 105 + extra.cost_q24().unwrap()
+                );
+                assert_eq!(debit, cost.q24_to_atp_q16_round_half_up(total).unwrap());
+                assert!(reserve_work(&source, 105, &extra, debit).unwrap().2);
+                if debit > 0 {
+                    assert!(!reserve_work(&source, 105, &extra, debit - 1).unwrap().2);
+                }
+                assert!(reserve_work(&source, 105, &extra, debit + 1).unwrap().2);
+            }
+        }
+        assert!(reserve_work(
+            &BrainWorkCounters::default(),
+            u64::MAX,
+            &MotorLobeWorkV1::checked(4, 1, 50).unwrap(),
+            BRAIN_ATP_Q16_MAX
+        )
+        .is_err());
+    }
+}
diff --git a/crates/alife_training/src/cpu/motor_host_envelope.rs b/crates/alife_training/src/cpu/motor_host_envelope.rs
new file mode 100644
index 0000000000000000000000000000000000000000..473f14d3955afb20e479be7cbe79003d3ac2ec88
--- /dev/null
+++ b/crates/alife_training/src/cpu/motor_host_envelope.rs
@@ -0,0 +1,190 @@
+//! Fresh-only research envelope. There is deliberately no conversion to an
+//! ordinary host, mutable world, training batch, GPU save, or breeding API.
+use super::*;
+
+/// Composite wrapper, not a class-6 biological organism or inherited genome.
+pub struct CpuMotorLobeHostV1 {
+    host: CpuCanonicalHost,
+    founder: CpuFoundationTrainer,
+    source_inputs: PhenotypeCompilerInputs,
+    mode: MotorHostModeV1,
+}
+#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct CpuMotorLobeHostCheckpointV1 {
+    schema_version: u16,
+    policy: String,
+    mode: MotorHostModeV1,
+    source_inputs: PhenotypeCompilerInputs,
+    recipe_digest: [u64; 4],
+    source_asset: FoundationWeightAsset,
+    founder: crate::FoundationTrainerCheckpoint,
+    canonical: CpuCanonicalCheckpoint,
+    controllers: BTreeMap<u64, MotorHostStateV1>,
+}
+pub struct CpuMotorLobeHostStepV1 {
+    pub tick_before: Tick,
+    pub tick_after: Tick,
+    pub decisions: Vec<CpuMotorLobeHostDecisionV1>,
+    pub sleeping_organisms: usize,
+    pub sleep_consolidations: usize,
+}
+pub struct CpuMotorLobeHostDecisionV1 {
+    pub organism_id: OrganismId,
+    pub action: crate::PpoJointAction,
+    pub patch: ExperiencePatch,
+    pub motor: MotorHostFrameReceiptV1,
+}
+const POLICY: &str =
+    "class5-body+sealed-m0-native-composite-v1;construction-cadence;single-metabolic-debit";
+impl CpuMotorLobeHostV1 {
+    /// Admission happens at a true newborn boundary, before world-only
+    /// preparation. The callback cannot access private neural or sampling state.
+    pub fn new_prepared<T, E: std::fmt::Display>(
+        game: CanonicalNewGame,
+        founder: CpuFoundationTrainer,
+        source_inputs: PhenotypeCompilerInputs,
+        sampling_seed: u32,
+        mode: MotorHostModeV1,
+        prepare: impl FnOnce(&mut HeadlessWorld) -> Result<T, E>,
+    ) -> Result<(Self, T), CpuHostError> {
+        let motor = MotorHostStateV1::fresh(&source_inputs, mode)?;
+        motor.validate(founder.phenotype())?;
+        let (mut host, prepared) = CpuCanonicalHost::new_prepared_grounded_drive_research_cohort(
+            game,
+            &founder,
+            sampling_seed,
+            prepare,
+        )?;
+        for resident in host.residents.values_mut() {
+            if resident.neural.checkpoint()?.last_decision_tick.is_some()
+                || resident.next_sequence != 1
+            {
+                return Err(CpuHostError::State(
+                    "motor host construction cannot reset a resident",
+                ));
+            }
+            resident.motor = Some(motor.clone());
+        }
+        host.seal_all_residents()?;
+        Ok((
+            Self {
+                host,
+                founder,
+                source_inputs,
+                mode,
+            },
+            prepared,
+        ))
+    }
+    pub fn world(&self) -> &HeadlessWorld {
+        self.host.world()
+    }
+    pub fn checkpoint(&self) -> Result<CpuMotorLobeHostCheckpointV1, CpuHostError> {
+        Ok(CpuMotorLobeHostCheckpointV1 {
+            schema_version: 1,
+            policy: POLICY.into(),
+            mode: self.mode,
+            source_inputs: self.source_inputs.clone(),
+            recipe_digest: MotorLobeM0V1::recipe_digest(),
+            source_asset: self.founder.source_foundation.clone(),
+            founder: self.founder.checkpoint(),
+            canonical: self.host.checkpoint_inner(&self.founder)?,
+            controllers: self
+                .host
+                .residents
+                .iter()
+                .map(|(&id, r)| {
+                    Ok((
+                        id,
+                        r.motor
+                            .clone()
+                            .ok_or(CpuHostError::State("missing composite controller"))?,
+                    ))
+                })
+                .collect::<Result<_, CpuHostError>>()?,
+        })
+    }
+    /// Expected source and mode are explicit caller inputs. No mode-changing,
+    /// partial-state, acquired-production or detached checkpoint import exists.
+    pub fn restore(
+        checkpoint: CpuMotorLobeHostCheckpointV1,
+        expected_source: &PhenotypeCompilerInputs,
+        expected_mode: MotorHostModeV1,
+    ) -> Result<Self, CpuHostError> {
+        let wire = serde_json::to_vec(&checkpoint)?;
+        if checkpoint.schema_version != 1
+            || checkpoint.policy != POLICY
+            || checkpoint.mode != expected_mode
+            || &checkpoint.source_inputs != expected_source
+            || checkpoint.recipe_digest != MotorLobeM0V1::recipe_digest()
+        {
+            return Err(CpuHostError::State(
+                "motor composite source, mode, policy or recipe mismatch",
+            ));
+        }
+        let p = PhenotypeCompiler::compile_validated(
+            expected_source,
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+        )?;
+        let founder =
+            CpuFoundationTrainer::from_checkpoint(p, checkpoint.source_asset, checkpoint.founder)?;
+        let host = CpuCanonicalHost::from_checkpoint_inner(
+            checkpoint.canonical,
+            &founder,
+            true,
+            Some(checkpoint.controllers),
+            None,
+        )?;
+        if host.residents.values().any(|r| {
+            !r.motor
+                .as_ref()
+                .is_some_and(|m| m.matches(expected_source, expected_mode))
+        }) {
+            return Err(CpuHostError::State(
+                "resident composite mode/source differs from envelope",
+            ));
+        }
+        let result = Self {
+            host,
+            founder,
+            source_inputs: checkpoint.source_inputs,
+            mode: checkpoint.mode,
+        };
+        if serde_json::to_vec(&result.checkpoint()?)? != wire {
+            return Err(CpuHostError::State(
+                "motor composite restore would discard or reinterpret state",
+            ));
+        }
+        Ok(result)
+    }
+    pub fn step(&mut self, temperature: f32) -> Result<CpuMotorLobeHostStepV1, CpuHostError> {
+        let step = self.host.step(&self.founder, temperature)?;
+        let decisions = step
+            .decisions
+            .into_iter()
+            .map(|d| {
+                let receipt = self
+                    .host
+                    .residents
+                    .get(&d.organism_id.raw())
+                    .and_then(|r| r.motor.as_ref())
+                    .and_then(|m| m.last_receipt.clone())
+                    .ok_or(CpuHostError::State("missing motor composite receipt"))?;
+                Ok(CpuMotorLobeHostDecisionV1 {
+                    organism_id: d.organism_id,
+                    action: d.action,
+                    patch: d.patch,
+                    motor: receipt,
+                })
+            })
+            .collect::<Result<_, CpuHostError>>()?;
+        Ok(CpuMotorLobeHostStepV1 {
+            tick_before: step.tick_before,
+            tick_after: step.tick_after,
+            decisions,
+            sleeping_organisms: step.sleeping_organisms,
+            sleep_consolidations: step.sleep_consolidations,
+        })
+    }
+}
