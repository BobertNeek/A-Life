+use super::*;
+use std::sync::OnceLock;
+fn phenotype() -> BrainPhenotype {
+    static P: OnceLock<BrainPhenotype> = OnceLock::new();
+    P.get_or_init(|| {
+        let g = BrainGenome::scaffold(
+            0x2048_2026,
+            BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID,
+        );
+        let d = DevelopmentState::new(g.id, Tick::ZERO, NormalizedScalar::new(1.).unwrap());
+        let (_, i) = PhenotypeCompiler::compile_n2048_grounded_drive_basis(
+            g,
+            d,
+            SensorProfile::GroundedObjectSlotsV1,
+        )
+        .unwrap();
+        PhenotypeCompiler::compile_motor_lobe_m0(&i).unwrap().0
+    })
+    .clone()
+}
+fn evaluator(control: MotorLobeProbeControl) -> MotorLobeDetachedCpu {
+    MotorLobeDetachedCpu::fresh(phenotype(), control).unwrap()
+}
+fn candidate(family: u8, lane: usize) -> TrainingReplayCandidate {
+    let mut inputs = [0.; 54];
+    inputs[lane] = 1.;
+    TrainingReplayCandidate {
+        family: CandidateActionFamily::try_from_raw(family).unwrap(),
+        decoder_inputs: inputs,
+        innate_bias: 0.,
+    }
+}
+fn candidates() -> Vec<TrainingReplayCandidate> {
+    // Native capacity is 32; one row per family executes all 50 fixed weights.
+    (0..8).map(|f| candidate(f, 23)).collect()
+}
+fn delta(e: &MotorLobeDetachedCpu, family: u8, lane: usize) -> f32 {
+    e.phenotype.synapses()[34048..]
+        .iter()
+        .filter_map(|s| {
+            let CompiledSynapseKind::Decoder(c) = s.kind() else {
+                return None;
+            };
+            (c.family().raw() == family && usize::from(c.input_lane()) == lane)
+                .then(|| e.initial.activations[s.source() as usize] * s.genetic_weight())
+        })
+        .sum()
+}
+fn run(control: MotorLobeProbeControl, drives: [f32; 11], steps: usize) -> MotorLobeDetachedCpu {
+    let mut e = evaluator(control);
+    for _ in 0..steps / 4 {
+        e.step(
+            drives,
+            MotorLobeProbeModulation::default(),
+            &candidates(),
+            4,
+        )
+        .unwrap();
+    }
+    e
+}
+#[test]
+fn compiled_native_onset_third_for_hunger_fourth_for_recovery() {
+    let mut drives = MotorLobeM0V1::SETPOINTS;
+    drives[0] = 0.9;
+    drives[1] = 0.9;
+    let mut full = evaluator(MotorLobeProbeControl::Full);
+    let mut sham = evaluator(MotorLobeProbeControl::EqualWorkSham);
+    let cs = [candidate(6, 37), candidate(1, 23)];
+    for step in 1..=4 {
+        let a = full
+            .step(drives, MotorLobeProbeModulation::default(), &cs, 1)
+            .unwrap();
+        let b = sham
+            .step(drives, MotorLobeProbeModulation::default(), &cs, 1)
+            .unwrap();
+        assert_eq!(
+            &full.state().activations[..2048],
+            &sham.state().activations[..2048]
+        );
+        assert_eq!(a.incremental_work, b.incremental_work);
+        assert_eq!(a.incremental_work.microsteps, 1);
+        if step < 3 {
+            assert_eq!(delta(&full, 6, 37), 0.);
+        } else {
+            assert!(delta(&full, 6, 37) > 0.);
+        }
+        if step < 4 {
+            assert_eq!(delta(&full, 1, 23), 0.);
+        }
+        let observed = a.evaluation.candidate_logits[0][0] - b.evaluation.candidate_logits[0][0];
+        assert!((observed - delta(&full, 6, 37)).abs() < 2e-5);
+    }
+    // Hunger competes with recovery, so use isolated fatigue for its onset.
+    let mut drives = MotorLobeM0V1::SETPOINTS;
+    drives[1] = 0.9;
+    let mut e = evaluator(MotorLobeProbeControl::Full);
+    for step in 1..=4 {
+        e.step(drives, MotorLobeProbeModulation::default(), &cs, 1)
+            .unwrap();
+        if step < 4 {
+            assert_eq!(delta(&e, 1, 23), 0.);
+        } else {
+            assert!(delta(&e, 1, 23) > 0.);
+        }
+    }
