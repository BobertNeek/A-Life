+#[test]
+fn v2_pressure_curve_tolerance_sham_and_fatigue_separation() {
+    let (i, a) = source();
+    for p in [0., 0.1, 0.3, 0.5, 0.6, 0.7, 1.] {
+        let f = make_frame(&specs(), 0., p);
+        let r = run(&mut fresh(), &f);
+        let d = r.receipt.scores.probabilities(1.).unwrap();
+        if p <= 0.1 {
+            assert!(d.conditional_operation[0] < 0.001);
+        }
+        if p >= 0.7 {
+            assert!(d.conditional_operation[0] > 0.9);
+        }
+        if p == 0.6 {
+            assert_eq!(d.conditional_operation, [0.5; 2]);
+        }
+        assert!(d.conditional_operation.iter().all(|x| *x > 0. && *x < 1.));
+        let mut sham =
+            RecoveryGroupDetachedCpuV2::fresh(&i, &a, MediationModeV1::DriveSham).unwrap();
+        let s = run(&mut sham, &f);
+        assert_eq!(
+            s.receipt
+                .scores
+                .probabilities(1.)
+                .unwrap()
+                .conditional_operation,
+            [0.5; 2]
+        );
+    }
+    let high_f = run(&mut fresh(), &make_frame(&specs(), 1., 0.));
+    let high_p = run(&mut fresh(), &make_frame(&specs(), 0., 1.));
+    assert!(high_f.receipt.scores.operations[0] < high_f.receipt.scores.operations[1]);
+    assert!(high_p.receipt.scores.operations[0] > high_p.receipt.scores.operations[1]);
+    assert!(high_f.receipt.group_components[4] > 0.);
+    assert!(high_p.receipt.group_components[4] > 0.);
+}
