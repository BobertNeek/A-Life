+        let recipe: GroupRecipe = serde_json::from_str(GROUP_RECIPE).map_err(|_| invalid())?;
+        if recipe.operation_final_readouts != [[8., -8.]; 2]
+            || recipe.nodes.len() != 16
+            || recipe
+                .nodes
+                .iter()
+                .enumerate()
+                .any(|(i, n)| n.id != 2492 + i || n.phase != if i < 10 { 5 } else { 6 })
+        {
+            return Err(invalid());
+        }
+        let state = RecoveryGroupSnapshotV2 {
+            schema: GROUP_SCHEMA.into(),
+            recipe: RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256.into(),
+            core_json: serde_json::to_string(&core.snapshot()).map_err(|_| invalid())?,
+            activations: [0.; 16],
+            ema: [0.; 16],
+            metabolic: [0.; 16],
