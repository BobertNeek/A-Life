+        a.attention_learning_rate(),
+        a.concept_learning_rate(),
+        a.motor_learning_rate(),
+        a.structural_learning_rate(),
+    )
+    .unwrap();
+    let g = g.with_cognitive_architecture(heads).unwrap();
+    let d = DevelopmentState::new(g.id, Tick::ZERO, NormalizedScalar::new(1.).unwrap());
