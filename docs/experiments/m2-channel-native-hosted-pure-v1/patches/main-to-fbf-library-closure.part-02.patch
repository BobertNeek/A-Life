+        let core = MediationDetachedCpuV1::fresh(inputs, asset, mode)?;
+        if format!("{:x}", Sha256::digest(GROUP_RECIPE.as_bytes()))
+            != RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256
