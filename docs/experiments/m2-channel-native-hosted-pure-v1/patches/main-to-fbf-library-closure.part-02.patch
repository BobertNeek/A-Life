+    /// Derivatives of ordinary scores; recovery slots are zero here.
+    pub ordinary_decoder_derivatives: Vec<Vec<f32>>,
+    pub group_decoder_derivatives: Vec<f32>,
+    pub operation_decoder_derivatives: [Vec<f32>; 2],
