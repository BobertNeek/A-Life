+fn source_with_heads(head_count: u8) -> (PhenotypeCompilerInputs, FoundationWeightAsset) {
+    let g = BrainGenome::scaffold(
+        0x4752_5031,
+        BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID,
+    );
+    let a = g.cognitive_architecture();
+    let heads = alife_core::genome::CognitiveArchitectureGenomeParameters::try_new_v1(
