+            threshold: 4.,
+            ..neutral()
+        },
+        MediationModulationV1 {
+            interoceptive_gain: 0.,
+            ..neutral()
+        },
+        MediationModulationV1 {
+            projection_gain: 0.,
+            ..neutral()
+        },
+    ] {
+        let base = refs();
+        let r = synthetic(&[], &[], base, m);
+        assert_eq!(r.signed_opponents, vec![0.; 12]);
+        assert_eq!(r.positive_opponents, vec![0.; 12]);
+        for axis in 0..12 {
+            for delta in [-0.08, 0.08] {
+                let mut drives = base;
+                drives[axis] = (base[axis] + delta).clamp(0., 1.);
+                let r = synthetic(&[], &[], drives, m);
+                let polarity = if axis == 6 { -1. } else { 1. };
+                let raw = 4.
+                    * m.interoceptive_gain
+                    * m.regional_gain
+                    * (drives[axis] - base[axis])
+                    * polarity;
+                close(
+                    r.signed_opponents[axis],
+                    m.projection_gain * raw.tanh(),
+                    1e-5,
+                );
+                close(
+                    r.positive_opponents[axis],
+                    m.projection_gain * raw.max(0.).tanh(),
+                    1e-5,
+                );
+            }
+        }
+    }
