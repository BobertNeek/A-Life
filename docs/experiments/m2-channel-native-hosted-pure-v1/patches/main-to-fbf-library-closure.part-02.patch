+    pub fn waking_outcome_plasticity(&mut self) -> Result<(), TrainingError> {
+        Err(invalid())
+    }
+    /// Frozen-context input executes the REAL source prefix once and four native
+    /// partitions. Not a world life. Forward arithmetic reservation excludes
+    /// diagnostic Jacobians/credit, staging, validation and bookkeeping and is
+    /// NOT a qualified host ATP bill. Nothing writes biological state.
+    pub fn step(
+        &mut self,
+        frame: &PerceptionFrame,
+        tick: TrainingReplayTick,
+        rows: &[MediationRowV1],
+        modulation: MediationModulationV1,
+        available_arithmetic_q24: u64,
+    ) -> Result<MediationProbeResultV1, TrainingError> {
+        modulation.validate()?;
+        if tick.microstep_count == 0
+            || rows.len() != tick.candidates.len()
+            || rows.len() != frame.candidates().len()
+            || rows.len() > SLOTS
+            || tick.projection_gain.to_bits() != modulation.projection_gain.to_bits()
+            || tick.local_threshold_shift.to_bits() != modulation.threshold.to_bits()
+            || tick.effective_weight_offsets.iter().any(|x| *x != 0.)
+            || !tick.structural_synapses.is_empty()
+        {
+            return Err(invalid());
+        }
+        for (i, (row, c)) in rows.iter().zip(&tick.candidates).enumerate() {
+            let physical = &frame.candidates()[i];
+            let family = self
+                .source
+                .candidate_decoder()
+                .families()
+                .iter()
+                .find(|f| f.family() == c.family)
+                .ok_or_else(invalid)?;
+            if c.innate_bias.to_bits()
+                != family
+                    .innate_contribution(frame.homeostasis().drives, physical.features)
+                    .to_bits()
+            {
+                return Err(invalid());
+            }
+
+            row.validate(
+                frame,
+                i,
+                c,
+                self.state.generation,
+                self.source.phenotype_hash(),
+            )?;
+        }
+        let q = TrainingSequence {
+            phenotype_hash: self.source.phenotype_hash(),
+            initial: self.state.source.clone(),
+            ticks: vec![tick],
+            burn_in_ticks: 0,
+            memory_candidate_gain: self
+                .source
+                .candidate_decoder()
+                .memory_channel()
+                .map_or(0., |p| p.max_candidate_gain()),
+        };
+        q.validate_for(&self.source)?;
+        let t = &q.ticks[0];
+        let generation = self.state.generation.checked_add(1).ok_or_else(invalid)?;
+        let reservation = self.arithmetic_cost(t)?;
+        if available_arithmetic_q24 < reservation {
+            return Err(invalid());
+        }
+        let mut drives = [0.; 12];
+        drives[..11].copy_from_slice(&frame.homeostasis().drives.to_array());
+        drives[11] = frame.homeostasis().hormones.to_array()[8];
+        if drives
+            .iter()
+            .any(|x| !x.is_finite() || !(0. ..=1.).contains(x))
+        {
+            return Err(invalid());
+        }
+        let tape = self
+            .graph
+            .forward_mediation_source(&self.source, &self.weights, &q)?;
+        let mut components: Vec<[f32; 5]> = t
+            .candidates
+            .iter()
+            .enumerate()
+            .map(|(i, c)| {
+                [
+                    tape.mediation_source[0][i],
+                    c.innate_bias,
+                    tape.memory[0][i].clamp(-q.memory_candidate_gain, q.memory_candidate_gain),
+                    tape.cognitive[0][i].clamp(-q.memory_candidate_gain, q.memory_candidate_gain),
+                    0.,
+                ]
+            })
+            .collect();
+        let upstream = (0..rows.len())
+            .map(|i| {
+                [
+                    clip_slope(tape.memory[0][i], q.memory_candidate_gain),
+                    clip_slope(tape.cognitive[0][i], q.memory_candidate_gain),
+                ]
+            })
+            .collect();
+        let mut next = self.state.clone();
+        let mut receipt = run_partitions(
+            &self.recipe,
+            &mut next,
+            &mut components,
+            &t.candidates,
+            drives,
+            self.pressure_reference,
+            modulation,
+        )?;
+        receipt.schema = SCHEMA.into();
+        receipt.recipe = M2_RECIPE_SHA256.into();
+        receipt.source_hash = self.source.phenotype_hash();
+        receipt.source_generation = self.state.generation;
+        receipt.final_generation = generation;
+        receipt.rows = rows.to_vec();
+        receipt.direct_source_logits = tape.evaluation.candidate_logits[0].clone();
+        receipt.upstream_context_slopes = upstream;
+        receipt.output_logits = if self.state.mode == MediationModeV1::DirectSource {
+            receipt.direct_source_logits.clone()
+        } else {
+            receipt.core_logits.clone()
+        };
+        receipt.detached_arithmetic_reservation_q24 = reservation;
+        receipt.source_execution_count = 1;
+        let eligibility = projected_credit(
+            &self.source,
+            t,
+            &tape.evaluation.final_activations[0],
+            &receipt,
+        )?;
+        next.source
+            .activations
+            .clone_from(&tape.evaluation.final_activations[0]);
+        next.source
+            .activity_ema
+            .clone_from(&tape.evaluation.final_activity_ema[0]);
+        next.source
+            .metabolic_load
+            .clone_from(&tape.evaluation.final_metabolic_load[0]);
+        next.generation = generation;
+        self.state = next;
+        Ok(MediationProbeResultV1 {
+            source_evaluation: tape.evaluation,
+            receipt,
+            projected_core_decoder_derivatives: eligibility,
+        })
+    }
+    fn arithmetic_cost(&self, t: &TrainingReplayTick) -> Result<u64, TrainingError> {
+        let steps = u64::from(t.microstep_count);
+        let decoder_products:u64=t.candidates.iter().map(|c|self.source.synapses().iter().filter(|s|matches!(s.kind(),CompiledSynapseKind::Decoder(d) if d.head()!=DecoderHeadKind::SpeechPayload&&d.family()==c.family)).count() as u64).sum();
+        let recurrent_products: u64 = (0..t.microstep_count as usize)
+            .map(|step| {
+                self.source
+                    .synapses()
+                    .iter()
+                    .filter(|s| {
+                        s.kind() == CompiledSynapseKind::Recurrent
+                            && t.enabled_routes[s.route_index() as usize]
+                            && super::replay::route_fires(
+                                self.source.projections()[s.route_index() as usize]
+                                    .update_cadence()
+                                    .raw(),
+                                step,
+                            )
+                    })
+                    .count() as u64
+            })
+            .sum();
+        let source = steps
+            .checked_mul(START as u64 * 32 + 64 * 16 + 128 * 4)
+            .and_then(|v| v.checked_add((recurrent_products + decoder_products) * 4))
+            .and_then(|v| {
+                v.checked_add(self.source.sensor_encoder().assignments().len() as u64 * 4)
+            })
+            .ok_or_else(invalid)?;
+        source
+            .checked_add(MediationWorkV1::expected().cost_q24()?)
+            .ok_or_else(invalid)
+    }
+}
+fn clip_slope(x: f32, bound: f32) -> f32 {
+    f32::from(x > -bound && x < bound)
+}
+fn cue(row: &DriveRow, c: &TrainingReplayCandidate) -> f32 {
+    if row.family != c.family {
+        return 0.;
+    }
+    match row.cue.as_str() {
+        "constant" => 1.,
+        "object_present" => c.decoder_inputs[36],
+        "positive_contact_chemical" => c.decoder_inputs[37],
+        "observed_thermal_excess" => c.decoder_inputs[39] + c.decoder_inputs[40],
+        "observed_agent_present" => c.decoder_inputs[41],
+        "grounded_vocal" => c.decoder_inputs[42],
+        _ => unreachable!("pinned recipe cue"),
+    }
+}
+fn run_partitions(
+    recipe: &Lowered,
+    state: &mut MediationDetachedSnapshotV1,
+    components: &mut [[f32; 5]],
+    candidates: &[TrainingReplayCandidate],
+    drives: [f32; 12],
+    pressure_reference: f32,
+    m: MediationModulationV1,
+) -> Result<MediationReceiptV1, TrainingError> {
+    run_partition_banks(
+        recipe,
+        state.mode,
+        state.source_hash,
+        &mut state.activations,
+        &mut state.ema,
+        &mut state.metabolic,
+        components,
+        candidates,
+        drives,
+        pressure_reference,
+        m,
+    )
+}
+/// Shared arithmetic only. The host borrows separate appendage banks and never
+/// instantiates a detached source owner or freshens the organism's source state.
+#[allow(clippy::too_many_arguments)]
+fn run_partition_banks(
+    recipe: &Lowered,
+    mode: MediationModeV1,
+    source_hash: PhenotypeHash,
+    activations: &mut [f32],
+    ema: &mut [f32],
+    metabolic: &mut [f32],
+    components: &mut [[f32; 5]],
+    candidates: &[TrainingReplayCandidate],
+    drives: [f32; 12],
+    pressure_reference: f32,
+    m: MediationModulationV1,
+) -> Result<MediationReceiptV1, TrainingError> {
+    if components.len() != candidates.len() || candidates.len() > SLOTS {
+        return Err(invalid());
+    }
+    for component in components.iter() {
+        finite(component)?;
+    }
+    let mut refs = [0.; 12];
+    refs[..11].copy_from_slice(&REFERENCES);
+    refs[11] = pressure_reference;
+    let mut encoded = vec![m.offset; ADDED];
+    let mut work = MediationWorkV1::default();
+    let mut pairs = vec![[[0.; 2]; 5]; components.len()];
+    let mut clip = vec![[[0.; 2]; 5]; components.len()];
+    for phase in 1..=4 {
+        work.phases += 1;
+        if phase == 1 {
+            for axis in 0..12 {
+                let raw = if mode == MediationModeV1::DriveSham {
+                    refs[axis]
+                } else {
+                    drives[axis]
+                };
+                encoded[axis * 5] = raw * m.interoceptive_gain * m.regional_gain + m.offset;
+                encoded[axis * 5 + 1] =
+                    refs[axis] * m.interoceptive_gain * m.regional_gain + m.offset;
+            }
+        }
+        if phase == 3 {
+            for slot in 0..SLOTS {
+                let mut d = 0.;
+                for r in &recipe.manifest.drive_proposal_readouts {
+                    let input = candidates.get(slot).map_or(0., |c| cue(r, c));
+                    d += activations[r.source - START] * (input * r.weight);
+                    work.drive_products += 1;
+                }
+                if slot < components.len() {
+                    components[slot][4] = d;
+                }
+            }
+            for slot in 0..SLOTS {
+                for port in 0..5 {
+                    let x = components.get(slot).map_or(0., |c| c[port]);
+                    for (side, sign) in [(0, 1.), (1, -1.)] {
+                        let affine = sign * x / DIVISORS[port];
+                        encoded[PORT_BASE + slot * 12 + port * 2 + side] =
+                            affine.clamp(-8., 8.) + m.offset;
+                        if slot < components.len() {
+                            clip[slot][port][side] = clip_slope(affine, 8.);
+                        }
+                    }
+                }
+            }
+        }
+        let previous = activations.to_vec();
+        for node in recipe
+            .manifest
+            .nodes
+            .iter()
+            .filter(|node| node.phase == phase)
+        {
+            let target = node.id - START;
+            let mut recurrent = 0.;
+            let mut dendritic = 0.;
+            for edge in recipe
+                .manifest
+                .recurrent_edges
+                .iter()
+                .filter(|e| e.target == node.id)
+            {
+                recurrent += previous[edge.source - START] * edge.weight;
+                work.recurrent_products += 1;
+            }
+            for b in &recipe.branches.branches()[recipe.branches.target_span(target as u32)] {
+                dendritic += native_kernel::dendritic_activation(&previous, b);
+                work.branches += 1;
+                work.branch_inputs += b.inputs.len() as u64;
+            }
+            let result = native_kernel::neuron_step(
+                &node.dynamics,
+                CellState {
+                    activation: previous[target],
+                    ema: ema[target],
+                    metabolic: metabolic[target],
+                },
+                encoded[target],
+                recurrent,
+                dendritic,
+                m.projection_gain,
+                m.threshold,
+            );
+            activations[target] = result.state.activation;
+            ema[target] = result.state.ema;
+            metabolic[target] = result.state.metabolic;
+            work.neuron_updates += 1;
+            work.assignments += 1;
+        }
+    }
+    finite(activations)?;
+    finite(ema)?;
+    finite(metabolic)?;
+    let mut logits = [0.; SLOTS];
+    for r in &recipe.manifest.final_readouts {
+        logits[r.candidate_slot] += activations[r.source - START] * r.weight;
+        work.final_products += 1;
+    }
+    if work != MediationWorkV1::expected() {
+        return Err(invalid());
+    }
+    let mut jacobians = vec![[0.; 5]; components.len()];
+    for slot in 0..components.len() {
+        let base = PORT_BASE + slot * 12;
+        let a = activations[base + 10];
+        let b = activations[base + 11];
+        let final_slope = 2. * m.projection_gain * ((1. - a * a).max(0.) + (1. - b * b).max(0.));
+        for port in 0..5 {
+            let plus = activations[base + port * 2];
+            let minus = activations[base + port * 2 + 1];
+            pairs[slot][port] = [plus, minus];
+            let port_slope = ((1. - plus * plus).max(0.) * clip[slot][port][0]
+                + (1. - minus * minus).max(0.) * clip[slot][port][1])
+                / (2. * DIVISORS[port]);
+            jacobians[slot][port] = final_slope * BOUND_WEIGHTS[port] * port_slope;
+        }
+    }
+    let signed = (0..12)
+        .map(|i| activations[i * 5 + 2] - activations[i * 5 + 3])
+        .collect();
+    let positive = (0..12)
+        .map(|i| activations[i * 5 + 2] - activations[i * 5 + 4])
+        .collect();
+    Ok(MediationReceiptV1 {
+        schema: String::new(),
+        recipe: String::new(),
+        source_hash,
+        source_generation: 0,
+        final_generation: 0,
+        rows: vec![],
+        mode,
+        direct_source_logits: vec![],
+        components: components.to_vec(),
+        port_activations: pairs,
+        port_clip_slopes: clip,
+        jacobians,
+        upstream_context_slopes: vec![],
+        core_logits: logits[..components.len()].to_vec(),
+        output_logits: vec![],
+        appended_activations: activations.to_vec(),
+        signed_opponents: signed,
+        positive_opponents: positive,
+        work,
+        detached_arithmetic_reservation_q24: 0,
+        source_execution_count: 0,
+        modulation: m,
+        raw_drives: drives,
+        references: refs,
+    })
+}
+fn projected_credit(
+    p: &BrainPhenotype,
+    t: &TrainingReplayTick,
+    activation: &[f32],
+    receipt: &MediationReceiptV1,
+) -> Result<Vec<Vec<f32>>, TrainingError> {
+    let mut result = vec![vec![0.; p.synapses().len()]; t.candidates.len()];
+    for (i, c) in t.candidates.iter().enumerate() {
+        for (j, s) in p.synapses().iter().enumerate() {
+            let CompiledSynapseKind::Decoder(d) = s.kind() else {
+                continue;
+            };
+            if d.family() != c.family {
+                continue;
+            }
+            let input = c
+                .decoder_inputs
+                .get(d.input_lane() as usize)
+                .copied()
+                .unwrap_or(0.);
+            let factor = match d.head() {
+                DecoderHeadKind::ActionCandidate => {
+                    receipt.jacobians[i][0] * activation[s.source() as usize]
+                }
+                DecoderHeadKind::MemoryContext => {
+                    receipt.jacobians[i][2] * receipt.upstream_context_slopes[i][0]
+                }
+                DecoderHeadKind::CognitiveContext => {
+                    receipt.jacobians[i][3] * receipt.upstream_context_slopes[i][1]
+                }
+                _ => 0.,
+            };
+            result[i][j] = input * factor;
+        }
+        finite(&result[i])?;
+    }
+    Ok(result)
+}
