+// This is actuator/controller persistence, not a complete host decision. The
+// real world receipt supplied below has no fabricated neural selection or replay
+// proof. Whole-host acquired-state continuation is tested separately above.
+#[derive(Clone, serde::Serialize, serde::Deserialize)]
+struct SleepActuatorComponents {
+    body: BiochemistryState,
+    sleep: SleepController,
+    controller: SleepChoiceResidentV1,
+    neural: CpuOrganismCheckpoint,
+    consolidation_count: u32,
+}
+fn advance_sleep_actuator_components(
+    value: &mut SleepActuatorComponents,
+    founder: &CpuFoundationTrainer,
+    phenotype: &CreaturePhenotype,
+) {
+    let tick = Tick(value.body.tick.raw() + 1);
+    value.sleep.advance(tick).unwrap();
+    if value.sleep.state().phase == SleepPhase::Consolidating
+        && matches!(value.sleep.state().consolidation, ConsolidationState::None)
+    {
+        // Real empty-replay neural consolidation, exactly the host's no-event
+        // branch. No memory observation, proof, reward or optimizer credit is
+        // invented for this manually supplied physical operation.
+        let evidence = replay_evidence(founder.phenotype(), &[]).unwrap();
+        let mut neural =
+            CpuOrganismState::from_checkpoint(founder.phenotype(), value.neural.clone()).unwrap();
+        neural
+            .consolidate_sleep(
+                founder,
+                &evidence,
+                &phenotype.development_state_at(tick).unwrap(),
+                phenotype.brain_genome.plasticity_parameters(),
+            )
+            .unwrap();
+        value.neural = neural.checkpoint().unwrap();
+        let mut state = value.sleep.state();
+        state.consolidation = ConsolidationState::Committed {
+            cycle_id: state.active_cycle_id,
+            output_generation: value.neural.weight_generation,
+            output_digest: json_digest(b"ALIFE-CPU-SLEEP-OUTPUT-V1", &value.neural).unwrap(),
+        };
+        value.sleep = SleepController::restore(value.sleep.config(), state).unwrap();
+        value.consolidation_count += 1;
+    }
+    value.body = value
+        .body
+        .advance_with_neural_emission(
+            tick,
+            tick,
+            BodyEventDelta {
+                sleep_recovery: if value.sleep.state().phase == SleepPhase::Awake {
+                    0.
+                } else {
+                    1.
+                },
+                ..BodyEventDelta::zero()
+            },
+            None,
+            phenotype,
+        )
+        .unwrap();
+}
+fn verify_sleep_actuator_component_restore(
+    founder: &CpuFoundationTrainer,
+    phenotype: &CreaturePhenotype,
+    initial: SleepActuatorComponents,
+    frame: &PerceptionFrame,
+    bundle: &MotorCommandBundle,
+    physical: &SleepChoiceWorldReceiptV1,
+) {
+    let mut warm = initial;
+    assert!(warm.body.body.sleeping);
+    assert_eq!(warm.sleep.state().phase, SleepPhase::EnteringSleep);
+    let mut cold: SleepActuatorComponents =
+        serde_json::from_slice(&serde_json::to_vec(&warm).unwrap()).unwrap();
+    let mut committed = false;
+    let mut waking = false;
+    for _ in 0..12 {
+        advance_sleep_actuator_components(&mut warm, founder, phenotype);
+        advance_sleep_actuator_components(&mut cold, founder, phenotype);
+        let bytes = serde_json::to_vec(&warm).unwrap();
+        assert_eq!(bytes, serde_json::to_vec(&cold).unwrap());
+        cold = serde_json::from_slice(&bytes).unwrap();
+        cold.sleep = SleepController::restore(cold.sleep.config(), cold.sleep.state()).unwrap();
+        cold.controller.motor.validate(founder.phenotype()).unwrap();
+        cold.controller.validate_replay(&[]).unwrap();
+        committed |= matches!(
+            warm.sleep.state().consolidation,
+            ConsolidationState::Committed { .. }
+        );
+        waking |= warm.sleep.state().phase == SleepPhase::Waking;
+        if warm.sleep.state().phase == SleepPhase::Awake {
+            break;
+        }
+    }
+    assert!(committed && waking);
+    assert_eq!(warm.sleep.state().phase, SleepPhase::Awake);
+    assert_eq!(warm.sleep.state().cycles_completed, 1);
+    assert_eq!(warm.consolidation_count, 1);
+    assert!(!warm.body.body.sleeping);
+    assert!(cold
+        .controller
+        .observe_physical(frame, bundle, physical, &mut cold.sleep)
+        .is_err());
+    assert_eq!(warm.sleep.state(), cold.sleep.state());
+    eprintln!("M1_ACTUATOR_COMPONENT_RESTORE entering/committed/waking/awake byte-exact; one empty-replay consolidation; duplicate receipt rejected; not a complete-host voluntary cycle or learned choice");
+}
