+#[cfg(test)]
+impl ChannelScores {
+    /// Exact controlled-physics fixture, never an autonomous sampled action.
+    /// Every physical selection must belong to the real bound frame/support.
+    pub(in crate::cpu) fn controlled_physics_fixture(&self,play:bool,seed:u32,counter:u32,t:f64)->Result<BundleAction,TrainingError> {
+        self.validate()?;
+        let d=self.distribution(t)?;
+        let find=|id:u32,slot:usize|->Result<u16,TrainingError>{
+            let matches=self.input.native_binding.identities.iter().enumerate().filter_map(|(i,identity)|{
+                let row:(ActionId,ActionTarget,ActionKind,CandidateActionFamily)=serde_json::from_str(identity).ok()?;
+                (row.0.raw()==id && self.input.eligible_mask&(1<<i)!=0 && self.input.native_binding.forced[i]==Some(slot)).then_some(i as u16)
+            }).collect::<Vec<_>>();
+            if matches.len()!=1 {return Err(invalid());} Ok(matches[0])
+        };
+        let mut motors=[Choice::NoOp;6];
+        motors[0]=Choice::Candidate(find(103,0)?); // genuine NoLocomotion
+        if d.channels[1].choices!=vec![Choice::NoOp] {motors[1]=Choice::Candidate(find(606,1)?);}
+        motors[2]=Choice::Candidate(find(if play{213}else{212},2)?);
+        motors[3]=if self.input.native_binding.enabled[3] {Choice::Quiet}else{Choice::NoOp};
+        motors[4]=Choice::Rest;
+        let operation=Some(1); // actual supported AwakeRest, never BodySleep
+        let e=self.evaluate_selection(motors,operation,t)?;
+        let action=BundleAction {domain:"channel-native-controlled-physics-action-v1".into(),
+            policy:"channel-native-controlled-physics-v1;not-autonomous;actor-credit-forbidden".into(),
+            owner_domain:"channel-native-controlled-physics-fixture-owner-v1".into(),
+            motors,operation,metadata_candidate:self.compatibility_metadata(&e.physical)?,log_probability_bits:0_f64.to_bits(),
+            proof:DrawProof {domain:"channel-native-controlled-physics-proof-v1;no-rng-draw".into(),
+                scores_digest:hash(SCORE_DOMAIN,self)?,seed,counter,temperature_bits:t.to_bits(),factors:vec![]},
+            controlled_physics:Some(play)};
+        Ok(action)
+    }
