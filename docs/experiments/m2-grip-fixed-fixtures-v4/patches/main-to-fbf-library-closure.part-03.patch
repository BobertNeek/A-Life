+#[test]
+fn sleep_choice_fixture_natural_pressure_reference_exceeds_default_lifetime() {
+    let (host, _) = fixture();
+    let record = host.world().organism_registry().iter().next().unwrap();
+    let phenotype = record.phenotype();
+    let graph = &phenotype.chemistry.biochemical;
+    let pressure_id = ChemicalSpeciesId(18);
+    let pressure = graph
+        .species()
+        .iter()
+        .find(|s| s.id == pressure_id)
+        .unwrap();
+    let positive: Vec<_> = graph
+        .emitters()
+        .iter()
+        .filter(|e| e.target == pressure_id && e.gain > 0.)
+        .collect();
+    assert_eq!(positive.len(), 1);
+    let awake = positive[0];
+    assert_eq!(awake.source, BiochemicalSourceLocus::Awake);
+    assert_eq!(awake.response, EmitterResponse::Analogue);
+    assert!(!awake.inverted);
+    assert_eq!(awake.threshold, 0.);
+    assert_eq!(awake.cadence_ticks, 1);
+    assert_eq!(pressure.minimum, 0.);
+    assert_eq!(
+        graph
+            .neuroemitters()
+            .iter()
+            .filter(|e| e.target == pressure_id)
+            .count(),
+        0
+    );
+    assert!(graph.reactions().iter().all(|r| r
+        .products
+        .iter()
+        .chain(&r.reactants)
+        .all(|t| t.species != pressure_id)));
+    assert_eq!(
+        phenotype
+            .development_state_at(Tick::ZERO)
+            .unwrap()
+            .maturation
+            .raw(),
+        0.
+    );
+    assert_eq!(record.biochemistry().development.biochemical_expression, 1.);
+    assert!(!host.world().age_death_disabled());
+    let retention = f64::from(pressure.decay_retention);
+    let equilibrium = f64::from(pressure.baseline) + f64::from(awake.gain) / (1. - retention);
+    let lifespan = PassiveBodyUpkeepPolicy::maximum_lifespan_ticks(phenotype);
+    let reference = f64::from(
+        host.founder
+            .phenotype()
+            .cognitive_architecture()
+            .sleep_trigger_threshold(),
+    );
+    // Optimistically grant full expression from birth. Actual maturation, rest,
+    // or earlier metabolic death can only reduce this uninterrupted-awake bound.
+    let upper_at_age_death = equilibrium * (1. - retention.powf(lifespan as f64));
+    let earliest_optimistic_crossing =
+        ((1. - reference / equilibrium).ln() / retention.ln()).ceil() as u64;
+    assert!(upper_at_age_death < reference);
+    assert!(earliest_optimistic_crossing > lifespan);
+    // Prospective lower bound for the separate age-disabled fixture: discard all
+    // accumulation before the known full-expression update240. Do not choose a
+    // preparation length from sampled biology or a neural outcome.
+    let lower_at_10000 = equilibrium * (1. - retention.powf((10_000 - 240) as f64));
+    assert!(lower_at_10000 > reference);
+    eprintln!("M1_PRESSURE_TIMESCALE baseline={} retention={} awake_gain={} age_death_tick={} optimistic_pressure_at_death={} reference={} earliest_optimistic_crossing={} controlled_10000_lower_bound={}; unchanged default life cannot meet the high-pressure preparation condition",
+        pressure.baseline, pressure.decay_retention, awake.gain, lifespan, upper_at_age_death,
+        reference, earliest_optimistic_crossing, lower_at_10000);
+}
