+        if posture == 700 {
+            control_bundle.channels[0].primitive = HeadlessActionIds::NO_POSTURE;
+        }
+        let own = control
+            .organism_registry
+            .get(OrganismId(1))
+            .unwrap()
+            .world_entity_id();
+        let neural = NeuralEmissionFrame::new(world.tick(), 1, vec![]).unwrap();
+        let ordinary = control
+            .apply_registered_motor_bundle_with_perceived_novelty_in_staged_tick(
+                &control_bundle,
+                own,
+                &neural,
+                0.0,
+                &[],
+            )
+            .unwrap();
+        let receipt = world
+            .apply_sleep_choice_motor_bundle_in_staged_tick(&request, &neural, 0.0, &[])
+            .unwrap();
+        assert!(!receipt.motor.succeeded, "empty vocal really failed");
+        assert_eq!(
+            receipt
+                .motor
+                .channel_receipts
+                .iter()
+                .find(|c| c.command.channel == MotorChannel::Vocal)
+                .unwrap()
+                .phase,
+            ActionPhase::Attempt
+        );
+        assert_eq!(
+            receipt
+                .motor
+                .channel_receipts
+                .iter()
+                .find(|c| c.command.channel == MotorChannel::Posture)
+                .unwrap()
+                .phase,
+            ActionPhase::Completed
+        );
+        assert_eq!(receipt.actual_displacement, Vec3f::ZERO);
+        assert_eq!(
+            receipt.motor.body_event, ordinary.body_event,
+            "retain the entire ordinary interval and costs"
+        );
+        if posture == 3 {
+            assert_eq!(
+                receipt.motor, ordinary,
+                "M1 BodySleep must not rewrite legacy Rest physiology"
+            );
