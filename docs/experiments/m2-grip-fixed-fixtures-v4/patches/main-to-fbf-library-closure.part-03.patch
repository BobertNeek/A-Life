+#[test]
+fn full_expression_m1_actions_separate_fatigue_from_sleep_pressure() {
+    // A fixed physical mechanism fixture, not a policy evaluation or selection.
+    let mut initial = fresh();
+    while initial.tick().raw() < 240 {
+        initial.try_advance_tick().unwrap();
+    }
+    let before = initial.organism_registry.get(OrganismId(1)).unwrap();
+    let graph = &before.phenotype().chemistry.biochemical;
+    let mut wire = serde_json::to_value(before.biochemistry()).unwrap();
+    for target in [
+        BiochemicalTargetLocus::Drive(BiochemicalDriveChannel::Fatigue),
+        BiochemicalTargetLocus::Endocrine(EndocrineChannel::SleepPressure),
+    ] {
+        let species = graph
+            .receptors()
+            .iter()
+            .find(|r| r.target == target)
+            .unwrap()
+            .source;
+        let index = graph
+            .species()
+            .iter()
+            .position(|s| s.id == species)
+            .unwrap();
+        wire["graph_state"]["concentrations"][index] = serde_json::json!(0.65);
+    }
+    let mut biology: BiochemistryState = serde_json::from_value(wire).unwrap();
+    biology.homeostasis = biology.graph_state().derive_homeostasis(graph).unwrap();
+    biology.validate_against(before.phenotype()).unwrap();
+    initial
+        .organism_registry
+        .with_biology_mut(OrganismId(1), |value| {
+            *value = biology;
+            Ok(())
+        })
+        .unwrap();
+    let before = initial
+        .organism_registry
+        .get(OrganismId(1))
+        .unwrap()
+        .clone();
+    assert_eq!(
+        before.biochemistry().development.biochemical_expression,
+        1.0
+    );
+    let neural = NeuralEmissionFrame::new(
+        initial.tick(),
+        1,
+        vec![NeuralEmission::new(NeuralEmissionClass::ExecutiveSustain, 0.9, 0.9).unwrap()],
+    )
+    .unwrap();
+    let mut results = Vec::new();
+    for posture in [700, 3, 104] {
+        let mut world = initial.clone();
+        let bundle = bundle(&world, posture);
+        let request = request(&mut world, &bundle);
+        let receipt = world
+            .apply_sleep_choice_motor_bundle_in_staged_tick(&request, &neural, 0.0, &[])
+            .unwrap();
+        let expected = before
+            .biochemistry()
+            .advance_with_body_research_events_v1(
+                Tick(241),
+                Tick(241),
+                receipt.motor.body_event,
+                Some(&neural),
+                before.phenotype(),
+                ThermalBalanceCandidate::default(),
+                AwakeRestEventV1::new(receipt.awake_dose).unwrap(),
+            )
+            .unwrap();
+        assert_eq!(
+            receipt.motor.biology_after, expected,
+            "one body interval and one neural emission for {posture}"
+        );
+        assert_eq!(world.try_advance_tick().unwrap(), Tick(241));
+        let after = world.organism_registry.get(OrganismId(1)).unwrap();
+        assert_eq!(
+            *after.biochemistry(),
+            expected,
+            "outer tick must not advance biology again"
+        );
+        assert_eq!(after.cognitive_work(), before.cognitive_work());
+        assert_eq!(after.state_graph().brain, before.state_graph().brain);
+        assert_eq!(after.state_graph().memory, before.state_graph().memory);
+        assert_eq!(after.genome(), before.genome());
+        assert_eq!(after.phenotype(), before.phenotype());
+        assert_eq!(after.sleep_phase(), SleepPhase::Awake);
+        results.push(receipt);
+    }
+    let (awake, sleep, neutral) = (&results[0], &results[1], &results[2]);
+    assert!(awake.awake_dose > 0.0);
+    assert!(
+        awake.motor.biology_after.homeostasis.drives.fatigue
+            < neutral.motor.biology_after.homeostasis.drives.fatigue
+    );
+    assert_eq!(
+        awake
+            .motor
+            .biology_after
+            .homeostasis
+            .hormones
+            .sleep_pressure,
+        neutral
+            .motor
+            .biology_after
+            .homeostasis
+            .hormones
+            .sleep_pressure
+    );
+    assert!(
+        sleep.motor.biology_after.homeostasis.drives.fatigue
+            < neutral.motor.biology_after.homeostasis.drives.fatigue
+    );
+    assert!(
+        sleep
+            .motor
+            .biology_after
+            .homeostasis
+            .hormones
+            .sleep_pressure
+            < neutral
+                .motor
+                .biology_after
+                .homeostasis
+                .hormones
+                .sleep_pressure
+    );
+    assert!(!awake.motor.biology_after.body.sleeping);
+    assert!(sleep.motor.biology_after.body.sleeping);
+    assert!(sleep.successful_stationary_body_sleep);
+    assert_eq!(
+        awake.motor.biology_after.body,
+        neutral.motor.biology_after.body
+    );
+    assert_eq!(
+        awake.motor.biology_after.homeostasis.drives.brain_atp,
+        neutral.motor.biology_after.homeostasis.drives.brain_atp
+    );
+    for receipt in results {
+        assert_eq!(receipt.motor.body_event.energy, 0.0);
+        assert!(receipt.motor.biology_after.body.energy <= before.biochemistry().body.energy);
+    }
+}
