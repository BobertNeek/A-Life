+        SleepChoiceMotorModeV1::Full,
+    )
+    .unwrap();
+    let mut saw_entry = false;
+    let mut saw_committed = false;
+    let mut saw_waking = false;
+    let mut saw_later_decision = false;
+    let mut entry_sequence = 0;
+    // One declared fixed fixture and horizon. Ordinary logits, candidates,
+    // random draws and the first frame are untouched; no seed search or settling.
+    for _ in 0..32 {
+        let step = host.step(1.).unwrap();
+        for decision in &step.decisions {
+            eprintln!("M1_PHASE_DECISION source_tick={} actual_microsteps={} operation={:?} awake_dose={} sleep_dose={} memory={:?}",
+                decision.motor.tick.raw(), decision.motor.work.microsteps,
+                decision.physical.operation, decision.physical.awake_recovery,
+                decision.physical.sleep_recovery, decision.motor.memory_contributions);
+        }
+        cold.step(1.).unwrap();
+        assert_eq!(
+            host.checkpoint().unwrap().encode().unwrap(),
+            cold.checkpoint().unwrap().encode().unwrap()
+        );
+        let resident = host.host.residents.values().next().unwrap();
+        let state = resident.sleep.state();
+        if state.last_trigger == Some(SleepTrigger::VoluntaryBodySleepV1) {
+            if state.phase == SleepPhase::EnteringSleep {
+                if !saw_entry {
+                    entry_sequence = resident.next_sequence - 1;
+                }
+                saw_entry = true;
+                assert!(resident
+                    .sleep_choice
+                    .as_ref()
+                    .unwrap()
+                    .consumed_voluntary
+                    .is_some());
+            }
+            saw_committed |= matches!(state.consolidation, ConsolidationState::Committed { .. });
+            saw_waking |= state.phase == SleepPhase::Waking;
+            saw_later_decision |=
+                state.cycles_completed > 0 && resident.next_sequence - 1 > entry_sequence;
+        }
+        if state.phase != SleepPhase::Awake {
+            let bytes = host.checkpoint().unwrap().encode().unwrap();
+            cold = CpuSleepChoiceHostV1::restore(
+                CpuSleepChoiceHostCheckpointV1::decode(&bytes).unwrap(),
+                &source,
+                SleepChoiceMotorModeV1::Full,
+            )
+            .unwrap();
+            assert_eq!(cold.checkpoint().unwrap().encode().unwrap(), bytes);
+            // The next iteration compares this cold state against the original
+            // uninterrupted warm host, never against another cold clone.
+        }
+        eprintln!(
+            "M1_PHASE_FIXTURE tick={} decisions={} phase={:?} trigger={:?} cycles={} sequence={}",
+            step.tick_after.raw(),
+            step.decisions.len(),
+            state.phase,
+            state.last_trigger,
+            state.cycles_completed,
+            resident.next_sequence - 1
+        );
+    }
+    // This low-pressure context is not required to choose BodySleep. Treating
+    // absence of that sampled action as a source failure was a test-design
+    // error; the original failed trace remains archived, not retuned away.
+    assert_eq!(host.world().tick().raw(), 272);
+    eprintln!("M1_NATURAL_RESTORE_HORIZON ticks=32 voluntary_entry={} committed={} waking={} later_decision={}; phase mechanics are qualified separately with a real actuator receipt", saw_entry, saw_committed, saw_waking, saw_later_decision);
+}
