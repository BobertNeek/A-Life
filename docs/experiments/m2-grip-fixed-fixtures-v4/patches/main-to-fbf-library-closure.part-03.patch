+fn channel(channel: MotorChannel, id: u32) -> ChannelCommand {
+    ChannelCommand::new(
+        channel,
+        ActionId(id),
+        None,
+        Vec3f::ZERO,
+        Intensity::new(1.0).unwrap(),
+        DurationTicks(1),
+        0.0,
+        Confidence::new(1.0).unwrap(),
+        0,
+    )
+    .unwrap()
+}
+fn bundle(world: &HeadlessWorld, id: u32) -> MotorCommandBundle {
+    MotorCommandBundle::new(
+        OrganismId(1),
+        ExperienceSequenceId(1),
+        world.tick(),
+        vec![channel(MotorChannel::Posture, id)],
+    )
+    .unwrap()
+}
+fn request(world: &mut HeadlessWorld, bundle: &MotorCommandBundle) -> RecoveryRequestV1 {
+    let admission = SleepChoiceWorldAdmissionV1::for_organism(world, OrganismId(1)).unwrap();
+    let (draft, binding) = world
+        .perception_sleep_choice_draft_with_bindings(
+            &admission,
+            world.tick(),
+            HomeostaticSnapshot::baseline(world.tick()),
+        )
+        .unwrap();
+    assert_eq!(
+        binding.unwrap().candidates_for_focus(&draft, None).unwrap(),
+        draft.candidates()
+    );
+    let frame = draft.finalize(PerceptionContextBlock::empty()).unwrap();
+    RecoveryRequestV1::new(&admission, &frame, bundle).unwrap()
+}
+fn execute(world: &mut HeadlessWorld, request: &RecoveryRequestV1) -> SleepChoiceWorldReceiptV1 {
+    world
+        .apply_sleep_choice_motor_bundle_in_staged_tick(
+            request,
+            &NeuralEmissionFrame::new(world.tick(), 1, vec![]).unwrap(),
+            0.0,
+            &[],
+        )
+        .unwrap()
+}
