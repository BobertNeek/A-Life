+            );
+            assert_eq!(
+                receipt.motor.biology_after.homeostasis.hormones,
+                ordinary.biology_after.homeostasis.hormones
+            );
+            assert_eq!(
+                receipt.motor.biology_after.homeostasis.drives.brain_atp,
+                ordinary.biology_after.homeostasis.drives.brain_atp
+            );
+        }
+    }
+}
