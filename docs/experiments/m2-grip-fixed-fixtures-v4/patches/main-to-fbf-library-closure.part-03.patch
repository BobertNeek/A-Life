diff --git a/crates/alife_world/src/headless/sleep_choice_research.rs b/crates/alife_world/src/headless/sleep_choice_research.rs
new file mode 100644
index 0000000000000000000000000000000000000000..b6025d779fa603a7d499ecbc01e94fd7fd19488f
--- /dev/null
+++ b/crates/alife_world/src/headless/sleep_choice_research.rs
@@ -0,0 +1,285 @@
+//! Explicit M1 world capability. Never consulted by ordinary action dispatch.
+use super::*;
+use alife_core::{AwakeRestEventV1, RecoveryOperationV1};
+
+/// World half of admission. The host must separately validate its M1 recipe,
+/// source compiler inputs and envelope before retaining this capability.
+/// No raw sensor profile or serialized token can construct one.
+#[derive(Debug, Clone)]
+pub struct SleepChoiceWorldAdmissionV1 {
+    organism_id: OrganismId,
+    world_entity_id: WorldEntityId,
+    genome: std::sync::Arc<alife_core::CreatureGenome>,
+    phenotype: std::sync::Arc<alife_core::CreaturePhenotype>,
+}
+impl SleepChoiceWorldAdmissionV1 {
+    pub fn for_organism(
+        world: &HeadlessWorld,
+        organism_id: OrganismId,
+    ) -> Result<Self, ScaffoldContractError> {
+        world.validate_organism_bindings()?;
+        let record = world
+            .organism_registry
+            .get(organism_id)
+            .ok_or(ScaffoldContractError::InvalidId)?;
+        let admission = Self {
+            organism_id,
+            world_entity_id: record.world_entity_id(),
+            genome: std::sync::Arc::new(record.genome().clone()),
+            phenotype: std::sync::Arc::new(record.phenotype().clone()),
+        };
+        admission.validate(world)?;
+        Ok(admission)
+    }
+    fn validate(&self, world: &HeadlessWorld) -> Result<(), ScaffoldContractError> {
+        let record = world
+            .organism_registry
+            .get(self.organism_id)
+            .ok_or(ScaffoldContractError::InvalidId)?;
+        if record.world_entity_id() != self.world_entity_id
+            || !record.lifecycle().is_alive()
+            || record.genome() != self.genome.as_ref()
+            || record.phenotype() != self.phenotype.as_ref()
+            || !record
+                .phenotype()
+                .chemistry
+                .biochemical
+                .supports_awake_rest_recovery_v1()
+            || record.embodiment().effector_gain(EffectorCapability::Rest) <= 0.0
+            || record
+                .genome()
+                .n2048_foundation_candidate
+                .as_ref()
+                .is_some_and(|asset| {
+                    asset.manifest().sensor_profile() != SensorProfile::GroundedObjectSlotsV1
+                })
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(())
+    }
+}
+
+/// Sealed selection from an actual canonical M1 frame. Contains the complete
+/// bundle (including sequence/tick); callers cannot swap channels after sealing.
+#[derive(Debug, Clone)]
+pub struct RecoveryRequestV1 {
+    admission: SleepChoiceWorldAdmissionV1,
+    frame: PerceptionFrame,
+    bundle: MotorCommandBundle,
+    operation: Option<RecoveryOperationV1>,
+}
+impl RecoveryRequestV1 {
+    pub fn new(
+        admission: &SleepChoiceWorldAdmissionV1,
+        frame: &PerceptionFrame,
+        bundle: &MotorCommandBundle,
+    ) -> Result<Self, ScaffoldContractError> {
+        frame.validate_contract()?;
+        bundle.validate_contract()?;
+        if frame.sensor_profile() != SensorProfile::GroundedObjectSlotsSleepChoiceV1
+            || frame.organism_id() != admission.organism_id
+            || bundle.organism_id != admission.organism_id
+            || frame.tick() != bundle.tick
+            || bundle
+                .channels
+                .iter()
+                .any(|c| matches!(c.primitive.raw(), 2201 | 2202))
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        let posture = bundle
+            .channels
+            .iter()
+            .find(|c| c.channel == MotorChannel::Posture);
+        let operation = match posture {
+            Some(channel) if matches!(channel.primitive.raw(), 3 | 700) => {
+                if channel.target.is_some()
+                    || channel.direction != Vec3f::ZERO
+                    || !channel.payload.values.is_empty()
+                {
+                    return Err(ScaffoldContractError::InvalidDecisionEvidence);
+                }
+                let candidate = frame
+                    .candidates()
+                    .iter()
+                    .find(|c| c.action_id == channel.primitive)
+                    .ok_or(ScaffoldContractError::InvalidDecisionEvidence)?;
+                RecoveryOperationV1::for_candidate(candidate)?
+            }
+            _ => None,
+        };
+        // No alias in a different motor channel may smuggle recovery through
+        // legacy kind fallback; every other channel uses ordinary validation.
+        if bundle
+            .channels
+            .iter()
+            .any(|c| matches!(c.primitive.raw(), 3 | 700) && c.channel != MotorChannel::Posture)
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(Self {
+            admission: admission.clone(),
+            frame: frame.clone(),
+            bundle: bundle.clone(),
+            operation,
+        })
+    }
+    pub fn bundle(&self) -> &MotorCommandBundle {
+        &self.bundle
+    }
+    pub fn operation(&self) -> Option<RecoveryOperationV1> {
+        self.operation
+    }
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct SleepChoiceWorldReceiptV1 {
+    pub motor: HeadlessMotorTransactionReceipt,
+    pub operation: Option<RecoveryOperationV1>,
+    pub awake_dose: f32,
+    pub actual_sleep_dose: f32,
+    pub actual_displacement: Vec3f,
+    pub successful_stationary_body_sleep: bool,
+}
+
+/// Persistable measured provenance, separate from the unchanged motor receipt ABI.
+#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SleepChoicePhysicalReceiptV1 {
+    pub organism_id: OrganismId,
+    pub sequence_id: alife_core::ExperienceSequenceId,
+    pub source_tick: Tick,
+    pub outcome_tick: Tick,
+    pub operation: Option<RecoveryOperationV1>,
+    pub awake_recovery: f32,
+    pub sleep_recovery: f32,
+    pub actual_displacement: Vec3f,
+    pub body_sleeping: bool,
+    pub successful_stationary_body_sleep: bool,
+}
+impl SleepChoiceWorldReceiptV1 {
+    pub fn summary(&self) -> SleepChoicePhysicalReceiptV1 {
+        SleepChoicePhysicalReceiptV1 {
+            organism_id: self.motor.bundle.organism_id,
+            sequence_id: self.motor.bundle.sequence_id,
+            source_tick: self.motor.bundle.tick,
+            outcome_tick: self.motor.outcome_tick,
+            operation: self.operation,
+            awake_recovery: self.awake_dose,
+            sleep_recovery: self.actual_sleep_dose,
+            actual_displacement: self.actual_displacement,
+            body_sleeping: self.motor.biology_after.body.sleeping,
+            successful_stationary_body_sleep: self.successful_stationary_body_sleep,
+        }
+    }
+}
+
+impl HeadlessWorld {
+    pub fn perception_sleep_choice_draft_with_bindings(
+        &mut self,
+        admission: &SleepChoiceWorldAdmissionV1,
+        tick: Tick,
+        homeostasis: HomeostaticSnapshot,
+    ) -> Result<(PerceptionFrameDraft, Option<GroundedCandidateBinding>), ScaffoldContractError>
+    {
+        admission.validate(self)?;
+        let (source, binding) = self.perception_frame_draft_with_bindings(
+            admission.organism_id,
+            tick,
+            SensorProfile::GroundedObjectSlotsV1,
+            homeostasis,
+        )?;
+        let binding = binding
+            .ok_or(ScaffoldContractError::InvalidPerceptionFrame)?
+            .into_sleep_choice();
+        let profile = SensorProfile::GroundedObjectSlotsSleepChoiceV1;
+        let draft = PerceptionFrameDraft::new(
+            source.organism_id(),
+            tick,
+            profile,
+            source.sensory().clone(),
+            source.body(),
+            *source.homeostasis(),
+            binding.enumerate(None)?,
+            SensorProfileProvenance::new(profile, SensoryAbiVersion::CURRENT, tick)?,
+            source.grounded_object_slots().to_vec(),
+        )?;
+        Ok((draft, Some(binding)))
+    }
+
+    /// Staged runtime owns rollback on error, just like the ordinary staged
+    /// novelty entry. Biology advances once; replay fails the organism tick check.
+    pub fn apply_sleep_choice_motor_bundle_in_staged_tick(
+        &mut self,
+        request: &RecoveryRequestV1,
+        neural: &NeuralEmissionFrame,
+        novelty: f32,
+        object_novelty: &[(WorldEntityId, f32)],
+    ) -> Result<SleepChoiceWorldReceiptV1, HeadlessMotorTransactionError> {
+        request.admission.validate(self)?;
+        let bundle = request.bundle();
+        if request.frame.tick() != self.tick
+            || request.frame.organism_id() != bundle.organism_id
+            || self
+                .organism_registry
+                .get(bundle.organism_id)
+                .is_none_or(|r| r.sleep_phase() != alife_core::SleepPhase::Awake)
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence.into());
+        }
+        if !novelty.is_finite()
+            || !(0.0..=1.0).contains(&novelty)
+            || object_novelty.len() > bundle.channels.len()
+            || object_novelty
+                .iter()
+                .any(|(id, v)| id.raw() == 0 || !v.is_finite() || !(0.0..=1.0).contains(v))
+        {
+            return Err(ScaffoldContractError::ScalarOutOfRange.into());
+        }
+        let mut recovery = AwakeRestEventV1::NONE;
+        let motor = self.apply_registered_motor_bundle_with_sleep_choice_inner(
+            bundle,
+            request.admission.world_entity_id,
+            Some(neural),
+            Some((novelty, object_novelty)),
+            None,
+            if request.operation == Some(RecoveryOperationV1::AwakeRest) {
+                Some(&mut recovery)
+            } else {
+                None
+            },
+            true,
+        )?;
+        let stationary = motor
+            .channel_receipts
+            .iter()
+            .all(|c| c.physical.displacement == Vec3f::ZERO);
+        let actual_displacement = motor
+            .channel_receipts
+            .iter()
+            .fold(Vec3f::ZERO, |sum, c| add(sum, c.physical.displacement));
+        let actual_sleep_dose = motor.body_event.sleep_recovery;
+        let successful_stationary_body_sleep = request.operation
+            == Some(RecoveryOperationV1::BodySleep)
+            && motor.channel_receipts.iter().any(|channel| {
+                channel.command.channel == MotorChannel::Posture
+                    && channel.command.primitive == RecoveryOperationV1::BodySleep.action_id()
+                    && channel.phase == ActionPhase::Completed
+            })
+            && stationary
+            && actual_sleep_dose > 0.0
+            && motor.body_event.damage == 0.0;
+        Ok(SleepChoiceWorldReceiptV1 {
+            motor,
+            operation: request.operation,
+            awake_dose: recovery.dose(),
+            actual_sleep_dose,
+            actual_displacement,
+            successful_stationary_body_sleep,
+        })
+    }
+}
