+#[test]
+fn sleep_choice_age_disabled_high_pressure_host_has_byte_exact_voluntary_cycle() {
+    // A separate controlled context, not the default-life fixture or a behavioral
+    // cohort. Same source genotype, seed, logits, sampler and actual first frame.
+    // Fixed before execution:10000 body-only ticks with age death disabled at
+    // birth, followed by exactly32 neural/world ticks. No adaptive extension.
+    let (mut host, source) = fixture_with_preparation(FixedBodyPreparation::AgeDisabled10000);
+    let initial = host.checkpoint().unwrap().encode().unwrap();
+    let mut cold = CpuSleepChoiceHostV1::restore(
+        CpuSleepChoiceHostCheckpointV1::decode(&initial).unwrap(),
