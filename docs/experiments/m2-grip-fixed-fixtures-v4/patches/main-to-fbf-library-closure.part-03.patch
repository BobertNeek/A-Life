+        SleepChoiceMotorModeV1::Full,
+    )
+    .unwrap();
+    let mut saw_entry = false;
+    let mut saw_committed = false;
+    let mut saw_waking = false;
+    let mut saw_later_decision = false;
+    let mut entry_sequence = 0;
+    let mut consolidations = std::collections::BTreeSet::new();
+    for offset in 0..32 {
+        let step = host.step(1.).unwrap();
+        for decision in &step.decisions {
+            eprintln!("M1_HIGH_PRESSURE_DECISION offset={} tick={} configured_microsteps={} actual_microsteps={} pressure={} reference={} encoded={:?} opponent={:?} pressure_head={:?} operation={:?} awake_dose={} sleep_dose={} memory={:?}",
+                offset, decision.motor.tick.raw(), decision.motor.configured_microsteps,
+                decision.motor.work.microsteps, decision.motor.raw_pressure, decision.motor.pressure_reference,
+                decision.motor.pressure_encoded_pair, decision.motor.pressure_opponent_pair,
+                decision.motor.pressure_candidate_contributions, decision.physical.operation,
+                decision.physical.awake_recovery, decision.physical.sleep_recovery, decision.motor.memory_contributions);
+        }
+        let restored_step = cold.step(1.).unwrap();
+        assert_eq!(step.decisions.len(), restored_step.decisions.len());
+        assert_eq!(
+            step.sleep_consolidations,
+            restored_step.sleep_consolidations
+        );
+        for (a, b) in step.decisions.iter().zip(&restored_step.decisions) {
+            assert_eq!(
+                serde_json::to_vec(&a.patch).unwrap(),
+                serde_json::to_vec(&b.patch).unwrap()
+            );
+            assert_eq!(
+                serde_json::to_vec(&a.motor).unwrap(),
+                serde_json::to_vec(&b.motor).unwrap()
+            );
+            assert_eq!(
+                serde_json::to_vec(&a.physical).unwrap(),
+                serde_json::to_vec(&b.physical).unwrap()
+            );
+        }
+        let bytes = host.checkpoint().unwrap().encode().unwrap();
+        assert_eq!(bytes, cold.checkpoint().unwrap().encode().unwrap());
+        let resident = host.host.residents.values().next().unwrap();
+        let state = resident.sleep.state();
+        if state.phase == SleepPhase::EnteringSleep
+            && state.last_trigger == Some(SleepTrigger::VoluntaryBodySleepV1)
+        {
+            if !saw_entry {
+                entry_sequence = resident.next_sequence - 1;
+            }
+            saw_entry = true;
+            assert!(resident
+                .sleep_choice
+                .as_ref()
+                .unwrap()
+                .consumed_voluntary
+                .is_some());
+        }
+        if state.last_trigger == Some(SleepTrigger::VoluntaryBodySleepV1) {
+            saw_committed |= matches!(state.consolidation, ConsolidationState::Committed { .. });
+            saw_waking |= state.phase == SleepPhase::Waking;
+            saw_later_decision |=
+                state.cycles_completed > 0 && resident.next_sequence - 1 > entry_sequence;
+        }
+        if step.sleep_consolidations > 0 {
+            assert_eq!(step.sleep_consolidations, 1);
+            assert!(
+                consolidations.insert(state.active_cycle_id),
+                "duplicate consolidation credit"
+            );
+        }
+        if state.phase != SleepPhase::Awake {
+            cold = CpuSleepChoiceHostV1::restore(
+                CpuSleepChoiceHostCheckpointV1::decode(&bytes).unwrap(),
+                &source,
+                SleepChoiceMotorModeV1::Full,
+            )
+            .unwrap();
+            assert_eq!(cold.checkpoint().unwrap().encode().unwrap(), bytes);
+        }
+        eprintln!("M1_HIGH_PRESSURE_PHASE tick={} decisions={} phase={:?} trigger={:?} cycles={} sequence={} consolidations={}",
+            step.tick_after.raw(), step.decisions.len(), state.phase, state.last_trigger,
+            state.cycles_completed, resident.next_sequence - 1, step.sleep_consolidations);
+    }
+    eprintln!("M1_HIGH_PRESSURE_RESULT fixed_ticks=32 entry={} committed={} waking={} later_decision={} consolidation_cycles={:?}; age-disabled full-host mechanism fixture, not default-life or learned competence", saw_entry, saw_committed, saw_waking, saw_later_decision, consolidations);
+    assert_eq!(host.world().tick().raw(), 10_032);
+    assert!(saw_entry && saw_committed && saw_waking && saw_later_decision);
+    assert!(!consolidations.is_empty());
+    let resident = host.host.residents.values().next().unwrap();
+    assert!(resident
+        .neural
+        .checkpoint()
+        .unwrap()
+        .fast
+        .iter()
+        .any(|x| *x != 0.));
+    assert!(!resident
+        .memory
+        .export_active_bank()
+        .unwrap()
+        .records
+        .is_empty());
+    assert_eq!(host.founder.checkpoint().optimizer_step, 23);
+    assert_eq!(host.founder.checkpoint().update_ages[0], 23);
+    assert_eq!(host.founder.checkpoint().first_moment[0], 0.03125);
+    assert_eq!(host.founder.checkpoint().second_moment[0], 0.0625);
+}
