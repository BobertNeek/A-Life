@@ -0,0 +1,85 @@
+//! Dedicated explicit M1 reconstruction. The intermediate M0 value is local;
+//! no M0 identity is exposed as the resulting contract or persisted as M1.
+use super::*;
+use crate::{
+    ActiveTilePolicy, BiologicalPriority, CandidateActionFamily, LobeKind, ProjectionType,
+    SleepChoiceM1V1, UpdateCadence,
+};
+impl BrainPhenotype {
+    pub(crate) fn lower_sleep_choice_m1(
+        recipe: &SleepChoiceM1V1,
+    ) -> Result<Self, ScaffoldContractError> {
+        recipe.validate()?;
+        let source = recipe.source_inputs();
+        let (mut value, _) = crate::PhenotypeCompiler::compile_motor_lobe_m0(source)?;
+        let capacity = BrainCapacityClass::n2144_sleep_choice_research();
+        // The old selector describes only source provenance. M1 identity lives
+        // in its separately typed descriptor and all execution digests.
+        value.foundation_abi_selection = source.foundation_abi().clone();
+        value.sensor_encoder = value
+            .sensor_encoder
+            .with_sleep_choice_m1(recipe.reference())?;
+        let route = (value.projections.len() - 1) as u16;
+        for (source, weight) in [(2142, 4.), (2143, -4.)] {
+            value.synapses.push(CompiledSynapse::new(
+                source,
+                source,
+                weight,
+                0.,
+                route,
+                CompiledSynapseKind::Decoder(DecoderSynapseCoordinate::new(
+                    DecoderHeadKind::ActionCandidate,
+                    CandidateActionFamily::Rest,
+                    54,
+                    (source - 2048) as u16,
+                )),
+            ));
+        }
+        value.projections[route as usize] = CompiledProjection::new(
+            route,
+            LobeKind::FlexibleReserve,
+            LobeKind::FlexibleReserve,
+            ProjectionType::MotorProposal,
+            ActiveTilePolicy::EssentialReservation,
+            UpdateCadence::Hot60Hz,
+            BiologicalPriority::Essential,
+            0,
+            SleepChoiceM1V1::BASE_SYNAPSES as u32,
+            52,
+            0,
+        );
+        value.budgets.capacity_class_id = capacity.id();
+        value.budgets.execution_abi_digest = capacity.canonical_digest();
+        value.budgets.global.action_decoder_synapses += 2;
+        value.budgets.global.total_synapses += 2;
+        value.budgets.global.immutable_payload_words += 2;
+        value.budgets.global.decoder_input_lanes = 55;
+        let b = &mut value.budgets.routes[route as usize];
+        b.action_decoder_synapses += 2;
+        b.immutable_payload_words += 2;
+        b.synapse_ceiling += 2;
+        b.payload_word_ceiling += 2;
+        value.budgets.validate_against(&capacity)?;
+        value.brain_class_id = capacity.id();
+        value.compiler_inputs_digest = recipe.canonical_digest();
+        value.persistent_address_map =
+            PersistentAddressMap::compile(&value.lobe_layout, &value.projections, &value.synapses)?;
+        use crate::blake3_digest::{domain_hasher, Blake3Write};
+        let mut route_hash = domain_hasher(b"alife.sleep-choice.m1.route.v1");
+        let mut plasticity_hash = domain_hasher(b"alife.sleep-choice.m1.fixed.v1");
+        for byte in value.route_abi_digest.bytes() {
+            route_hash.write_u8(*byte);
+        }
+        for byte in value.plasticity_abi_digest.bytes() {
+            plasticity_hash.write_u8(*byte);
+        }
+        for word in recipe.canonical_digest() {
+            route_hash.write_u64(word);
+            plasticity_hash.write_u64(word);
+        }
+        value.route_abi_digest = Blake3Digest::from_hasher(route_hash);
+        value.plasticity_abi_digest = Blake3Digest::from_hasher(plasticity_hash);
+        value.phenotype_hash = value.recompute_phenotype_hash()?;
+        Ok(value)
+    }
+}
