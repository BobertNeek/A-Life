+//! Snapshot of the frozen V1 assay helpers; candidate experiments do not alter V1.
+//! Detached fixed-context CPU routing assay. No world ticks, learning or private state.
+#[path = "multidrive_frozen.rs"]
+pub mod frozen;
+use alife_core::*;
+use alife_training::{
+    TrainingInitialState, TrainingReplayCandidate, TrainingReplayTick, TrainingSequence,
+};
+use serde_json::{json, Value};
+use std::{
+    collections::{BTreeSet, VecDeque},
+    error::Error,
+};
+type Result<T> = std::result::Result<T, Box<dyn Error>>;
+pub const FRAMES: usize = 64;
+pub const BURN: usize = 32;
+pub const LABELS: [&str; 11] = [
+    "hunger",
+    "fatigue",
+    "fear",
+    "pain",
+    "loneliness",
+    "curiosity",
+    "ATP_availability",
+    "temperature_stress",
+    "reproductive",
+    "boredom_if_bound",
+    "extension1_unbound",
+];
+pub fn drives(a: [f32; 11]) -> DriveSnapshot {
+    DriveSnapshot {
+        hunger: a[0],
+        fatigue: a[1],
+        fear: a[2],
+        pain: a[3],
+        loneliness: a[4],
+        curiosity: a[5],
+        brain_atp: a[6],
+        temperature_stress: a[7],
+        reproductive_drive: a[8],
+        extension: [a[9], a[10]],
+    }
+}
+pub fn features(family: CandidateActionFamily, context: &str) -> CandidateFeatureVector {
+    if family == CandidateActionFamily::Idle {
+        return CandidateFeatureVector::zero().with_intrinsic_action_basis(ActionKind::Idle);
+    }
+    if family == CandidateActionFamily::Rest {
+        return CandidateFeatureVector::zero().with_intrinsic_action_basis(ActionKind::Rest);
+    }
+    let mut x = [0.; 24];
+    if !matches!(
+        family,
+        CandidateActionFamily::Idle | CandidateActionFamily::Rest
+    ) {
+        x[0] = 1.;
+        x[2] = if context == "distant" { 0.8 } else { 0.1 };
+        x[6] = 0.4;
+        x[7] = 0.3;
+        x[8] = 0.2;
+        x[18] = if context == "distant" { 0. } else { 1. };
+        x[15] = match context {
+            "nutritious_contact" => 1.,
+            "aversive_contact" => -1.,
+            _ => 0.,
+        };
+    }
+    CandidateFeatureVector(x)
+}
+pub fn encoded(p: &BrainPhenotype, a: [f32; 11]) -> Vec<f32> {
+    let mut encoded = vec![0.; p.neuron_count() as usize];
+    for s in p.sensor_encoder().assignments() {
+        // Synthetic controlled context: all other sensor/hormone channels zero.
+        // Encoder scale, bias and clamp remain inherited. Receptor gains fixed 1.
+        let value =
+            if s.source_group() == SensorEncoderSourceGroup::Homeostasis && s.source_index() < 11 {
+                a[s.source_index() as usize]
+            } else {
+                0.
+            };
+        let (lo, hi) = s.clamp_range();
+        encoded[s.target_neuron() as usize] += (value * s.scale() + s.bias()).clamp(lo, hi);
+    }
+    for v in &mut encoded {
+        *v = v.clamp(-1., 1.);
+    }
+    encoded
+}
+pub fn sequence(
+    p: &BrainPhenotype,
+    base: [f32; 11],
+    changed: [f32; 11],
+    context: &str,
+    dendrites: &DendriticBranchSet,
+    input_cut: bool,
+) -> TrainingSequence {
+    let n = p.neuron_count() as usize;
+    let ticks = (0..FRAMES)
+        .map(|t| {
+            let a = if t < BURN || input_cut { base } else { changed };
+            let candidates = p
+                .candidate_decoder()
+                .families()
+                .iter()
+                .map(|f| {
+                    let mut decoder_inputs = [0.; 54];
+                    decoder_inputs[..24].copy_from_slice(&features(f.family(), context).0);
+                    TrainingReplayCandidate {
+                        family: f.family(),
+                        decoder_inputs,
+                        innate_bias: 0.,
+                    }
+                })
+                .collect();
+            TrainingReplayTick {
+                encoded_inputs: encoded(p, a),
+                projection_gain: 1.,
+                local_threshold_shift: 0.,
+                microstep_count: p.microstep_count() as u32,
+                enabled_routes: vec![true; p.projections().len()],
+                effective_weight_offsets: vec![0.; p.synapses().len()],
+                structural_synapses: vec![],
+                candidates,
+            }
+        })
+        .collect();
+    TrainingSequence {
+        phenotype_hash: p.phenotype_hash(),
+        initial: TrainingInitialState {
+            activations: vec![0.; n],
+            activity_ema: vec![0.; n],
+            metabolic_load: vec![0.; n],
+            dendrites: dendrites.clone(),
+        },
+        ticks,
+        burn_in_ticks: BURN,
+        memory_candidate_gain: p
+            .candidate_decoder()
+            .memory_channel()
+            .map_or(0., |m| m.max_candidate_gain()),
+    }
+}
+pub fn reachability(
+    p: &BrainPhenotype,
+    w: &[f32],
+    d: &DendriticBranchSet,
+    lane: usize,
+    effective: bool,
+    include_dendrites: bool,
+) -> Value {
+    let mut edges = vec![Vec::new(); p.neuron_count() as usize];
+    for (i, s) in p.synapses().iter().enumerate() {
+        if s.kind() == CompiledSynapseKind::Recurrent && (!effective || w[i] != 0.) {
+            edges[s.source() as usize].push(s.target() as usize);
+        }
+    }
+    if include_dendrites {
+        for b in d.branches() {
+            if !effective || b.output_gain != 0. {
+                for i in &b.inputs {
+                    if !effective || i.weight != 0. {
+                        edges[i.source as usize].push(b.target as usize);
+                    }
+                }
+            }
+        }
+    }
+    let roots = p
+        .sensor_encoder()
+        .assignments()
+        .iter()
+        .filter(|s| {
+            s.source_group() == SensorEncoderSourceGroup::Homeostasis
+                && s.source_index() as usize == lane
+        })
+        .map(|s| s.target_neuron() as usize)
+        .collect::<Vec<_>>();
+    let mut seen = BTreeSet::new();
+    let mut q = VecDeque::from(roots.clone());
+    while let Some(n) = q.pop_front() {
+        if seen.insert(n) {
+            q.extend(edges[n].iter().copied());
+        }
+    }
+    let family=p.candidate_decoder().families().iter().map(|f| {
+        let motors=p.synapses().iter().enumerate().filter_map(|(i,s)|match s.kind() {CompiledSynapseKind::Decoder(c) if c.head()==DecoderHeadKind::ActionCandidate && c.family()==f.family() && (!effective || w[i]!=0.)=>Some(s.source() as usize),_=>None}).collect::<BTreeSet<_>>();
+        json!({"family":f.family(),"reachable_motor_count":motors.intersection(&seen).count(),"decoder_motor_count":motors.len()})
+    }).collect::<Vec<_>>();
+    json!({"roots":roots,"reachable_neurons":seen.len(),"families":family})
+}
diff --git a/crates/alife_training/examples/support/motor_host_preparation_v1.rs b/crates/alife_training/examples/support/motor_host_preparation_v1.rs
new file mode 100644
index 0000000000000000000000000000000000000000..ff4f71a35892cc1455eed08fa839bc5175be1a13
--- /dev/null
+++ b/crates/alife_training/examples/support/motor_host_preparation_v1.rs
@@ -0,0 +1,363 @@
+//! Fresh motor-host scene preparation. Source geometry/chemistry operations are
+//! copied from qualified grounded preparation; no archived world is imported.
+use alife_core::*;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask};
+use alife_world::*;
+use serde_json::{json, Value};
+use std::collections::BTreeSet;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+pub const PREPARATION_TICKS: u64 = 240;
+pub const SEED: u64 = 0x4D48_5432;
+pub fn prepare(
+    recipe: &super::recipe::R0Recipe,
+    scene: usize,
+    mode: MotorHostModeV1,
+) -> Result<(CpuMotorLobeHostV1, Value)> {
+    if scene > 1 || recipe.config.world_seed != SEED {
+        return Err("motor-host frozen scene/seed mismatch".into());
+    }
+    recipe
+        .genotype
+        .validate_n2048_grounded_drive_inputs(&recipe.inputs)?;
+    recipe.asset.validate_against(&recipe.phenotype)?;
+    let seed = recipe.config.world_seed;
+    let sampling_seed = (seed ^ (seed >> 32)) as u32;
+    let trainer = CpuFoundationTrainer::new(
+        recipe.phenotype.clone(),
+        recipe.asset.clone(),
+        StageTrainableMask::recurrent_only(&recipe.phenotype)?,
+        AdamWConfig::default(),
+    )?;
+    let trainer_before = serde_json::to_value(trainer.checkpoint())?;
+    let mut game = create_grounded_drive_research_new_game(&recipe.config, &recipe.genotype)?;
+    let newborn = game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("missing newborn")?
+        .clone();
+    let organism = newborn.organism_id();
+    if newborn.birth_tick() != Tick::ZERO
+        || newborn.biochemistry().tick != Tick::ZERO
+        || newborn.genome() != &recipe.genotype
+    {
+        return Err("not an exact newborn".into());
+    }
+    let mut world = HeadlessScenarioBuilder::new(seed)
+        .agent("learner", organism, Vec3f::ZERO)
+        .build()?;
+    if world.entity_id("learner") != Some(newborn.world_entity_id())
+        || world.object_count() != 1
+        || world.terrain().is_some()
+    {
+        return Err("newborn scene binding changed".into());
+    }
+    world.register_grounded_drive_research_record(newborn)?;
+    game.world = world;
+    let reference = CpuCanonicalHost::new_grounded_drive_research_cohort(
+        game.clone(),
+        &trainer,
+        sampling_seed,
+    )?;
+    let before = reference.grounded_drive_research_checkpoint(&trainer)?;
+    let (host, setup) = CpuMotorLobeHostV1::new_prepared(
+        game,
+        trainer,
+        recipe.inputs.clone(),
+        sampling_seed,
+        mode,
+        |world| -> Result<Value> {
+            let admitted = identity(world, organism)?;
+            for expected in 1..=PREPARATION_TICKS {
+                if world.try_advance_tick()? != Tick::new(expected) {
+                    return Err("body-only preparation did not advance exactly one interval".into());
+                }
+            }
+            let aged = world
+                .organism_registry()
+                .get(organism)
+                .ok_or("prepared learner missing")?;
+            let development = aged.biochemistry().development;
+            if world.tick() != Tick::new(PREPARATION_TICKS)
+                || development.age_ticks != Tick::new(PREPARATION_TICKS)
+                || development.last_update_tick != world.tick()
+                || development.biochemical_expression.to_bits() != 1_f32.to_bits()
+                || development.maturation >= 1.
+                || development.puberty_reached
+                || !aged.lifecycle().is_alive()
+                || aged.biochemistry().body.sleeping
+                || aged.sleep_cycle_id() != 0
+                || aged.cognitive_work() != &CognitiveWorkReceipt::zero()
+            {
+                return Err(
+                    "R0 needs an awake, fully biochemically expressed age-240 juvenile".into(),
+                );
+            }
+            let after_world_only = identity(world, organism)?;
+            let target = world.editor_spawn_object(WorldEditorSpawnSpec {
+                label: "target".into(),
+                // Ball is the exact movable-toy kind used by spawn_toy(..., true).
+                kind: if scene == 0 {
+                    WorldObjectKind::Food
+                } else {
+                    WorldObjectKind::Ball
+                },
+                organism_id: None,
+                position: Vec3f::new(if scene == 0 { 1. } else { 0.65 }, 0., 0.),
+                nutrition: if scene == 0 { 0.6 } else { 0. },
+                hazard_pain: 0.,
+                radius: 0.2,
+                token_id: None,
+            })?;
+            let mut physical = world
+                .entity(target)
+                .ok_or("target missing")?
+                .grounded_physical;
+            let physical_before = physical;
+            physical.chemical[0] = if scene == 0 { 0.85 } else { 0. };
+            physical.surface_temperature = 0.;
+            world.set_grounded_physical_properties(target, physical)?;
+            let chemistry = author_source_concentrations(world, organism, scene)?;
+            let geometry = geometry_receipt(world, organism, target)?;
+            Ok(json!({
+                "admitted_before_preparation": admitted,
+                "after_world_only_preparation": after_world_only,
+                "after_concentration_edits": identity(world, organism)?,
+                "target_entity": target,
+                "target_physical_before_authoring": physical_before,
+                "target_physical_after_authoring": physical,
+                "thermal_physics_enabled": false,
+                "chemistry": chemistry,
+                "geometry": geometry,
+            }))
+        },
+    )?;
+    let after = serde_json::to_value(host.checkpoint()?)?;
+    if serde_json::to_vec(&serde_json::to_value(&before.checkpoint.residents)?)?
+        != serde_json::to_vec(&after["canonical"]["residents"])?
+        || serde_json::to_vec(&trainer_before)? != serde_json::to_vec(&after["founder"])?
+        || after["canonical"]["sampling_counter"] != json!(0)
+        || after["canonical"]["sampling_seed"] != json!(sampling_seed)
+    {
+        return Err("body-only preparation changed cognition, optimizer or sampling".into());
+    }
+    for controller in after["controllers"]
+        .as_object()
+        .ok_or("missing controllers")?
+        .values()
+    {
+        for key in ["activations", "inactive", "ema", "metabolic"] {
+            let bank = controller[key].as_array().ok_or("missing bank")?;
+            if bank.len() != 96 || bank.iter().any(|x| x.as_f64() != Some(0.)) {
+                return Err("controller warmed during preparation".into());
+            }
+        }
+    }
+    let record = host
+        .world()
+        .organism_registry()
+        .get(organism)
+        .ok_or("missing prepared record")?;
+    let metadata = json!({"schema":"motor_host_scene_preparation_v1","seed":seed,"scene":scene,"mode":mode,"world_only_ticks":PREPARATION_TICKS,
+        "decisions":0,"optimizer_updates":0,"private_prefix_bytes_preserved":true,"controller_zero_state_preserved":true,
+        "setup":setup,"initial_biology":record.biochemistry(),"initial_embodiment":record.embodiment(),
+        "expressed_biochemical_species":record.phenotype().chemistry.biochemical.species(),
+        "expressed_biochemical_reactions":record.phenotype().chemistry.biochemical.reactions(),
+        "expressed_biochemical_emitters":record.phenotype().chemistry.biochemical.emitters(),
+        "expressed_biochemical_receptors":record.phenotype().chemistry.biochemical.receptors(),
+        "source_phenotype_hash":recipe.phenotype.phenotype_hash(),"source_address_map":recipe.phenotype.persistent_address_map().digest(),
+        "composite_phenotype_hash":PhenotypeCompiler::compile_motor_lobe_m0(&recipe.inputs)?.0.phenotype_hash()});
+    Ok((host, metadata))
+}
+fn author_source_concentrations(
+    world: &mut HeadlessWorld,
+    organism: OrganismId,
+    scene: usize,
+) -> Result<Value> {
+    let record = world
+        .organism_registry()
+        .get(organism)
+        .ok_or("learner missing")?;
+    let phenotype = record.phenotype().clone();
+    let before = *record.biochemistry();
+    let before_wire = serde_json::to_value(before)?;
+    let mut wire = before_wire.clone();
+    let mut indices = BTreeSet::new();
+    let mut edits = Vec::new();
+    for (channel, concentration) in [
+        (
+            BiochemicalDriveChannel::Hunger,
+            if scene == 0 { 0.65_f32 } else { 0.1 },
+        ),
+        (
+            BiochemicalDriveChannel::Fatigue,
+            if scene == 0 { 0.65_f32 } else { 0.1 },
+        ),
+        (
+            BiochemicalDriveChannel::Curiosity,
+            if scene == 0 { 0.1_f32 } else { 0.65 },
+        ),
+    ] {
+        let receptors = phenotype
+            .chemistry
+            .biochemical
+            .receptors()
+            .iter()
+            .filter(|r| r.target == BiochemicalTargetLocus::Drive(channel))
+            .collect::<Vec<_>>();
+        if receptors.len() != 1 || receptors[0].digital || receptors[0].gain <= 0. {
+            return Err(
+                "R0 needs one positive analog inherited receptor per declared drive".into(),
+            );
+        }
+        let receptor = receptors[0];
+        let index = phenotype
+            .chemistry
+            .biochemical
+            .species()
+            .iter()
+            .position(|s| s.id == receptor.source)
+            .ok_or("drive source species missing")?;
+        let species = phenotype.chemistry.biochemical.species()[index];
+        if !indices.insert(index) || !(species.minimum..=species.maximum).contains(&concentration) {
+            return Err(
+                "R0 source concentrations must be distinct and within inherited bounds".into(),
+            );
+        }
+        let slot = wire
+            .get_mut("graph_state")
+            .and_then(|g| g.get_mut("concentrations"))
+            .and_then(Value::as_array_mut)
+            .and_then(|a| a.get_mut(index))
+            .ok_or("biochemistry concentration schema changed")?;
+        let prior = slot.clone();
+        if prior == json!(concentration) {
+            return Err("R0 must author exactly three changed source concentrations".into());
+        }
+        *slot = json!(concentration);
+        edits.push(json!({
+            "channel": channel, "source_species": receptor.source, "species_index": index,
+            "path": format!("/graph_state/concentrations/{index}"),
+            "before": prior, "after": concentration, "inherited_receptor": receptor,
+        }));
+    }
+    let mut next: BiochemistryState = serde_json::from_value(wire.clone())?;
+    next.homeostasis = next
+        .graph_state()
+        .derive_homeostasis(&phenotype.chemistry.biochemical)?;
+    next.validate_against(&phenotype)?;
+    // Compare the entire biology serialization, not only selected easy fields.
+    // Exactly the three concentration cells plus their derived cache may differ.
+    *wire
+        .get_mut("homeostasis")
+        .ok_or("homeostasis schema changed")? = serde_json::to_value(next.homeostasis)?;
+    if serde_json::to_value(next)? != wire || edits.len() != 3 {
+        return Err("chemistry preparation changed an undeclared biological field".into());
+    }
+    let mut registry = world.organism_registry().clone();
+    registry.with_biology_mut(organism, |biology| {
+        *biology = next;
+        Ok(())
+    })?;
+    world.replace_organism_registry_exact(registry.iter().cloned())?;
+    let actual = world
+        .organism_registry()
+        .get(organism)
+        .ok_or("learner missing")?
+        .biochemistry();
+    if actual != &next {
+        return Err("registry replacement did not preserve the exact authored biology".into());
+    }
+    Ok(json!({
+        "authored_edit_count": 3, "edits": edits,
+        "homeostasis_before": before.homeostasis, "homeostasis_after": next.homeostasis,
+        "biochemistry_before_hash": hash(b"r0-biochemistry-v1", &before)?,
+        "biochemistry_after_hash": hash(b"r0-biochemistry-v1", &next)?,
+        "all_other_biological_fields_preserved": true,
+        "derived_cache_only": "homeostasis rederived from inherited biochemical receptors",
+        "direct_body_energy_atp_hormone_edits": false,
+    }))
+}
+
+fn identity(world: &HeadlessWorld, organism: OrganismId) -> Result<Value> {
+    let record = world
+        .organism_registry()
+        .get(organism)
+        .ok_or("learner missing")?;
+    Ok(json!({
+        "organism_id": organism, "world_entity_id": record.world_entity_id(),
+        "world_tick": world.tick(), "birth_tick": record.birth_tick(),
+        "genome_id": record.genome().id, "lineage_id": record.genome().lineage_id,
+        "genotype_hash": hash(b"r0-genotype-v1", record.genome())?,
+        "phenotype_hash": hash(b"r0-creature-phenotype-v1", record.phenotype())?,
+        "record_hash": hash(b"r0-organism-record-v1", record)?,
+        "biochemistry_hash": hash(b"r0-biochemistry-v1", record.biochemistry())?,
+        "development": record.biochemistry().development,
+        "biochemical_activation_maturation": record.phenotype().development.biochemical_activation_maturation,
+        "maturation_duration_ticks": record.phenotype().development.maturation_duration_ticks,
+        "puberty_tick": record.phenotype().development.puberty_tick,
+        "brain_seal": record.state_graph().brain,
+        "memory_seal": record.state_graph().memory,
+    }))
+}
+
+fn geometry_receipt(
+    world: &HeadlessWorld,
+    organism: OrganismId,
+    target: WorldEntityId,
+) -> Result<Value> {
+    let record = world
+        .organism_registry()
+        .get(organism)
+        .ok_or("learner missing")?;
+    let learner = world
+        .entity(record.world_entity_id())
+        .ok_or("learner object missing")?;
+    let object = world.entity(target).ok_or("target missing")?;
+    let delta = Vec3f::new(
+        object.position.x - learner.position.x,
+        object.position.y - learner.position.y,
+        object.position.z - learner.position.z,
+    );
+    let distance = (delta.x * delta.x + delta.y * delta.y + delta.z * delta.z).sqrt();
+    if learner.position != Vec3f::ZERO
+        || world.terrain().is_some()
+        || world.object_count() != 2
+        || world
+            .object_snapshots()
+            .iter()
+            .any(|o| o.kind == WorldObjectKind::Obstacle)
+        || distance > 1.25
+        || object.radius.to_bits() != 0.2_f32.to_bits()
+        || object.grounded_physical.surface_temperature.to_bits() != 0_f32.to_bits()
+    {
+        return Err("R0 declared geometry or thermally neutral target changed".into());
+    }
+    Ok(json!({
+        "age_ticks": record.biochemistry().development.age_ticks,
+        "actual_expressed_size_scale": record.phenotype().body.size_scale,
+        "actual_embodiment": record.embodiment(),
+        "learner_position": learner.position, "target_position": object.position,
+        "learner_object_radius": learner.radius, "target_radius": object.radius,
+        "locomotion_envelope_radius": LocomotionLimits::default().body_radius,
+        "center_distance": distance,
+        "center_to_target_surface_distance": (distance - object.radius).max(0.),
+        "object_radius_surface_gap": (distance - learner.radius - object.radius).max(0.),
+        "manipulation_center_reach": 1.25,
+        "in_physical_manipulation_reach": true,
+        "obstacle_or_terrain_blockers": false,
+        "observed_object_contact_at_start": distance <= object.radius,
+        "reach_formula": "distance(actor.position, target.position) <= EAT_RADIUS (1.25) && solid_segment_clear; no age/size multiplier",
+        "locomotion_radius_formula": "terrain limits when present, otherwise LocomotionLimits::default().body_radius; not phenotype size_scale",
+        "contact_formula": "carried_by == actor || (center_distance <= target.radius && physical_contact_reachable)",
+        "source": "crates/alife_world/src/headless.rs::physical_contact_reachable, locomotion_body_radius, physical_observation_snapshot_from_objects at 599d2df638cf279e8fad732075a734fd0d92ebdc",
+        "horizon_extension_allowed": false,
+    }))
+}
+
+fn hash<T: serde::Serialize>(domain: &[u8], value: &T) -> Result<[u64; 4]> {
+    let mut digest = CanonicalDigestBuilder::new(domain);
+    digest.write_bytes(&serde_json::to_vec(value)?);
+    Ok(digest.finish256())
+}
diff --git a/crates/alife_training/examples/support/motor_operating_point.rs b/crates/alife_training/examples/support/motor_operating_point.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f91942b465d81befa259edbe4588115c95763379
--- /dev/null
+++ b/crates/alife_training/examples/support/motor_operating_point.rs
@@ -0,0 +1,134 @@
+//! Explicit weight-only research candidate. No inherited dendrite or ABI edits.
+use alife_core::*;
+use serde_json::{json, Value};
+use std::collections::BTreeSet;
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+
+/// Factorial controls keep frozen whole-care6 as the starting point. Negative
+/// tonic state is produced by a signed Modulatory edge; motor edges stay positive.
+pub fn counterbalance(
+    p: &BrainPhenotype,
+    original: &[f32],
+    circuits: &[Value],
+    gain: f32,
+    differential_readout: bool,
+) -> Result<(Vec<f32>, Vec<Value>)> {
+    if original.len() != p.synapses().len()
+        || p.foundation_abi_selection()
+            .n2048_experimental_graph()
+            .is_none()
+        || p.sensor_profile() != SensorProfile::GroundedObjectSlotsV1
+        || p.projections()
+            .get(3)
+            .is_none_or(|r| r.projection_type() != ProjectionType::Modulatory)
+        || p.projections()
+            .get(5)
+            .is_none_or(|r| r.projection_type() != ProjectionType::MotorProposal)
+    {
+        return Err(
+            "operating-point candidate requires its explicit research graph and weight layout"
+                .into(),
+        );
+    }
+    if !gain.is_finite() || !(0.0..=8.0).contains(&gain) {
+        return Err("counterbalance gain outside declared sweep".into());
+    }
+    let mut w = original.to_vec();
+    let mut edits = vec![];
+    let mut occupied = BTreeSet::new();
+    for c in circuits.iter().filter(|c| c["role"] == "need") {
+        let bridge = c["bridge_synapses"][1]
+            .as_u64()
+            .ok_or("missing frozen bridge")? as usize;
+        occupied.insert(p.synapses()[bridge].target());
+    }
+    let tonic = circuits
+        .iter()
+        .find(|c| c["role"] == "tonic")
+        .ok_or("missing frozen tonic")?;
+    let first = tonic["bridge_synapses"][0]
+        .as_u64()
+        .ok_or("missing tonic source")? as usize;
+    let reservoir = p.synapses()[first].target();
+    for family in [
+        CandidateActionFamily::Rest,
+        CandidateActionFamily::Inspect,
+        CandidateActionFamily::Approach,
+    ] {
+        let family_value = serde_json::to_value(family)?;
+        let record = circuits
+            .iter()
+            .find(|c| c["role"] == "reference" && c["family"] == family_value)
+            .ok_or("missing family reference")?;
+        let reference = record["reference_motor"]
+            .as_u64()
+            .ok_or("missing reference motor")? as u32;
+        let mut motors = record["signal_motors"]
+            .as_array()
+            .ok_or("missing signal motors")?
+            .iter()
+            .map(|v| v.as_u64().map(|v| v as u32).ok_or("invalid motor"))
+            .collect::<std::result::Result<Vec<_>, _>>()?;
+        motors.push(reference);
+        if differential_readout && family != CandidateActionFamily::Rest {
+            for (i, s) in p.synapses().iter().enumerate() {
+                if s.source() == reference
+                    && matches!(s.kind(), CompiledSynapseKind::Decoder(c) if c.head()==DecoderHeadKind::ActionCandidate && c.family()==family)
+                    && w[i] != 0.
+                {
+                    let before = w[i];
+                    w[i] *= -0.2; // frozen +5 reference becomes a -1 contrast
+                    edits.push(json!({"role":"differential_reference","family":family,"synapse":i,"before":before,"after":w[i]}));
+                }
+            }
+        }
+        if gain == 0. {
+            continue;
+        }
+        for motor in motors {
+            let mut found = None;
+            for (middle, edge) in p.synapses().iter().enumerate() {
+                if edge.kind() != CompiledSynapseKind::Recurrent
+                    || edge.route_index() != 3
+                    || edge.source() != reservoir
+                    || occupied.contains(&edge.target())
+                {
+                    continue;
+                }
+                if let Some((output, _)) = p.synapses().iter().enumerate().find(|(_, s)| {
+                    s.kind() == CompiledSynapseKind::Recurrent
+                        && s.route_index() == 5
+                        && s.source() == edge.target()
+                        && s.target() == motor
+                }) {
+                    found = Some((middle, output, edge.target()));
+                    break;
+                }
+            }
+            let (middle, output, relay) =
+                found.ok_or("no noncolliding signed tonic path to motor")?;
+            if original[middle] != 0. || original[output] != 0. {
+                return Err("counterbalance would overwrite an existing non-need path".into());
+            }
+            if original[first] != 8. {
+                return Err("frozen tonic source identity changed".into());
+            }
+            // Positive Homeostatic input, negative signed Modulatory state,
+            // positive MotorProposal output. No negative motor projection.
+            w[first] = 8.;
+            w[middle] = -8.;
+            w[output] = gain;
+            edits.push(json!({"role":"tonic_counterbalance","family":family,"motor":motor,"is_reference":motor==reference,"relay":relay,"first":first,"middle":middle,"output":output,"weights":[8.,-8.,gain]}));
+        }
+    }
+    for (i, s) in p.synapses().iter().enumerate() {
+        if s.kind() == CompiledSynapseKind::Recurrent
+            && p.projections()[s.route_index() as usize].projection_type()
+                == ProjectionType::MotorProposal
+            && w[i] < 0.
+        {
+            return Err("negative MotorProposal weight rejected".into());
+        }
+    }
+    Ok((w, edits))
+}
