index 0000000000000000000000000000000000000000..38376f8f5a93e3003b149850d709aedbf29b4407
--- /dev/null
+++ b/crates/alife_training/examples/qualify_motor_host_fixture.rs
@@ -0,0 +1,222 @@
+//! Fixed disposable canonical-host fixtures, NOT an autonomous scene assay.
+//! Runs only with --run-fixtures; never uses the reserved grounded R0 seed.
+#[allow(dead_code)]
+#[path = "support/grounded_developmental_recipe.rs"]
+mod recipe;
+use alife_core::*;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask};
+use alife_world::*;
+use serde_json::{json, Value};
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const SEED: u64 = 0x4D48_5431;
+fn wire<T: serde::Serialize>(x: &T) -> Result<Vec<u8>> {
+    Ok(serde_json::to_vec(x)?)
+}
+fn fixture(r: &recipe::R0Recipe, mode: MotorHostModeV1) -> Result<CpuMotorLobeHostV1> {
+    let trainer = CpuFoundationTrainer::new(
+        r.phenotype.clone(),
+        r.asset.clone(),
+        StageTrainableMask::recurrent_only(&r.phenotype)?,
+        AdamWConfig::default(),
+    )?;
+    // Test-owned nonzero optimizer state, without a training step or life import.
+    let mut state = trainer.checkpoint();
+    state.optimizer_step = 17;
+    state.update_ages[0] = 17;
+    state.first_moment[0] = 0.03125;
+    state.second_moment[0] = 0.0625;
+    let trainer =
+        CpuFoundationTrainer::from_checkpoint(r.phenotype.clone(), r.asset.clone(), state)?;
+    let mut game = create_grounded_drive_research_new_game(&r.config, &r.genotype)?;
+    let newborn = game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("missing newborn")?
+        .clone();
+    let mut world = HeadlessScenarioBuilder::new(SEED)
+        .agent("fixture", newborn.organism_id(), Vec3f::ZERO)
+        .build()?;
+    world.register_grounded_drive_research_record(newborn)?;
+    game.world = world;
+    let (host, ()) = CpuMotorLobeHostV1::new_prepared(
+        game,
+        trainer,
+        r.inputs.clone(),
+        SEED as u32,
+        mode,
+        |_| Ok::<(), String>(()),
+    )?;
+    Ok(host)
+}
+fn restore(v: Value, r: &recipe::R0Recipe, mode: MotorHostModeV1) -> Result<CpuMotorLobeHostV1> {
+    Ok(CpuMotorLobeHostV1::restore(
+        serde_json::from_value(v)?,
+        &r.inputs,
+        mode,
+    )?)
+}
+fn run() -> Result<Value> {
+    let r = recipe::build(SEED, false)?;
+    let (composite, _) = PhenotypeCompiler::compile_motor_lobe_m0(&r.inputs)?;
+    assert_eq!(&composite.synapses()[..34048], r.phenotype.synapses());
+    assert_eq!(
+        &composite.neuron_dynamics()[..2048],
+        r.phenotype.neuron_dynamics()
+    );
+    let mut full = fixture(&r, MotorHostModeV1::Full)?;
+    let initial = serde_json::to_value(full.checkpoint()?)?;
+    let optimizer = initial["founder"].clone();
+    let first = full.step(1.)?;
+    assert_eq!(first.decisions.len(), 1);
+    let f = &first.decisions[0];
+    assert_eq!(
+        f.motor.raw_drives,
+        f.patch
+            .pre_action()
+            .perception()
+            .homeostasis()
+            .drives
+            .to_array()
+    );
+    assert_eq!(
+        f.motor.frame_digest,
+        f.patch.pre_action().perception().frame_digest()
+    );
+    assert_eq!(f.motor.work.encoder_assignments, 22);
+    assert_eq!(f.motor.work.neuron_updates, f.motor.work.microsteps * 96);
+    assert_eq!(f.motor.work.branches, f.motor.work.microsteps * 70);
+    assert_eq!(f.motor.work.branch_inputs, f.motor.work.microsteps * 184);
+    assert!(f.motor.applied_body_energy_debit > 0.);
+    assert_eq!(
+        BrainActivityPolicyV1::grounded_drive_research_v1()
+            .cost
+            .q24_to_atp_q16_round_half_up(f.motor.reservation_q24)?,
+        f.motor.reservation_q16
+    );
+    let saved = serde_json::to_value(full.checkpoint()?)?;
+    assert_eq!(saved["founder"], optimizer);
+    let resident = &saved["canonical"]["residents"][0];
+    for key in ["activations", "inactive", "ema", "metabolic"] {
+        let bank = saved["controllers"]
+            .as_object()
+            .ok_or("missing controller map")?
+            .values()
+            .next()
+            .ok_or("empty controller map")?[key]
+            .as_array()
+            .ok_or("missing appended bank")?;
+        assert_eq!(bank.len(), 96);
+        assert!(bank.iter().any(|x| x.as_f64().unwrap() != 0.));
+    }
+    assert_eq!(
+        resident["neural"]["lifetime"].as_array().unwrap().len(),
+        34048
+    );
+    assert_eq!(
+        resident["neural"]["eligibility"].as_array().unwrap().len(),
+        34048
+    );
+    let mut cold = restore(saved.clone(), &r, MotorHostModeV1::Full)?;
+    let next_full = full.step(1.)?;
+    let next_cold = cold.step(1.)?;
+    assert_eq!(wire(&full.checkpoint()?)?, wire(&cold.checkpoint()?)?);
+    assert_eq!(
+        wire(&next_full.decisions[0].patch)?,
+        wire(&next_cold.decisions[0].patch)?
+    );
+    assert_eq!(
+        wire(&next_full.decisions[0].motor)?,
+        wire(&next_cold.decisions[0].motor)?
+    );
+    assert_eq!(
+        wire(&next_full.decisions[0].action)?,
+        wire(&next_cold.decisions[0].action)?
+    );
+    assert_eq!(
+        serde_json::to_value(full.checkpoint()?)?["founder"],
+        optimizer
+    );
+    let mut negatives = 0;
+    for path in [
+        "mode",
+        "recipe_digest",
+        "source_inputs",
+        "schema_version",
+        "policy",
+    ] {
+        let mut bad = saved.clone();
+        match path {
+            "mode" => bad[path] = json!("EqualWorkSham"),
+            "recipe_digest" => bad[path][0] = json!(0),
+            "source_inputs" => bad[path] = Value::Null,
+            "schema_version" => bad[path] = json!(2),
+            "policy" => bad[path] = json!("ordinary"),
+            _ => unreachable!(),
+        }
+        assert!(restore(bad, &r, MotorHostModeV1::Full).is_err());
+        negatives += 1;
+    }
+    for path in [
+        "mode",
+        "recipe_digest",
+        "activations",
+        "inactive",
+        "ema",
+        "metabolic",
+    ] {
+        let mut bad = saved.clone();
+        let state = bad["controllers"]
+            .as_object_mut()
+            .unwrap()
+            .values_mut()
+            .next()
+            .unwrap();
+        if path == "mode" {
+            state[path] = json!("EqualWorkSham");
+        } else if path == "recipe_digest" {
+            state[path][0] = json!(0);
+        } else {
+            state[path][0] = json!(0.123);
+        }
+        assert!(restore(bad, &r, MotorHostModeV1::Full).is_err());
+        negatives += 1;
+    }
+    let mut bad = saved.clone();
+    bad["controllers"] = json!({});
+    assert!(restore(bad, &r, MotorHostModeV1::Full).is_err());
+    negatives += 1;
+    // Imported old branches may never reach a fixed cell, even if all other
+    // resident fields are present. The normal class-5 validator remains active.
+    for target in [true, false] {
+        let mut bad = saved.clone();
+        let branch =
+            &mut bad["canonical"]["residents"][0]["neural"]["neural"]["dendrites"]["branches"][0];
+        if target {
+            branch["target"] = json!(2048);
+        } else {
+            branch["inputs"][0]["source"] = json!(2048);
+        }
+        assert!(restore(bad, &r, MotorHostModeV1::Full).is_err());
+        negatives += 1;
+    }
+    let mut sham = fixture(&r, MotorHostModeV1::EqualWorkSham)?;
+    let step = sham.step(1.)?;
+    for pair in &step.decisions[0].motor.encoded_pairs {
+        assert_eq!(pair[0].to_bits(), pair[1].to_bits());
+    }
+    assert_eq!(step.decisions[0].motor.work, first.decisions[0].motor.work);
+    // No claim about real-world rest or hunger from these admission fixtures.
+    Ok(
+        json!({"fixture_seed":SEED,"world_decisions":4,"negative_restores":negatives,"exact_next_full_checkpoint":true,"nonzero_optimizer_preserved":true,"source_recipe":r.metadata,"first_frame":f.motor,"cold_next_frame":next_cold.decisions[0].motor,"sham_frame":step.decisions[0].motor}),
+    )
+}
+fn main() -> Result<()> {
+    if std::env::args().nth(1).as_deref() != Some("--run-fixtures") {
+        println!("Fixed fresh canonical admission/restore fixtures only. Use --run-fixtures.");
+        return Ok(());
+    }
+    println!("{}", serde_json::to_string_pretty(&run()?)?);
+    Ok(())
+}
