+#[test]
+fn sleep_choice_actual_scoped_transaction_validates_sources_before_dedup_and_is_atomic() {
+    let config = MemoryBankConfig::new(8, 64, 4, 0.72, Confidence::new(0.0).unwrap()).unwrap();
+    let mut sidecar = MemorySidecarState::new_profiled(OWNER, identity(), config).unwrap();
+    let mut journal =
+        SleepReplayJournal::new(ReplayCapturePlan::try_new(vec![3], 1, 4, 4).unwrap()).unwrap();
+    let mut proofs = vec![];
+    let mut targets = vec![];
+    for (seq, op) in [(1, 3), (2, 3), (3, 3), (4, 700)] {
+        let patch = patch(seq, op, 0.7);
+        let (event, target) = source_pair(&patch);
+        let write = sidecar.observe_sealed_patch(&patch).unwrap();
+        proofs.push(SleepMemorySourceProofV1::capture(&patch, event, &target, write).unwrap());
+        journal.push(event, &[0.75]).unwrap();
+        targets.push(target);
+    }
+    let batch = journal.build_bounded_batch(4, 4, u32::MAX).unwrap();
+    let evidence = crate::sleep::SleepReplayEvidence::new(batch, targets).unwrap();
+    let consolidator = SleepConsolidator::new(SleepConsolidationConfig {
+        memory_max_records_after: 8,
+        ..SleepConsolidationConfig::reference()
+    })
+    .unwrap();
+    let mut predictor = crate::predictive::GroundedSuccessorPredictor::default();
+    let mut topo = topology();
+    let before = sidecar.clone();
+    let prediction_before = predictor.clone();
+    let topo_before = topo.clone();
+    assert!(sidecar
+        .run_bounded_sleep_transaction(
+            &consolidator,
+            &HomeostaticSnapshot::baseline(Tick::new(100)),
+            Tick::new(100),
+            &evidence,
+            &mut predictor,
+            &mut topo
+        )
+        .is_err());
+    let mut reversed = proofs.clone();
+    reversed.swap(0, 3);
+    assert!(sidecar
+        .run_bounded_sleep_transaction_scoped_v1(
+            &consolidator,
+            &HomeostaticSnapshot::baseline(Tick::new(100)),
+            Tick::new(100),
+            &evidence,
+            &reversed,
+            &mut predictor,
+            &mut topo
+        )
+        .is_err());
+    assert_eq!(sidecar, before);
+    assert_eq!(predictor, prediction_before);
+    assert_eq!(topo, topo_before);
+    let receipt = sidecar
+        .run_bounded_sleep_transaction_scoped_v1(
+            &consolidator,
+            &HomeostaticSnapshot::baseline(Tick::new(100)),
+            Tick::new(100),
+            &evidence,
+            &proofs,
+            &mut predictor,
+            &mut topo,
+        )
+        .unwrap()
+        .unwrap();
+    assert_eq!(receipt.status, crate::sleep::SleepWorkStatus::Consolidated);
+    // First/newest BodySleep and the distinct AwakeRest survive; interior merged
+    // sequence2 is not fabricated into replay provenance.
+    assert_eq!(receipt.replay_event_count, 3);
+    assert_eq!(
+        receipt.replay_digest,
+        sleep_memory_replay_digest_v1(&evidence, &proofs).unwrap()
+    );
+    assert_ne!(receipt.replay_digest, evidence.canonical_digest);
+    assert_eq!(sidecar.bank().candidate_store.records.len(), 2);
+}
