+fn source_pair(patch: &ExperiencePatch) -> (SleepReplayEvent, PredictionTargetReceipt) {
+    let key = patch.decision().episodic_key().unwrap();
+    let q = key.query();
+    let event = SleepReplayEvent {
+        sequence_id: patch.header().sequence_id,
+        originating_tick: q.tick(),
+        frame_digest: key.final_frame_digest(),
+        candidate_feature_digest: q.candidate_feature_digest(),
+        action_id: q.action_id(),
+        family: q.action_family(),
+        modulator: NeuromodulatorSample::from_components(0.4, 0.1, 0.2, 0.0, 0.3).unwrap(),
+    };
+    let condition = JointMotorCondition::new(vec![MotorChannelFactor {
+        channel: if matches!(q.action_kind(), ActionKind::Inspect | ActionKind::Look) {
+            MotorChannel::Orientation
+        } else {
+            MotorChannel::Posture
+        },
+        primitive: q.action_id(),
+        intensity: 1.0,
+        duration_ticks: 1,
+        direction: Vec3f::ZERO,
+        stand_off_distance: 0.0,
+        confidence: 0.9,
+        target: None,
+        payload: vec![],
+        coordination_group: 0,
+    }])
+    .unwrap();
+    let target = PredictionTargetReceipt::for_successor(
+        OWNER,
+        event.sequence_id,
+        q.action_id(),
+        Tick::new(q.tick().raw() + 1),
+        event.frame_digest.0,
+        SemanticStateVector::new(vec![0.5, 0.25]).unwrap(),
+        condition,
+        SemanticStateVector::new(vec![0.9, 0.1]).unwrap(),
+    )
+    .unwrap();
+    (event, target)
+}
+fn topology() -> TopologySidecar {
+    TopologySidecar::new_profiled(
+        OWNER,
+        identity(),
+        TopologicalMapConfig {
+            max_concepts: 16,
+            max_edges: 32,
+            max_simplexes: 16,
+            max_unresolved_gaps: 8,
+            edge_decay_per_tick: NormalizedScalar::new(0.05).unwrap(),
+        },
+    )
+    .unwrap()
+}
