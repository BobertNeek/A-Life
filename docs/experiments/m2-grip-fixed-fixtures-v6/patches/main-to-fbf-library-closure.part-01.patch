+++ b/crates/alife_training/examples/probe_motor_mediation_native_v1.rs
@@ -0,0 +1,205 @@
+//! Fixed arithmetic only. Builds fresh genetic B1 source, never a world host.
+#[allow(dead_code)]
+#[path = "support/recovery_sleep_recipe_v1.rs"]
+mod recipe;
+use alife_core::*;
+use alife_training::{cpu::*, *};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+fn digest<T: serde::Serialize>(x: &T) -> recipe::Result<String> {
+    Ok(format!("{:x}", Sha256::digest(serde_json::to_vec(x)?)))
+}
+fn evaluation_bits(e: &TrainingReplayEvaluation) -> [Vec<Vec<u32>>; 4] {
+    [
+        &e.candidate_logits,
+        &e.final_activations,
+        &e.final_activity_ema,
+        &e.final_metabolic_load,
+    ]
+    .map(|bank| {
+        bank.iter()
+            .map(|row| row.iter().map(|v| v.to_bits()).collect())
+            .collect()
+    })
+}
+fn main() -> recipe::Result<()> {
+    if !std::env::args().any(|x| x == "--run-fixtures") {
+        return Err("requires --run-fixtures; no sampled lives".into());
+    }
+    let r = recipe::build(0x4d32_2026, true)?;
+    let source = &r.phenotype;
+    let trainer = CpuFoundationTrainer::new(
+        source.clone(),
+        r.asset.clone(),
+        StageTrainableMask::recurrent_only(source)?,
+        AdamWConfig::default(),
+    )?;
+    // Fixture-owned sentinel only, not an imported life/checkpoint. This
+    // independent direct source control must retain exact integer ages/moments.
+    let mut sentinel = trainer.checkpoint();
+    sentinel.optimizer_step = 16_777_220;
+    sentinel.update_ages[0] = 16_777_217;
+    sentinel.first_moment[0] = 0.03125;
+    sentinel.second_moment[0] = 0.0625;
+    let trainer = CpuFoundationTrainer::from_checkpoint(source.clone(), r.asset.clone(), sentinel)?;
+    let checkpoint_before = trainer.checkpoint();
+    let fresh_state = MediationDetachedCpuV1::fresh(&r.inputs, &r.asset, MediationModeV1::Full)?;
+    let source_branch_count = fresh_state.source_state().dendrites.branches().len();
+    let source_branch_inputs: usize = fresh_state
+        .source_state()
+        .dendrites
+        .branches()
+        .iter()
+        .map(|b| b.inputs.len())
+        .sum();
+    let somatic_coordinates: Vec<_> = source.synapses().iter().enumerate().filter(|(_,s)| source.plasticity_receptors()[s.receptor_index() as usize].is_delta_enabled()).map(|(i,s)| json!({"index":i,"receptor_index":s.receptor_index(),"address":source.persistent_address_map().synapses()[i].address()})).collect();
+    let archived: Value = serde_json::from_str(include_str!(
+        "../../../docs/experiments/motor-mediation-native-v1/archived-arithmetic-frames.json"
+    ))?;
+    let mut outputs = vec![];
+    for (label, value) in archived["frames"].as_object().ok_or("missing frames")? {
+        let old: PerceptionFrame = serde_json::from_value(value.clone())?;
+        let profile = SensorProfile::GroundedObjectSlotsSleepChoiceV1;
+        // Explicit typed profile re-expression; no digest relabel or old replay use.
+        let frame = PerceptionFrame::new(
+            old.organism_id(),
+            old.tick(),
+            profile,
+            old.sensory().clone(),
+            old.body(),
+            *old.homeostasis(),
+            old.candidates().to_vec(),
+            SensorProfileProvenance::new(profile, SensoryAbiVersion::CURRENT, old.tick())?,
+            old.grounded_object_slots().to_vec(),
+        )?;
+        let derived = prepare_sleep_choice_grounded_drive_features_v1(&frame)?;
+        let drives = frame.homeostasis().drives.to_array();
+        let cs = frame
+            .candidates()
+            .iter()
+            .enumerate()
+            .map(|(i, c)| {
+                let mut inputs = [0.; 54];
+                inputs[..24].copy_from_slice(&c.features.0);
+                inputs[36..46].copy_from_slice(&derived[i]);
+                let family = source
+                    .candidate_decoder()
+                    .families()
+                    .iter()
+                    .find(|f| f.family() == c.family)
+                    .unwrap();
+                TrainingReplayCandidate {
+                    family: c.family,
+                    decoder_inputs: inputs,
+                    innate_bias: family.innate_contribution(frame.homeostasis().drives, c.features),
+                }
+            })
+            .collect();
+        let mut encoded = vec![0.; 2048];
+        for assignment in source.sensor_encoder().assignments() {
+            let value = if assignment.source_group() == SensorEncoderSourceGroup::Homeostasis {
+                drives
+                    .get(assignment.source_index() as usize)
+                    .copied()
+                    .unwrap_or(0.)
+            } else {
+                0.
+            };
+            let (lo, hi) = assignment.clamp_range();
+            encoded[assignment.target_neuron() as usize] +=
+                (value * assignment.scale() + assignment.bias()).clamp(lo, hi);
+        }
+        for value in &mut encoded {
+            *value = value.clamp(-1., 1.);
+        }
+        let tick = TrainingReplayTick {
+            encoded_inputs: encoded,
+            projection_gain: 0.5,
+            local_threshold_shift: 0.25,
+            microstep_count: 1,
+            enabled_routes: vec![true; source.projections().len()],
+            effective_weight_offsets: vec![0.; source.synapses().len()],
+            structural_synapses: vec![],
+            candidates: cs,
+        };
+        let mut full = MediationDetachedCpuV1::fresh(&r.inputs, &r.asset, MediationModeV1::Full)?;
+        let mut sham =
+            MediationDetachedCpuV1::fresh(&r.inputs, &r.asset, MediationModeV1::DriveSham)?;
+        let mut direct =
+            MediationDetachedCpuV1::fresh(&r.inputs, &r.asset, MediationModeV1::DirectSource)?;
+        let mut steps = vec![];
+        for step in 0..32 {
+            let q = TrainingSequence {
+                phenotype_hash: source.phenotype_hash(),
+                initial: full.source_state().clone(),
+                ticks: vec![tick.clone()],
+                burn_in_ticks: 0,
+                memory_candidate_gain: source
+                    .candidate_decoder()
+                    .memory_channel()
+                    .unwrap()
+                    .max_candidate_gain(),
+            };
+            let control = trainer.evaluate_replay(&q)?;
+            let a = full.step(
+                &frame,
+                tick.clone(),
+                &full.bind_rows(&frame, &tick)?,
+                Default::default(),
+                u64::MAX,
+            )?;
+            let b = sham.step(
+                &frame,
+                tick.clone(),
+                &sham.bind_rows(&frame, &tick)?,
+                Default::default(),
+                u64::MAX,
+            )?;
+            let c = direct.step(
+                &frame,
+                tick.clone(),
+                &direct.bind_rows(&frame, &tick)?,
+                Default::default(),
+                u64::MAX,
+            )?;
+            assert_eq!(
+                evaluation_bits(&a.source_evaluation),
+                evaluation_bits(&control)
+            );
+            assert_eq!(
+                evaluation_bits(&b.source_evaluation),
+                evaluation_bits(&control)
+            );
+            assert_eq!(
+                evaluation_bits(&c.source_evaluation),
+                evaluation_bits(&control)
+            );
+            assert_eq!(a.receipt.work, b.receipt.work);
+            assert_eq!(a.receipt.work, c.receipt.work);
+            assert_eq!(c.receipt.output_logits, control.candidate_logits[0]);
+            assert!(b.receipt.components.iter().all(|v| v[4] == 0.));
+            if step == 15 {
+                let bytes = serde_json::to_vec(&full.snapshot())?;
+                full = MediationDetachedCpuV1::restore(
+                    &r.inputs,
+                    &r.asset,
+                    MediationModeV1::Full,
+                    serde_json::from_slice(&bytes)?,
+                )?;
+            }
+            if step == 0 || step == 31 {
+                steps.push(json!({"source_microsteps":step+1,"receipt":a.receipt,"sham_logits":b.receipt.output_logits,"source_activations":control.final_activations[0],"source_ema":control.final_activity_ema[0],"source_metabolic":control.final_metabolic_load[0],"projected_decoder_derivatives_sha256":digest(&a.projected_core_decoder_derivatives)?}));
+            }
+        }
+        outputs.push(json!({"context":label,"original_frame_digest":old.frame_digest(),"new_typed_frame_digest":frame.frame_digest(),"steps":steps}));
+    }
+    assert_eq!(digest(&trainer.checkpoint())?, digest(&checkpoint_before)?);
+    let rows:Vec<_>=source.synapses().iter().enumerate().filter(|(_,s)|s.genetic_weight()!=0.).map(|(i,s)|json!({"index":i,"address":source.persistent_address_map().synapses()[i].address(),"synapse":s})).collect();
+    println!(
+        "{}",
+        serde_json::to_string_pretty(
+            &json!({"scope":"CPU detached native arithmetic; synthetic fixed context; no host, action sampling or learning", "source_recipe":r.metadata,"recipe_sha256":M2_RECIPE_SHA256,"source_nonzero_rows":rows,"source_synapse_count":source.synapses().len(),"source_neurons":source.neuron_count(),"controller_neurons":444,"controller_trainable_rows":0,"source_dynamic_branches":source_branch_count,"source_dynamic_branch_inputs":source_branch_inputs,"source_somatic_plastic_coordinates":somatic_coordinates,"source_recurrent_trainable_mask_rows":24576,"actual_optimizer_updates":0,"source_private_weight_offsets":0,"optimizer_unchanged":true,"sampled_actions":0,"world_steps":0,"source_prefix_bit_equality":true,"fixtures":outputs})
+        )?
+    );
+    Ok(())
+}
