@@ -0,0 +1,249 @@
+//! Frozen constructor copy from probe_weight_space_care.rs at 10eecff4.
+//! Source-only assay support. No rollout code is included.
+use alife_core::*;
+use alife_runtime::canonical_preparation::foundation_construction_development;
+use alife_world::*;
+use serde_json::json;
+use std::error::Error;
+type Result<T> = std::result::Result<T, Box<dyn Error>>;
+
+pub fn source(
+    seed: u64,
+    experimental: bool,
+) -> Result<(
+    CanonicalNewGameConfig,
+    BrainPhenotype,
+    FoundationWeightAsset,
+)> {
+    let mut config = CanonicalNewGameConfig::phase3(seed, 1)?;
+    config.brain_class = BrainScaleTier::Standard2048;
+    let asset = FoundationWeightAsset::builtin_n2048_v1(config.sensor_profile)?;
+    let game = create_canonical_new_game_with_n2048_candidate(&config, &asset)?;
+    let r = game.world.organism_registry().iter().next().unwrap();
+    let capacity = BrainCapacityClass::n2048();
+    let genome = r.phenotype().brain_genome.clone();
+    let development = foundation_construction_development(
+        &genome,
+        &capacity,
+        &r.phenotype().development_state_at(Tick::ZERO)?,
+    )?;
+    if experimental {
+        let (p, _) = PhenotypeCompiler::compile_n2048_experimental_graph(
+            genome.clone(),
+            development.clone(),
+            config.sensor_profile,
+        )?;
+        let asset = FoundationWeightAsset::from_trained_weights(
+            &p,
+            p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+            TrainingStageManifest::bootstrap(),
+        )?;
+        let (p, _) = PhenotypeCompiler::compile_n2048_experimental_foundation_candidate(
+            genome,
+            development,
+            asset.clone(),
+        )?;
+        return Ok((config, p, asset));
+    }
+    let p = PhenotypeCompiler::compile(&genome, &capacity, &development, config.sensor_profile)?;
+    let asset = FoundationWeightAsset::from_trained_weights(
+        &p,
+        p.synapses().iter().map(|s| s.genetic_weight()).collect(),
+        asset.manifest().training_stage(),
+    )?;
+    let (p, _) =
+        PhenotypeCompiler::compile_n2048_foundation_candidate(genome, development, asset.clone())?;
+    Ok((config, p, asset))
+}
+// Whole-weight revision 6. Feedback-informed: explicit signed tonic/need circuits
+// and a native reference motor population; never an external action policy.
+pub fn whole_care(p: &BrainPhenotype) -> Result<(Vec<f32>, Vec<serde_json::Value>)> {
+    whole_care_with_contact(p, -2.)
+}
+fn whole_care_with_contact(
+    p: &BrainPhenotype,
+    contact_coefficient: f32,
+) -> Result<(Vec<f32>, Vec<serde_json::Value>)> {
+    use std::collections::BTreeSet;
+    let mut w = vec![0.; p.synapses().len()];
+    let mut circuits = Vec::new();
+    let mut incoming = vec![0usize; p.neuron_count() as usize];
+    let mut outgoing = vec![Vec::new(); p.neuron_count() as usize];
+    for (i, s) in p.synapses().iter().enumerate() {
+        if s.kind() == CompiledSynapseKind::Recurrent {
+            incoming[s.target() as usize] += 1;
+            outgoing[s.source() as usize].push(i);
+        }
+    }
+    for (i, s) in p.synapses().iter().enumerate() {
+        if s.kind() != CompiledSynapseKind::Recurrent {
+            continue;
+        }
+        let route = &p.projections()[s.route_index() as usize];
+        if route.projection_type() == ProjectionType::LateralInhibition {
+            w[i] = -0.03;
+        } else if [
+            LobeKind::WorkingContextExecutive,
+            LobeKind::MemoryInterface,
+            LobeKind::MultimodalAssociation,
+        ]
+        .contains(&route.source_lobe())
+            || [
+                LobeKind::WorkingContextExecutive,
+                LobeKind::MemoryInterface,
+                LobeKind::MultimodalAssociation,
+            ]
+            .contains(&route.target_lobe())
+        {
+            w[i] = 0.12 / incoming[s.target() as usize] as f32;
+        }
+    }
+    let intero = p
+        .lobe_layout()
+        .region(LobeKind::InteroceptiveMotivational)
+        .unwrap();
+    let reserve = p.lobe_layout().region(LobeKind::FlexibleReserve).unwrap();
+    let tonic_source = (intero.start..intero.start + intero.len)
+        .rev()
+        .find(|n| {
+            !p.sensor_encoder()
+                .assignments()
+                .iter()
+                .any(|a| a.target_neuron() == *n)
+        })
+        .ok_or("no unsensed tonic neuron")?;
+    let tonic_reserve = reserve.start + 15;
+    let tonic_first = *outgoing[tonic_source as usize]
+        .iter()
+        .find(|&&i| p.synapses()[i].route_index() == 2 && p.synapses()[i].target() == tonic_reserve)
+        .ok_or("tonic input route absent")?;
+    let mut need_axes = std::collections::BTreeMap::<u16, (u32, u32)>::new();
+    for (family, lanes) in [
+        (CandidateActionFamily::Ingest, vec![0]),
+        (CandidateActionFamily::Approach, vec![0]),
+        (CandidateActionFamily::Rest, vec![1]),
+        (CandidateActionFamily::Avoid, vec![3, 2]),
+        (CandidateActionFamily::Inspect, vec![5]),
+        (CandidateActionFamily::Contact, vec![5]),
+    ] {
+        let motors = p
+            .synapses()
+            .iter()
+            .filter_map(|s| match s.kind() {
+                CompiledSynapseKind::Decoder(c)
+                    if c.head() == DecoderHeadKind::ActionCandidate && c.family() == family =>
+                {
+                    Some(s.source())
+                }
+                _ => None,
+            })
+            .collect::<BTreeSet<_>>();
+        let reference = *motors.last().unwrap();
+        let mut selected = BTreeSet::new();
+        for lane in lanes {
+            let input = p
+                .sensor_encoder()
+                .assignments()
+                .iter()
+                .find(|a| {
+                    a.source_group() == SensorEncoderSourceGroup::Homeostasis
+                        && a.source_index() == lane
+                })
+                .ok_or("essential homeostatic port absent")?
+                .target_neuron();
+            let mut found = None;
+            'paths: for &first in &outgoing[input as usize] {
+                let first_edge = &p.synapses()[first];
+                if first_edge.route_index() != 2
+                    || first_edge.target() == tonic_reserve
+                    || need_axes
+                        .iter()
+                        .any(|(other, (r, _))| *other != lane && *r == first_edge.target())
+                    || need_axes
+                        .get(&lane)
+                        .is_some_and(|(r, _)| *r != first_edge.target())
+                {
+                    continue;
+                }
+                for &second in &outgoing[first_edge.target() as usize] {
+                    let second_edge = &p.synapses()[second];
+                    if second_edge.route_index() != 3
+                        || need_axes
+                            .iter()
+                            .any(|(other, (_, t))| *other != lane && *t == second_edge.target())
+                        || need_axes
+                            .get(&lane)
+                            .is_some_and(|(_, t)| *t != second_edge.target())
+                    {
+                        continue;
+                    }
+                    let Some(&tonic_second) = outgoing[tonic_reserve as usize].iter().find(|&&i| {
+                        p.synapses()[i].route_index() == 3
+                            && p.synapses()[i].target() == second_edge.target()
+                    }) else {
+                        continue;
+                    };
+                    for &third in &outgoing[second_edge.target() as usize] {
+                        let target = p.synapses()[third].target();
+                        if p.synapses()[third].route_index() == 5
+                            && motors.contains(&target)
+                            && target != reference
+                        {
+                            found = Some((first, second, third, tonic_second, target));
+                            break 'paths;
+                        }
+                    }
+                }
+            }
+            let (first, second, third, tonic_second, motor) =
+                found.ok_or("compatible tonic and need circuit absent")?;
+            need_axes.insert(
+                lane,
+                (p.synapses()[first].target(), p.synapses()[second].target()),
+            );
+            w[first] = 2.;
+            w[second] = 2.;
+            w[third] = 4.;
+            w[tonic_first] = 8.;
+            w[tonic_second] = -4.;
+            selected.insert(motor);
+            circuits.push(json!({"role":"need","family":family,"homeostatic_lane":lane,"source_neuron":input,"motor_neuron":motor,"bridge_synapses":[first,second],"output_synapse":third}));
+            circuits.push(json!({"role":"tonic","family":family,"source_neuron":tonic_source,"motor_neuron":motor,"bridge_synapses":[tonic_first,tonic_second],"output_synapse":third}));
+        }
+        for (i, synapse) in p.synapses().iter().enumerate() {
+            let CompiledSynapseKind::Decoder(c) = synapse.kind() else {
+                continue;
+            };
+            if c.head() != DecoderHeadKind::ActionCandidate || c.family() != family {
+                continue;
+            }
+            let coefficient = match (family, c.input_lane()) {
+                (CandidateActionFamily::Ingest, 15) => 12.,
+                (CandidateActionFamily::Ingest, 2) => -6.,
+                (CandidateActionFamily::Approach, 15) => 4.,
+                (CandidateActionFamily::Approach, 2) => -2.,
+                (CandidateActionFamily::Approach, 18) => contact_coefficient,
+                (CandidateActionFamily::Rest, 23) => 2.,
+                (CandidateActionFamily::Avoid, 15) => -10.,
+                (CandidateActionFamily::Inspect, 6..=8) => 0.5,
+                (CandidateActionFamily::Contact, 15) => 2.,
+                _ => 0.,
+            };
+            if selected.contains(&synapse.source()) {
+                w[i] = coefficient;
+            }
+            if synapse.source() == reference {
+                let reference_gain = match family {
+                    CandidateActionFamily::Approach | CandidateActionFamily::Inspect => 5.,
+                    CandidateActionFamily::Rest => -1.,
+                    _ => -5.,
+                };
+                if coefficient != 0. {
+                    w[i] = reference_gain * selected.len() as f32 * coefficient;
+                }
+            }
+        }
+        circuits.push(json!({"role":"reference","family":family,"reference_motor":reference,"signal_motors":selected}));
+    }
+    Ok((w, circuits))
+}
diff --git a/crates/alife_training/examples/support/recovery_sleep_recipe_v1.rs b/crates/alife_training/examples/support/recovery_sleep_recipe_v1.rs
new file mode 100644
index 0000000000000000000000000000000000000000..c72b34ec19674589f65ce0f24d958a4ae3006271
--- /dev/null
+++ b/crates/alife_training/examples/support/recovery_sleep_recipe_v1.rs
@@ -0,0 +1,273 @@
+//! Fresh B1 plus explicitly inherited bounded memory reader and four motor heads.
+//! No archived life, learned checkpoint, concentration patch or training input.
+#[allow(dead_code)]
+#[path = "grounded_r0_dedicated_fatigue.rs"]
+mod dedicated;
+#[allow(dead_code)]
+#[path = "multidrive_frozen.rs"]
+mod frozen;
+#[allow(dead_code)]
+#[path = "grounded_r0_motor_operating_point.rs"]
+mod readout;
+use alife_core::*;
+use alife_runtime::canonical_preparation::foundation_construction_development;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask};
+use alife_world::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+pub type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+pub struct Recipe {
+    pub config: CanonicalNewGameConfig,
+    pub genotype: CreatureGenome,
+    pub phenotype: BrainPhenotype,
+    pub asset: FoundationWeightAsset,
+    pub inputs: PhenotypeCompilerInputs,
+    pub metadata: Value,
+}
+pub fn build(seed: u64, timer: bool) -> Result<Recipe> {
+    let mut config = CanonicalNewGameConfig::phase3(seed, 1)?;
+    config.brain_class = BrainScaleTier::Standard2048;
+    let builtin = FoundationWeightAsset::builtin_n2048_v1(config.sensor_profile)?;
+    let original = create_canonical_new_game_with_n2048_candidate(&config, &builtin)?;
+    let mut genotype = original
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("missing newborn")?
+        .genome()
+        .clone();
+    // These are new inherited genes before this source's expression/compilation.
+    let a = genotype.brain.construction.maternal_architecture;
+    let heads = alife_core::genome::CognitiveArchitectureGenomeParameters::try_new_v1(
+        a.attention_capacity(),
+        a.active_concept_limit(),
+        a.active_gap_limit(),
+        a.predictor_capacity(),
+        a.predictor_learning_rate(),
+        4,
+        a.motor_head_width(),
+        a.dendritic_branch_capacity(),
+        a.structural_candidate_budget(),
+        a.structural_edit_budget(),
+        a.sleep_trigger_threshold(),
+        a.sleep_replay_rate(),
+        a.sleep_consolidation_rate(),
+        a.attention_learning_rate(),
+        a.concept_learning_rate(),
+        a.motor_learning_rate(),
+        a.structural_learning_rate(),
+    )?;
+    genotype.brain.construction.maternal_architecture = heads;
+    genotype.brain.construction.paternal_architecture = heads;
+    genotype.chemistry.graph = genotype
+        .chemistry
+        .graph
+        .with_awake_rest_recovery_v1(AlleleSide::Maternal)?
+        .with_awake_rest_recovery_v1(AlleleSide::Paternal)?;
+    if timer {
+        genotype.chemistry.graph = genotype
+            .chemistry
+            .graph
+            .with_recovery_timescale_v1(AlleleSide::Maternal)?
+            .with_recovery_timescale_v1(AlleleSide::Paternal)?;
+    }
+    let expressed = genotype.express()?;
+    let genome = expressed.brain_genome.clone();
+    let development = foundation_construction_development(
+        &genome,
+        &BrainCapacityClass::n2048(),
+        &expressed.development_state_at(Tick::ZERO)?,
+    )?;
+    let (bounded, _) = PhenotypeCompiler::compile_n2048_bounded_founder(
+        genome.clone(),
+        development.clone(),
+        config.sensor_profile,
+    )?;
+    let (weights, circuits) = frozen::whole_care(&bounded)?;
+    let (weights, differential) = readout::counterbalance(&bounded, &weights, &circuits, 0., true)?;
+    let (weights, references) =
+        dedicated::full_reference_calibration(&bounded, &weights, &circuits, true)?;
+    let (mut weights, dedicated_b) =
+        dedicated::build(&bounded, &weights, dedicated::Factor::Dedicated)?;
+    let mut reader = Vec::new();
+    for (index, synapse) in bounded.synapses().iter().enumerate() {
+        if matches!(synapse.kind(), CompiledSynapseKind::Decoder(c) if c.head() == DecoderHeadKind::MemoryContext)
+        {
+            if weights[index] != 0. {
+                return Err("archived B1 reader is no longer zero".into());
+            }
+            weights[index] = synapse.genetic_weight();
+            reader.push(json!({"bounded_index":index,"address":bounded.persistent_address_map().synapses()[index].address(),"b1":0.,"composed":weights[index]}));
+        }
+    }
+    if reader.len() != 4096
+        || reader
+            .iter()
+            .filter(|r| r["composed"].as_f64() != Some(0.))
+            .count()
+            != 592
+    {
+        return Err("qualified bounded reader coordinates changed".into());
+    }
+    let source_asset = FoundationWeightAsset::from_trained_weights(
+        &bounded,
+        weights,
+        TrainingStageManifest::bootstrap(),
+    )?;
+    let m = source_asset.manifest();
+    genotype.foundation = FoundationGeneticIdentity::new(
+        m.foundation_id().raw(),
+        m.foundation_version().raw() as u16,
+        m.compatibility_family_id().raw(),
+        BrainCapacityClass::N2048_ID,
+    )?;
+    genotype.n2048_foundation_candidate = Some(source_asset.clone());
+    genotype.validate_contract()?;
+    if genotype.express()?.brain_genome != genome {
+        return Err("asset binding changed inherited brain".into());
+    }
+    let (source, source_inputs) = PhenotypeCompiler::compile_n2048_bounded_founder_candidate(
+        genome,
+        development,
+        source_asset.clone(),
+    )?;
+    let transfer = alife_training::transfer_bounded_genetic_founder_to_grounded_drive(
+        &source,
+        &source_inputs,
+        &source_asset,
+    )?;
+    if transfer.added_zero_rows != 1280 {
+        return Err("grounded transfer changed".into());
+    }
+    for row in &mut reader {
+        let index = row["bounded_index"]
+            .as_u64()
+            .ok_or("reader index missing")? as u32;
+        let (_, target) = transfer
+            .source_to_target
+            .iter()
+            .find(|(source, _)| *source == index)
+            .ok_or("reader transfer row missing")?;
+        let weight = transfer.asset.weights()[*target as usize];
+        if weight.to_bits() != source_asset.weights()[index as usize].to_bits() {
+            return Err("reader weight changed during transfer".into());
+        }
+        row["grounded_index"] = json!(target);
+        row["grounded_address"] = json!(transfer.phenotype.persistent_address_map().synapses()
+            [*target as usize]
+            .address());
+    }
+    let reader_max = reader
+        .iter()
+        .map(|r| r["composed"].as_f64().unwrap().abs())
+        .fold(0_f64, f64::max) as f32;
+    if reader_max.to_bits() != 0.01375_f32.to_bits() {
+        return Err("bounded reader maximum differs".into());
+    }
+    let reader_sha256 = format!("{:x}", Sha256::digest(serde_json::to_vec(&reader)?));
+    let genotype = CreatureGenome::from_n2048_grounded_drive_transfer(
+        &genotype,
+        &transfer.inputs,
+        transfer.asset.clone(),
+    )?;
+    genotype.validate_n2048_grounded_drive_inputs(&transfer.inputs)?;
+    if transfer
+        .phenotype
+        .cognitive_architecture()
+        .motor_head_count()
+        != 4
+        || !transfer
+            .phenotype
+            .candidate_decoder()
+            .factorized_motor_channels(&transfer.phenotype)?
+            .contains(&MotorChannel::Posture)
+        || genotype
+            .express_n2048_grounded_drive_research()?
+            .chemistry
+            .biochemical
+            .value_profile()
+            .hormones[8]
+            != 0.
+    {
+        return Err("composed birth capability or valuation mismatch".into());
+    }
+    let metadata = json!({"recipe":"B1+bounded-reader+four-head+awake-rest-v1", "seed":seed,"timer":timer,
+        "b1_recipe":"whole-care6/counterbalance/full references/dedicated fatigue B/tonic-on",
+        "reader_is_authored_not_learned":true,"reader_rows":reader,"reader_sha256":reader_sha256,"differential":differential,"references":references,"dedicated_b":dedicated_b,
+        "source_asset":source_asset.digest(),"target_asset":transfer.asset.digest(),"inputs":transfer.inputs.canonical_digest(),
+        "phenotype":transfer.phenotype.phenotype_hash(),"added_zero_rows":transfer.added_zero_rows,
+        "reader_max_abs":reader_max,"genotype_sha256":format!("{:x}",Sha256::digest(serde_json::to_vec(&genotype)?)),"expressed_graph":genotype.express_n2048_grounded_drive_research()?.chemistry.biochemical,"pressure_value":0.,"world_steps":0,"neural_steps":0,"optimizer_steps":0});
+    Ok(Recipe {
+        config,
+        genotype,
+        phenotype: transfer.phenotype,
+        asset: transfer.asset,
+        inputs: transfer.inputs,
+        metadata,
+    })
+}
+pub fn host(
+    recipe: &Recipe,
+    mode: SleepChoiceMotorModeV1,
+    preparation: u64,
+    sentinel: bool,
+) -> Result<CpuSleepChoiceHostV1> {
+    let mut trainer = CpuFoundationTrainer::new(
+        recipe.phenotype.clone(),
+        recipe.asset.clone(),
+        StageTrainableMask::recurrent_only(&recipe.phenotype)?,
+        AdamWConfig::default(),
+    )?;
+    if sentinel {
+        let mut state = trainer.checkpoint();
+        state.optimizer_step = 23;
+        state.update_ages[0] = 23;
+        state.first_moment[0] = 0.03125;
+        state.second_moment[0] = 0.0625;
+        trainer = CpuFoundationTrainer::from_checkpoint(
+            recipe.phenotype.clone(),
+            recipe.asset.clone(),
+            state,
+        )?;
+    }
+    let mut game = create_grounded_drive_research_new_game(&recipe.config, &recipe.genotype)?;
+    let newborn = game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("missing newborn")?
+        .clone();
+    let mut world = HeadlessScenarioBuilder::new(recipe.config.world_seed)
+        .agent("learner", newborn.organism_id(), Vec3f::ZERO)
+        .build()?;
+    world.register_grounded_drive_research_record(newborn)?;
+    game.world = world;
+    let seed = (recipe.config.world_seed ^ (recipe.config.world_seed >> 32)) as u32;
+    let (host, ()) = CpuSleepChoiceHostV1::new_prepared(
+        game,
+        trainer,
+        recipe.inputs.clone(),
+        seed,
+        mode,
+        |world| -> Result<()> {
+            for _ in 0..preparation {
+                world.try_advance_tick()?;
+            }
+            if world.age_death_disabled()
+                || !world
+                    .organism_registry()
+                    .iter()
+                    .next()
+                    .ok_or("missing prepared body")?
+                    .lifecycle()
+                    .is_alive()
+            {
+                return Err("normal lifetime preparation failed".into());
+            }
+            Ok(())
+        },
+    )?;
+    Ok(host)
+}
