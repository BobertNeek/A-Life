+#[test]
+fn sleep_choice_proof_capture_rejects_other_operation_receipt_and_mutated_target() {
+    let p = patch(1, 3, 0.7);
+    let (event, target) = source_pair(&p);
+    let mut b = bank(8);
+    let write = b.observe_sealed_patch(&p).unwrap();
+    let proof = SleepMemorySourceProofV1::capture(&p, event, &target, write).unwrap();
+    let encoded = serde_json::to_vec(&proof).unwrap();
+    let restored: SleepMemorySourceProofV1 = serde_json::from_slice(&encoded).unwrap();
+    restored.validate_against(&event, &target).unwrap();
+    let binary = bincode::serde::encode_to_vec(&proof, bincode::config::standard()).unwrap();
+    let (binary_restored, consumed): (SleepMemorySourceProofV1, usize) =
+        bincode::serde::decode_from_slice(&binary, bincode::config::standard()).unwrap();
+    assert_eq!(consumed, binary.len());
+    binary_restored.validate_against(&event, &target).unwrap();
+
+    assert_eq!(
+        restored.resolve(&b).unwrap(),
+        Some(b.candidate_store.records.values().next().unwrap().memory_id)
+    );
+    let mut wrong = write;
+    wrong.bucket.other_action_id_raw = 700;
+    assert!(SleepMemorySourceProofV1::capture(&p, event, &target, wrong).is_err());
+    let mut wrong_event = event;
+    wrong_event.action_id = ActionId(700);
+    assert!(proof.validate_against(&wrong_event, &target).is_err());
+    let mut wrong_target = target.clone();
+    wrong_target.decision = ActionId(700);
+    assert!(proof.validate_against(&event, &wrong_target).is_err());
+    let mut evicted = b.clone();
+    evicted.candidate_store.records.clear();
+    evicted.candidate_store.rebuild_indices();
+    assert_eq!(proof.resolve(&evicted).unwrap(), None);
+    let mut opposite = b.clone();
+    opposite
+        .candidate_store
+        .records
+        .values_mut()
+        .next()
+        .unwrap()
+        .action_id_raw = 700;
+    assert!(proof.resolve(&opposite).is_err());
+}
