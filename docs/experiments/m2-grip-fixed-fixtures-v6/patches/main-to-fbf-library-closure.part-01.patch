+    .unwrap();
+    assert_eq!(restored.bank().candidate_store.records.len(), 2);
+    for mut bad in active.records.clone() {
+        bad.action_id_raw = 99;
+        bad.canonical_digest = bad.recompute_canonical_digest().unwrap();
+        // Recompute the portable record seal: rejection must be semantic, not
+        // merely a stale digest. The active store also validates on import.
+        let mut invalid_asset = active.clone();
+        invalid_asset.records[0] = bad;
+        invalid_asset.canonical_digest = invalid_asset.recompute_canonical_digest().unwrap();
+        assert!(invalid_asset.validate_contract().is_err());
+        assert!(MemorySidecarState::restore_portable(
+            identity(),
+            *sidecar.compaction_checkpoint(),
+            invalid_asset,
+            None
+        )
+        .is_err());
+    }
+}
