+//! Sealed, fresh-founder M0 motor mediation recipe. This ABI is intentionally
+//! detached-only: no live organism, checkpoint migration, optimizer or GPU
+//! upload is admitted. It preserves the complete class-5 prefix and adds a
+//! fixed head; it does not centralize legacy proposal, innate or memory paths.
+use crate::{
+    BrainCapacityClass, CanonicalDigestBuilder, DendriticBranch, DendriticBranchSet,
+    DendriticInputRef, FoundationAbiSelection, PhenotypeCompilerInputs, ScaffoldContractError,
+    SensorProfile,
+};
+use serde::{Deserialize, Serialize};
+
