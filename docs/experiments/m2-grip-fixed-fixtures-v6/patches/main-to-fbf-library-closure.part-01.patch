diff --git a/crates/alife_core/src/sleep_choice.rs b/crates/alife_core/src/sleep_choice.rs
new file mode 100644
index 0000000000000000000000000000000000000000..9830e4c2136504ea07290748bf18c28926489298
--- /dev/null
+++ b/crates/alife_core/src/sleep_choice.rs
@@ -0,0 +1,260 @@
+//! Explicit fresh-only CPU M1 contract. This descriptor is not a positional
+//! foundation selector and never changes the stored class-5 source identity.
+use crate::*;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct SleepChoiceM1V1 {
+    schema_version: u16,
+    selector_tag: u16,
+    runtime_profile_raw: u16,
+    composite_class_raw: u16,
+    foundation_id_raw: u64,
+    compatibility_family_raw: u64,
+    source_lineage: String,
+    source_inputs: Box<PhenotypeCompilerInputs>,
+    recipe_digest: [u64; 4],
+}
+// Source selectors are deliberately opaque until the outer lineage is checked.
+// This applies to direct public descriptor decoding as well as host envelopes,
+// including binary sequence formats and arbitrarily ordered JSON object keys.
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SleepChoiceDescriptorWireV1 {
+    schema_version: u16,
+    selector_tag: u16,
+    runtime_profile_raw: u16,
+    composite_class_raw: u16,
+    foundation_id_raw: u64,
+    compatibility_family_raw: u64,
+    source_lineage: String,
+    recipe_digest: [u64; 4],
+    source_inputs_json: String,
+}
+impl Serialize for SleepChoiceM1V1 {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.validate().map_err(serde::ser::Error::custom)?;
+        SleepChoiceDescriptorWireV1 {
+            schema_version: self.schema_version,
+            selector_tag: self.selector_tag,
+            runtime_profile_raw: self.runtime_profile_raw,
+            composite_class_raw: self.composite_class_raw,
+            foundation_id_raw: self.foundation_id_raw,
+            compatibility_family_raw: self.compatibility_family_raw,
+            source_lineage: self.source_lineage.clone(),
+            recipe_digest: self.recipe_digest,
+            source_inputs_json: serde_json::to_string(&self.source_inputs)
+                .map_err(serde::ser::Error::custom)?,
+        }
+        .serialize(serializer)
+    }
+}
+impl<'de> Deserialize<'de> for SleepChoiceM1V1 {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let wire = SleepChoiceDescriptorWireV1::deserialize(deserializer)?;
+        // No source enum has been interpreted yet: source_inputs_json is data.
+        if wire.schema_version != 1
+            || wire.selector_tag != Self::SELECTOR_TAG
+            || wire.runtime_profile_raw != 5
+            || wire.composite_class_raw != 7
+            || wire.foundation_id_raw != Self::FOUNDATION_ID.raw()
+            || wire.compatibility_family_raw != Self::COMPATIBILITY_FAMILY.raw()
+            || wire.source_lineage != Self::SOURCE_LINEAGE
+            || wire.recipe_digest != Self::recipe_digest()
+        {
+            return Err(serde::de::Error::custom(
+                "unknown M1 descriptor lineage or contract",
+            ));
+        }
+        let source: PhenotypeCompilerInputs =
+            serde_json::from_str(&wire.source_inputs_json).map_err(serde::de::Error::custom)?;
+        Self::fresh(&source).map_err(serde::de::Error::custom)
+    }
+}
+impl SleepChoiceM1V1 {
+    pub const SELECTOR_TAG: u16 = 12;
+    pub const FOUNDATION_ID: FoundationId = FoundationId::N2144_SLEEP_CHOICE_M1_V1;
+    pub const COMPATIBILITY_FAMILY: FoundationCompatibilityFamilyId =
+        FoundationCompatibilityFamilyId::N2144_SLEEP_CHOICE_M1;
+    pub const SOURCE_LINEAGE: &'static str = "alife.grounded-drive.class5.m0-lineage.v1";
+    pub const BASE_SYNAPSES: usize = MotorLobeM0V1::BASE_SYNAPSES;
+    pub const NEW_READOUTS: usize = 52;
+    pub const NEW_BRANCHES: usize = 72;
+    pub const NEW_BRANCH_INPUTS: usize = 188;
+    pub const ENCODER_ASSIGNMENTS: usize = 24;
+    pub fn fresh(source: &PhenotypeCompilerInputs) -> Result<Self, ScaffoldContractError> {
+        MotorLobeM0V1::fresh(source)?;
+        if source.sensor_profile() != SensorProfile::GroundedObjectSlotsV1
+            || source
+                .genome()
+                .cognitive_architecture()
+                .dendritic_branch_capacity()
+                < 136
+        {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        Ok(Self {
+            schema_version: 1,
+            selector_tag: Self::SELECTOR_TAG,
+            runtime_profile_raw: 5,
+            composite_class_raw: 7,
+            foundation_id_raw: Self::FOUNDATION_ID.raw(),
+            compatibility_family_raw: Self::COMPATIBILITY_FAMILY.raw(),
+            source_lineage: Self::SOURCE_LINEAGE.into(),
+            source_inputs: Box::new(source.clone()),
+            recipe_digest: Self::recipe_digest(),
+        })
+    }
+    /// M1's private composite identity, distinct from the preserved class-5
+    /// source foundation selection returned by the transient phenotype.
+    pub const fn foundation_id(&self) -> FoundationId {
+        Self::FOUNDATION_ID
+    }
+    pub const fn compatibility_family_id(&self) -> FoundationCompatibilityFamilyId {
+        Self::COMPATIBILITY_FAMILY
+    }
+    /// The biological/source compiler provenance keeps its original foundation.
+    pub fn source_inputs(&self) -> &PhenotypeCompilerInputs {
+        &self.source_inputs
+    }
+    pub fn pressure_reference(&self) -> f32 {
+        self.reference()
+    }
+    pub fn reference(&self) -> f32 {
+        self.source_inputs
+            .genome()
+            .cognitive_architecture()
+            .sleep_trigger_threshold()
+    }
+    pub fn validate(&self) -> Result<(), ScaffoldContractError> {
+        if *self != Self::fresh(&self.source_inputs)? {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        Ok(())
+    }
+    pub fn compile(&self) -> Result<BrainPhenotype, ScaffoldContractError> {
+        self.validate()?;
+        BrainPhenotype::lower_sleep_choice_m1(self)
+    }
+    pub fn validate_phenotype(
+        &self,
+        phenotype: &BrainPhenotype,
+    ) -> Result<(), ScaffoldContractError> {
+        if *phenotype != self.compile()? {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        Ok(())
+    }
+    pub fn canonical_digest(&self) -> [u64; 4] {
+        let mut d = CanonicalDigestBuilder::new(b"alife.sleep-choice.m1.descriptor.v1");
+        d.write_u16(self.schema_version);
+        d.write_u16(self.selector_tag);
+        d.write_u16(self.runtime_profile_raw);
+        d.write_u16(self.composite_class_raw);
+        d.write_u64(self.foundation_id_raw);
+        d.write_u64(self.compatibility_family_raw);
+        d.write_bytes(self.source_lineage.as_bytes());
+        for x in self.source_inputs.canonical_digest() {
+            d.write_u64(x);
+        }
+        for x in self.recipe_digest {
+            d.write_u64(x);
+        }
+        d.finish256()
+    }
+    pub fn recipe_digest() -> [u64; 4] {
+        let mut d = CanonicalDigestBuilder::new(b"alife.sleep-choice.m1.fixed.native55.v1");
+        d.write_u64(Self::FOUNDATION_ID.raw());
+        d.write_u64(Self::COMPATIBILITY_FAMILY.raw());
+        for x in MotorLobeM0V1::recipe_digest() {
+            d.write_u64(x);
+        }
+        // All M0 assignments/branches/readouts remain exact. Explicit appended
+        // pressure lane, paired reference, opponent branches and signed head.
+        for x in [
+            12, 5, 7, 2144, 2048, 96, 24, 72, 188, 52, 55, 54, 19, 2140, 2141, 2142, 2143,
+        ] {
+            d.write_u32(x);
+        }
+        for x in [1_f32, 0., 4., -4., 32., 4., 16., 4., 4.] {
+            d.write_u32(x.to_bits());
+        }
+        d.write_bytes(b"reference=compiled-source-sleep-trigger;affine-before-common-gain;no-controller-plasticity");
+        d.finish256()
+    }
+    pub fn fixed_branches(&self) -> Result<DendriticBranchSet, ScaffoldContractError> {
+        self.validate()?;
+        let mut branches = MotorLobeM0V1::fresh(&self.source_inputs)?
+            .fixed_branches()?
+            .branches()
+            .to_vec();
+        for (target, a, b) in [(2142, 2140, 2141), (2143, 2141, 2140)] {
+            branches.push(DendriticBranch::new(
+                target,
+                0.,
+                1.,
+                vec![
+                    DendriticInputRef::new(a, 4.)?,
+                    DendriticInputRef::new(b, -4.)?,
+                ],
+            )?);
+        }
+        DendriticBranchSet::new(branches)
+    }
+    pub fn readout_count(family: CandidateActionFamily) -> usize {
+        MotorLobeM0V1::readout_count(family)
+            + if family == CandidateActionFamily::Rest {
+                2
+            } else {
+                0
+            }
+    }
+}
+
+/// M1 work has an independent identity and counts even zero-valued edges.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SleepChoiceWorkV1 {
+    pub microsteps: u64,
+    pub neuron_updates: u64,
+    pub encoder_assignments: u64,
+    pub branches: u64,
+    pub branch_inputs: u64,
+    pub readout_products: u64,
+}
+impl SleepChoiceWorkV1 {
+    pub fn checked(
+        microsteps: u64,
+        encoded_frames: u64,
+        readout_products: u64,
+    ) -> Result<Self, ScaffoldContractError> {
+        let mul = |a: u64, b| {
+            a.checked_mul(b)
+                .ok_or(ScaffoldContractError::BrainActivityPolicyMismatch)
+        };
+        Ok(Self {
+            microsteps,
+            neuron_updates: mul(microsteps, 96)?,
+            encoder_assignments: mul(encoded_frames, 24)?,
+            branches: mul(microsteps, 72)?,
+            branch_inputs: mul(microsteps, 188)?,
+            readout_products,
+        })
+    }
+    pub fn cost_q24(&self) -> Result<u64, ScaffoldContractError> {
+        [
+            (self.neuron_updates, 32_u64),
+            (self.encoder_assignments, 4),
+            (self.branches, 16),
+            (self.branch_inputs, 4),
+            (self.readout_products, 4),
+        ]
+        .into_iter()
+        .try_fold(0_u64, |a, (n, r)| {
+            a.checked_add(
+                n.checked_mul(r)
+                    .ok_or(ScaffoldContractError::BrainActivityPolicyMismatch)?,
+            )
+            .ok_or(ScaffoldContractError::BrainActivityPolicyMismatch)
+        })
+    }
+}
