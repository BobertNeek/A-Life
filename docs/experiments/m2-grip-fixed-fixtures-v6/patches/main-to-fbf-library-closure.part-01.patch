+        ),
+        0.7,
+    );
+    sidecar.observe_sealed_patch(&first).unwrap();
+    let write = sidecar.observe_sealed_patch(&newer).unwrap();
+    assert!(matches!(write.kind, MemoryUpdateKind::Merged { .. }));
+    let (event, target) = source_pair(&newer);
+    let proof = SleepMemorySourceProofV1::capture(&newer, event, &target, write).unwrap();
+    assert_eq!(proof.resolve(sidecar.bank()).unwrap(), None);
+    let recovery = patch(3, 700, 0.7);
+    let write = sidecar.observe_sealed_patch(&recovery).unwrap();
+    let (recovery_event, recovery_target) = source_pair(&recovery);
+    let recovery_proof =
+        SleepMemorySourceProofV1::capture(&recovery, recovery_event, &recovery_target, write)
+            .unwrap();
+    let consolidator = SleepConsolidator::new(SleepConsolidationConfig {
+        memory_max_records_after: 8,
+        ..SleepConsolidationConfig::reference()
+    })
+    .unwrap();
+    let mut predictor = crate::predictive::GroundedSuccessorPredictor::default();
+    let mut topo = topology();
+    let mixed = replay_evidence(&[(event, target.clone()), (recovery_event, recovery_target)]);
+    let result = sidecar
+        .run_bounded_sleep_transaction_scoped_v1(
+            &consolidator,
+            &HomeostaticSnapshot::baseline(Tick::new(100)),
+            Tick::new(100),
+            &mixed,
+            &[proof.clone(), recovery_proof.clone()],
+            &mut predictor,
+            &mut topo,
+        )
+        .unwrap()
+        .unwrap();
+    assert_eq!(result.replay_event_count, 1);
+    assert_eq!(
+        result.promoted_memory_ids,
+        vec![recovery_proof.resolve(sidecar.bank()).unwrap().unwrap()]
+    );
+    let unavailable = replay_evidence(&[(event, target)]);
+    let before = sidecar.clone();
+    let p_before = predictor.clone();
+    let t_before = topo.clone();
+    assert_eq!(
+        sidecar
+            .run_bounded_sleep_transaction_scoped_v1(
+                &consolidator,
+                &HomeostaticSnapshot::baseline(Tick::new(101)),
+                Tick::new(101),
+                &unavailable,
+                &[proof],
+                &mut predictor,
+                &mut topo
+            )
+            .unwrap(),
+        None
+    );
+    assert_eq!(sidecar, before);
+    assert_eq!(predictor, p_before);
+    assert_eq!(topo, t_before);
+    // Even a wholly unavailable batch must authenticate every paired proof.
+    assert!(sidecar
+        .run_bounded_sleep_transaction_scoped_v1(
+            &consolidator,
+            &HomeostaticSnapshot::baseline(Tick::new(101)),
+            Tick::new(101),
+            &unavailable,
+            &[recovery_proof],
+            &mut predictor,
+            &mut topo
+        )
+        .is_err());
+    assert_eq!(sidecar, before);
+    assert_eq!(predictor, p_before);
+    assert_eq!(topo, t_before);
+}
