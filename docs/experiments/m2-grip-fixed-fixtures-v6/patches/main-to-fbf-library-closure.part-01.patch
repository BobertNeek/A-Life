+            let old_result = old.step(
+                &f,
+                tick.clone(),
+                &old_rows,
+                MediationModulationV1::default(),
+                127,
+                [true; 6],
+                u64::MAX,
+            )?;
+            let rows = e.bind_rows(&f, &tick)?;
+            let start = Instant::now();
+            let r = e.step(
+                &f,
+                tick,
+                &rows,
+                MediationModulationV1::default(),
+                127,
+                [true; 6],
+                u64::MAX,
+            )?;
+            let native_ns = start.elapsed().as_nanos();
+            let old_d = old_result.receipt.scores.probabilities(1.)?;
+            let d = r.receipt.scores.probabilities(1.)?;
