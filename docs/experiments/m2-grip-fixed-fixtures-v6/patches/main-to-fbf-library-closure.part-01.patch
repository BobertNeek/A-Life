@@ -0,0 +1,269 @@
+//! Explicit fresh dendritic-state factorial. No acquired-state or genetic edits.
+#[allow(dead_code)]
+#[path = "support/motor_balance_assay.rs"]
+mod assay;
+#[allow(dead_code)]
+#[path = "support/motor_probe_common.rs"]
+mod common;
+
+#[path = "support/motor_operating_point.rs"]
+mod readout;
+use alife_core::*;
+use alife_gpu_backend::GpuV11CausalState;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask, TrainingSequence};
+
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    error::Error,
+};
+type Result<T> = std::result::Result<T, Box<dyn Error>>;
+fn branch_plan(
+    inherited: &DendriticBranchSet,
+    name: &str,
+    gain: f32,
+    threshold: f32,
+) -> Result<(DendriticBranchSet, Value)> {
+    let branches = inherited
+        .branches()
+        .iter()
+        .map(|b| {
+            assert_eq!(b.output_gain, 6.);
+            assert_eq!(b.threshold, -1.);
+            DendriticBranch::new(b.target, threshold, gain, b.inputs.clone())
+        })
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    let changed = DendriticBranchSet::new(branches)?;
+    changed.validate_for_neuron_count(2048)?;
+    assert_eq!(changed.branches().len(), inherited.branches().len());
+    for (a, b) in changed.branches().iter().zip(inherited.branches()) {
+        assert_eq!(a.target, b.target);
+        assert_eq!(a.inputs, b.inputs);
+        assert_eq!(a.output_gain, gain);
+        assert_eq!(a.threshold, threshold);
+    }
+    let digest = format!("{:x}", Sha256::digest(serde_json::to_vec(&changed)?));
+    Ok((
+        changed.clone(),
+        json!({"schema":"explicit_fresh_branch_plan_v1","profile":name,"output_gain":gain,"threshold":threshold,"branch_count":inherited.branches().len(),"branch_plan_sha256":digest,"branches":changed.branches(),"targets_and_input_weights_preserved":true,"rest_signal":1747,"inspect_signal":1760,"approach_reference":1791,"rest_reference":1759,"approach_signal":1776}),
+    ))
+}
+fn sequence(
+    p: &BrainPhenotype,
+    base: [f32; 11],
+    changed: [f32; 11],
+    d: &DendriticBranchSet,
+    start: f32,
+    cut: bool,
+) -> TrainingSequence {
+    let mut q = common::combined_sequence(p, base, changed, d, cut);
+    q.ticks.extend(
+        common::combined_sequence(p, base, base, d, false)
+            .ticks
+            .into_iter()
+            .take(32),
+    );
+    let region = p.lobe_layout().region(LobeKind::ActionPlanning).unwrap();
+    q.initial.activations[region.start as usize..(region.start + region.len) as usize].fill(start);
+    // Deliberately held equal across activation starts; these are synthetic
+    // fresh-state controls, not physically equilibrated biological states.
+    assert!(q.initial.metabolic_load.iter().all(|x| *x == 0.));
+    assert!(q.initial.activity_ema.iter().all(|x| *x == 0.));
+    q
+}
+fn conditions(base: [f32; 11]) -> Vec<(String, [f32; 11])> {
+    let mut rows = vec![("balanced".into(), base)];
+    for (i, name) in assay::LABELS.iter().enumerate() {
+        let mut a = base;
+        a[i] = if i == 6 { 0.1 } else { 0.9 };
+        rows.push((name.to_string(), a));
+    }
+    for (name, axes) in [
+        ("hunger_fatigue", vec![0, 1]),
+        ("hunger_pain", vec![0, 3]),
+        ("fatigue_boredom", vec![1, 9]),
+        ("hunger_low_atp", vec![0, 6]),
+        ("fatigue_low_atp", vec![1, 6]),
+        ("triple", vec![0, 1, 6]),
+    ] {
+        let mut a = base;
+        for i in axes {
+            a[i] = if i == 6 { 0.1 } else { 0.9 };
+        }
+        rows.push((name.into(), a));
+    }
+    for fatigue in [0., 0.05, 0.2, 0.4, 0.6, 0.8, 1.] {
+        let mut a = base;
+        a[1] = fatigue;
+        rows.push((format!("fatigue_level_{fatigue}"), a));
+    }
+    rows
+}
+fn run() -> Result<Value> {
+    let (_, base_p, source) = assay::frozen::source(7, true)?;
+    let (original, circuits) = assay::frozen::whole_care(&base_p)?;
+    let inspection =
+        json!({"schema":"fresh_branch_state_scope_v1","world_steps":0,"learning_steps":0});
+    if !std::env::args().any(|a| a == "--run") {
+        return Ok(inspection);
+    }
+    let inherited = GpuV11CausalState::for_phenotype(&base_p)?
+        .dendritic_branches()
+        .clone();
+    let base = [0.1, 0.1, 0., 0., 0.1, 0.45, 0.75, 0., 0.1, 0.1, 0.];
+    let cases = conditions(base);
+    let mut arms = vec![];
+    for (factor, gain, threshold) in [
+        ("Inherited", 6., -1.),
+        ("GainOnly", 0.25, -1.),
+        ("ThresholdOnly", 6., 0.1),
+        ("BoundedCombined", 0.25, 0.1),
+        ("ZeroOutputAblation", 0., -1.),
+    ] {
+        let (branch_state, plan) = branch_plan(&inherited, factor, gain, threshold)?;
+        for start in [0., -0.5, 0.5] {
+            let mut paired_traces = BTreeMap::new();
+            for differential in [false, true] {
+                let (w, _) =
+                    readout::counterbalance(&base_p, &original, &circuits, 0., differential)?;
+                let asset = FoundationWeightAsset::from_trained_weights(
+                    &base_p,
+                    w,
+                    source.manifest().training_stage(),
+                )?;
+                let p = common::bind_candidate(7, &asset)?;
+                asset.validate_against(&p)?;
+                assert_eq!(p.synapses().len(), base_p.synapses().len());
+                for (a, b) in p.synapses().iter().zip(base_p.synapses()) {
+                    assert_eq!(
+                        (a.source(), a.target(), a.route_index(), a.kind()),
+                        (b.source(), b.target(), b.route_index(), b.kind())
+                    );
+                }
+                assert_eq!(p.neuron_dynamics(), base_p.neuron_dynamics());
+                assert_eq!(p.sensor_encoder(), base_p.sensor_encoder());
+                assert_eq!(p.candidate_decoder(), base_p.candidate_decoder());
+                assert_eq!(
+                    GpuV11CausalState::for_phenotype(&p)?.dendritic_branches(),
+                    &inherited
+                );
+                let mask = StageTrainableMask::from_synapse_indices(
+                    &p,
+                    &(0..p.synapses().len() as u32).collect::<Vec<_>>(),
+                )?;
+                let trainer = CpuFoundationTrainer::new(
+                    p.clone(),
+                    asset.clone(),
+                    mask,
+                    AdamWConfig::default(),
+                )?;
+                let checkpoint = serde_json::to_vec(&trainer.checkpoint())?;
+                let q0 = sequence(&p, base, base, &branch_state, start, false);
+                let baseline = trainer.evaluate_replay(&q0)?;
+                let state_sha = format!("{:x}", Sha256::digest(serde_json::to_vec(&q0.initial)?));
+                let mut rows = vec![];
+                for (name, a) in &cases {
+                    assert_eq!(sequence(&p, base, *a, &branch_state, start, true), q0);
+                    let eval = trainer.evaluate_replay(&sequence(
+                        &p,
+                        base,
+                        *a,
+                        &branch_state,
+                        start,
+                        false,
+                    ))?;
+                    if differential {
+                        assert_eq!(
+                            &eval.final_activations,
+                            paired_traces.get(name).ok_or("missing paired trace")?
+                        );
+                    } else {
+                        paired_traces.insert(name.clone(), eval.final_activations.clone());
+                    }
+                    for (ci, context) in common::CONTEXTS.iter().enumerate() {
+                        let range = ci * 8..ci * 8 + 8;
+                        let samples=[32,33,34,36,40,48,64,65,66,68,72,80,96].map(|frame|{
+                        let t=frame-1;let active=if(32..64).contains(&t){*a}else{base};
+                        let phase=if t<32{"baseline"}else if t<64{"perturbation"}else{"washout"};
+                        let logits=&eval.candidate_logits[t][range.clone()];let reference=&baseline.candidate_logits[t][range.clone()];
+                        let innate=p.candidate_decoder().families().iter().map(|f|f.innate_contribution(assay::drives(active),assay::features(f.family(),context))).collect::<Vec<_>>();
+                        let motors=p.candidate_decoder().families().iter().map(|f|{
+                            let ids=p.synapses().iter().filter_map(|s|match s.kind(){CompiledSynapseKind::Decoder(c)if c.head()==DecoderHeadKind::ActionCandidate&&c.family()==f.family()=>Some(s.source()as usize),_=>None}).collect::<BTreeSet<_>>();
+                            let values=ids.iter().map(|&m|eval.final_activations[t][m]).collect::<Vec<_>>();
+                            json!({"family":f.family(),"min":values.iter().copied().fold(f32::INFINITY,f32::min),"max":values.iter().copied().fold(f32::NEG_INFINITY,f32::max),"mean":values.iter().sum::<f32>()/values.len()as f32,"max_abs_delta":ids.iter().map(|&m|(eval.final_activations[t][m]-baseline.final_activations[t][m]).abs()).fold(0_f32,f32::max)})
+                        }).collect::<Vec<_>>();
+                        let path_neurons=["rest_signal","inspect_signal","approach_reference","rest_reference","approach_signal"].map(|role|{let id=plan[role].as_u64().unwrap()as usize;json!({"role":role,"id":id,"activation":eval.final_activations[t][id],"baseline_activation":baseline.final_activations[t][id]})});
+                        json!({"frame":frame,"phase":phase,"neural_logits":logits,"baseline_logits":reference,"neural_delta":logits.iter().zip(reference).map(|(x,b)|x-b).collect::<Vec<_>>(),"innate":innate,"total":logits.iter().zip(&innate).map(|(n,i)|n+i).collect::<Vec<_>>(),"motors":motors,"path_neurons":path_neurons})
+                    });
+                        rows.push(json!({"condition":name,"context":context,"perturbed_drives":a,"samples":samples}));
+                    }
+                }
+                assert_eq!(checkpoint, serde_json::to_vec(&trainer.checkpoint())?);
+                eprintln!("completed {factor:?} start={start} differential={differential}");
+                arms.push(json!({"factor":factor,"motor_start":start,"initial_metabolic_load":0,"initial_activity_ema":0,"differential_readout":differential,"candidate_asset_digest":asset.digest(),"candidate_phenotype_hash":p.phenotype_hash(),"initial_state_sha256":state_sha,"plan":plan,"rows":rows,"optimizer_preserved":true,"inherited_branch_inputs_preserved":true,"declared_branch_plan_only":true,"input_cuts_exact":true,"readout_pair_traces_exact":true}));
+            }
+        }
+    }
+    Ok(
+        json!({"schema":"fresh_branch_state_replay_v1","inspection":inspection,"seed":7,"backend":"native_cpu_replay","frames":{"warmup":32,"perturbation":32,"washout":32},"world_steps":0,"learning_steps":0,"families":base_p.candidate_decoder().families().iter().map(|f|f.family()).collect::<Vec<_>>(),"arms":arms}),
+    )
+}
+fn main() -> Result<()> {
+    println!("{}", serde_json::to_string_pretty(&run()?)?);
+    Ok(())
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn branch_profiles_change_only_declared_fields() {
+        let (_, p, _) = assay::frozen::source(7, true).unwrap();
+        let inherited = GpuV11CausalState::for_phenotype(&p)
+            .unwrap()
+            .dendritic_branches()
+            .clone();
+        for (name, g, t) in [
+            ("Inherited", 6., -1.),
+            ("GainOnly", 0.25, -1.),
+            ("ThresholdOnly", 6., 0.1),
+            ("BoundedCombined", 0.25, 0.1),
+            ("ZeroOutputAblation", 0., -1.),
+        ] {
+            let (d, plan) = branch_plan(&inherited, name, g, t).unwrap();
+            assert_eq!(plan["branch_count"], 64);
+            if name == "Inherited" {
+                assert_eq!(d, inherited);
+            } else {
+                assert_ne!(d, inherited);
+            }
+            let encoded = serde_json::to_vec(&d).unwrap();
+            assert_eq!(
+                serde_json::from_slice::<DendriticBranchSet>(&encoded).unwrap(),
+                d
+            );
+        }
+    }
+    #[test]
+    fn starts_and_washout_are_explicit_and_cut_is_exact() {
+        let (_, p, _) = assay::frozen::source(7, true).unwrap();
+        let d = GpuV11CausalState::for_phenotype(&p)
+            .unwrap()
+            .dendritic_branches()
+            .clone();
+        let base = [0.1; 11];
+        let mut a = base;
+        a[1] = 0.9;
+        for start in [-0.5, 0., 0.5] {
+            let q = sequence(&p, base, a, &d, start, false);
+            assert_eq!(q.ticks.len(), 96);
+            assert_eq!(q.initial.dendrites, d);
+            assert_eq!(q.ticks[0].encoded_inputs, q.ticks[95].encoded_inputs);
+            assert_ne!(q.ticks[32].encoded_inputs, q.ticks[95].encoded_inputs);
+            assert_eq!(
+                sequence(&p, base, a, &d, start, true),
+                sequence(&p, base, base, &d, start, false)
+            );
+        }
+    }
+}
diff --git a/crates/alife_training/examples/probe_grounded_developmental.rs b/crates/alife_training/examples/probe_grounded_developmental.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0323eff85fdbfb5b9a35ab62d5f1c8840ad61ad1
--- /dev/null
+++ b/crates/alife_training/examples/probe_grounded_developmental.rs
@@ -0,0 +1,275 @@
+//! Frozen prospective R0. No life is run by default; --run requires a fresh directory.
+#[path = "support/grounded_developmental_detached.rs"]
+mod detached;
+#[path = "support/grounded_developmental_preparation.rs"]
+mod preparation;
+#[path = "support/grounded_developmental_recipe.rs"]
+mod recipe;
+use alife_core::*;
+use alife_training::cpu::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{fs, path::Path};
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const SEED: u64 = 0xD241_1108;
+fn digest<T: serde::Serialize>(v: &T) -> Result<String> {
+    Ok(format!("{:x}", Sha256::digest(serde_json::to_vec(v)?)))
+}
+fn plan() -> Value {
+    json!({"schema":"grounded_developmental_r0_v1","seed":SEED,"arms":["zero_initialized_added_rows","four_authored_added_rows"],"scenes":["food_hunger_fatigue","toy_curiosity"],"preparation_ticks_per_episode":240,"decision_ticks_per_episode":8,"max_world_ticks":992,"max_decisions":32,"detached_ticks":96,"optimizer_steps":0,"sensor_profile":"GroundedObjectSlotsV1","capacity_class":5,"candidate_price_q24":768,"age_label":"fully biochemically expressed juvenile, not adult","learning":"ordinary somatic plasticity in both arms; zero initialization is not permanent lesion","inherited_recipe":"bounded B1 whole-care, differential references, dedicated fatigue B, tonic-on","new_rows":[{"family":"Approach","lane":36,"source":1779,"weight":-0.4},{"family":"Approach","lane":36,"source":1791,"weight":0.4},{"family":"Inspect","lane":36,"source":1766,"weight":0.5},{"family":"Inspect","lane":36,"source":1775,"weight":-0.5}],"scenes_geometry":[{"kind":"Food","center":[1.,0.,0.],"radius":0.2,"nutrition":0.6,"taste":0.85},{"kind":"Toy","center":[0.65,0.,0.],"radius":0.2,"taste":0.}],"thermal_physics":false,"scope":"CPU-only fresh research host, no acquired migration, no default promotion, no coefficient tuning, no eight-tick feeding guarantee","detached_scope":"first actual decision captures, static contexts, partial receptor modulation; scenes are not an isolated drive dose-response"})
+}
+fn stats(values: impl Iterator<Item = f32>) -> Value {
+    let xs: Vec<_> = values.collect();
+    json!({"count":xs.len(),"nonzero":xs.iter().filter(|&&x| x != 0.).count(),"absolute_sum":xs.iter().map(|x|f64::from(x.abs())).sum::<f64>(),"max_absolute":xs.iter().map(|x|x.abs()).fold(0.,f32::max)})
+}
+fn added_state(
+    p: &BrainPhenotype,
+    genetic: &[f32],
+    ids: &[usize],
+    before: &CpuCanonicalCheckpoint,
+    after: &CpuCanonicalCheckpoint,
+    initial: &CpuCanonicalCheckpoint,
+) -> Value {
+    let a = &before.residents[0].neural;
+    let b = &after.residents[0].neural;
+    let start = &initial.residents[0].neural;
+    let effective = |r: &CpuOrganismCheckpoint, i: usize| {
+        genetic[i] + r.lifetime[i] + p.synapses()[i].alpha() * r.fast[i]
+    };
+    json!({"genetic":stats(ids.iter().map(|&i|genetic[i])),"lifetime":stats(ids.iter().map(|&i|b.lifetime[i])),"fast":stats(ids.iter().map(|&i|b.fast[i])),"effective":stats(ids.iter().map(|&i|effective(b,i))),"step_lifetime_delta":stats(ids.iter().map(|&i|b.lifetime[i]-a.lifetime[i])),"step_fast_delta":stats(ids.iter().map(|&i|b.fast[i]-a.fast[i])),"step_effective_delta":stats(ids.iter().map(|&i|effective(b,i)-effective(a,i))),"initial_lifetime_delta":stats(ids.iter().map(|&i|b.lifetime[i]-start.lifetime[i])),"initial_fast_delta":stats(ids.iter().map(|&i|b.fast[i]-start.fast[i])),"initial_effective_delta":stats(ids.iter().map(|&i|effective(b,i)-effective(start,i)))})
+}
+struct Trial {
+    recipe: recipe::R0Recipe,
+    host: CpuCanonicalHost,
+    trainer: CpuFoundationTrainer,
+    preparation: Value,
+    scene: usize,
+    authored: bool,
+}
+fn run_trial(
+    mut t: Trial,
+    directory: &Path,
+    index: usize,
+    detached_budget: &mut detached::DetachedBudget,
+) -> Result<Value> {
+    let initial = t
+        .host
+        .grounded_drive_research_checkpoint(&t.trainer)?
+        .checkpoint;
+    let optimizer = digest(&t.trainer.checkpoint())?;
+    let p = t.trainer.phenotype();
+    let mut rows = Vec::new();
+    let mut stop = None;
+    for step_index in 0..8 {
+        let before_cp = t
+            .host
+            .grounded_drive_research_checkpoint(&t.trainer)?
+            .checkpoint;
+        let record = t
+            .host
+            .world()
+            .organism_registry()
+            .iter()
+            .next()
+            .ok_or("missing learner")?
+            .clone();
+        let biology = *record.biochemistry();
+        if !record.lifecycle().is_alive() || biology.body.health < 0.5 || biology.body.energy < 0.05
+        {
+            stop = Some("bounded health/energy stop");
+            break;
+        }
+        let position = t
+            .host
+            .world()
+            .entity(record.world_entity_id())
+            .ok_or("missing body")?
+            .position;
+        let receptors = biology.neural_receptor_frame(record.phenotype())?;
+        let effects =
+            NeuralReceptorEffects::from_frame(&receptors, &NeuralReceptorPhenotype::compile(p)?)?;
+        let step = t.host.step(&t.trainer, 1.)?;
+        let mut decisions = Vec::new();
+        for decision in &step.decisions {
+            let frame = decision.patch.pre_action().perception();
+            let resident = &before_cp.residents[0];
+            let budget = cpu_activity_budget(
+                p,
+                CpuActivityAnchor {
+                    organism_id: record.organism_id(),
+                    tick: frame.tick(),
+                    sequence_cursor: resident.next_sequence,
+                    previous_dispatch_generation: resident.neural.dispatch_generation,
+                    source_frame_digest: resident.activity.source_frame_digest,
+                    frame_digest: frame.frame_digest().0,
+                },
+                biology.homeostasis.drives.brain_atp,
+                frame.candidates().len() as u32,
+                decision.replay_tick.candidates.len() as u32,
+            )?;
+            assert_eq!(budget.work, decision.brain_work);
+            assert_eq!(
+                u32::from(budget.microsteps),
+                decision.replay_tick.microstep_count
+            );
+            assert_eq!(
+                effects.projection_gain,
+                decision.replay_tick.projection_gain
+            );
+            assert_eq!(
+                effects.local_threshold_shift,
+                decision.replay_tick.local_threshold_shift
+            );
+            if step_index == 0 {
+                let report = detached::evaluate_capture(
+                    &t.trainer,
+                    decision,
+                    if t.scene == 0 {
+                        "food_hunger_fatigue"
+                    } else {
+                        "toy_curiosity"
+                    },
+                    if t.authored {
+                        "authored"
+                    } else {
+                        "zero_initialized"
+                    },
+                    detached_budget,
+                )?;
+                fs::write(
+                    directory.join(format!("detached-{index}.json")),
+                    serde_json::to_vec_pretty(&report)?,
+                )?;
+            }
+            let candidate_readouts=frame.candidates().iter().zip(&decision.replay_tick.candidates).map(|(candidate,replay)| {
+                let mut inherited=0.;let mut added=0.;
+                for (i,s) in p.synapses().iter().enumerate() {
+                    if let CompiledSynapseKind::Decoder(c)=s.kind() {
+                        if c.head()==DecoderHeadKind::ActionCandidate && c.family()==candidate.family {
+                            let contribution=decision.final_features[s.source() as usize]*replay.decoder_inputs[c.input_lane() as usize]*(t.trainer.weights()[i]+decision.replay_tick.effective_weight_offsets[i]);
+                            if (36..46).contains(&c.input_lane()){added+=contribution;}else{inherited+=contribution;}
+                        }
+                    }
+                }
+                json!({"candidate":candidate,"inherited_neural":inherited,"added_neural":added,"innate_bias":replay.innate_bias,"neural_plus_innate":inherited+added+replay.innate_bias})
+            }).collect::<Vec<_>>();
+            decisions.push(json!({"sampling_counter":decision.sampling_counter,"action":decision.action,"selected_bundle":decision.patch.selected_bundle(),"outcome":decision.patch.outcome(),"biological_reward":decision.biological_reward,"receptors":receptors,"receptor_effects":effects,"microsteps":decision.replay_tick.microstep_count,"brain_work":decision.brain_work,"charged_neural_q24":BrainActivityPolicyV1::for_phenotype(p).cost.neural_cost_q24(&decision.brain_work)?,"available_atp_q16":budget.available_atp_q16,"debit_atp_q16":budget.debit_atp_q16,"candidate_readouts":candidate_readouts,"fatigue_signal_minus_reference":decision.final_features[1779]-decision.final_features[1791],"curiosity_signal_minus_reference":decision.final_features[1766]-decision.final_features[1775],"source383":decision.final_features[383]}));
+        }
+        let after_cp = t
+            .host
+            .grounded_drive_research_checkpoint(&t.trainer)?
+            .checkpoint;
+        let after = t
+            .host
+            .world()
+            .organism_registry()
+            .get(record.organism_id())
+            .ok_or("missing learner after step")?;
+        rows.push(json!({"step":step_index,"tick_before":step.tick_before,"tick_after":step.tick_after,"biology_before":biology,"biology_after":after.biochemistry(),"cognitive_before":record.cognitive_work(),"cognitive_after":after.cognitive_work(),"position_before":position,"position_after":t.host.world().entity(after.world_entity_id()).ok_or("missing body")?.position,"sleeping_organisms":step.sleeping_organisms,"sleep_consolidations":step.sleep_consolidations,"activity_before":before_cp.residents[0].activity,"activity_after":after_cp.residents[0].activity,"added_rows":added_state(p,t.trainer.weights(),&t.recipe.added_rows,&before_cp,&after_cp,&initial),"decisions":decisions}));
+        fs::write(
+            directory.join(format!("trial-{index}-progress.json")),
+            serde_json::to_vec_pretty(&rows)?,
+        )?;
+    }
+    assert_eq!(optimizer, digest(&t.trainer.checkpoint())?);
+    Ok(
+        json!({"scene":t.scene,"authored":t.authored,"recipe":t.recipe.metadata,"preparation":t.preparation,"rows":rows,"early_stop":stop,"optimizer_unchanged":true,"final_checkpoint_hash":digest(&t.host.grounded_drive_research_checkpoint(&t.trainer)?)?}),
+    )
+}
+fn run() -> Result<Value> {
+    let args: Vec<_> = std::env::args().skip(1).collect();
+    if args.is_empty() || args == ["--plan"] {
+        return Ok(plan());
+    }
+    let directory = match args.as_slice() {
+        [mode, path] if mode == "--run" => Path::new(path),
+        _ => return Err("expected --plan or --run NEW_DIRECTORY".into()),
+    };
+    fs::create_dir(directory)?;
+    fs::write(
+        directory.join("protocol.json"),
+        serde_json::to_vec_pretty(&plan())?,
+    )?;
+    fs::write(
+        directory.join("executable.sha256"),
+        format!(
+            "{:x}\n",
+            Sha256::digest(fs::read(std::env::current_exe()?)?)
+        ),
+    )?;
+    let mut trials = Vec::new();
+    for authored in [false, true] {
+        for scene in 0..2 {
+            let recipe = recipe::build(SEED, authored)?;
+            let (host, trainer, preparation) = preparation::prepare(&recipe, scene)?;
+            fs::write(
+                directory.join(format!("preparation-{}.json", trials.len())),
+                serde_json::to_vec_pretty(&preparation)?,
+            )?;
+            trials.push(Trial {
+                recipe,
+                host,
+                trainer,
+                preparation,
+                scene,
+                authored,
+            });
+        }
+    }
+    for scene in 0..2 {
+        for key in ["scene_hash", "body_hash", "rng_hash"] {
+            assert!(
+                !trials[scene].preparation[key].is_null(),
+                "missing paired identity {key}"
+            );
+            assert_eq!(
+                trials[scene].preparation[key],
+                trials[scene + 2].preparation[key],
+                "unmatched predecision {key}"
+            );
+        }
+    }
+    let mut results = Vec::new();
+    let mut budget = detached::DetachedBudget::new();
+    for (index, trial) in trials.into_iter().enumerate() {
+        let result = run_trial(trial, directory, index, &mut budget)?;
+        fs::write(
+            directory.join(format!("trial-{index}.json")),
+            serde_json::to_vec_pretty(&result)?,
+        )?;
+        results.push(result);
+        eprintln!("R0 trial {index} finished");
+    }
+    Ok(
+        json!({"protocol":plan(),"paired_predecision_scene_body_rng_equal":true,"detached_budget":budget.summary(),"trials":results}),
+    )
+}
+fn main() -> Result<()> {
+    println!("{}", serde_json::to_string_pretty(&run()?)?);
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn frozen_recipe_constructs_exact_zero_and_four_row_controls_without_ticks() {
+        let zero = recipe::build(SEED, false).unwrap();
+        let authored = recipe::build(SEED, true).unwrap();
+        assert_eq!(zero.added_rows, authored.added_rows);
+        assert_eq!(zero.added_rows.len(), 1280);
+        assert_eq!(
+            zero.asset
+                .weights()
+                .iter()
+                .zip(authored.asset.weights())
+                .filter(|(a, b)| a.to_bits() != b.to_bits())
+                .count(),
+            4
+        );
+        assert_eq!(zero.inputs.genome(), authored.inputs.genome());
+        assert_eq!(zero.inputs.development(), authored.inputs.development());
+        assert_eq!(plan()["max_decisions"], 32);
+        assert_eq!(plan()["max_world_ticks"], 992);
+    }
+}
