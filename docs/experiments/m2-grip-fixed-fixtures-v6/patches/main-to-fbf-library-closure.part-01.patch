+//! Recovery operation boundaries exercise real writes, recall, and portable state.
+use super::*;
+use crate::*;
+
+const OWNER: OrganismId = OrganismId(811);
+fn profile() -> SensorProfile {
+    SensorProfile::GroundedObjectSlotsSleepChoiceV1
+}
+fn identity() -> SensorProfileIdentity {
+    SensorProfileProvenance::new(profile(), SensoryAbiVersion::CURRENT, Tick::ZERO)
+        .unwrap()
+        .identity()
+}
+fn bank(capacity: usize) -> MemoryBank {
+    MemoryBank::new(
+        MemoryBankConfig::new(
+            capacity,
+            64,
+            capacity.min(4),
+            0.72,
+            Confidence::new(0.0).unwrap(),
+        )
+        .unwrap(),
+    )
+    .unwrap()
+}
+fn draft(tick: u64, ids: &[u32]) -> PerceptionFrameDraft {
+    draft_actions(
+        tick,
+        &ids.iter()
+            .map(|id| (*id, ActionKind::Rest, CandidateActionFamily::Rest))
+            .collect::<Vec<_>>(),
+    )
+}
+fn draft_actions(
+    tick: u64,
+    ids: &[(u32, ActionKind, CandidateActionFamily)],
+) -> PerceptionFrameDraft {
+    let tick = Tick::new(tick);
+    let slot = GroundedObjectSlotV1 {
+        slot_index: 0,
+        tracked_object_id: TrackedObjectId(61),
+        bearing: [0.0; 2],
+        distance: 0.4,
+        relative_velocity: [0.0; 3],
+        color: [0.0; 3],
+        material: [0.0; 3],
+        shape: [0.0; 3],
+        chemical: [0.0; 3],
+        contact: 0.0,
+        proprioception: [0.0; 2],
+        temperature: 0.0,
+        terrain: [0.0; 2],
+        confidence: Confidence::new(0.9).unwrap(),
+    };
+    let has_inspect = ids
+        .iter()
+        .any(|(_, _, family)| *family == CandidateActionFamily::Inspect);
+    let candidates = ids
+        .iter()
+        .enumerate()
+        .map(|(index, (id, kind, family))| {
+            ActionCandidate::new(
+                index as u16,
+                ActionId(*id),
+                *kind,
+                *family,
+                if *family == CandidateActionFamily::Inspect {
+                    CandidateObservationRef::ObjectSlot(0)
+                } else {
+                    CandidateObservationRef::None
+                },
+                if *family == CandidateActionFamily::Inspect {
+                    ActionTarget::new(Some(WorldEntityId(71)), Some(Vec3f::new(0.4, 0.0, 0.0)))
+                } else {
+                    ActionTarget::NONE
+                },
+                if *family == CandidateActionFamily::Inspect {
+                    slot.candidate_features().unwrap()
+                } else {
+                    CandidateFeatureVector::zero()
+                },
+                Confidence::new(0.9).unwrap(),
+                NormalizedScalar::new(0.2).unwrap(),
+                DurationTicks::new(1),
+                DurationTicks::new(2),
+            )
+            .unwrap()
+        })
+        .collect();
+    PerceptionFrameDraft::new(
+        OWNER,
+        tick,
+        profile(),
+        SensorySnapshot::new(
+            OWNER,
+            tick,
+            Vec3f::ZERO,
+            SensoryChannels::ZERO,
+            Default::default(),
+        )
+        .unwrap(),
+        BodySnapshot {
+            pose: Pose::IDENTITY,
+            velocity: Velocity::ZERO,
+        },
+        HomeostaticSnapshot::baseline(tick),
+        candidates,
+        SensorProfileProvenance::new(profile(), SensoryAbiVersion::CURRENT, tick).unwrap(),
+        if has_inspect { vec![slot] } else { vec![] },
+    )
+    .unwrap()
+}
+fn patch(sequence: u64, action: u32, reward: f32) -> ExperiencePatch {
+    patch_from_draft(sequence, draft(sequence * 2, &[action]), reward)
+}
+fn patch_from_draft(sequence: u64, draft: PerceptionFrameDraft, reward: f32) -> ExperiencePatch {
+    let tick = draft.tick();
+    let sequence = ExperienceSequenceId(sequence);
+    let (frame, recall) = bank(8)
+        .recall_frame(&draft)
+        .unwrap()
+        .finalize(draft)
+        .unwrap();
+    let candidate = &frame.candidates()[0];
+    let decision = DecisionSnapshot::from_neural_selection(
+        sequence,
+        PhenotypeHash([1, 2, 3, 4]),
+        sequence.raw(),
+        0,
+        &frame,
+        NeuralActionSelection {
+            candidate_index: 0,
+            logit: 0.7,
+            confidence: Confidence::new(0.8).unwrap(),
+            active_tiles: 8,
+            active_synapses: 64,
+        },
+        candidate
+            .to_command(OWNER, Confidence::new(0.8).unwrap())
+            .unwrap(),
+    )
+    .unwrap()
+    .with_finalized_memory_recall(&frame, &recall, 0)
+    .unwrap();
+    let spec = BrainClassSpec::for_tier(BrainScaleTier::Nano512);
+    let genome = BrainGenome::scaffold(321, spec.id);
+    let development = DevelopmentState::new(genome.id, tick, NormalizedScalar::new(0.5).unwrap())
+        .with_enabled_lobes([
+            LobeKind::PerceptualIntegration,
+            LobeKind::TemporalPredictive,
+            LobeKind::ActionPlanning,
+        ]);
+    let pre = PreActionSnapshot::from_neural_frame(
+        sequence,
+        spec.id,
+        PhenotypeHash([1, 2, 3, 4]),
+        genome.id,
+        genome.schema_version,
+        development,
+        frame,
+    )
+    .unwrap();
+    let pain = if reward < 0.0 { 0.5 } else { 0.0 };
+    let outcome = PostActionOutcome::new(
+        OWNER,
+        sequence,
+        Tick::new(tick.raw() + 1),
+        reward >= 0.0,
+        PhysicalActionOutcome {
+            contact: PhysicalContactKind::None,
+            target_entity: None,
+            displacement: Vec3f::ZERO,
+            collision_normal: None,
+            energy_cost: NormalizedScalar::new(0.1).unwrap(),
+        },
+        HomeostaticDelta {
+            drives: DriveDelta {
+                pain,
+                fear: pain,
+                brain_atp: -0.1,
+                ..DriveDelta::zero()
+            },
+            hormones: EndocrineDelta::zero(),
+        },
+        SignedValence::new(reward).unwrap(),
+        NormalizedScalar::new(pain).unwrap(),
+        NormalizedScalar::new(pain).unwrap(),
+        SignedValence::new(-0.1).unwrap(),
+        NormalizedScalar::new(if reward == 0.0 { 0.0 } else { 0.2 }).unwrap(),
+    )
+    .unwrap();
+    ExperiencePatchBuilder::new(sequence)
+        .record_pre_action(pre)
+        .unwrap()
+        .record_decision(decision)
+        .unwrap()
+        .record_outcome(outcome)
+        .unwrap()
+        .seal()
+        .unwrap()
+}
+fn write(bank: &mut MemoryBank, sequence: u64, action: u32, reward: f32) {
+    bank.observe_sealed_patch(&patch(sequence, action, reward))
+        .unwrap();
+}
+fn assert_scope(bank: &MemoryBank, operation: u32, other: u32, sign: f32) {
+    let d = draft(100, &[operation, other]);
+    let recall = bank.recall_frame(&d).unwrap();
+    let contexts = &recall.context().candidates;
+    assert!(contexts[0].family_value[0] * sign > 0.0);
+    assert_eq!(contexts[1].family_source_count, 0);
+    assert_eq!(contexts[1].family_value, [0.0; MEMORY_VALUE_V1_COUNT]);
+    assert!(recall.receipt().candidates[1].family_reused_from.is_none());
+    for context in contexts {
+        assert_eq!(context.target_source_count, 0);
+    }
+    let (fresh, cache) = bank
+        .recall_frame_runtime(&d, &Default::default(), true)
+        .unwrap();
+    let (cached, _) = bank
+        .recall_frame_runtime(&d, &cache.unwrap(), false)
+        .unwrap();
+    assert_eq!(fresh.context().candidates, cached.context().candidates);
+    assert!(cached.context().candidates[0].family_value[0] * sign > 0.0);
+    assert_eq!(cached.context().candidates[1].family_source_count, 0);
+}
+
+#[test]
+fn sleep_choice_positive_negative_writes_and_caches_never_cross_credit() {
+    for (operation, other) in [(3, 700), (700, 3)] {
+        for reward in [0.7, -0.7] {
+            let mut b = bank(8);
+            write(&mut b, 1, operation, reward);
+            write(&mut b, 2, operation, reward);
+            assert_eq!(b.candidate_store.records.len(), 1);
+            assert_eq!(
+                b.candidate_store
+                    .records
+                    .values()
+                    .next()
+                    .unwrap()
+                    .observation_count,
+                2
+            );
+            assert_scope(&b, operation, other, reward.signum());
+            let json = serde_json::to_vec(&b).unwrap();
+            let restored: MemoryBank = serde_json::from_slice(&json).unwrap();
+            assert_scope(&restored, operation, other, reward.signum());
+        }
+    }
+}
