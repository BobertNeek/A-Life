+//! Bounded M1 replay provenance, captured only from the actual sealed write.
+use super::*;
+use crate::{EpisodicDecisionKeyV2, PredictionTargetReceipt, SleepReplayEvent};
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SleepMemorySourceProofV1 {
+    key: EpisodicDecisionKeyV2,
+    event: SleepReplayEvent,
+    target_digest: [u64; 4],
+    write: MemoryUpdateReceipt,
+    canonical_digest: [u64; 4],
+}
+
+impl SleepMemorySourceProofV1 {
+    pub fn capture(
+        patch: &ExperiencePatch,
+        event: SleepReplayEvent,
+        target: &PredictionTargetReceipt,
+        write: MemoryUpdateReceipt,
+    ) -> Result<Self, ScaffoldContractError> {
+        patch.validate_contract()?;
+        let key = patch
+            .decision()
+            .episodic_key()
+            .ok_or(ScaffoldContractError::InvalidDecisionEvidence)?
+            .clone();
+        if patch.header().sequence_id != event.sequence_id {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        let mut proof = Self {
+            key,
+            event,
+            target_digest: target.canonical_digest()?,
+            write,
+            canonical_digest: [0; 4],
+        };
+        proof.canonical_digest = proof.recompute_digest()?;
+        proof.validate_against(&event, target)?;
+        Ok(proof)
+    }
+
+    pub fn sequence_id(&self) -> ExperienceSequenceId {
+        self.event.sequence_id
+    }
+    pub fn query(&self) -> &CandidateMemoryQueryV2 {
+        self.key.query()
+    }
+    pub fn canonical_digest(&self) -> [u64; 4] {
+        self.canonical_digest
+    }
+
+    pub fn validate_against(
+        &self,
+        event: &SleepReplayEvent,
+        target: &PredictionTargetReceipt,
+    ) -> Result<(), ScaffoldContractError> {
+        self.key.validate_contract()?;
+        target.validate_contract()?;
+        let query = self.key.query();
+        let (target_key, family_key) = keys_for_query(query);
+        if query.profile().profile_id.raw() != 5
+            || self.event != *event
+            || self.target_digest != target.canonical_digest()?
+            || self.canonical_digest != self.recompute_digest()?
+            || query.organism_id() != target.organism_id
+            || query.tick() != event.originating_tick
+            || query.action_id() != event.action_id
+            || query.action_family() != event.family
+            || query.candidate_feature_digest() != event.candidate_feature_digest
+            || self.key.final_frame_digest() != event.frame_digest
+            || target.experience_sequence != event.sequence_id
+            || target.decision != event.action_id
+            || target.source_digest != event.frame_digest.0
+            || target.world_tick.raw() < event.originating_tick.raw()
+            || self.write.sealed_sequence_id != event.sequence_id
+            || self.write.organism_id_raw != query.organism_id().raw()
+            || self.write.bucket != family_key.receipt()
+            || self.write.target_bucket != target_key.receipt()
+            || self.write.output_generation < self.write.input_generation
+            || self.write.capacity == 0
+            || self.write.record_count > self.write.capacity
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        if query.action_family() == CandidateActionFamily::Rest {
+            let posture = target
+                .motor_condition
+                .channels
+                .iter()
+                .find(|factor| factor.channel == crate::MotorChannel::Posture)
+                .ok_or(ScaffoldContractError::InvalidDecisionEvidence)?;
+            if posture.primitive != query.action_id() || posture.target.is_some() {
+                return Err(ScaffoldContractError::InvalidDecisionEvidence);
+            }
+        }
+        if let Some(id) = self.retained_id() {
+            id.validate()?;
+        }
+        if self.write.output_generation
+            != self
+                .write
+                .input_generation
+                .checked_add(1)
+                .ok_or(ScaffoldContractError::InvalidDecisionEvidence)?
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(())
+    }
+
+    fn retained_id(&self) -> Option<MemoryId> {
+        match self.write.kind {
+            MemoryUpdateKind::Inserted { inserted }
+            | MemoryUpdateKind::Evicted { inserted, .. } => Some(inserted),
+            MemoryUpdateKind::Merged { into } => Some(into),
+            MemoryUpdateKind::IgnoredLowInformation | MemoryUpdateKind::IgnoredLowerRetention => {
+                None
+            }
+        }
+    }
+
+    pub(crate) fn resolve(
+        &self,
+        bank: &MemoryBank,
+    ) -> Result<Option<MemoryId>, ScaffoldContractError> {
+        if self.write.output_generation > bank.candidate_store.generation {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        let Some(retained) = self.retained_id() else {
+            return Ok(None);
+        };
+        let Some(source) = bank.candidate_store.records.get(&retained.raw()) else {
+            return Ok(None);
+        };
+        source.validate_contract()?;
+        let query = self.query();
+        let expected_operation = crate::memory_query::memory_operation_id(
+            query.profile(),
+            query.action_family(),
+            query.action_kind(),
+            query.action_id(),
+        )?;
+        if source.family_key().receipt() != self.write.bucket
+            || source.profile() != query.profile()
+            || source.organism_id_raw != query.organism_id().raw()
+            || source.family_raw != u16::from(query.action_family().raw())
+            || source.operation_id()? != expected_operation
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        if source.action_kind_raw != query.action_kind().raw()
+            || source.action_id_raw != query.action_id().raw()
+        {
+            // Known non-recovery families deliberately preserve their first
+            // representative label on merge. A valid write proof does not make
+            // that later label provable from the retained source record.
+            if query.action_family() != CandidateActionFamily::Rest && source.observation_count > 1
+            {
+                return Ok(None);
+            }
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        if source.source_sequence_id != self.event.sequence_id
+            && !matches!(
+                self.write.kind,
+                MemoryUpdateKind::Inserted { .. } | MemoryUpdateKind::Evicted { .. }
+            )
+        {
+            // Equal ticks do not establish sequence membership. Only the
+            // original insertion receipt can prove a retained-first source;
+            // older merged receipts are interior/unavailable, even at one tick.
+            return Ok(None);
+        }
+        let resolved = bank.memory_id_for_sleep_sequence_scoped_v1(
+            self.event.sequence_id,
+            query.organism_id(),
+            query.profile(),
+            query.action_kind(),
+            query.action_id(),
+            query.action_family(),
+            self.event.originating_tick,
+        )?;
+        if resolved.is_some_and(|id| id != retained) {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(resolved)
+    }
+
+    fn recompute_digest(&self) -> Result<[u64; 4], ScaffoldContractError> {
+        let mut d = CanonicalDigestBuilder::new(b"ALIFE-SLEEP-MEMORY-SOURCE-PROOF-V1");
+        for word in self.key.canonical_digest() {
+            d.write_u64(word);
+        }
+        d.write_u64(self.event.sequence_id.raw());
+        d.write_u64(self.event.originating_tick.raw());
+        for word in self.event.frame_digest.0 {
+            d.write_u64(word);
+        }
+        for word in self.event.candidate_feature_digest.0 {
+            d.write_u64(word);
+        }
+        d.write_u32(self.event.action_id.raw());
+        d.write_u8(self.event.family.raw());
+        for lane in self.event.modulator.frame().lanes() {
+            d.write_f32(*lane)?;
+        }
+        for value in [
+            self.event.modulator.prediction_residual(),
+            self.event.modulator.pain(),
+            self.event.modulator.homeostatic_improvement(),
+            self.event.modulator.frustration(),
+            self.event.modulator.novelty(),
+        ] {
+            d.write_f32(value)?;
+        }
+        for word in self.target_digest {
+            d.write_u64(word);
+        }
+        let w = &self.write;
+        d.write_u8(u8::from(w.runtime_approximate));
+        d.write_u64(w.sealed_sequence_id.raw());
+        d.write_u64(w.organism_id_raw);
+        let b = &w.bucket;
+        d.write_u64(b.organism_id_raw);
+        d.write_u16(b.profile_id_raw);
+        d.write_u16(b.profile_schema_version);
+        d.write_u16(b.sensory_abi_version_raw);
+        d.write_u16(b.query_version_raw);
+        d.write_u64(b.tracked_object_id_raw);
+        d.write_u16(b.family_raw);
+        d.write_u32(b.other_action_id_raw);
+        for bin in b.target_bins {
+            d.write_u8(bin as u8);
+        }
+        let b = &w.target_bucket;
+        d.write_u64(b.organism_id_raw);
+        d.write_u16(b.profile_id_raw);
+        d.write_u16(b.profile_schema_version);
+        d.write_u16(b.sensory_abi_version_raw);
+        d.write_u16(b.query_version_raw);
+        d.write_u64(b.tracked_object_id_raw);
+        for bin in b.target_bins {
+            d.write_u8(bin as u8);
+        }
+        d.write_u64(w.input_generation);
+        d.write_u64(w.output_generation);
+        match w.kind {
+            MemoryUpdateKind::IgnoredLowInformation => d.write_u8(0),
+            MemoryUpdateKind::IgnoredLowerRetention => d.write_u8(1),
+            MemoryUpdateKind::Inserted { inserted } => {
+                d.write_u8(2);
+                d.write_u64(inserted.raw());
+            }
+            MemoryUpdateKind::Merged { into } => {
+                d.write_u8(3);
+                d.write_u64(into.raw());
+            }
+            MemoryUpdateKind::Evicted { removed, inserted } => {
+                d.write_u8(4);
+                d.write_u64(removed.raw());
+                d.write_u64(inserted.raw());
+            }
+        }
+        d.write_u32(w.record_count);
+        d.write_u32(w.capacity);
+        d.write_u64(w.merge_count);
+        d.write_u64(w.eviction_count);
+        for word in w.before_digest.into_iter().chain(w.after_digest) {
+            d.write_u64(word);
+        }
+        Ok(d.finish256())
+    }
+}
+
+/// The scoped transaction authenticates both the old bounded replay payload and
+/// its M1 operation/query/write provenance. Legacy replay digests stay exact.
+pub fn sleep_memory_replay_digest_v1(
+    evidence: &crate::sleep::SleepReplayEvidence,
+    proofs: &[SleepMemorySourceProofV1],
+) -> Result<[u64; 4], ScaffoldContractError> {
+    evidence.validate_contract()?;
+    if proofs.len() != evidence.batch.events.len() {
+        return Err(ScaffoldContractError::InvalidDecisionEvidence);
+    }
+    let mut digest = CanonicalDigestBuilder::new(b"ALIFE-SLEEP-MEMORY-REPLAY-SCOPE-V1");
+    for word in evidence.canonical_digest {
+        digest.write_u64(word);
+    }
+    digest.write_sequence_len(proofs.len());
+    for ((proof, event), target) in proofs
+        .iter()
+        .zip(&evidence.batch.events)
+        .zip(&evidence.prediction_targets)
+    {
+        proof.validate_against(event, target)?;
+        for word in proof.canonical_digest() {
+            digest.write_u64(word);
+        }
+    }
+    Ok(digest.finish256())
+}
