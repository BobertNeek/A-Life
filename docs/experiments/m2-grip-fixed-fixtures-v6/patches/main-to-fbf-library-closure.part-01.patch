+// Keep all three ordinary serialized names and binary enum tags exact. Tags 3/4
+// are deliberately NOT accepted: held Grip and research lineages are ambiguous.
+// M1 uses an explicit sparse tag, additionally protected by its outer envelope.
+impl Serialize for SensorProfile {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let (tag, name) = match self {
+            Self::PrivilegedAffordanceV1 => (0, "PrivilegedAffordanceV1"),
+            Self::GroundedObjectSlotsV1 => (1, "GroundedObjectSlotsV1"),
+            Self::GroundedTerrainVisionV1 => (2, "GroundedTerrainVisionV1"),
+            Self::GroundedObjectSlotsSleepChoiceV1 => (0x5305, "GroundedObjectSlotsSleepChoiceV1"),
+        };
+        serializer.serialize_unit_variant("SensorProfile", tag, name)
+    }
+}
+impl<'de> Deserialize<'de> for SensorProfile {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct Tag;
+        impl<'de> serde::de::Visitor<'de> for Tag {
+            type Value = SensorProfile;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("an explicit SensorProfile wire tag")
+            }
+            fn visit_u64<E: serde::de::Error>(self, v: u64) -> Result<Self::Value, E> {
+                match v {
+                    0 => Ok(SensorProfile::PrivilegedAffordanceV1),
+                    1 => Ok(SensorProfile::GroundedObjectSlotsV1),
+                    2 => Ok(SensorProfile::GroundedTerrainVisionV1),
+                    0x5305 => Ok(SensorProfile::GroundedObjectSlotsSleepChoiceV1),
+                    _ => Err(E::custom("unknown or ambiguous SensorProfile wire lineage")),
+                }
+            }
+            fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<Self::Value, E> {
+                match v {
+                    "PrivilegedAffordanceV1" => self.visit_u64(0),
+                    "GroundedObjectSlotsV1" => self.visit_u64(1),
+                    "GroundedTerrainVisionV1" => self.visit_u64(2),
+                    "GroundedObjectSlotsSleepChoiceV1" => self.visit_u64(0x5305),
+                    _ => Err(E::custom("unknown SensorProfile name")),
+                }
+            }
+        }
+        impl<'de> serde::de::DeserializeSeed<'de> for Tag {
+            type Value = SensorProfile;
+            fn deserialize<D: Deserializer<'de>>(self, d: D) -> Result<Self::Value, D::Error> {
+                d.deserialize_identifier(self)
+            }
+        }
+        struct Profile;
+        impl<'de> serde::de::Visitor<'de> for Profile {
+            type Value = SensorProfile;
+            fn expecting(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+                f.write_str("SensorProfile")
+            }
+            fn visit_enum<A: serde::de::EnumAccess<'de>>(
+                self,
+                data: A,
+            ) -> Result<Self::Value, A::Error> {
+                let (tag, unit) = data.variant_seed(Tag)?;
+                serde::de::VariantAccess::unit_variant(unit)?;
+                Ok(tag)
+            }
+        }
+        deserializer.deserialize_enum(
+            "SensorProfile",
+            &[
+                "PrivilegedAffordanceV1",
+                "GroundedObjectSlotsV1",
+                "GroundedTerrainVisionV1",
+                "GroundedObjectSlotsSleepChoiceV1",
+            ],
+            Profile,
+        )
+    }
+}
