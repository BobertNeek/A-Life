+#[test]
+fn sleep_choice_opposite_operations_never_merge_or_reverse_at_compaction() {
+    let mut b = bank(8);
+    for (seq, op, reward) in [(1, 3, 0.7), (2, 700, -0.7), (3, 3, 0.7), (4, 700, -0.7)] {
+        write(&mut b, seq, op, reward);
+    }
+    assert_eq!(b.candidate_store.records.len(), 2);
+    assert!(b
+        .candidate_store
+        .records
+        .values()
+        .all(|r| r.observation_count == 2));
+    let before = b.candidate_store.records.clone();
+    b.compact_candidate_records(OWNER, 1, 8, 1).unwrap();
+    assert_eq!(b.candidate_store.records, before);
+    let recall = b.recall_frame(&draft(100, &[3, 700])).unwrap();
+    assert!(recall.context().candidates[0].family_value[0] > 0.0);
+    assert!(recall.context().candidates[1].family_value[0] < 0.0);
+    let a = &recall.receipt().candidates;
+    assert_ne!(
+        a[0].family_bucket.other_action_id_raw,
+        a[1].family_bucket.other_action_id_raw
+    );
+    let records: Vec<_> = b.candidate_store.records.values().collect();
+    assert!(merge_candidate_records(records[0], records[1]).is_err());
+}
