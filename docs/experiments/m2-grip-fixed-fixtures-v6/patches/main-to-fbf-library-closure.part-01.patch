+//! Pre/post refactor source-only fixture. It uses no M2 APIs and can be copied
+//! unchanged onto design commit 3be4bafb to verify native bit preservation.
+#[allow(dead_code)]
+#[path = "support/recovery_sleep_recipe_v1.rs"]
+mod recipe;
+use alife_core::*;
+use alife_training::{cpu::*, *};
+use serde_json::json;
+use sha2::{Digest, Sha256};
+fn main() -> recipe::Result<()> {
+    if !std::env::args().any(|x| x == "--run-fixtures") {
+        return Err("requires --run-fixtures; no lives are run".into());
+    }
+    let r = recipe::build(0x4d32_2026, true)?;
+    let p = &r.phenotype;
+    let trainer = CpuFoundationTrainer::new(
+        p.clone(),
+        r.asset.clone(),
+        StageTrainableMask::recurrent_only(p)?,
+        AdamWConfig::default(),
+    )?;
+    let motor = p.candidate_decoder().motor_start();
+    let branches = DendriticBranchSet::new(
+        (0..64)
+            .map(|i| {
+                DendriticBranch::new(
+                    motor + i,
+                    0.1,
+                    0.25,
+                    vec![
+                        DendriticInputRef::new(motor + i, 1.)?,
+                        DendriticInputRef::new(motor + i + 1, 1.)?,
+                    ],
+                )
+            })
+            .collect::<Result<Vec<_>, ScaffoldContractError>>()?,
+    )?;
+    let mut state = TrainingInitialState {
+        activations: (0..2048).map(|i| (i % 19) as f32 / 31. - 0.3).collect(),
+        activity_ema: vec![0.12; 2048],
+        metabolic_load: vec![0.34; 2048],
+        dendrites: branches,
+    };
+    let mut results = vec![];
+    for count in [1, 18, 32] {
+        let tick = TrainingReplayTick {
+            encoded_inputs: (0..2048).map(|i| (i % 13) as f32 / 31. - 0.1).collect(),
+            projection_gain: 0.63,
+            local_threshold_shift: 0.21,
+            microstep_count: 4,
+            enabled_routes: vec![true; p.projections().len()],
+            effective_weight_offsets: vec![0.; p.synapses().len()],
+            structural_synapses: vec![],
+            candidates: (0..count)
+                .map(|i| TrainingReplayCandidate {
+                    family: CandidateActionFamily::try_from_raw((i % 8) as u8).unwrap(),
+                    decoder_inputs: std::array::from_fn(|k| ((i + k) % 9) as f32 / 11. - 0.2),
+                    innate_bias: (i % 5) as f32 / 17.,
+                })
+                .collect(),
+        };
+        let q = TrainingSequence {
+            phenotype_hash: p.phenotype_hash(),
+            initial: state.clone(),
+            ticks: vec![tick],
+            burn_in_ticks: 0,
+            memory_candidate_gain: p
+                .candidate_decoder()
+                .memory_channel()
+                .unwrap()
+                .max_candidate_gain(),
+        };
+        let evaluation = trainer.evaluate_replay(&q)?;
+        let bits = |xs: &[f32]| xs.iter().map(|x| x.to_bits()).collect::<Vec<_>>();
+        results.push(json!({"candidate_count":count,"logits":bits(&evaluation.candidate_logits[0]),"activations":bits(&evaluation.final_activations[0]),"ema":bits(&evaluation.final_activity_ema[0]),"metabolic":bits(&evaluation.final_metabolic_load[0])}));
+        state
+            .activations
+            .clone_from(&evaluation.final_activations[0]);
+        state
+            .activity_ema
+            .clone_from(&evaluation.final_activity_ema[0]);
+        state
+            .metabolic_load
+            .clone_from(&evaluation.final_metabolic_load[0]);
+    }
+    let bytes = serde_json::to_vec(&results)?;
+    println!(
+        "{}",
+        serde_json::to_string_pretty(
+            &json!({"fixture":"real B1+reader4heads/timer, synthetic nonzero state, no life import", "source_inputs":r.inputs.canonical_digest(),"source_asset":r.asset.digest(),"results":results,"sha256":format!("{:x}",Sha256::digest(&bytes)),"optimizer_steps":0,"world_steps":0,"sampled_actions":0})
+        )?
+    );
+    Ok(())
+}
diff --git a/crates/alife_training/examples/probe_motor_host_behavior.rs b/crates/alife_training/examples/probe_motor_host_behavior.rs
new file mode 100644
index 0000000000000000000000000000000000000000..56aab0ffbd9bd0a32b7b1e5ad9a35eb1c307417e
--- /dev/null
+++ b/crates/alife_training/examples/probe_motor_host_behavior.rs
@@ -0,0 +1,303 @@
+//! Frozen fresh Full/Sham comparison. No autonomous work without --run NEW_DIR.
+#[path = "support/motor_host_preparation_v1.rs"]
+mod preparation;
+#[allow(dead_code)]
+#[path = "support/grounded_developmental_recipe.rs"]
+mod recipe;
+use alife_core::*;
+use alife_training::cpu::*;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{fs, path::Path};
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+fn hash<T: serde::Serialize>(v: &T) -> Result<String> {
+    Ok(format!("{:x}", Sha256::digest(serde_json::to_vec(v)?)))
+}
+fn plan() -> Value {
+    json!({"schema":"motor_host_full_sham_v1","seed":preparation::SEED,
+    "arms":["Full","EqualWorkSham"],"scenes":["food_hunger_fatigue_in_reach","toy_curiosity_in_reach"],
+    "fresh_lives":4,"body_only_ticks_per_life":240,"decision_windows_per_life":8,"maximum_world_intervals":992,"maximum_decisions":32,
+    "sampling_seed":preparation::SEED as u32,"sampling_temperature":1.0,"optimizer_updates":0,
+    "source":"B1 whole-care6 + counterbalance + full references + dedicated fatigue B + tonic-on; build(seed,false)",
+    "zero_added_class5_rows":1280,"fixed_recipe":"archived M0 unchanged; ATP reference .5; unsigned thermal stress",
+    "health_stop":"Before each decision window: dead, body health < .5 or body energy < .05 stops that arm",
+    "error_rule":"Archive attempted window and exact rollback identity; stop affected arm, continue other predeclared arms; no retries, replacement lives or horizon extension",
+    "preparation_error":"Abort before decisions if either paired initial state cannot be prepared or matched",
+    "fixed_footprint":"96 cells,22 assignments,70 branches,184 branch inputs,50 readouts in both modes",
+    "mode_difference":"Only appended drive signals become their declared references in EqualWorkSham; ordinary source encoding/plasticity remain active",
+    "matched_initial_exclusions":["outer mode","each controller mode","world organism brain content digest, which binds mode"],
+    "biology":"single canonical body-energy work debit and later chemistry; Q24->Q16 is reservation, not a second chemical debit",
+    "baseline":"No old-price class5 arm; the causal Full/Sham pair shares the successor work policy",
+    "pain_reflex":"Directional physical pain shortcut remains OFF; M0 pain scoring is not a reflex-on experiment",
+    "claims_excluded":["navigation","broad drive competence","optimal thresholds","awakening-rest mechanism","M1 sleep-pressure input","existing-life migration","GPU/PPO admission"],
+    "first_outcome_rule":"Keep null, adverse, transient and partial outcomes; no calibration or additional seeds in this revision"})
+}
+fn normalized_initial(mut cp: Value) -> Result<Value> {
+    *cp.get_mut("mode").ok_or("missing mode")? = Value::Null;
+    for state in cp
+        .get_mut("controllers")
+        .and_then(Value::as_object_mut)
+        .ok_or("missing controllers")?
+        .values_mut()
+    {
+        *state.get_mut("mode").ok_or("missing controller mode")? = Value::Null;
+    }
+    for record in cp
+        .pointer_mut("/canonical/world/world/organism_records")
+        .and_then(Value::as_array_mut)
+        .ok_or("missing world records")?
+    {
+        *record
+            .pointer_mut("/state_graph/brain/content_digest")
+            .ok_or("missing brain seal")? = Value::Null;
+    }
+    Ok(cp)
+}
+struct Trial {
+    host: CpuMotorLobeHostV1,
+    scene: usize,
+    mode: MotorHostModeV1,
+    initial: Value,
+    prep: Value,
+}
+fn trial(mut trial: Trial, p: &BrainPhenotype, directory: &Path, index: usize) -> Result<Value> {
+    let initial_optimizer = trial.initial["founder"].clone();
+    let mut rows = Vec::new();
+    let mut stop = None;
+    for window in 0..8 {
+        let before_cp = serde_json::to_value(trial.host.checkpoint()?)?;
+        let record = trial
+            .host
+            .world()
+            .organism_registry()
+            .iter()
+            .next()
+            .ok_or("missing resident")?
+            .clone();
+        if !record.lifecycle().is_alive()
+            || record.biochemistry().body.health < 0.5
+            || record.biochemistry().body.energy < 0.05
+        {
+            stop = Some("predeclared health/energy stop".to_owned());
+            break;
+        }
+        let biology = *record.biochemistry();
+        let receptors = biology.neural_receptor_frame(record.phenotype())?;
+        let effects =
+            NeuralReceptorEffects::from_frame(&receptors, &NeuralReceptorPhenotype::compile(p)?)?;
+        let before_objects = before_cp
+            .pointer("/canonical/world/world/objects")
+            .ok_or("missing pre-step object state")?
+            .clone();
+        let step = match trial.host.step(1.) {
+            Ok(value) => value,
+            Err(error) => {
+                let after_cp = serde_json::to_value(trial.host.checkpoint()?)?;
+                let rollback_exact = before_cp == after_cp;
+                let failure = json!({"status":"step_error","window":window,"error":error.to_string(),"rollback_exact":rollback_exact,"tick_before":record.biochemistry().tick,"tick_after":trial.host.world().tick(),"committed_decisions":after_cp["canonical"]["sampling_counter"].as_u64().unwrap_or(0).saturating_sub(before_cp["canonical"]["sampling_counter"].as_u64().unwrap_or(0)),"committed_world_intervals":trial.host.world().tick().raw().saturating_sub(record.biochemistry().tick.raw()),"before_checkpoint_sha256":hash(&before_cp)?,"after_checkpoint_sha256":hash(&after_cp)?});
+                fs::write(
+                    directory.join(format!("trial-{index}-window-{window}-error.json")),
+                    serde_json::to_vec_pretty(&failure)?,
+                )?;
+                rows.push(failure);
+                stop = Some("step error, no retry".to_owned());
+                break;
+            }
+        };
+        // Write authoritative committed tick/action data before auditing or
+        // formatting can fail. A reporting error must never erase execution.
+        let mut commit_receipt = json!({"status":"committed_unchecked","window":window,
+            "tick_before":step.tick_before,"tick_after":step.tick_after,
+            "committed_decisions":step.decisions.len(),"committed_world_intervals":step.tick_after.raw()-step.tick_before.raw(),
+            "sampling_counter_before":before_cp["canonical"]["sampling_counter"],
+            "sampling_counter_after_expected_from_returned_decisions":before_cp["canonical"]["sampling_counter"].as_u64().unwrap_or(0)+step.decisions.len() as u64,
+            "returned_decisions":step.decisions.iter().map(|d|json!({"organism":d.organism_id,"action":d.action,"patch":d.patch,"motor":d.motor})).collect::<Vec<_>>()});
+        fs::write(
+            directory.join(format!("trial-{index}-window-{window}-commit.json")),
+            serde_json::to_vec_pretty(&commit_receipt)?,
+        )?;
+        let reported = (|| -> Result<Value> {
+            let after = trial
+                .host
+                .world()
+                .organism_registry()
+                .get(record.organism_id())
+                .ok_or("missing post-step resident")?;
+            let after_cp = serde_json::to_value(trial.host.checkpoint()?)?;
+            commit_receipt["sampling_counter_after"] =
+                after_cp["canonical"]["sampling_counter"].clone();
+            if serde_json::to_vec(&after_cp["founder"])? != serde_json::to_vec(&initial_optimizer)?
+            {
+                return Err("founder optimizer changed".into());
+            }
+            let decisions=step.decisions.iter().map(|d|->Result<Value>{
+            for i in 0..d.motor.candidate_logits.len(){
+                if (d.motor.source_candidate_logits[i]+d.motor.fixed_candidate_contributions[i]).to_bits()!=d.motor.candidate_logits[i].to_bits(){return Err("native pre-head + fixed-head f32 order changed".into());}
+            }
+            let frame=d.patch.pre_action().perception();
+            let representative=&frame.candidates()[d.action.representative as usize];
+            let confidence=(representative.sensor_confidence.raw()*65535.).round()/65535.;
+            let arousal=d.motor.candidate_logits[d.action.representative as usize].abs().tanh();
+            Ok(json!({"organism":d.organism_id,"action":d.action,"patch":d.patch,"motor":d.motor,
+                "all_candidates":frame.candidates(),"actual_effects":effects,"actual_receptors":receptors,
+                "regional_arousal_activity":arousal,"regional_arousal_confidence":confidence,
+                "regional_arousal_product":arousal*confidence,
+                "head_identity":"native source aggregate already includes family/innate/memory/cognitive; final f32 is source + fixed head, not a reordered component sum",
+                "physical_directional_pain_reflex_enabled":false}))
+        }).collect::<Result<Vec<_>>>()?;
+            let row = json!({"status":"ok","window":window,"tick_before":step.tick_before,"tick_after":step.tick_after,
+            "committed_decisions":step.decisions.len(),"committed_world_intervals":step.tick_after.raw()-step.tick_before.raw(),
+            "sleeping_organisms":step.sleeping_organisms,"sleep_consolidations":step.sleep_consolidations,
+            "sleep_phase_before":record.sleep_phase(),"sleep_phase_after":after.sleep_phase(),
+            "biology_before":biology,"biology_after":after.biochemistry(),
+            "embodiment_before":record.embodiment(),"embodiment_after":after.embodiment(),
+            "objects_before":before_objects,"objects_after":after_cp.pointer("/canonical/world/world/objects").ok_or("missing post-step object state")?,
+            "work_receipt_after":after.cognitive_work(),"body_energy_debit_after":after.cognitive_energy_debit(),
+            "sampling_counter_before":before_cp["canonical"]["sampling_counter"],"sampling_counter_after":after_cp["canonical"]["sampling_counter"],
+            "prefix_state_before_sha256":hash(&before_cp["canonical"]["residents"])? ,"prefix_state_after_sha256":hash(&after_cp["canonical"]["residents"])? ,
+            "controller_before_sha256":hash(&before_cp["controllers"])? ,"controller_after_sha256":hash(&after_cp["controllers"])? ,
+            "full_checkpoint_before_sha256":hash(&before_cp)? ,"full_checkpoint_after_sha256":hash(&after_cp)? ,
+            "decisions":decisions});
+            Ok(row)
+        })();
+        let row = match reported {
+            Ok(row) => row,
+            Err(error) => {
+                commit_receipt["status"] = json!("reporting_error");
+                commit_receipt["error"] = json!(error.to_string());
+                fs::write(
+                    directory.join(format!("trial-{index}-window-{window}-error.json")),
+                    serde_json::to_vec_pretty(&commit_receipt)?,
+                )?;
+                rows.push(commit_receipt);
+                stop = Some(
+                    "post-step reporting error; committed action retained, no retry".to_owned(),
+                );
+                break;
+            }
+        };
+        fs::write(
+            directory.join(format!("trial-{index}-window-{window}.json")),
+            serde_json::to_vec_pretty(&row)?,
+        )?;
+        rows.push(row);
+    }
+    let final_checkpoint = match trial.host.checkpoint() {
+        Ok(cp) => json!({"sha256":hash(&cp)?}),
+        Err(error) => json!({"error":error.to_string()}),
+    };
+    Ok(
+        json!({"scene":trial.scene,"mode":trial.mode,"stop":stop,"accounting":window_accounting(&rows),
+        "preparation":trial.prep,"initial_checkpoint_sha256":hash(&trial.initial)?,"final_checkpoint":final_checkpoint,"rows":rows}),
+    )
+}
+fn window_accounting(rows: &[Value]) -> Value {
+    json!({"attempted_windows":rows.len(),
+        "error_attempts":rows.iter().filter(|r|r["status"]=="step_error" || r["status"]=="reporting_error").count(),
+        "successful_reported_windows":rows.iter().filter(|r|r["status"]=="ok").count(),
+        "committed_windows":rows.iter().filter(|r|r["committed_world_intervals"].as_u64()==Some(1)).count(),
+        "committed_world_intervals":rows.iter().map(|r|r["committed_world_intervals"].as_u64().unwrap_or(0)).sum::<u64>(),
+        "actual_decisions":rows.iter().map(|r|r["committed_decisions"].as_u64().unwrap_or(0)).sum::<u64>()})
+}
+#[test]
+fn rolled_back_attempt_is_not_a_committed_window() {
+    let rows = vec![
+        json!({"status":"ok","tick_after":10,"committed_world_intervals":1,"committed_decisions":1}),
+        json!({"status":"step_error","tick_after":10,"committed_world_intervals":0,"committed_decisions":0}),
+        json!({"status":"reporting_error","tick_after":11,"committed_world_intervals":1,"committed_decisions":1}),
+    ];
+    assert_eq!(
+        window_accounting(&rows),
+        json!({"attempted_windows":3,"error_attempts":2,"successful_reported_windows":1,"committed_windows":2,"committed_world_intervals":2,"actual_decisions":2})
+    );
+}
+
+fn main() -> Result<()> {
+    let args = std::env::args().skip(1).collect::<Vec<_>>();
+    if args.is_empty() || args == ["--plan"] {
+        println!("{}", serde_json::to_string_pretty(&plan())?);
+        return Ok(());
+    }
+    let directory = match args.as_slice() {
+        [mode, path] if mode == "--run" => Path::new(path),
+        _ => return Err("expected --plan or --run NEW_DIRECTORY".into()),
+    };
+    let revision = std::env::var("MOTOR_HOST_SOURCE_COMMIT")?;
+    if revision.len() != 40 || !revision.bytes().all(|b| b.is_ascii_hexdigit()) {
+        return Err("exact frozen source commit required".into());
+    }
+    fs::create_dir(directory)?;
+    fs::write(
+        directory.join("protocol.json"),
+        serde_json::to_vec_pretty(&plan())?,
+    )?;
+    fs::write(directory.join("source-commit.txt"), format!("{revision}\n"))?;
+    fs::write(
+        directory.join("executable.sha256"),
+        format!(
+            "{:x}\n",
+            Sha256::digest(fs::read(std::env::current_exe()?)?)
+        ),
+    )?;
+    let recipe = recipe::build(preparation::SEED, false)?;
+    fs::write(
+        directory.join("recipe.json"),
+        serde_json::to_vec_pretty(&recipe.metadata)?,
+    )?;
+    let mut trials = Vec::new();
+    for scene in 0..2 {
+        let mut normalized = None;
+        for mode in [MotorHostModeV1::Full, MotorHostModeV1::EqualWorkSham] {
+            let (host, prep) = match preparation::prepare(&recipe, scene, mode) {
+                Ok(prepared) => prepared,
+                Err(error) => {
+                    fs::write(
+                        directory.join("preparation-error.json"),
+                        serde_json::to_vec_pretty(
+                            &json!({"scene":scene,"mode":mode,"error":error.to_string(),"completed_preparations":trials.len(),"completed_preparation_intervals":trials.len()*240,"partial_preparation_intervals_upper_bound":240,"actual_decisions":0,"retry":false}),
+                        )?,
+                    )?;
+                    return Err(error);
+                }
+            };
+            let initial = serde_json::to_value(host.checkpoint()?)?;
+            let candidate = normalized_initial(initial.clone())?;
+            if let Some(expected) = &normalized {
+                if serde_json::to_vec(expected)? != serde_json::to_vec(&candidate)? {
+                    return Err("paired initial state differs beyond mode/seal".into());
+                }
+            } else {
+                normalized = Some(candidate.clone());
+            }
+            fs::write(
+                directory.join(format!("preparation-{}.json", trials.len())),
+                serde_json::to_vec_pretty(
+                    &json!({"preparation":prep,"normalized_initial_sha256":hash(&candidate)?,"full_initial_sha256":hash(&initial)?}),
+                )?,
+            )?;
+            trials.push(Trial {
+                host,
+                scene,
+                mode,
+                initial,
+                prep,
+            });
+        }
+    }
+    let mut results = Vec::new();
+    for (index, t) in trials.into_iter().enumerate() {
+        let result = trial(t, &recipe.phenotype, directory, index)?;
+        fs::write(
+            directory.join(format!("trial-{index}.json")),
+            serde_json::to_vec_pretty(&result)?,
+        )?;
+        results.push(result);
+    }
+    fs::write(
+        directory.join("results.json"),
+        serde_json::to_vec_pretty(
+            &json!({"schema":"motor_host_full_sham_v1","source_commit":revision,"results":results}),
+        )?,
+    )?;
+    Ok(())
+}
diff --git a/crates/alife_training/examples/probe_motor_mediation_native_v1.rs b/crates/alife_training/examples/probe_motor_mediation_native_v1.rs
