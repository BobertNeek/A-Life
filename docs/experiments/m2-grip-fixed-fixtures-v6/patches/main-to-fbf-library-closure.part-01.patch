diff --git a/crates/alife_core/src/phenotype/motor_lobe_lowering.rs b/crates/alife_core/src/phenotype/motor_lobe_lowering.rs
new file mode 100644
index 0000000000000000000000000000000000000000..53b0d6d901936349ce7b91bcfa97e76efef6ea2c
--- /dev/null
+++ b/crates/alife_core/src/phenotype/motor_lobe_lowering.rs
@@ -0,0 +1,129 @@
+//! Exact append-only lowering. The generic legacy decoder validator is not
+//! loosened: class 6 uses whole-record deterministic reconstruction validation.
+use super::*;
+use crate::{
+    ActivationFunction, ActiveTilePolicy, BiologicalPriority, CandidateActionFamily, LobeKind,
+    MotorLobeM0V1, ProjectionType, UpdateCadence, MOTOR_LOBE_NEURONS, MOTOR_LOBE_START,
+};
+
+impl BrainPhenotype {
+    pub(in crate::phenotype) fn lower_motor_lobe_m0(
+        inputs: &PhenotypeCompilerInputs,
+    ) -> Result<Self, ScaffoldContractError> {
+        let capacity = BrainCapacityClass::n2144_motor_lobe_research();
+        inputs.validate_against(&capacity)?;
+        let recipe = inputs
+            .foundation_abi()
+            .motor_lobe_m0()
+            .ok_or(ScaffoldContractError::PhenotypeCompile)?;
+        let mut value = crate::PhenotypeCompiler::compile_validated(
+            recipe.source_inputs(),
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+        )?;
+        if value.neuron_count != MOTOR_LOBE_START
+            || value.synapses.len() != MotorLobeM0V1::BASE_SYNAPSES
+        {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        // Reserve recruitment preserves all nine homologue identities and every
+        // old address. The named motor-control partition is [2048,2144) within
+        // FlexibleReserve; its subregions are fixed by the M0 recipe.
+        let reserve = value
+            .lobe_layout
+            .regions
+            .last_mut()
+            .ok_or(ScaffoldContractError::PhenotypeCompile)?;
+        if reserve.kind != LobeKind::FlexibleReserve || reserve.end() != MOTOR_LOBE_START {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        reserve.len += MOTOR_LOBE_NEURONS;
+        value.neuron_count += MOTOR_LOBE_NEURONS;
+        value
+            .lobe_layout
+            .validate_for_neuron_count(value.neuron_count)?;
+        value
+            .neuron_dynamics
+            .extend((0..MOTOR_LOBE_NEURONS).map(|_| {
+                // Native source EMA/metabolic tracking constants retained. Pair
+                // feedback is zero, but activity and metabolic load still update.
+                NeuronDynamics::new(0., 0.5, ActivationFunction::Tanh, 0.95, 0.01, 0.)
+            }));
+        value.sensor_encoder = value.sensor_encoder.with_motor_lobe_m0()?;
+        let route = u16::try_from(value.projections.len())
+            .map_err(|_| ScaffoldContractError::PhenotypeCompile)?;
+        let start = value.synapses.len() as u32;
+        for r in crate::motor_lobe::plan::READOUTS {
+            let source = MOTOR_LOBE_START + r.source as u32;
+            value.synapses.push(CompiledSynapse::new(
+                source,
+                source,
+                r.weight,
+                0.,
+                route,
+                CompiledSynapseKind::Decoder(DecoderSynapseCoordinate::new(
+                    DecoderHeadKind::ActionCandidate,
+                    CandidateActionFamily::try_from_raw(r.family)?,
+                    r.lane as u16,
+                    // Separate head's output coordinate, not an offset into the
+                    // legacy motor block. Generic live upload is forbidden.
+                    r.source as u16,
+                )),
+            ));
+        }
+        value.projections.push(CompiledProjection::new(
+            route,
+            LobeKind::FlexibleReserve,
+            LobeKind::FlexibleReserve,
+            ProjectionType::MotorProposal,
+            ActiveTilePolicy::EssentialReservation,
+            UpdateCadence::Hot60Hz,
+            BiologicalPriority::Essential,
+            0,
+            start,
+            50,
+            0,
+        ));
+        value.budgets.capacity_class_id = capacity.id();
+        value.budgets.execution_abi_digest = capacity.canonical_digest();
+        value.budgets.global.neuron_count = value.neuron_count;
+        value.budgets.global.action_decoder_synapses += 50;
+        value.budgets.global.total_synapses += 50;
+        value.budgets.global.immutable_payload_words += 50;
+        value.budgets.routes.push(crate::RouteBudgetReceipt {
+            route_index: route,
+            active_tiles: 0,
+            recurrent_synapses: 0,
+            action_decoder_synapses: 50,
+            memory_decoder_synapses: 0,
+            immutable_payload_words: 50,
+            tile_ceiling: 0,
+            synapse_ceiling: 50,
+            payload_word_ceiling: 50,
+        });
+        value.budgets.validate_against(&capacity)?;
+        value.brain_class_id = capacity.id();
+        value.compiler_inputs_digest = inputs.canonical_digest();
+        value.foundation_abi_selection = inputs.foundation_abi().clone();
+        value.persistent_address_map =
+            PersistentAddressMap::compile(&value.lobe_layout, &value.projections, &value.synapses)?;
+        // Both digests bind source ABI, appended coordinates, fixed branch and
+        // encoder semantics, dynamics, prices and the detached-only write policy.
+        use crate::blake3_digest::{domain_hasher, Blake3Write};
+        let mut route_hash = domain_hasher(b"alife.motor-lobe.m0.route.v1");
+        let mut plasticity_hash = domain_hasher(b"alife.motor-lobe.m0.fixed.v1");
+        for byte in value.route_abi_digest.bytes() {
+            route_hash.write_u8(*byte);
+        }
+        for byte in value.plasticity_abi_digest.bytes() {
+            plasticity_hash.write_u8(*byte);
+        }
+        for word in MotorLobeM0V1::recipe_digest() {
+            route_hash.write_u64(word);
+            plasticity_hash.write_u64(word);
+        }
+        value.route_abi_digest = Blake3Digest::from_hasher(route_hash);
+        value.plasticity_abi_digest = Blake3Digest::from_hasher(plasticity_hash);
+        value.phenotype_hash = value.recompute_phenotype_hash()?;
+        Ok(value)
+    }
+}
