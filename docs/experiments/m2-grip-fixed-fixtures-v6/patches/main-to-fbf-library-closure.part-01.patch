@@ -0,0 +1,58 @@
+//! Exact M1 recovery capability registry. Legacy action dispatch never calls it.
+use crate::*;
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub enum RecoveryOperationV1 {
+    BodySleep,
+    AwakeRest,
+}
+impl RecoveryOperationV1 {
+    pub const fn action_id(self) -> ActionId {
+        ActionId(match self {
+            Self::BodySleep => 3,
+            Self::AwakeRest => 700,
+        })
+    }
+    pub const fn decoder_sign(self) -> f32 {
+        match self {
+            Self::BodySleep => 1.,
+            Self::AwakeRest => -1.,
+        }
+    }
+    pub fn from_action(
+        family: CandidateActionFamily,
+        kind: ActionKind,
+        id: ActionId,
+    ) -> Result<Option<Self>, ScaffoldContractError> {
+        // Held Grip belongs to profile4 and cannot gain M1 meaning through
+        // candidate, memory import, or replay validation.
+        if matches!(id.raw(), 2201 | 2202) {
+            return Err(ScaffoldContractError::InvalidActionCandidate);
+        }
+        if family != CandidateActionFamily::Rest {
+            if id == Self::BodySleep.action_id() || id == Self::AwakeRest.action_id() {
+                return Err(ScaffoldContractError::InvalidActionCandidate);
+            }
+            return Ok(None);
+        }
+        if kind != ActionKind::Rest {
+            return Err(ScaffoldContractError::InvalidActionCandidate);
+        }
+        match id.raw() {
+            3 => Ok(Some(Self::BodySleep)),
+            700 => Ok(Some(Self::AwakeRest)),
+            _ => Err(ScaffoldContractError::InvalidActionCandidate),
+        }
+    }
+    pub fn for_candidate(c: &ActionCandidate) -> Result<Option<Self>, ScaffoldContractError> {
+        let value = Self::from_action(c.family, c.kind, c.action_id)?;
+        if value.is_some()
+            && (c.target != ActionTarget::NONE || c.observation != CandidateObservationRef::None)
+        {
+            return Err(ScaffoldContractError::InvalidActionCandidate);
+        }
+        Ok(value)
+    }
+}
