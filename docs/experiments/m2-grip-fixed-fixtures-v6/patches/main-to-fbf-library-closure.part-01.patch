+//! Source-only R0 genetics. This module never advances a world or loads a life.
+//!
+//! The bounded source is reconstructed from `physiology_host::fixture` at
+//! 6dee4ea0e93cb8e7315e94611d9ac0c86fb97ff4, with bounded/dedicated/tonic all true.
+//! Only its pure constructors are used. The adjacent grounded_r0_* files are
+//! byte-for-byte constructor copies from that revision; source hashes are in
+//! the recipe receipt below. No archived chemistry, rollout, or result is used.
+//! All four source files also match report revision 42058a91 and head cdd33942.
+
+#[allow(dead_code)]
+#[path = "grounded_r0_dedicated_fatigue.rs"]
+mod dedicated;
+#[allow(dead_code)]
+#[path = "multidrive_frozen.rs"]
+mod frozen;
+#[allow(dead_code)]
+#[path = "grounded_r0_motor_operating_point.rs"]
+mod readout;
+
+use alife_core::*;
+use alife_runtime::canonical_preparation::foundation_construction_development;
+use alife_training::transfer_bounded_genetic_founder_to_grounded_drive;
+use alife_world::*;
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+
+pub type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+
+pub struct R0Recipe {
+    pub config: CanonicalNewGameConfig,
+    pub genotype: CreatureGenome,
+    pub phenotype: BrainPhenotype,
+    pub inputs: PhenotypeCompilerInputs,
+    pub asset: FoundationWeightAsset,
+    /// Every newly introduced row, including the four authored rows in that arm.
+    pub added_rows: Vec<usize>,
+    pub metadata: Value,
+}
+
+/// Construct matched NEW founders, with either 1,280 zero added coefficients or
+/// exactly the four prospective lane-36 coefficients. All retained coefficients
+/// are copied by complete persistent address through the checked transfer API.
+pub fn build(seed: u64, authored: bool) -> Result<R0Recipe> {
+    let mut config = CanonicalNewGameConfig::phase3(seed, 1)?;
+    config.brain_class = BrainScaleTier::Standard2048;
+    if config.sensor_profile != SensorProfile::GroundedObjectSlotsV1 {
+        return Err("R0 requires GroundedObjectSlotsV1".into());
+    }
+
+    // Obtain the actual canonical anatomy, biochemical calibration, and mixed
+    // construction genes BEFORE compiling any bounded asset. A raw BrainGenome
+    // scaffold is not an acceptable substitute for this expressed founder.
+    let builtin = FoundationWeightAsset::builtin_n2048_v1(config.sensor_profile)?;
+    let original = create_canonical_new_game_with_n2048_candidate(&config, &builtin)?;
+    let original_record = original
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("canonical newborn missing")?;
+    let original_genotype = original_record.genome().clone();
+    let genome = original_record.phenotype().brain_genome.clone();
+    let development = foundation_construction_development(
+        &genome,
+        &BrainCapacityClass::n2048(),
+        &original_record
+            .phenotype()
+            .development_state_at(Tick::ZERO)?,
+    )?;
+    if original_record.biochemistry().tick != Tick::ZERO
+        || original_record.biochemistry().development.age_ticks != Tick::ZERO
+        || !original_genotype.parent_genome_ids.is_empty()
+    {
+        return Err("source must be a genuine zero-tick canonical founder".into());
+    }
+    let (bounded, _) = PhenotypeCompiler::compile_n2048_bounded_founder(
+        genome.clone(),
+        development.clone(),
+        config.sensor_profile,
+    )?;
+    let (weights, circuits) = frozen::whole_care(&bounded)?;
+    let (weights, differential) = readout::counterbalance(&bounded, &weights, &circuits, 0., true)?;
+    let (weights, references) =
+        dedicated::full_reference_calibration(&bounded, &weights, &circuits, true)?;
+    let (weights, dedicated_b) =
+        dedicated::build(&bounded, &weights, dedicated::Factor::Dedicated)?;
+    let tonic = validate_tonic_on(&bounded, &weights)?;
+    // The codec names this constructor from_trained_weights, but these are
+    // purely source-authored genetic values. No training or acquired input ran.
+    let source_asset = FoundationWeightAsset::from_trained_weights(
+        &bounded,
+        weights,
+        TrainingStageManifest::bootstrap(),
+    )?;
+    let (source_phenotype, source_inputs) =
+        PhenotypeCompiler::compile_n2048_bounded_founder_candidate(
+            genome,
+            development,
+            source_asset.clone(),
+        )?;
+    source_asset.validate_against(&source_phenotype)?;
+
+    // Bind the exact bounded asset through the ordinary canonical candidate
+    // constructor, then prove it retained every original construction gene.
+    let source_game =
+        create_canonical_new_game_with_n2048_experimental_candidate(&config, &source_asset)?;
+    let source_record = source_game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("bounded canonical newborn missing")?;
+    let source_genotype = source_record.genome().clone();
+    let mut expected_source = original_genotype;
+    expected_source.foundation = source_genotype.foundation;
+    expected_source.n2048_foundation_candidate = Some(source_asset.clone());
+    if source_genotype != expected_source
+        || source_record.phenotype().brain_genome != *source_inputs.genome()
+        || foundation_construction_development(
+            &source_record.phenotype().brain_genome,
+            &BrainCapacityClass::n2048(),
+            &source_record.phenotype().development_state_at(Tick::ZERO)?,
+        )? != *source_inputs.development()
+        || source_record.biochemistry().tick != Tick::ZERO
+        || source_record.biochemistry().development.age_ticks != Tick::ZERO
+    {
+        return Err("bounded asset binding changed canonical founder genes or development".into());
+    }
+
+    let transfer = transfer_bounded_genetic_founder_to_grounded_drive(
+        &source_phenotype,
+        &source_inputs,
+        &source_asset,
+    )?;
+    if transfer.source_asset_digest != source_asset.digest()
+        || transfer.source_to_target.len() != 32_768
+        || transfer.added_zero_rows != 1_280
+    {
+        return Err("unexpected R0 source transfer receipt".into());
+    }
+    let retained: BTreeSet<_> = transfer
+        .source_to_target
+        .iter()
+        .map(|(_, new)| *new as usize)
+        .collect();
+    if retained.len() != 32_768 || transfer.asset.weights().len() != 34_048 {
+        return Err("unexpected R0 target graph size or duplicate retained row".into());
+    }
+    let added_rows = (0..transfer.asset.weights().len())
+        .filter(|i| !retained.contains(i))
+        .collect::<Vec<_>>();
+    if added_rows.len() != 1_280 {
+        return Err("R0 must add exactly 1,280 rows".into());
+    }
+    let added: BTreeSet<_> = added_rows.iter().copied().collect();
+    let mut weights = transfer.asset.weights().to_vec();
+    let mut authored_rows = BTreeMap::new();
+    let mut coordinates = Vec::new();
+    for (family, motor, coefficient) in [
+        (CandidateActionFamily::Approach, 1779, -0.4_f32),
+        (CandidateActionFamily::Approach, 1791, 0.4_f32),
+        (CandidateActionFamily::Inspect, 1766, 0.5_f32),
+        (CandidateActionFamily::Inspect, 1775, -0.5_f32),
+    ] {
+        let (row, address) = observed_object_row(&transfer.phenotype, family, motor)?;
+        if !added.contains(&row)
+            || weights[row].to_bits() != 0_f32.to_bits()
+            || authored_rows.insert(row, coefficient).is_some()
+        {
+            return Err("authored coordinate must be a distinct newly added zero row".into());
+        }
+        if authored {
+            weights[row] = coefficient;
+        }
+        coordinates.push(json!({
+            "row": row, "address": address, "family": family, "lane": 36,
+            "motor": motor, "authored_coefficient": coefficient,
+            "actual_coefficient": weights[row],
+        }));
+    }
+    for &row in &added_rows {
+        let expected = if authored {
+            authored_rows.get(&row).copied().unwrap_or(0.)
+        } else {
+            0.
+        };
+        if weights[row].to_bits() != expected.to_bits() {
+            return Err("undeclared added-row genetic coefficient".into());
+        }
+    }
+
+    let asset = FoundationWeightAsset::from_trained_weights(
+        &transfer.phenotype,
+        weights,
+        source_asset.manifest().training_stage(),
+    )?;
+    let (phenotype, inputs) = PhenotypeCompiler::compile_n2048_grounded_drive_basis_candidate(
+        transfer.inputs.genome().clone(),
+        transfer.inputs.development().clone(),
+        asset.clone(),
+    )?;
+    asset.validate_against(&phenotype)?;
+    if inputs.genome() != transfer.inputs.genome()
+        || inputs.development() != transfer.inputs.development()
+        || phenotype.persistent_address_map() != transfer.phenotype.persistent_address_map()
+    {
+        return Err("R0 authoring changed construction inputs or persistent addresses".into());
+    }
+    for (old, new) in &transfer.source_to_target {
+        if asset.weights()[*new as usize].to_bits()
+            != source_asset.weights()[*old as usize].to_bits()
+        {
+            return Err("R0 authoring changed a retained source weight".into());
+        }
+    }
+    for (row, (before, after)) in transfer
+        .phenotype
+        .synapses()
+        .iter()
+        .zip(phenotype.synapses())
+        .enumerate()
+    {
+        if before.kind() != after.kind()
+            || before.source() != after.source()
+            || before.target() != after.target()
+            || before.route_index() != after.route_index()
+            || before.alpha().to_bits() != after.alpha().to_bits()
+            || before.receptor_index() != after.receptor_index()
+            || after.genetic_weight().to_bits() != asset.weights()[row].to_bits()
+        {
+            return Err("R0 admission changed a causal coordinate or its genetic weight".into());
+        }
+    }
+    let changed = asset
+        .weights()
+        .iter()
+        .zip(transfer.asset.weights())
+        .filter(|(a, b)| a.to_bits() != b.to_bits())
+        .count();
+    if changed != if authored { 4 } else { 0 } {
+        return Err("R0 must change exactly the declared four rows, or none".into());
+    }
+    let genotype = CreatureGenome::from_n2048_grounded_drive_transfer(
+        &source_genotype,
+        &inputs,
+        asset.clone(),
+    )?;
+    genotype.validate_n2048_grounded_drive_inputs(&inputs)?;
+
+    let mut map_digest = CanonicalDigestBuilder::new(b"alife.grounded-drive-r0.source-map.v1");
+    for &(old, new) in &transfer.source_to_target {
+        map_digest.write_u32(old);
+        map_digest.write_u32(new);
+    }
+    let metadata = json!({
+        "schema": "grounded_developmental_r0_recipe_v1",
+        "seed": seed, "authored": authored,
+        "sensor_profile": config.sensor_profile,
+        "source_recipe": "bounded + B1 whole-care6 + full differential references + dedicated fatigue B + tonic-on",
+        "source_revision": "6dee4ea0e93cb8e7315e94611d9ac0c86fb97ff4",
+        "source_report_revision": "42058a91a695c33ee7b74e1b5d67351ffb19b4d6",
+        "source_identical_at_head": "cdd339421528e198a7a0114ab9753bd185984df6",
+        "source_sha256": {
+            "physiology_host.rs": "94addce2513784fbb9e874947591c1f1ec8e2254d30cafb13d1a400d3932311b",
+            "multidrive_frozen.rs": "bee7e25f1340e1278eee9d34395a4fd3bc201bac3a63dc47879c27a5aaa176e4",
+            "motor_operating_point.rs": "04e5582f808aba2acf3dca97816280edbfa515c39d4de911e18db6fb43b7387a",
+            "dedicated_fatigue.rs": "6436f26a87b9e5cda890742f3cece4212c58c9a25d3dd9c8a268d5fddd27b3fc",
+        },
+        "canonical_original_newborn_genes_preserved": true,
+        "source_asset_digest": source_asset.digest(),
+        "source_phenotype_hash": source_phenotype.phenotype_hash(),
+        "source_address_map_digest": source_phenotype.persistent_address_map().digest(),
+        "target_address_map_digest": phenotype.persistent_address_map().digest(),
+        "zero_control_asset_digest": transfer.asset.digest(),
+        "asset_digest": asset.digest(),
+        "phenotype_hash": phenotype.phenotype_hash(),
+        "retained_rows": transfer.source_to_target.len(),
+        "source_to_target_map_digest": map_digest.finish256(),
+        "added_rows": added_rows.len(), "changed_rows": changed,
+        "coordinates": coordinates,
+        "differential_reference_edits": differential,
+        "full_reference_calibration": references,
+        "dedicated_b": dedicated_b, "tonic": tonic,
+        "world_steps": 0, "neural_steps": 0, "training_steps": 0,
+        "learned_state_imported": false, "retained_weights_changed": false,
+        "chemistry_fixture_applied": false,
+    });
+    Ok(R0Recipe {
+        config,
+        genotype,
+        phenotype,
+        inputs,
+        asset,
+        added_rows,
+        metadata,
+    })
+}
+
+/// Resolve and check the entire logical address, never a shifted packed index.
+fn observed_object_row(
+    p: &BrainPhenotype,
+    family: CandidateActionFamily,
+    motor: u32,
+) -> Result<(usize, PersistentSynapseAddress)> {
+    let motor_start = p.candidate_decoder().motor_start();
+    let ordinal = motor.checked_sub(motor_start).ok_or("invalid motor")?;
+    if motor_start != 1728 || ordinal / 16 != u32::from(family.raw()) {
+        return Err("R0 motor family or layout changed".into());
+    }
+    let neuron = PersistentNeuronAddress {
+        lobe: LobeKind::ActionPlanning,
+        ordinal,
+    };
+    let address = PersistentSynapseAddress {
+        projection: PersistentProjectionAddress {
+            source_lobe: LobeKind::ActionPlanning,
+            target_lobe: LobeKind::ActionPlanning,
+            role: PersistentProjectionRole::ActionAndSpeechDecoder,
+            logical_ordinal: 0,
+        },
+        source: neuron,
+        target: neuron,
+        decoder: Some(PersistentDecoderAddress {
+            head: DecoderHeadKind::ActionCandidate,
+            logical_group: family.raw(),
+            input_lane: 36,
+            output_index: u16::try_from(ordinal)?,
+        }),
+        duplicate_ordinal: 0,
+    };
+    let rows = p
+        .persistent_address_map()
+        .synapses()
+        .iter()
+        .filter(|entry| entry.address() == address)
+        .collect::<Vec<_>>();
+    if rows.len() != 1 {
+        return Err("R0 requires exactly one complete observed-object address".into());
+    }
+    let row = rows[0].packed_index() as usize;
+    let s = &p.synapses()[row];
+    if s.source() != motor
+        || s.target() != motor
+        || !matches!(s.kind(), CompiledSynapseKind::Decoder(c)
+            if c.head() == DecoderHeadKind::ActionCandidate
+                && c.family() == family && c.input_lane() == 36
+                && u32::from(c.motor_index()) == ordinal)
+        || !p
+            .persistent_address_map()
+            .projections()
+            .iter()
+            .any(|entry| {
+                entry.address() == address.projection && entry.packed_index() == s.route_index()
+            })
+    {
+        return Err("R0 full address disagrees with family/lane/motor coordinate".into());
+    }
+    Ok((row, address))
+}
+
+/// Enabled branch of archived physiology_host::tonic_factor. There is no
+/// coefficient edit: the five -4 bridges and the +8 root are required intact.
+fn validate_tonic_on(p: &BrainPhenotype, weights: &[f32]) -> Result<Value> {
+    if weights.len() != p.synapses().len() {
+        return Err("tonic source length mismatch".into());
+    }
+    let mut rows = Vec::new();
+    for (index, target) in [
+        (7841, 896),
+        (7842, 897),
+        (7844, 899),
+        (7845, 900),
+        (7847, 902),
+    ] {
+        let s = p.synapses().get(index).ok_or("tonic bridge missing")?;
+        if (s.kind(), s.route_index(), s.source(), s.target())
+            != (CompiledSynapseKind::Recurrent, 3, 1967, target)
+            || weights[index].to_bits() != (-4_f32).to_bits()
+        {
+            return Err("tonic-on bridge coordinate or prior mismatch".into());
+        }
+        rows.push(json!({"index":index,"source":1967,"target":target,"before":-4.,"after":-4.}));
+    }
+    let root = p.synapses().get(7679).ok_or("tonic root missing")?;
+    if (
+        root.kind(),
+        root.route_index(),
+        root.source(),
+        root.target(),
+    ) != (CompiledSynapseKind::Recurrent, 2, 383, 1967)
+        || weights[7679].to_bits() != 8_f32.to_bits()
+    {
+        return Err("tonic-on root coordinate or prior mismatch".into());
+    }
+    Ok(json!({
+        "enabled": true, "root_edge_unchanged": 7679, "root_weight": 8.,
+        "bridge_rows": rows, "source383_is_not_a_constant": true,
+    }))
+}
