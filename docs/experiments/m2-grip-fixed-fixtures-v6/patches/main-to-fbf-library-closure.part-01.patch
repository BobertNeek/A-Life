+//! Read-only R0 diagnostics from four actual, separately prepared first decisions.
+//!
+//! Each capture costs three eight-tick CPU replays. Only recurrent neural state
+//! evolves inside each discarded replay; ordinary context, acquired offsets and
+//! dendrites stay frozen. No world, organism, trainer or optimizer is mutated.
+//! These are partial modulation counterfactuals, not physiology experiments.
+
+use alife_core::{
+    BrainPhenotype, CandidateActionFamily, CompiledSynapseKind, DecoderHeadKind,
+    NeuralReceptorActivation, NeuralReceptorClass, NeuralReceptorEffects, NeuralReceptorFrame,
+    NeuralReceptorPhenotype, PreActionBrainEvidence, Tick, Validate,
+    BIOCHEMICAL_GRAPH_SCHEMA_VERSION,
+};
+use alife_training::cpu::{CpuCollectedDecision, CpuFoundationTrainer};
+use alife_training::{TrainingReplayCandidate, TrainingReplayTick, TrainingSequence};
+use serde_json::{json, Value};
+use std::collections::{BTreeMap, BTreeSet};
+
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const TICKS_PER_CONTEXT: usize = 8;
+const CONTEXTS_PER_CAPTURE: usize = 3;
+const MAX_CAPTURES: usize = 4;
+const APPROVED_DETACHED_TICK_CAP: usize = 192;
+
+/// Share one budget across both arms and both canonical scenes. Reserve a whole
+/// capture before execution, so a failed evaluation cannot silently buy retries.
+#[derive(Default)]
+pub struct DetachedBudget {
+    ticks_reserved: usize,
+    captures: BTreeSet<(String, String)>,
+}
+
+impl DetachedBudget {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    pub fn summary(&self) -> Value {
+        json!({
+            "captures_reserved": self.captures.len(),
+            "detached_ticks_reserved": self.ticks_reserved,
+            "planned_captures": MAX_CAPTURES,
+            "planned_detached_ticks": MAX_CAPTURES * CONTEXTS_PER_CAPTURE * TICKS_PER_CONTEXT,
+            "approved_detached_tick_cap": APPROVED_DETACHED_TICK_CAP,
+            "world_ticks": 0, "optimizer_steps": 0,
+        })
+    }
+
+    fn reserve(&mut self, scene: &str, arm: &str) -> Result<()> {
+        let key = (scene.to_owned(), arm.to_owned());
+        let next = self.ticks_reserved + CONTEXTS_PER_CAPTURE * TICKS_PER_CONTEXT;
+        if scene.is_empty()
+            || arm.is_empty()
+            || self.captures.contains(&key)
+            || self.captures.len() >= MAX_CAPTURES
+            || next > APPROVED_DETACHED_TICK_CAP
+        {
+            return Err("duplicate capture, missing label, or detached R0 budget exceeded".into());
+        }
+        self.captures.insert(key);
+        self.ticks_reserved = next;
+        Ok(())
+    }
+}
+
+#[derive(Default)]
+struct Summary {
+    count: usize,
+    sum: f64,
+    first: f64,
+    last: f64,
+    min: f64,
+    max: f64,
+    negative: usize,
+    zero: usize,
+    positive: usize,
+}
+
+impl Summary {
+    fn push(&mut self, value: f64) -> Result<()> {
+        if !value.is_finite() {
+            return Err("non-finite detached diagnostic".into());
+        }
+        if self.count == 0 {
+            self.first = value;
+            self.min = value;
+            self.max = value;
+        }
+        self.count += 1;
+        self.sum += value;
+        self.last = value;
+        self.min = self.min.min(value);
+        self.max = self.max.max(value);
+        self.negative += usize::from(value < 0.);
+        self.zero += usize::from(value == 0.);
+        self.positive += usize::from(value > 0.);
+        Ok(())
+    }
+
+    fn json(&self) -> Value {
+        json!({
+            "count": self.count, "mean": self.sum / self.count.max(1) as f64,
+            "first": self.first, "last": self.last, "min": self.min, "max": self.max,
+            "negative_ticks": self.negative, "zero_ticks": self.zero,
+            "positive_ticks": self.positive,
+            "sign_reversal_within_replay": self.negative > 0 && self.positive > 0,
+        })
+    }
+}
+
+type Metrics = BTreeMap<&'static str, Summary>;
+
+fn add(metrics: &mut Metrics, name: &'static str, value: f64) -> Result<()> {
+    metrics.entry(name).or_default().push(value)
+}
+
+fn metrics_json(metrics: &Metrics) -> Value {
+    Value::Object(
+        metrics
+            .iter()
+            .map(|(key, value)| ((*key).into(), value.json()))
+            .collect(),
+    )
+}
+
+/// The caller must pass each real first decision with its unchanged founder.
+/// Scene labels are provenance only, never drive values or evaluator inputs.
+pub fn evaluate_capture(
+    trainer: &CpuFoundationTrainer,
+    decision: &CpuCollectedDecision,
+    scene_label: &str,
+    arm_label: &str,
+    budget: &mut DetachedBudget,
+) -> Result<Value> {
+    let p = trainer.phenotype();
+    let pre = decision.patch.pre_action();
+    let frame = pre.perception();
+    if p.brain_class_id().0 != 5
+        || p.neuron_count() != 2048
+        || p.candidate_decoder().motor_start() != 1728
+        || p.foundation_abi_selection()
+            .n2048_grounded_drive_basis()
+            .is_none()
+        || pre.organism_id != decision.organism_id
+        || pre.development_state.age_ticks.raw() != 240
+        || !matches!(&pre.brain_evidence,
+            PreActionBrainEvidence::NeuralClosedLoopCpu { capacity_class_id, phenotype_hash, .. }
+            if *capacity_class_id == p.brain_class_id() && *phenotype_hash == p.phenotype_hash())
+        || frame.candidates().len() != decision.replay_tick.candidates.len()
+        || frame
+            .candidates()
+            .iter()
+            .zip(&decision.replay_tick.candidates)
+            .any(|(a, b)| a.family != b.family)
+        || trainer.weights().len() != p.synapses().len()
+        || trainer
+            .weights()
+            .iter()
+            .zip(p.synapses())
+            .any(|(weight, synapse)| weight.to_bits() != synapse.genetic_weight().to_bits())
+    {
+        return Err("detached R0 capture must be an actual age-240 class-5 CPU decision".into());
+    }
+    let added = p
+        .synapses()
+        .iter()
+        .map(|s| {
+            matches!(s.kind(),
+        CompiledSynapseKind::Decoder(c) if c.head() == DecoderHeadKind::ActionCandidate
+            && (36..46).contains(&c.input_lane()))
+        })
+        .collect::<Vec<_>>();
+    let added_count = added.iter().filter(|&&value| value).count();
+    let added_nonzero = added
+        .iter()
+        .zip(trainer.weights())
+        .filter(|(is_added, weight)| **is_added && **weight != 0.)
+        .count();
+    if added_count != 1280 || !matches!(added_nonzero, 0 | 4) {
+        return Err(
+            "detached R0 requires all 1,280 added rows and zero or four nonzero genes".into(),
+        );
+    }
+
+    let receptor_phenotype = NeuralReceptorPhenotype::compile(p)?;
+    let low = synthetic_effects(&receptor_phenotype, pre.tick, 0.)?;
+    let high = synthetic_effects(&receptor_phenotype, pre.tick, 1.)?;
+    // The ordinary replay's pair also passes the receptor-effects bounds. Other
+    // effects in this local validator object are never copied into replay.
+    let mut actual_validation = low;
+    actual_validation.projection_gain = decision.replay_tick.projection_gain;
+    actual_validation.local_threshold_shift = decision.replay_tick.local_threshold_shift;
+    actual_validation.validate_contract()?;
+    let settings = [
+        (
+            "actual_canonical_pair",
+            decision.replay_tick.projection_gain,
+            decision.replay_tick.local_threshold_shift,
+            None,
+        ),
+        (
+            "synthetic_zero_projection_threshold_signals",
+            low.projection_gain,
+            low.local_threshold_shift,
+            Some(0.0_f32),
+        ),
+        (
+            "synthetic_full_projection_threshold_signals",
+            high.projection_gain,
+            high.local_threshold_shift,
+            Some(1.0_f32),
+        ),
+    ];
+    budget.reserve(scene_label, arm_label)?;
+    let mut contexts = Vec::new();
+    let mut first_check = Value::Null;
+    for (context_index, (label, gain, threshold, synthetic_signal)) in
+        settings.into_iter().enumerate()
+    {
+        let mut tick = decision.replay_tick.clone();
+        tick.projection_gain = gain;
+        tick.local_threshold_shift = threshold;
+        let sequence = TrainingSequence {
+            phenotype_hash: p.phenotype_hash(),
+            initial: decision.initial.clone(),
+            ticks: vec![tick.clone(); TICKS_PER_CONTEXT],
+            burn_in_ticks: 0,
+            memory_candidate_gain: p
+                .candidate_decoder()
+                .memory_channel()
+                .map_or(0., |channel| channel.max_candidate_gain()),
+        };
+        sequence.validate_for(p)?;
+        let replay = trainer.evaluate_replay(&sequence)?;
+        if replay.final_activations.len() != TICKS_PER_CONTEXT
+            || replay.candidate_logits.len() != TICKS_PER_CONTEXT
+        {
+            return Err("detached replay returned an unexpected tick count".into());
+        }
+        if context_index == 0 {
+            let first = &replay.final_activations[0];
+            let exact = first.len() == decision.final_features.len()
+                && first
+                    .iter()
+                    .zip(&decision.final_features)
+                    .all(|(a, b)| a.is_finite() && b.is_finite() && a.to_bits() == b.to_bits());
+            let max_abs_error = first
+                .iter()
+                .zip(&decision.final_features)
+                .map(|(a, b)| (a - b).abs())
+                .fold(0_f32, f32::max);
+            first_check = json!({
+                "bit_exact": exact, "compared_neurons": first.len(),
+                "max_abs_error": max_abs_error,
+                "comparison": "actual replay tick 0 versus captured decision.final_features",
+                "extra_replay_ticks": 0,
+            });
+            if !exact {
+                return Err(
+                    "actual first detached replay is not bit-exact with captured neural output"
+                        .into(),
+                );
+            }
+        }
+        let mut motor_metrics = Metrics::new();
+        let mut candidates = (0..tick.candidates.len())
+            .map(|_| Metrics::new())
+            .collect::<Vec<_>>();
+        for t in 0..TICKS_PER_CONTEXT {
+            let activations = &replay.final_activations[t];
+            if activations.len() != p.neuron_count() as usize
+                || replay.candidate_logits[t].len() != tick.candidates.len()
+            {
+                return Err("detached replay output shape mismatch".into());
+            }
+            for (name, value) in [
+                ("gate_context_neuron383", activations[383]),
+                ("fatigue_signal_motor1779", activations[1779]),
+                ("fatigue_reference_motor1791", activations[1791]),
+                (
+                    "fatigue_signal_minus_reference",
+                    activations[1779] - activations[1791],
+                ),
+                ("curiosity_signal_motor1766", activations[1766]),
+                ("curiosity_reference_motor1775", activations[1775]),
+                (
+                    "curiosity_signal_minus_reference",
+                    activations[1766] - activations[1775],
+                ),
+            ] {
+                add(&mut motor_metrics, name, f64::from(value))?;
+            }
+            for (index, candidate) in tick.candidates.iter().enumerate() {
+                accumulate_candidate(
+                    &mut candidates[index],
+                    trainer,
+                    &tick,
+                    candidate,
+                    activations,
+                    replay.candidate_logits[t][index],
+                    &added,
+                    sequence.memory_candidate_gain,
+                )?;
+            }
+        }
+        let candidate_summaries = candidates
+            .iter()
+            .enumerate()
+            .map(|(index, metrics)| {
+                json!({
+                    "candidate_index": index, "family": tick.candidates[index].family,
+                    "observed_object_lane36": tick.candidates[index].decoder_inputs[36],
+                    "metrics": metrics_json(metrics),
+                })
+            })
+            .collect::<Vec<_>>();
+        contexts.push(json!({
+            "label": label, "projection_gain": gain, "local_threshold_shift": threshold,
+            "source": if context_index == 0 { "captured canonical replay tick" }
+                else { "synthetic receptor signals projected through compiled neural expression" },
+            "synthetic_signal": synthetic_signal,
+            "full_receptor_counterfactual": false,
+            "encoded_inputs_gate_offset_and_source383_unchanged": true,
+            "encoded_source383": tick.encoded_inputs[383],
+            "initial_state_reset_to_capture": true, "ticks": TICKS_PER_CONTEXT,
+            "decoder_reconstruction_bit_exact": true,
+            "motor_contrasts": metrics_json(&motor_metrics),
+            "candidates": candidate_summaries,
+        }));
+    }
+    Ok(json!({
+        "schema": "grounded_developmental_r0_detached_capture_v1",
+        "backend": "native-cpu", "scene": scene_label, "arm": arm_label,
+        "organism_id": decision.organism_id, "source_tick": pre.tick,
+        "source_age_ticks": pre.development_state.age_ticks,
+        "phenotype_hash": p.phenotype_hash(), "brain_class": p.brain_class_id(),
+        "source_frame_digest": frame.frame_digest(),
+        "source_homeostatic_drives": frame.homeostasis().drives,
+        "source_microstep_count": decision.replay_tick.microstep_count,
+        "added_rows": added_count, "added_genetically_nonzero_rows": added_nonzero,
+        "added_row_identity": "ActionCandidate decoder input lanes 36..45 across every family and motor",
+        "source_optimizer_step": trainer.optimizer_step(), "optimizer_steps": 0,
+        "world_ticks": 0, "detached_ticks": CONTEXTS_PER_CAPTURE * TICKS_PER_CONTEXT,
+        "actual_first_replay_check": first_check,
+        "compiled_projection_expression": receptor_phenotype.expression()[2],
+        "compiled_threshold_expression": receptor_phenotype.expression()[3],
+        "contexts": contexts,
+        "frozen_context": "captured encoded inputs, candidates, masks, microstep budget, acquired offsets, structural edges and dendrites",
+        "live_plasticity_disabled": false,
+        "detached_offset_or_plasticity_updates": false,
+        "live_state_mutated": false, "trainer_mutated": false,
+        "interpretation": "Scene contrasts are confounded, not isolated drive dose-responses. Synthetic pairs change only projection gain and local threshold. They do not regenerate canonical receptor effects, encoded gate context, source383, chemistry, perception or physiology. Later replay ticks are static-context neural diagnostics, not organism outcomes.",
+        "component_roundoff": "Component sums use separately accumulated float terms; genetic plus acquired-offset subtotals can differ from effective totals by floating-point rounding. Decoder reconstruction is checked in original accumulation order.",
+    }))
+}
+
+fn synthetic_effects(
+    p: &NeuralReceptorPhenotype,
+    tick: Tick,
+    signal: f32,
+) -> Result<NeuralReceptorEffects> {
+    let frame = NeuralReceptorFrame {
+        schema_version: BIOCHEMICAL_GRAPH_SCHEMA_VERSION,
+        source_chemistry_version: BIOCHEMICAL_GRAPH_SCHEMA_VERSION,
+        source_tick: tick,
+        activations: vec![
+            NeuralReceptorActivation {
+                class: NeuralReceptorClass::ProjectionGain,
+                signal,
+            },
+            NeuralReceptorActivation {
+                class: NeuralReceptorClass::LocalThreshold,
+                signal,
+            },
+        ],
+    };
+    let effects = NeuralReceptorEffects::from_frame(&frame, p)?;
+    effects.validate_contract()?;
+    Ok(effects)
+}
+
+#[allow(clippy::too_many_arguments)]
+fn accumulate_candidate(
+    metrics: &mut Metrics,
+    trainer: &CpuFoundationTrainer,
+    tick: &TrainingReplayTick,
+    candidate: &TrainingReplayCandidate,
+    activations: &[f32],
+    actual_logit: f32,
+    added: &[bool],
+    memory_gain: f32,
+) -> Result<()> {
+    let p: &BrainPhenotype = trainer.phenotype();
+    let family_bias = p
+        .candidate_decoder()
+        .families()
+        .iter()
+        .find(|family| family.family() == candidate.family)
+        .ok_or("missing captured candidate family")?
+        .bias();
+    let mut reconstructed = family_bias + candidate.innate_bias;
+    let mut memory = 0_f32;
+    let mut cognitive = 0_f32;
+    let mut neural = [0_f64; 6]; // added/retained, each effective/genetic/acquired
+    for (row, synapse) in p.synapses().iter().enumerate() {
+        let CompiledSynapseKind::Decoder(coordinate) = synapse.kind() else {
+            continue;
+        };
+        if coordinate.family() != candidate.family
+            || coordinate.head() == DecoderHeadKind::SpeechPayload
+        {
+            continue;
+        }
+        let input = candidate.decoder_inputs[coordinate.input_lane() as usize];
+        let genetic = trainer.weights()[row];
+        let offset = tick.effective_weight_offsets[row];
+        let value = input * (genetic + offset);
+        match coordinate.head() {
+            DecoderHeadKind::ActionCandidate => {
+                let activation = activations[synapse.source() as usize];
+                let term = activation * value;
+                reconstructed += term;
+                let group = if added[row] { 0 } else { 3 };
+                neural[group] += f64::from(term);
+                neural[group + 1] += f64::from(activation * (input * genetic));
+                neural[group + 2] += f64::from(activation * (input * offset));
+            }
+            DecoderHeadKind::MemoryContext => memory += value,
+            DecoderHeadKind::CognitiveContext => cognitive += value,
+            _ => {}
+        }
+    }
+    let memory_clamped = memory.clamp(-memory_gain, memory_gain);
+    let cognitive_clamped = cognitive.clamp(-memory_gain, memory_gain);
+    reconstructed += memory_clamped + cognitive_clamped;
+    if reconstructed.to_bits() != actual_logit.to_bits() {
+        return Err("detached candidate decomposition disagrees with canonical CPU decoder".into());
+    }
+    for (name, value) in [
+        ("total_logit", f64::from(actual_logit)),
+        ("family_bias", f64::from(family_bias)),
+        ("innate_bias", f64::from(candidate.innate_bias)),
+        ("total_neural_contribution", neural[0] + neural[3]),
+        ("added_rows_neural_contribution", neural[0]),
+        ("added_rows_genetic_neural_contribution", neural[1]),
+        ("added_rows_acquired_neural_contribution", neural[2]),
+        ("retained_rows_neural_contribution", neural[3]),
+        ("retained_rows_genetic_neural_contribution", neural[4]),
+        ("retained_rows_acquired_neural_contribution", neural[5]),
+        ("memory_context_contribution", f64::from(memory_clamped)),
+        (
+            "cognitive_context_contribution",
+            f64::from(cognitive_clamped),
+        ),
+    ] {
+        add(metrics, name, value)?;
+    }
+    // These prospective signed terms retain the declared coefficients even if
+    // the signal-reference contrast reverses; they are not corrective edits.
+    let pair = match candidate.family {
+        CandidateActionFamily::Approach => Some((-0.4_f32, 1779, 1791)),
+        CandidateActionFamily::Inspect => Some((0.5_f32, 1766, 1775)),
+        _ => None,
+    };
+    if let Some((coefficient, signal, reference)) = pair {
+        add(
+            metrics,
+            "prospective_authored_lane36_pair_contribution",
+            f64::from(
+                coefficient
+                    * candidate.decoder_inputs[36]
+                    * (activations[signal] - activations[reference]),
+            ),
+        )?;
+    }
+    Ok(())
+}
