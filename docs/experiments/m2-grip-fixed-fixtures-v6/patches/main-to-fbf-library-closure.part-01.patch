+    /// M1-only resolver. The caller must first authenticate its bounded replay
+    /// envelope and the original write receipt. No legacy fast-tier substitution
+    /// or inferred membership of an interior merged sequence is permitted.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn memory_id_for_sleep_sequence_scoped_v1(
+        &self,
+        sequence_id: ExperienceSequenceId,
+        organism_id: OrganismId,
+        profile: crate::SensorProfileIdentity,
+        action_kind: ActionKind,
+        action_id: ActionId,
+        family: CandidateActionFamily,
+        originating_tick: Tick,
+    ) -> Result<Option<MemoryId>, ScaffoldContractError> {
+        sequence_id.validate()?;
+        organism_id.validate()?;
+        profile.validate_contract()?;
+        action_id.validate()?;
+        if profile.profile_id.raw() != 5
+            || !family.is_compatible_with(action_kind)
+            || self.len != 0
+            || !self.lifetime_records.is_empty()
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        let operation =
+            crate::memory_query::memory_operation_id(profile, family, action_kind, action_id)?;
+        let matches_scope = |record: &CandidateMemoryRecordV2| {
+            record.organism_id_raw == organism_id.raw()
+                && record.profile() == profile
+                && record.family_raw == u16::from(family.raw())
+                && record.action_kind_raw == action_kind.raw()
+                && record.action_id_raw == action_id.raw()
+                && record.operation_id() == Ok(operation)
+        };
+        let exact = self.candidate_store.records.values().find(|record| {
+            record.source_sequence_id == sequence_id && record.organism_id_raw == organism_id.raw()
+        });
+        if let Some(record) = exact {
+            record.validate_contract()?;
+            if family != CandidateActionFamily::Rest
+                && record.observation_count > 1
+                && record.profile() == profile
+                && record.family_raw == u16::from(family.raw())
+                && record.operation_id() == Ok(operation)
+                && record.last_tick == originating_tick
+                && (record.action_kind_raw != action_kind.raw()
+                    || record.action_id_raw != action_id.raw())
+            {
+                return Ok(None);
+            }
+            if !matches_scope(record) || record.last_tick != originating_tick {
+                return Err(ScaffoldContractError::InvalidDecisionEvidence);
+            }
+            return Ok(Some(record.memory_id));
+        }
+        let mut first = self.candidate_store.records.values().filter(|record| {
+            matches_scope(record)
+                && record.first_tick == originating_tick
+                && record.source_sequence_id.raw() > sequence_id.raw()
+        });
+        let Some(record) = first.next() else {
+            return Ok(None);
+        };
+        record.validate_contract()?;
+        if first.next().is_some() {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(Some(record.memory_id))
+    }
