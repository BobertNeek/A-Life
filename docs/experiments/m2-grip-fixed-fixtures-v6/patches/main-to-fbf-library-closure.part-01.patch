+            let drives = home.drives.to_array();
+            for assignment in e.source().sensor_encoder().assignments() {
+                let value = if assignment.source_group() == SensorEncoderSourceGroup::Homeostasis {
+                    drives
+                        .get(assignment.source_index() as usize)
+                        .copied()
+                        .unwrap_or(0.)
+                } else {
+                    0.
+                };
+                let (lo, hi) = assignment.clamp_range();
+                encoded[assignment.target_neuron() as usize] +=
+                    (value * assignment.scale() + assignment.bias()).clamp(lo, hi);
+            }
+            for value in &mut encoded {
+                *value = value.clamp(-1., 1.);
+            }
+            let tick = TrainingReplayTick {
+                encoded_inputs: encoded,
+                projection_gain: 0.5,
+                local_threshold_shift: 0.25,
+                microstep_count: u32::from(e.source().microstep_count()),
+                enabled_routes: vec![true; e.source().projections().len()],
+                effective_weight_offsets: vec![0.; e.source().synapses().len()],
+                structural_synapses: vec![],
+                candidates,
+            };
+            let rows = e.bind_rows(&f, &tick)?;
+            let start = Instant::now();
+            let r = e.step(
+                &f,
+                tick,
+                &rows,
+                MediationModulationV1::default(),
+                127,
+                [true; 6],
+                u64::MAX,
+            )?;
+            let native_ns = start.elapsed().as_nanos();
+            let scores = &r.receipt.scores;
+            let d = scores.probabilities(1.)?;
+            let action = scores.sample(0x4752_5031, 0, 1.)?;
+            let evaluation = scores.evaluate(&action)?;
+            cases.push(json!({"mode":mode,"fatigue":fatigue,"pressure":pressure,"input_scope":"qualified genetic B1 source; native homeostatic encoding with other sensory groups zero, fixed neutral seven-row repertoire; no world ticks","source_microsteps_per_decision":e.source().microstep_count(),"native_step_wall_nanoseconds":native_ns,"receipt":r.receipt,"probabilities":d,"sample":action,"evaluation":evaluation}));
+        }
+    }
+    println!(
+        "{}",
+        serde_json::to_string_pretty(
+            &json!({"schema":"recovery-group-native-fixtures-v1","diagnostic_pressure_sweep":pressure_sweep,"recipe_sha256":RECOVERY_GROUP_RECIPE_SHA256,"qualified_source_metadata":src.metadata,"source_asset_digest":src.asset.digest(),"source_inputs_digest":src.inputs.canonical_digest(),"source_neurons":src.phenotype.neuron_count(),"source_weight_rows":src.phenotype.synapses().len(),"cases":cases,"world_ticks":0,"learning_updates":0,"host_admitted":false,"gpu_run":false})
+        )?
+    );
+    Ok(())
+}
diff --git a/crates/alife_training/examples/probe_recovery_sleep_combined.rs b/crates/alife_training/examples/probe_recovery_sleep_combined.rs
new file mode 100644
index 0000000000000000000000000000000000000000..265c570ca3566544816246c78fe8806ee4a00cff
--- /dev/null
+++ b/crates/alife_training/examples/probe_recovery_sleep_combined.rs
@@ -0,0 +1,437 @@
+//! Explicit local-only source audit, disposable qualification, and one-shot pilot.
+#[path = "support/recovery_sleep_recipe_v1.rs"]
+mod recipe;
+use alife_core::*;
+use alife_training::cpu::*;
+use alife_training::TrainingReplayCandidate;
+use alife_world::*;
+use recipe::Result;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    fs::{self, OpenOptions},
+    io::Write,
+    path::Path,
+};
+const SEED: u64 = 0x0353_4C50_0000_0001;
+const FIXTURE_SEED: u64 = 0x0343_4D31_4658_0001;
+const HORIZON: u64 = 1200;
+fn hash(bytes: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(bytes))
+}
+fn data(bytes: &[u8]) -> Result<Value> {
+    // Inspection of our already validated typed envelope, never an import path.
+    let start = bytes
+        .iter()
+        .position(|x| *x == b'{')
+        .ok_or("missing payload")?;
+    Ok(serde_json::from_slice(&bytes[start..])?)
+}
+fn bytes(h: &CpuSleepChoiceHostV1) -> Result<Vec<u8>> {
+    Ok(h.checkpoint()?.encode()?)
+}
+fn write(path: &Path, value: &Value) -> Result<()> {
+    fs::write(path, serde_json::to_vec_pretty(value)?)?;
+    Ok(())
+}
+fn plan() -> Value {
+    json!({"schema":"recovery_sleep_pilot_v1","seed":SEED,"arms":["old/full","old/pressure-sham","new/full","new/pressure-sham"],
+    "source":"B1+bounded-reader+four-head+awake-rest-v1","reader":"authored bounded M1 reader, same rows/weights in every arm, not learned",
+    "body_preparation":240,"continuous_host_intervals":HORIZON,"maximum_fresh_lives":4,"maximum_total_world_intervals":4*(240+HORIZON),
+    "scene":"neutral flat one-organism scene; no food/toy/synthetic rewards or social peers","temperature":1.,"normal_age_death":true,
+    "pressure_value":0.,"timers_old":[0.00007,0.00007],"timers_new":[0.0012,0.0006],"thresholds_unchanged":[0.35,0.6],
+    "health_stop":"before each tick: dead or health < .5 or energy < .05","failure_rule":"record any partial commit and stop arm; no retry, replacement or extension",
+    "observations":"every committed interval: actual decisions/pressure/fatigue/physical relief/sleep phases/work; full local checkpoint every 240 intervals and final",
+    "preregistered_restore_check":"qualification only; no duplicated sampled run","inference":"single matched pilot, mechanism/choice/burden observations, not benefit or learning proof",
+    "repertoire_prior":"shared two Rest candidates; no -ln(2) correction; not an M0 causal comparison","optimizer_updates":0})
+}
+fn normalized(mut v: Value) -> Result<Value> {
+    v["mode"] = Value::Null;
+    for c in v["controllers"]
+        .as_object_mut()
+        .ok_or("controllers missing")?
+        .values_mut()
+    {
+        c["motor"]["mode"] = Value::Null;
+    }
+    for r in v["canonical"]["world"]["world"]["organism_records"]
+        .as_array_mut()
+        .ok_or("records missing")?
+    {
+        r["state_graph"]["brain"]["content_digest"] = Value::Null;
+    }
+    Ok(v)
+}
+fn snapshot(h: &CpuSleepChoiceHostV1) -> Result<Value> {
+    let r = h
+        .world()
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("resident missing")?;
+    Ok(
+        json!({"tick":h.world().tick(),"body":r.biochemistry().body,"homeostasis":r.biochemistry().homeostasis,
+        "age":r.biochemistry().development.age_ticks,"sleep_state":h.sleep_state(r.organism_id()),"phase":r.sleep_phase(),"cycle":r.sleep_cycle_id(),"alive":r.lifecycle().is_alive(),
+        "work":r.cognitive_work(),"energy_debit":r.cognitive_energy_debit()}),
+    )
+}
+fn legal_frame(h: &CpuSleepChoiceHostV1) -> Result<Value> {
+    let r = h
+        .world()
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("resident missing")?;
+    let mut w = h.world().clone();
+    let cap = SleepChoiceWorldAdmissionV1::for_organism(&w, r.organism_id())?;
+    let (draft, _) = w.perception_sleep_choice_draft_with_bindings(
+        &cap,
+        w.tick(),
+        r.biochemistry().homeostasis,
+    )?;
+    let frame = draft.finalize(PerceptionContextBlock::empty())?;
+    let ids = frame
+        .candidates()
+        .iter()
+        .filter(|c| c.family == CandidateActionFamily::Rest)
+        .map(|c| c.action_id.raw())
+        .collect::<std::collections::BTreeSet<_>>();
+    if ids != [3, 700].into_iter().collect() {
+        return Err("both recovery operations must be enumerated".into());
+    }
+    // Disposable typed-row test, not a fabricated observation or memory record.
+    for (i, c) in frame.candidates().iter().enumerate() {
+        let mut inputs = std::array::from_fn(|j| j as f32 / 64.);
+        inputs[53] = -0.;
+        let p = TrainingReplayCandidate {
+            family: c.family,
+            decoder_inputs: inputs,
+            innate_bias: 0.25,
+        };
+        let row = SleepChoiceReplayRowV1::bind(&frame, i, &p)?;
+        let restored: SleepChoiceReplayRowV1 = serde_json::from_slice(&serde_json::to_vec(&row)?)?;
+        restored.validate(&frame, i, &p)?;
+        for (a, b) in restored.decoder_inputs()[..54].iter().zip(inputs) {
+            assert_eq!(a.to_bits(), b.to_bits());
+        }
+        assert_eq!(
+            restored.decoder_inputs()[54],
+            RecoveryOperationV1::for_candidate(c)?.map_or(0., RecoveryOperationV1::decoder_sign)
+        );
+    }
+    Ok(
+        json!({"frame_digest":frame.frame_digest(),"recovery_ids":ids,"candidates":frame.candidates()}),
+    )
+}
+fn decision(d: &CpuSleepChoiceHostDecisionV1) -> Value {
+    json!({"action":d.action,"motor":d.motor,"physical":d.physical,"phase":d.sleep_phase,"trigger":d.sleep_trigger,"patch":d.patch})
+}
+fn check_masks(d: &CpuSleepChoiceHostDecisionV1) -> Result<()> {
+    let f = d.patch.pre_action().perception();
+    let mask = f
+        .candidates()
+        .iter()
+        .enumerate()
+        .filter(|(_, c)| c.family == CandidateActionFamily::Rest)
+        .fold(0_u32, |m, (i, _)| m | (1 << i));
+    if mask.count_ones() != 2 || d.action.motor_masks[4] & mask != mask {
+        return Err("Rest operation is not legal in actual B1 Posture mask".into());
+    }
+    Ok(())
+}
+fn qualify(dir: &Path, intervals: u64) -> Result<()> {
+    fs::create_dir(dir)?;
+    let mut reports = Vec::new();
+    let old = recipe::build(FIXTURE_SEED, false)?;
+    let new = recipe::build(FIXTURE_SEED, true)?;
+    compare_recipes(&old, &new)?;
+    for timer in [false, true] {
+        let r = recipe::build(FIXTURE_SEED, timer)?;
+        write(&dir.join(format!("source-{timer}.json")), &r.metadata)?;
+        let mut paired = None;
+        for mode in [
+            SleepChoiceMotorModeV1::Full,
+            SleepChoiceMotorModeV1::PressureSham,
+        ] {
+            let mut h = recipe::host(&r, mode, 1200, true)?;
+            let initial = bytes(&h)?;
+            let initial_data = data(&initial)?;
+            let norm = normalized(initial_data.clone())?;
+            if let Some(ref expected) = paired {
+                assert_eq!(expected, &norm);
+            } else {
+                paired = Some(norm);
+            }
+            let legal = legal_frame(&h)?;
+            let mut cold = CpuSleepChoiceHostV1::restore(
+                CpuSleepChoiceHostCheckpointV1::decode(&initial)?,
+                &r.inputs,
+                mode,
+            )?;
+            assert_eq!(initial, bytes(&cold)?);
+            let mut rows = Vec::new();
+            for offset in 0..intervals {
+                let step = h.step(1.)?;
+                let other = cold.step(1.)?;
+                let a = step.decisions.iter().map(decision).collect::<Vec<_>>();
+                let b = other.decisions.iter().map(decision).collect::<Vec<_>>();
+                assert_eq!(a, b);
+                for d in &step.decisions {
+                    check_masks(d)?;
+                }
+                let wire = bytes(&h)?;
+                assert_eq!(wire, bytes(&cold)?);
+                assert_eq!(initial_data["founder"], data(&wire)?["founder"]);
+                // Every boundary, including any naturally reached non-Awake phase.
+                cold = CpuSleepChoiceHostV1::restore(
+                    CpuSleepChoiceHostCheckpointV1::decode(&wire)?,
+                    &r.inputs,
+                    mode,
+                )?;
+                rows.push(json!({"offset":offset,"state_sha256":hash(&wire),"snapshot":snapshot(&h)?,"decisions":a,"consolidations":step.sleep_consolidations}));
+            }
+            reports.push(json!({"timer":timer,"mode":mode,"initial_sha256":hash(&initial),"legal":legal,"rows":rows,"warm_cold_byte_exact":true,"optimizer_sentinel_exact":true}));
+            eprintln!("QUALIFIED timer={timer} mode={mode:?} fixed_intervals={intervals}");
+        }
+    }
+    write(
+        &dir.join("qualification.json"),
+        &json!({"fixture_seed":FIXTURE_SEED,"reports":reports}),
+    )?;
+    Ok(())
+}
+fn compare_recipes(old: &recipe::Recipe, new: &recipe::Recipe) -> Result<()> {
+    assert_eq!(old.inputs, new.inputs);
+    assert_eq!(old.asset, new.asset);
+    assert_eq!(old.phenotype, new.phenotype);
+    assert_eq!(old.metadata["reader_rows"], new.metadata["reader_rows"]);
+    let mut expected = old.genotype.clone();
+    expected.chemistry.graph = expected
+        .chemistry
+        .graph
+        .with_recovery_timescale_v1(AlleleSide::Maternal)?
+        .with_recovery_timescale_v1(AlleleSide::Paternal)?;
+    assert_eq!(
+        expected, new.genotype,
+        "only the two gains on both homologs may differ"
+    );
+    Ok(())
+}
+fn prepare(dir: &Path) -> Result<()> {
+    fs::create_dir(dir)?;
+    write(&dir.join("PLAN.json"), &plan())?;
+    let old = recipe::build(SEED, false)?;
+    let new = recipe::build(SEED, true)?;
+    compare_recipes(&old, &new)?;
+    let mut prepared = Vec::new();
+    for (timer, r) in [(false, &old), (true, &new)] {
+        let mut matched = None;
+        for mode in [
+            SleepChoiceMotorModeV1::Full,
+            SleepChoiceMotorModeV1::PressureSham,
+        ] {
+            let arm = prepared.len();
+            let arm_dir = dir.join(format!("arm-{arm}"));
+            fs::create_dir(&arm_dir)?;
+            let h = recipe::host(r, mode, 240, false)?;
+            let initial = bytes(&h)?;
+            fs::write(arm_dir.join("initial.private.m1"), &initial)?;
+            let normalized = normalized(data(&initial)?)?;
+            if let Some(ref expected) = matched {
+                assert_eq!(expected, &normalized);
+            } else {
+                matched = Some(normalized.clone());
+            }
+            write(&arm_dir.join("SOURCE.json"), &r.metadata)?;
+            let receipt = json!({"arm":arm,"timer":timer,"mode":mode,"sha256":hash(&initial),
+                "normalized_sha256":hash(&serde_json::to_vec(&normalized)?),"state":snapshot(&h)?,"legal":legal_frame(&h)?});
+            write(&arm_dir.join("INITIAL.json"), &receipt)?;
+            prepared.push(receipt);
+        }
+    }
+    // This file exists only after all four exact fresh states pass preflight.
+    write(
+        &dir.join("PREPARATION_COMPLETE.json"),
+        &json!({"arms":prepared,"paired_checkpoint_equality":true,"cross_timer_brain_reader_identity":true,"only_two_gain_changes":true,"neural_decisions":0}),
+    )?;
+    Ok(())
+}
+fn run(root: &Path, arm: usize) -> Result<()> {
+    if arm > 3 {
+        return Err("arm must be 0..3".into());
+    }
+    let preflight: Value =
+        serde_json::from_slice(&fs::read(root.join("PREPARATION_COMPLETE.json"))?)?;
+    if serde_json::from_slice::<Value>(&fs::read(root.join("PLAN.json"))?)? != plan() {
+        return Err("prepared plan differs from executable".into());
+    }
+    let dir = root.join(format!("arm-{arm}"));
+    let timer = arm >= 2;
+    let mode = if arm % 2 == 0 {
+        SleepChoiceMotorModeV1::Full
+    } else {
+        SleepChoiceMotorModeV1::PressureSham
+    };
+    // Exclusive attempt marker is written before loading/stepping; never retry an arm.
+    let mut marker = OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(dir.join("ATTEMPTED.json"))?;
+    writeln!(
+        marker,
+        "{}",
+        serde_json::to_string(&json!({"arm":arm,"timer":timer,"mode":mode,"retry_allowed":false}))?
+    )?;
+    marker.flush()?;
+    let r = recipe::build(SEED, timer)?;
+    if serde_json::from_slice::<Value>(&fs::read(dir.join("SOURCE.json"))?)? != r.metadata {
+        return Err("prepared source differs from executable".into());
+    }
+    let initial = fs::read(dir.join("initial.private.m1"))?;
+    if preflight["arms"][arm]["sha256"] != hash(&initial) {
+        return Err("prepared initial state hash mismatch".into());
+    }
+    let initial_data = data(&initial)?;
+    let mut h = CpuSleepChoiceHostV1::restore(
+        CpuSleepChoiceHostCheckpointV1::decode(&initial)?,
+        &r.inputs,
+        mode,
+    )?;
+    assert_eq!(initial, bytes(&h)?);
+    let mut out = OpenOptions::new()
+        .create_new(true)
+        .write(true)
+        .open(dir.join("TRACE.jsonl"))?;
+    let mut stop = "horizon".to_owned();
+    let mut decisions = 0;
+    let mut intervals = 0;
+    let mut awake = 0;
+    let mut sleep = 0;
+    let mut consolidations = 0;
+    let mut fatigue_sum = 0_f64;
+    let mut pressure_sum = 0_f64;
+    let mut min_energy = 1_f32;
+    let mut min_health = 1_f32;
+    for offset in 0..HORIZON {
+        let record = h
+            .world()
+            .organism_registry()
+            .iter()
+            .next()
+            .ok_or("missing resident")?;
+        if !record.lifecycle().is_alive()
+            || record.biochemistry().body.health < 0.5
+            || record.biochemistry().body.energy < 0.05
+        {
+            stop = "health/energy/death".into();
+            break;
+        }
+        let before = snapshot(&h)?;
+        let tick_before = h.world().tick();
+        let step = match h.step(1.) {
+            Ok(s) => s,
+            Err(e) => {
+                stop = format!("step error: {e}");
+                let row = json!({"status":"error","offset":offset,"tick_before":tick_before,"tick_after":h.world().tick(),"error":e.to_string(),"snapshot":snapshot(&h)?,"rollback_full_bytes":"not asserted by this pilot; fixed qualification covers transactional behavior"});
+                writeln!(out, "{}", serde_json::to_string(&row)?)?;
+                out.flush()?;
+                break;
+            }
+        };
+        // Commit provenance reaches disk before reporting/auditing can fail.
+        let commit = json!({"status":"committed","offset":offset,"tick_before":step.tick_before,"tick_after":step.tick_after,"decisions":step.decisions.iter().map(decision).collect::<Vec<_>>(),"consolidations":step.sleep_consolidations});
+        writeln!(out, "{}", serde_json::to_string(&commit)?)?;
+        out.flush()?;
+        intervals += step.tick_after.raw() - step.tick_before.raw();
+        decisions += step.decisions.len();
+        consolidations += step.sleep_consolidations;
+        let audit_result = (|| -> Result<()> {
+            for d in &step.decisions {
+                check_masks(d)?;
+                match d.physical.operation {
+                    Some(RecoveryOperationV1::AwakeRest) => awake += 1,
+                    Some(RecoveryOperationV1::BodySleep) => sleep += 1,
+                    None => {}
+                }
+            }
+            let r = h
+                .world()
+                .organism_registry()
+                .iter()
+                .next()
+                .ok_or("missing resident")?;
+            fatigue_sum += f64::from(r.biochemistry().homeostasis.drives.fatigue);
+            pressure_sum += f64::from(r.biochemistry().homeostasis.hormones.sleep_pressure);
+            min_energy = min_energy.min(r.biochemistry().body.energy);
+            min_health = min_health.min(r.biochemistry().body.health);
+            writeln!(
+                out,
+                "{}",
+                serde_json::to_string(
+                    &json!({"status":"observed","offset":offset,"before":before,"after":snapshot(&h)?})
+                )?
+            )?;
+            out.flush()?;
+            if (offset + 1) % 240 == 0 {
+                let cp = bytes(&h)?;
+                fs::write(dir.join(format!("boundary-{}.private.m1", offset + 1)), &cp)?;
+                if initial_data["founder"] != data(&cp)?["founder"] {
+                    return Err("founder changed at boundary".into());
+                }
+                eprintln!(
+                    "PILOT arm={arm} interval={} decisions={decisions} sleep={sleep} rest={awake}",
+                    offset + 1
+                );
+            }
+            Ok(())
+        })();
+        if let Err(error) = audit_result {
+            stop = format!("post-commit audit failure: {error}");
+            // A failed trace sink must not prevent the final checkpoint attempt.
+            let log_error = (|| -> Result<()> {
+                writeln!(
+                    out,
+                    "{}",
+                    serde_json::to_string(
+                        &json!({"status":"audit_error","offset":offset,"error":error.to_string()})
+                    )?
+                )?;
+                out.flush()?;
+                Ok(())
+            })();
+            if let Err(log_error) = log_error {
+                eprintln!("audit log failed: {log_error}; attempting final checkpoint");
+            }
+            break;
+        }
+    }
+    let final_wire = bytes(&h)?;
+    fs::write(dir.join("final.private.m1"), &final_wire)?;
+    let optimizer_unchanged = initial_data["founder"] == data(&final_wire)?["founder"];
+    if !optimizer_unchanged {
+        stop = "founder preservation failure".into();
+    }
+    write(
+        &dir.join("RESULT.json"),
+        &json!({"arm":arm,"timer":timer,"mode":mode,"stop":stop,"committed_intervals":intervals,"decisions":decisions,"awake_rest_choices":awake,"body_sleep_choices":sleep,"consolidations":consolidations,"fatigue_sum":fatigue_sum,"pressure_sum":pressure_sum,"min_energy":min_energy,"min_health":min_health,"final_state":snapshot(&h)?,"final_sha256":hash(&final_wire),"optimizer_unchanged":optimizer_unchanged}),
+    )?;
+    Ok(())
+}
+fn main() -> Result<()> {
+    let a = std::env::args().skip(1).collect::<Vec<_>>();
+    match a.as_slice() {
+        [] => println!("{}", serde_json::to_string_pretty(&plan())?),
+        [cmd] if cmd == "--plan" => println!("{}", serde_json::to_string_pretty(&plan())?),
+        [cmd, path] if cmd == "--qualify" => qualify(Path::new(path),16)?,
+        [cmd, path] if cmd == "--qualify-profile" => qualify(Path::new(path),2)?,
+        [cmd, path] if cmd == "--prepare-pilot" => prepare(Path::new(path))?,
+        [cmd, path, arm] if cmd == "--run-prepared" => run(Path::new(path), arm.parse()?)?,
+        _ => {
+            return Err(
+                "use --plan | --qualify NEW_DIR | --qualify-profile NEW_DIR | --prepare-pilot NEW_DIR | --run-prepared DIR ARM"
+                    .into(),
+            )
+        }
+    }
+    Ok(())
+}
diff --git a/crates/alife_training/examples/qualify_motor_host_fixture.rs b/crates/alife_training/examples/qualify_motor_host_fixture.rs
