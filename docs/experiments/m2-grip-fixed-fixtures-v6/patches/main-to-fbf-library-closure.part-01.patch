+fn replay_evidence(
+    pairs: &[(SleepReplayEvent, PredictionTargetReceipt)],
+) -> crate::sleep::SleepReplayEvidence {
+    let capacity = pairs.len().max(1) as u32;
+    let mut journal = SleepReplayJournal::new(
+        ReplayCapturePlan::try_new(vec![3], 1, capacity, capacity).unwrap(),
+    )
