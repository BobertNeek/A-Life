@@ -0,0 +1,202 @@
+//! Explicit fresh-founder genetics for the sealed grounded-drive research ABI.
+//!
+//! No serialized fields or ordinary genetics admission rules change here. The
+//! existing candidate slot carries the exact genetic asset; neither an acquired
+//! organism nor a neural/optimizer checkpoint is an input to these constructors.
+
+use crate::{
+    BrainCapacityClass, BrainGenome, CreatureGenome, CreaturePhenotype, DevelopmentState,
+    FoundationCompatibilityFamilyId, FoundationGeneticIdentity, FoundationId, FoundationVersion,
+    FoundationWeightAsset, GenomeId, N2048GroundedDriveBasisV1, NormalizedScalar,
+    PhenotypeCompiler, PhenotypeCompilerInputs, ScaffoldContractError, Tick, Validate,
+};
+
+impl CreatureGenome {
+    /// Bind a transferred class-5 genetic asset to a NEW parentless genotype.
+    /// Every causal construction gene must match the complete class-3 expression,
+    /// including its mixed genetic prior, rather than an unexpressed scaffold.
+    pub fn from_n2048_grounded_drive_transfer(
+        source: &Self,
+        target_inputs: &PhenotypeCompilerInputs,
+        asset: FoundationWeightAsset,
+    ) -> Result<Self, ScaffoldContractError> {
+        source.validate_contract()?;
+        if !source.parent_genome_ids.is_empty()
+            || source.foundation.brain_class_id != BrainCapacityClass::N2048_ID
+            || source.brain.brain_class.maternal.value != BrainCapacityClass::N2048_ID
+            || source.brain.brain_class.paternal.value != BrainCapacityClass::N2048_ID
+            || source.nano512_readout_candidate.is_some()
+            || source.nano512_action_credit_candidate_v2.is_some()
+        {
+            return Err(ScaffoldContractError::IncompatibleGeneticClass);
+        }
+        let source_asset = source
+            .n2048_foundation_candidate
+            .as_ref()
+            .ok_or(ScaffoldContractError::PhenotypeCompile)?;
+        // The bounded factory checks the source recipe, branch policy, profile,
+        // addresses, and asset ABI. An experimental graph with the older branch
+        // policy is not an admissible source just because its class is also 3.
+        let source_expression = source.express()?;
+        PhenotypeCompiler::compile_n2048_bounded_founder_candidate(
+            source_expression.brain_genome.clone(),
+            fresh_construction_development(source.id)?,
+            source_asset.clone(),
+        )?;
+        if asset.manifest().sensor_profile() != source_asset.manifest().sensor_profile() {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        let target_brain = transfer_genetic_identity(source_expression.brain_genome)?;
+        if target_brain.id == source.id || target_inputs.genome() != &target_brain {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        let mut target = source.clone();
+        target.id = target_brain.id;
+        target.foundation = research_identity(&asset)?;
+        target.brain.brain_class.maternal.value = target.foundation.brain_class_id;
+        target.brain.brain_class.paternal.value = target.foundation.brain_class_id;
+        target.n2048_foundation_candidate = Some(asset);
+        target.validate_n2048_grounded_drive_inputs(target_inputs)?;
+        Ok(target)
+    }
+
+    /// Validate a deserialized research genotype without caches or external
+    /// authority. This deliberately does not make `Validate` accept class 5.
+    /// Full admission recompiles the sealed graph and checks its exact asset ABI.
+    pub fn validate_n2048_grounded_drive_research(&self) -> Result<(), ScaffoldContractError> {
+        self.express_n2048_grounded_drive_research().map(|_| ())
+    }
+
+    /// Reconstruct the complete retained biology and class-3 genetic seed set,
+    /// changing only the fresh target identity and capacity. Ordinary `express`
+    /// continues rejecting this class, including after serialization round trips.
+    pub fn express_n2048_grounded_drive_research(
+        &self,
+    ) -> Result<CreaturePhenotype, ScaffoldContractError> {
+        let expression = self.grounded_drive_expression_uncompiled()?;
+        self.compile_grounded_drive_expression(&expression)?;
+        Ok(expression)
+    }
+
+    /// Match all genetic compiler inputs, not just selected seeds or a phenotype
+    /// hash. Construction is mature at age zero with empty dynamic gates and no
+    /// lifetime counters; authoritative body development remains separate.
+    pub fn validate_n2048_grounded_drive_inputs(
+        &self,
+        inputs: &PhenotypeCompilerInputs,
+    ) -> Result<(), ScaffoldContractError> {
+        inputs.validate_against(&BrainCapacityClass::n2048_grounded_drive_research())?;
+        let expression = self.grounded_drive_expression_uncompiled()?;
+        if inputs.genome() != &expression.brain_genome
+            || inputs.development() != &fresh_construction_development(self.id)?
+        {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        let expected_inputs = self.compile_grounded_drive_expression(&expression)?;
+        if inputs != &expected_inputs {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        Ok(())
+    }
+
+    fn grounded_drive_expression_uncompiled(
+        &self,
+    ) -> Result<CreaturePhenotype, ScaffoldContractError> {
+        let asset = self
+            .n2048_foundation_candidate
+            .as_ref()
+            .ok_or(ScaffoldContractError::PhenotypeCompile)?;
+        if self.foundation != research_identity(asset)?
+            || self.brain.brain_class.maternal.value
+                != BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID
+            || self.brain.brain_class.paternal.value
+                != BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID
+            || !self.parent_genome_ids.is_empty()
+            || self.nano512_readout_candidate.is_some()
+            || self.nano512_action_credit_candidate_v2.is_some()
+        {
+            return Err(ScaffoldContractError::IncompatibleGeneticClass);
+        }
+
+        // This local, non-persisted projection reuses ordinary validated biology
+        // expression. It is NOT a reverse asset or acquired-state migration.
+        // Foundation identity does not affect ordinary chromosome expression.
+        let mut retained = self.clone();
+        retained.foundation = FoundationGeneticIdentity::new(
+            FoundationId::N2048_EXPERIMENTAL_GRAPH_V1.raw(),
+            FoundationVersion::V1.raw() as u16,
+            FoundationCompatibilityFamilyId::N2048_EXPERIMENTAL_GRAPH.raw(),
+            BrainCapacityClass::N2048_ID,
+        )?;
+        retained.n2048_foundation_candidate = None;
+        retained.brain.brain_class.maternal.value = BrainCapacityClass::N2048_ID;
+        retained.brain.brain_class.paternal.value = BrainCapacityClass::N2048_ID;
+        let mut expression = retained.express()?;
+        expression.brain_genome = transfer_genetic_identity(expression.brain_genome)?;
+        if self.id != expression.brain_genome.id {
+            return Err(ScaffoldContractError::InvalidId);
+        }
+        expression.source_genome_id = self.id;
+        expression.foundation = self.foundation;
+        Ok(expression)
+    }
+
+    fn compile_grounded_drive_expression(
+        &self,
+        expression: &CreaturePhenotype,
+    ) -> Result<PhenotypeCompilerInputs, ScaffoldContractError> {
+        let asset = self
+            .n2048_foundation_candidate
+            .as_ref()
+            .ok_or(ScaffoldContractError::PhenotypeCompile)?;
+        let (phenotype, inputs) = PhenotypeCompiler::compile_n2048_grounded_drive_basis_candidate(
+            expression.brain_genome.clone(),
+            fresh_construction_development(self.id)?,
+            asset.clone(),
+        )?;
+        asset.validate_against(&phenotype)?;
+        Ok(inputs)
+    }
+}
+
+fn research_identity(
+    asset: &FoundationWeightAsset,
+) -> Result<FoundationGeneticIdentity, ScaffoldContractError> {
+    // Canonical validation checks the exact class, version, family, row count,
+    // content digest and permitted sensor profiles. The factory additionally
+    // binds the current recipe and activity/branch policy to the asset ABI.
+    N2048GroundedDriveBasisV1::for_asset(asset)?;
+    let manifest = asset.manifest();
+    if manifest.promotion_receipt().is_promoted() {
+        return Err(ScaffoldContractError::PhenotypeCompile);
+    }
+    Ok(FoundationGeneticIdentity {
+        foundation_id: manifest.foundation_id().raw(),
+        version: u16::try_from(manifest.foundation_version().raw())
+            .map_err(|_| ScaffoldContractError::PhenotypeCompile)?,
+        compatibility_family_id: manifest.compatibility_family_id().raw(),
+        brain_class_id: manifest.capacity_class_id(),
+    })
+}
+
+fn transfer_genetic_identity(
+    mut genome: BrainGenome,
+) -> Result<BrainGenome, ScaffoldContractError> {
+    let identity = BrainGenome::scaffold(
+        genome.species_seed,
+        BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID,
+    );
+    genome.brain_class_id = identity.brain_class_id;
+    genome.id = identity.id;
+    genome.seeds.genome_id_seed = identity.seeds.genome_id_seed;
+    // Preserve every other seed, the fully mixed prior, the fixed N2048 layout,
+    // density behavior, and all causal genes, including developmental schedules.
+    genome.validate_contract()?;
+    Ok(genome)
+}
+
+fn fresh_construction_development(id: GenomeId) -> Result<DevelopmentState, ScaffoldContractError> {
+    let development = DevelopmentState::new(id, Tick::ZERO, NormalizedScalar::new(1.0)?);
+    development.validate_contract()?;
+    Ok(development)
+}
