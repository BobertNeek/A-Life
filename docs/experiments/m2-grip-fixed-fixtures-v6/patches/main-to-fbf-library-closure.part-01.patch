+#[test]
+fn sleep_choice_sleep_mapping_checks_every_merged_source_scope() {
+    for op in [3, 700] {
+        let mut b = bank(8);
+        for seq in 1..=3 {
+            write(&mut b, seq, op, 0.7);
+        }
+        let resolve = |seq, kind, action, family, tick| {
+            b.memory_id_for_sleep_sequence_scoped_v1(
+                ExperienceSequenceId(seq),
+                OWNER,
+                identity(),
+                kind,
+                ActionId(action),
+                family,
+                Tick::new(tick),
+            )
+        };
+        let first = resolve(1, ActionKind::Rest, op, CandidateActionFamily::Rest, 2).unwrap();
+        assert!(first.is_some());
+        assert_eq!(
+            resolve(3, ActionKind::Rest, op, CandidateActionFamily::Rest, 6).unwrap(),
+            first
+        );
+        assert_eq!(
+            resolve(2, ActionKind::Rest, op, CandidateActionFamily::Rest, 4).unwrap(),
+            None
+        );
+        let other = if op == 3 { 700 } else { 3 };
+        assert!(resolve(3, ActionKind::Rest, other, CandidateActionFamily::Rest, 6).is_err());
+        assert_eq!(
+            resolve(1, ActionKind::Rest, other, CandidateActionFamily::Rest, 2).unwrap(),
