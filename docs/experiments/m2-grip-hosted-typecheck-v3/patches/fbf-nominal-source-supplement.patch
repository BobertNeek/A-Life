+#[test]
+fn m1_descriptor_checks_lineage_before_decoding_opaque_source() {
+    let (_, inputs) = source();
+    let recipe = SleepChoiceM1V1::fresh(&inputs).unwrap();
+    let config = bincode::config::standard();
+    let bytes = bincode::serde::encode_to_vec(&recipe, config).unwrap();
+    let (restored, used): (SleepChoiceM1V1, usize) =
+        bincode::serde::decode_from_slice(&bytes, config).unwrap();
+    assert_eq!(restored, recipe);
+    assert_eq!(used, bytes.len());
+    let mut wire = serde_json::to_value(&recipe).unwrap();
+    assert!(wire["source_inputs_json"].is_string());
+    assert!(wire.get("source_inputs").is_none());
+    wire["source_inputs_json"] = serde_json::json!("not valid source JSON or positional selectors");
+    assert!(serde_json::from_value::<SleepChoiceM1V1>(wire.clone()).is_err());
+    wire["source_lineage"] = serde_json::json!("ambiguous-held-positional-lineage");
+    let error = serde_json::from_value::<SleepChoiceM1V1>(wire)
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("unknown M1 descriptor lineage or contract"));
+    #[derive(serde::Serialize)]
+    struct Wire<'a> {
+        schema_version: u16,
+        selector_tag: u16,
+        runtime_profile_raw: u16,
+        composite_class_raw: u16,
+        foundation_id_raw: u64,
+        compatibility_family_raw: u64,
+        source_lineage: &'a str,
+        recipe_digest: [u64; 4],
+        source_inputs_json: &'a str,
+    }
+    let invalid = Wire {
+        schema_version: 1,
+        selector_tag: 12,
+        runtime_profile_raw: 5,
+        composite_class_raw: 7,
+        foundation_id_raw: SleepChoiceM1V1::FOUNDATION_ID.raw(),
+        compatibility_family_raw: SleepChoiceM1V1::COMPATIBILITY_FAMILY.raw(),
+        source_lineage: "unknown",
+        recipe_digest: SleepChoiceM1V1::recipe_digest(),
+        source_inputs_json: "[6,7,8]",
+    };
+    let bytes = bincode::serde::encode_to_vec(invalid, config).unwrap();
+    let error = bincode::serde::decode_from_slice::<SleepChoiceM1V1, _>(&bytes, config)
+        .unwrap_err()
+        .to_string();
+    assert!(error.contains("unknown M1 descriptor lineage or contract"));
+}
