@@ -0,0 +1,413 @@
+use alife_core::*;
+use std::collections::BTreeMap;
+
+fn construction(id: GenomeId) -> DevelopmentState {
+    DevelopmentState::new(id, Tick::ZERO, NormalizedScalar::new(1.0).unwrap())
+}
+
+fn source(seed: u64) -> CreatureGenome {
+    let mut source = CreatureGenome::early_mammal_founder(
+        seed,
+        FoundationGeneticIdentity::new(
+            FoundationId::N2048_EXPERIMENTAL_GRAPH_V1.raw(),
+            1,
+            FoundationCompatibilityFamilyId::N2048_EXPERIMENTAL_GRAPH.raw(),
+            BrainCapacityClass::N2048_ID,
+        )
+        .unwrap(),
+    )
+    .unwrap();
+    // Exercise expressed biology, not just the default scaffold. The weight
+    // variation must be mixed into the retained class-3 genetic prior exactly.
+    source.body.sensory_acuity = ContinuousLocus::mean(0.61, 0.72).unwrap();
+    source.brain.genetic_weight_variation = ContinuousLocus::mean(0.71, 0.83).unwrap();
+    source.brain.plasticity = ContinuousLocus::mean(0.62, 0.70).unwrap();
+    source.brain.connectivity_density = ContinuousLocus::mean(0.12, 0.24).unwrap();
+    source.brain.sensory_lobe_ratio = ContinuousLocus::mean(0.31, 0.35).unwrap();
+    source.chemistry.sleep_threshold = ContinuousLocus::mean(0.69, 0.75).unwrap();
+    source.development.maturation_rate = ContinuousLocus::mean(0.55, 0.65).unwrap();
+    let expressed = source.express().unwrap();
+    let (brain, _) = PhenotypeCompiler::compile_n2048_bounded_founder(
+        expressed.brain_genome,
+        construction(source.id),
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap();
+    let asset = FoundationWeightAsset::from_phenotype_for_genetic_birth(&brain).unwrap();
+    source.with_n2048_foundation_candidate(asset).unwrap()
+}
+
+fn transfer_inputs(source: &CreatureGenome) -> (PhenotypeCompilerInputs, FoundationWeightAsset) {
+    let expressed = source.express().unwrap();
+    let (old, _) = PhenotypeCompiler::compile_n2048_bounded_founder_candidate(
+        expressed.brain_genome.clone(),
+        construction(source.id),
+        source.n2048_foundation_candidate.clone().unwrap(),
+    )
+    .unwrap();
+    let identity = BrainGenome::scaffold(
+        source.conception_seed,
+        BrainCapacityClass::N2048_GROUNDED_DRIVE_RESEARCH_ID,
+    );
+    let mut genome = expressed.brain_genome;
+    genome.brain_class_id = identity.brain_class_id;
+    genome.id = identity.id;
+    genome.seeds.genome_id_seed = identity.seeds.genome_id_seed;
+    let development = construction(genome.id);
+    let (fresh, _) = PhenotypeCompiler::compile_n2048_grounded_drive_basis(
+        genome.clone(),
+        development.clone(),
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap();
+    let target_addresses: BTreeMap<_, _> = fresh
+        .persistent_address_map()
+        .synapses()
+        .iter()
+        .map(|entry| (entry.address(), entry.packed_index()))
+        .collect();
+    let mut weights = vec![0.0; fresh.synapses().len()];
+    for entry in old.persistent_address_map().synapses() {
+        weights[target_addresses[&entry.address()] as usize] =
+            old.synapses()[entry.packed_index() as usize].genetic_weight();
+    }
+    let asset = FoundationWeightAsset::from_trained_weights(
+        &fresh,
+        weights,
+        TrainingStageManifest::bootstrap(),
+    )
+    .unwrap();
+    let (_, inputs) = PhenotypeCompiler::compile_n2048_grounded_drive_basis_candidate(
+        genome,
+        development,
+        asset.clone(),
+    )
+    .unwrap();
+    (inputs, asset)
+}
+
+fn changed_inputs(
+    inputs: &PhenotypeCompilerInputs,
+    change: impl FnOnce(&mut BrainGenome, &mut DevelopmentState),
+) -> PhenotypeCompilerInputs {
+    let mut genome = inputs.genome().clone();
+    let mut development = inputs.development().clone();
+    change(&mut genome, &mut development);
+    PhenotypeCompilerInputs::try_new_with_foundation_selection(
+        genome,
+        &BrainCapacityClass::n2048_grounded_drive_research(),
+        development,
+        inputs.sensor_profile(),
+        inputs.foundation_abi().clone(),
+    )
+    .unwrap()
+}
+
+#[test]
+fn exact_full_expression_survives_fresh_research_conversion_and_json_restore() {
+    let source = source(0x2048_9801);
+    let source_bytes = serde_json::to_vec(&source).unwrap();
+    let old = source.express().unwrap();
+    let (inputs, asset) = transfer_inputs(&source);
+    let target =
+        CreatureGenome::from_n2048_grounded_drive_transfer(&source, &inputs, asset).unwrap();
+    let expression = target.express_n2048_grounded_drive_research().unwrap();
+    target
+        .validate_n2048_grounded_drive_inputs(&inputs)
+        .unwrap();
+    assert_eq!(expression.brain_genome, *inputs.genome());
+    assert_eq!(expression.body, old.body);
+    assert_eq!(expression.chemistry, old.chemistry);
+    assert_eq!(expression.development, old.development);
+    assert_eq!(expression.reproduction, old.reproduction);
+    assert_eq!(expression.predisposition, old.predisposition);
+    assert_eq!(expression.genetic_provenance, old.genetic_provenance);
+    assert_eq!(expression.lineage_id, old.lineage_id);
+    assert_eq!(expression.source_genome_id, target.id);
+    assert_eq!(expression.brain_genome.id, target.id);
+    assert_eq!(
+        expression
+            .development_state_at(Tick::ZERO)
+            .unwrap()
+            .genome_id,
+        target.id
+    );
+    assert_eq!(inputs.development().genome_id, target.id);
+    let mut expected_seeds = old.brain_genome.seeds.clone();
+    expected_seeds.genome_id_seed = inputs.genome().seeds.genome_id_seed;
+    assert_eq!(inputs.genome().seeds, expected_seeds);
+    assert_eq!(
+        inputs.genome().genetic_prior_seed,
+        old.brain_genome.genetic_prior_seed
+    );
+    assert_ne!(
+        inputs.genome().genetic_prior_seed,
+        BrainGenome::scaffold(source.conception_seed, BrainCapacityClass::N2048_ID)
+            .genetic_prior_seed
+    );
+    assert_eq!(inputs.genome().lobe_ratios, LobeRatioPlan::ClassDefault);
+    assert_eq!(
+        inputs.genome().sparse_density_priors,
+        old.brain_genome.sparse_density_priors
+    );
+    assert_eq!(
+        inputs.genome().developmental_schedule,
+        old.brain_genome.developmental_schedule
+    );
+    assert_eq!(source_bytes, serde_json::to_vec(&source).unwrap());
+    assert_ne!(target.id, source.id);
+    assert!(target.parent_genome_ids.is_empty());
+    assert!(!target.provenance.ordinary_birth);
+
+    let restored: CreatureGenome =
+        serde_json::from_slice(&serde_json::to_vec(&target).unwrap()).unwrap();
+    restored.validate_n2048_grounded_drive_research().unwrap();
+    assert_eq!(target, restored);
+    assert_eq!(
+        expression,
+        restored.express_n2048_grounded_drive_research().unwrap()
+    );
+    assert!(restored.validate_contract().is_err());
+    assert!(restored.express().is_err());
+    assert!(restored.brain.validate_contract().is_err());
+    assert!(restored.foundation.validate_contract().is_err());
+    assert!(restored.expressed_brain_class().is_err());
+    assert!(CreatureGenome::early_mammal_founder(3, restored.foundation).is_err());
+    assert!(CreatureGenome::reproduce(&restored, &restored, 3).is_err());
+    assert!(FoundationGeneticIdentity::new(
+        restored.foundation.foundation_id,
+        restored.foundation.version,
+        restored.foundation.compatibility_family_id,
+        restored.foundation.brain_class_id,
+    )
+    .is_err());
+}
+
+#[test]
+fn exact_inputs_reject_partial_gene_seed_identity_and_acquired_development_changes() {
+    let source = source(0x2048_9802);
+    let (inputs, asset) = transfer_inputs(&source);
+    let target =
+        CreatureGenome::from_n2048_grounded_drive_transfer(&source, &inputs, asset.clone())
+            .unwrap();
+    let changes: Vec<fn(&mut BrainGenome, &mut DevelopmentState)> = vec![
+        |g, _| g.seeds.mutation_seed ^= 1,
+        |g, _| g.seeds.crossover_seed ^= 1,
+        |g, _| g.seeds.development_seed ^= 1,
+        |g, _| g.seeds.sensor_layout_seed ^= 1,
+        |g, _| g.seeds.species_seed ^= 1,
+        |g, _| g.seeds.genome_id_seed ^= 1,
+        |g, _| {
+            g.seeds.genetic_prior_seed ^= 1;
+            g.genetic_prior_seed = g.seeds.genetic_prior_seed;
+        },
+        |g, _| g.innate_priority.food_attraction = 0.01,
+        |g, _| g.sensor_layout.channels[0].receptor_count += 1,
+        |g, _| {
+            let original = g.mutation_rates.point.raw();
+            let changed = if original <= 0.5 {
+                original + 0.25
+            } else {
+                original - 0.25
+            };
+            g.mutation_rates.point = NormalizedScalar::new(changed).unwrap();
+        },
+        |g, d| {
+            g.id = GenomeId(g.id.0 ^ 1);
+            d.genome_id = g.id;
+        },
+        |_, d| d.age_ticks = Tick(1),
+        |_, d| d.maturation = NormalizedScalar::new(0.5).unwrap(),
+        |_, d| d.sleep_cycle_count = 1,
+        |_, d| d.consolidation_cycle_count = 1,
+        |_, d| d.last_sleep_tick = Some(Tick::ZERO),
+        |_, d| d.enabled_lobes = vec![LobeKind::ActionPlanning],
+    ];
+    for (case_index, change) in changes.into_iter().enumerate() {
+        let altered = changed_inputs(&inputs, change);
+        assert_ne!(
+            altered, inputs,
+            "mutation case {case_index} must change inputs"
+        );
+        assert!(
+            target
+                .validate_n2048_grounded_drive_inputs(&altered)
+                .is_err(),
+            "validator accepted mutation case {case_index}",
+        );
+        assert!(
+            CreatureGenome::from_n2048_grounded_drive_transfer(&source, &altered, asset.clone(),)
+                .is_err(),
+            "converter accepted mutation case {case_index}",
+        );
+    }
+    let (_, unbound) = PhenotypeCompiler::compile_n2048_grounded_drive_basis(
+        inputs.genome().clone(),
+        inputs.development().clone(),
+        inputs.sensor_profile(),
+    )
+    .unwrap();
+    assert!(target
+        .validate_n2048_grounded_drive_inputs(&unbound)
+        .is_err());
+}
+
+#[test]
+fn research_rejects_missing_wrong_assets_mixed_alleles_parents_and_biology_tampering() {
+    let source = source(0x2048_9803);
+    let (inputs, asset) = transfer_inputs(&source);
+    let target =
+        CreatureGenome::from_n2048_grounded_drive_transfer(&source, &inputs, asset.clone())
+            .unwrap();
+    let changes: Vec<Box<dyn Fn(&mut CreatureGenome)>> = vec![
+        Box::new(|g| g.brain.brain_class.paternal.value = BrainCapacityClass::N2048_ID),
+        Box::new(|g| g.brain.brain_class.maternal.value = BrainCapacityClass::N2048_ID),
+        Box::new(|g| g.foundation.brain_class_id = BrainCapacityClass::N2048_ID),
+        Box::new(|g| g.foundation.foundation_id ^= 1),
+        Box::new(|g| g.foundation.version += 1),
+        Box::new(|g| g.foundation.compatibility_family_id ^= 1),
+        Box::new(|g| g.id = GenomeId(g.id.0 ^ 1)),
+        Box::new(|g| g.conception_seed ^= 1),
+        Box::new(|g| g.parent_genome_ids = vec![GenomeId(4), GenomeId(5)]),
+        Box::new(|g| g.provenance.ordinary_birth = true),
+        Box::new(|g| g.n2048_foundation_candidate = None),
+        Box::new(|g| g.brain.plasticity = ContinuousLocus::mean(0.1, 0.2).unwrap()),
+        Box::new(|g| g.body.size.maternal = f32::NAN),
+    ];
+    for change in changes {
+        let mut bad = target.clone();
+        change(&mut bad);
+        assert!(bad.validate_n2048_grounded_drive_research().is_err());
+        assert!(bad.express_n2048_grounded_drive_research().is_err());
+    }
+    let mut wrong_asset = target.clone();
+    wrong_asset.n2048_foundation_candidate = source.n2048_foundation_candidate.clone();
+    assert!(wrong_asset
+        .validate_n2048_grounded_drive_research()
+        .is_err());
+    let mut missing = source.clone();
+    missing.n2048_foundation_candidate = None;
+    assert!(
+        CreatureGenome::from_n2048_grounded_drive_transfer(&missing, &inputs, asset.clone())
+            .is_err()
+    );
+    let mut mixed = source.clone();
+    mixed.brain.brain_class.paternal.value = BrainCapacityClass::N512_ID;
+    mixed.validate_contract().unwrap(); // A recessive production allele is ordinary-valid.
+    assert!(
+        CreatureGenome::from_n2048_grounded_drive_transfer(&mixed, &inputs, asset.clone()).is_err()
+    );
+    let child = CreatureGenome::reproduce(&source, &source, 0x2048_9804).unwrap();
+    assert!(
+        CreatureGenome::from_n2048_grounded_drive_transfer(&child, &inputs, asset.clone()).is_err()
+    );
+    let mut changed_biology = target.clone();
+    changed_biology.body.sensory_acuity = ContinuousLocus::mean(0.1, 0.2).unwrap();
+    assert!(changed_biology
+        .validate_n2048_grounded_drive_inputs(&inputs)
+        .is_err());
+
+    let expressed = source.express().unwrap();
+    let (unbounded, _) = PhenotypeCompiler::compile_n2048_experimental_graph(
+        expressed.brain_genome,
+        construction(source.id),
+        inputs.sensor_profile(),
+    )
+    .unwrap();
+    let mut wrong_branch_policy = source.clone();
+    wrong_branch_policy.n2048_foundation_candidate =
+        Some(FoundationWeightAsset::from_phenotype_for_genetic_birth(&unbounded).unwrap());
+    wrong_branch_policy.validate_contract().unwrap();
+    assert!(CreatureGenome::from_n2048_grounded_drive_transfer(
+        &wrong_branch_policy,
+        &inputs,
+        asset
+    )
+    .is_err());
+}
+
+#[test]
+fn research_requires_exact_profile_asset_binding_and_no_simultaneous_nano_candidates() {
+    let source = source(0x2048_9807);
+    let (inputs, asset) = transfer_inputs(&source);
+    let target =
+        CreatureGenome::from_n2048_grounded_drive_transfer(&source, &inputs, asset.clone())
+            .unwrap();
+    let p = PhenotypeCompiler::compile_validated(
+        &inputs,
+        &BrainCapacityClass::n2048_grounded_drive_research(),
+    )
+    .unwrap();
+    let mut weights = asset.weights().to_vec();
+    weights[0] += 0.001;
+    let different_asset = FoundationWeightAsset::from_trained_weights(
+        &p,
+        weights,
+        TrainingStageManifest::bootstrap(),
+    )
+    .unwrap();
+    assert!(
+        CreatureGenome::from_n2048_grounded_drive_transfer(&source, &inputs, different_asset)
+            .is_err()
+    );
+
+    let (terrain, _) = PhenotypeCompiler::compile_n2048_grounded_drive_basis(
+        inputs.genome().clone(),
+        inputs.development().clone(),
+        SensorProfile::GroundedTerrainVisionV1,
+    )
+    .unwrap();
+    let terrain_asset = FoundationWeightAsset::from_phenotype_for_genetic_birth(&terrain).unwrap();
+    let (_, terrain_inputs) = PhenotypeCompiler::compile_n2048_grounded_drive_basis_candidate(
+        inputs.genome().clone(),
+        inputs.development().clone(),
+        terrain_asset.clone(),
+    )
+    .unwrap();
+    assert!(CreatureGenome::from_n2048_grounded_drive_transfer(
+        &source,
+        &terrain_inputs,
+        terrain_asset
+    )
+    .is_err());
+    assert!(target
+        .validate_n2048_grounded_drive_inputs(&terrain_inputs)
+        .is_err());
+
+    let builtin = FoundationWeightAsset::builtin_nano512_v1(inputs.sensor_profile()).unwrap();
+    let (legacy, _, _) = PhenotypeCompiler::compile_fixed_legacy_nano512_compatibility_asset(
+        inputs.sensor_profile(),
+        &builtin,
+    )
+    .unwrap()
+    .into_runtime_parts();
+    let nano_asset = FoundationWeightAsset::from_nano512_readout_candidate(
+        &legacy,
+        builtin.weights().to_vec(),
+        TrainingStageManifest::bootstrap(),
+    )
+    .unwrap();
+    let mut readout = target.clone();
+    readout.nano512_readout_candidate = Some(Nano512ReadoutCandidateV1::new(&nano_asset).unwrap());
+    assert!(readout.validate_n2048_grounded_drive_research().is_err());
+    let mut credit = target;
+    credit.nano512_action_credit_candidate_v2 = Some(
+        Nano512ActionCreditCandidateV2::new(
+            &nano_asset,
+            ActionCandidateCreditProfileV1::SignedConsequences,
+        )
+        .unwrap(),
+    );
+    assert!(credit.validate_n2048_grounded_drive_research().is_err());
+
+    // Invalid serialized payloads must fail either deserialization or explicit
+    // research validation. Never trust a cached phenotype from before tampering.
+    let valid =
+        CreatureGenome::from_n2048_grounded_drive_transfer(&source, &inputs, asset).unwrap();
+    let mut wire = serde_json::to_value(&valid).unwrap();
+    wire["n2048_foundation_candidate"]["manifest"]["route_abi_digest"] =
+        serde_json::to_value([0_u8; 32]).unwrap();
+    if let Ok(corrupt) = serde_json::from_value::<CreatureGenome>(wire) {
+        assert!(corrupt.validate_n2048_grounded_drive_research().is_err());
+    }
+}
