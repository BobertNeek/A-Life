+    let branches = recipe.fixed_branches().unwrap();
+    let old = MotorLobeM0V1::fresh(&inputs)
+        .unwrap()
+        .fixed_branches()
+        .unwrap();
+    for b in old.branches() {
+        assert!(branches.branches().contains(b));
+    }
+    assert_eq!(branches.branches().len(), 72);
+    assert_eq!(
+        branches
+            .branches()
+            .iter()
+            .map(|b| b.inputs.len())
+            .sum::<usize>(),
+        188
+    );
+    assert_eq!(
+        p.sensor_encoder().assignments().len() - source().0.sensor_encoder().assignments().len(),
+        24
+    );
+    for (target, a, b) in [(2142, 2140, 2141), (2143, 2141, 2140)] {
+        let branch = branches
+            .branches()
+            .iter()
+            .find(|x| x.target == target)
+            .unwrap();
+        assert_eq!(branch.threshold, 0.);
+        assert_eq!(branch.output_gain, 1.);
+        assert_eq!(
+            branch.inputs,
+            vec![
+                DendriticInputRef::new(a, 4.).unwrap(),
+                DendriticInputRef::new(b, -4.).unwrap()
+            ]
+        );
+    }
