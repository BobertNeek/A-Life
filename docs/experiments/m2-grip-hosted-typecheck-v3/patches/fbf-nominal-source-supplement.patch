+#[test]
+fn exact_compiler_prefix_addresses_and_costs() {
+    let (base, bi) = source();
+    let before = serde_json::to_vec(&base).unwrap();
+    let (p, i) = PhenotypeCompiler::compile_motor_lobe_m0(&bi).unwrap();
+    let cap = BrainCapacityClass::n2144_motor_lobe_research();
+    p.validate_against(&cap).unwrap();
+    p.sensor_encoder().validate_against(&p).unwrap();
+    p.candidate_decoder().validate_against(&p).unwrap();
+    assert_eq!(p.neuron_count(), 2144);
+    assert_eq!(p.synapses().len(), 34098);
+    assert_eq!(cap.execution().max_total_synapses(), 34162);
+    assert_eq!(&p.synapses()[..34048], base.synapses());
+    assert_eq!(
+        serde_json::to_vec(&p.synapses()[..34048]).unwrap(),
+        serde_json::to_vec(base.synapses()).unwrap()
+    );
+    assert_eq!(&p.neuron_dynamics()[..2048], base.neuron_dynamics());
+    assert_eq!(
+        &p.projections()[..base.projections().len()],
+        base.projections()
+    );
+    assert_eq!(p.candidate_decoder(), base.candidate_decoder());
+    assert_eq!(p.sensor_encoder().schema_version(), 2);
+    assert_eq!(
+        p.sensor_encoder().assignments().len(),
+        base.sensor_encoder().assignments().len() + 22
+    );
+    assert_eq!(
+        &p.sensor_encoder().assignments()[..base.sensor_encoder().assignments().len()],
+        base.sensor_encoder().assignments()
+    );
+    for entry in base.persistent_address_map().neurons() {
+        assert!(p.persistent_address_map().neurons().contains(entry));
+    }
+    let retained = p
+        .persistent_address_map()
+        .synapses()
+        .iter()
+        .filter(|x| x.packed_index() < 34048)
+        .cloned()
+        .collect::<Vec<_>>();
+    assert_eq!(retained, base.persistent_address_map().synapses());
+    assert_eq!(
+        before,
+        serde_json::to_vec(
+            &PhenotypeCompiler::compile_validated(
+                &bi,
+                &BrainCapacityClass::n2048_grounded_drive_research()
+            )
+            .unwrap()
+        )
+        .unwrap()
+    );
+    assert_eq!(p, PhenotypeCompiler::compile_validated(&i, &cap).unwrap());
+    let w = MotorLobeWorkV1::checked(3, 1, 50).unwrap();
+    assert_eq!(
+        (
+            w.neuron_updates,
+            w.encoder_assignments,
+            w.branches,
+            w.branch_inputs
+        ),
+        (288, 22, 210, 552)
+    );
+    assert_eq!(
+        w.cost_q24().unwrap(),
+        288 * 32 + 22 * 4 + 210 * 16 + 552 * 4 + 50 * 4
+    );
+    assert!(MotorLobeWorkV1::checked(u64::MAX, 1, 1).is_err());
+    let policy = BrainActivityPolicyV1::for_phenotype(&p);
+    assert_eq!(policy.policy_version, 3);
+    policy.validate_class(cap.id()).unwrap();
+    assert!(BrainActivityPolicyV1::grounded_drive_research_v1()
+        .validate_class(cap.id())
+        .is_err());
+    assert!(policy.validate_class(base.brain_class_id()).is_err());
+}
+#[test]
+fn archive_lowering_is_exact_and_all_new_parameters_are_sealed() {
+    let (_, bi) = source();
+    let (p, _) = PhenotypeCompiler::compile_motor_lobe_m0(&bi).unwrap();
+    let recipe = p.foundation_abi().motor_lobe_m0().unwrap();
+    let archive: serde_json::Value = serde_json::from_str(include_str!(
+        "../../../docs/experiments/motor-lobe-native-m0-v1/mediation-m0-manifest.json"
+    ))
+    .unwrap();
+    let branches = recipe.fixed_branches().unwrap();
+    let expected = archive["new_branches"].as_array().unwrap();
+    assert_eq!(branches.branches().len(), expected.len());
+    for (b, r) in branches.branches().iter().zip(expected) {
+        assert_eq!(b.target, r["target"].as_u64().unwrap() as u32);
+        assert_eq!(
+            b.threshold.to_bits(),
+            (r["threshold"].as_f64().unwrap() as f32).to_bits()
+        );
+        assert_eq!(
+            b.output_gain.to_bits(),
+            (r["output_gain"].as_f64().unwrap() as f32).to_bits()
+        );
+        let inputs = r["inputs"].as_array().unwrap();
+        assert_eq!(b.inputs.len(), inputs.len());
+        for (input, row) in b.inputs.iter().zip(inputs) {
+            assert_eq!(input.source, row[0].as_u64().unwrap() as u32);
+            assert_eq!(
+                input.weight.to_bits(),
+                (row[1].as_f64().unwrap() as f32).to_bits()
+            );
+        }
+    }
+    let mut canonical = archive["new_arbitration_readout_head"]
+        .as_array()
+        .unwrap()
+        .iter();
+    for s in &p.synapses()[34048..] {
+        let r = canonical.next().unwrap();
+        let CompiledSynapseKind::Decoder(c) = s.kind() else {
+            panic!()
+        };
+        assert_eq!(format!("{:?}", c.family()), r["family"].as_str().unwrap());
+        assert_eq!(s.source(), r["source"].as_u64().unwrap() as u32);
+        assert_eq!(c.input_lane(), r["lane"].as_u64().unwrap() as u16);
+        assert_eq!(
+            s.genetic_weight().to_bits(),
+            (r["weight"].as_f64().unwrap() as f32).to_bits()
+        );
+    }
+    assert!(canonical.next().is_none());
+    for index in [0, 2048, 2050, 2143] {
+        let mut j = serde_json::to_value(&p).unwrap();
+        j["neuron_dynamics"][index]["bias"] = serde_json::json!(0.1);
+        assert!(serde_json::from_value::<BrainPhenotype>(j).is_err());
+    }
+    for index in [0, 34048, 34097] {
+        let mut j = serde_json::to_value(&p).unwrap();
+        j["synapses"][index]["genetic_weight"] = serde_json::json!(0.123);
+        assert!(serde_json::from_value::<BrainPhenotype>(j).is_err());
+    }
+}
