+    assert!(
+        PhenotypeCompiler::compile(i.genome(), &cap, i.development(), i.sensor_profile()).is_err()
+    );
+    let q: BrainPhenotype = serde_json::from_slice(&serde_json::to_vec(&p).unwrap()).unwrap();
+    let qi: PhenotypeCompilerInputs =
