+#[test]
+fn research_preparation_starts_fresh_and_preserves_private_state_without_ticks() {
+    let (config, genome, trainer, host, _) = fixture();
+    let initial = host.grounded_drive_research_checkpoint(&trainer).unwrap();
+    let game = create_grounded_drive_research_new_game(&config, &genome).unwrap();
+    let (prepared, ()) = CpuCanonicalHost::new_prepared_grounded_drive_research_cohort(
+        game.clone(),
+        &trainer,
+        17,
+        |_| Ok::<_, ScaffoldContractError>(()),
+    )
+    .unwrap();
+    let prepared = prepared
+        .grounded_drive_research_checkpoint(&trainer)
+        .unwrap();
+    assert!(
+        serde_json::to_vec(&initial.checkpoint.residents).unwrap()
+            == serde_json::to_vec(&prepared.checkpoint.residents).unwrap(),
+        "zero-tick preparation changed private resident state"
+    );
+    let mut expected = serde_json::to_value(initial).unwrap();
+    // Preparation reseals unchanged cognitive ownership exactly once.
+    for field in ["brain/revision", "memory/revision", "transaction_revision"] {
+        let path = format!("/checkpoint/world/world/organism_records/0/state_graph/{field}");
+        let revision = expected.pointer_mut(&path).unwrap();
+        *revision = serde_json::json!(revision.as_u64().unwrap() + 1);
+    }
+    assert!(
+        expected == serde_json::to_value(prepared).unwrap(),
+        "zero-tick preparation changed more than the three seal revisions"
+    );
+    assert!(
+        CpuCanonicalHost::new_prepared_cohort(
+            game,
+            &trainer,
+            17,
+            |_| Ok::<_, ScaffoldContractError>(())
+        )
+        .is_err()
+    );
+}
