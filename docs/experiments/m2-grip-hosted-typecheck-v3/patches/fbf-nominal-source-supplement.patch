@@ -0,0 +1,172 @@
+//! Frozen field order and serde attributes from 58ffdfd4. The research API
+//! must not append optional fields to the old positional or nested wire types.
+//! Existing optional/adjacent-tag positional decode limitations are compared
+//! against the old reader, not silently claimed as supported restoration.
+use alife_core::*;
+use serde::{de::DeserializeOwned, Deserialize, Serialize};
+
+fn construction_is_default(value: &BrainConstructionChromosome) -> bool {
+    value == &BrainConstructionChromosome::default()
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct OldFoundationGeneticIdentity {
+    pub foundation_id: u64,
+    pub version: u16,
+    pub compatibility_family_id: u64,
+    pub brain_class_id: BrainClassId,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct OldBrainChromosome {
+    /// Optional in old saves; these are construction parameters, never lifetime state.
+    #[serde(default, skip_serializing_if = "construction_is_default")]
+    pub construction: BrainConstructionChromosome,
+    pub brain_class: DiscreteLocus<BrainClassId>,
+    pub sensory_lobe_ratio: ContinuousLocus,
+    pub association_lobe_ratio: ContinuousLocus,
+    pub working_memory_ratio: ContinuousLocus,
+    pub connectivity_density: ContinuousLocus,
+    pub plasticity: ContinuousLocus,
+    pub receptor_sensitivity: ContinuousLocus,
+    /// Procedural construction diversity; inactive for exact trained foundations.
+    #[serde(rename = "genetic_weight_bias", alias = "genetic_weight_variation")]
+    pub genetic_weight_variation: ContinuousLocus,
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct OldCreatureGenome {
+    pub schema_version: u16,
+    pub id: GenomeId,
+    pub parent_genome_ids: Vec<GenomeId>,
+    pub lineage_id: LineageId,
+    pub conception_seed: u64,
+    pub foundation: OldFoundationGeneticIdentity,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub nano512_readout_candidate: Option<crate::Nano512ReadoutCandidateV1>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub nano512_action_credit_candidate_v2: Option<crate::Nano512ActionCreditCandidateV2>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub n2048_foundation_candidate: Option<crate::FoundationWeightAsset>,
+    pub provenance: GeneticLineageProvenance,
+    pub body: BodyChromosome,
+    pub brain: OldBrainChromosome,
+    pub chemistry: ChemistryChromosome,
+    pub development: DevelopmentChromosome,
+    pub reproduction: ReproductionChromosome,
+    pub predisposition: PredispositionChromosome,
+}
+
+#[derive(Debug, PartialEq, Serialize, Deserialize)]
+struct Nested<G> {
+    prefix: u64,
+    genome: G,
+    suffix: Vec<u64>,
+}
+
+fn positional_reader_parity<Old, Current>(bytes: &[u8])
+where
+    Old: DeserializeOwned + Serialize,
+    Current: DeserializeOwned + Serialize,
+{
+    let config = bincode::config::standard();
+    let old = bincode::serde::decode_from_slice::<Old, _>(bytes, config);
+    let current = bincode::serde::decode_from_slice::<Current, _>(bytes, config);
+    match (old, current) {
+        (Ok((a, old_used)), Ok((b, current_used))) => {
+            assert_eq!(old_used, bytes.len());
+            assert_eq!(current_used, old_used);
+            assert_eq!(
+                serde_json::to_value(a).unwrap(),
+                serde_json::to_value(b).unwrap()
+            );
+        }
+        (Err(old), Err(current)) => {
+            // The historical skipped fields and tagged nested enums can already
+            // reject positional restoration. Preserve that result without
+            // presenting it as a new successful bincode save/load capability.
+            assert_eq!(format!("{old:?}"), format!("{current:?}"));
+        }
+        _ => panic!("research support changed an old positional reader boundary"),
+    }
+}
+
+fn compare_old_wire(genome: CreatureGenome) {
+    let old: OldCreatureGenome =
+        serde_json::from_value(serde_json::to_value(&genome).unwrap()).unwrap();
+    let old_json = serde_json::to_vec(&old).unwrap();
+    assert_eq!(old_json, serde_json::to_vec(&genome).unwrap());
+    let restored: CreatureGenome = serde_json::from_slice(&old_json).unwrap();
+    restored.validate_contract().unwrap();
+    assert_eq!(restored, genome);
+    assert_eq!(restored.express().unwrap(), genome.express().unwrap());
+    let config = bincode::config::standard();
+    let old_bytes = bincode::serde::encode_to_vec(&old, config).unwrap();
+    assert_eq!(
+        old_bytes,
+        bincode::serde::encode_to_vec(&genome, config).unwrap()
+    );
+    positional_reader_parity::<OldCreatureGenome, CreatureGenome>(&old_bytes);
+
+    let old_brain_bytes = bincode::serde::encode_to_vec(&old.brain, config).unwrap();
+    assert_eq!(
+        old_brain_bytes,
+        bincode::serde::encode_to_vec(&genome.brain, config).unwrap()
+    );
+    positional_reader_parity::<OldBrainChromosome, BrainChromosome>(&old_brain_bytes);
+    let old_identity_bytes = bincode::serde::encode_to_vec(&old.foundation, config).unwrap();
+    assert_eq!(
+        old_identity_bytes,
+        bincode::serde::encode_to_vec(&genome.foundation, config).unwrap()
+    );
+    positional_reader_parity::<OldFoundationGeneticIdentity, FoundationGeneticIdentity>(
+        &old_identity_bytes,
+    );
+
+    let old_nested = Nested {
+        prefix: 19,
+        genome: old,
+        suffix: vec![11, 23, 41],
+    };
+    let current_nested = Nested {
+        prefix: 19,
+        genome,
+        suffix: vec![11, 23, 41],
+    };
+    let old_json = serde_json::to_vec(&old_nested).unwrap();
+    assert_eq!(old_json, serde_json::to_vec(&current_nested).unwrap());
+    assert_eq!(
+        serde_json::from_slice::<Nested<CreatureGenome>>(&old_json).unwrap(),
+        current_nested,
+    );
+    let old_bytes = bincode::serde::encode_to_vec(&old_nested, config).unwrap();
+    assert_eq!(
+        old_bytes,
+        bincode::serde::encode_to_vec(&current_nested, config).unwrap()
+    );
+    positional_reader_parity::<Nested<OldCreatureGenome>, Nested<CreatureGenome>>(&old_bytes);
+}
+
+#[test]
+fn existing_named_positional_and_nested_genetics_keep_the_frozen_wire_shape() {
+    for class in [BrainCapacityClass::N512_ID, BrainCapacityClass::N2048_ID] {
+        let founder = CreatureGenome::early_mammal_founder(
+            0x2048_9805,
+            FoundationGeneticIdentity::new(10, 1, 7, class).unwrap(),
+        )
+        .unwrap();
+        compare_old_wire(founder.clone());
+        compare_old_wire(CreatureGenome::reproduce(&founder, &founder, 0x2048_9806).unwrap());
+        let mut nondefault = founder;
+        nondefault.brain.construction.maternal_learning = nondefault
+            .brain
+            .construction
+            .maternal_learning
+            .clone()
+            .with_action_candidate_credit_profile(
+                ActionCandidateCreditProfileV1::SignedConsequences,
+            )
+            .unwrap();
+        compare_old_wire(nondefault);
+    }
+}
