+#![cfg(feature = "cpu-backend")]
+use alife_training::cpu::CpuResidentCheckpoint;
+
+#[test]
+fn literal_pre_adapter_resident_json_roundtrips_byte_exactly() {
+    // Produced by unmodified 1cae49fa4 library code from a source-authored B1
+    // newborn. Zero neural decisions, no imported life or trained checkpoint.
+    let bytes = zstd::stream::decode_all(
+        &include_bytes!("fixtures/cpu-resident-pre-motor-v1.json.zst")[..],
+    )
+    .unwrap();
+    let resident: CpuResidentCheckpoint = serde_json::from_slice(&bytes).unwrap();
+    assert_eq!(resident.next_sequence, 1);
+    assert_eq!(resident.neural.dispatch_generation, 0);
+    assert!(resident.neural.last_decision_tick.is_none());
+    assert_eq!(serde_json::to_vec(&resident).unwrap(), bytes);
+}
