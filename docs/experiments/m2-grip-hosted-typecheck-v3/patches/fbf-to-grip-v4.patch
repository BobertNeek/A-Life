+        let speech = if motors[3].is_some() {
+            scores.source().speech()?
+        } else {
+            None
+        };
+        state.grip_options.as_mut().unwrap().last = Some(GripOptionsSelectionV1 {
+            scores,
+            action: action.clone(),
+        });
+        Ok((action, index, motors, speech))
+    }
+    fn stage(
+        r: &mut Resident,
+        p: &BrainPhenotype,
+        a: &Self::Action,
+        b: CpuDecisionBinding,
+    ) -> Result<(), CpuHostError> {
+        let state = r
+            .grouped
+            .as_ref()
+            .ok_or(CpuHostError::State("missing optional controller"))?;
