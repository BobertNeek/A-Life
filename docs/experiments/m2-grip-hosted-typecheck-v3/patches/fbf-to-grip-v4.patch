+            .as_ref()
+            .map_or(1., |f| f.probability(GripOptionsChoiceV1::Quiet));
+        let speech = channels[3].as_ref().map_or(0., |f| {
+            f.outcomes
+                .iter()
+                .zip(&f.probabilities)
+                .filter(|(o, _)| matches!(o, GripOptionsChoiceV1::Candidate(_)))
+                .map(|(_, p)| p)
+                .sum::<f64>()
