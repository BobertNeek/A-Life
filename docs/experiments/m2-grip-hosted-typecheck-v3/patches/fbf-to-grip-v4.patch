+        [cmd,root,out] if cmd=="--compare-prefix"=>compare_prefix(Path::new(root),Path::new(out)),
+        _=>Err("explicit commands only: --qualify-admission PRIOR_50_CALL_QUALIFICATION OUT | --qualify-reference ORIGINAL_QUALIFICATION OUT | --freeze QUALIFICATION RESERVATION OUT | --prepare ROOT FREEZE RESERVATION | --run ROOT ARM | --export ROOT ARM OUT | --compare-prefix ROOT OUT".into()),
