+//! Inherited, parametric coordination energy over the actual joint option.
+//! Never consults WorldObjectKind, food nutrition, ownership, or world positions.
+//! Sensor geometry is only a fallible prediction. World validation and failed
+//! experience remain authoritative, and every finite base option retains support.
+use super::*;
+
+pub const GRIP_COORDINATION_WEIGHTS_V1: [f64; 3] = [-4.0, 1.0, -1.0];
+pub const GRIP_COORDINATION_FEATURE_ID_V1: &str =
+    "observed-postmove-reach-excess,observed-progress,remote-target-conflict/v1";
+// Frozen morphology/actuator prior, not a claim of actual displacement. This is
+// the ordinary maximum 2 units/s divided by 20 ticks/s. Obstruction, terrain,
+// effector gain, carried objects and unseen motion can invalidate the estimate.
+const STEP: f64 = 0.1;
+const REACH: f64 = 1.25;
+const VISION_RADIUS: f64 = 8.0;
+
+#[derive(Debug, Clone, Serialize)]
+pub struct GripCoordinationPairFactorV1 {
+    pub outcomes: Vec<[GripOptionsChoiceV1; 2]>,
+    pub probabilities: Vec<f64>,
+    pub log_probabilities: Vec<f64>,
+    pub features: Vec<[f64; 3]>,
+}
+impl GripCoordinationPairFactorV1 {
+    pub(super) fn sample(&self, u: f64) -> usize {
+        let mut sum = 0.;
+        for (i, p) in self.probabilities.iter().enumerate() {
+            sum += p;
+            if u < sum {
+                return i;
+            }
+        }
+        self.probabilities.len() - 1
+    }
+}
+#[derive(Clone, Copy)]
+struct Geometry {
+    slot: u16,
+    distance: f64,
+    bearing: [f64; 2],
+    confidence: f64,
+}
+fn observation(
+    frame: &PerceptionFrame,
+    c: &ActionCandidate,
+) -> Result<Option<Geometry>, TrainingError> {
+    if frame.own_grip().is_some_and(|g| {
+        g.occupied
+            && frame.grounded_object_slots().iter().any(|s| {
+                Some(s.tracked_object_id) == g.recognized_held_target
+                    && c.observation == CandidateObservationRef::ObjectSlot(s.slot_index)
+            })
+    }) {
+        return Ok(None);
+    }
+    let CandidateObservationRef::ObjectSlot(index) = c.observation else {
+        return Ok(None);
+    };
+    let slot = frame
+        .grounded_object_slots()
+        .iter()
+        .find(|s| s.slot_index == index)
+        .ok_or_else(invalid)?;
+    if slot.candidate_features()? != c.features {
+        return Err(invalid());
+    }
+    let norm = f64::from(slot.bearing[0]).hypot(f64::from(slot.bearing[1]));
+    // An uncertain bearing is no permission to read the transport coordinates.
+    if norm < 0.5 {
+        return Ok(None);
+    }
+    let motion = slot
+        .relative_velocity
+        .iter()
+        .map(|x| f64::from(*x).powi(2))
+        .sum::<f64>()
+        .sqrt();
+    Ok(Some(Geometry {
+        slot: index,
+        distance: f64::from(slot.distance) * VISION_RADIUS,
+        bearing: [
+            f64::from(slot.bearing[0]) / norm,
+            f64::from(slot.bearing[1]) / norm,
+        ],
+        confidence: f64::from(slot.confidence.raw().min(c.sensor_confidence.raw())) / (1. + motion),
+    }))
+}
+fn geometry_features(
+    movement: Option<(Geometry, CandidateActionFamily)>,
+    manipulation: Option<Geometry>,
+) -> [f64; 3] {
+    let Some(m) = manipulation else {
+        return [0.; 3];
+    };
+    let mut displacement = [0.; 2];
+    let mut confidence = m.confidence;
+    let mut conflict = 0.;
+    if let Some((l, family)) = movement {
+        confidence = confidence.min(l.confidence);
+        let sign = match family {
+            CandidateActionFamily::Approach => 1.,
+            CandidateActionFamily::Avoid => -1.,
+            _ => 0.,
+        };
+        let length = if sign > 0. {
+            l.distance.min(STEP)
+        } else {
+            STEP
+        };
+        displacement = l.bearing.map(|x| x * sign * length);
+        // A separate target is not inherently incompatible. Penalize only the
+        // remote case, softly; near/held contact remains entirely available.
+        if m.distance > REACH && l.slot != m.slot {
+            conflict = (0.5
+                * (1. - sign * (l.bearing[0] * m.bearing[0] + l.bearing[1] * m.bearing[1])))
+                .clamp(0., 1.);
+        }
+    }
+    let after = (m.bearing[0] * m.distance - displacement[0])
+        .hypot(m.bearing[1] * m.distance - displacement[1]);
+    let excess = (after - REACH).max(0.);
+    [
+        confidence * excess / (REACH + excess),
+        confidence * ((m.distance - after) / STEP).clamp(-1., 1.),
+        confidence * conflict * (excess / STEP).clamp(0., 1.),
+    ]
+}
+fn logsumexp(xs: &[f64]) -> Result<f64, TrainingError> {
+    if xs.is_empty() || xs.iter().any(|x| !x.is_finite()) {
+        return Err(invalid());
+    }
+    let max = xs.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+    Ok(max + xs.iter().map(|x| (x - max).exp()).sum::<f64>().ln())
+}
