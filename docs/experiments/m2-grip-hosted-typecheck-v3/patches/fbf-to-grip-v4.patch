+//! Map-only deferred own-grip parsing. Legacy profiles discard this metadata.
+//! Sequence/bincode decoding never enters this adapter.
+use serde::de::{self, DeserializeSeed, EnumAccess, IntoDeserializer, MapAccess, SeqAccess, VariantAccess, Visitor};
+use serde::{Deserialize, Deserializer};
+use std::fmt;
+
+// Preserve arbitrary self-describing values until the enclosing profile is known.
+// Maps retain non-string keys and duplicates. Bytes and nonfinite floats are not
+// forced through JSON. Malformed grip data is harmless for a legacy profile.
+#[derive(Debug)]
+pub(super) enum DeferredValue {
+    Unit, Bool(bool), I64(i64), U64(u64), I128(i128), U128(u128), F64(f64),
+    String(String), Bytes(Vec<u8>), Seq(Vec<Self>), Map(Vec<(Self, Self)>), Invalid,
+}
+impl<'de> Deserialize<'de> for DeferredValue {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
+        struct Capture;
+        impl<'de> Visitor<'de> for Capture {
+            type Value = DeferredValue;
+            fn expecting(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result { f.write_str("deferred metadata") }
+            fn visit_unit<E: de::Error>(self) -> Result<Self::Value,E> { Ok(DeferredValue::Unit) }
+            fn visit_none<E: de::Error>(self) -> Result<Self::Value,E> { Ok(DeferredValue::Unit) }
+            fn visit_some<D: Deserializer<'de>>(self,d:D)->Result<Self::Value,D::Error>{DeferredValue::deserialize(d)}
+            fn visit_newtype_struct<D: Deserializer<'de>>(self,d:D)->Result<Self::Value,D::Error>{DeferredValue::deserialize(d)}
+            fn visit_bool<E:de::Error>(self,v:bool)->Result<Self::Value,E>{Ok(DeferredValue::Bool(v))}
+            fn visit_i64<E:de::Error>(self,v:i64)->Result<Self::Value,E>{Ok(DeferredValue::I64(v))}
+            fn visit_u64<E:de::Error>(self,v:u64)->Result<Self::Value,E>{Ok(DeferredValue::U64(v))}
+            fn visit_i128<E:de::Error>(self,v:i128)->Result<Self::Value,E>{Ok(DeferredValue::I128(v))}
+            fn visit_u128<E:de::Error>(self,v:u128)->Result<Self::Value,E>{Ok(DeferredValue::U128(v))}
+            fn visit_f64<E:de::Error>(self,v:f64)->Result<Self::Value,E>{Ok(DeferredValue::F64(v))}
+            fn visit_str<E:de::Error>(self,v:&str)->Result<Self::Value,E>{Ok(DeferredValue::String(v.into()))}
+            fn visit_string<E:de::Error>(self,v:String)->Result<Self::Value,E>{Ok(DeferredValue::String(v))}
+            fn visit_bytes<E:de::Error>(self,v:&[u8])->Result<Self::Value,E>{Ok(DeferredValue::Bytes(v.into()))}
+            fn visit_byte_buf<E:de::Error>(self,v:Vec<u8>)->Result<Self::Value,E>{Ok(DeferredValue::Bytes(v))}
+            fn visit_seq<A:SeqAccess<'de>>(self,mut a:A)->Result<Self::Value,A::Error>{
+                let mut v=Vec::new();while let Some(x)=a.next_element()?{v.push(x);}Ok(DeferredValue::Seq(v))
+            }
+            fn visit_map<A:MapAccess<'de>>(self,mut a:A)->Result<Self::Value,A::Error>{
+                let mut v=Vec::new();while let Some(x)=a.next_entry()?{v.push(x);}Ok(DeferredValue::Map(v))
+            }
+            fn visit_enum<A:EnumAccess<'de>>(self,a:A)->Result<Self::Value,A::Error>{
+                // Same consumption protocol as Serde IgnoredAny, without giving
+                // an unknown native enum an accidental own-grip interpretation.
+                a.variant::<de::IgnoredAny>()?.1.newtype_variant::<de::IgnoredAny>()?;
+                Ok(DeferredValue::Invalid)
+            }
+        }
+        d.deserialize_any(Capture)
+    }
+}
+impl<'de> IntoDeserializer<'de,de::value::Error> for DeferredValue {
+    type Deserializer=Self;
+    fn into_deserializer(self)->Self{self}
+}
+impl<'de> Deserializer<'de> for DeferredValue {
+    type Error=de::value::Error;
+    fn deserialize_any<V:Visitor<'de>>(self,v:V)->Result<V::Value,Self::Error>{
+        match self {
+            Self::Unit=>v.visit_unit(),Self::Bool(x)=>v.visit_bool(x),Self::I64(x)=>v.visit_i64(x),
+            Self::U64(x)=>v.visit_u64(x),Self::I128(x)=>v.visit_i128(x),Self::U128(x)=>v.visit_u128(x),
+            Self::F64(x)=>v.visit_f64(x),Self::String(x)=>v.visit_string(x),Self::Bytes(x)=>v.visit_byte_buf(x),
+            Self::Seq(x)=>v.visit_seq(de::value::SeqDeserializer::new(x.into_iter())),
+            Self::Map(x)=>v.visit_map(de::value::MapDeserializer::new(x.into_iter())),
+            Self::Invalid=>Err(de::Error::custom("unsupported own-grip metadata")),
+        }
+    }
+    fn deserialize_newtype_struct<V:Visitor<'de>>(self,_:&'static str,v:V)->Result<V::Value,Self::Error>{
+        v.visit_newtype_struct(self)
+    }
+    fn deserialize_option<V:Visitor<'de>>(self,v:V)->Result<V::Value,Self::Error>{
+        match self {Self::Unit=>v.visit_none(),other=>v.visit_some(other)}
+    }
+    fn deserialize_enum<V:Visitor<'de>>(self,_:&'static str,_:&'static [&'static str],v:V)->Result<V::Value,Self::Error>{
+        match self {
+            Self::String(x)=>v.visit_enum(x.into_deserializer()),
+            Self::U64(x)=> {
+                let tag=u32::try_from(x).map_err(|_|de::Error::custom("own-grip enum tag out of range"))?;
+                v.visit_enum(de::value::U32Deserializer::<Self::Error>::new(tag))
+            },
+            _=>Err(de::Error::custom("invalid own-grip relation enum")),
+        }
+    }
+    serde::forward_to_deserialize_any!{bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string bytes byte_buf unit unit_struct seq tuple tuple_struct map struct identifier ignored_any}
+}
+
+pub(super) struct DeferredGripMap<A>{
+    map:A,
+    pub value:Option<DeferredValue>,
+    pub occurrences:usize,
+}
+impl<A> DeferredGripMap<A>{pub fn new(map:A)->Self{Self{map,value:None,occurrences:0}}}
+// Field identifiers accepted by Serde's derived struct visitor.
+enum Key {Name(String),Bytes(Vec<u8>),Index(u64)}
+impl<'de> Deserialize<'de> for Key {
+    fn deserialize<D:Deserializer<'de>>(d:D)->Result<Self,D::Error>{
+        struct Read;
+        impl<'de> Visitor<'de> for Read {
+            type Value=Key;
+            fn expecting(&self,f:&mut fmt::Formatter<'_>)->fmt::Result{f.write_str("field identifier")}
+            fn visit_str<E:de::Error>(self,x:&str)->Result<Key,E>{Ok(Key::Name(x.into()))}
+            fn visit_string<E:de::Error>(self,x:String)->Result<Key,E>{Ok(Key::Name(x))}
+            fn visit_bytes<E:de::Error>(self,x:&[u8])->Result<Key,E>{Ok(Key::Bytes(x.into()))}
+            fn visit_u64<E:de::Error>(self,x:u64)->Result<Key,E>{Ok(Key::Index(x))}
+        }
+        d.deserialize_identifier(Read)
+    }
+}
+impl<'de,A:MapAccess<'de>> MapAccess<'de> for DeferredGripMap<A>{
+    type Error=A::Error;
+    fn next_key_seed<K:DeserializeSeed<'de>>(&mut self,seed:K)->Result<Option<K::Value>,A::Error>{
+        loop {
+            let Some(key)=self.map.next_key::<Key>()? else{return Ok(None)};
+            let own=match &key {Key::Name(x)=>x=="own_grip",Key::Bytes(x)=>x==b"own_grip",Key::Index(x)=>*x==11};
+            if own {
+                self.occurrences=self.occurrences.saturating_add(1);
+                self.value=Some(self.map.next_value()?);
+                continue;
+            }
+            return match key {
+                Key::Name(x)=>seed.deserialize(de::value::StringDeserializer::<A::Error>::new(x)).map(Some),
+                Key::Bytes(x)=>seed.deserialize(de::value::BytesDeserializer::<A::Error>::new(&x)).map(Some),
+                Key::Index(x)=>seed.deserialize(de::value::U64Deserializer::<A::Error>::new(x)).map(Some),
+            };
+        }
+    }
+    fn next_value_seed<V:DeserializeSeed<'de>>(&mut self,seed:V)->Result<V::Value,A::Error>{self.map.next_value_seed(seed)}
+}
