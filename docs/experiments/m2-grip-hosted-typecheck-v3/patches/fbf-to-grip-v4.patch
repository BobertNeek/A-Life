+                    }
+                    actual_transfers += receipt["grip_transfers"]
+                        .as_array()
+                        .ok_or("grip array missing")?
+                        .len() as u64;
+                }
+                let packet = journal::make_packet(&b, offset, &warm_previous, &bytes, &rows)?;
+                journal::publish(&warm_dir, &format!("{offset:06}.packet"), &packet)?;
+                warm_previous = hash(&packet);
+                if let Some(previous) = previous_warm_size {
+                    max_positive_growth =
+                        max_positive_growth.max((packet.len() as u64).saturating_sub(previous));
+                }
+                previous_warm_size = Some(packet.len() as u64);
+                max_packet = max_packet.max(packet.len() as u64);
+                max_science = max_science.max(rows.len() as u64);
+                // Load only this fixture's own cold published prefix. Never use warm
+                // acquired state to initialize the cold trajectory.
+                let mut cold =
+                    restore(&cold_bytes, &r.inputs, arm, 240 + offset, &b.closure_sha256)?;
+                let cold_before = observe(&cold)?;
+                write_new(
+                    &cold_dir,
+                    &format!("ATTEMPT-{offset:06}.json"),
+                    &json!({"offset":offset,"observer":false,"attempt_before_call":true}),
+                )?;
+                let cold_step = counted_call(&mut native, || cold.advance(1., false))?;
+                let cold_wire = cp(&cold)?;
+                let cold_rows = science(
+                    &cold_before,
+                    &observe(&cold)?,
+                    &cold_step,
+                    offset,
+                    &cold_wire,
+                    &b.closure_sha256,
+                    reference,
+                )?;
+                if cold_wire != bytes || original_science(&cold_rows)? != original_science(&rows)? {
+                    return Err(
+                        "observer changed old output/state or cold continuation differs".into(),
+                    );
+                }
+                let cold_packet =
+                    journal::make_packet(&b, offset, &cold_previous, &cold_wire, &cold_rows)?;
+                journal::publish(&cold_dir, &format!("{offset:06}.packet"), &cold_packet)?;
+                let loaded = journal::bounded_read(
+                    &cold_dir.join(format!("{offset:06}.packet")),
+                    journal::MAX_PACKET,
+                )?;
+                let decoded = journal::decode_packet(&loaded, &b, offset, &cold_previous)?;
+                if decoded.checkpoint != cold_wire || decoded.trace != cold_rows {
+                    return Err("cold packet roundtrip differs".into());
+                }
+                cold_previous = decoded.digest;
+                cold_bytes = decoded.checkpoint;
+                max_packet = max_packet.max(cold_packet.len() as u64);
+                max_science = max_science.max(cold_rows.len() as u64);
+            }
+            // Exercise the actual durable recovery/export path, including attempt
+            // records and their retained atomic aliases, without further native calls.
+            for dir in [&warm_dir, &cold_dir] {
+                let recovered = journal::recover_without_trace(dir, &b, &initial, |wire, tick| {
+                    validate_cp(wire, tick, &b.closure_sha256)
+                })?;
+                if recovered.next != INTERVALS || recovered.checkpoint != cold_bytes {
+                    return Err("qualified durable recovery does not match final state".into());
+                }
+            }
+            details.push(json!({"arm":arm,"policy":mode_name(arm)?,"warm_calls":4,"cold_calls":4,"decisions_per_trajectory":arm_decisions,"authoritative_grip_transfers_observed":actual_transfers,"every_original_output_and_checkpoint_exact":true,"observer_only_fields_excluded_from_original_output_comparison":["research_world_receipt"],"closed_source_optimizer_sentinels":true,"final_checkpoint_sha256":hash(&cold_bytes)}));
+        }
+        if actual != 240
+            || native != 16
+            || max_packet
+                .checked_add(262144 + (max_positive_growth * HORIZON).max(1024 * 1024))
+                .is_none_or(|v| v > journal::MAX_PACKET)
+        {
+            return Err("fixed dose or whole-packet forecast failed".into());
+        }
+        write_new(
+            out,
+            "QUALIFICATION_COMPLETE.json",
+            &json!({"schema":"object-rich-coordinated-target-driver-qualification-v1","complete":true,"driver_commit":DRIVER_COMMIT,"driver_code_sha256":code_hash(),"executable_sha256":executable_hash()?,"protocol_sha256":hash(PROTOCOL),"actual_native_calls":native,"actual_preparation_intervals":actual,"primary_seed_executed":false,"observer_inertness_and_cold_exact":true,"maximum_packet_bytes":max_packet,"maximum_positive_packet_growth_per_interval":max_positive_growth,"projected_packet_bytes":max_packet+262144+(max_positive_growth*HORIZON).max(1024*1024),"projection_is_not_a_growth_guarantee":true,"maximum_initial_checkpoint_bytes":max_initial,"maximum_science_row_pair_bytes":max_science,"projected_pair_physical_bytes":2*HORIZON*journal::MAX_PACKET,"metadata_initial_export_headroom":2*journal::MAX_PACKET+64*1024*1024,"arms":details,"no_behavioral_benefit_claim":true,"no_extra_calls_for_event_coverage":true}),
+        )?;
+        Ok(())
+    })();
+    if let Err(e) = &result {
+        let _ = write_new(
+            out,
+            "QUALIFICATION_FAILED.json",
+            &json!({"error":e.to_string(),"actual_native_calls_attempted":native,"actual_preparation_intervals_completed":actual,"no_retry":true}),
+        );
+    }
+    result
+}
