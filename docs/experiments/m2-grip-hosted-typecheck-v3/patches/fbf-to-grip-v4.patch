+    }
+    pub(super) fn coordinate(
+        &self,
+        representative: &mut GripOptionsFactorV1,
+        channels: &[Option<GripOptionsFactorV1>; 6],
+        t: f64,
+        weights: [f64; 3],
+    ) -> Result<(Vec<GripCoordinationPairFactorV1>, [f64; 3]), TrainingError> {
+        if weights.iter().any(|w| !w.is_finite() || w.abs() > 32.) {
+            return Err(invalid());
+        }
+        let mut pairs = Vec::new();
+        let mut representative_logs = Vec::new();
+        for (r, base_logp) in representative
+            .outcomes
+            .iter()
+            .zip(&representative.log_probabilities)
+        {
+            let choices = |channel: usize| -> Vec<(GripOptionsChoiceV1, f64)> {
+                if self.forced(*r) == Some(channel) {
+                    return vec![(*r, 0.)];
+                }
+                channels[channel].as_ref().map_or_else(
+                    || vec![(GripOptionsChoiceV1::NoOp, 0.)],
+                    |f| {
+                        f.outcomes
+                            .iter()
+                            .copied()
+                            .zip(f.log_probabilities.iter().copied())
+                            .collect()
+                    },
+                )
+            };
+            let mut outcomes = Vec::new();
+            let mut features = Vec::new();
+            let mut logits = Vec::new();
+            for (l, lp) in choices(0) {
+                for (m, mp) in choices(2) {
+                    let pair = [l, m];
+                    let phi = self.pair_features(pair)?;
+                    let energy: f64 = phi.iter().zip(weights).map(|(x, w)| x * w).sum();
+                    outcomes.push(pair);
+                    features.push(phi);
+                    logits.push(lp + mp + energy / t);
+                }
+            }
+            let partition = logsumexp(&logits)?;
+            let log_probabilities: Vec<_> = logits.iter().map(|x| x - partition).collect();
+            let probabilities = log_probabilities.iter().map(|x| x.exp()).collect();
+            pairs.push(GripCoordinationPairFactorV1 {
+                outcomes,
+                probabilities,
+                log_probabilities,
+                features,
+            });
+            representative_logs.push(base_logp + partition);
+        }
+        let partition = logsumexp(&representative_logs)?;
+        representative.log_probabilities =
+            representative_logs.iter().map(|x| x - partition).collect();
+        representative.probabilities = representative
+            .log_probabilities
+            .iter()
+            .map(|x| x.exp())
+            .collect();
+        let mut mean = [0.; 3];
+        for (r, pair) in representative.probabilities.iter().zip(&pairs) {
+            for (p, phi) in pair.probabilities.iter().zip(&pair.features) {
+                for i in 0..3 {
+                    mean[i] += r * p * phi[i];
+                }
+            }
+        }
+        Ok((pairs, mean))
+    }
