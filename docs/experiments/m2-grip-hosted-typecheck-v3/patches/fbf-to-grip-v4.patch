+#[test]
+fn coordination_fixed_physical_matrix_preserves_real_failures_and_move_then_reach() {
+    let (host, _) = fresh();
+    let record = host
+        .world()
+        .organism_registry()
+        .iter()
+        .next()
+        .unwrap()
+        .clone();
+    let id = record.organism_id();
+    let scene = |kind: u8, distance: f32, occluded: bool| {
+        let mut builder =
+            HeadlessScenarioBuilder::new(FIXTURE_SEED).agent("learner", id, Vec3f::ZERO);
+        builder = match kind {
+            0 => builder.food("target", Vec3f::new(distance, 0., 0.), 0.65),
+            1 => builder.toy("target", Vec3f::new(distance, 0., 0.), false),
+            _ => builder.obstacle("target", Vec3f::new(distance, 0., 0.), 0.1),
+        };
+        if occluded {
+            builder = builder.obstacle("wall", Vec3f::new(0.5, 0., 0.), 0.2);
+        }
+        let mut w = builder
+            .food("second", Vec3f::new(0.8, 0., 0.25), 0.45)
+            .build()
+            .unwrap();
+        w.register_grounded_drive_research_record(record.clone())
+            .unwrap();
+        w
+    };
+    let command = |w: &HeadlessWorld, label: &str, action: ActionId, kind: ActionKind| {
+        let target = w.entity_id(label).unwrap();
+        ActionCommand::structured(
+            id,
+            action,
+            kind,
+            ActionTarget::new(Some(target), Some(w.entity(target).unwrap().position)),
+            Intensity::new(1.).unwrap(),
+            DurationTicks::new(1),
+            Confidence::new(1.).unwrap(),
+            0,
+            None,
+            None,
+            None,
+        )
+        .unwrap()
+    };
+    let apply = |w: &mut HeadlessWorld, label: &str, action: ActionId| {
+        let c = command(w, label, action, ActionKind::Interact);
+        w.apply_neural_command(&c, None, false).unwrap()
+    };
+    // Six cases, six attempts. Kind failures are intentional and visible.
+    for (kind, distance, action, expected) in [
+        (0, 1., HeadlessActionIds::EAT, true),
+        (0, 3., HeadlessActionIds::EAT, false),
+        (1, 1., HeadlessActionIds::PLAY, true),
+        (1, 3., HeadlessActionIds::PLAY, false),
+        (2, 1., HeadlessActionIds::GRAB, false),
+        (2, 1., HeadlessActionIds::EAT, false),
+    ] {
+        let mut w = scene(kind, distance, false);
+        let result = apply(&mut w, "target", action);
+        assert_eq!(result.execution.succeeded, expected);
+        if !expected {
+            assert!(result.observation.frustration_delta.raw() > 0.);
+            assert_eq!(result.body_event.nutrition, 0.);
+        }
+        if kind == 0 && expected {
+            // First unheld Eat is an actual acquisition phase, not a meal.
+            assert_eq!(result.body_event.nutrition, 0.);
+            assert_eq!(
+                w.entity(w.entity_id("target").unwrap()).unwrap().carried_by,
+                Some(id)
+            );
+            let meal = apply(&mut w, "target", HeadlessActionIds::EAT);
+            assert!(meal.execution.succeeded);
+            assert_eq!(meal.body_event.nutrition, 0.65);
+        }
+    }
+    // Held food is not a toy. Failed Play does not drop it or invent a meal.
+    let mut w = scene(0, 0.5, false);
+    assert!(
+        apply(&mut w, "target", HeadlessActionIds::GRAB)
+            .execution
+            .succeeded
+    );
+    let failure = apply(&mut w, "target", HeadlessActionIds::PLAY);
+    assert!(!failure.execution.succeeded);
+    assert!(failure.observation.frustration_delta.raw() > 0.);
+    assert_eq!(
+        w.entity(w.entity_id("target").unwrap()).unwrap().carried_by,
+        Some(id)
+    );
+    // Own-held Eat stays real and consumes once.
+    let mut w = scene(0, 0.5, false);
+    assert!(
+        apply(&mut w, "target", HeadlessActionIds::GRAB)
+            .execution
+            .succeeded
+    );
+    assert!(
+        apply(&mut w, "target", HeadlessActionIds::EAT)
+            .execution
+            .succeeded
+    );
+    assert!(w.entity(w.entity_id("target").unwrap()).unwrap().consumed);
+    // Ordinary grip replacement, no policy-owned possession rewrite.
+    let mut w = scene(0, 0.5, false);
+    assert!(
+        apply(&mut w, "target", HeadlessActionIds::GRAB)
+            .execution
+            .succeeded
+    );
+    assert!(
+        apply(&mut w, "second", HeadlessActionIds::GRAB)
+            .execution
+            .succeeded
+    );
+    assert_eq!(
+        w.entity(w.entity_id("second").unwrap()).unwrap().carried_by,
+        Some(id)
+    );
+    assert_eq!(
+        w.entity(w.entity_id("target").unwrap()).unwrap().carried_by,
+        None
+    );
+    // Locomotion is executed before manipulation in the SAME real bundle.
+    let mut w = scene(0, 1.251, false);
+    let target = w.entity_id("target").unwrap();
+    let channels = [
+        (MotorChannel::Locomotion, HeadlessActionIds::APPROACH),
+        (MotorChannel::Manipulation, HeadlessActionIds::EAT),
+    ]
+    .into_iter()
+    .map(|(channel, action)| {
+        ChannelCommand::new(
+            channel,
+            action,
+            Some(ActionTarget::new(
+                Some(target),
+                Some(w.entity(target).unwrap().position),
+            )),
+            Vec3f::ZERO,
+            Intensity::new(1.).unwrap(),
+            DurationTicks::new(1),
+            0.,
+            Confidence::new(1.).unwrap(),
+            0,
+        )
+        .unwrap()
+    })
+    .collect();
+    let bundle = MotorCommandBundle::new(
+        id,
+        ExperienceSequenceId::new(1).unwrap(),
+        w.tick(),
+        channels,
+    )
+    .unwrap();
+    let actor = w.entity_id("learner").unwrap();
+    let receipt = w.apply_registered_motor_bundle(&bundle, actor).unwrap();
+    assert!(receipt.succeeded);
+    assert_eq!(receipt.body_event.nutrition, 0.);
+    assert_eq!(w.entity(target).unwrap().carried_by, Some(id));
+    let meal = apply(&mut w, "target", HeadlessActionIds::EAT);
+    assert!(meal.execution.succeeded);
+    assert_eq!(meal.body_event.nutrition, 0.65);
+    // A consumed target and an occluding solid must still fail honestly.
+    let mut w = scene(0, 1., false);
+    assert!(
+        apply(&mut w, "target", HeadlessActionIds::EAT)
+            .execution
+            .succeeded
+    );
+    let meal = apply(&mut w, "target", HeadlessActionIds::EAT);
+    assert!(meal.execution.succeeded);
+    assert_eq!(meal.body_event.nutrition, 0.65);
+    assert!(
+        !apply(&mut w, "target", HeadlessActionIds::EAT)
+            .execution
+            .succeeded
+    );
+    let mut w = scene(0, 1., true);
+    let failure = apply(&mut w, "target", HeadlessActionIds::EAT);
+    assert!(!failure.execution.succeeded);
+    assert!(failure.observation.frustration_delta.raw() > 0.);
+    println!("COORDINATION_PHYSICAL_COUNTS cases=12 direct_primitive_calls=18 registered_bundles=1 physical_channels=20 source_forwards=0");
+}
