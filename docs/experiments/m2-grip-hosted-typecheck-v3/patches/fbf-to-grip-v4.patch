+//! Fresh-source own-grip semantics. Legacy profiles retain their exact fallback.
+use super::*;
+use alife_core::{OwnGripRelationV1, OwnGripSenseV1, OwnGripSlotV1};
+
+impl HeadlessWorld {
+    pub(super) fn has_grip_source(&self, organism: OrganismId) -> bool {
+        self.organism_registry.get(organism).is_some_and(|record| {
+            record.genome().n2048_foundation_candidate.as_ref().is_some_and(|asset| {
+                record.validate_contract().is_ok()
+                    && asset.is_n2048_grounded_grip_sleep_choice()
+                    && asset.manifest().sensor_profile() == SensorProfile::GroundedGripSleepChoiceV1
+            })
+        })
+    }
+
+    /// Explicit fresh birth admission; ordinary and old research entrypoints
+    /// retain their original source restrictions.
+    pub fn register_grip_sleep_choice_research_record(
+        &mut self, record: WorldOrganismRecord,
+    ) -> Result<(), ScaffoldContractError> {
+        record.genome().validate_n2048_grip_sleep_choice_research()?;
+        if record.birth_tick() != self.tick() || record.biochemistry().tick != self.tick() {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        self.register_organism_record_inner(record)
+    }
+
+    /// Own constraint sensing is independent of visual range, occlusion, and
+    /// index coverage. It never reports another actor's ownership or food kind.
+    pub(super) fn capture_own_grip(
+        &mut self,
+        organism: OrganismId,
+        tick: Tick,
+        slots: &[alife_core::GroundedObjectSlotV1],
+    ) -> Result<(OwnGripSenseV1, Option<WorldEntityId>), ScaffoldContractError> {
+        let held = self.objects.values().filter(|o| !o.consumed && o.carried_by == Some(organism))
+            .map(|o| (o.id, o.tracking_provenance, o.grounded_physical)).collect::<Vec<_>>();
+        if held.len() > 1 { return Err(ScaffoldContractError::InvalidPerceptionFrame); }
+        let recognized = if let Some((_, provenance, properties)) = held.first() {
+            // Proprioceptive identity is transported privately; this does not
+            // invent a visible slot or expose the stored physical descriptor.
+            Some(self.tracked_objects.observe(organism, *provenance,
+                crate::StablePhysicalDescriptor::try_from(*properties)?, tick)?.tracked_object_id)
+        } else { None };
+        let sense = OwnGripSenseV1 {
+            schema_version: 1, occupied: !held.is_empty(), confidence: Confidence::new(1.0)?,
+            recognized_held_target: recognized,
+            slots: slots.iter().map(|slot| OwnGripSlotV1 {
+                slot_index: slot.slot_index,
+                relation: if Some(slot.tracked_object_id) == recognized { OwnGripRelationV1::SelfHeld }
+                    else { OwnGripRelationV1::NotSelfHeld },
+                confidence: Confidence::new(1.0).expect("unit confidence"),
+            }).collect(),
+        };
+        sense.validate_slots(&slots.iter().map(|s| s.tracked_object_id).collect::<Vec<_>>())?;
+        Ok((sense, held.first().map(|h| h.0)))
+    }
+
+    pub(super) fn execute_grip_intent(
+        &mut self, command: ActionCommand, actor: WorldEntityId,
+    ) -> Result<HeadlessActionResult, ScaffoldContractError> {
+        if self.objects.get(&actor.raw()).is_none_or(|o|
+                o.consumed || o.organism_id != Some(command.organism_id))
+            || self.organism_registry.get(command.organism_id).is_some_and(|r|
+                !r.lifecycle().is_alive()
+                    || r.embodiment().effector_gain(EffectorCapability::Manipulation) <= 0.0) {
+            return self.invalid_target(command, command.target_entity);
+        }
+        let Some(target) = command.target_entity else {
+            // Empty means physically empty now, not merely absent from vision
+            // or from the earlier snapshot. A stale empty command must never
+            // detach a newly acquired object.
+            let occupied = self.objects.values().any(|o|
+                !o.consumed && o.carried_by == Some(command.organism_id));
+            if command.action_id.raw() == 2202 && !occupied {
+                return self.finish_action(command, true, None,
+                    physical(PhysicalContactKind::None, None, Vec3f::ZERO, 0.01)?,
+                    OutcomeProfile::no_manipulation(), Vec::new());
+            }
+            return self.invalid_target(command, None);
+        };
+        let held = self.objects.get(&target.raw()).is_some_and(|o|
+            !o.consumed && o.carried_by == Some(command.organism_id));
+        if command.action_id.raw() == 2202 && !held {
+            // A named stale release is a failed attempt, never an acquisition.
+            return self.invalid_target(command, Some(target));
+        }
+        if command.action_id.raw() == 2202 {
+            // Releasing an existing constraint needs no visual reacquisition or
+            // reaching through geometry. Finish fallible receipt work first.
+            let position = self.objects[&target.raw()].position;
+            let mut result = self.finish_action(command, true, None,
+                physical(PhysicalContactKind::Touch, Some(target), Vec3f::ZERO, 0.06)?,
+                OutcomeProfile::grab(), vec![target])?;
+            let object = self.objects.get_mut(&target.raw()).expect("checked exact own hold");
+            object.carried_by = None;
+            object.activity_hold = false;
+            result.grip_transfers.push(GripTransfer { object: target,
+                previous_owner: Some(command.organism_id), new_owner: None,
+                previous_position: position, new_position: position, kind: GripTransferKind::Released });
+            return Ok(result);
+        }
+        if command.action_id.raw() == 2201 && held {
+            // Repeated Close keeps the constraint, regardless of target pose.
+            return self.finish_action(command, true, None,
+                physical(PhysicalContactKind::Touch, Some(target), Vec3f::ZERO, 0.06)?,
+                OutcomeProfile::grab(), vec![target]);
+        }
+        // Existing atomic swap handles placement and rollback for acquisition.
+        self.execute_grab(command, actor)
+    }
+}
