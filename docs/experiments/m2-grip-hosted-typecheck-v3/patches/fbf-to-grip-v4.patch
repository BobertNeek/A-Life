+            GripOptionsChoiceV1::Candidate(i) => Ok(Some(i)),
+            GripOptionsChoiceV1::NoOp | GripOptionsChoiceV1::Quiet => Ok(None),
+            GripOptionsChoiceV1::RestGroup => operation
