+fn check_freeze(f: &Freeze) -> Result<()> {
+    if f.schema != "object-rich-coordinated-target-source-build-freeze-v1"
+        || f.host_commit != HOST_COMMIT
+        || f.host_tree != HOST_TREE
+        || f.driver_commit != DRIVER_COMMIT
+        || f.driver_commit.len() != 40
+        || !f.driver_commit.bytes().all(|b| b.is_ascii_hexdigit())
+        || f.driver_code_sha256 != code_hash()
+        || f.executable_sha256 != executable_hash()?
+        || f.protocol_sha256 != hash(PROTOCOL)
+        || f.seed != SEED
+        || f.preparation != PREPARATION
+        || f.horizon != HORIZON
+        || f.temperature_bits != TEMPERATURE.to_bits()
+    {
+        return Err("source/executable/protocol freeze differs".into());
+    }
+    let q: Value = serde_json::from_str(&f.qualification_json)?;
+    if hash(f.qualification_json.as_bytes()) != f.qualification_sha256
+        || q["complete"] != true
+        || q["schema"] != "object-rich-coordinated-target-driver-qualification-v1"
+        || q["driver_code_sha256"] != code_hash()
+        || q["executable_sha256"] != f.executable_sha256
+        || q["protocol_sha256"] != hash(PROTOCOL)
+        || q["actual_native_calls"] != 16
+        || q["actual_preparation_intervals"] != 240
+        || q["primary_seed_executed"] != false
+        || q["observer_inertness_and_cold_exact"] != true
+    {
+        return Err("exact qualification missing or changed".into());
+    }
+    let max = q["maximum_packet_bytes"]
+        .as_u64()
+        .ok_or("qualification packet maximum absent")?;
+    if max
+        .checked_add(262144)
+        .is_none_or(|n| n > journal::MAX_PACKET)
+        || f.projected_pair_bytes != 2 * HORIZON * journal::MAX_PACKET
+        || f.headroom_bytes != 2 * journal::MAX_PACKET + 64 * 1024 * 1024
+    {
+        return Err("fixed whole-packet or allocation budget differs".into());
+    }
+    Ok(())
+}
+fn freeze(qualification_root: &Path, reservation: &Path, out: &Path) -> Result<()> {
+    seed_admission_preflight(SEED, 1)?;
+    canonical_reservation(reservation)?;
+    let (q, qbytes): (Value, _) = read_typed(
+        &qualification_root.join("QUALIFICATION_COMPLETE.json"),
+        1024 * 1024,
+    )?;
+    if q["schema"] != "object-rich-coordinated-target-driver-qualification-v1"
+        || q["complete"] != true
+        || q["driver_code_sha256"] != code_hash()
+        || q["executable_sha256"] != executable_hash()?
+        || q["driver_commit"] != DRIVER_COMMIT
+        || q["protocol_sha256"] != hash(PROTOCOL)
+        || q["primary_seed_executed"] != false
+    {
+        return Err("missing exact qualified driver evidence".into());
+    }
+    let (r, rbytes): (Value, _) = read_typed(reservation, 1024 * 1024)?;
+    if r["study"] != STUDY
+        || r["seed_decimal"] != SEED
+        || r["preparation_attempted"] != false
+        || r["source_constructed"] != false
+        || r["native_calls"] != 0
+    {
+        return Err("reservation is not the untouched primary seed".into());
+    }
+    let f = Freeze {
+        schema: "object-rich-coordinated-target-source-build-freeze-v1".into(),
+        host_commit: HOST_COMMIT.into(),
+        host_tree: HOST_TREE.into(),
+        driver_commit: DRIVER_COMMIT.into(),
+        driver_code_sha256: code_hash(),
+        executable_sha256: executable_hash()?,
+        protocol_sha256: hash(PROTOCOL),
+        qualification_sha256: hash(&qbytes),
+        qualification_json: String::from_utf8(qbytes.clone())?,
+        reservation_sha256: hash(&rbytes),
+        seed: SEED,
+        preparation: PREPARATION,
+        horizon: HORIZON,
+        temperature_bits: TEMPERATURE.to_bits(),
+        projected_pair_bytes: q["projected_pair_physical_bytes"]
