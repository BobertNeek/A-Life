+mod tests {
+    use super::*;
+    fn g(slot: u16, d: f64) -> Geometry {
+        Geometry {
+            slot,
+            distance: d,
+            bearing: [0., 1.],
+            confidence: 1.,
+        }
+    }
+    #[test]
+    fn fixed_near_far_move_then_reach_and_noop() {
+        assert_eq!(geometry_features(None, None), [0.; 3]);
+        assert_eq!(geometry_features(None, Some(g(1, 0.5))), [0.; 3]);
+        assert!(geometry_features(None, Some(g(1, 3.)))[0] > 0.);
+        assert_eq!(
+            geometry_features(
+                Some((g(1, 1.3), CandidateActionFamily::Approach)),
+                Some(g(1, 1.3))
+            )[0],
+            0.
+        );
+        assert!(
+            geometry_features(
+                Some((g(1, 1.3), CandidateActionFamily::Avoid)),
+                Some(g(1, 1.3))
+            )[0] > 0.
+        );
+    }
+    #[test]
+    fn no_kind_or_mobility_or_held_semantic_oracle() {
+        // Geometry alone gives food, stationary toys, hazards and obstacles the
+        // same prior. Their native neural logits and real outcomes distinguish.
+        let near = geometry_features(
+            Some((g(2, 4.), CandidateActionFamily::Approach)),
+            Some(g(1, 0.5)),
+        );
+        assert_eq!(near[0], 0.);
+        assert_eq!(near[2], 0.);
+        let far = geometry_features(
+            Some((g(2, 4.), CandidateActionFamily::Approach)),
+            Some(g(1, 3.)),
+        );
+        assert_eq!(far[2], 0.);
+        let mut opposite = g(2, 4.);
+        opposite.bearing = [0., -1.];
+        assert_eq!(
+            geometry_features(
+                Some((opposite, CandidateActionFamily::Approach)),
+                Some(g(1, 3.))
+            )[2],
+            1.
+        );
+        assert_eq!(
+            geometry_features(
+                Some((g(2, 4.), CandidateActionFamily::Approach)),
+                Some(g(1, 1.3))
+            )[2],
+            0.
+        );
+        let mut uncertain = g(1, 3.);
+        uncertain.confidence = 0.;
+        assert_eq!(geometry_features(None, Some(uncertain)), [0.; 3]);
+    }
+}
