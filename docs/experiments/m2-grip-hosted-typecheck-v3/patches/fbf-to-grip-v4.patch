+//! Pure serialization fixtures. No compiler recipes, native forwards or world calls.
+use alife_core::*;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+const LEGACY_FIELDS: [&str; 11] = [
+    "schema_version",
+    "organism_id",
+    "tick",
+    "sensor_profile",
+    "sensory",
+    "body",
+    "homeostasis",
+    "candidates",
+    "profile_provenance",
+    "grounded_object_slots",
+    "base_digest",
+];
+
+/// Independent declaration of the exact pre-extension eleven-field wire layout.
+/// No skip/default/extension attribute is allowed in this reference type.
+#[derive(Serialize)]
+struct LegacyDraft {
+    schema_version: u16,
+    organism_id: OrganismId,
+    tick: Tick,
+    sensor_profile: SensorProfile,
+    sensory: SensorySnapshot,
+    body: BodySnapshot,
+    homeostasis: HomeostaticSnapshot,
+    candidates: Vec<ActionCandidate>,
+    profile_provenance: SensorProfileProvenance,
+    grounded_object_slots: Vec<GroundedObjectSlotV1>,
+    base_digest: PerceptionBaseDigest,
+}
+impl From<&PerceptionFrameDraft> for LegacyDraft {
+    fn from(d: &PerceptionFrameDraft) -> Self {
+        assert!(d.own_grip().is_none());
+        Self {
+            schema_version: d.schema_version(),
+            organism_id: d.organism_id(),
+            tick: d.tick(),
+            sensor_profile: d.sensor_profile(),
+            sensory: d.sensory().clone(),
+            body: d.body(),
+            homeostasis: *d.homeostasis(),
+            candidates: d.candidates().to_vec(),
+            profile_provenance: d.profile_provenance(),
+            grounded_object_slots: d.grounded_object_slots().to_vec(),
+            base_digest: d.base_digest(),
+        }
+    }
+}
+#[derive(Serialize)]
+struct LegacyFrame {
+    base: LegacyDraft,
+    context: PerceptionContextBlock,
+    frame_digest: PerceptionFrameDigest,
+}
+fn slot() -> GroundedObjectSlotV1 {
+    GroundedObjectSlotV1 {
+        slot_index: 0,
+        tracked_object_id: TrackedObjectId(7),
+        bearing: [-0.3, 0.2],
+        distance: 0.4,
+        relative_velocity: [0.1, 0., -0.2],
+        color: [0.3, 0.4, 0.5],
+        material: [0.2; 3],
+        shape: [0.1; 3],
+        chemical: [0.; 3],
+        contact: 0.2,
+        proprioception: [0.; 2],
+        temperature: 0.1,
+        terrain: [0.; 2],
+        confidence: Confidence::new(0.8).unwrap(),
+    }
+}
+fn action(
+    index: u16,
+    id: u32,
+    kind: ActionKind,
+    family: CandidateActionFamily,
+    observation: CandidateObservationRef,
+    target: ActionTarget,
+    features: CandidateFeatureVector,
+) -> ActionCandidate {
+    ActionCandidate::new(
+        index,
+        ActionId(id),
+        kind,
+        family,
+        observation,
+        target,
+        features,
+        Confidence::new(0.8).unwrap(),
+        NormalizedScalar::new(0.1).unwrap(),
+        DurationTicks::new(1),
+        DurationTicks::new(2),
+    )
+    .unwrap()
+}
+fn fixture(profile: SensorProfile, visible: bool) -> PerceptionFrameDraft {
+    assert!(!visible || profile != SensorProfile::PrivilegedAffordanceV1);
+    let owner = OrganismId(421);
+    let tick = Tick::new(37);
+    let mut channels = SensoryChannels::ZERO;
+    channels.auditory_acoustic[2] = 0.25;
+    channels.smell_chemistry[3] = 0.5;
+    channels.tactile_contact[1] = 0.75;
+    channels.pain_signal = NormalizedScalar::new(0.2).unwrap();
+    let sensory =
+        SensorySnapshot::new(owner, tick, Vec3f::ZERO, channels, Default::default()).unwrap();
+    let mut candidates = vec![action(
+        0,
+        1,
+        ActionKind::Idle,
+        CandidateActionFamily::Idle,
+        CandidateObservationRef::None,
+        ActionTarget::NONE,
+        CandidateFeatureVector::zero(),
+    )];
+    if visible {
+        candidates.push(action(
+            1,
+            2,
+            ActionKind::Inspect,
+            CandidateActionFamily::Inspect,
+            CandidateObservationRef::ObjectSlot(0),
+            ActionTarget::new(Some(WorldEntityId(91)), Some(Vec3f::new(0.5, 0., 0.))),
+            slot().candidate_features().unwrap(),
+        ));
+    }
+    let grip = if profile == SensorProfile::GroundedGripSleepChoiceV1 {
+        candidates.push(action(
+            candidates.len() as u16,
+            2202,
+            ActionKind::Interact,
+            CandidateActionFamily::Other,
+            CandidateObservationRef::OwnGrip,
+            ActionTarget::new(Some(WorldEntityId(7)), None),
+            CandidateFeatureVector::own_grip_target(),
+        ));
+        Some(OwnGripSenseV1 {
+            schema_version: 1,
+            occupied: true,
+            confidence: Confidence::new(0.9).unwrap(),
+            recognized_held_target: Some(TrackedObjectId(7)),
+            slots: if visible {
+                vec![OwnGripSlotV1 {
+                    slot_index: 0,
+                    relation: OwnGripRelationV1::SelfHeld,
+                    confidence: Confidence::new(0.8).unwrap(),
+                }]
+            } else {
+                vec![]
+            },
+        })
+    } else {
+        None
+    };
+    PerceptionFrameDraft::new_with_own_grip(
+        owner,
+        tick,
+        profile,
+        sensory,
+        BodySnapshot {
+            pose: Pose::IDENTITY,
+            velocity: Velocity::ZERO,
+        },
+        HomeostaticSnapshot::baseline(tick),
+        candidates,
+        SensorProfileProvenance::new(profile, SensoryAbiVersion::CURRENT, tick).unwrap(),
+        if visible { vec![slot()] } else { vec![] },
+        grip,
+    )
+    .unwrap()
+}
+fn old_fixtures() -> Vec<PerceptionFrameDraft> {
+    [
+        SensorProfile::PrivilegedAffordanceV1,
+        SensorProfile::GroundedObjectSlotsV1,
+        SensorProfile::GroundedTerrainVisionV1,
+        SensorProfile::GroundedObjectSlotsSleepChoiceV1,
+    ]
+    .into_iter()
+    .flat_map(|p| {
+        if p == SensorProfile::PrivilegedAffordanceV1 {
+            vec![fixture(p, false)]
+        } else {
+            vec![fixture(p, false), fixture(p, true)]
+        }
+    })
+    .collect()
+}
+fn ordered(d: &PerceptionFrameDraft) -> Vec<Value> {
+    let object = serde_json::to_value(d).unwrap();
+    let mut fields = LEGACY_FIELDS
+        .iter()
+        .map(|name| object[*name].clone())
+        .collect::<Vec<_>>();
+    if d.sensor_profile() == SensorProfile::GroundedGripSleepChoiceV1 {
+        fields.push(object["own_grip"].clone());
+    }
+    fields
+}
+fn from_numeric_map(fields: Vec<Value>) -> Result<PerceptionFrameDraft, serde_json::Error> {
+    // JSON itself cannot carry integer object keys. Feed actual u64 identifiers
+    // through MapAccess while retaining full JSON values for each nested field.
+    let entries = fields.into_iter().enumerate().map(|(i, v)| (i as u64, v));
+    PerceptionFrameDraft::deserialize(
+        serde::de::value::MapDeserializer::<_, serde_json::Error>::new(entries),
+    )
+}
+fn binary<T: Serialize>(value: &T) -> Vec<u8> {
+    bincode::serde::encode_to_vec(value, bincode::config::standard()).unwrap()
+}
+#[test]
+fn legacy_full_objects_and_sequences_keep_exact_eleven_fields() {
+    for draft in old_fixtures() {
+        let old = LegacyDraft::from(&draft);
+        let bytes = serde_json::to_vec(&old).unwrap();
+        assert_eq!(serde_json::to_vec(&draft).unwrap(), bytes);
+        assert_eq!(
+            serde_json::from_slice::<PerceptionFrameDraft>(&bytes).unwrap(),
+            draft
+        );
+        let seq = ordered(&draft);
+        assert_eq!(seq.len(), 11);
+        assert_eq!(
+            serde_json::from_value::<PerceptionFrameDraft>(Value::Array(seq)).unwrap(),
+            draft
+        );
+        assert_eq!(binary(&old), binary(&draft));
+    }
+}
+#[test]
+fn legacy_numeric_maps_decode_full_fields_without_extension() {
+    for draft in old_fixtures() {
+        assert_eq!(from_numeric_map(ordered(&draft)).unwrap(), draft);
+    }
+}
+#[test]
+fn legacy_nested_bincode_does_not_consume_the_next_draft_or_tail() {
+    let drafts = old_fixtures();
+    let legacy = drafts.iter().map(LegacyDraft::from).collect::<Vec<_>>();
+    let bytes = binary(&(0xA174_u32, legacy, 0xF123_4567_89AB_CDEF_u64));
+    let ((head, decoded, tail), used): ((u32, Vec<PerceptionFrameDraft>, u64), usize) =
+        bincode::serde::decode_from_slice(&bytes, bincode::config::standard()).unwrap();
+    assert_eq!(head, 0xA174);
+    assert_eq!(tail, 0xF123_4567_89AB_CDEF);
+    assert_eq!(used, bytes.len());
+    assert_eq!(decoded, drafts);
+    let frames = drafts
+        .iter()
+        .cloned()
+        .map(|d| d.finalize(PerceptionContextBlock::empty()).unwrap())
+        .collect::<Vec<_>>();
+    let old_frames = drafts
+        .iter()
+        .zip(&frames)
+        .map(|(d, f)| LegacyFrame {
+            base: LegacyDraft::from(d),
+            context: f.context().clone(),
+            frame_digest: f.frame_digest(),
+        })
+        .collect::<Vec<_>>();
+    let bytes = binary(&(old_frames, Vec::<u8>::from([0x81, 0x91, 0xA1])));
+    assert_eq!(
+        bytes,
+        binary(&(frames.clone(), Vec::<u8>::from([0x81, 0x91, 0xA1])))
+    );
+    let ((decoded, tail), used): ((Vec<PerceptionFrame>, Vec<u8>), usize) =
+        bincode::serde::decode_from_slice(&bytes, bincode::config::standard()).unwrap();
+    assert_eq!(used, bytes.len());
+    assert_eq!(decoded, frames);
+    assert_eq!(tail, [0x81, 0x91, 0xA1]);
