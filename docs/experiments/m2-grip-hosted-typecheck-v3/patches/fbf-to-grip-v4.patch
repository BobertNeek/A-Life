+//! Authored only. This test executes compiler recipes when explicitly selected.
+//! The exact recursive recipe/work dose must be reviewed before enabling it.
+use alife_core::*;
+
+#[test]
+#[ignore = "source-only authoring: requires separately admitted compiler reconstruction dose"]
+fn sealed_source_descriptor_asset_and_restore_preserve_every_numerical_row() {
+    let capacity = BrainCapacityClass::n2048_grounded_drive_research();
+    let genome = BrainGenome::scaffold(0x4752_4950, capacity.id());
+    let development =
+        DevelopmentState::new(genome.id, Tick::ZERO, NormalizedScalar::new(1.).unwrap());
+    let (unsealed, _) = PhenotypeCompiler::compile_n2048_grounded_drive_basis(
+        genome.clone(),
+        development.clone(),
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap();
+    let source_asset = FoundationWeightAsset::from_phenotype_for_genetic_birth(&unsealed).unwrap();
+    // Persisted reconstruction is compared from a sealed exact genetic asset,
+    // not from an unbound recipe that intentionally has a different input identity.
+    let (source, source_inputs) = PhenotypeCompiler::compile_n2048_grounded_drive_basis_candidate(
+        genome.clone(),
+        development.clone(),
+        source_asset.clone(),
+    )
+    .unwrap();
+    let source_input_bytes = serde_json::to_vec(&source_inputs).unwrap();
+    let source_bytes = serde_json::to_vec(&source).unwrap();
+    let source_asset_bytes = source_asset.encode_canonical().unwrap();
+    let (fresh, fresh_inputs) =
+        PhenotypeCompiler::compile_n2048_grounded_grip_sleep_choice(&source_inputs).unwrap();
+    fresh.validate_against(&capacity).unwrap();
+    assert_eq!(
+        fresh.sensor_profile(),
+        SensorProfile::GroundedGripSleepChoiceV1
+    );
+    assert_eq!(fresh.brain_class_id(), source.brain_class_id());
+    assert_eq!(fresh.synapses(), source.synapses());
+    assert_eq!(fresh.neuron_dynamics(), source.neuron_dynamics());
+    assert_eq!(fresh.lobe_layout(), source.lobe_layout());
+    assert_eq!(
+        fresh.persistent_address_map(),
+        source.persistent_address_map()
+    );
+    assert_eq!(fresh.candidate_decoder(), source.candidate_decoder());
+    assert_eq!(fresh.candidate_decoder().flattened_input_lane_count(), 54);
+    assert_ne!(
+        fresh_inputs.canonical_digest(),
+        source_inputs.canonical_digest()
+    );
+    assert_eq!(
+        fresh_inputs
+            .foundation_abi()
+            .n2048_grounded_grip_sleep_choice()
+            .unwrap()
+            .source_inputs(),
+        &source_inputs
+    );
+    assert_eq!(
+        serde_json::to_vec(&source_inputs).unwrap(),
+        source_input_bytes
+    );
+    assert_eq!(serde_json::to_vec(&source).unwrap(), source_bytes);
+    assert_eq!(source_asset.encode_canonical().unwrap(), source_asset_bytes);
+
+    let restored_inputs: PhenotypeCompilerInputs =
+        serde_json::from_slice(&serde_json::to_vec(&fresh_inputs).unwrap()).unwrap();
+    let restored = PhenotypeCompiler::compile_validated(&restored_inputs, &capacity).unwrap();
+    assert_eq!(restored_inputs, fresh_inputs);
+    assert_eq!(restored, fresh);
+    let restored_phenotype: BrainPhenotype =
+        serde_json::from_slice(&serde_json::to_vec(&fresh).unwrap()).unwrap();
+    assert_eq!(restored_phenotype, fresh);
+
+    let asset = FoundationWeightAsset::from_phenotype_for_genetic_birth(&fresh).unwrap();
+    let encoded = asset.encode_canonical().unwrap();
+    let decoded = FoundationWeightAsset::decode_canonical(&encoded).unwrap();
+    assert_eq!(decoded, asset);
+    assert!(decoded.is_n2048_grounded_grip_sleep_choice());
+    assert!(!decoded.is_n2048_grounded_drive_basis());
+    assert!(N2048GroundedDriveBasisV1::for_asset(&decoded).is_err());
+    assert_ne!(
+        decoded.manifest().foundation_id(),
+        source_asset.manifest().foundation_id()
+    );
+    let (reconstructed, reconstructed_inputs) =
+        PhenotypeCompiler::compile_n2048_grip_sleep_choice_candidate(
+            genome,
+            development,
+            decoded.clone(),
+        )
+        .unwrap();
+    assert_eq!(reconstructed, fresh);
+    assert_eq!(reconstructed_inputs, fresh_inputs);
+    decoded.validate_against(&reconstructed).unwrap();
+    decoded.manifest().validate_against(&reconstructed).unwrap();
+    assert_eq!(decoded.weights(), source_asset.weights());
+}
