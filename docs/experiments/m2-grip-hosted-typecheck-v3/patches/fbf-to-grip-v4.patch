+//! New fresh grip profile adapters. No old 54-float source lane is repurposed.
+use super::{grip_ports_v3 as ports, invalid};
+use crate::TrainingError;
+use alife_core::*;
+
+pub(super) const GRIP_APPEND_Q24: u64 = 256 * 32 + (256 + 128) * 4 + 256 + 5;
+pub(super) fn is_grip(p: &BrainPhenotype) -> bool {
+    p.sensor_profile() == SensorProfile::GroundedGripSleepChoiceV1
+        && p.foundation_abi()
+            .n2048_grounded_grip_sleep_choice()
+            .is_some()
+}
+pub(super) fn matches_source_frame(p: &BrainPhenotype, f: &PerceptionFrame) -> bool {
+    if is_grip(p) {
+        f.sensor_profile() == SensorProfile::GroundedGripSleepChoiceV1 && f.own_grip().is_some()
+    } else {
+        p.sensor_profile() == SensorProfile::GroundedObjectSlotsV1
+            && f.sensor_profile() == SensorProfile::GroundedObjectSlotsSleepChoiceV1
+    }
+}
+pub(super) fn recovery_operation(
+    f: &PerceptionFrame,
+    c: &ActionCandidate,
+) -> Result<Option<RecoveryOperationV1>, TrainingError> {
+    if f.sensor_profile() == SensorProfile::GroundedGripSleepChoiceV1
+        && matches!(c.action_id.raw(), 2201 | 2202)
+    {
+        f.validate_contract()?;
+        if c.kind != ActionKind::Interact
+            || c.family
+                != if c.action_id.raw() == 2201 {
+                    CandidateActionFamily::Contact
+                } else {
+                    CandidateActionFamily::Other
+                }
+        {
+            return Err(invalid());
+        }
+        Ok(None)
+    } else {
+        Ok(RecoveryOperationV1::for_candidate(c)?)
+    }
+}
+fn bytes(words: [u64; 4]) -> [u8; 32] {
+    let mut out = [0; 32];
+    for (i, w) in words.into_iter().enumerate() {
+        out[i * 8..i * 8 + 8].copy_from_slice(&w.to_le_bytes());
+    }
+    out
+}
+pub(super) fn rows(
+    p: &BrainPhenotype,
+    f: &PerceptionFrame,
+    generation: u64,
+) -> Result<Vec<ports::Ports>, TrainingError> {
+    if !is_grip(p) || !matches_source_frame(p, f) {
+        return Err(invalid());
+    }
+    f.validate_contract()?;
+    let sense = f.own_grip().ok_or_else(invalid)?;
+    f.candidates()
+        .iter()
+        .map(|c| {
+            let operation = match c.action_id.raw() {
+                2201 => ports::Operation::Close,
+                2202 => ports::Operation::Release,
+                _ => return Ok(ports::Ports::zero()),
+            };
+            recovery_operation(f, c)?;
+            let (tracked, relation, confidence) = match c.observation {
+                CandidateObservationRef::ObjectSlot(i) => {
+                    let slot = f
+                        .grounded_object_slots()
+                        .get(i as usize)
+                        .ok_or_else(invalid)?;
+                    let own = sense.slots.get(i as usize).ok_or_else(invalid)?;
+                    (
+                        slot.tracked_object_id.raw(),
+                        match own.relation {
+                            OwnGripRelationV1::Unknown => None,
+                            OwnGripRelationV1::NotSelfHeld => Some(false),
+                            OwnGripRelationV1::SelfHeld => Some(true),
+                        },
+                        own.confidence.raw(),
+                    )
+                }
+                CandidateObservationRef::OwnGrip => (
+                    sense.recognized_held_target.map_or(0, |t| t.raw()),
+                    if sense.occupied {
+                        Some(true)
+                    } else {
+                        Some(false)
+                    },
+                    sense.confidence.raw(),
+                ),
+                _ => return Err(invalid()),
+            };
+            // Caller owns an actual pending source forward; frame and generation are
+            // bound again by native score and source receipt validation before sample.
+            ports::Ports::bind(
+                ports::Binding {
+                    owner: f.organism_id().raw(),
+                    tick: f.tick().raw(),
+                    source_hash: bytes(p.phenotype_hash().0),
+                    frame_digest: bytes(f.frame_digest().0),
+                    generation,
+                    candidate: c.candidate_index,
+                    target: if tracked == 0 { ports::Target::OwnGripper } else { ports::Target::Object(tracked) },
+                    operation,
+                },
+                ports::Proprioception {
+                    occupied: sense.occupied,
+                    body_confidence: sense.confidence.raw(),
+                    target_self_held: relation,
+                    relation_confidence: confidence,
+                },
+                None,
+            )
+            .map_err(|_| invalid())
+            // Exact operation memory is UNKNOWN until an operation-scoped producer
+            // exists. No inferred Contact inversion or Other-family value enters here.
+        })
+        .collect()
+}
+pub(super) fn dynamics() -> Result<NeuronDynamics, TrainingError> {
+    serde_json::from_str(r#"{"bias":0.0,"leak":1.0,"activation":"Tanh","activity_ema_decay":0.95,"metabolic_decay":0.01,"homeostatic_gain":0.0}"#).map_err(|_|invalid())
+}
+
+#[derive(Debug, Clone, serde::Serialize, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct GripReadoutReceiptV1 {
+    pub source: PhenotypeHash,
+    pub frame: PerceptionFrameDigest,
+    pub generation: u64,
+    pub kernel: ports::Receipt,
+    /// All five mediated native components follow the referenced NoManip output.
+    pub native_component_owners: Vec<u16>,
+}
+impl GripReadoutReceiptV1 {
+    pub(super) fn validate(
+        &self,
+        source: PhenotypeHash,
+        frame: PerceptionFrameDigest,
+        generation: u64,
+        candidates: usize,
+    ) -> Result<(), TrainingError> {
+        let k = &self.kernel;
+        if self.native_component_owners.len() != candidates
+            || self
+                .native_component_owners
+                .iter()
+                .any(|i| usize::from(*i) >= candidates)
+        {
+            return Err(invalid());
+        }
+        if self.native_component_owners.iter().any(|&owner|
+            self.native_component_owners[usize::from(owner)] != owner) {
+            return Err(invalid());
+        }
+        if (self.source, self.frame, self.generation) != (source, frame, generation)
+            || k.deltas.len() != candidates
+            || k.readout_jacobians.len() != candidates
+            || k.recall_jacobians.len() != candidates
+            || k.neuron_updates != 256
+            || k.sensory_assignments != 256
+            || k.signed_reduction_products != 256
+            || k.readout_products != 128
+            || k.recall_derivative_evaluations != candidates as u64
+            || k.deltas
+                .iter()
+                .chain(&k.recall_jacobians)
+                .any(|x| !x.is_finite())
+            || k.readout_jacobians.iter().flatten().any(|x| !x.is_finite())
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
+
+/// Authored motor wiring: an otherwise unmapped Release starts from actual
+/// NoManip's native inputs, not generic Other-family desire. No raw world labels.
+fn maintenance_base(release: &mut [f32; 5], maintenance: [f32; 5]) {
+    release[..4].copy_from_slice(&maintenance[..4]);
+    release[4] = 0.0;
+}
+pub(super) fn route_release_base(
+    frame: &PerceptionFrame,
+    components: &mut [[f32; 5]],
+) -> Result<Vec<u16>, TrainingError> {
+    if frame.sensor_profile() != SensorProfile::GroundedGripSleepChoiceV1
+        || components.len() != frame.candidates().len()
+    {
+        return Err(invalid());
+    }
+    let mut no_manip = None;
+    let mut release = None;
+    for (i, c) in frame.candidates().iter().enumerate() {
+        if c.action_id.raw() == 212 {
+            if no_manip.replace(i).is_some()
+                || c.kind != ActionKind::Interact
+                || c.family != CandidateActionFamily::Contact
+                || c.target != ActionTarget::NONE
+                || c.observation != CandidateObservationRef::None
+            {
+                return Err(invalid());
+            }
+        }
+        if c.action_id.raw() == 2202 {
+            if release.replace(i).is_some()
+                || c.kind != ActionKind::Interact
+                || c.family != CandidateActionFamily::Other
+                || c.observation != CandidateObservationRef::OwnGrip
+            {
+                return Err(invalid());
+            }
+        }
+    }
+    let owner = no_manip.ok_or_else(invalid)?;
+    let release = release.ok_or_else(invalid)?;
+    let maintenance = components[owner];
+    maintenance_base(&mut components[release], maintenance);
+    let mut routes = (0..components.len()).map(|i| i as u16).collect::<Vec<_>>();
+    routes[release] = owner as u16;
+    Ok(routes)
+}
+#[cfg(test)]
+mod maintenance_tests {
+    use super::*;
+    #[test]
+    fn release_native_base_is_maintenance_not_other_value() {
+        let mut release = [9., 8., 7., 6., 5.];
+        let maintenance = [0.2, -0.1, 0., 0.3, 0.];
+        maintenance_base(&mut release, maintenance);
+        assert_eq!(release, maintenance);
+    }
+}
+
+/// Exact authoritative mediated reference, independent of candidate-slot state.
+/// Jacobians are routed with the output, not left attached to unused Release cells.
+pub(super) fn reference_maintenance_output(
+    logits: &mut [f32],
+    jacobians: &mut [[f32; 5]],
+    owners: &[u16],
+) -> Result<(), TrainingError> {
+    if logits.len() != owners.len() || jacobians.len() != owners.len() {
+        return Err(invalid());
+    }
+    for (i, &owner) in owners.iter().enumerate() {
+        let owner = usize::from(owner);
+        if owner >= owners.len() || usize::from(owners[owner]) != owner {
+            return Err(invalid());
+        }
+        if owner != i {
+            logits[i] = logits[owner];
+            jacobians[i] = jacobians[owner];
+        }
+    }
+    Ok(())
+}
