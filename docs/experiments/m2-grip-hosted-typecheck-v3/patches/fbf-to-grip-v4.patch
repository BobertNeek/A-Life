+//! Versioned new-profile grip bank; prototype arithmetic preserved.
+//! Native scalar circuit owned by the new registered CPU host. The adapter
+//! authenticates pending source/frame identity before constructing these ports.
+//! The kernel itself is not a world dispatcher or a security boundary.
+use super::native_kernel::{self, CellState};
+use alife_core::NeuronDynamics;
+use serde::{Deserialize, Serialize};
+
+pub const SCHEMA: &str = "m2-grip-options-native-bank-v1-profile6";
+pub const SLOTS: usize = 32;
+pub const PORTS: usize = 4;
+pub const CELLS: usize = SLOTS * PORTS * 2;
+/// Authored conservative motor priors, not measured or learned weights.
+/// Repeat Close; occupied-hand swap; Release effort; exact-operation value.
+pub const INITIAL_READOUTS: [f32; PORTS] = [-0.5, -0.25, -0.5, 1.0];
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum Operation {
+    Close,
+    Release,
+}
+/// A body operation has no object identity and cannot retrieve object memory.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum Target {
+    Object(u64),
+    OwnGripper,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Binding {
+    pub owner: u64,
+    pub tick: u64,
+    pub source_hash: [u8; 32],
+    pub frame_digest: [u8; 32],
+    pub generation: u64,
+    pub candidate: u16,
+    pub target: Target,
+    pub operation: Operation,
+}
+/// One's own body knows whether its gripper is occupied, including offscreen.
+/// Absence of a target relation means UNKNOWN, not empty or free-to-acquire.
+#[derive(Debug, Clone, Copy)]
+pub struct Proprioception {
+    pub occupied: bool,
+    pub body_confidence: f32,
+    pub target_self_held: Option<bool>,
+    pub relation_confidence: f32,
+}
+#[derive(Debug, Clone, Copy)]
+pub struct ExactOperationRecall {
+    pub binding: Binding,
+    pub value: f32,
+    pub confidence: f32,
+}
+#[derive(Debug, Clone, Copy)]
+pub struct Ports {
+    values: [f32; PORTS],
+    /// Derivative to the exact raw recall value. No unrelated Other credit.
+    recall_slope: f32,
+}
+fn unit(v: f32) -> bool {
+    v.is_finite() && (0.0..=1.0).contains(&v)
+}
+impl Ports {
+    pub fn zero() -> Self {
+        Self {
+            values: [0.0; PORTS],
+            recall_slope: 0.0,
+        }
+    }
+    pub fn bind(
+        binding: Binding,
+        grip: Proprioception,
+        recall: Option<ExactOperationRecall>,
+    ) -> Result<Self, &'static str> {
+        if binding.owner == 0
+            || matches!(binding.target, Target::Object(0))
+            || (binding.target == Target::OwnGripper && binding.operation != Operation::Release)
+            || binding.generation == 0
+            || usize::from(binding.candidate) >= SLOTS
+            || !unit(grip.body_confidence)
+            || !unit(grip.relation_confidence)
+            || (grip.target_self_held == Some(true) && !grip.occupied)
+        {
+            return Err("invalid grounded grip binding");
+        }
+        let mut result = Self::zero();
+        let c = grip.body_confidence.min(grip.relation_confidence);
+        match binding.operation {
+            Operation::Close => {
+                result.values[0] = if grip.target_self_held == Some(true) {
+                    c
+                } else {
+                    0.0
+                };
+                result.values[1] = if grip.occupied && grip.target_self_held == Some(false) {
+                    c
+                } else {
+                    0.0
+                };
+            }
+            Operation::Release => {
+                // Releasing any grip expends effort; an empty attempt has twice
+                // the authored input cost. This is never a held-object value.
+                result.values[2] = grip.body_confidence * if grip.occupied { 0.5 } else { 1.0 };
+            }
+        }
+        if let Some(memory) = recall {
+            // No Contact-to-Other sign inversion, target substitution, slot-only
+            // lookup or prior-profile family-memory reinterpretation.
+            if binding.target == Target::OwnGripper
+                || memory.binding != binding
+                || !unit(memory.confidence)
+                || !memory.value.is_finite()
+                || !(-1.0..=1.0).contains(&memory.value)
+            {
+                return Err("recall provenance mismatch");
+            }
+            result.values[3] = memory.value * memory.confidence;
+            result.recall_slope = memory.confidence;
+        }
+        Ok(result)
+    }
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Bank {
+    schema: String,
+    activation: Vec<f32>,
+    ema: Vec<f32>,
+    metabolic: Vec<f32>,
+    readouts: [f32; PORTS],
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Receipt {
+    pub deltas: Vec<f32>,
+    pub readout_jacobians: Vec<[f32; PORTS]>,
+    pub recall_jacobians: Vec<f32>,
+    pub neuron_updates: u64,
+    pub readout_products: u64,
+    pub sensory_assignments: u64,
+    pub signed_reduction_products: u64,
+    pub recall_derivative_evaluations: u64,
+}
+impl Bank {
+    pub fn fresh() -> Self {
+        Self {
+            schema: SCHEMA.into(),
+            activation: vec![0.0; CELLS],
+            ema: vec![0.0; CELLS],
+            metabolic: vec![0.0; CELLS],
+            readouts: INITIAL_READOUTS,
+        }
+    }
+    pub fn validate(&self) -> Result<(), &'static str> {
+        if self.schema != SCHEMA
+            || [&self.activation, &self.ema, &self.metabolic]
+                .iter()
+                .any(|b| b.len() != CELLS || b.iter().any(|x| !x.is_finite()))
+            || self.activation.iter().any(|x| x.abs() > 1.0)
+            || self.ema.iter().chain(&self.metabolic).any(|x| !unit(*x))
+            || self
+                .readouts
+                .iter()
+                .any(|x| !x.is_finite() || x.abs() > 4.0)
+        {
+            return Err("invalid grip bank");
+        }
+        Ok(())
+    }
+    /// All 32 padded slots are charged. No state is written on validation failure.
+    /// Caller commits this candidate bank only with the ordinary host commit.
+    pub fn forward(
+        &self,
+        rows: &[Ports],
+        dynamics: &NeuronDynamics,
+    ) -> Result<(Self, Receipt), &'static str> {
+        self.validate()?;
+        // Stateless readout activation avoids leaking last frame's candidate
+        // identity through reused slots. EMA/metabolic are still preserved.
+        if rows.len() > SLOTS
+            || dynamics.activation().raw() != 2
+            || dynamics.leak() != 1.0
+            || dynamics.bias() != 0.0
+            || dynamics.homeostatic_gain() != 0.0
+        {
+            return Err("wrong grip neuron dynamics");
+        }
+        let mut next = self.clone();
+        let mut receipt = Receipt {
+            deltas: vec![0.0; rows.len()],
+            readout_jacobians: vec![[0.0; PORTS]; rows.len()],
+            recall_jacobians: vec![0.0; rows.len()],
+            neuron_updates: 0,
+            readout_products: 0,
+            sensory_assignments: 0,
+            signed_reduction_products: 0,
+            recall_derivative_evaluations: 0,
+        };
+        for slot in 0..SLOTS {
+            let row = rows.get(slot).copied().unwrap_or_else(Ports::zero);
+            for port in 0..PORTS {
+                let mut difference = 0.0;
+                for side in 0..2 {
+                    let sign = if side == 0 { 1.0 } else { -1.0 };
+                    let i = (slot * PORTS + port) * 2 + side;
+                    let step = native_kernel::neuron_step(
+                        dynamics,
+                        CellState {
+                            activation: self.activation[i],
+                            ema: self.ema[i],
+                            metabolic: self.metabolic[i],
+                        },
+                        sign * row.values[port],
+                        0.0,
+                        0.0,
+                        0.0,
+                        0.0,
+                    );
+                    next.activation[i] = step.state.activation;
+                    next.ema[i] = step.state.ema;
+                    next.metabolic[i] = step.state.metabolic;
+                    difference += step.state.activation * (if side == 0 { 0.5 } else { -0.5 });
+                    receipt.signed_reduction_products += 1;
+                    receipt.neuron_updates += 1;
+                    receipt.sensory_assignments += 1;
+                }
+                let product = difference * self.readouts[port];
+                receipt.readout_products += 1;
+                if slot < rows.len() {
+                    receipt.deltas[slot] += product;
+                    receipt.readout_jacobians[slot][port] = difference;
+                    if port == 3 {
+                        receipt.recall_derivative_evaluations += 1;
+                        receipt.recall_jacobians[slot] = self.readouts[port]
+                            * (1.0 - difference * difference)
+                            * row.recall_slope;
+                    }
+                }
+            }
+        }
+        next.validate()?;
+        Ok((next, receipt))
+    }
+}
