+pub const MAGIC: &[u8] =
+    b"ALIFE-GROUPED-M2-HOST\0V1\0CONFIDENCE-V2\0SYNAPTIC-CLOSED\0PROFILE5\0SAMPLER-BITS1\0";
+#[derive(Clone, Copy)]
+pub struct Raw<'a>(pub &'a [u8]);
+impl<'a> Raw<'a> {
+    pub fn object(self) -> Result<BTreeMap<String, Self>> {
+        let bytes = self.0;
+        if bytes.first() != Some(&b'{') {
+            return Err("raw object expected".into());
+        }
+        let mut pos = 1;
+        let mut out = BTreeMap::new();
+        loop {
+            ws(bytes, &mut pos);
+            if bytes.get(pos) == Some(&b'}') {
+                pos += 1;
+                break;
+            }
+            let (key, end) = read::<String>(&bytes[pos..])?;
+            pos += end;
+            ws(bytes, &mut pos);
+            if bytes.get(pos) != Some(&b':') {
+                return Err("raw colon expected".into());
+            }
+            pos += 1;
+            ws(bytes, &mut pos);
+            let start = pos;
+            let (_, len) = read::<serde::de::IgnoredAny>(&bytes[pos..])?;
+            pos += len;
+            if out.insert(key, Raw(&bytes[start..pos])).is_some() {
+                return Err("duplicate raw key".into());
+            }
+            ws(bytes, &mut pos);
+            match bytes.get(pos) {
+                Some(b',') => pos += 1,
+                Some(b'}') => {
+                    pos += 1;
+                    break;
+                }
+                _ => return Err("raw object delimiter".into()),
+            }
+        }
+        ws(bytes, &mut pos);
+        if pos != bytes.len() {
+            return Err("raw object trailing bytes".into());
+        }
+        Ok(out)
+    }
+    pub fn array(self) -> Result<Vec<Self>> {
+        let bytes = self.0;
+        if bytes.first() != Some(&b'[') {
+            return Err("raw array expected".into());
+        }
+        let mut pos = 1;
+        let mut out = Vec::new();
+        loop {
+            ws(bytes, &mut pos);
+            if bytes.get(pos) == Some(&b']') {
+                pos += 1;
+                break;
+            }
+            let start = pos;
+            let (_, len) = read::<serde::de::IgnoredAny>(&bytes[pos..])?;
+            pos += len;
+            out.push(Raw(&bytes[start..pos]));
+            ws(bytes, &mut pos);
+            match bytes.get(pos) {
+                Some(b',') => pos += 1,
+                Some(b']') => {
+                    pos += 1;
+                    break;
+                }
+                _ => return Err("raw array delimiter".into()),
+            }
+        }
+        ws(bytes, &mut pos);
+        if pos != bytes.len() {
+            return Err("raw array trailing bytes".into());
+        }
+        Ok(out)
+    }
+    pub fn field(self, name: &str) -> Result<Self> {
+        self.object()?
+            .remove(name)
+            .ok_or_else(|| format!("missing raw field {name}").into())
+    }
+    pub fn path(self, path: &[&str]) -> Result<Self> {
+        path.iter().try_fold(self, |v, key| v.field(key))
+    }
+    pub fn one(self) -> Result<Self> {
+        let values = self.array()?;
+        if values.len() != 1 {
+            return Err("exactly one raw resident expected".into());
+        }
+        Ok(values[0])
+    }
+    pub fn value<T: serde::de::DeserializeOwned>(self) -> Result<T> {
+        Ok(serde_json::from_slice(self.0)?)
+    }
+}
+fn ws(bytes: &[u8], pos: &mut usize) {
+    while bytes.get(*pos).is_some_and(u8::is_ascii_whitespace) {
+        *pos += 1;
+    }
+}
+fn read<T: serde::de::DeserializeOwned>(bytes: &[u8]) -> Result<(T, usize)> {
+    let mut stream = serde_json::Deserializer::from_slice(bytes).into_iter::<T>();
+    let value = stream.next().ok_or("missing raw JSON value")??;
+    Ok((value, stream.byte_offset()))
