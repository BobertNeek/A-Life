+//! Source-authored bounded memory controls. No recipe, native forward or world call.
+use super::*;
+use crate::*;
+fn query(target: Option<u64>, operation: u32) -> CandidateMemoryQueryV2 {
+    let owner = OrganismId(811);
+    let tick = Tick::new(20);
+    let profile = SensorProfile::GroundedGripSleepChoiceV1;
+    let family = if operation == 2201 {
+        CandidateActionFamily::Contact
+    } else {
+        CandidateActionFamily::Other
+    };
+    let slot = GroundedObjectSlotV1 {
+        slot_index: 0,
+        tracked_object_id: TrackedObjectId(target.unwrap_or(61)),
+        bearing: [0.; 2],
+        distance: 0.2,
+        relative_velocity: [0.; 3],
+        color: [0.6; 3],
+        material: [0.5; 3],
+        shape: [0.4; 3],
+        chemical: [0.; 3],
+        contact: 0.,
+        proprioception: [0.; 2],
+        temperature: 0.,
+        terrain: [0.; 2],
+        confidence: Confidence::new(1.).unwrap(),
+    };
+    let visible = target.is_some();
+    let c = ActionCandidate::new(
+        0,
+        ActionId(operation),
+        ActionKind::Interact,
+        family,
+        if visible {
+            CandidateObservationRef::ObjectSlot(0)
+        } else {
+            CandidateObservationRef::OwnGrip
+        },
+        ActionTarget::new(target.map(WorldEntityId), None),
+        if visible {
+            slot.candidate_features().unwrap()
+        } else {
+            CandidateFeatureVector::own_grip_target()
+        },
+        Confidence::new(1.).unwrap(),
+        NormalizedScalar::new(0.2).unwrap(),
+        DurationTicks::new(1),
+        DurationTicks::new(2),
+    )
+    .unwrap();
+    let draft = PerceptionFrameDraft::new_with_own_grip(
+        owner,
+        tick,
+        profile,
+        SensorySnapshot::new(
+            owner,
+            tick,
+            Vec3f::ZERO,
+            SensoryChannels::ZERO,
+            Default::default(),
+        )
+        .unwrap(),
+        BodySnapshot {
+            pose: Pose::IDENTITY,
+            velocity: Velocity::ZERO,
+        },
+        HomeostaticSnapshot::baseline(tick),
+        vec![c],
+        SensorProfileProvenance::new(profile, SensoryAbiVersion::CURRENT, tick).unwrap(),
+        if visible { vec![slot] } else { vec![] },
+        Some(OwnGripSenseV1 {
+            schema_version: 1,
+            occupied: visible,
+            confidence: Confidence::new(1.).unwrap(),
+            recognized_held_target: target.map(TrackedObjectId),
+            slots: if visible {
+                vec![OwnGripSlotV1 {
+                    slot_index: 0,
+                    relation: OwnGripRelationV1::SelfHeld,
+                    confidence: Confidence::new(1.).unwrap(),
+                }]
+            } else {
+                vec![]
+            },
+        }),
+    )
+    .unwrap();
+    MemoryQueryEncoderV2::encode_candidate(&draft, &draft.candidates()[0]).unwrap()
+}
+fn record(q: &CandidateMemoryQueryV2) -> CandidateMemoryRecordV2 {
+    CandidateMemoryRecordV2 {
+        schema_version: MEMORY_RECALL_SCHEMA_VERSION,
+        memory_id: MemoryId(1),
+        organism_id_raw: q.organism_id().raw(),
+        source_sequence_id: ExperienceSequenceId(1),
+        first_tick: Tick::new(1),
+        last_tick: Tick::new(2),
+        profile_id_raw: q.profile().profile_id.raw(),
+        profile_schema_version: q.profile().profile_schema_version,
+        sensory_abi_version_raw: q.profile().sensory_abi_version,
+        query_version_raw: q.version().raw(),
+        action_id_raw: q.action_id().raw(),
+        action_kind_raw: q.action_kind().raw(),
+        family_raw: u16::from(q.action_family().raw()),
+        tracked_object_id_raw: q.tracked_object_id().map_or(0, |id| id.raw()),
+        query_features: q.features().to_vec(),
+        target_latent: [0.; MEMORY_LATENT_V1_COUNT],
+        family_value: [0.7; MEMORY_VALUE_V1_COUNT],
+        confidence: 1.,
+        salience_q16: u16::MAX,
+        observation_count: 1,
+        outcome_contact: None,
+    }
+}
+fn recall(record: CandidateMemoryRecordV2, q: &CandidateMemoryQueryV2) -> FamilyRecallResult {
+    record.validate_contract().unwrap();
+    let mut store = CandidateMemoryStoreV2::default();
+    let id = record.memory_id;
+    store.records.insert(id.raw(), record);
+    store.insert_record_into_indices(id);
+    let (_, key) = keys_for_query(q);
+    recall_family_channel_with_budget(&store, q, &key, RUNTIME_MEMORY_SEARCH_CAP).unwrap()
+}
+#[test]
+fn grip_family_recall_requires_exact_target_and_operation() {
+    let q = query(Some(61), 2201);
+    assert!(recall(record(&q), &q).confidence.raw() > 0.);
+    for other in [query(Some(62), 2201), query(Some(61), 2202)] {
+        let r = recall(record(&q), &other);
+        assert_eq!(r.values, [0.; MEMORY_VALUE_V1_COUNT]);
+        assert_eq!(r.source_count, 0);
+        assert!(!r.category_read);
+    }
+}
