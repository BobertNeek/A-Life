+                let rows = science(
+                    &before,
+                    &after,
+                    &step,
+                    offset,
+                    &bytes,
+                    &b.closure_sha256,
+                    reference,
+                )?;
+                arm_decisions += step.decisions.len() as u64;
+                for row in &step.decisions {
