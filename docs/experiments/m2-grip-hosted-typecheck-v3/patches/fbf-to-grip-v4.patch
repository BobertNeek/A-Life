+//! Fresh coordinated-target host identity and a shared-loop policy strategy.
+//! No old host conversion, reset, imported checkpoint, or gradient entry point.
+use super::*;
+use crate::cpu::{
+    GripOptionsActionV1, GripOptionsScoresV1, GripOptionsSourceV1, GRIP_OPTIONS_POLICY_V1,
+};
+const GRIP_MAGIC: &[u8] = b"ALIFE-GRIP-OPTIONS-M2-HOST\0V1\0IDLE-QUIET\0SOURCE-PAYLOAD\0SYNAPTIC-CLOSED\0PROFILE6\0BITS1\0";
+const GRIP_LINEAGE: &str = "fresh-grip-options-m2-host-v1/class5/no-historical-import";
+const GRIP_RESIDENT: &str = "grip-options-m2-resident-v1";
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(in crate::cpu::host) struct GripOptionsResidentV1 {
+    schema: String,
+    last: Option<GripOptionsSelectionV1>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct GripOptionsSelectionV1 {
+    scores: GripOptionsScoresV1,
+    action: GripOptionsActionV1,
+}
+impl GripOptionsResidentV1 {
+    pub(super) fn fresh() -> Self {
+        Self {
+            schema: GRIP_RESIDENT.into(),
+            last: None,
+        }
+    }
+    pub(super) fn is_fresh(&self) -> bool {
+        self.schema == GRIP_RESIDENT && self.last.is_none()
+    }
+}
+impl GroupedResidentV1 {
+    pub(in crate::cpu::host) fn validate_grip_policy(&self) -> Result<(), CpuHostError> {
+        if self.grip_options.is_some() != true
+            || self
+                .grip_options
+                .as_ref()
+                .is_some_and(|v| v.schema != GRIP_RESIDENT || self.last_action.is_some())
+        {
+            return Err(CpuHostError::State("closed grouped policy owner mismatch"));
+        }
+        if let Some(v) = &self.grip_options {
+            if v.last.is_some() != self.motor.last_receipt.is_some() {
+                return Err(CpuHostError::State("optional Vocal incomplete owner"));
+            }
+        }
+        Ok(())
+    }
+    pub(super) fn grip_sampling_cursor(&self) -> Option<(u32, u32)> {
+        match &self.grip_options {
+            None => self.last_action.as_ref().map(|a| (a.seed, a.counter)),
+            Some(v) => v
+                .last
+                .as_ref()
+                .map(|s| (s.action.seed(), s.action.counter())),
+        }
+    }
+    pub(super) fn grip_physical_selection(
+        &self,
+    ) -> Result<(u16, [Option<u16>; 6], Option<u8>), CpuHostError> {
+        let native = &self
+            .motor
+            .last_receipt
+            .as_ref()
+            .ok_or(CpuHostError::State("missing native proposal"))?
+            .native
+            .scores;
+        if let Some(v) = &self.grip_options {
+            self.validate_grip_policy()?;
+            let last = v
+                .last
+                .as_ref()
+                .ok_or(CpuHostError::State("missing optional Vocal sample"))?;
+            last.scores.validate_native(native)?;
+            let (i, m) = last.scores.physical_selection(&last.action)?;
+            Ok((i, m, last.action.operation()))
+        } else {
+            let a = self
+                .last_action
+                .as_ref()
+                .ok_or(CpuHostError::State("missing legacy grouped sample"))?;
+            let (i, m) = native.physical_selection(a)?;
+            Ok((i, m, a.operation))
+        }
+    }
+    pub(super) fn validate_grip_source(
+        &self,
+        founder: &CpuFoundationTrainer,
+        neural: &CpuOrganismState,
+    ) -> Result<(), CpuHostError> {
+        let Some(v) = &self.grip_options else {
+            return Ok(());
+        };
+        self.validate_grip_policy()?;
+        let Some(last) = &v.last else {
+            return Ok(());
+        };
+        let m = self
+            .motor
+            .last_receipt
+            .as_ref()
+            .ok_or(CpuHostError::State("missing optional native output"))?;
+        let checkpoint = neural.checkpoint()?;
+        let offsets = neural.effective_offsets(founder.phenotype())?;
+        let actual = GripOptionsSourceV1::from_forward(
+            checkpoint.organism_id,
+            m.tick,
+            founder.phenotype().phenotype_hash(),
+            m.frame_digest,
+            checkpoint.dispatch_generation,
+            checkpoint.active_activation_side,
+            &checkpoint.neural.activations,
+            &offsets,
+            decode_cpu_speech(founder, &checkpoint.neural.activations, &offsets)?,
+        )?;
+        last.scores.validate_source(&actual)?;
+        last.scores.validate_native(&m.native.scores)?;
+        Ok(())
+    }
+}
+
+impl GripOptionsResidentV1 {
+    pub(super) fn sampling_cursor(&self) -> Option<(u32, u32)> {
+        self.last
+            .as_ref()
+            .map(|s| (s.action.seed(), s.action.counter()))
+    }
