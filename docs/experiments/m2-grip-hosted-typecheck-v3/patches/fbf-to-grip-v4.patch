+        path(&["source_lineage"]),
+        path(&["policy"]),
+        path(&["canonical", "schema_version"]),
+        path(&["canonical", "residents", "0", "neural", "schema_version"]),
+        path(&[
+            "canonical",
+            "world",
+            "world",
+            "organism_records",
+            "0",
+            "state_graph",
+            "brain",
+            "content_digest",
