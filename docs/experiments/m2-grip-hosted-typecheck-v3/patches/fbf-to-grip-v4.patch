+#[derive(Debug, Clone, Serialize)]
+pub struct GripOptionsFactorV1 {
+    pub outcomes: Vec<GripOptionsChoiceV1>,
+    pub probabilities: Vec<f64>,
+    pub log_probabilities: Vec<f64>,
+}
+impl GripOptionsFactorV1 {
+    fn canonical_idle(index: u16) -> Result<ActionCandidate, TrainingError> {
+        Ok(ActionCandidate::new(
+            index,
+            ActionKind::Idle.canonical_id(),
+            ActionKind::Idle,
+            CandidateActionFamily::Idle,
+            CandidateObservationRef::None,
+            ActionTarget::NONE,
+            CandidateFeatureVector::zero().with_intrinsic_action_basis(ActionKind::Idle),
+            Confidence::new(1.)?,
+            NormalizedScalar::new(0.)?,
+            DurationTicks::new(1),
+            DurationTicks::new(1),
+        )?)
+    }
+    fn from_native(d: RecoveryGroupFactorV2) -> Self {
+        Self {
+            outcomes: d.outcomes.into_iter().map(from_native).collect(),
+            probabilities: d.probabilities,
+            log_probabilities: d.log_probabilities,
+        }
+    }
+    fn new(
+        outcomes: Vec<GripOptionsChoiceV1>,
+        logits: Vec<f64>,
+        t: f64,
+    ) -> Result<Self, TrainingError> {
+        valid_temperature(t)?;
+        if outcomes.len() != logits.len()
+            || logits.is_empty()
+            || logits.iter().any(|x| !x.is_finite() || x.abs() > 1e30)
+        {
+            return Err(invalid());
+        }
+        let max = logits.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+        let sum = logits.iter().map(|x| ((x - max) / t).exp()).sum::<f64>();
+        if !sum.is_finite() || sum <= 0. {
+            return Err(invalid());
+        }
+        let log_probabilities: Vec<_> = logits.iter().map(|x| (x - max) / t - sum.ln()).collect();
+        let probabilities = log_probabilities.iter().map(|x| x.exp()).collect();
+        Ok(Self {
+            outcomes,
+            probabilities,
+            log_probabilities,
+        })
+    }
+    fn sample(&self, u: f64) -> GripOptionsChoiceV1 {
+        let mut sum = 0.;
+        for (&o, p) in self.outcomes.iter().zip(&self.probabilities) {
+            sum += p;
+            if u < sum {
+                return o;
+            }
+        }
+        *self.outcomes.last().expect("validated nonempty factor")
+    }
+    fn logp(&self, o: GripOptionsChoiceV1) -> Result<f64, TrainingError> {
+        self.outcomes
+            .iter()
+            .position(|x| *x == o)
+            .map(|i| self.log_probabilities[i])
+            .ok_or_else(invalid)
+    }
+    pub fn probability(&self, o: GripOptionsChoiceV1) -> f64 {
+        self.outcomes
+            .iter()
+            .position(|x| *x == o)
+            .map_or(0., |i| self.probabilities[i])
+    }
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct GripOptionsProbabilitiesV1 {
+    pub representative: GripOptionsFactorV1,
+    pub channels: [Option<GripOptionsFactorV1>; 6],
+    pub conditional_operation: [f64; 2],
+    pub conditional_log_probability: [Option<f64>; 2],
+    /// Marginal after representative forcing, not merely the independent factor.
+    pub actual_quiet_probability: f64,
+    pub actual_vocal_probability: f64,
+    /// Exact joint move/manipulation factors conditional on each representative.
+    pub coordination: Vec<GripCoordinationPairFactorV1>,
+    pub coordination_mean_features: [f64; 3],
+}
+#[derive(Debug, Clone, Serialize)]
+pub struct GripOptionsEvaluationV1 {
+    pub joint_log_probability: f64,
+    pub joint_probability: f64,
