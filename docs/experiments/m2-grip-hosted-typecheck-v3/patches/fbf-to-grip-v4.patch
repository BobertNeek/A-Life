+pub type CpuCoordinatedTargetM2HostStepV1 = CpuGroupedM2HostStepV1<CoordinatedTargetActionV1>;
+pub type CpuCoordinatedTargetM2HostDecisionV1 =
+    CpuGroupedM2HostDecisionV1<CoordinatedTargetActionV1>;
+pub struct CpuCoordinatedTargetM2HostV1 {
+    inner: CpuGroupedM2HostV1,
+}
+#[derive(Debug, Clone)]
+pub struct CpuCoordinatedTargetM2HostCheckpointV1 {
+    payload: GroupedPayloadV1,
+}
+impl CpuCoordinatedTargetM2HostCheckpointV1 {
+    pub fn encode(&self) -> Result<Vec<u8>, CpuHostError> {
+        let mut bytes = OPTIONAL_MAGIC.to_vec();
+        bytes.extend(serde_json::to_vec(&self.payload)?);
+        Ok(bytes)
+    }
+    pub fn decode(bytes: &[u8]) -> Result<Self, CpuHostError> {
+        let body = bytes
+            .strip_prefix(OPTIONAL_MAGIC)
+            .ok_or(CpuHostError::State("not fresh optional Vocal M2 envelope"))?;
+        let metadata: serde_json::Value = serde_json::from_slice(body)?;
+        // Identity is inspected before decoding source or private acquired state.
+        if metadata["schema_version"] != 1
+            || metadata["source_lineage"] != OPTIONAL_LINEAGE
+            || metadata["policy"] != COORDINATED_TARGET_POLICY_V1
+            || metadata["runtime_profile_raw"] != 5
+            || metadata["selector_tag"] != 12
+            || metadata["decoder_stride"] != 55
+            || metadata["recipe_digest"] != RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256
+            || metadata["canonical"]["schema_version"] != COORDINATED_TARGET_CANONICAL_SCHEMA
+            || !metadata["canonical"]["residents"]
+                .as_array()
+                .is_some_and(|rows| {
+                    !rows.is_empty()
+                        && rows.iter().all(|r| {
+                            r["neural"]["schema_version"]
+                                == crate::cpu::organism::COORDINATED_TARGET_NEURAL_SCHEMA
+                        })
+                })
+        {
+            return Err(CpuHostError::State("optional Vocal outer policy mismatch"));
+        }
+        let mut payload: GroupedPayloadV1 = serde_json::from_value(metadata.clone())?;
+        payload.restore_sampler_bits()?;
+        for state in payload.controllers.values() {
+            state.validate_policy::<CoordinatedTargetPolicy>()?;
+        }
+        if serde_json::from_slice::<serde_json::Value>(&serde_json::to_vec(&payload)?)? != metadata
+        {
+            return Err(CpuHostError::State(
+                "optional Vocal noncanonical nested state",
+            ));
+        }
+        Ok(Self { payload })
+    }
+}
+impl CpuCoordinatedTargetM2HostV1 {
+    pub fn new_prepared<T, E: std::fmt::Display>(
+        game: CanonicalNewGame,
+        founder: CpuFoundationTrainer,
+        source_inputs: PhenotypeCompilerInputs,
+        sampling_seed: u32,
+        mode: MediationModeV1,
+        prepare: impl FnOnce(&mut HeadlessWorld) -> Result<T, E>,
+    ) -> Result<(Self, T), CpuHostError> {
+        let (inner, value) = CpuGroupedM2HostV1::new_prepared_policy::<
+            CoordinatedTargetPolicy,
+            T,
+            E,
+        >(game, founder, source_inputs, sampling_seed, mode, prepare)?;
+        Ok((Self { inner }, value))
+    }
+    pub fn world(&self) -> &HeadlessWorld {
+        self.inner.world()
+    }
+    /// Read-only optional sampling evidence for this organism's last decision.
+    /// The shared motor receipt contains native proposals, not this policy's
+    /// selected-action distribution. Old grouped/PPO evaluation is not valid here.
+    pub fn last_selection_scores(
+        &self,
+        organism: OrganismId,
+    ) -> Option<&CoordinatedTargetScoresV1> {
+        self.inner
+            .host
+            .residents
+            .get(&organism.raw())?
+            .grouped
+            .as_ref()?
+            .optional_vocal
+            .as_ref()?
+            .last
+            .as_ref()
+            .map(|s| &s.scores)
+    }
+    pub fn sleep_state(&self, id: OrganismId) -> Option<alife_core::sleep::SleepState> {
+        self.inner.sleep_state(id)
+    }
+    pub fn checkpoint(&self) -> Result<CpuCoordinatedTargetM2HostCheckpointV1, CpuHostError> {
+        Ok(CpuCoordinatedTargetM2HostCheckpointV1 {
+            payload: self.inner.checkpoint_payload::<CoordinatedTargetPolicy>()?,
+        })
+    }
+    pub fn restore(
+        c: CpuCoordinatedTargetM2HostCheckpointV1,
+        expected_source: &PhenotypeCompilerInputs,
+        mode: MediationModeV1,
+    ) -> Result<Self, CpuHostError> {
+        let wire = c.encode()?;
+        let inner = CpuGroupedM2HostV1::restore_payload::<CoordinatedTargetPolicy>(
+            c.payload,
+            expected_source,
+            mode,
+            wire,
+        )?;
+        Ok(Self { inner })
+    }
+    pub fn step_research_observed(
+        &mut self,
+        temperature: f32,
+    ) -> Result<CpuGroupedM2ResearchStepV1<CoordinatedTargetActionV1>, CpuHostError> {
+        self.inner
+            .host
+            .grouped_policy_step_observed::<CoordinatedTargetPolicy>(
+                &self.inner.founder,
+                temperature,
+            )
+    }
+    pub fn step(
+        &mut self,
+        temperature: f32,
+    ) -> Result<CpuCoordinatedTargetM2HostStepV1, CpuHostError> {
+        self.inner
+            .host
+            .grouped_policy_step::<CoordinatedTargetPolicy>(&self.inner.founder, temperature)
+    }
+    pub fn actor_optimization(&mut self) -> Result<(), CpuHostError> {
