+pub const OPTIONAL_MAGIC: &[u8] = b"ALIFE-COORDINATED-TARGET-M2-HOST\0V1\0IDLE-QUIET\0SOURCE-PAYLOAD\0SYNAPTIC-CLOSED\0PROFILE5\0BITS1\0";
+const LEGACY_LINEAGE: &str = "fresh-grouped-m2-host-v1/confidence-v2/class5/no-historical-import";
+const OPTIONAL_LINEAGE: &str = "fresh-coordinated-target-m2-host-v1/class5/no-historical-import";
+const LEGACY_POLICY: &str = "synaptic-learning-closed;source-once;typed-grouped-sampling;profile5;canonical-memory-predictor-body;no-structural-sleep;one-cognitive-debit;source-logit-regional-arousal;memory-sleep-output-generation-is-cycle-id";
+const OPTIONAL_POLICY: &str = "m2-coordinated-target-v1;closed;idle-mediated-quiet;source-payload-removal;cooldown-physical;no-gradient";
