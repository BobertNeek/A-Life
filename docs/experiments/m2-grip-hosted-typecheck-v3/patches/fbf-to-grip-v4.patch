+//! Versioned profile6 own-grip sensory extension.
+//! The world produces this from its authoritative own-gripper constraint.
+//! Neither visual absence nor another holder's constraint becomes an affordance.
+use crate::{
+    CanonicalDigestBuilder, Confidence, ScaffoldContractError, TrackedObjectId, Validate,
+    MAX_GROUNDED_OBJECT_SLOTS,
+};
+use serde::{Deserialize, Serialize};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum OwnGripRelationV1 {
+    Unknown,
+    NotSelfHeld,
+    SelfHeld,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct OwnGripSlotV1 {
+    pub slot_index: u16,
+    pub relation: OwnGripRelationV1,
+    pub confidence: Confidence,
+}
+/// Kept after old PerceptionFrameDraft.base_digest wire index10. The existing
+/// profiles must omit the entire extension, not serialize null or an empty vec.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct OwnGripSenseV1 {
+    pub schema_version: u16,
+    pub occupied: bool,
+    pub confidence: Confidence,
+    /// Proprioceptively known OWN object identity, not hidden other ownership.
+    /// May be absent while occupied: occupancy does not imply recognition.
+    /// This is transport/binding only; neural rows receive no numeric ID.
+    pub recognized_held_target: Option<TrackedObjectId>,
+    pub slots: Vec<OwnGripSlotV1>,
+}
+impl Validate for OwnGripSenseV1 {
+    fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        if self.schema_version != 1
+            || self.slots.len() > MAX_GROUNDED_OBJECT_SLOTS
+            || (!self.occupied && self.recognized_held_target.is_some())
+        {
+            return Err(ScaffoldContractError::InvalidPerceptionFrame);
+        }
+        Confidence::new(self.confidence.raw())?;
+        if let Some(target) = self.recognized_held_target {
+            target.validate()?;
+        }
+        let mut held = 0;
+        for (i, slot) in self.slots.iter().enumerate() {
+            if usize::from(slot.slot_index) != i {
+                return Err(ScaffoldContractError::InvalidPerceptionFrame);
+            }
+            Confidence::new(slot.confidence.raw())?;
+            if slot.relation == OwnGripRelationV1::SelfHeld {
+                held += 1;
+            }
+            if slot.relation == OwnGripRelationV1::Unknown && slot.confidence.raw() != 0.0 {
+                return Err(ScaffoldContractError::InvalidPerceptionFrame);
+            }
+        }
+        if held > 1 || (held != 0 && !self.occupied) {
+            return Err(ScaffoldContractError::InvalidPerceptionFrame);
+        }
+        Ok(())
+    }
+}
+impl OwnGripSenseV1 {
+    /// Validate against actual grounded tracked identities, not merely count.
+    /// Zero visible slots is valid, including occupied and recognized own hold.
+    pub fn validate_slots(&self, tracks: &[TrackedObjectId]) -> Result<(), ScaffoldContractError> {
+        self.validate_contract()?;
+        if tracks.len() != self.slots.len() {
+            return Err(ScaffoldContractError::InvalidPerceptionFrame);
+        }
+        for (track, slot) in tracks.iter().zip(&self.slots) {
+            track.validate()?;
+            if let Some(held) = self.recognized_held_target {
+                if (slot.relation == OwnGripRelationV1::SelfHeld && *track != held)
+                    || (slot.relation == OwnGripRelationV1::NotSelfHeld && *track == held)
+                {
+                    return Err(ScaffoldContractError::InvalidPerceptionFrame);
+                }
+            }
+        }
+        Ok(())
+    }
+    /// Only the NEW profile's base-digest path invokes this. Old digests unchanged.
+    pub fn append_canonical(
+        &self,
+        digest: &mut CanonicalDigestBuilder,
+    ) -> Result<(), ScaffoldContractError> {
+        self.validate_contract()?;
+        digest.write_bytes(b"alife.own-grip-sense.v1");
+        digest.write_u16(self.schema_version);
+        digest.write_u8(u8::from(self.occupied));
+        digest.write_f32(self.confidence.raw())?;
+        match self.recognized_held_target {
+            Some(target) => {
+                digest.write_some();
+                digest.write_u64(target.raw());
+            }
+            None => digest.write_none(),
+        }
+        digest.write_sequence_len(self.slots.len());
+        for slot in &self.slots {
+            digest.write_u16(slot.slot_index);
+            digest.write_u8(match slot.relation {
+                OwnGripRelationV1::Unknown => 0,
+                OwnGripRelationV1::NotSelfHeld => 1,
+                OwnGripRelationV1::SelfHeld => 2,
+            });
+            digest.write_f32(slot.confidence.raw())?;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn sense() -> OwnGripSenseV1 {
+        OwnGripSenseV1 {
+            schema_version: 1,
+            occupied: true,
+            confidence: Confidence::new(1.0).unwrap(),
+            recognized_held_target: Some(TrackedObjectId(7)),
+            slots: vec![],
+        }
+    }
+    #[test]
+    fn occluded_own_hold_retains_proprioception_without_visual_slots() {
+        let s = sense();
+        assert!(s.validate_slots(&[]).is_ok());
+        assert!(s.occupied);
+    }
+    #[test]
+    fn contradictory_known_target_relation_is_rejected() {
+        let mut s = sense();
+        s.slots.push(OwnGripSlotV1 {
+            slot_index: 0,
+            relation: OwnGripRelationV1::NotSelfHeld,
+            confidence: Confidence::new(1.0).unwrap(),
+        });
+        assert!(s.validate_slots(&[TrackedObjectId(7)]).is_err());
+    }
+    #[test]
+    fn other_holder_is_never_an_exposed_relation() {
+        let mut s = sense();
+        s.occupied = false;
+        s.recognized_held_target = None;
+        s.slots.push(OwnGripSlotV1 {
+            slot_index: 0,
+            relation: OwnGripRelationV1::NotSelfHeld,
+            confidence: Confidence::new(1.0).unwrap(),
+        });
+        assert!(s.validate_slots(&[TrackedObjectId(8)]).is_ok());
+        // The same structure represents free, player-held and other-held targets.
+    }
+    #[test]
+    fn sensory_extension_roundtrips_and_checks_its_version() {
+        let original = sense();
+        let bytes = serde_json::to_vec(&original).unwrap();
+        let mut restored: OwnGripSenseV1 = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(original, restored);
+        restored.schema_version = 2;
+        assert!(restored.validate_contract().is_err());
+    }
+}
