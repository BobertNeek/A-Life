+pub(in crate::cpu::host) struct GripOptionsPolicy;
+impl GroupedPolicyStrategy for GripOptionsPolicy {
+    type Action = GripOptionsActionV1;
+    const OPTIONAL: bool = false;
+    const GRIP: bool = true;
+    const MAGIC: &'static [u8] = GRIP_MAGIC;
+    const LINEAGE: &'static str = GRIP_LINEAGE;
+    const POLICY: &'static str = GRIP_OPTIONS_POLICY_V1;
+    fn select(
+        founder: &CpuFoundationTrainer,
+        r: &mut Resident,
+        frame: &PerceptionFrame,
+        _output: &CpuDecisionOutput,
+        seed: u32,
+        counter: u32,
+        t: f64,
+    ) -> Result<Selection<Self::Action>, CpuHostError> {
+        let source = r.neural.grip_options_source()?.clone();
+        let state = r
+            .grouped
+            .as_mut()
+            .ok_or(CpuHostError::State("missing optional controller"))?;
+        // During the new forward native generation is one ahead of last sample;
+        // use explicit owner checks, not the completed-boundary validator.
+        if state.last_action.is_some()
+            || state
+                .grip_options
+                .as_ref()
+                .is_none_or(|v| v.schema != GRIP_RESIDENT)
+        {
+            return Err(CpuHostError::State("optional sampler owner mismatch"));
+        }
+        let native = &state
+            .motor
+            .last_receipt
+            .as_ref()
+            .ok_or(CpuHostError::State("missing optional scores"))?
+            .native
+            .scores;
