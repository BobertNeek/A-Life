+//! One bounded fresh fixture. Existing old public step output and state must match
+//! observed warm versus ordinary-entry-point cold continuation, at every boundary.
+use super::*;
+const INTERVALS: u64 = 4;
+fn binding(arm: usize, r: &recipe::Recipe, initial: &[u8]) -> Result<journal::Binding> {
+    Ok(journal::Binding {
+        schema: "object-rich-coordinated-target-durable-v1".into(),
+        study_id: "object-rich-coordinated-target-fixed-fixture-v1".into(),
+        arm,
+        mode: mode_name(arm)?.into(),
+        seed: FIXTURE_SEED,
+        sampling_seed: sampling_seed(FIXTURE_SEED),
+        initial_tick: 240,
+        horizon: INTERVALS,
+        temperature_bits: 1_f32.to_bits(),
+        host_source_commit: HOST_COMMIT.into(),
+        host_source_tree: HOST_TREE.into(),
+        driver_source_commit: DRIVER_COMMIT.into(),
+        driver_source_sha256: code_hash(),
+        executable_sha256: executable_hash()?,
+        protocol_sha256: hash(PROTOCOL),
+        qualification_sha256: "fixed-fixture-not-primary".into(),
+        preparation_sha256: hash(b"one 240-tick fresh pre-neural template; no primary seed"),
+        source_manifest_sha256: hash(&serde_json::to_vec(&r.metadata)?),
+        inputs_sha256: hash(&serde_json::to_vec(&r.inputs)?),
+        initial_sha256: hash(initial),
+        initial_matched_sha256: hash(&raw::matched_initial(initial, mode_name(arm)?)?),
+        closure_sha256: closure_hash(initial)?,
+        source_headers: raw::source_headers(initial)?,
+        max_packet_bytes: journal::MAX_PACKET,
+        max_arm_bytes: journal::MAX_ARM_BYTES,
+        min_free_bytes: journal::MIN_FREE_BYTES,
+    })
+}
+fn original_science(rows: &[u8]) -> Result<Vec<u8>> {
+    let mut out = Vec::new();
+    for line in rows.split(|c| *c == b'\n').filter(|l| !l.is_empty()) {
+        let mut v: Value = serde_json::from_slice(line)?;
+        if let Some(decisions) = v["decisions"].as_array_mut() {
+            for d in decisions {
+                d["research_world_receipt"] = Value::Null;
+            }
+        }
+        out.extend(serde_json::to_vec(&v)?);
+        out.push(b'\n');
+    }
+    Ok(out)
+}
+pub fn qualify(out: &Path) -> Result<()> {
+    seed_admission_preflight(FIXTURE_SEED, 1)?;
+    if out.exists() {
+        return Err("fixed qualification directory exists; no retry".into());
+    }
+    fs::create_dir(out)?;
+    write_new(
+        out,
+        "QUALIFICATION_ATTEMPT.json",
+        &json!({"seed":FIXTURE_SEED,"primary_seed_executed":false,"maximum_native_calls":16,"maximum_body_calls":240,"source_candidates":1,"automatic_retry":false,"executable_sha256":executable_hash()?,"driver_code_sha256":code_hash()}),
+    )?;
+    let mut actual = 0;
+    let mut native = 0_u64;
+    let mut max_packet = 0_u64;
+    let mut max_initial = 0_u64;
+    let mut max_science = 0_u64;
+    let mut max_positive_growth = 0_u64;
+    let mut details = Vec::new();
+    let result = (|| -> Result<()> {
+        let r = recipe::build(FIXTURE_SEED, true)?;
+        write_new(out, "SOURCE-CONTRACT.json", &source_contract(&r)?)?;
+        write_new(out, "SOURCE.json", &r.metadata)?;
+        write_new(
+            out,
+            "SOURCE_BOUND_BEFORE_PREPARATION.json",
+            &json!({"genotype":r.metadata["genotype_sha256"],"inputs":r.inputs.canonical_digest(),"native_calls":0,"body_calls":0}),
+        )?;
+        let hosts = fresh_pair(&r, 240, true, &mut actual, out)?;
+        let reference = r
+            .phenotype
+            .cognitive_architecture()
+            .sleep_trigger_threshold();
+        for (arm, mut warm) in hosts.into_iter().enumerate() {
+            let d = out.join(format!("arm-{arm}"));
+            fs::create_dir(&d)?;
+            let initial = cp(&warm)?;
+            max_initial = max_initial.max(initial.len() as u64);
+            journal::publish_artifact(&d, "initial.private.m2", &initial, journal::MAX_PACKET)?;
+            let b = binding(arm, &r, &initial)?;
+            let warm_dir = d.join("warm");
+            let cold_dir = d.join("cold");
+            journal::init_journal(&warm_dir, &b)?;
+            journal::init_journal(&cold_dir, &b)?;
+            let mut warm_previous = hash(&initial);
+            let mut cold_previous = hash(&initial);
+            let mut cold_bytes =
+                journal::bounded_read(&d.join("initial.private.m2"), journal::MAX_PACKET)?;
+            let mut arm_decisions = 0_u64;
+            let mut actual_transfers = 0_u64;
+            let mut previous_warm_size = None;
+            for offset in 0..INTERVALS {
