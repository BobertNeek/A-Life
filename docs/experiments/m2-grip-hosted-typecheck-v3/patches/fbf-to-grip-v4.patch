+/// Exact new-profile operation registry. This never relaxes legacy/M1 rejection.
+pub fn grip_sleep_recovery_operation(
+    c: &crate::ActionCandidate,
+) -> Result<Option<crate::RecoveryOperationV1>, ScaffoldContractError> {
+    use crate::{ActionKind, CandidateActionFamily, CandidateObservationRef};
+    if matches!(c.action_id.raw(), 2201 | 2202) {
+        let family = if c.action_id.raw() == 2201 {
+            CandidateActionFamily::Contact
+        } else {
+            CandidateActionFamily::Other
+        };
+        if c.kind != ActionKind::Interact
+            || c.family != family
+            || (c.observation == CandidateObservationRef::OwnGrip && c.target.position.is_some())
+            || !matches!(
+                c.observation,
+                CandidateObservationRef::ObjectSlot(_) | CandidateObservationRef::OwnGrip
+            )
+            || (matches!(c.observation, CandidateObservationRef::ObjectSlot(_))
+                && c.target.entity.is_none())
+        {
+            return Err(ScaffoldContractError::InvalidActionCandidate);
+        }
+        Ok(None)
+    } else {
+        crate::RecoveryOperationV1::for_candidate(c)
+    }
+}
