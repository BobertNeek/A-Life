+            .validate_native(&state.motor.last_receipt.as_ref().unwrap().native.scores)?;
+        Ok(r.neural
+            .stage_grip_options_closed_selection(p, a, &last.scores, b)?)
+    }
+    fn close(
+        n: &mut CpuOrganismState,
+        f: &CpuFoundationTrainer,
+        p: &ExperiencePatch,
+        r: &NeuralReceptorFrame,
+    ) -> Result<(), CpuHostError> {
+        Ok(n.close_grip_options_outcome(f, p, r)?)
+    }
+}
