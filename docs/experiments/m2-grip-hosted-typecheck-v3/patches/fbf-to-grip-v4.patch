+//! Fresh profile6 source wrapper. Frozen class5 numerical source, separate typed grip ports.
+use crate::*;
+use serde::{Deserialize, Serialize};
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct N2048GroundedGripSleepChoiceV1 {
+    schema_version: u16,
+    source_inputs: Box<PhenotypeCompilerInputs>,
+    recipe_digest: [u64; 4],
+}
+impl Eq for N2048GroundedGripSleepChoiceV1 {}
+impl N2048GroundedGripSleepChoiceV1 {
+    pub const SELECTOR_TAG: u8 = 13;
+    pub fn fresh(source: &PhenotypeCompilerInputs) -> Result<Self, ScaffoldContractError> {
+        // Check the nonrecursive source selector BEFORE recursive validation.
+        if source
+            .foundation_abi()
+            .n2048_grounded_drive_basis()
+            .is_none()
+            || source.sensor_profile() != SensorProfile::GroundedObjectSlotsV1
+            || source.cognitive_channel_extension().is_some()
+            || source.live_policy().is_some()
+            || source.n2048_candidate_asset().is_some()
+            || source.foundation_weight_application().is_some()
+        {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        source.validate_against(&BrainCapacityClass::n2048_grounded_drive_research())?;
+        Ok(Self {
+            schema_version: 1,
+            source_inputs: Box::new(source.clone()),
+            recipe_digest: Self::recipe_digest(),
+        })
+    }
+    pub fn source_inputs(&self) -> &PhenotypeCompilerInputs {
+        &self.source_inputs
+    }
+    pub fn compiler_inputs(&self) -> Result<PhenotypeCompilerInputs, ScaffoldContractError> {
+        self.validate_against(
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+            SensorProfile::GroundedGripSleepChoiceV1,
+        )?;
+        PhenotypeCompilerInputs::try_new_with_foundation_selection(
+            self.source_inputs.genome().clone(),
+            &BrainCapacityClass::n2048_grounded_drive_research(),
+            self.source_inputs.development().clone(),
+            SensorProfile::GroundedGripSleepChoiceV1,
+            FoundationAbiSelection::N2048GroundedGripSleepChoiceV1(self.clone()),
+        )
+    }
+    pub(crate) fn validate_inputs(
+        &self,
+        inputs: &PhenotypeCompilerInputs,
+    ) -> Result<(), ScaffoldContractError> {
+        if inputs.genome() != self.source_inputs.genome()
+            || inputs.development() != self.source_inputs.development()
+            || inputs.cognitive_channel_extension().is_some()
+            || inputs.live_policy().is_some()
+            || inputs.n2048_candidate_asset().is_some()
+            || inputs.foundation_weight_application().is_some()
+        {
+            return Err(ScaffoldContractError::PhenotypeCompile);
+        }
+        Ok(())
+    }
+    pub(crate) fn validate_against(
+        &self,
+        capacity: &BrainCapacityClass,
+        profile: SensorProfile,
