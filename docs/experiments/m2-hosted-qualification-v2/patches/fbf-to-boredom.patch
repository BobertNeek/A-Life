+#[test]
+fn boredom_low_high_and_urgency_recovery_use_real_receptor_projection() {
+    let mut e = fresh(MediationModeV1::Full, M2BoredomControlV1::Full);
+    for signal in [0., 0.5, 1.] {
+        let low = frame(drives(0.1), true);
+        let high = frame(drives(0.6), true);
+        let r = receptors(high.tick(), signal);
+        let lo = synthetic(&mut e, &low, &r);
+        let hi = synthetic(&mut e, &high, &r);
+        let p = high.candidates().len() - 1;
+        assert_eq!(lo.components[p][4].to_bits(), 0f32.to_bits());
+        assert!(hi.components[p][4] > 0.);
+        assert!(hi.core_logits[p] > lo.core_logits[p]);
+        let pair = e.play.activations;
+        for axis in [1, 2, 3, 7, 6] {
+            let mut urgent = drives(0.6);
+            match axis {
+                1 => urgent.fatigue = 1.,
+                2 => urgent.fear = 1.,
+                3 => urgent.pain = 1.,
+                7 => urgent.temperature_stress = 1.,
+                6 => urgent.brain_atp = 0.,
+                _ => unreachable!(),
+            }
+            let f = frame(urgent, true);
+            let inhibited = synthetic(&mut e, &f, &r);
+            assert_eq!(inhibited.components[p][4].to_bits(), 0f32.to_bits());
+            assert_eq!(inhibited.raw_drives[9].to_bits(), 0.6f32.to_bits());
+            assert_eq!(
+                inhibited.positive_opponents[9].to_bits(),
+                hi.positive_opponents[9].to_bits()
+            );
+            let recovered = synthetic(&mut e, &high, &r);
+            assert_eq!(e.play.activations.map(f32::to_bits), pair.map(f32::to_bits));
+            assert_eq!(
+                recovered.components[p][4].to_bits(),
+                hi.components[p][4].to_bits()
+            );
+        }
+        let mut hunger = drives(0.6);
+        hunger.hunger = 1.;
+        hunger.curiosity = 1.; // Distinct curiosity axis does not replace boredom.
+        let h = synthetic(&mut e, &frame(hunger, true), &r);
+        assert_eq!(h.components[p][4].to_bits(), hi.components[p][4].to_bits());
+        assert_eq!(e.play.activations.map(f32::to_bits), pair.map(f32::to_bits));
+    }
+}
