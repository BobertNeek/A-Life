+#[test]
+fn boredom_only_exact_play_changes_noop_vocal_grab_and_other_bits() {
+    let f = frame(drives(0.8), true);
+    let r = receptors(f.tick(), 0.5);
+    let mut full = fresh(MediationModeV1::Full, M2BoredomControlV1::Full);
+    let mut sham = fresh(
+        MediationModeV1::Full,
+        M2BoredomControlV1::EqualWorkReadoutSham,
+    );
+    let a = synthetic(&mut full, &f, &r);
+    let b = synthetic(&mut sham, &f, &r);
+    assert_eq!(full.play.activations, sham.play.activations);
+    for i in 0..f.candidates().len() - 1 {
+        assert_eq!(
+            a.components[i].map(f32::to_bits),
+            b.components[i].map(f32::to_bits)
+        );
+        assert_eq!(a.core_logits[i].to_bits(), b.core_logits[i].to_bits());
+    }
+    let absent = frame(drives(0.8), false);
+    let absent_a = synthetic(&mut full, &absent, &r);
+    assert_eq!(
+        absent_a.core_logits,
+        a.core_logits[..a.core_logits.len() - 1]
+    );
+    let mut ds = fresh(MediationModeV1::DriveSham, M2BoredomControlV1::Full);
+    let d = synthetic(&mut ds, &f, &r);
+    assert_eq!(d.components.last().unwrap()[4].to_bits(), 0f32.to_bits());
+}
