+#[test]
+fn boredom_exact_target_provenance_and_malformed_play_fail_before_source() {
+    let mut e = fresh(MediationModeV1::Full, M2BoredomControlV1::Full);
+    let f = frame(drives(0.8), true);
+    let r = receptors(f.tick(), 0.);
+    let t = tick(&e, &f, &r);
+    let rows = e.bind_rows(&f, &t).unwrap();
+    let before = serde_json::to_vec(&e.snapshot().unwrap()).unwrap();
+    let bindings = play_bindings(&f).unwrap();
+    assert_eq!(bindings.len(), 1);
+    assert_eq!(bindings[0].tracked_object_id, TrackedObjectId(41));
+    assert_eq!(bindings[0].target, f.candidates().last().unwrap().target);
+    for (kind, family) in [
+        (ActionKind::Vocalize, CandidateActionFamily::Other),
+        (ActionKind::Interact, CandidateActionFamily::Contact),
+    ] {
+        let mut cs = f.candidates().to_vec();
+        let last = cs.last_mut().unwrap();
+        last.kind = kind;
+        last.family = family;
+        let bad = rebuild(drives(0.8), cs, vec![slot()]);
+        assert!(e.bind_rows(&bad, &tick(&e, &bad, &r)).is_err());
+    }
+    let mut cs = f.candidates().to_vec();
+    let n = cs.len() - 1;
+    cs[n] = candidate(
+        n,
+        213,
+        ActionKind::Idle,
+        CandidateActionFamily::Idle,
+        CandidateObservationRef::None,
+        ActionTarget::NONE,
+        CandidateFeatureVector::zero().with_intrinsic_action_basis(ActionKind::Idle),
+    );
+    assert!(play_bindings(&rebuild(drives(0.8), cs, vec![slot()])).is_err());
+    let legacy = PerceptionFrame::new(
+        f.organism_id(),
+        f.tick(),
+        SensorProfile::GroundedObjectSlotsV1,
+        f.sensory().clone(),
+        f.body(),
+        *f.homeostasis(),
+        f.candidates()
+            .iter()
+            .filter(|c| c.action_id != ActionId(700))
+            .cloned()
+            .enumerate()
+            .map(|(i, mut c)| {
+                c.candidate_index = i as u16;
+                c
+            })
+            .collect(),
+        SensorProfileProvenance::new(
+            SensorProfile::GroundedObjectSlotsV1,
+            SensoryAbiVersion::CURRENT,
+            f.tick(),
+        )
+        .unwrap(),
+        vec![slot()],
+    )
+    .unwrap();
+    assert!(play_bindings(&legacy).is_err());
+    let mut cs = f.candidates().to_vec();
+    for c in &mut cs {
+        if matches!(c.observation, CandidateObservationRef::ObjectSlot(_)) {
+            c.target.entity = Some(WorldEntityId(11));
+        }
+    }
+    let changed = rebuild(drives(0.8), cs, vec![slot()]);
+    let t2 = tick(&e, &changed, &r);
+    assert!(e
+        .step(
+            &changed,
+            t2,
+            &rows,
+            &r,
+            (1 << rows.len()) - 1,
+            [true; 6],
+            u64::MAX
+        )
+        .is_err());
+    assert_eq!(serde_json::to_vec(&e.snapshot().unwrap()).unwrap(), before);
+    let mut rs = r.clone();
+    rs.source_tick = Tick::new(2);
+    assert!(e
+        .step(
+            &f,
+            t.clone(),
+            &rows,
+            &rs,
+            (1 << rows.len()) - 1,
+            [true; 6],
+            u64::MAX
+        )
+        .is_err());
+    assert!(e
+        .step(&f, t, &rows, &r, (1 << rows.len()) - 1, [true; 6], 0)
+        .is_err());
+    assert_eq!(serde_json::to_vec(&e.snapshot().unwrap()).unwrap(), before);
+}
