@@ -0,0 +1,481 @@
+//! Opt-in SOURCE-ONLY M2 Play route. No world host or acquired-state migration.
+//! The extra native pair is inserted before the existing bounded D proposal port.
+use super::*;
+
+pub const M2_BOREDOM_RECIPE_SHA256: &str =
+    "65a9de085b1b7bfa4c979358dd8723fc0f0edc36a975955a8f3456b3b71a4bfe";
+const RECIPE: &str =
+    include_str!("../../../../../../docs/experiments/m2-boredom-routing-v1/recipe.json");
+const SCHEMA: &str = "detached-m2-boredom-play-v1-not-a-world-host";
+pub(in crate::cpu::motor_mediation) const CORE_SCHEMA: &str = "detached-m2-boredom-play-core-v1";
+pub(in crate::cpu::motor_mediation) const GROUP_SCHEMA: &str = "detached-m2-boredom-play-group-v1";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum M2BoredomControlV1 {
+    Full,
+    EqualWorkReadoutSham,
+}
+
+/// Fixed semantic work in every mode, including all absent candidate slots.
+/// Constants/validation, binding, derivative diagnostics and serialization are
+/// unpriced bookkeeping, as in detached M2. This is not a host ATP debit.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct M2BoredomWorkV1 {
+    pub phases: u64,
+    pub neuron_updates: u64,
+    pub assignments: u64,
+    pub branches: u64,
+    pub branch_inputs: u64,
+    pub drive_products: u64,
+}
+impl M2BoredomWorkV1 {
+    pub const EXPECTED: Self = Self {
+        phases: 1,
+        neuron_updates: 2,
+        assignments: 2,
+        branches: 2,
+        branch_inputs: 24,
+        drive_products: 64,
+    };
+    // Private: only the small fixed EXPECTED or measured counters call this.
+    pub(in crate::cpu::motor_mediation) fn cost_q24(self) -> u64 {
+        self.neuron_updates * 32
+            + self.assignments * 4
+            + self.branches * 16
+            + self.branch_inputs * 4
+            + self.drive_products * 4
+    }
+}
+
+#[derive(Deserialize)]
+struct PlayRecipe {
+    nodes: [Node; 2],
+    branches: Vec<Branch>,
+    play_readout: [f32; 2],
+}
+struct PlayLowered {
+    recipe: PlayRecipe,
+    branches: DendriticBranchSet,
+}
+impl PlayLowered {
+    fn pinned(bytes: &str) -> Result<Self, TrainingError> {
+        if format!("{:x}", Sha256::digest(bytes.as_bytes())) != M2_BOREDOM_RECIPE_SHA256 {
+            return Err(invalid());
+        }
+        let recipe: PlayRecipe = serde_json::from_str(bytes).map_err(|_| invalid())?;
+        if recipe
+            .nodes
+            .iter()
+            .enumerate()
+            .any(|(i, n)| n.id != 2508 + i || n.phase != 7)
+            || recipe.branches.len() != 2
+            || recipe.play_readout != [0.25, -0.25]
+            || recipe.branches.iter().enumerate().any(|(i, b)| {
+                b.target != 2508 + i as u32
+                    || b.inputs.len() != 12
+                    || b.inputs.iter().any(|(s, _)| !(2048..2108).contains(s))
+            })
+        {
+            return Err(invalid());
+        }
+        let branches = DendriticBranchSet::new(
+            recipe
+                .branches
+                .iter()
+                .map(|b| {
+                    DendriticBranch::new(
+                        b.target - START as u32,
+                        b.threshold,
+                        b.gain,
+                        b.inputs
+                            .iter()
+                            .map(|&(s, w)| DendriticInputRef::new(s - START as u32, w))
+                            .collect::<Result<Vec<_>, _>>()?,
+                    )
+                })
+                .collect::<Result<Vec<_>, ScaffoldContractError>>()?,
+        )?;
+        branches.validate_for_neuron_count(462)?;
+        Ok(Self { recipe, branches })
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct PlayBanks {
+    activations: [f32; 2],
+    ema: [f32; 2],
+    metabolic: [f32; 2],
+}
+impl PlayBanks {
+    fn zero() -> Self {
+        Self {
+            activations: [0.; 2],
+            ema: [0.; 2],
+            metabolic: [0.; 2],
+        }
+    }
+    fn validate(&self) -> Result<(), TrainingError> {
+        // Identity soma: offset - threshold + projection * branch in [-8,12]
+        // under the declared modulation envelope; no accumulated carry (leak1).
+        if self
+            .activations
+            .iter()
+            .any(|x| !x.is_finite() || !(-8. ..=12.).contains(x))
+        {
+            return Err(invalid());
+        }
+        if self
+            .ema
+            .iter()
+            .chain(&self.metabolic)
+            .any(|x| !x.is_finite() || !(0. ..=1.).contains(x))
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
+
+/// This is observed candidate provenance, not a claim of physical toy legality.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct M2PlayBindingV1 {
+    pub candidate_index: usize,
+    pub action_id: ActionId,
+    pub target: ActionTarget,
+    pub observation: CandidateObservationRef,
+    pub tracked_object_id: TrackedObjectId,
+    pub feature_digest: CandidateFeatureDigest,
+}
+fn play_bindings(frame: &PerceptionFrame) -> Result<Vec<M2PlayBindingV1>, TrainingError> {
+    // Validates frame/profile, features, canonical slot order, target presence,
+    // per-slot exact target consistency and entity-to-slot uniqueness.
+    prepare_sleep_choice_grounded_drive_features_v1(frame)?;
+    let mut result = vec![];
+    for (i, c) in frame.candidates().iter().enumerate() {
+        if c.action_id != ActionId(213) {
+            continue;
+        }
+        let CandidateObservationRef::ObjectSlot(slot) = c.observation else {
+            return Err(invalid());
+        };
+        if c.kind != ActionKind::Interact
+            || c.family != CandidateActionFamily::Other
+            || c.target.entity.is_none()
+            || c.target.position.is_none()
+        {
+            return Err(invalid());
+        }
+        c.target.validate()?;
+        let observed = frame
+            .grounded_object_slots()
+            .get(usize::from(slot))
+            .ok_or_else(invalid)?;
+        if observed.slot_index != slot || observed.candidate_features()? != c.features {
+            return Err(invalid());
+        }
+        result.push(M2PlayBindingV1 {
+            candidate_index: i,
+            action_id: c.action_id,
+            target: c.target,
+            observation: c.observation,
+            tracked_object_id: observed.tracked_object_id,
+            feature_digest: c.feature_digest()?,
+        });
+    }
+    Ok(result)
+}
+
+/// Private borrowed appendage only: cannot own or execute the source.
+pub(in crate::cpu::motor_mediation) struct BoredomRunV1<'a> {
+    recipe: &'a PlayLowered,
+    banks: &'a mut PlayBanks,
+    gates: [f32; SLOTS],
+    control: M2BoredomControlV1,
+    work: M2BoredomWorkV1,
+}
+impl BoredomRunV1<'_> {
+    pub(in crate::cpu::motor_mediation) fn forward(
+        &mut self,
+        opponents: &[f32],
+        m: MediationModulationV1,
+    ) -> Result<[f32; SLOTS], TrainingError> {
+        if opponents.len() != ADDED || self.work != M2BoredomWorkV1::default() {
+            return Err(invalid());
+        }
+        m.validate()?;
+        finite(opponents)?;
+        self.banks.validate()?;
+        let previous = self.banks.clone();
+        self.work.phases += 1;
+        for (i, node) in self.recipe.recipe.nodes.iter().enumerate() {
+            let b = &self.recipe.branches.branches()[i];
+            let dendritic = native_kernel::dendritic_activation(opponents, b);
+            let result = native_kernel::neuron_step(
+                &node.dynamics,
+                CellState {
+                    activation: previous.activations[i],
+                    ema: previous.ema[i],
+                    metabolic: previous.metabolic[i],
+                },
+                m.offset,
+                0.,
+                dendritic,
+                m.projection_gain,
+                m.threshold,
+            );
+            self.banks.activations[i] = result.state.activation;
+            self.banks.ema[i] = result.state.ema;
+            self.banks.metabolic[i] = result.state.metabolic;
+            self.work.neuron_updates += 1;
+            self.work.assignments += 1;
+            self.work.branches += 1;
+            self.work.branch_inputs += b.inputs.len() as u64;
+        }
+        self.banks.validate()?;
+        let mut readouts = [0.; SLOTS];
+        let enabled = f32::from(self.control == M2BoredomControlV1::Full);
+        for (slot, value) in readouts.iter_mut().enumerate() {
+            for (cell, weight) in self.recipe.recipe.play_readout.iter().enumerate() {
+                *value += self.banks.activations[cell] * (self.gates[slot] * enabled * weight);
+                self.work.drive_products += 1;
+            }
+        }
+        finite(&readouts)?;
+        if self.work != M2BoredomWorkV1::EXPECTED {
+            return Err(invalid());
+        }
+        Ok(readouts)
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct M2BoredomSnapshotV1 {
+    schema: String,
+    recipe: String,
+    mode: MediationModeV1,
+    control: M2BoredomControlV1,
+    generation: u64,
+    // New inner schemas as well: unwrapping does not admit this to old restores.
+    group_json: String,
+    play: PlayBanks,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct M2BoredomReceiptV1 {
+    pub schema: String,
+    pub recipe: String,
+    pub mode: MediationModeV1,
+    pub control: M2BoredomControlV1,
+    pub frame_digest: PerceptionFrameDigest,
+    pub core: MediationReceiptV1,
+    pub group_components: [f32; 5],
+    pub group_activations: [f32; 16],
+    pub group_logit: f64,
+    pub operation_logits: [f64; 2],
+    pub group_arithmetic_q24: u64,
+    pub group_source_products: u64,
+    pub play_bindings: Vec<M2PlayBindingV1>,
+    pub play_activations: [f32; 2],
+    pub play_work: M2BoredomWorkV1,
+    pub total_arithmetic_reservation_q24: u64,
+}
+pub struct M2BoredomProbeResultV1 {
+    pub source_evaluation: TrainingReplayEvaluation,
+    pub receipt: M2BoredomReceiptV1,
+    // No exposed sampler, old-policy action, gradient or update API until a
+    // separate policy identity and world admission are qualified. The internal
+    // old group binding is used only for shared arithmetic and is not exported.
+}
+pub struct M2BoredomDetachedCpuV1 {
+    group: RecoveryGroupDetachedCpuV2,
+    recipe: PlayLowered,
+    mode: MediationModeV1,
+    control: M2BoredomControlV1,
+    play: PlayBanks,
+}
+impl M2BoredomDetachedCpuV1 {
+    pub fn fresh(
+        inputs: &PhenotypeCompilerInputs,
+        asset: &FoundationWeightAsset,
+        mode: MediationModeV1,
+        control: M2BoredomControlV1,
+    ) -> Result<Self, TrainingError> {
+        // Existing fresh admission still requires genetic source, exact 2048 /
+        // 34048 capacity and no M0. It rejects DirectSource. No imported banks.
+        let mut group = RecoveryGroupDetachedCpuV2::fresh(inputs, asset, mode)?;
+        group.core.state.schema = CORE_SCHEMA.into();
+        group.core.state.recipe = M2_BOREDOM_RECIPE_SHA256.into();
+        group.state.schema = GROUP_SCHEMA.into();
+        group.state.recipe = M2_BOREDOM_RECIPE_SHA256.into();
+        group.state.core_json =
+            serde_json::to_string(&group.core.snapshot()).map_err(|_| invalid())?;
+        Ok(Self {
+            group,
+            recipe: PlayLowered::pinned(RECIPE)?,
+            mode,
+            control,
+            play: PlayBanks::zero(),
+        })
+    }
+    pub fn source(&self) -> &BrainPhenotype {
+        self.group.source()
+    }
+    pub fn source_state(&self) -> &TrainingInitialState {
+        self.group.source_state()
+    }
+    pub fn bind_rows(
+        &self,
+        frame: &PerceptionFrame,
+        tick: &TrainingReplayTick,
+    ) -> Result<Vec<MediationRowV1>, TrainingError> {
+        play_bindings(frame)?;
+        self.group.bind_rows(frame, tick)
+    }
+    pub fn snapshot(&self) -> Result<M2BoredomSnapshotV1, TrainingError> {
+        Ok(M2BoredomSnapshotV1 {
+            schema: SCHEMA.into(),
+            recipe: M2_BOREDOM_RECIPE_SHA256.into(),
+            mode: self.mode,
+            control: self.control,
+            generation: self.group.core.state.generation,
+            group_json: serde_json::to_string(&self.group.snapshot()).map_err(|_| invalid())?,
+            play: self.play.clone(),
+        })
+    }
+    pub fn restore(
+        inputs: &PhenotypeCompilerInputs,
+        asset: &FoundationWeightAsset,
+        mode: MediationModeV1,
+        control: M2BoredomControlV1,
+        snapshot: M2BoredomSnapshotV1,
+    ) -> Result<Self, TrainingError> {
+        if snapshot.schema != SCHEMA
+            || snapshot.recipe != M2_BOREDOM_RECIPE_SHA256
+            || snapshot.mode != mode
+            || snapshot.control != control
+        {
+            return Err(invalid());
+        }
+        snapshot.play.validate()?;
+        let state: RecoveryGroupSnapshotV2 =
+            serde_json::from_str(&snapshot.group_json).map_err(|_| invalid())?;
+        if state.schema != GROUP_SCHEMA || state.recipe != M2_BOREDOM_RECIPE_SHA256 {
+            return Err(invalid());
+        }
+        for (bank, bounded) in [
+            (&state.activations, false),
+            (&state.ema, true),
+            (&state.metabolic, true),
+        ] {
+            if bank
+                .iter()
+                .any(|x| !x.is_finite() || (bounded && !(0. ..=1.).contains(x)))
+            {
+                return Err(invalid());
+            }
+        }
+        let core: MediationDetachedSnapshotV1 =
+            serde_json::from_str(&state.core_json).map_err(|_| invalid())?;
+        if core.generation != snapshot.generation {
+            return Err(invalid());
+        }
+        let mut fresh = Self::fresh(inputs, asset, mode, control)?;
+        // Shared validation still checks exact schema, recipe, source hash/asset,
+        // mode, dendrites and every bank's bounds. No old-envelope retagging.
+        fresh.group.core = MediationDetachedCpuV1::restore_into(fresh.group.core, core)?;
+        fresh.group.state = state;
+        fresh.play = snapshot.play;
+        Ok(fresh)
+    }
+    #[allow(clippy::too_many_arguments)]
+    pub fn step(
+        &mut self,
+        frame: &PerceptionFrame,
+        tick: TrainingReplayTick,
+        rows: &[MediationRowV1],
+        receptors: &NeuralReceptorFrame,
+        attempt_mask: u32,
+        available_effectors: [bool; 6],
+        available_arithmetic_q24: u64,
+    ) -> Result<M2BoredomProbeResultV1, TrainingError> {
+        receptors.validate_contract()?;
+        if receptors.source_tick != frame.tick() {
+            return Err(invalid());
+        }
+        let effects = NeuralReceptorEffects::from_frame(
+            receptors,
+            &NeuralReceptorPhenotype::compile(self.source())?,
+        )?;
+        let m = MediationModulationV1 {
+            interoceptive_gain: effects.interoceptive_gain,
+            regional_gain: effects.regional_excitability,
+            projection_gain: effects.projection_gain,
+            threshold: effects.local_threshold_shift,
+            offset: ((effects.structural_growth_gate
+                + effects.sleep_gate
+                + effects.consolidation_gate)
+                / 3.
+                - 0.5)
+                * 0.05,
+        };
+        m.validate()?;
+        let bindings = play_bindings(frame)?;
+        let mut gates = [0.; SLOTS];
+        for b in &bindings {
+            gates[b.candidate_index] = 1.;
+        }
+        // Entire extra bank is staged. Group step already rolls the source back
+        // on any late error, and publishes group banks only after all checks.
+        let mut next = self.play.clone();
+        let mut run = BoredomRunV1 {
+            recipe: &self.recipe,
+            banks: &mut next,
+            gates,
+            control: self.control,
+            work: M2BoredomWorkV1::default(),
+        };
+        let result = self.group.step_with_boredom(
+            frame,
+            tick,
+            rows,
+            m,
+            attempt_mask,
+            available_effectors,
+            available_arithmetic_q24,
+            Some(&mut run),
+        )?;
+        let work = run.work;
+        // Preflight reservation in the group already checked this same sum.
+        let total = result.receipt.core.detached_arithmetic_reservation_q24
+            + result.receipt.extension_arithmetic_q24;
+        self.play = next;
+        Ok(M2BoredomProbeResultV1 {
+            source_evaluation: result.source_evaluation,
+            receipt: M2BoredomReceiptV1 {
+                schema: SCHEMA.into(),
+                recipe: M2_BOREDOM_RECIPE_SHA256.into(),
+                mode: self.mode,
+                control: self.control,
+                frame_digest: frame.frame_digest(),
+                group_components: result.receipt.group_components,
+                group_activations: result.receipt.extension_activations,
+                group_logit: result.receipt.scores.group,
+                operation_logits: result.receipt.scores.operations,
+                group_arithmetic_q24: result.receipt.extension_arithmetic_q24,
+                group_source_products: result.receipt.extension_source_products,
+                core: result.receipt.core,
+                play_bindings: bindings,
+                play_activations: self.play.activations,
+                play_work: work,
+                total_arithmetic_reservation_q24: total,
+            },
+        })
+    }
+}
