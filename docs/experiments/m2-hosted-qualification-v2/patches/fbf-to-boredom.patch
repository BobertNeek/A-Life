+#[test]
+fn boredom_recipe_native_counts_and_signed_zero_are_closed() {
+    let r = PlayLowered::pinned(RECIPE).unwrap();
+    assert_eq!(r.recipe.nodes[0].id, 2508);
+    assert_eq!(r.recipe.nodes[1].id, 2509);
+    assert_eq!(
+        r.branches
+            .branches()
+            .iter()
+            .map(|b| b.inputs.len())
+            .sum::<usize>(),
+        24
+    );
+    assert!(PlayLowered::pinned(&(RECIPE.to_owned() + " ")).is_err());
+    let mut e = fresh(MediationModeV1::Full, M2BoredomControlV1::Full);
+    for z in [0., -0.] {
+        let f = frame(drives(z), true);
+        let r = receptors(f.tick(), 0.);
+        let out = synthetic(&mut e, &f, &r);
+        assert_eq!(out.components.last().unwrap()[4].to_bits(), 0f32.to_bits());
+        assert_eq!(
+            e.play.activations[0].to_bits(),
+            e.play.activations[1].to_bits()
+        );
+        assert!(out
+            .core_logits
+            .iter()
+            .all(|x| x.is_finite() && x.abs() <= 4.));
+    }
+    let (i, a) = super::super::tests::source();
+    let mut bad = e.snapshot().unwrap();
+    bad.play.activations[0] = f32::NAN;
+    assert!(M2BoredomDetachedCpuV1::restore(&i, &a, e.mode, e.control, bad).is_err());
+    let mut bad = e.snapshot().unwrap();
+    bad.play.activations[0] = 12.01;
+    assert!(M2BoredomDetachedCpuV1::restore(&i, &a, e.mode, e.control, bad).is_err());
+}
