+        );
+        let a = run(&mut full, &f, &r);
+        let b = run(&mut sham, &f, &r);
+        assert_eq!(a.receipt.play_work, b.receipt.play_work);
+        assert_eq!(
+            a.receipt.total_arithmetic_reservation_q24,
+            b.receipt.total_arithmetic_reservation_q24
+        );
+        assert_eq!(
+            eval_bits(&a.source_evaluation),
+            eval_bits(&b.source_evaluation)
+        );
+        assert_eq!(full.group.core.state.source, sham.group.core.state.source);
+        assert_eq!(full.play, sham.play);
+        let (i, weights) = super::super::tests::source();
+        let mut cold = M2BoredomDetachedCpuV1::restore(
+            &i,
+            &weights,
+            full.mode,
+            full.control,
+            full.snapshot().unwrap(),
+        )
+        .unwrap();
+        let warm = run(&mut full, &f, &r);
+        let resumed = run(&mut cold, &f, &r);
+        assert_eq!(
+            serde_json::to_vec(&warm.receipt).unwrap(),
+            serde_json::to_vec(&resumed.receipt).unwrap()
+        );
+        assert_eq!(full.snapshot().unwrap(), cold.snapshot().unwrap());
+    }
+}
