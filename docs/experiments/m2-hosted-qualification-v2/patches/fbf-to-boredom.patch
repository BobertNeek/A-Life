+//! Authored synthetic/detached gates. These are NOT world-life/learning tests.
+//! No result is claimed until compiled and run on an approved build lane.
+use super::*;
+
+fn fresh(mode: MediationModeV1, control: M2BoredomControlV1) -> M2BoredomDetachedCpuV1 {
+    let (i, a) = super::super::tests::source();
+    M2BoredomDetachedCpuV1::fresh(&i, &a, mode, control).unwrap()
+}
+fn drives(boredom: f32) -> DriveSnapshot {
+    DriveSnapshot {
+        hunger: 0.35,
+        fatigue: 0.35,
+        fear: 0.25,
+        pain: 0.10,
+        loneliness: 0.35,
+        curiosity: 0.35,
+        brain_atp: 0.75,
+        temperature_stress: 0.10,
+        reproductive_drive: 0.50,
+        extension: [boredom, 0.],
+    }
+}
+fn slot() -> GroundedObjectSlotV1 {
+    GroundedObjectSlotV1 {
+        slot_index: 0,
+        tracked_object_id: TrackedObjectId(41),
+        bearing: [0.; 2],
+        distance: 0.1,
+        relative_velocity: [0.; 3],
+        color: [0.; 3],
+        material: [0.; 3],
+        shape: [0.; 3],
+        chemical: [0.; 3],
+        contact: 0.,
+        proprioception: [0.; 2],
+        temperature: 0.,
+        terrain: [0.; 2],
+        confidence: Confidence::new(1.).unwrap(),
+    }
+}
+#[allow(clippy::too_many_arguments)]
+fn candidate(
+    i: usize,
+    id: u32,
+    kind: ActionKind,
+    family: CandidateActionFamily,
+    observation: CandidateObservationRef,
+    target: ActionTarget,
+    features: CandidateFeatureVector,
+) -> ActionCandidate {
+    ActionCandidate::new(
+        i as u16,
+        ActionId(id),
+        kind,
+        family,
+        observation,
+        target,
+        features,
+        Confidence::new(1.).unwrap(),
+        NormalizedScalar::new(0.).unwrap(),
+        DurationTicks::new(1),
+        DurationTicks::new(1),
+    )
+    .unwrap()
+}
+fn rebuild(
+    d: DriveSnapshot,
+    candidates: Vec<ActionCandidate>,
+    slots: Vec<GroundedObjectSlotV1>,
+) -> PerceptionFrame {
+    let t = Tick::new(1);
+    let profile = SensorProfile::GroundedObjectSlotsSleepChoiceV1;
+    let mut h = HomeostaticSnapshot::baseline(t);
+    h.drives = d;
+    h.hormones.sleep_pressure = 0.6;
+    PerceptionFrame::new(
+        OrganismId(1),
+        t,
+        profile,
+        SensorySnapshot::new(
+            OrganismId(1),
+            t,
+            Vec3f::ZERO,
+            SensoryChannels::ZERO,
+            Default::default(),
+        )
+        .unwrap(),
+        BodySnapshot {
+            pose: Pose::IDENTITY,
+            velocity: Velocity::ZERO,
+        },
+        h,
+        candidates,
+        SensorProfileProvenance::new(profile, SensoryAbiVersion::CURRENT, t).unwrap(),
+        slots,
+    )
+    .unwrap()
+}
+fn frame(d: DriveSnapshot, include_play: bool) -> PerceptionFrame {
+    let specs = [
+        (1, ActionKind::Idle, CandidateActionFamily::Idle),
+        (3, ActionKind::Rest, CandidateActionFamily::Rest),
+        (400, ActionKind::Vocalize, CandidateActionFamily::Other),
+        (103, ActionKind::Move, CandidateActionFamily::Approach),
+        (212, ActionKind::Interact, CandidateActionFamily::Contact),
+        (104, ActionKind::Hold, CandidateActionFamily::Other),
+        (700, ActionKind::Rest, CandidateActionFamily::Rest),
+    ];
+    let mut cs: Vec<_> = specs
+        .into_iter()
+        .enumerate()
+        .map(|(i, (id, k, f))| {
+            candidate(
+                i,
+                id,
+                k,
+                f,
+                CandidateObservationRef::None,
+                ActionTarget::NONE,
+                CandidateFeatureVector::zero().with_intrinsic_action_basis(k),
+            )
+        })
+        .collect();
+    let s = slot();
+    let target = ActionTarget::new(Some(WorldEntityId(10)), Some(Vec3f::ZERO));
+    // GRAB is also the same-target release primitive in the real dispatcher.
+    // Here this is candidate isolation only, not a physical release receipt.
+    for (id, k, f) in [
+        (211, ActionKind::Interact, CandidateActionFamily::Contact),
+        (
+            ActionKind::Inspect.canonical_id().raw(),
+            ActionKind::Inspect,
+            CandidateActionFamily::Inspect,
+        ),
+        (900, ActionKind::Interact, CandidateActionFamily::Other),
+    ] {
+        cs.push(candidate(
+            cs.len(),
+            id,
+            k,
+            f,
+            CandidateObservationRef::ObjectSlot(0),
+            target,
+            s.candidate_features().unwrap(),
+        ));
+    }
+    if include_play {
+        cs.push(candidate(
+            cs.len(),
+            213,
+            ActionKind::Interact,
+            CandidateActionFamily::Other,
+            CandidateObservationRef::ObjectSlot(0),
+            target,
+            s.candidate_features().unwrap(),
+        ));
+    }
+    rebuild(d, cs, vec![s])
+}
+fn receptors(t: Tick, signal: f32) -> NeuralReceptorFrame {
+    NeuralReceptorFrame {
+        schema_version: BIOCHEMICAL_GRAPH_SCHEMA_VERSION,
+        source_chemistry_version: BIOCHEMICAL_GRAPH_SCHEMA_VERSION,
+        source_tick: t,
+        activations: [
+            NeuralReceptorClass::InteroceptiveInput,
+            NeuralReceptorClass::RegionalExcitability,
+            NeuralReceptorClass::ProjectionGain,
+            NeuralReceptorClass::LocalThreshold,
+            NeuralReceptorClass::StructuralGrowth,
+            NeuralReceptorClass::Sleep,
+            NeuralReceptorClass::Consolidation,
+        ]
+        .into_iter()
+        .map(|class| NeuralReceptorActivation { class, signal })
+        .collect(),
+    }
+}
+fn modulation(e: &M2BoredomDetachedCpuV1, r: &NeuralReceptorFrame) -> MediationModulationV1 {
+    let x = NeuralReceptorEffects::from_frame(
+        r,
+        &NeuralReceptorPhenotype::compile(e.source()).unwrap(),
+    )
+    .unwrap();
+    MediationModulationV1 {
+        interoceptive_gain: x.interoceptive_gain,
+        regional_gain: x.regional_excitability,
+        projection_gain: x.projection_gain,
+        threshold: x.local_threshold_shift,
+        offset: ((x.structural_growth_gate + x.sleep_gate + x.consolidation_gate) / 3. - 0.5)
+            * 0.05,
+    }
+}
+fn tick(
+    e: &M2BoredomDetachedCpuV1,
+    f: &PerceptionFrame,
+    r: &NeuralReceptorFrame,
+) -> TrainingReplayTick {
+    let mut t = super::super::tests::tick(&e.group, f);
+    let m = modulation(e, r);
+    t.projection_gain = m.projection_gain;
+    t.local_threshold_shift = m.threshold;
+    t
+}
+fn run(
+    e: &mut M2BoredomDetachedCpuV1,
+    f: &PerceptionFrame,
+    r: &NeuralReceptorFrame,
+) -> M2BoredomProbeResultV1 {
+    let t = tick(e, f, r);
+    let rows = e.bind_rows(f, &t).unwrap();
+    e.step(
+        f,
+        t,
+        &rows,
+        r,
+        u32::MAX >> (32 - rows.len()),
+        [true; 6],
+        u64::MAX,
+    )
+    .unwrap()
+}
+fn synthetic(
+    e: &mut M2BoredomDetachedCpuV1,
+    f: &PerceptionFrame,
+    r: &NeuralReceptorFrame,
+) -> MediationReceiptV1 {
+    let t = tick(e, f, r);
+    let m = modulation(e, r);
+    let mut state = e.group.core.snapshot();
+    let mut components = vec![[0.; 5]; t.candidates.len()];
+    let mut raw = [0.; 12];
+    raw[..11].copy_from_slice(&f.homeostasis().drives.to_array());
+    raw[11] = f.homeostasis().hormones.sleep_pressure;
+    let mut gates = [0.; SLOTS];
+    for b in play_bindings(f).unwrap() {
+        gates[b.candidate_index] = 1.;
+    }
+    let mut run = BoredomRunV1 {
+        recipe: &e.recipe,
+        banks: &mut e.play,
+        gates,
+        control: e.control,
+        work: M2BoredomWorkV1::default(),
+    };
+    let out = run_partition_banks_with_boredom(
+        &e.group.core.recipe,
+        e.mode,
+        state.source_hash,
+        &mut state.activations,
+        &mut state.ema,
+        &mut state.metabolic,
+        &mut components,
+        &t.candidates,
+        raw,
+        0.6,
+        m,
+        Some(&mut run),
+    )
+    .unwrap();
+    assert_eq!(run.work, M2BoredomWorkV1::EXPECTED);
+    assert_eq!(run.work.cost_q24(), 456);
+    out
+}
+fn eval_bits(e: &TrainingReplayEvaluation) -> Vec<u8> {
+    serde_json::to_vec(
+        &[
+            &e.candidate_logits,
+            &e.final_activations,
+            &e.final_activity_ema,
+            &e.final_metabolic_load,
+        ]
+        .map(|b| {
+            b.iter()
+                .map(|r| r.iter().map(|x| x.to_bits()).collect::<Vec<_>>())
+                .collect::<Vec<_>>()
+        }),
+    )
+    .unwrap()
+}
