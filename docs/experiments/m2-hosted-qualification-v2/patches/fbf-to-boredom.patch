+#[test]
+fn boredom_source_once_legacy_bytes_equal_work_and_cold_identity() {
+    let (i, a) = super::super::tests::source();
+    let f = frame(drives(0.8), true);
+    let r = receptors(f.tick(), 0.5);
+    for mode in [MediationModeV1::Full, MediationModeV1::DriveSham] {
+        let mut new = fresh(mode, M2BoredomControlV1::EqualWorkReadoutSham);
+        let mut old = RecoveryGroupDetachedCpuV2::fresh(&i, &a, mode).unwrap();
+        let t = tick(&new, &f, &r);
+        let rows = old.bind_rows(&f, &t).unwrap();
+        let old_out = old
+            .step(
+                &f,
+                t,
+                &rows,
+                modulation(&new, &r),
+                (1 << rows.len()) - 1,
+                [true; 6],
+                u64::MAX,
+            )
+            .unwrap();
+        let new_out = run(&mut new, &f, &r);
+        assert_eq!(
+            eval_bits(&new_out.source_evaluation),
+            eval_bits(&old_out.source_evaluation)
+        );
+        assert_eq!(new_out.receipt.core.source_execution_count, 1);
+        assert_eq!(
+            new_out.receipt.core.core_logits,
+            old_out.receipt.core.core_logits
+        );
+        assert_eq!(
+            new_out.receipt.group_activations,
+            old_out.receipt.extension_activations
+        );
+        assert_eq!(
+            new_out.receipt.group_logit.to_bits(),
+            old_out.receipt.scores.group.to_bits()
+        );
+        assert_eq!(
+            new_out.receipt.operation_logits,
+            old_out.receipt.scores.operations
+        );
+        assert_eq!(
+            new_out.receipt.total_arithmetic_reservation_q24,
+            old_out.receipt.core.detached_arithmetic_reservation_q24
+                + old_out.receipt.extension_arithmetic_q24
+                + 456
+        );
+        let old_bytes = serde_json::to_vec(&old.snapshot()).unwrap();
+        let old_restored =
+            RecoveryGroupDetachedCpuV2::restore(&i, &a, mode, old.snapshot()).unwrap();
+        assert_eq!(
+            serde_json::to_vec(&old_restored.snapshot()).unwrap(),
+            old_bytes
+        );
+        let snapshot = new.snapshot().unwrap();
+        let bytes = serde_json::to_vec(&snapshot).unwrap();
+        let mut cold = M2BoredomDetachedCpuV1::restore(
+            &i,
+            &a,
+            mode,
+            new.control,
+            serde_json::from_slice(&bytes).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(
+            serde_json::to_vec(&cold.snapshot().unwrap()).unwrap(),
+            bytes
+        );
+        let warm = run(&mut new, &f, &r);
+        let cold_out = run(&mut cold, &f, &r);
+        assert_eq!(
+            serde_json::to_vec(&warm.receipt).unwrap(),
+            serde_json::to_vec(&cold_out.receipt).unwrap()
+        );
+        assert_eq!(new.snapshot().unwrap(), cold.snapshot().unwrap());
+        let other = if mode == MediationModeV1::Full {
+            MediationModeV1::DriveSham
+        } else {
+            MediationModeV1::Full
+        };
+        assert!(
+            M2BoredomDetachedCpuV1::restore(&i, &a, other, new.control, snapshot.clone()).is_err()
+        );
+        assert!(M2BoredomDetachedCpuV1::restore(
+            &i,
+            &a,
+            mode,
+            M2BoredomControlV1::Full,
+            snapshot.clone()
+        )
+        .is_err());
+        let inner: RecoveryGroupSnapshotV2 = serde_json::from_str(&snapshot.group_json).unwrap();
+        assert!(RecoveryGroupDetachedCpuV2::restore(&i, &a, mode, inner.clone()).is_err());
+        let core = serde_json::from_str(&inner.core_json).unwrap();
+        assert!(MediationDetachedCpuV1::restore(&i, &a, mode, core).is_err());
+        let mut swapped = snapshot;
+        swapped.group_json = serde_json::to_string(&old.snapshot()).unwrap();
+        assert!(M2BoredomDetachedCpuV1::restore(&i, &a, mode, new.control, swapped).is_err());
+        assert!(serde_json::from_slice::<M2BoredomSnapshotV1>(&old_bytes).is_err());
+    }
+}
