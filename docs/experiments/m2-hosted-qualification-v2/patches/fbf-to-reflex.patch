+#[test]
+fn recovery_reflex_chronic_pain_stops_next_interval_and_cold_receipt_is_exact() {
+    let mut world = fresh(1, false);
+    hazard_at(&mut world, Vec3f::new(0.01, 0.0, 0.0), 0.03);
+    let selected = bundle(&world, 700, false);
+    let first = execute(&mut world, &selected);
+    assert!(first.interval().withdrawal.is_some());
+    world.try_advance_tick().unwrap();
+    let encoded = serde_json::to_vec(&world.save_state()).unwrap();
+    let decoded = serde_json::from_slice(&encoded).unwrap();
+    let mut cold = HeadlessWorld::from_save_state(&decoded).unwrap();
+    let selected = bundle(&world, 700, false);
+    let expected = execute(&mut world, &selected);
+    let actual = execute(&mut cold, &selected);
+    assert!(expected.motor().biology_before.body.injury > 0.0);
+    assert!(expected.interval().withdrawal.is_none());
+    assert_eq!(expected.interval().actual_displacement, Vec3f::ZERO);
+    assert_eq!(expected, actual);
+    assert_eq!(
+        expected.evidence().canonical_digest().unwrap(),
+        actual.evidence().canonical_digest().unwrap()
+    );
+    assert_eq!(
+        serde_json::to_vec(&world.save_state()).unwrap(),
+        serde_json::to_vec(&cold.save_state()).unwrap()
+    );
+}
