+#[test]
+fn recovery_reflex_localized_left_right_behind_keeps_selection_and_heading() {
+    for pain in [
+        Vec3f::new(0.0, 0.0, 0.01),
+        Vec3f::new(0.0, 0.0, -0.01),
+        Vec3f::new(-0.01, 0.0, 0.0),
+    ] {
+        for posture in [3, 700] {
+            let mut world = fresh(1, false);
+            let source = hazard_at(&mut world, pain, 0.03);
+            let selected = bundle(&world, posture, false);
+            let before = world.organism_registry.get(OWNER).unwrap().clone();
+            let receipt = execute(&mut world, &selected);
+            let reflex = receipt.interval().withdrawal.as_ref().unwrap();
+            assert_eq!(
+                reflex.direction_basis,
+                WithdrawalDirectionBasis::LocalizedContact
+            );
+            assert_eq!(reflex.sources, vec![source]);
+            assert!(
+                !reflex.blocked
+                    && pain.x * reflex.displacement.x + pain.z * reflex.displacement.z < 0.0
+            );
+            assert_eq!(receipt.motor().bundle, selected);
+            assert_eq!(receipt.motor().joint.execution.displacement, Vec3f::ZERO);
+            assert_eq!(
+                receipt.composed_joint().execution.displacement,
+                reflex.displacement
+            );
+            assert_eq!(
+                receipt.composed_joint().channel_outcomes,
+                receipt.motor().joint.channel_outcomes
+            );
+            assert_eq!(receipt.evidence().successor_body_yaw, 0.0);
+            assert_eq!(receipt.evidence().awake_recovery, 0.0);
+            assert_eq!(receipt.motor().body_event.sleep_recovery, 0.0);
+            assert!(!receipt.evidence().successful_stationary_body_sleep);
+            assert_one_biology(&world, &before, &receipt);
+        }
+    }
+}
