+++ b/crates/alife_world/src/headless/sleep_choice_research/recovery_reflex/tests.rs
@@ -0,0 +1,852 @@
+//! Authored physical fixtures, not learned choices or autonomous lives.
+//! Not run during source-only preparation. Native qualification is a later gate.
+use super::*;
+use crate::*;
+use alife_core::*;
+
+const OWNER: OrganismId = OrganismId(1);
+fn fresh(residents: u16, zero_capacity: bool) -> HeadlessWorld {
+    // Reuse the existing public recovery-body fixture, not an acquired source.
+    let template = create_canonical_new_game_with_awake_rest_research_v1(
+        &CanonicalNewGameConfig::phase3(961060, residents).unwrap(),
+    )
+    .unwrap()
+    .world;
+    let mut builder = HeadlessScenarioBuilder::new(961060)
+        .agent("agent", OWNER, Vec3f::ZERO)
+        .food("food", Vec3f::new(1.0, 0.0, 0.0), 0.6)
+        .hazard("hazard", Vec3f::new(8.0, 0.0, 0.0), 0.2);
+    if residents == 2 {
+        builder = builder.agent("peer", OrganismId(2), Vec3f::new(4.0, 0.0, 0.0));
+    }
+    let mut world = builder.build().unwrap();
+    for raw in 1..=residents {
+        let id = OrganismId(u64::from(raw));
+        let record = template.organism_registry.get(id).unwrap();
+        let entity = world
+            .entity_id(if raw == 1 { "agent" } else { "peer" })
+            .unwrap();
+        let mut chemistry = *record.biochemistry();
+        // Synthetic physical-capacity control only; never patch a lived body.
+        if zero_capacity {
+            chemistry.body.set_energy(0.0).unwrap();
+        }
+        world
+            .register_organism_record(
+                WorldOrganismRecord::new(
+                    id,
+                    entity,
+                    record.genome().clone(),
+                    record.phenotype().clone(),
+                    chemistry,
+                    Tick::ZERO,
+                )
+                .unwrap(),
+            )
+            .unwrap();
+    }
+    world
+}
+fn chan(channel: MotorChannel, primitive: ActionId) -> ChannelCommand {
+    ChannelCommand::new(
+        channel,
+        primitive,
+        None,
+        Vec3f::ZERO,
+        Intensity::new(1.0).unwrap(),
+        DurationTicks(1),
+        0.0,
+        Confidence::new(1.0).unwrap(),
+        0,
+    )
+    .unwrap()
+}
+fn bundle(world: &HeadlessWorld, posture: u32, moving: bool) -> MotorCommandBundle {
+    let mut channels = vec![chan(MotorChannel::Posture, ActionId(posture))];
+    if moving {
+        let mut movement = chan(MotorChannel::Locomotion, HeadlessActionIds::STEP_FORWARD);
+        movement.direction = Vec3f::new(1.0, 0.0, 0.0);
+        channels.push(movement);
+    }
+    MotorCommandBundle::new(
+        OWNER,
+        ExperienceSequenceId(world.tick.raw() + 1),
+        world.tick,
+        channels,
+    )
+    .unwrap()
+}
+fn request(world: &mut HeadlessWorld, bundle: &MotorCommandBundle) -> RecoveryReflexRequestV1 {
+    let admission =
+        RecoveryReflexWorldAdmissionV1::for_organism(world, bundle.organism_id).unwrap();
+    let (draft, binding) = world
+        .perception_recovery_reflex_draft_with_bindings(
+            &admission,
+            world.tick,
+            HomeostaticSnapshot::baseline(world.tick),
+        )
+        .unwrap();
+    assert_eq!(
+        binding.unwrap().candidates_for_focus(&draft, None).unwrap(),
+        draft.candidates()
+    );
+    RecoveryReflexRequestV1::new(
+        &admission,
+        &draft.finalize(PerceptionContextBlock::empty()).unwrap(),
+        bundle,
+    )
+    .unwrap()
+}
+fn execute(world: &mut HeadlessWorld, bundle: &MotorCommandBundle) -> RecoveryReflexWorldReceiptV1 {
+    let request = request(world, bundle);
+    let neural = NeuralEmissionFrame::new(world.tick, 1, vec![]).unwrap();
+    world
+        .apply_recovery_reflex_motor_bundle_v1(&request, &neural, 0.0, &[])
+        .unwrap()
+}
+fn hazard_at(world: &mut HeadlessWorld, position: Vec3f, radius: f32) -> WorldEntityId {
+    let id = world.entity_id("hazard").unwrap();
+    let object = world.objects.get_mut(&id.raw()).unwrap();
+    object.position = position;
+    object.radius = radius;
+    id
+}
+fn hold_food(world: &mut HeadlessWorld) -> WorldEntityId {
+    let food = world.entity_id("food").unwrap();
+    let cmd = HeadlessWorldCommand::structured(
+        OWNER,
+        HeadlessActionIds::GRAB,
+        ActionKind::Hold,
+        Some(food),
+        None,
+    )
+    .unwrap();
+    assert!(world.apply_command(&cmd).unwrap().execution.succeeded);
+    assert_eq!(world.entity(food).unwrap().carried_by, Some(OWNER));
+    food
+}
+fn assert_one_biology(
+    world: &HeadlessWorld,
+    before: &WorldOrganismRecord,
+    receipt: &RecoveryReflexWorldReceiptV1,
+) {
+    let m = receipt.motor();
+    let neural = NeuralEmissionFrame::new(m.bundle.tick, 1, vec![]).unwrap();
+    let expected = before
+        .biochemistry()
+        .advance_with_body_research_events_v1(
+            m.outcome_tick,
+            Tick(before.age_at(m.bundle.tick).unwrap().raw() + 1),
+            m.body_event,
+            Some(&neural),
+            before.phenotype(),
+            ThermalBalanceCandidate::default(),
+            AwakeRestEventV1::new(receipt.evidence().awake_recovery).unwrap(),
+        )
+        .unwrap();
+    assert_eq!(m.biology_after, expected);
+    assert_eq!(
+        *world.organism_registry.get(OWNER).unwrap().biochemistry(),
+        expected
+    );
+}
+fn rest_event(id: OrganismId) -> BTreeMap<u64, BodyEventDelta> {
+    BTreeMap::from([(
+        id.raw(),
+        BodyEventDelta {
+            sleep_recovery: 1.0,
+            ..BodyEventDelta::zero()
+        },
+    )])
+}
+fn add_obstacle(world: &mut HeadlessWorld, position: Vec3f, radius: f32) {
+    world
+        .editor_spawn_object(WorldEditorSpawnSpec {
+            label: "blocker".into(),
+            kind: WorldObjectKind::Obstacle,
+            organism_id: None,
+            position,
+            nutrition: 0.0,
+            hazard_pain: 0.0,
+            radius,
+            token_id: None,
+        })
+        .unwrap();
+}
