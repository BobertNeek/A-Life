+impl Validate for RecoveryReflexBodyIntervalV1 {
+    fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        let invalid = ScaffoldContractError::InvalidDecisionEvidence;
+        if self.schema_version != 1
+            || self.interval.schema_version != 1
+            || self.source_tick.raw().checked_add(1) != Some(self.interval.outcome_tick.raw())
+            || self
+                .admitted_nondecision_organisms
+                .iter()
+                .any(|id| id.raw() == 0)
+            || self
+                .admitted_nondecision_organisms
+                .windows(2)
+                .any(|p| p[0].raw() >= p[1].raw())
+            || self.interval.responses.len() > self.admitted_nondecision_organisms.len()
+        {
+            return Err(invalid);
+        }
+        let mut seen = BTreeSet::new();
+        for r in &self.interval.responses {
+            r.applied_body_event.validate_contract()?;
+            NormalizedScalar::new(r.requested_sleep_recovery)?;
+            if r.schema_version != 1
+                || r.outcome_tick != self.interval.outcome_tick
+                || !self.admitted_nondecision_organisms.contains(&r.organism_id)
+                || !seen.insert(r.organism_id.raw())
+                || r.sleep_recovery_interrupted
+                    != (r.applied_body_event.damage > 0.0 && r.requested_sleep_recovery > 0.0)
+                || (r.applied_body_event.damage > 0.0 && r.applied_body_event.sleep_recovery != 0.0)
+            {
+                return Err(invalid);
+            }
+            if let Some(reflex) = &r.withdrawal {
+                validate_withdrawal(reflex)?;
+                if r.applied_body_event.damage <= 0.0
+                    || (reflex.displacement != Vec3f::ZERO
+                        && r.applied_body_event.sleep_recovery != 0.0)
+                {
+                    return Err(invalid);
+                }
+            }
+        }
+        Ok(())
+    }
+}
