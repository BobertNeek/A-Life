+#[test]
+fn recovery_reflex_initial_preemption_and_swept_contact_share_one_budget() {
+    for fraction in [0.0, 0.2, 0.5, 0.9] {
+        let mut world = fresh(1, false);
+        let selected = bundle(&world, 700, true);
+        let mut quiet = world.clone();
+        let step = execute(&mut quiet, &selected)
+            .interval()
+            .actual_displacement
+            .x;
+        assert!(step > 0.0);
+        hazard_at(
+            &mut world,
+            Vec3f::new(0.03 + step * fraction, 0.0, 0.0),
+            0.03,
+        );
+        let receipt = execute(&mut world, &selected);
+        assert!(receipt.interval().withdrawal.is_some());
+        assert!(receipt.interval().allocated_translation_time <= 1.0);
+        assert!((receipt.interval().voluntary_time_allocated - fraction).abs() < 1e-4);
+        if fraction == 0.0 {
+            assert_eq!(receipt.interval().voluntary_path, 0.0);
+            assert!(!receipt.motor().succeeded);
+        } else {
+            assert!(receipt.interval().voluntary_path > 0.0);
+        }
+        assert_eq!(receipt.motor().body_event.damage, 0.2);
+        assert_eq!(receipt.evidence().awake_recovery, 0.0);
+    }
+}
