+/// Explicit body-only evidence has no sampled bundle, sequence or credit event.
+/// Quiet due residents are included in the roster even when `responses` is empty.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RecoveryReflexBodyIntervalV1 {
+    pub schema_version: u16,
+    pub policy: RecoveryReflexPolicyV1,
+    pub source_tick: Tick,
+    pub admitted_nondecision_organisms: Vec<OrganismId>,
+    pub interval: BodyOnlyContactIntervalReceipt,
+}
+impl HeadlessWorld {
+    pub fn advance_recovery_reflex_bodies_v1(
+        &mut self,
+        events: &BTreeMap<u64, BodyEventDelta>,
+        admissions: &[RecoveryReflexWorldAdmissionV1],
+    ) -> Result<RecoveryReflexBodyIntervalV1, ScaffoldContractError> {
+        let mut staged = self.clone();
+        let receipt =
+            staged.advance_recovery_reflex_bodies_v1_in_staged_tick(events, admissions)?;
+        *self = staged;
+        Ok(receipt)
+    }
+    /// Supply only scheduler-selected nondecision residents, not every awake
+    /// resident. Already-acted peers retain their completed body transaction.
+    /// No SleepController phase is changed by interrupted physical recovery.
+    pub fn advance_recovery_reflex_bodies_v1_in_staged_tick(
+        &mut self,
+        events: &BTreeMap<u64, BodyEventDelta>,
+        admissions: &[RecoveryReflexWorldAdmissionV1],
+    ) -> Result<RecoveryReflexBodyIntervalV1, ScaffoldContractError> {
+        let source_tick = self.tick;
+        let mut ids = BTreeSet::new();
+        for admission in admissions {
+            admission.validate_owner(
+                self,
+                admission.recovery.organism_id,
+                admission.recovery.world_entity_id,
+            )?;
+            if !ids.insert(admission.recovery.organism_id.raw()) {
+                return Err(ScaffoldContractError::InvalidDecisionEvidence);
+            }
+        }
+        let interval =
+            self.try_advance_tick_with_selected_body_contacts_in_staged_tick(events, &ids)?;
+        let receipt = RecoveryReflexBodyIntervalV1 {
+            schema_version: 1,
+            policy: RecoveryReflexPolicyV1::SharedTimeDirectionalWithdrawalAndRecoveryV1,
+            source_tick,
+            admitted_nondecision_organisms: ids.into_iter().map(OrganismId).collect(),
+            interval,
+        };
+        receipt.validate_contract()?;
+        Ok(receipt)
+    }
+}
