+#[test]
+fn recovery_reflex_quiet_controls_preserve_old_world_receipt_and_old_guard() {
+    for posture in [3, 700, HeadlessActionIds::NO_POSTURE.raw()] {
+        let mut world = fresh(1, false);
+        let selected = bundle(&world, posture, false);
+        let new_request = request(&mut world, &selected);
+        let old_request = new_request.selection.clone();
+        let neural = NeuralEmissionFrame::new(world.tick, 1, vec![]).unwrap();
+        let mut old = world.clone();
+        let expected = old
+            .apply_sleep_choice_motor_bundle_in_staged_tick(&old_request, &neural, 0.0, &[])
+            .unwrap();
+        let actual = world
+            .apply_recovery_reflex_motor_bundle_v1(&new_request, &neural, 0.0, &[])
+            .unwrap();
+        assert_eq!(actual.motor(), &expected.motor);
+        assert_eq!(actual.evidence().awake_recovery, expected.awake_dose);
+        assert_eq!(actual.composed_joint(), &expected.motor.joint);
+        assert_eq!(world.save_state(), old.save_state());
+        let mut rejected = fresh(1, false);
+        let own = rejected.entity_id("agent").unwrap();
+        let before = rejected.save_state();
+        let mut translation = awake_translation::AwakeTranslationState::default();
+        let mut awake = AwakeRestEventV1::NONE;
+        assert!(rejected
+            .apply_registered_motor_bundle_with_sleep_choice_inner(
+                &selected,
+                own,
+                Some(&neural),
+                None,
+                Some(&mut translation),
+                Some(&mut awake),
+                true
+            )
+            .is_err());
+        assert_eq!(rejected.save_state(), before);
+    }
+}
