+impl HeadlessWorld {
+    pub fn perception_recovery_reflex_draft_with_bindings(
+        &mut self,
+        admission: &RecoveryReflexWorldAdmissionV1,
+        tick: Tick,
+        homeostasis: HomeostaticSnapshot,
+    ) -> Result<(PerceptionFrameDraft, Option<GroundedCandidateBinding>), ScaffoldContractError>
+    {
+        self.perception_sleep_choice_draft_with_bindings(&admission.recovery, tick, homeostasis)
+    }
+
+    /// Atomic standalone physical transaction. No source, experience sequence or
+    /// optimizer update is created here. The host still owns cognitive commit.
+    pub fn apply_recovery_reflex_motor_bundle_v1(
+        &mut self,
+        request: &RecoveryReflexRequestV1,
+        neural: &NeuralEmissionFrame,
+        novelty: f32,
+        object_novelty: &[(WorldEntityId, f32)],
+    ) -> Result<RecoveryReflexWorldReceiptV1, HeadlessMotorTransactionError> {
+        let mut staged = self.clone();
+        let receipt = staged.apply_recovery_reflex_motor_bundle_v1_in_staged_tick(
+            request,
+            neural,
+            novelty,
+            object_novelty,
+        )?;
+        *self = staged;
+        Ok(receipt)
+    }
+
+    /// Enclosing host MUST discard its entire staged world/resident state on any
+    /// error, including evidence construction failure after the biology call.
+    pub fn apply_recovery_reflex_motor_bundle_v1_in_staged_tick(
+        &mut self,
+        request: &RecoveryReflexRequestV1,
+        neural: &NeuralEmissionFrame,
+        novelty: f32,
+        object_novelty: &[(WorldEntityId, f32)],
+    ) -> Result<RecoveryReflexWorldReceiptV1, HeadlessMotorTransactionError> {
+        let bundle = request.bundle();
+        let entity = request.admission.recovery.world_entity_id;
+        request
+            .admission
+            .validate_owner(self, bundle.organism_id, entity)?;
+        if request.selection.frame.tick() != self.tick
+            || self
+                .organism_registry
+                .get(bundle.organism_id)
+                .is_none_or(|r| r.sleep_phase() != alife_core::SleepPhase::Awake)
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence.into());
+        }
+        if !novelty.is_finite()
+            || !(0.0..=1.0).contains(&novelty)
+            || object_novelty.len() > bundle.channels.len()
+            || object_novelty
+                .iter()
+                .any(|(id, v)| id.raw() == 0 || !v.is_finite() || !(0.0..=1.0).contains(v))
+        {
+            return Err(ScaffoldContractError::ScalarOutOfRange.into());
+        }
+        let initial_position = self.objects[&entity.raw()].position;
+        let mut translation = awake_translation::AwakeTranslationState::default();
+        let mut recovery = AwakeRestEventV1::NONE;
+        let motor = self.apply_registered_motor_bundle_recovery_reflex_inner(
+            bundle,
+            entity,
+            Some(neural),
+            Some((novelty, object_novelty)),
+            Some(&mut translation),
+            if request.selection.operation == Some(RecoveryOperationV1::AwakeRest) {
+                Some(&mut recovery)
+            } else {
+                None
+            },
+            true,
+            Some(&request.admission),
+        )?;
+        let interval = translation.into_receipt(motor);
+        let m = &interval.voluntary;
+        let stationary = all_segments_stationary(&m.joint, interval.withdrawal.as_ref());
+        let evidence = RecoveryReflexPhysicalEvidenceV1 {
+            schema_version: 1,
+            policy: RecoveryReflexPolicyV1::SharedTimeDirectionalWithdrawalAndRecoveryV1,
+            frame_digest: request.selection.frame.frame_digest(),
+            selected_bundle: bundle.clone(),
+            outcome_tick: m.outcome_tick,
+            operation: request.selection.operation,
+            voluntary_joint: m.joint.clone(),
+            composed_joint: compose_joint(&m.joint, interval.withdrawal.as_ref())?,
+            withdrawal: interval.withdrawal.clone(),
+            translation: RecoveryReflexTranslationWitnessV1 {
+                time_metric: interval.translation_time_metric,
+                allocated_time: interval.allocated_translation_time,
+                voluntary_time: interval.voluntary_time_allocated,
+                planned_voluntary_time: interval.planned_voluntary_time,
+                voluntary_time_provenance: interval.voluntary_time_provenance,
+                reflex_time: interval.reflex_time_allocated,
+                reflex_budget_exhausted: interval.reflex_budget_exhausted,
+                exhausted_late_no_effect: interval.exhausted_late_no_effect,
+                voluntary_execution_altered: interval.voluntary_execution_altered,
+                voluntary_path: interval.voluntary_path,
+                reflex_path: interval.reflex_path,
+                voluntary_translation_energy: interval.voluntary_translation_energy,
+            },
+            initial_position,
+            successor_position: self.objects[&entity.raw()].position,
+            successor_body_yaw: self.objects[&entity.raw()].body_yaw,
+            body_event: m.body_event,
+            biology_before: m.biology_before,
+            biology_after_physical: m.biology_after,
+            awake_recovery: recovery.dose(),
+            successful_stationary_body_sleep: request.selection.operation
+                == Some(RecoveryOperationV1::BodySleep)
+                && m.channel_receipts.iter().any(|c| {
+                    c.command.channel == MotorChannel::Posture
+                        && c.command.primitive == RecoveryOperationV1::BodySleep.action_id()
+                        && c.phase == ActionPhase::Completed
+                })
+                && stationary
+                && m.body_event.damage == 0.0
+                && m.body_event.sleep_recovery > 0.0
+                && m.biology_after.body.sleeping,
+        };
+        evidence.validate_contract()?;
+        Ok(RecoveryReflexWorldReceiptV1 { interval, evidence })
+    }
+}
