@@ -0,0 +1,718 @@
+//! Explicit combined world capability. It does not enable the grouped M2 host.
+//! A reflex is an environment response, never an extra sampled motor factor.
+use super::*;
+use serde::{Deserialize, Serialize};
+
+/// A new physical policy identity. Receipts cannot be relabeled as the old
+/// sleep-choice route, or used to construct an execution capability.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum RecoveryReflexPolicyV1 {
+    SharedTimeDirectionalWithdrawalAndRecoveryV1,
+}
+
+/// Ephemeral world admission, reconstructed against the authoritative inherited
+/// body. A future host must separately admit its source, recipe and envelope.
+#[derive(Debug, Clone)]
+pub struct RecoveryReflexWorldAdmissionV1 {
+    recovery: SleepChoiceWorldAdmissionV1,
+}
+impl RecoveryReflexWorldAdmissionV1 {
+    pub fn for_organism(
+        world: &HeadlessWorld,
+        organism: OrganismId,
+    ) -> Result<Self, ScaffoldContractError> {
+        Ok(Self {
+            recovery: SleepChoiceWorldAdmissionV1::for_organism(world, organism)?,
+        })
+    }
+    pub(in crate::headless) fn validate_owner(
+        &self,
+        world: &HeadlessWorld,
+        organism: OrganismId,
+        entity: WorldEntityId,
+    ) -> Result<(), ScaffoldContractError> {
+        self.recovery.validate(world)?;
+        if self.recovery.organism_id != organism || self.recovery.world_entity_id != entity {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        Ok(())
+    }
+}
+
+/// Exact finalized frame and selected bundle. Neither a boolean nor a persisted
+/// evidence record admits a new transaction. No action channels are appended.
+#[derive(Debug, Clone)]
+pub struct RecoveryReflexRequestV1 {
+    admission: RecoveryReflexWorldAdmissionV1,
+    selection: RecoveryRequestV1,
+}
+impl RecoveryReflexRequestV1 {
+    pub fn new(
+        admission: &RecoveryReflexWorldAdmissionV1,
+        frame: &PerceptionFrame,
+        bundle: &MotorCommandBundle,
+    ) -> Result<Self, ScaffoldContractError> {
+        Ok(Self {
+            admission: admission.clone(),
+            selection: RecoveryRequestV1::new(&admission.recovery, frame, bundle)?,
+        })
+    }
+    pub fn bundle(&self) -> &MotorCommandBundle {
+        self.selection.bundle()
+    }
+}
+
+/// Bounded measured work/time, not a persistent escape plan. Spatial path and
+/// actuator time are separate because terrain walking uses ground-plane time.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RecoveryReflexTranslationWitnessV1 {
+    pub time_metric: TranslationTimeMetric,
+    pub allocated_time: f32,
+    pub voluntary_time: f32,
+    pub planned_voluntary_time: f32,
+    pub voluntary_time_provenance: VoluntaryTimeProvenance,
+    pub reflex_time: f32,
+    pub reflex_budget_exhausted: bool,
+    pub exhausted_late_no_effect: bool,
+    pub voluntary_execution_altered: bool,
+    pub voluntary_path: f32,
+    pub reflex_path: f32,
+    pub voluntary_translation_energy: f32,
+}
+
+/// New evidence owner, deliberately outside the unchanged V12 core ABI.
+/// `voluntary_joint` reports only selected-channel execution. `composed_joint`
+/// keeps those channel outcomes and binds involuntary displacement/effort into
+/// the aggregate. World successor pose and one biology transition are explicit.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RecoveryReflexPhysicalEvidenceV1 {
+    pub schema_version: u16,
+    pub policy: RecoveryReflexPolicyV1,
+    pub frame_digest: alife_core::PerceptionFrameDigest,
+    pub selected_bundle: MotorCommandBundle,
+    pub outcome_tick: Tick,
+    pub operation: Option<RecoveryOperationV1>,
+    pub voluntary_joint: JointPhysicalOutcome,
+    pub composed_joint: JointPhysicalOutcome,
+    pub withdrawal: Option<ContactWithdrawalReceipt>,
+    pub translation: RecoveryReflexTranslationWitnessV1,
+    pub initial_position: Vec3f,
+    pub successor_position: Vec3f,
+    pub successor_body_yaw: f32,
+    pub body_event: BodyEventDelta,
+    pub biology_before: BiochemistryState,
+    pub biology_after_physical: BiochemistryState,
+    pub awake_recovery: f32,
+    pub successful_stationary_body_sleep: bool,
+}
+
+fn compose_joint(
+    voluntary: &JointPhysicalOutcome,
+    withdrawal: Option<&ContactWithdrawalReceipt>,
+) -> Result<JointPhysicalOutcome, ScaffoldContractError> {
+    let mut actual = voluntary.clone();
+    if let Some(reflex) = withdrawal {
+        actual.execution.displacement = add(actual.execution.displacement, reflex.displacement);
+        actual.execution.energy_cost = NormalizedScalar::new(
+            (actual.execution.energy_cost.raw() + reflex.energy_cost).clamp(0.0, 1.0),
+        )?;
+        let contact = if reflex.blocked {
+            PhysicalContactKind::Blocked
+        } else if !reflex.sources.is_empty() {
+            PhysicalContactKind::Touch
+        } else {
+            PhysicalContactKind::Moved
+        };
+        if physical_contact_priority(contact) > physical_contact_priority(actual.execution.contact)
+        {
+            actual.execution.contact = contact;
+            actual.execution.target_entity = reflex.sources.first().copied();
+            // No fabricated collision normal for a blocked actuator or an
+            // internal pain dose. Exact contributing source IDs live above.
+            actual.execution.collision_normal = None;
+        }
+    }
+    actual.validate_contract()?;
+    Ok(actual)
+}
+
+fn all_segments_stationary(
+    joint: &JointPhysicalOutcome,
+    withdrawal: Option<&ContactWithdrawalReceipt>,
+) -> bool {
+    joint
+        .channel_outcomes
+        .iter()
+        .all(|c| c.physical.displacement == Vec3f::ZERO)
+        && withdrawal.is_none_or(|r| r.displacement == Vec3f::ZERO)
+}
+
+fn validate_withdrawal(reflex: &ContactWithdrawalReceipt) -> Result<(), ScaffoldContractError> {
+    reflex.displacement.validate()?;
+    NormalizedScalar::new(reflex.energy_cost)?;
+    if reflex.sources.len() > ContactWithdrawalReceipt::MAX_SOURCES
+        || reflex.sources.iter().any(|id| id.raw() == 0)
+        || reflex
+            .sources
+            .windows(2)
+            .any(|pair| pair[0].raw() >= pair[1].raw())
+        || (reflex.direction_basis == WithdrawalDirectionBasis::LocalizedContact
+            && reflex.sources.is_empty())
+        || (reflex.blocked && reflex.displacement != Vec3f::ZERO)
+    {
+        return Err(ScaffoldContractError::InvalidDecisionEvidence);
+    }
+    Ok(())
+}
+
+impl Validate for RecoveryReflexPhysicalEvidenceV1 {
+    fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        let invalid = ScaffoldContractError::InvalidDecisionEvidence;
+        self.selected_bundle.validate_contract()?;
+        self.voluntary_joint.validate_contract()?;
+        self.composed_joint.validate_contract()?;
+        self.body_event.validate_contract()?;
+        self.biology_before.validate_contract()?;
+        self.biology_after_physical.validate_contract()?;
+        self.initial_position.validate()?;
+        self.successor_position.validate()?;
+        NormalizedScalar::new(self.awake_recovery)?;
+        let t = &self.translation;
+        for value in [
+            t.allocated_time,
+            t.voluntary_time,
+            t.planned_voluntary_time,
+            t.reflex_time,
+        ] {
+            NormalizedScalar::new(value)?;
+        }
+        for value in [t.voluntary_path, t.reflex_path] {
+            if !value.is_finite() || value < 0.0 {
+                return Err(invalid);
+            }
+        }
+        SignedValence::new(t.voluntary_translation_energy)?;
+        if !self.successor_body_yaw.is_finite()
+            || self.schema_version != 1
+            || self.selected_bundle.tick.raw().checked_add(1) != Some(self.outcome_tick.raw())
+            || self.biology_before.tick != self.selected_bundle.tick
+            || self.biology_after_physical.tick != self.outcome_tick
+            || self.biology_before.source_genome_id != self.biology_after_physical.source_genome_id
+            || t.allocated_time.to_bits() != (t.voluntary_time + t.reflex_time).to_bits()
+        {
+            return Err(invalid);
+        }
+        let posture = self
+            .selected_bundle
+            .channels
+            .iter()
+            .find(|c| c.channel == MotorChannel::Posture);
+        let operation = posture.and_then(|c| match c.primitive.raw() {
+            3 => Some(RecoveryOperationV1::BodySleep),
+            700 => Some(RecoveryOperationV1::AwakeRest),
+            _ => None,
+        });
+        if operation != self.operation {
+            return Err(invalid);
+        }
+        let mut expected_channels = self
+            .selected_bundle
+            .channels
+            .iter()
+            .map(|c| c.channel.canonical_key())
+            .collect::<Vec<_>>();
+        let mut actual_channels = self
+            .voluntary_joint
+            .channel_outcomes
+            .iter()
+            .map(|c| c.channel.canonical_key())
+            .collect::<Vec<_>>();
+        expected_channels.sort_unstable();
+        actual_channels.sort_unstable();
+        if expected_channels != actual_channels {
+            return Err(invalid);
+        }
+        let voluntary = self
+            .voluntary_joint
+            .channel_outcomes
+            .iter()
+            .fold(Vec3f::ZERO, |sum, c| add(sum, c.physical.displacement));
+        if voluntary != self.voluntary_joint.execution.displacement {
+            return Err(invalid);
+        }
+        let voluntary_path = self
+            .voluntary_joint
+            .channel_outcomes
+            .iter()
+            .filter(|c| c.channel == MotorChannel::Locomotion)
+            .map(|c| distance(Vec3f::ZERO, c.physical.displacement))
+            .sum::<f32>();
+        if t.voluntary_path.to_bits() != voluntary_path.to_bits() {
+            return Err(invalid);
+        }
+        match t.voluntary_time_provenance {
+            VoluntaryTimeProvenance::NoTranslation | VoluntaryTimeProvenance::ZeroSpeed => {
+                if t.voluntary_time != 0.0 || t.voluntary_path != 0.0 {
+                    return Err(invalid);
+                }
+            }
+            VoluntaryTimeProvenance::InitialPreemption => {
+                if self.withdrawal.is_none()
+                    || t.voluntary_time != 0.0
+                    || t.voluntary_path != 0.0
+                    || !t.voluntary_execution_altered
+                {
+                    return Err(invalid);
+                }
+            }
+            VoluntaryTimeProvenance::FullInterval | VoluntaryTimeProvenance::BlockedAttempt => {
+                if t.voluntary_time != 1.0 {
+                    return Err(invalid);
+                }
+            }
+            VoluntaryTimeProvenance::GoalArrival => {
+                if t.voluntary_time != t.planned_voluntary_time {
+                    return Err(invalid);
+                }
+            }
+            VoluntaryTimeProvenance::SweptContact => {
+                if self.withdrawal.is_none() || t.voluntary_time > t.planned_voluntary_time {
+                    return Err(invalid);
+                }
+            }
+        }
+        let reflex_displacement = self
+            .withdrawal
+            .as_ref()
+            .map_or(Vec3f::ZERO, |r| r.displacement);
+        if let Some(reflex) = &self.withdrawal {
+            validate_withdrawal(reflex)?;
+            if self.body_event.damage <= 0.0 {
+                return Err(invalid);
+            }
+        } else if t.reflex_time != 0.0
+            || t.reflex_path != 0.0
+            || t.reflex_budget_exhausted
+            || t.exhausted_late_no_effect
+        {
+            return Err(invalid);
+        }
+        if t.reflex_budget_exhausted != (self.withdrawal.is_some() && t.reflex_time == 0.0)
+            || t.reflex_path.to_bits() != distance(Vec3f::ZERO, reflex_displacement).to_bits()
+            || compose_joint(&self.voluntary_joint, self.withdrawal.as_ref())?
+                != self.composed_joint
+            || (t.exhausted_late_no_effect
+                && (!t.reflex_budget_exhausted
+                    || t.voluntary_execution_altered
+                    || self.withdrawal.as_ref().is_none_or(|r| {
+                        !r.blocked || r.energy_cost != 0.0 || r.displacement != Vec3f::ZERO
+                    })))
+        {
+            return Err(invalid);
+        }
+        // Different f32 additions/subtractions at translated origins can round
+        // differently. Preserve exact pose bits in the witness and its digest;
+        // this bound checks composition, not byte identity across origins.
+        let composed_endpoint = add(add(self.initial_position, voluntary), reflex_displacement);
+        for (a, b, start) in [
+            (
+                composed_endpoint.x,
+                self.successor_position.x,
+                self.initial_position.x,
+            ),
+            (
+                composed_endpoint.y,
+                self.successor_position.y,
+                self.initial_position.y,
+            ),
+            (
+                composed_endpoint.z,
+                self.successor_position.z,
+                self.initial_position.z,
+            ),
+        ] {
+            let tolerance = 8.0 * f32::EPSILON * a.abs().max(b.abs()).max(start.abs()).max(1.0);
+            if (a - b).abs() > tolerance {
+                return Err(invalid);
+            }
+        }
+        let stationary = all_segments_stationary(&self.voluntary_joint, self.withdrawal.as_ref());
+        let undamaged_stationary = stationary && self.body_event.damage == 0.0;
+        if self.awake_recovery > 0.0
+            && (self.operation != Some(RecoveryOperationV1::AwakeRest)
+                || !undamaged_stationary
+                || self.body_event.sleep_recovery != 0.0
+                || self.biology_after_physical.body.sleeping)
+        {
+            return Err(invalid);
+        }
+        if self.body_event.sleep_recovery > 0.0 && !undamaged_stationary {
+            return Err(invalid);
+        }
+        if self.successful_stationary_body_sleep
+            != (self.operation == Some(RecoveryOperationV1::BodySleep)
+                && undamaged_stationary
+                && self.body_event.sleep_recovery > 0.0
+                && self.biology_after_physical.body.sleeping)
+        {
+            return Err(invalid);
+        }
+        Ok(())
+    }
+}
+impl RecoveryReflexPhysicalEvidenceV1 {
+    /// Includes the separate witness and all successor/biology fields. JSON is
+    /// a version-specific encoding here, never the unchanged V12 causal digest.
+    pub fn canonical_digest(&self) -> Result<[u64; 4], ScaffoldContractError> {
+        self.validate_contract()?;
+        let mut digest = CanonicalDigestBuilder::new(b"ALIFE-RECOVERY-REFLEX-PHYSICAL-V1-JSON1");
+        digest.write_bytes(
+            &serde_json::to_vec(self)
+                .map_err(|_| ScaffoldContractError::InvalidDecisionEvidence)?,
+        );
+        Ok(digest.finish256())
+    }
+}
