+/// V12 can truthfully carry composed aggregate + unchanged voluntary channels,
+/// but cannot itself bind the withdrawal witness. This versioned outer owner is
+/// required, with its digest, in the future host's packet and cold envelope.
+/// There is still only ONE canonical experience and ONE selected bundle.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RecoveryReflexExperienceV1 {
+    schema_version: u16,
+    patch: ExperiencePatch,
+    physical: RecoveryReflexPhysicalEvidenceV1,
+    physical_digest: [u64; 4],
+}
+impl RecoveryReflexExperienceV1 {
+    pub fn seal(
+        patch: ExperiencePatch,
+        receipt: &RecoveryReflexWorldReceiptV1,
+    ) -> Result<Self, ScaffoldContractError> {
+        let value = Self {
+            schema_version: 1,
+            patch,
+            physical: receipt.evidence.clone(),
+            physical_digest: receipt.evidence.canonical_digest()?,
+        };
+        value.validate_contract()?;
+        Ok(value)
+    }
+    pub fn patch(&self) -> &ExperiencePatch {
+        &self.patch
+    }
+    pub fn physical(&self) -> &RecoveryReflexPhysicalEvidenceV1 {
+        &self.physical
+    }
+    pub fn canonical_digest(&self) -> Result<[u64; 4], ScaffoldContractError> {
+        self.validate_contract()?;
+        let mut digest = CanonicalDigestBuilder::new(b"ALIFE-RECOVERY-REFLEX-EXPERIENCE-V1");
+        for word in self.patch.causal_digest()? {
+            digest.write_u64(word);
+        }
+        for word in self.physical_digest {
+            digest.write_u64(word);
+        }
+        Ok(digest.finish256())
+    }
+}
+impl Validate for RecoveryReflexExperienceV1 {
+    fn validate_contract(&self) -> Result<(), ScaffoldContractError> {
+        self.patch.validate_contract()?;
+        self.physical.validate_contract()?;
+        let outcome = self.patch.outcome();
+        if self.schema_version != 1
+            || self.patch.header().abi_version != ExperiencePatch::V12_ABI_VERSION
+            || self.physical_digest != self.physical.canonical_digest()?
+            || self.patch.decision().selected_bundle.as_ref()
+                != Some(&self.physical.selected_bundle)
+            || self.patch.pre_action().frame_digest()? != self.physical.frame_digest
+            || outcome.outcome_tick != self.physical.outcome_tick
+            || outcome.joint.as_ref() != Some(&self.physical.composed_joint)
+            || outcome.measured_physiology.as_ref().is_none_or(|p| {
+                p.before != self.physical.biology_before
+                    || p.after.tick != self.physical.biology_after_physical.tick
+                    || p.after.source_genome_id
+                        != self.physical.biology_after_physical.source_genome_id
+            })
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        // The host owns the one subsequent cognitive debit and its exact-state
+        // validation; physical biology is deliberately retained before that debit.
+        Ok(())
+    }
+}
