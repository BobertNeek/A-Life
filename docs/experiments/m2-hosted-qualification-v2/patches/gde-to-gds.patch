@@ -0,0 +1,394 @@
+//! Desired GDS1 assertions. Not executed until a native lane is granted.
+use super::*;
+use crate::cpu::{CpuGroupedM2DecoderShamCheckpointV1, CpuGroupedM2DecoderShamHostV1};
+fn sham_fixture(preparation: u64) -> (CpuGroupedM2DecoderShamHostV1, PhenotypeCompilerInputs) {
+    let (mut inner, inputs) = fixture(preparation);
+    for r in inner.host.residents.values_mut() {
+        assert_eq!(r.next_sequence, 1);
+        let state = r.grouped.as_mut().unwrap();
+        state.motor.enable_decoder_sham_fresh().unwrap();
+        state.decoder_sham = Some(GroupedDecoderShamStateV1 {
+            policy: GROUPED_DECODER_SHAM_POLICY_V1.into(),
+            work_policy: GROUPED_DECODER_SHAM_WORK_V1.into(),
+            last_credit: None,
+        });
+        r.sealed_authority = None;
+    }
+    inner.host.seal_all_residents().unwrap();
+    (CpuGroupedM2DecoderShamHostV1 { inner }, inputs)
+}
+fn source(host: &CpuGroupedM2HostV1) -> CpuOrganismCheckpoint {
+    host.host
+        .residents
+        .values()
+        .next()
+        .unwrap()
+        .neural
+        .checkpoint()
+        .unwrap()
+}
+#[test]
+fn grouped_sham_first_step_equal_work_and_only_fast_write_difference() {
+    let (mut full, _) = learning_fixture();
+    let (mut sham, _) = sham_fixture(240);
+    let initial = source(&sham.inner);
+    assert_eq!(initial, source(&full.inner));
+    let founder = bytes(&sham.inner.founder.checkpoint());
+    let structural = bytes(
+        &sham
+            .inner
+            .host
+            .residents
+            .values()
+            .next()
+            .unwrap()
+            .v11
+            .checkpoint(),
+    );
+    let f = full.step(0.73).unwrap();
+    let s = sham.step(0.73).unwrap();
+    assert_eq!(f.decisions.len(), 1);
+    assert_eq!(s.decisions.len(), 1);
+    let f = &f.decisions[0];
+    let s = &s.decisions[0];
+    assert_eq!(f.action, s.action);
+    assert_eq!(f.sampling_counter, s.sampling_counter);
+    assert_eq!(f.source_diagnostic_logits, s.source_diagnostic_logits);
+    assert_eq!(bytes(&f.diagnostic.sequence), bytes(&s.diagnostic.sequence));
+    assert_eq!(
+        bytes(&f.diagnostic.receptors),
+        bytes(&s.diagnostic.receptors)
+    );
+    assert_eq!(bytes(&f.motor.native.scores), bytes(&s.motor.native.scores));
+    assert_eq!(
+        f.motor.native.core.appended_activations,
+        s.motor.native.core.appended_activations
+    );
+    assert_eq!(
+        f.motor.native.extension_activations,
+        s.motor.native.extension_activations
+    );
+    assert_ne!(f.motor.native.schema, s.motor.native.schema);
+    assert_eq!(bytes(&f.brain_work), bytes(&s.brain_work));
+    assert_eq!(f.motor.reservation_q24, s.motor.reservation_q24);
+    assert_eq!(
+        f.motor.applied_body_energy_debit.to_bits(),
+        s.motor.applied_body_energy_debit.to_bits()
+    );
+    assert_eq!(bytes(&f.patch), bytes(&s.patch));
+    assert_eq!(bytes(&f.physical), bytes(&s.physical));
+    let record = full.world().organism_registry().get(f.organism_id).unwrap();
+    let development = record
+        .phenotype()
+        .development_state_at(f.motor.tick)
+        .unwrap();
+    let mut wrong_mode = f.diagnostic.staged.clone();
+    assert!(wrong_mode
+        .apply_grouped_decoder_sham_credit(
+            &full.inner.founder,
+            &f.patch,
+            &f.diagnostic.receptors,
+            &development,
+            record.phenotype().brain_genome.plasticity_parameters()
+        )
+        .is_err());
+    let fc = full.last_credit(f.organism_id).unwrap();
+    let sc = sham.last_credit(s.organism_id).unwrap();
+    assert_eq!(fc.learning_ops, sc.credit.learning_ops);
+    assert_eq!(fc.nonzero_eligibility, sc.credit.nonzero_eligibility);
+    assert!(sc.credit.nonzero_eligibility > 0);
+    assert_eq!(
+        fc.full_fast_write_counts()
+            .unwrap()
+            .hypothetical_changed_fast_coordinates,
+        sc.writes.hypothetical_changed_fast_coordinates
+    );
+    assert!(sc.writes.hypothetical_changed_fast_coordinates > 0);
+    assert_eq!(sc.writes.applied_changed_fast_coordinates, 0);
+    assert_eq!(sc.credit.changed_fast_coordinates, 0);
+    assert_eq!(
+        sc.credit.output_weight_generation,
+        initial.weight_generation
+    );
+    assert!(sc.credit.full_fast_write_counts().is_err());
+    let acquired = source(&sham.inner);
+    let mut acquired_full = source(&full.inner);
+    assert_eq!(bytes(&initial.fast), bytes(&acquired.fast));
+    assert_eq!(bytes(&initial.lifetime), bytes(&acquired.lifetime));
+    let p = sham.inner.founder.phenotype();
+    for (i, synapse) in p.synapses().iter().enumerate() {
+        if !grouped_decoder_coordinate(synapse.kind()) {
+            assert_eq!(
+                initial.eligibility[i].to_bits(),
+                acquired.eligibility[i].to_bits()
+            );
+        }
+    }
+    // Every source field except FULL's allowed fast values/generation agrees.
+    acquired_full.fast = acquired.fast.clone();
+    acquired_full.weight_generation = acquired.weight_generation;
+    assert_eq!(acquired_full, acquired);
+    assert_eq!(founder, bytes(&sham.inner.founder.checkpoint()));
+    assert_eq!(
+        structural,
+        bytes(
+            &sham
+                .inner
+                .host
+                .residents
+                .values()
+                .next()
+                .unwrap()
+                .v11
+                .checkpoint()
+        )
+    );
+    // Receipt scores still describe the pre-update sample in both modes.
+    for d in [f, s] {
+        assert_eq!(
+            d.motor
+                .native
+                .scores
+                .evaluate(&d.action)
+                .unwrap()
+                .joint_log_probability
+                .to_bits(),
+            d.action.old_joint_log_probability.to_bits()
+        );
+    }
+}
+#[test]
+fn grouped_sham_exact_cold_continuation_and_cross_mode_rejection() {
+    let (mut warm, inputs) = sham_fixture(240);
+    warm.step(0.73).unwrap();
+    // Explicit synthetic nonzero preservation sentinels, not acquired fast learning.
+    inject_frozen_sentinels(&mut warm.inner);
+    let frozen = |host: &CpuGroupedM2DecoderShamHostV1| {
+        let n = source(&host.inner);
+        let p = host.inner.founder.phenotype();
+        let other_traces = p
+            .synapses()
+            .iter()
+            .enumerate()
+            .filter(|(_, s)| !grouped_decoder_coordinate(s.kind()))
+            .map(|(i, _)| n.eligibility[i].to_bits())
+            .collect::<Vec<_>>();
+        bytes(&(
+            n.fast,
+            n.lifetime,
+            other_traces,
+            n.neural.dendrites,
+            host.inner.founder.checkpoint(),
+            host.inner
+                .host
+                .residents
+                .values()
+                .next()
+                .unwrap()
+                .v11
+                .checkpoint(),
+        ))
+    };
+    let frozen_before = frozen(&warm);
+    let wire = warm.checkpoint().unwrap().encode().unwrap();
+    assert!(CpuGroupedM2DecoderCheckpointV1::decode(&wire).is_err());
+    assert!(CpuGroupedM2HostCheckpointV1::decode(&wire).is_err());
+    let (mut full, _) = learning_fixture();
+    full.step(0.73).unwrap();
+    assert!(CpuGroupedM2DecoderShamCheckpointV1::decode(
+        &full.checkpoint().unwrap().encode().unwrap()
+    )
+    .is_err());
+    let (closed, _) = fixture(240);
+    assert!(CpuGroupedM2DecoderShamCheckpointV1::decode(
+        &closed.checkpoint().unwrap().encode().unwrap()
+    )
+    .is_err());
+    let boundary = wire.iter().position(|x| *x == b'{').unwrap();
+    let mut invalid_body = wire[..boundary].to_vec();
+    invalid_body.extend_from_slice(b"not-json");
+    assert!(matches!(
+        CpuGroupedM2DecoderCheckpointV1::decode(&invalid_body),
+        Err(CpuHostError::State(_))
+    ));
+    // A relabeled FULL controller still fails generic mode metadata before
+    // deliberately invalid source JSON can reach its positional decoder.
+    let full_wire = full.checkpoint().unwrap().encode().unwrap();
+    let full_boundary = full_wire.iter().position(|x| *x == b'{').unwrap();
+    let mut metadata: serde_json::Value = serde_json::from_slice(&wire[boundary..]).unwrap();
+    let foreign: serde_json::Value = serde_json::from_slice(&full_wire[full_boundary..]).unwrap();
+    metadata["controllers"] = foreign["controllers"].clone();
+    metadata["source_inputs"] = serde_json::json!("not-a-source");
+    let mut relabeled = wire[..boundary].to_vec();
+    relabeled.extend(serde_json::to_vec(&metadata).unwrap());
+    assert!(matches!(
+        CpuGroupedM2DecoderShamCheckpointV1::decode(&relabeled),
+        Err(CpuHostError::State(_))
+    ));
+    let mut cold = CpuGroupedM2DecoderShamHostV1::restore(
+        CpuGroupedM2DecoderShamCheckpointV1::decode(&wire).unwrap(),
+        &inputs,
+        MediationModeV1::Full,
+    )
+    .unwrap();
+    assert_eq!(wire, cold.checkpoint().unwrap().encode().unwrap());
+    for t in [1.17, 0.73, 1.37] {
+        let a = warm.step(t).unwrap();
+        let b = cold.step(t).unwrap();
+        assert_eq!(a.decisions.len(), b.decisions.len());
+        for (a, b) in a.decisions.iter().zip(&b.decisions) {
+            assert_eq!(a.action, b.action);
+            assert_eq!(bytes(&a.patch), bytes(&b.patch));
+        }
+        assert_eq!(
+            warm.checkpoint().unwrap().encode().unwrap(),
+            cold.checkpoint().unwrap().encode().unwrap()
+        );
+        assert_eq!(source(&warm.inner).weight_generation, 0);
+        assert_eq!(frozen(&warm), frozen_before);
+        assert_eq!(frozen(&cold), frozen_before);
+    }
+    let before_failure = warm.checkpoint().unwrap().encode().unwrap();
+    assert!(warm.step(f32::NAN).is_err());
+    assert_eq!(before_failure, warm.checkpoint().unwrap().encode().unwrap());
+    // No request to equate later FULL/SHAM trajectories after weights diverge.
+}
+#[test]
+fn grouped_sham_rejects_full_credit_wrong_provenance_and_reuse() {
+    let (mut host, _) = sham_fixture(240);
+    let step = host.step(0.73).unwrap();
+    let d = &step.decisions[0];
+    let evidence = &d.diagnostic;
+    let record = host.world().organism_registry().get(d.organism_id).unwrap();
+    let development = record
+        .phenotype()
+        .development_state_at(step.tick_before)
+        .unwrap();
+    let parameters = record.phenotype().brain_genome.plasticity_parameters();
+    let apply = |state: &mut CpuOrganismState, receptors: &NeuralReceptorFrame| {
+        state.apply_grouped_decoder_sham_credit(
+            &host.inner.founder,
+            &d.patch,
+            receptors,
+            &development,
+            parameters,
+        )
+    };
+    let mut pending = evidence.staged.clone();
+    assert!(pending
+        .apply_grouped_decoder_credit(
+            &host.inner.founder,
+            &d.patch,
+            &evidence.receptors,
+            &development,
+            parameters
+        )
+        .is_err());
+    assert!(pending.checkpoint().is_err());
+    for kind in 0..9 {
+        let mut bad = evidence.staged.clone();
+        bad.corrupt_grouped_binding_for_test(kind);
+        assert!(apply(&mut bad, &evidence.receptors).is_err());
+    }
+    let mut wrong = evidence.receptors.clone();
+    wrong.source_tick = Tick(wrong.source_tick.raw() + 1);
+    assert!(apply(&mut pending, &wrong).is_err());
+    let credit = apply(&mut pending, &evidence.receptors).unwrap();
+    assert_eq!(&credit, host.last_credit(d.organism_id).unwrap());
+    let acquired = pending.checkpoint().unwrap();
+    assert!(apply(&mut pending, &evidence.receptors).is_err());
+    assert_eq!(acquired, pending.checkpoint().unwrap());
+    // Mode alone cannot be switched on an acquired controller, even internally.
+    let mut motor = host
+        .inner
+        .host
+        .residents
+        .values()
+        .next()
+        .unwrap()
+        .grouped
+        .as_ref()
+        .unwrap()
+        .motor
+        .clone();
+    assert!(motor.enable_decoder_learning_fresh().is_err());
+    assert!(motor.enable_decoder_sham_fresh().is_err());
+    // Sidecar mode tampering invalidates resident authority and export.
+    let r = host.inner.host.residents.values_mut().next().unwrap();
+    r.grouped
+        .as_mut()
+        .unwrap()
+        .decoder_sham
+        .as_mut()
+        .unwrap()
+        .work_policy
+        .push_str("-wrong");
+    assert!(host.checkpoint().is_err());
+}
+#[test]
+fn grouped_sham_nonzero_trace_survives_memory_sleep_and_waking() {
+    let (mut host, inputs) = sham_fixture(1200);
+    let initial = source(&host.inner);
+    let mut physical_sleep = false;
+    let mut acquired = false;
+    let mut consolidations = 0;
+    let mut waking = false;
+    let mut resumed = false;
+    for _ in 0..24 {
+        let before = source(&host.inner);
+        let step = host.step(0.73).unwrap();
+        let after = source(&host.inner);
+        assert_eq!(bytes(&initial.fast), bytes(&after.fast));
+        assert_eq!(after.weight_generation, 0);
+        acquired |= after.eligibility.iter().any(|x| *x != 0.);
+        for d in &step.decisions {
+            physical_sleep |= d.physical.successful_stationary_body_sleep;
+            if waking {
+                resumed = true;
+            }
+        }
+        if step.sleep_consolidations > 0 {
+            assert!(acquired);
+            assert_eq!(before, after);
+            let r = host.inner.host.residents.values().next().unwrap();
+            validate_grouped_sleep_boundary(r).unwrap();
+            let sham_digest = grouped_sleep_output_digest(r).unwrap();
+            let mut swapped = r.clone();
+            swapped.grouped.as_mut().unwrap().decoder_sham = None;
+            assert_ne!(sham_digest, grouped_sleep_output_digest(&swapped).unwrap());
+            if let ConsolidationState::Committed {
+                cycle_id,
+                output_generation,
+                ..
+            } = r.sleep.state().consolidation
+            {
+                assert_eq!(cycle_id, output_generation);
+            } else {
+                panic!("missing committed memory-only cycle");
+            }
+        }
+        consolidations += step.sleep_consolidations;
+        waking |= host
+            .inner
+            .host
+            .residents
+            .values()
+            .any(|r| r.sleep.state().phase == SleepPhase::Waking);
+        let wire = host.checkpoint().unwrap().encode().unwrap();
+        host = CpuGroupedM2DecoderShamHostV1::restore(
+            CpuGroupedM2DecoderShamCheckpointV1::decode(&wire).unwrap(),
+            &inputs,
+            MediationModeV1::Full,
+        )
+        .unwrap();
+        assert_eq!(wire, host.checkpoint().unwrap().encode().unwrap());
+        if consolidations > 0 && waking && resumed {
+            break;
+        }
+    }
+    assert!(
+        physical_sleep && acquired && waking && resumed,
+        "Declared bound did not observe sham sleep/trace/wake chain; do not force or retune"
+    );
+    assert_eq!(consolidations, 1);
+}
