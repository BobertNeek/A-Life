 //! A reflex is an environment response, never an extra sampled motor factor.
 use super::*;
 use serde::{Deserialize, Serialize};
+
+// Comparison key for the public enum, matching the pinned core ordering.
+// This is local to world evidence validation; it adds no core API or channel.
+fn recovery_reflex_channel_key(channel: MotorChannel) -> u16 {
+    match channel {
+        MotorChannel::Locomotion => 0,
+        MotorChannel::Orientation => 1,
+        MotorChannel::Manipulation => 2,
+        MotorChannel::Vocal => 3,
+        MotorChannel::Posture => 4,
+        MotorChannel::SpeciesSpecific(id) => 0x100 + u16::from(id),
+    }
+}
 
