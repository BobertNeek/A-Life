+//! Explicit source-owned host recipes. No public arbitrary recipe loader or migration.
+use super::*;
+
+/// Explicit opt-in for fresh, separately owned full-runtime experiments.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PlayNeedArmV1 {
+    Candidate,
+    PaddedSham,
+}
+impl PlayNeedArmV1 {
+    pub(crate) const fn owner(self) -> HostRecipeV1 {
+        match self {
+            Self::Candidate => HostRecipeV1::PlayNeedCandidate76,
+            Self::PaddedSham => HostRecipeV1::PlayNeedPaddedSham76,
+        }
+    }
+    pub fn recipe_sha256(self) -> &'static str {
+        self.owner().recipe_sha256()
+    }
+    pub fn work_policy(self) -> &'static str {
+        self.owner().work_policy()
+    }
+    pub fn owner_identity(self) -> &'static str {
+        self.owner().schema()
+    }
+}
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
+pub(crate) enum HostRecipeV1 {
+    #[default]
+    Original60,
+    PlayNeedCandidate76,
+    PlayNeedPaddedSham76,
+}
+impl HostRecipeV1 {
+    pub(crate) fn is_original(&self) -> bool {
+        *self == Self::Original60
+    }
+    pub(crate) const fn recipe_sha256(self) -> &'static str {
+        match self {
+            Self::Original60 => M2_RECIPE_SHA256,
+            Self::PlayNeedCandidate76 => {
+                "301954e2573a45428f492244640b045d32c7a5da1beb450c43db48edc5c7eec3"
+            }
+            Self::PlayNeedPaddedSham76 => {
+                "aab2e50a8f34c052df2f243f434f807191ad7adf519810a3ac499ba707dca942"
+            }
+        }
+    }
+    pub(crate) fn manifest(self) -> &'static str {
+        match self {
+            Self::Original60 => MANIFEST,
+            Self::PlayNeedCandidate76 => include_str!(
+                "../../../../../docs/experiments/m2-play-need-owned-v1/candidate-recipe.json"
+            ),
+            Self::PlayNeedPaddedSham76 => include_str!(
+                "../../../../../docs/experiments/m2-play-need-owned-v1/padded-sham-recipe.json"
+            ),
+        }
+    }
+    pub(crate) const fn drive_rows(self) -> usize {
+        match self {
+            Self::Original60 => 60,
+            _ => 76,
+        }
+    }
+    pub(crate) fn work(self) -> MediationWorkV1 {
+        let mut work = MediationWorkV1::expected();
+        work.drive_products = self.drive_rows() as u64 * SLOTS as u64;
+        work
+    }
+    pub(crate) const fn extension_q24(self) -> u64 {
+        // Original 1,016 includes all 60 virtual common-Rest drive rows.
+        1016 + 4 * (self.drive_rows() as u64 - 60)
+    }
+    pub(crate) const fn schema(self) -> &'static str {
+        match self {
+            Self::Original60 => "grouped-m2-host-appendage-v1-confidence-v2-learning-closed",
+            Self::PlayNeedCandidate76 => {
+                "grouped-m2-play-need-candidate76-v1-confidence-v2-learning-closed"
+            }
+            Self::PlayNeedPaddedSham76 => {
+                "grouped-m2-play-need-padded-sham76-v1-confidence-v2-learning-closed"
+            }
+        }
+    }
+    pub(crate) const fn work_policy(self) -> &'static str {
+        match self { Self::Original60 => super::confidence::GROUPED_HOST_WORK_POLICY_V1,
+            Self::PlayNeedCandidate76 => "play-need-candidate76-v1;source-once;460-native-cells;830-fixed-rows;2432-ordinary-drive-products;76-virtual-drive-products;native-semantic-work-v1;host-bookkeeping-unpriced",
+            Self::PlayNeedPaddedSham76 => "play-need-padded-sham76-v1;source-once;460-native-cells;830-fixed-rows;2432-ordinary-drive-products;76-virtual-drive-products;native-semantic-work-v1;host-bookkeeping-unpriced" }
+    }
+    pub(crate) fn validate_frame(self, frame: &PerceptionFrame) -> Result<(), TrainingError> {
+        if self.is_original() {
+            return Ok(());
+        }
+        let derived = prepare_sleep_choice_grounded_drive_features_v1(frame)?;
+        for (c, lanes) in frame.candidates().iter().zip(derived) {
+            if c.family == CandidateActionFamily::Other {
+                let object = lanes[0] != 0.;
+                // Reject future object-grounded Other aliases rather than let a
+                // Play-only intervention silently apply to another operation.
+                if object
+                    && (c.action_id != ActionId(213)
+                        || c.kind != ActionKind::Interact
+                        || !matches!(c.observation, CandidateObservationRef::ObjectSlot(_)))
+                    || c.action_id == ActionId(213) && !object
+                {
+                    return Err(invalid());
+                }
+            }
+        }
+        Ok(())
+    }
+}
