+    assert_eq!(MediationWorkV1::expected().cost_q24().unwrap(), 27_344);
+    for a in arms {
+        assert_eq!(a.work().drive_products, a.drive_rows() as u64 * 32);
+        for b in arms {
+            assert_eq!(Lowered::pinned_for(b.manifest(), a).is_ok(), a == b);
+        }
+        assert!(Lowered::pinned_for(&(a.manifest().to_owned() + " "), a).is_err());
+    }
+    for arm in &arms[1..] {
+        assert_eq!(arm.work().cost_q24().unwrap(), 29_392);
+        assert_eq!(arm.extension_q24(), 1080);
+        assert_eq!(arm.work().cost_q24().unwrap() + arm.extension_q24()
+            - MediationWorkV1::expected().cost_q24().unwrap() - arms[0].extension_q24(), 2112);
+    }
+    let original: serde_json::Value = serde_json::from_str(MANIFEST).unwrap();
+    let candidate: serde_json::Value = serde_json::from_str(arms[1].manifest()).unwrap();
+    let sham: serde_json::Value = serde_json::from_str(arms[2].manifest()).unwrap();
