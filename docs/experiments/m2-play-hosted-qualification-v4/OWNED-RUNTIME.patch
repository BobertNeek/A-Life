+    for i in 0..60 { assert_eq!(candidate["drive_proposal_readouts"][i], original["drive_proposal_readouts"][i]); assert_eq!(sham["drive_proposal_readouts"][i], original["drive_proposal_readouts"][i]); }
+    for i in 60..76 {
+        for field in ["source", "family", "cue"] { assert_eq!(candidate["drive_proposal_readouts"][i][field], sham["drive_proposal_readouts"][i][field]); }
+        assert_eq!(sham["drive_proposal_readouts"][i]["weight"].as_f64(), Some(0.));
+    }
+}
