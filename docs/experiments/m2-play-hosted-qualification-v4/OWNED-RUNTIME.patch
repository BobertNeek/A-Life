+//! Source-only authored tests. Execution requires a separately admitted new build.
+use super::*;
+use crate::{AdamWConfig, StageTrainableMask};
+use alife_world::*;
+#[allow(dead_code)]
+#[path = "grouped_host_fixture.rs"]
+mod recipe;
+const SEED: u64 = 0x004f_5054_564f_4331;
+fn inputs() -> (
+    CanonicalNewGame,
+    CpuFoundationTrainer,
+    PhenotypeCompilerInputs,
+) {
+    let r = recipe::build(SEED, true).unwrap();
+    let founder = CpuFoundationTrainer::new(
+        r.phenotype.clone(),
+        r.asset,
+        StageTrainableMask::recurrent_only(&r.phenotype).unwrap(),
+        AdamWConfig::default(),
+    )
+    .unwrap();
+    let mut game = create_grounded_drive_research_new_game(&r.config, &r.genotype).unwrap();
+    let newborn = game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .unwrap()
+        .clone();
+    let mut blank = HeadlessScenarioBuilder::new(SEED)
+        .agent("learner", newborn.organism_id(), Vec3f::ZERO)
+        .build()
+        .unwrap();
+    blank
+        .register_grounded_drive_research_record(newborn)
+        .unwrap();
+    game.world = blank;
+    (game, founder, r.inputs)
+}
+fn fresh(arm: PlayNeedArmV1) -> (CpuPlayNeedM2HostV1, PhenotypeCompilerInputs) {
+    let (game, founder, inputs) = inputs();
+    let (host, ()) =
+        CpuPlayNeedM2HostV1::new_prepared(arm, game, founder, inputs.clone(), SEED as u32, |_| {
+            Ok::<_, String>(())
+        })
+        .unwrap();
+    (host, inputs)
+}
+fn magic(arm: PlayNeedArmV1) -> &'static [u8] {
+    match arm {
+        PlayNeedArmV1::Candidate => OptionalVocalPolicy::<1>::MAGIC,
+        PlayNeedArmV1::PaddedSham => OptionalVocalPolicy::<2>::MAGIC,
+    }
+}
+fn alter(bytes: &[u8], arm: PlayNeedArmV1, f: impl FnOnce(&mut serde_json::Value)) -> Vec<u8> {
+    let mut data: serde_json::Value =
+        serde_json::from_slice(bytes.strip_prefix(magic(arm)).unwrap()).unwrap();
+    f(&mut data);
+    let mut out = magic(arm).to_vec();
+    out.extend(serde_json::to_vec(&data).unwrap());
+    out
+}
+#[test]
+fn play_owned_public_full_host_cold_continuation_and_cost() {
+    for arm in [PlayNeedArmV1::Candidate, PlayNeedArmV1::PaddedSham] {
+        let (mut warm, inputs) = fresh(arm);
+        let frozen = serde_json::to_vec(&warm.inner.founder.checkpoint()).unwrap();
+        let zero_wire = warm.checkpoint().unwrap().encode().unwrap();
+        let zero = CpuPlayNeedM2HostCheckpointV1::decode(arm, &zero_wire).unwrap();
+        assert_eq!(
+            CpuPlayNeedM2HostV1::restore(arm, zero, &inputs)
+                .unwrap()
+                .checkpoint()
+                .unwrap()
+                .encode()
+                .unwrap(),
+            zero_wire
+        );
+        let first = warm.step(0.73).unwrap();
+        assert_eq!(first.decisions.len(), 1);
+        let d = &first.decisions[0];
+        assert_eq!(d.motor.native.core.source_execution_count, 1);
+        assert_eq!(d.motor.native.core.recipe, arm.recipe_sha256());
+        assert_eq!(d.motor.native.core.work.drive_products, 2432);
+        assert_eq!(
+            d.motor.native.extension_arithmetic_q24,
+            1080 + 4 * d.motor.native.extension_source_products
+        );
+        let scores = warm.last_selection_scores(d.organism_id).unwrap();
+        assert!(!scores.source().payload_present());
+        assert_eq!(scores.physical_selection(&d.action).unwrap().1[3], None);
+        assert_eq!(
+            serde_json::to_vec(&warm.inner.founder.checkpoint()).unwrap(),
+            frozen
+        );
+        let wire = warm.checkpoint().unwrap().encode().unwrap();
+        let mut cold = CpuPlayNeedM2HostV1::restore(
+            arm,
+            CpuPlayNeedM2HostCheckpointV1::decode(arm, &wire).unwrap(),
+            &inputs,
+        )
+        .unwrap();
+        assert_eq!(cold.checkpoint().unwrap().encode().unwrap(), wire);
+        let a = warm.step_research_observed(0.73).unwrap();
+        let b = cold.step_research_observed(0.73).unwrap();
+        assert_eq!(a.world_receipts.len(), b.world_receipts.len());
+        assert_eq!(a.step.decisions.len(), b.step.decisions.len());
+        for (a, b) in a.step.decisions.iter().zip(&b.step.decisions) {
+            assert_eq!(
+                serde_json::to_vec(&a.action).unwrap(),
+                serde_json::to_vec(&b.action).unwrap()
+            );
+            assert_eq!(
+                serde_json::to_vec(&a.motor).unwrap(),
+                serde_json::to_vec(&b.motor).unwrap()
+            );
+        }
+        assert_eq!(
+            warm.checkpoint().unwrap().encode().unwrap(),
+            cold.checkpoint().unwrap().encode().unwrap()
+        );
+        assert!(warm.actor_optimization().is_err());
+        assert!(warm.waking_synaptic_plasticity().is_err());
+        assert!(warm.synaptic_sleep_consolidation().is_err());
+    }
+}
+#[test]
+fn play_owned_cold_cross_owner_recipe_cost_and_mode_reject() {
+    for arm in [PlayNeedArmV1::Candidate, PlayNeedArmV1::PaddedSham] {
+        let other = match arm {
+            PlayNeedArmV1::Candidate => PlayNeedArmV1::PaddedSham,
+            PlayNeedArmV1::PaddedSham => PlayNeedArmV1::Candidate,
+        };
+        let (mut host, inputs) = fresh(arm);
+        host.step(0.73).unwrap();
+        let wire = host.checkpoint().unwrap().encode().unwrap();
+        assert!(CpuPlayNeedM2HostCheckpointV1::decode(other, &wire).is_err());
+        assert!(CpuOptionalVocalM2HostCheckpointV1::decode(&wire).is_err());
+        assert!(CpuGroupedM2HostCheckpointV1::decode(&wire).is_err());
+        assert!(CpuPlayNeedM2HostV1::restore(
+            other,
+            CpuPlayNeedM2HostCheckpointV1::decode(arm, &wire).unwrap(),
+            &inputs
+        )
+        .is_err());
+        for field in [
+            "recipe_owner",
+            "schema",
+            "m2_recipe",
+            "work_policy",
+            "group_recipe",
+        ] {
+            let bad = alter(&wire, arm, |v| {
+                v["controllers"]
+                    .as_object_mut()
+                    .unwrap()
+                    .values_mut()
+                    .next()
+                    .unwrap()["motor"][field] = "wrong-owner".into();
+            });
+            assert!(
+                CpuPlayNeedM2HostCheckpointV1::decode(arm, &bad).is_err(),
+                "{field}"
+            );
+        }
+        let bad = alter(&wire, arm, |v| v["mode"] = "DriveSham".into());
+        assert!(CpuPlayNeedM2HostCheckpointV1::decode(arm, &bad).is_err());
+        let bad = alter(&wire, arm, |v| {
+            v["controllers"]
+                .as_object_mut()
+                .unwrap()
+                .values_mut()
+                .next()
+                .unwrap()["motor"]["last_receipt"]["native"]["core"]["work"]["drive_products"] =
+                1920.into();
+        });
+        assert!(CpuPlayNeedM2HostCheckpointV1::decode(arm, &bad).is_err());
+        let bad = alter(&wire, arm, |v| {
+            v["controllers"]
+                .as_object_mut()
+                .unwrap()
+                .values_mut()
+                .next()
+                .unwrap()["motor"]["last_receipt"]["reservation_q24"] = 0.into();
+        });
+        let decoded = CpuPlayNeedM2HostCheckpointV1::decode(arm, &bad).unwrap();
+        assert!(CpuPlayNeedM2HostV1::restore(arm, decoded, &inputs).is_err());
+        // Coordinated proof + charge edits are still rejected by the existing
+        // canonical-world authority digest over the entire grouped resident.
+        let bad = alter(&wire, arm, |v| {
+            let r = &mut v["controllers"]
+                .as_object_mut()
+                .unwrap()
+                .values_mut()
+                .next()
+                .unwrap()["motor"]["last_receipt"];
+            r["play_work"]["dynamic_q24"] = 0.into();
+            r["reservation_q24"] = 0.into();
+            r["reservation_q16"] = 0.into();
+        });
+        let decoded = CpuPlayNeedM2HostCheckpointV1::decode(arm, &bad).unwrap();
+        assert!(CpuPlayNeedM2HostV1::restore(arm, decoded, &inputs).is_err());
+        let bad = alter(&wire, arm, |v| {
+            v["controllers"]
+                .as_object_mut()
+                .unwrap()
+                .values_mut()
+                .next()
+                .unwrap()["motor"]["last_receipt"]["applied_body_energy_debit"] = 0.into();
+        });
+        let decoded = CpuPlayNeedM2HostCheckpointV1::decode(arm, &bad).unwrap();
+        assert!(CpuPlayNeedM2HostV1::restore(arm, decoded, &inputs).is_err());
+        // Even with a rewritten outer label, legacy admission checks the new
+        // nested motor identity before attempting historical source decoding.
+        let mut v: serde_json::Value =
+            serde_json::from_slice(wire.strip_prefix(magic(arm)).unwrap()).unwrap();
+        v["source_lineage"] = OPTIONAL_LINEAGE.into();
+        v["policy"] = OPTIONAL_VOCAL_POLICY_V1.into();
+        v["source_inputs"] = "must-not-decode".into();
+        let mut forged = OPTIONAL_MAGIC.to_vec();
+        forged.extend(serde_json::to_vec(&v).unwrap());
+        assert!(matches!(
+            CpuOptionalVocalM2HostCheckpointV1::decode(&forged),
+            Err(CpuHostError::State(
+                "motor owner/recipe/work identity mismatch"
+            ))
+        ));
+    }
+}
+#[test]
+fn play_owned_baseline_default_wire_and_no_import() {
+    let (game, founder, inputs) = inputs();
+    let (mut baseline, ()) = CpuOptionalVocalM2HostV1::new_prepared(
+        game,
+        founder,
+        inputs.clone(),
+        SEED as u32,
+        MediationModeV1::Full,
+        |_| Ok::<_, String>(()),
+    )
+    .unwrap();
+    baseline.step(0.73).unwrap();
+    let wire = baseline.checkpoint().unwrap().encode().unwrap();
+    let data: serde_json::Value =
+        serde_json::from_slice(wire.strip_prefix(OPTIONAL_MAGIC).unwrap()).unwrap();
+    let motor = &data["controllers"]
+        .as_object()
+        .unwrap()
+        .values()
+        .next()
+        .unwrap()["motor"];
+    assert!(motor.get("recipe_owner").is_none());
+    assert!(motor["last_receipt"].get("play_work").is_none());
+    assert_eq!(motor["m2_recipe"], crate::cpu::M2_RECIPE_SHA256);
+    assert_eq!(
+        motor["last_receipt"]["native"]["core"]["work"]["drive_products"],
+        1920
+    );
+    for arm in [PlayNeedArmV1::Candidate, PlayNeedArmV1::PaddedSham] {
+        assert!(CpuPlayNeedM2HostCheckpointV1::decode(arm, &wire).is_err());
+        let mut forged_data = data.clone();
+        let (lineage, policy) = match arm {
+            PlayNeedArmV1::Candidate => (
+                OptionalVocalPolicy::<1>::LINEAGE,
+                OptionalVocalPolicy::<1>::POLICY,
+            ),
+            PlayNeedArmV1::PaddedSham => (
+                OptionalVocalPolicy::<2>::LINEAGE,
+                OptionalVocalPolicy::<2>::POLICY,
+            ),
+        };
+        forged_data["source_lineage"] = lineage.into();
+        forged_data["policy"] = policy.into();
+        forged_data["source_inputs"] = "must-not-decode".into();
+        let mut forged = magic(arm).to_vec();
+        forged.extend(serde_json::to_vec(&forged_data).unwrap());
+        assert!(matches!(
+            CpuPlayNeedM2HostCheckpointV1::decode(arm, &forged),
+            Err(CpuHostError::State(
+                "motor owner/recipe/work identity mismatch"
+            ))
+        ));
+    }
+    let cold = CpuOptionalVocalM2HostV1::restore(
+        CpuOptionalVocalM2HostCheckpointV1::decode(&wire).unwrap(),
+        &inputs,
+        MediationModeV1::Full,
+    )
+    .unwrap();
+    assert_eq!(cold.checkpoint().unwrap().encode().unwrap(), wire);
+}
