+#[test]
+fn play_owned_full_native_source_sham_nonplay_group_parity_and_alias_rejection() {
+    for rich in [false, true] {
+        let (original, founder, mut q, _, mut receptors, _) = fixture();
+        let p=founder.phenotype();
+        let f=play_owned_frame(rich,213);
+        receptors.source_tick=f.tick();
+        let effects=NeuralReceptorEffects::from_frame(&receptors,&NeuralReceptorPhenotype::compile(p).unwrap()).unwrap();
+        let detached=RecoveryGroupDetachedCpuV2::fresh(&original.source_inputs,&founder.source_foundation,MediationModeV1::Full).unwrap();
+        q.ticks=vec![super::super::tests::tick(&detached,&f)];
+        let mut motors=vec![];
+        let mut source_bits=vec![];
+        for arm in [HostRecipeV1::Original60,HostRecipeV1::PlayNeedPaddedSham76,HostRecipeV1::PlayNeedCandidate76] {
+            let mut state=GroupedMotorStateV1::fresh_for(&original.source_inputs,p,MediationModeV1::Full,arm).unwrap();
+            let before=serde_json::to_vec(&state).unwrap();
+            if rich && !arm.is_original() {
+                let alias=play_owned_frame(true,999);
+                assert!(state.forward(p,founder.weights(),&q,&alias,&receptors,&effects,[true;6],(1<<f.candidates().len())-1).is_err());
+                assert_eq!(serde_json::to_vec(&state).unwrap(),before);
+            }
+            let result=state.forward(p,founder.weights(),&q,&f,&receptors,&effects,[true;6],(1<<f.candidates().len())-1).unwrap();
+            source_bits.push(bits(&result.evaluation));
+            motors.push(state);
+        }
+        assert_eq!(source_bits[0],source_bits[1]);assert_eq!(source_bits[0],source_bits[2]);
+        let receipts=motors.iter().map(|m|&m.last_receipt.as_ref().unwrap().native).collect::<Vec<_>>();
+        assert_eq!(receipts[0].core.components,receipts[1].core.components);
+        assert_eq!(receipts[0].core.core_logits,receipts[1].core.core_logits);
+        for j in 1..3 {
+            assert_eq!(receipts[0].group_components,receipts[j].group_components);
+            assert_eq!(receipts[0].extension_activations,receipts[j].extension_activations);
+            assert_eq!(receipts[0].scores.group.to_bits(),receipts[j].scores.group.to_bits());
+            assert_eq!(receipts[0].scores.operations.map(f64::to_bits),receipts[j].scores.operations.map(f64::to_bits));
+            assert_eq!(receipts[j].core.work.cost_q24().unwrap()+receipts[j].extension_arithmetic_q24
+                -receipts[0].core.work.cost_q24().unwrap()-receipts[0].extension_arithmetic_q24,2112);
+        }
+        for (i,c) in f.candidates().iter().enumerate() {
+            if c.action_id==ActionId(213) { assert!(receipts[2].core.components[i][4]>receipts[0].core.components[i][4]); }
+            else { assert_eq!(receipts[0].core.core_logits[i].to_bits(),receipts[2].core.core_logits[i].to_bits()); }
+        }
+    }
+}
+#[test]
+fn play_owned_state_and_cheaper_receipt_rejection() {
+    let (original,founder,_,_,_,_)=fixture();let p=founder.phenotype();
+    let a=HostRecipeV1::PlayNeedCandidate76;let b=HostRecipeV1::PlayNeedPaddedSham76;
+    let candidate=GroupedMotorStateV1::fresh_for(&original.source_inputs,p,MediationModeV1::Full,a).unwrap();
+    assert!(candidate.validate_owner(b).is_err());assert!(candidate.validate_owner(HostRecipeV1::Original60).is_err());
+    for mode in [MediationModeV1::DriveSham,MediationModeV1::DirectSource] { assert!(GroupedMotorStateV1::fresh_for(&original.source_inputs,p,mode,a).is_err()); }
+    let mut corrupt=candidate.clone();corrupt.m2_recipe=M2_RECIPE_SHA256.into();assert!(corrupt.validate(p).is_err());
+    let mut corrupt=candidate.clone();corrupt.work_policy=GROUPED_HOST_WORK_POLICY_V1.into();assert!(corrupt.validate(p).is_err());
+    let mut corrupt=candidate.clone();corrupt.activations[0]=0.125;assert!(corrupt.validate(p).is_err());
+    let base=BrainWorkCounters::default();
+    let old=GroupedMotorStateV1::work(p,&base,0,u32::MAX).unwrap();
+    let new=GroupedMotorStateV1::work_for(p,&base,0,u32::MAX,a).unwrap();
+    assert_eq!(new.0-old.0,2112);
+    assert_eq!(new,GroupedMotorStateV1::work_for(p,&base,0,u32::MAX,b).unwrap());
+    assert!(new.1>old.1);
+    assert!(GroupedMotorStateV1::work(p,&base,0,old.1).unwrap().2);
+    assert!(!GroupedMotorStateV1::work_for(p,&base,0,old.1,a).unwrap().2);
+}
