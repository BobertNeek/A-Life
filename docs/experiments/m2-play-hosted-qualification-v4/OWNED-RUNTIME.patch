+//! Explicit fresh candidate/sham entry points for the complete registered host.
+//! No conversion from the qualified baseline or another arm is provided.
+use super::*;
+use crate::cpu::PlayNeedArmV1;
+
+pub struct CpuPlayNeedM2HostV1 {
+    inner: CpuGroupedM2HostV1,
+    arm: PlayNeedArmV1,
+}
+#[derive(Debug, Clone)]
+pub struct CpuPlayNeedM2HostCheckpointV1 {
+    arm: PlayNeedArmV1,
+    payload: GroupedPayloadV1,
+}
+impl CpuPlayNeedM2HostCheckpointV1 {
+    pub fn arm(&self) -> PlayNeedArmV1 {
+        self.arm
+    }
+    pub fn encode(&self) -> Result<Vec<u8>, CpuHostError> {
+        let magic = match self.arm {
+            PlayNeedArmV1::Candidate => OptionalVocalPolicy::<1>::MAGIC,
+            PlayNeedArmV1::PaddedSham => OptionalVocalPolicy::<2>::MAGIC,
+        };
+        let mut bytes = magic.to_vec();
+        bytes.extend(serde_json::to_vec(&self.payload)?);
+        Ok(bytes)
+    }
+    /// The expected owner is mandatory. Magic is checked before JSON, and
+    /// pinned owner/recipe/work metadata before historical source codecs.
+    pub fn decode(expected_arm: PlayNeedArmV1, bytes: &[u8]) -> Result<Self, CpuHostError> {
+        match expected_arm {
+            PlayNeedArmV1::Candidate => Self::decode_for::<1>(expected_arm, bytes),
+            PlayNeedArmV1::PaddedSham => Self::decode_for::<2>(expected_arm, bytes),
+        }
+    }
+    fn decode_for<const ARM: u8>(arm: PlayNeedArmV1, bytes: &[u8]) -> Result<Self, CpuHostError> {
+        let body = bytes
+            .strip_prefix(OptionalVocalPolicy::<ARM>::MAGIC)
+            .ok_or(CpuHostError::State(
+                "not the expected Play-need owner envelope",
+            ))?;
+        let metadata: serde_json::Value = serde_json::from_slice(body)?;
+        if metadata["schema_version"] != 1
+            || metadata["source_lineage"] != OptionalVocalPolicy::<ARM>::LINEAGE
+            || metadata["policy"] != OptionalVocalPolicy::<ARM>::POLICY
+            || metadata["runtime_profile_raw"] != 5
+            || metadata["selector_tag"] != 12
+            || metadata["decoder_stride"] != 55
+            || metadata["mode"] != "Full"
+            || metadata["recipe_digest"] != RECOVERY_GROUP_CONFIDENCE_RECIPE_SHA256
+            || metadata["canonical"]["schema_version"] != OPTIONAL_VOCAL_CANONICAL_SCHEMA
+            || !metadata["canonical"]["residents"]
+                .as_array()
+                .is_some_and(|rows| {
+                    !rows.is_empty()
+                        && rows.iter().all(|r| {
+                            r["neural"]["schema_version"]
+                                == crate::cpu::organism::OPTIONAL_VOCAL_NEURAL_SCHEMA
+                        })
+                })
+        {
+            return Err(CpuHostError::State("Play-need outer identity mismatch"));
+        }
+        validate_motor_metadata::<OptionalVocalPolicy<ARM>>(&metadata)?;
+        let mut payload: GroupedPayloadV1 = serde_json::from_value(metadata.clone())?;
+        payload.restore_sampler_bits()?;
+        for state in payload.controllers.values() {
+            state.validate_policy::<OptionalVocalPolicy<ARM>>()?;
+        }
+        if serde_json::from_slice::<serde_json::Value>(&serde_json::to_vec(&payload)?)? != metadata
+        {
+            return Err(CpuHostError::State("Play-need noncanonical nested state"));
+        }
+        Ok(Self { arm, payload })
+    }
+}
+impl CpuPlayNeedM2HostV1 {
+    /// Fresh genetic inputs only. Full mode is fixed; padded sham is not the
+    /// old DriveSham intervention, which disables every drive route.
+    pub fn new_prepared<T, E: std::fmt::Display>(
+        arm: PlayNeedArmV1,
+        game: CanonicalNewGame,
+        founder: CpuFoundationTrainer,
+        source_inputs: PhenotypeCompilerInputs,
+        sampling_seed: u32,
+        prepare: impl FnOnce(&mut HeadlessWorld) -> Result<T, E>,
+    ) -> Result<(Self, T), CpuHostError> {
+        let (inner, value) = match arm {
+            PlayNeedArmV1::Candidate => {
+                CpuGroupedM2HostV1::new_prepared_policy::<OptionalVocalPolicy<1>, T, E>(
+                    game,
+                    founder,
+                    source_inputs,
+                    sampling_seed,
+                    MediationModeV1::Full,
+                    prepare,
+                )?
+            }
+            PlayNeedArmV1::PaddedSham => {
+                CpuGroupedM2HostV1::new_prepared_policy::<OptionalVocalPolicy<2>, T, E>(
+                    game,
+                    founder,
+                    source_inputs,
+                    sampling_seed,
+                    MediationModeV1::Full,
+                    prepare,
+                )?
+            }
+        };
+        Ok((Self { inner, arm }, value))
+    }
+    pub fn arm(&self) -> PlayNeedArmV1 {
+        self.arm
+    }
+    pub fn world(&self) -> &HeadlessWorld {
+        self.inner.world()
+    }
+    pub fn sleep_state(&self, id: OrganismId) -> Option<alife_core::sleep::SleepState> {
+        self.inner.sleep_state(id)
+    }
+    pub fn last_selection_scores(&self, id: OrganismId) -> Option<&OptionalVocalScoresV1> {
+        self.inner
+            .host
+            .residents
+            .get(&id.raw())?
+            .grouped
+            .as_ref()?
+            .optional_vocal
+            .as_ref()?
+            .last
+            .as_ref()
+            .map(|s| &s.scores)
+    }
+    pub fn checkpoint(&self) -> Result<CpuPlayNeedM2HostCheckpointV1, CpuHostError> {
+        let payload = match self.arm {
+            PlayNeedArmV1::Candidate => {
+                self.inner.checkpoint_payload::<OptionalVocalPolicy<1>>()?
+            }
+            PlayNeedArmV1::PaddedSham => {
+                self.inner.checkpoint_payload::<OptionalVocalPolicy<2>>()?
+            }
+        };
+        Ok(CpuPlayNeedM2HostCheckpointV1 {
+            arm: self.arm,
+            payload,
+        })
+    }
+    pub fn restore(
+        expected_arm: PlayNeedArmV1,
+        checkpoint: CpuPlayNeedM2HostCheckpointV1,
+        expected_source: &PhenotypeCompilerInputs,
+    ) -> Result<Self, CpuHostError> {
+        if checkpoint.arm != expected_arm {
+            return Err(CpuHostError::State("Play-need checkpoint owner mismatch"));
+        }
+        let wire = checkpoint.encode()?;
+        let inner = match expected_arm {
+            PlayNeedArmV1::Candidate => {
+                CpuGroupedM2HostV1::restore_payload::<OptionalVocalPolicy<1>>(
+                    checkpoint.payload,
+                    expected_source,
+                    MediationModeV1::Full,
+                    wire,
+                )?
+            }
+            PlayNeedArmV1::PaddedSham => {
+                CpuGroupedM2HostV1::restore_payload::<OptionalVocalPolicy<2>>(
+                    checkpoint.payload,
+                    expected_source,
+                    MediationModeV1::Full,
+                    wire,
+                )?
+            }
+        };
+        Ok(Self {
+            inner,
+            arm: expected_arm,
+        })
+    }
+    pub fn step(&mut self, temperature: f32) -> Result<CpuOptionalVocalM2HostStepV1, CpuHostError> {
+        match self.arm {
+            PlayNeedArmV1::Candidate => self
+                .inner
+                .host
+                .grouped_policy_step::<OptionalVocalPolicy<1>>(&self.inner.founder, temperature),
+            PlayNeedArmV1::PaddedSham => self
+                .inner
+                .host
+                .grouped_policy_step::<OptionalVocalPolicy<2>>(&self.inner.founder, temperature),
+        }
+    }
+    pub fn step_research_observed(
+        &mut self,
+        temperature: f32,
+    ) -> Result<CpuGroupedM2ResearchStepV1<OptionalVocalActionV1>, CpuHostError> {
+        match self.arm {
+            PlayNeedArmV1::Candidate => self
+                .inner
+                .host
+                .grouped_policy_step_observed::<OptionalVocalPolicy<1>>(
+                    &self.inner.founder,
+                    temperature,
+                ),
+            PlayNeedArmV1::PaddedSham => self
+                .inner
+                .host
+                .grouped_policy_step_observed::<OptionalVocalPolicy<2>>(
+                    &self.inner.founder,
+                    temperature,
+                ),
+        }
+    }
+    pub fn actor_optimization(&mut self) -> Result<(), CpuHostError> {
+        self.inner.actor_optimization()
+    }
+    pub fn waking_synaptic_plasticity(&mut self) -> Result<(), CpuHostError> {
+        self.inner.waking_synaptic_plasticity()
+    }
+    pub fn synaptic_sleep_consolidation(&mut self) -> Result<(), CpuHostError> {
+        self.inner.synaptic_sleep_consolidation()
+    }
+}
