+        include_bytes!("support/grounded_r0_motor_operating_point.rs").as_slice(),
+        PROTOCOL,
+    ] {
+        h.update((bytes.len() as u64).to_le_bytes());
+        h.update(bytes);
+    }
+    format!("{:x}", h.finalize())
