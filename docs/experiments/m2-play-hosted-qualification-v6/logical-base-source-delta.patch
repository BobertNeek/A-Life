+fn observe(h: &CpuGroupedM2HostV1) -> Result<Observation> {
+    let r = h
+        .world()
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("resident absent")?;
+    if h.world().age_death_disabled() {
+        return Err("normal lifetime disabled".into());
+    }
+    Ok(Observation {
+        tick: h.world().tick().raw(),
+        body: r.biochemistry().body,
+        homeostasis: r.biochemistry().homeostasis,
+        age: r.biochemistry().development.age_ticks.raw(),
+        phase: r.sleep_phase(),
+        cycle: r.sleep_cycle_id(),
+        sleep: h
+            .sleep_state(r.organism_id())
+            .ok_or("sleep controller absent")?,
+        alive: r.lifecycle().is_alive(),
+        work: *r.cognitive_work(),
+        cognitive_body_energy_debit: r.cognitive_energy_debit(),
+        food_context: "bland scene; no food, toy or peer".into(),
+    })
