+fn applied_recovery(p: &SleepChoicePhysicalReceiptV1) -> Option<RecoveryOperationV1> {
+    if p.operation == Some(RecoveryOperationV1::AwakeRest) && p.awake_recovery > 0. {
+        Some(RecoveryOperationV1::AwakeRest)
+    } else if p.successful_stationary_body_sleep {
+        Some(RecoveryOperationV1::BodySleep)
+    } else {
+        None
+    }
+}
+#[derive(Serialize)]
+struct DecisionRow<'a> {
+    organism_id: OrganismId,
+    action: &'a RecoveryGroupJointActionV2,
+    probabilities: RecoveryGroupProbabilitiesV2,
+    evaluation: RecoveryGroupEvaluationV2,
+    sampling_counter: u32,
+    source_diagnostic_logits: &'a [f32],
+    biological_emissions: &'a NeuralEmissionFrame,
+    brain_work: &'a BrainWorkCounters,
+    motor: &'a GroupedMotorReceiptV1,
+    physical: &'a SleepChoicePhysicalReceiptV1,
+    applied_recovery: Option<RecoveryOperationV1>,
+    real_noop_receipts: Vec<NoopReceipt>,
+    patch: &'a ExperiencePatch,
+    sleep_phase: SleepPhase,
+    sleep_trigger: Option<alife_core::sleep::SleepTrigger>,
+}
+#[derive(Serialize)]
+struct CommitRow<'a> {
+    schema: &'static str,
+    status: &'static str,
+    offset: u64,
+    tick_before: u64,
+    tick_after: u64,
+    decisions: Vec<DecisionRow<'a>>,
+    sleeping_organisms: usize,
+    consolidations: usize,
+    checkpoint_sha256: String,
+    closed_source_sha256: String,
+}
+#[derive(Serialize)]
+struct ObservationRow<'a> {
+    schema: &'static str,
+    status: &'static str,
+    offset: u64,
+    before: &'a Observation,
+    after: &'a Observation,
+    net_change_not_causal_benefit: [f32; 5],
+    fatigue_reference_bits: u32,
+    pressure_reference_bits: u32,
+}
+fn science(
+    before: &Observation,
+    after: &Observation,
+    step: &CpuGroupedM2HostStepV1,
+    offset: u64,
+    bytes: &[u8],
+    closure: &str,
+    pressure_reference: f32,
+) -> Result<Vec<u8>> {
+    if step.tick_before.raw() != before.tick
+        || step.tick_after.raw() != after.tick
+        || after.tick != before.tick + 1
+    {
+        return Err("science clock differs".into());
+    }
+    let mut decisions = Vec::new();
+    for d in &step.decisions {
+        let scores = &d.motor.native.scores;
+        let evaluation = scores.evaluate(&d.action)?;
+        if evaluation.joint_log_probability.to_bits()
+            != d.action.old_joint_log_probability.to_bits()
+            || d.action.counter != d.sampling_counter
+            || d.motor.native.core.source_execution_count != 1
+            || d.motor.native.core.references[11].to_bits() != pressure_reference.to_bits()
+        {
+            return Err("native grouped factor/source identity differs".into());
+        }
+        decisions.push(DecisionRow {
+            organism_id: d.organism_id,
+            action: &d.action,
+            probabilities: scores.probabilities(d.action.temperature)?,
+            evaluation,
+            sampling_counter: d.sampling_counter,
+            source_diagnostic_logits: &d.source_diagnostic_logits,
+            biological_emissions: &d.biological_emissions,
+            brain_work: &d.brain_work,
+            motor: &d.motor,
+            physical: &d.physical,
+            applied_recovery: applied_recovery(&d.physical),
+            real_noop_receipts: d
+                .patch
+                .selected_bundle()
+                .map(|bundle| {
+                    bundle
+                        .channels
+                        .iter()
+                        .filter(|c| matches!(c.primitive.raw(), 103 | 104 | 212))
+                        .map(|c| NoopReceipt {
+                            channel: c.channel,
+                            primitive: c.primitive.raw(),
+                            measured: d
+                                .patch
+                                .outcome()
+                                .joint
+                                .as_ref()
+                                .and_then(|joint| {
+                                    joint
+                                        .channel_observations
+                                        .iter()
+                                        .find(|o| o.channel == c.channel)
+                                })
+                                .cloned(),
+                        })
+                        .collect()
+                })
+                .unwrap_or_default(),
+            patch: &d.patch,
+            sleep_phase: d.sleep_phase,
+            sleep_trigger: d.sleep_trigger,
+        });
+    }
+    let mut raw = serde_json::to_vec(&CommitRow {
+        schema: "grouped-m2-commit-v1",
+        status: "committed",
+        offset,
+        tick_before: before.tick,
+        tick_after: after.tick,
+        decisions,
+        sleeping_organisms: step.sleeping_organisms,
+        consolidations: step.sleep_consolidations,
+        checkpoint_sha256: hash(bytes),
+        closed_source_sha256: closure.into(),
+    })?;
+    raw.push(b'\n');
+    raw.extend(serde_json::to_vec(&ObservationRow {
+        schema: "grouped-m2-observation-v1",
+        status: "observed",
+        offset,
+        before,
+        after,
+        net_change_not_causal_benefit: [
+            after.homeostasis.drives.fatigue - before.homeostasis.drives.fatigue,
+            after.homeostasis.hormones.sleep_pressure - before.homeostasis.hormones.sleep_pressure,
+            after.homeostasis.drives.brain_atp - before.homeostasis.drives.brain_atp,
+            after.body.health - before.body.health,
+            after.body.energy - before.body.energy,
+        ],
+        fatigue_reference_bits: 0.35_f32.to_bits(),
+        pressure_reference_bits: pressure_reference.to_bits(),
+    })?);
+    raw.push(b'\n');
+    Ok(raw)
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Freeze {
+    schema: String,
+    host_commit: String,
+    host_tree: String,
+    driver_commit: String,
+    driver_code_sha256: String,
+    executable_sha256: String,
+    protocol_sha256: String,
+    qualification_sha256: String,
+    qualification_json: String,
+    reservation_sha256: String,
+    seed: u64,
+    preparation: u64,
+    horizon: u64,
+    temperature_bits: u32,
+    projected_pair_bytes: u64,
+    headroom_bytes: u64,
+}
+fn check_freeze(f: &Freeze) -> Result<()> {
+    if f.schema != "grouped-m2-source-build-freeze-v1"
+        || f.host_commit != HOST_COMMIT
+        || f.host_tree != HOST_TREE
+        || f.driver_commit != DRIVER_COMMIT
+        || f.driver_commit.len() != 40
+        || !f.driver_commit.bytes().all(|b| b.is_ascii_hexdigit())
+        || f.driver_code_sha256 != code_hash()
+        || f.executable_sha256 != executable_hash()?
+        || f.protocol_sha256 != hash(PROTOCOL)
+        || f.seed != SEED
+        || f.preparation != PREPARATION
+        || f.horizon != HORIZON
+        || f.temperature_bits != TEMPERATURE.to_bits()
+    {
+        return Err("source/executable/protocol freeze differs".into());
+    }
+    let q: Value = serde_json::from_str(&f.qualification_json)?;
+    if hash(f.qualification_json.as_bytes()) != f.qualification_sha256
+        || q["schema"] != "grouped-m2-driver-qualification-v1"
+        || q["complete"] != true
+        || q["resource_projection_adequate"] != true
+        || q["driver_commit"] != DRIVER_COMMIT
+        || q["driver_code_sha256"] != code_hash()
+        || q["executable_sha256"] != f.executable_sha256
+        || q["protocol_sha256"] != hash(PROTOCOL)
+        || q["primary_seed_executed"] != false
+        || q["composite_proof"] != true
+        || q["qualification_scope"]
+            != "admission-only; unchanged native runtime via exact prior proof"
+        || q["actual_native_calls"] != 0
+        || q["actual_preparation_intervals"] != 0
+        || q["reused_runtime_native_calls_not_this_executable"] != 50
+        || q["reused_runtime_qualification_sha256"]
+            != "5e2c13072debd852e32f902af8ad689cadf7560efe8f7432736d208a34ca492f"
+        || q["reference_native_calls_not_this_executable"] != 136
+        || q["measurement_bounds_include_longer_reference"] != true
+    {
+        return Err("embedded exact qualification differs".into());
+    }
+    let number = |name: &str| -> Result<u64> {
+        q[name]
+            .as_u64()
+            .ok_or_else(|| format!("qualification number absent: {name}").into())
+    };
+    let projected_packet = number("maximum_packet_bytes")?
+        .checked_add(number("observed_packet_growth_bytes")?.max(256 * 1024))
+        .ok_or("projection overflow")?;
+    let pair = projected_packet
+        .checked_mul(2 * HORIZON)
+        .ok_or("pair projection overflow")?;
+    let trace = number("maximum_science_row_pair_bytes")?
+        .checked_mul(HORIZON)
+        .ok_or("trace projection overflow")?;
+    let initial = number("maximum_initial_checkpoint_bytes")?;
+    let headroom = trace
+        .checked_mul(2)
+        .and_then(|n| n.checked_add(2 * initial))
+        .and_then(|n| n.checked_add(2 * projected_packet))
+        .and_then(|n| n.checked_add(64 * 1024 * 1024))
+        .ok_or("headroom overflow")?;
+    if pair != f.projected_pair_bytes
+        || headroom != f.headroom_bytes
+        || number("projected_pair_physical_bytes")? != pair
+        || number("metadata_initial_export_headroom")? != headroom
+        || projected_packet > journal::MAX_PACKET
+        || trace >= journal::MAX_TRACE_BYTES
+    {
+        return Err("frozen qualified budget differs".into());
+    }
+    Ok(())
+}
+fn freeze(qualification_root: &Path, reservation: &Path, out: &Path) -> Result<()> {
+    seed_admission_preflight(SEED, 1)?;
+    canonical_reservation(reservation)?;
+    let (q, qbytes): (Value, _) = read_typed(
+        &qualification_root.join("QUALIFICATION_COMPLETE.json"),
+        1024 * 1024,
+    )?;
+    if q["schema"] != "grouped-m2-driver-qualification-v1"
+        || q["complete"] != true
+        || q["driver_code_sha256"] != code_hash()
+        || q["executable_sha256"] != executable_hash()?
+        || q["driver_commit"] != DRIVER_COMMIT
+        || q["protocol_sha256"] != hash(PROTOCOL)
+        || q["primary_seed_executed"] != false
+    {
+        return Err("missing exact qualified driver evidence".into());
+    }
+    let (r, rbytes): (Value, _) = read_typed(reservation, 1024 * 1024)?;
+    if r["study_id"] != STUDY
+        || r["seed_decimal"] != SEED
+        || r["seed_consumed"] != false
+        || r["preparation_attempted"] != false
+        || r["process_starts"] != 0
+        || r["attempts"] != json!([])
+    {
+        return Err("reservation is not the untouched primary seed".into());
+    }
+    let f = Freeze {
+        schema: "grouped-m2-source-build-freeze-v1".into(),
+        host_commit: HOST_COMMIT.into(),
+        host_tree: HOST_TREE.into(),
+        driver_commit: DRIVER_COMMIT.into(),
+        driver_code_sha256: code_hash(),
+        executable_sha256: executable_hash()?,
+        protocol_sha256: hash(PROTOCOL),
+        qualification_sha256: hash(&qbytes),
+        qualification_json: String::from_utf8(qbytes.clone())?,
+        reservation_sha256: hash(&rbytes),
+        seed: SEED,
+        preparation: PREPARATION,
+        horizon: HORIZON,
+        temperature_bits: TEMPERATURE.to_bits(),
+        projected_pair_bytes: q["projected_pair_physical_bytes"]
+            .as_u64()
+            .ok_or("qualified projection absent")?,
+        headroom_bytes: q["metadata_initial_export_headroom"]
+            .as_u64()
+            .ok_or("qualified headroom absent")?,
+    };
+    check_freeze(&f)?;
+    if journal::free_bytes(out.parent().ok_or("freeze parent absent")?)?
+        < journal::MIN_FREE_BYTES
+            .checked_add(f.projected_pair_bytes)
+            .and_then(|n| n.checked_add(f.headroom_bytes))
+            .ok_or("freeze budget overflow")?
+    {
+        return Err("freeze filesystem below guard".into());
+    }
+    journal::publish_artifact(
+        out.parent().ok_or("freeze parent absent")?,
+        out.file_name()
+            .and_then(|v| v.to_str())
+            .ok_or("freeze filename invalid")?,
+        &serde_json::to_vec(&f)?,
+        64 * 1024,
+    )
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
