+/// Admission remains newborn-first. Only the first closure advances biology;
+/// the second clones that newly prepared, neurologically inexperienced world.
+fn fresh_pair(
+    r: &recipe::Recipe,
+    preparation: u64,
+    sentinel: bool,
+    actual: &mut u64,
+) -> Result<[CpuGroupedM2HostV1; 2]> {
+    let seed = r.config.world_seed;
+    let game = newborn(r)?;
+    let second = game.clone();
+    let (full, template) = CpuGroupedM2HostV1::new_prepared(
+        game,
+        trainer(r, sentinel)?,
+        r.inputs.clone(),
+        sampling_seed(seed),
+        mode(0)?,
+        |world| -> Result<HeadlessWorld> {
+            for _ in 0..preparation {
+                world.try_advance_tick()?;
+                *actual += 1;
+            }
+            if world.age_death_disabled()
+                || world.tick().raw() != preparation
+                || !world
+                    .organism_registry()
+                    .iter()
+                    .next()
+                    .ok_or("prepared body absent")?
+                    .lifecycle()
+                    .is_alive()
+            {
+                return Err("normal fresh preparation failed".into());
+            }
+            Ok(world.clone())
+        },
+    )?;
+    let (sham, ()) = CpuGroupedM2HostV1::new_prepared(
+        second,
+        trainer(r, sentinel)?,
+        r.inputs.clone(),
+        sampling_seed(seed),
+        mode(1)?,
+        |world| -> Result<()> {
+            *world = template;
+            Ok(())
+        },
+    )?;
+    let a = cp(&full)?;
+    let b = cp(&sham)?;
+    raw::fresh(&a, preparation, sampling_seed(seed))?;
+    raw::fresh(&b, preparation, sampling_seed(seed))?;
+    if raw::matched_initial(&a, "Full")? != raw::matched_initial(&b, "DriveSham")?
+        || *actual != preparation
+    {
+        return Err("fresh matched pair/preparation accounting differs".into());
+    }
+    Ok([full, sham])
+}
