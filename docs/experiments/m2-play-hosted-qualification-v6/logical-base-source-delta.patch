+    for n in [meta.len(), cp.len(), trace.len()] {
+        wire.extend_from_slice(&(n as u64).to_le_bytes());
+    }
+    wire.extend(meta);
+    wire.extend(cp);
+    wire.extend(trace);
+    Ok(wire)
