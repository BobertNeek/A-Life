+// The admission-only delta does not rerun or import the prior native fixture.
+const ADMISSION_REFERENCE_SHA256: &str =
+    "5e2c13072debd852e32f902af8ad689cadf7560efe8f7432736d208a34ca492f";
+const ADMISSION_REFERENCE_COMMIT: &str = "93ff181050a9f7274a0535f2fba6b248f6e52734";
+const ADMISSION_REFERENCE_CODE: &str =
+    "1f82b8219176ef4765515e62df4964c423e9b9bfca11d840a85704c76c83ff58";
+const ADMISSION_REFERENCE_EXE: &str =
+    "eaeafbbc77fc6759afcdeadcfac6a42b5b298496ddafaf9721c247c6d0396780";
+const ADMISSION_RUNTIME_FINGERPRINT: &str =
+    "e9b892da7c8ad72b22231df8c67e333fa1ec40148c9ee28f17a952999f84f970";
+fn unchanged_host_helper_fingerprint() -> String {
+    let mut h = Sha256::new();
+    for bytes in [
+        include_bytes!("../../src/cpu/grouped_host_envelope.rs").as_slice(),
+        include_bytes!("../../src/cpu/grouped_host_fixture.rs").as_slice(),
+        include_bytes!("../../src/cpu/grouped_host_food_tests.rs").as_slice(),
+        include_bytes!("../../src/cpu/grouped_host_loop.rs").as_slice(),
+        include_bytes!("../../src/cpu/grouped_host_tests.rs").as_slice(),
+        include_bytes!("../../src/cpu/host.rs").as_slice(),
+        include_bytes!("../../src/cpu/motor_mediation.rs").as_slice(),
+        include_bytes!("../../src/cpu/motor_mediation/confidence.rs").as_slice(),
+        include_bytes!("../../src/cpu/motor_mediation/confidence/host.rs").as_slice(),
+        include_bytes!("../../src/cpu/motor_mediation/confidence/host/tests.rs").as_slice(),
+        include_bytes!("../../src/cpu/motor_mediation/confidence/policy.rs").as_slice(),
+        include_bytes!("../../src/cpu/motor_mediation/confidence/tests.rs").as_slice(),
+        include_bytes!("../../src/cpu/organism.rs").as_slice(),
+        include_bytes!("recovery_sleep_recipe_v1.rs").as_slice(),
+        include_bytes!("grounded_r0_dedicated_fatigue.rs").as_slice(),
+        include_bytes!("multidrive_frozen.rs").as_slice(),
+        include_bytes!("grounded_r0_motor_operating_point.rs").as_slice(),
+    ] {
+        h.update((bytes.len() as u64).to_le_bytes());
+        h.update(bytes);
+    }
+    format!("{:x}", h.finalize())
+}
+pub fn qualify_admission(reference: &Path, out: &Path) -> Result<()> {
+    let (prior, prior_bytes): (Value, _) =
+        read_typed(&reference.join("QUALIFICATION_COMPLETE.json"), 1024 * 1024)?;
+    if hash(&prior_bytes) != ADMISSION_REFERENCE_SHA256
+        || prior["driver_commit"] != ADMISSION_REFERENCE_COMMIT
+        || prior["driver_code_sha256"] != ADMISSION_REFERENCE_CODE
+        || prior["executable_sha256"] != ADMISSION_REFERENCE_EXE
+        || prior["complete"] != true
+        || prior["actual_native_calls"] != 50
+        || prior["actual_preparation_intervals"] != 1200
+        || prior["primary_seed_executed"] != false
+        || unchanged_host_helper_fingerprint() != ADMISSION_RUNTIME_FINGERPRINT
+    {
+        return Err("admission-only reference/runtime proof differs".into());
+    }
+    let max = (u64::MAX - 1) / 16;
+    if seed_admission_preflight(max, 1)? != 0xFFFF_FFFF_FFFF_FFF1
+        || seed_admission_preflight(max, 8)? != 0xFFFF_FFFF_FFFF_FFF8
+        || seed_admission_preflight(max + 1, 1).is_ok()
+        || seed_admission_preflight(u64::MAX, 1).is_ok()
+        || seed_admission_preflight(0, 1).is_ok()
+        || seed_admission_preflight(1, 0).is_ok()
+        || seed_admission_preflight(1, 9).is_ok()
+        || seed_admission_preflight(0x4D32_424C_0009_0001, 1).is_ok()
+        || seed_admission_preflight(SEED, 1)? != 0x34D3_2424_C000_9011
+    {
+        return Err("fixed pre-claim admission guard case differs".into());
+    }
+    fs::create_dir(out)?;
+    journal::publish_artifact(
+        out,
+        "REUSED_RUNTIME_QUALIFICATION.json",
+        &prior_bytes,
+        1024 * 1024,
+    )?;
+    write_new(
+        out,
+        "ADMISSION_GUARDS.json",
+        &json!({
+            "schema":"grouped-m2-pre-claim-seed-domain-proof-v1",
+            "new_seed":SEED,"new_seed_hex":"0x034D32424C000901","sampling_seed":sampling_seed(SEED),
+            "first_founder_seed":seed_admission_preflight(SEED, 1)?,
+            "maximum_seed_one_founder":max,"maximum_seed_accepted":true,"next_seed_rejected":true,
+            "u64_max_rejected":true,"zero_and_invalid_founder_count_rejected":true,
+            "failed_original_seed_rejected":true,"host_helper_fingerprint":ADMISSION_RUNTIME_FINGERPRINT,
+            "source_constructions":0,"world_constructions":0,"body_preparation_intervals":0,"native_calls":0,
+            "unit_tests_required_separately":"root identity, source publication ordering/failure, attempted-call accounting and ordered cycle tests"
+        }),
+    )?;
+    let mut q = prior.clone();
+    let arms = q
+        .as_object_mut()
+        .ok_or("reference receipt is not an object")?
+        .remove("arms")
+        .ok_or("reference arms absent")?;
+    q["reused_runtime_arms_not_this_executable"] = arms;
+    q["qualification_scope"] =
+        json!("admission-only; unchanged native runtime via exact prior proof");
+    q["reused_runtime_qualification_sha256"] = json!(ADMISSION_REFERENCE_SHA256);
+    q["reused_runtime_driver_commit"] = json!(ADMISSION_REFERENCE_COMMIT);
+    q["reused_runtime_native_calls_not_this_executable"] = json!(50);
+    q["reused_runtime_preparation_intervals_not_this_executable"] = json!(1200);
+    q["host_helper_fingerprint"] = json!(ADMISSION_RUNTIME_FINGERPRINT);
+    q["driver_commit"] = json!(DRIVER_COMMIT);
+    q["driver_code_sha256"] = json!(code_hash());
+    q["executable_sha256"] = json!(executable_hash()?);
+    q["protocol_sha256"] = json!(hash(PROTOCOL));
+    q["actual_native_calls"] = json!(0);
+    q["actual_preparation_intervals"] = json!(0);
+    q["source_constructions"] = json!(0);
+    q["wall_seconds"] = Value::Null;
+    let free = journal::free_bytes(out)?;
+    q["free_bytes_at_qualification"] = json!(free);
+    let required = q["projected_pair_physical_bytes"]
+        .as_u64()
+        .ok_or("projection absent")?
+        .checked_add(
+            q["metadata_initial_export_headroom"]
+                .as_u64()
+                .ok_or("headroom absent")?,
+        )
+        .and_then(|n| n.checked_add(journal::MIN_FREE_BYTES))
+        .ok_or("resource overflow")?;
+    let adequate = free > required;
+    q["complete"] = json!(adequate);
+    q["resource_projection_adequate"] = json!(adequate);
+    write_new(
+        out,
+        if adequate {
+            "QUALIFICATION_COMPLETE.json"
+        } else {
+            "QUALIFICATION_RESOURCE_BLOCKED.json"
+        },
+        &q,
+    )?;
+    if !adequate {
+        return Err("admission-qualified source below measured resource guard".into());
+    }
+    Ok(())
+}
