+// Pure source/admission preflight: no genome, host, world, body or sampler is constructed.
+fn seed_admission_preflight(seed: u64, founder_count: u16) -> Result<u64> {
+    CanonicalNewGameConfig::phase3(seed, founder_count)
+        .map_err(|e| format!("pre-claim seed/config admission: {e}"))?;
+    seed.checked_mul(16)
+        .and_then(|base| base.checked_add(u64::from(founder_count)))
+        .ok_or_else(|| format!(
+            "pre-claim seed-domain overflow: seed {seed:#018x}, founder_count {founder_count}, maximum seed {:#018x}",
+            (u64::MAX - u64::from(founder_count)) / 16
+        ).into())
+}
+fn canonical_reservation(path: &Path) -> Result<()> {
+    if path.canonicalize()? != Path::new(RESERVATION_PATH)
+        || fs::symlink_metadata(path)?.file_type().is_symlink()
+    {
+        return Err("not the authoritative primary reservation path".into());
+    }
+    Ok(())
+}
