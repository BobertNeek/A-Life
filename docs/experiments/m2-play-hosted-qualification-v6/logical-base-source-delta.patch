+fn code_hash() -> String {
+    let mut h = Sha256::new();
+    for bytes in [
+        include_bytes!("probe_grouped_m2_durable_v1.rs").as_slice(),
+        include_bytes!("support/grouped_m2_journal_v1.rs").as_slice(),
+        include_bytes!("support/grouped_m2_raw_v1.rs").as_slice(),
