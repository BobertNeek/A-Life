+    std::fs::write(
+        directory.join("summary.json"),
+        serde_json::to_vec_pretty(&summary).unwrap(),
+    )
+    .unwrap();
+    println!("{summary}");
+    assert!(founder_unchanged);
+    assert!(rows <= 12);
+    assert!(
+        paired_observed_support > 0 && stored_own > 0 && stored_observed > 0,
+        "preserved null: no paired observed recall; never retry"
+    );
+}
diff --git a/crates/alife_world/src/headless/prepared_motor_adapter_tests.rs b/crates/alife_world/src/headless/prepared_motor_adapter_tests.rs
