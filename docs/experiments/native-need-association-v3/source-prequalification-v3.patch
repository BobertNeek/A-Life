+                }
+                changed_logits +=
+                    usize::from(candidate.final_logit.to_bits() != candidate.base_logit.to_bits());
+            }
+            let pairs = row
+                .port
+                .candidates
+                .iter()
+                .filter(|c| {
+                    c.support.action_sequence.is_some() && c.support.reference_sequence.is_some()
+                })
+                .count();
+            paired_support += pairs;
