+fn write_json_new(path: &std::path::Path, value: &serde_json::Value) {
+    use std::io::Write;
+    let mut f = std::fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(path)
+        .unwrap();
+    serde_json::to_writer_pretty(&mut f, value).unwrap();
+    f.write_all(b"\n").unwrap();
+    f.sync_all().unwrap();
+}
