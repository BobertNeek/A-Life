+    pub fn research_intervene_lattice(
+        &mut self, founder: &CpuFoundationTrainer, id: OrganismId, ablate: bool,
+    ) -> Result<(), CpuHostError> {
+        self.validate_founder(founder)?;
+        let resident = self.residents.get_mut(&id.raw())
+            .ok_or(CpuHostError::State("research resident missing"))?;
