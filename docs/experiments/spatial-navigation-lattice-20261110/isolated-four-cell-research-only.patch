 /// Exploratory native circuit: feed the lateral sight rays through existing
 /// recurrent context paths into opposing turn preferences, with a modest
 /// context recurrence boost. This is NOT a claimed spatial map or solver.
+/// Disposable perceptual goal trace; no target ID or hidden location is fed in.
+fn wire_research_goal_readout(p: &BrainPhenotype, weights: &mut [f32], edits: &mut Vec<serde_json::Value>) -> Result<()> {
+    use std::collections::{BTreeSet, VecDeque};
+    let mut out = vec![Vec::new(); p.neuron_count() as usize];
+    for (i,e) in p.synapses().iter().enumerate() {
+        if e.kind()==CompiledSynapseKind::Recurrent && p.projections()[e.route_index() as usize].projection_type()!=ProjectionType::LateralInhibition {
+            out[e.source() as usize].push(i);
+        }
+    }
+    let motors = p.synapses().iter().filter_map(|e| match e.kind() {
+        CompiledSynapseKind::Decoder(c) if c.head()==DecoderHeadKind::ActionCandidate && c.family()==CandidateActionFamily::Inspect && c.input_lane()==0 => Some(e.source()),
+        _ => None,
+    }).collect::<BTreeSet<_>>();
+    let mut reserved = edits.iter().filter(|e|e["role"]=="spatial_turn_bias").filter_map(|e|e["source"].as_u64().map(|x|x as u32)).collect::<BTreeSet<_>>();
+    for (source, sign) in [(908u32,1.0f32),(909u32,-1.0f32)] {
+        let mut q=VecDeque::from([(source,Vec::<usize>::new())]);
+        let mut visited=BTreeSet::from([source]);
+        let mut found=None;
+        while let Some((node,path))=q.pop_front() {
+            if !path.is_empty() && motors.contains(&node) && !reserved.contains(&node) { found=Some((node,path)); break; }
+            if path.len()>=6 { continue; }
+            for &i in &out[node as usize] {
+                let e=&p.synapses()[i]; let next=e.target();
+                let cells=match(e.route_index(),e.source(),next) {
+                    (7,a @ 896..=911,b @ 1600..=1615)=>Some((a-896,b-1600)),
+                    (8,a @ 1600..=1615,b @ 896..=911)=>Some((a-1600,b-896)),
+                    _=>None,
+                };
+                if let Some((a,b))=cells { if (a/4).abs_diff(b/4)+(a%4).abs_diff(b%4)>1 {continue;} }
+                if reserved.contains(&next) || next==908 || next==909 {continue;}
+                if visited.insert(next) {let mut next_path=path.clone();next_path.push(i);q.push_back((next,next_path));}
+            }
+        }
+        let (motor,path)=found.ok_or("no separate goal readout path")?;
+        reserved.insert(motor);
+        for i in path { let before=weights[i];weights[i]=2.0;edits.push(json!({"role":"goal_trace_relay","index":i,"before":before,"after":weights[i]})); }
+        let mut n=0;
+        for (i,e) in p.synapses().iter().enumerate() {
+            if e.source()==motor && matches!(e.kind(),CompiledSynapseKind::Decoder(c) if c.head()==DecoderHeadKind::ActionCandidate && c.family()==CandidateActionFamily::Inspect && c.input_lane()==0) {
+                let before=weights[i];weights[i]+=sign*120.0;n+=1;edits.push(json!({"role":"goal_trace_turn","index":i,"before":before,"after":weights[i]}));
+            }
+        }
+        if n==0 {return Err("missing goal turn output".into());}
+    }
+    Ok(())
