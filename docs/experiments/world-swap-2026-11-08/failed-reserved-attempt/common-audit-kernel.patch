+//! NEW reconstructed scalar-only sink; native qualification and external bounded-pipe runner required.
+use super::*;
+use serde_json::{json, Value};
+use std::{
+    fs,
+    io::{BufRead, Read, Write},
+    path::{Path, PathBuf},
+    time::{SystemTime, UNIX_EPOCH},
+};
+const FLOOR: u64 = 2 * 1024 * 1024 * 1024 + 256 * 1024 * 1024;
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct SourceBinding {
+    pub source_tree: String,
+    pub source_closure_sha256: String,
+    pub executable_sha256: String,
+    pub plan_sha256: String,
+    pub common_patch_sha256: String,
+    pub world_patch_sha256: String,
+}
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Binding {
+    pub protocol: String,
+    pub deadline_unix_seconds: u64,
+    pub old_world: SourceBinding,
+    pub new_world: SourceBinding,
+}
+impl Binding {
+    fn source(&self, v: WorldVariant) -> &SourceBinding {
+        match v {
+            WorldVariant::OldWorld => &self.old_world,
+            WorldVariant::NewWorld => &self.new_world,
+        }
+    }
+}
+pub(super) struct NativeSink {
+    root: PathBuf,
+    binding: Binding,
+    id: String,
+    scene: Scene,
+    variant: WorldVariant,
+    initial: Option<Value>,
+    rows: Vec<Value>,
+    attempted: bool,
+    started: bool,
+}
+fn case_id(scene: Scene, variant: WorldVariant) -> String {
+    format!(
+        "s{}_{}",
+        if scene.seed == SCENES[0].seed { 1 } else { 2 },
+        match variant {
+            WorldVariant::OldWorld => "old_world",
+            WorldVariant::NewWorld => "new_world",
+        }
+    )
+}
+fn create(path: &Path, value: &Value) -> Result<Vec<u8>> {
+    let mut raw = serde_json::to_vec(value)?;
+    raw.push(b'\n');
+    require(raw.len() <= 8 * 1024 * 1024, "output_bound")?;
+    let mut f = fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(path)?;
+    f.write_all(&raw)?;
+    f.sync_all()?;
+    Ok(raw)
+}
+fn signal(kind: &str, id: &str) -> Result<()> {
+    println!("{} {}", kind, id);
+    std::io::stdout().flush()?;
+    Ok(())
+}
+fn wait_for(kind: &str, id: &str) -> Result<()> {
+    wait_for_reader(&mut std::io::stdin().lock(), kind, id)
+}
+fn wait_for_reader(reader: &mut impl BufRead, kind: &str, id: &str) -> Result<()> {
+    let mut line = String::new();
+    reader.take(128).read_line(&mut line)?;
+    require(line == format!("{} {}\n", kind, id), "handshake")
+}
+fn free_bytes(root: &Path) -> Result<u64> {
+    let output = std::process::Command::new("df")
+        .arg("-Pk")
+        .arg(root)
+        .output()?;
+    require(output.status.success(), "resource")?;
+    let text = std::str::from_utf8(&output.stdout).map_err(|_| "resource")?;
+    let value: u64 = text
+        .lines()
+        .last()
+        .and_then(|s| s.split_whitespace().nth(3))
+        .ok_or("resource")?
+        .parse()
+        .map_err(|_| "resource")?;
+    value.checked_mul(1024).ok_or_else(|| "resource".into())
+}
+impl NativeSink {
+    pub(super) fn new(
+        root: PathBuf,
+        binding: Binding,
+        scene: Scene,
+        variant: WorldVariant,
+    ) -> Result<Self> {
+        require(binding.protocol == "world_only_swap_v1", "binding")?;
+        require(
+            root.is_dir() && !root.is_symlink() && fs::read_dir(&root)?.next().is_none(),
+            "fresh_directory",
+        )?;
+        let executable = fs::read(std::env::current_exe()?)?;
+        require(
+            digest(&executable) == binding.source(variant).executable_sha256,
+            "executable",
+        )?;
+        Ok(Self {
+            root,
+            binding,
+            id: case_id(scene, variant),
+            scene,
+            variant,
+            initial: None,
+            rows: Vec::new(),
+            attempted: false,
+            started: false,
+        })
+    }
+    fn finish_report(
+        &mut self,
+        c: &Counts,
+        founder_unchanged: bool,
+        roundtrip: bool,
+    ) -> Result<()> {
+        self.guard()?;
+        require(
+            self.rows.len() == usize::from(c.ticks) && self.started,
+            "accounting",
+        )?;
+        let actual_decisions = self
+            .rows
+            .iter()
+            .map(|r| r["decisions"].as_array().map_or(0, Vec::len))
+            .sum::<usize>();
+        require(actual_decisions == usize::from(c.decisions), "accounting")?;
+        let mut meals = [0u16; 2];
+        for row in &self.rows {
+            for decision in row["decisions"].as_array().ok_or("projection")? {
+                for (i, count) in meals.iter_mut().enumerate() {
+                    *count += u16::from(
+                        decision["physical_meals"][i]
+                            .as_bool()
+                            .ok_or("projection")?,
+                    );
+                }
+            }
+        }
+        require(
+            meals == c.meals && founder_unchanged && roundtrip,
+            "preservation",
+        )?;
+        let result = json!({"schema_version":1,"case_id":self.id,"seed":self.scene.seed,"world":self.variant,
+            "initial":self.initial.as_ref().ok_or("initial")?,"source":self.binding.source(self.variant),"rows":self.rows,
+            "stop":c.stop,"founder_optimizer_unchanged":founder_unchanged,"checkpoint_roundtrip_exact":roundtrip,"primary_next_checkpoint_tested":false});
+        let raw = create(&self.root.join("summary.json"), &result)?;
+        create(
+            &self.root.join("completion.json"),
+            &json!({"case_id":self.id,"original_summary_sha256":digest(&raw),"original_summary_byte_count":raw.len()}),
+        )?;
+        signal("CASE_READY", &self.id)?;
+        wait_for("VALIDATED", &self.id)
+    }
+    pub(super) fn reject(&self) -> Result<()> {
+        create(
+            &self.root.join("rejection.json"),
+            &json!({"case_id":self.id,"gate":"native_integrity_or_resource"}),
+        )?;
+        signal("REJECTED", &self.id)
+    }
+}
+impl AuditSink for NativeSink {
+    fn guard(&mut self) -> Result<()> {
+        let now = SystemTime::now().duration_since(UNIX_EPOCH)?.as_secs();
+        require(now < self.binding.deadline_unix_seconds, "deadline")?;
+        require(free_bytes(&self.root)? >= FLOOR, "resource")?;
+        let mut size = 0u64;
+        for entry in fs::read_dir(&self.root)? {
+            let entry = entry?;
+            require(
+                entry.file_type()?.is_file() && !entry.file_type()?.is_symlink(),
+                "output_bound",
+            )?;
+            size = size
+                .checked_add(entry.metadata()?.len())
+                .ok_or("output_bound")?;
+        }
+        require(size <= 16 * 1024 * 1024, "output_bound")
+    }
+    fn attempted_before_construction(&mut self, scene: Scene, variant: WorldVariant) -> Result<()> {
+        require(
+            !self.attempted && scene == self.scene && variant == self.variant,
+            "assignment",
+        )?;
+        create(
+            &self.root.join("attempted.json"),
+            &json!({"case_id":self.id,"seed":scene.seed,"world":variant,"stage":"before_construction"}),
+        )?;
+        self.attempted = true;
+        Ok(())
+    }
+    fn prepared_pair_barrier(&mut self, identity: &PairIdentity) -> Result<()> {
+        require(
+            self.attempted && !self.started && self.initial.is_none(),
+            "accounting",
+        )?;
+        require(identity.asset_sha256 == ASSET_SHA256, "asset")?;
+        let initial = serde_json::to_value(identity)?;
+        create(
+            &self.root.join("prepared.json"),
+            &json!({"case_id":self.id,"initial":initial,"source":self.binding.source(self.variant)}),
+        )?;
+        self.initial = Some(initial);
+        signal("PREPARED", &self.id)?;
+        wait_for("START", &self.id)?;
+        self.guard()?;
+        create(
+            &self.root.join("started.json"),
+            &json!({"case_id":self.id,"stage":"before_first_primary_tick"}),
+        )?;
+        self.started = true;
+        Ok(())
+    }
+    fn before_step(&mut self, _: &Life, index: u16) -> Result<()> {
+        require(
+            self.started && usize::from(index) == self.rows.len() && index < PRIMARY_TICKS,
+            "tick_budget",
+        )
+    }
+    fn actual_step(
+        &mut self,
+        _: &Life,
+        step: &CpuCanonicalStep,
+        index: u16,
+        projection: &Value,
+    ) -> Result<()> {
+        require(
+            step.decisions.len() <= 1 && usize::from(index) == self.rows.len(),
+            "row_count",
+        )?;
+        require(
+            projection["primary_tick"].as_u64() == Some(u64::from(index) + 1),
+            "clock",
+        )?;
+        self.rows.push(projection.clone());
+        Ok(())
+    }
+    fn finish(
+        &mut self,
+        _: &Life,
+        c: &Counts,
+        founder_unchanged: bool,
+        roundtrip: bool,
+    ) -> Result<()> {
+        self.finish_report(c, founder_unchanged, roundtrip)
+    }
+}
+
