+//! NEW reconstructed projection of actual receipts. No hypothetical world action.
+use super::*;
+use serde_json::{json, Value};
+fn role(life: &Life, id: Option<WorldEntityId>) -> &'static str {
+    match id {
+        None => "none",
+        Some(t) if t == life.targets[0] => "h",
+        Some(t) if t == life.targets[1] => "s",
+        _ => "other",
+    }
+}
+fn owner(o: SwapOwner) -> &'static str {
+    match o {
+        SwapOwner::Missing => "missing",
+        SwapOwner::Consumed => "consumed",
+        SwapOwner::Nobody => "nobody",
+        SwapOwner::ThisOrganism => "self",
+        SwapOwner::OtherOrganism => "other",
+        SwapOwner::Player => "player",
+    }
+}
+fn mode(m: SwapGripMode) -> &'static str {
+    match m {
+        SwapGripMode::None => "none",
+        SwapGripMode::Activity => "activity",
+        SwapGripMode::Deliberate => "deliberate",
+    }
+}
+fn phase(p: ActionPhase) -> &'static str {
+    match p {
+        ActionPhase::Attempt => "attempt",
+        ActionPhase::Preparation => "preparation",
+        ActionPhase::Completed => "completed",
+    }
+}
+fn contact(p: PhysicalContactKind) -> &'static str {
+    match p {
+        PhysicalContactKind::None => "none",
+        PhysicalContactKind::Touch => "touch",
+        PhysicalContactKind::Collision => "collision",
+        PhysicalContactKind::Blocked => "blocked",
+        PhysicalContactKind::Consumed => "consumed",
+        PhysicalContactKind::Moved => "moved",
+    }
+}
+fn transfer(t: GripTransferKind) -> &'static str {
+    match t {
+        GripTransferKind::Acquired => "acquired",
+        GripTransferKind::Released => "released",
+        GripTransferKind::Placed => "placed",
+        GripTransferKind::Consumed => "consumed",
+    }
+}
+fn holder(o: Option<OrganismId>, own: OrganismId) -> &'static str {
+    match o {
+        None => "nobody",
+        Some(x) if x == own => "self",
+        _ => "other",
+    }
+}
+fn failure(f: Option<ReferenceActionFailure>) -> &'static str {
+    match f {
+        None => "none",
+        Some(ReferenceActionFailure::MissingAffordance) => "missing_affordance",
+        Some(ReferenceActionFailure::ActionRejected) => "action_rejected",
+        Some(ReferenceActionFailure::Blocked) => "blocked",
+        Some(ReferenceActionFailure::ExecutorInvalid) => "executor_invalid",
+    }
+}
+fn owners(life: &Life, facts: &[SwapOwnership]) -> Result<Value> {
+    require(facts.len() <= 16, "scene_bound")?;
+    let mut result = Vec::new();
+    for target in life.targets {
+        let f = facts
+            .iter()
+            .find(|f| f.target == target)
+            .ok_or("owner_missing")?;
+        result.push(json!({"target":role(life,Some(target)),"active":f.active,"owner":owner(f.owner),"mode":mode(f.mode)}));
+    }
+    require(
+        facts
+            .iter()
+            .filter(|f| f.owner == SwapOwner::ThisOrganism)
+            .count()
+            <= 1,
+        "multiple_hold",
+    )?;
+    Ok(Value::Array(result))
+}
+fn event(c: &HeadlessMotorChannelReceipt, own: OrganismId) -> Result<&'static str> {
+    let target = c.command.target.and_then(|t| t.entity);
+    let t = &c.grip_transfers;
+    let value = match t.as_slice() {
+        [] => {
+            if c.failure.is_some() {
+                "failed"
+            } else {
+                "none"
+            }
+        }
+        [a] => match a.kind {
+            GripTransferKind::Acquired => {
+                require(
+                    Some(a.object) == target
+                        && a.previous_owner.is_none()
+                        && a.new_owner == Some(own),
+                    "acquire_receipt",
+                )?;
+                "acquired"
+            }
+            GripTransferKind::Placed => {
+                require(
+                    a.previous_owner == Some(own) && a.new_owner.is_none(),
+                    "place_receipt",
+                )?;
+                "placed_only"
+            }
+            GripTransferKind::Released => {
+                require(
+                    Some(a.object) == target
+                        && a.previous_owner == Some(own)
+                        && a.new_owner.is_none(),
+                    "release_receipt",
+                )?;
+                "released"
+            }
+            GripTransferKind::Consumed => {
+                require(
+                    Some(a.object) == target
+                        && a.previous_owner == Some(own)
+                        && a.new_owner.is_none()
+                        && c.physical.contact == PhysicalContactKind::Consumed
+                        && c.physical.target_entity == target
+                        && c.command.primitive == HeadlessActionIds::EAT
+                        && c.phase == ActionPhase::Completed,
+                    "meal_receipt",
+                )?;
+                "consumed"
+            }
+        },
+        [a, b] => {
+            require(
+                a.kind == GripTransferKind::Placed
+                    && b.kind == GripTransferKind::Acquired
+                    && a.object != b.object
+                    && a.previous_owner == Some(own)
+                    && a.new_owner.is_none()
+                    && b.previous_owner.is_none()
+                    && b.new_owner == Some(own)
+                    && Some(b.object) == target
+                    && c.physical.target_entity == target,
+                "swap_receipt",
+            )?;
+            require(
+                c.command.primitive != HeadlessActionIds::EAT
+                    || c.phase == ActionPhase::Preparation,
+                "swap_phase",
+            )?;
+            "atomic_swap"
+        }
+        _ => return Err("transfer_count".into()),
+    };
+    require(
+        t.is_empty()
+            || (c.observation.as_ref().is_some_and(|o| o.executed)
+                && c.physical.contact
+                    == if value == "consumed" {
+                        PhysicalContactKind::Consumed
+                    } else {
+                        PhysicalContactKind::Touch
+                    }),
+        "transfer_execution",
+    )?;
+    require(t.is_empty() || c.failure.is_none(), "failed_transfer")?;
+    require(
+        c.physical.contact != PhysicalContactKind::Consumed || value == "consumed",
+        "physical_meal",
+    )?;
+    Ok(value)
+}
+pub(super) fn project(life: &Life, step: &CpuCanonicalStep, index: u16) -> Result<Value> {
+    require(
+        step.decisions.len() == step.swap_audits.len() && step.decisions.len() <= 1,
+        "audit_count",
+    )?;
+    let checkpoint = life.host.checkpoint(&life.trainer)?;
+    require(checkpoint.residents.len() == 1, "population")?;
+    let resident = &checkpoint.residents[0];
+    let active = &resident.memory.records;
+    let staged = resident
+        .staged_memory
+        .as_ref()
+        .map(|m| m.records.as_slice())
+        .unwrap_or(&[]);
+    let mut decisions = Vec::new();
+    for (row, audit) in step.decisions.iter().zip(&step.swap_audits) {
+        let frame = row.patch.pre_action().perception();
+        require(
+            audit.sequence == row.patch.header().sequence_id
+                && audit.frame_digest == frame.frame_digest(),
+            "sequence_binding",
+        )?;
+        require(
+            row.patch.selected_bundle() == Some(&audit.motor.bundle)
+                && row.patch.outcome().joint.as_ref() == Some(&audit.motor.joint),
+            "actual_receipt_binding",
+        )?;
+        require(
+            audit.candidates.len() == frame.candidates().len(),
+            "candidate_count",
+        )?;
+        require(
+            audit
+                .motor
+                .channel_receipts
+                .iter()
+                .flat_map(|c| c.grip_transfers.iter())
+                .eq(audit.motor.grip_transfers.iter()),
+            "transfer_order",
+        )?;
+        let mut candidates = Vec::new();
+        for (i, (c, e)) in frame.candidates().iter().zip(&audit.candidates).enumerate() {
+            require(
+                c.candidate_index as usize == i
+                    && e.candidate_index as usize == i
+                    && e.world_target == c.target.entity,
+                "candidate_binding",
+            )?;
+            let source = e.best_family_source.as_ref();
+            let exact = source.is_some_and(|s| {
+                s.action == HeadlessActionIds::EAT.raw()
+                    && s.family == u16::from(CandidateActionFamily::Ingest.raw())
+                    && s.contact == Some(PhysicalContactKind::Consumed)
+                    && e.tracked_target
+                        .is_some_and(|t| t.raw() == s.tracked_target)
+            });
+            candidates.push(json!({"index":i,"primitive":c.action_id.raw(),"family":c.family.raw(),"target":role(life,c.target.entity),
+                "active":e.physical.active,"owner":owner(e.physical.owner),"mode":mode(e.physical.mode),"contact":c.features.0[18]>0.,
+                "contact_reachable":e.physical.physical_contact_reachable,"grasp_reachable":e.physical.grasp_reachable,
+                "held_count":e.physical.self_held_object_count,"actor_alive":e.physical.actor_alive,"effector":e.physical.manipulation_effector,
+                "target_sources":e.target_source_count,"family_sources":e.family_source_count,"target_confidence":e.target_confidence,
+                "family_confidence":e.family_confidence,"family_valence":e.family_valence,
+                "source_sequence":source.map(|s|s.sequence),"source_exact_ingest":exact}));
+        }
+        let mut channels = Vec::new();
+        let mut meals = [false; 2];
+        let mut covered_active = [false; 2];
+        let mut covered_staged = [false; 2];
+        for c in &audit.motor.channel_receipts {
+            let slot = match c.command.channel {
+                MotorChannel::Locomotion => 0,
+                MotorChannel::Orientation => 1,
+                MotorChannel::Manipulation => 2,
+                MotorChannel::Vocal => 3,
+                MotorChannel::Posture => 4,
+                _ => return Err("channel".into()),
+            };
+            let ci = row.action.motor_candidates[slot].ok_or("selected_channel")? as usize;
+            let candidate = frame.candidates().get(ci).ok_or("selected_index")?;
+            let target = c.command.target.and_then(|t| t.entity);
+            require(
+                candidate.action_id == c.command.primitive && candidate.target.entity == target,
+                "selected_target",
+            )?;
+            let observed = event(c, life.own)?;
+            let executed = c.observation.as_ref().map(|o| o.executed);
+            require(
+                c.failure.is_none() || executed != Some(true),
+                "failure_binding",
+            )?;
+            let transfers=c.grip_transfers.iter().map(|t|json!({"target":role(life,Some(t.object)),"kind":transfer(t.kind),
+                "previous_owner":holder(t.previous_owner,life.own),"new_owner":holder(t.new_owner,life.own)})).collect::<Vec<_>>();
+            channels.push(json!({"slot":slot,"candidate":ci,"primitive":c.command.primitive.raw(),"target":role(life,target),
+                "phase":phase(c.phase),"executed":executed,"failure":failure(c.failure),"contact":contact(c.physical.contact),
+                "physical_target":role(life,c.physical.target_entity),"event":observed,"transfers":transfers}));
+            if observed == "consumed" {
+                require(slot == 2 && executed == Some(true), "meal_channel")?;
+                let role_index = life
+                    .targets
+                    .iter()
+                    .position(|t| Some(*t) == target)
+                    .ok_or("meal_target")?;
+                meals[role_index] = true;
+                let tracked = audit.candidates[ci]
+                    .tracked_target
+                    .ok_or("meal_tracking")?
+                    .raw();
+                let exact = |m: &&PortableMemoryRecordV2| {
+                    m.organism_id_raw == life.own.raw()
+                        && m.sealed_sequence_id_raw == audit.sequence.raw()
+                        && m.tracked_object_id_raw == tracked
+                        && m.action_id_raw == HeadlessActionIds::EAT.raw()
+                        && m.family_raw == u16::from(CandidateActionFamily::Ingest.raw())
+                        && m.outcome_contact == Some(PhysicalContactKind::Consumed)
+                };
+                covered_active[role_index] = active.iter().filter(exact).count() > 0;
+                covered_staged[role_index] = staged.iter().filter(exact).count() > 0;
+                // Representative-only memory is not relabeled or rejected merely for missing Ingest coverage.
+            }
+        }
+        for i in 0..2 {
+            require(
+                meals[i] == consumed(row, life.targets[i]),
+                "joint_meal_binding",
+            )?;
+        }
+        for t in &audit.motor.grip_transfers {
+            let before = audit
+                .owners_before
+                .iter()
+                .find(|f| f.target == t.object)
+                .ok_or("owner_before")?;
+            let after = audit
+                .owners_after
+                .iter()
+                .find(|f| f.target == t.object)
+                .ok_or("owner_after")?;
+            require(
+                (before.owner == SwapOwner::ThisOrganism) == (t.previous_owner == Some(life.own))
+                    && (after.owner == SwapOwner::ThisOrganism) == (t.new_owner == Some(life.own)),
+                "owner_transfer",
+            )?;
+            // Concurrent locomotion may move held items within the bundle. Do not invent channel-entry geometry.
+        }
+        let phys = row
+            .patch
+            .outcome()
+            .measured_physiology
+            .as_ref()
+            .ok_or("physiology")?;
+        decisions.push(json!({"sequence":audit.sequence.raw(),"sampling_counter":row.sampling_counter.ok_or("rng_counter")?,
+            "actual_replay_equal":true,"pain":audit.current_pain,"pre_energy":audit.motor.biology_before.body.energy,
+            "aversive_harm":phys.aversive_harm(),"experienced_valence":row.patch.outcome().experienced_valence().raw(),
+            "owners_before":owners(life,&audit.owners_before)?,"owners_after":owners(life,&audit.owners_after)?,
+            "candidates":candidates,"channels":channels,"physical_meals":meals,"ingest_episode_active":covered_active,
+            "ingest_episode_staged":covered_staged}));
+    }
+    let record = life
+        .host
+        .world()
+        .organism_registry()
+        .get(life.own)
+        .ok_or("organism")?;
+    let b = record.biochemistry().body;
+    Ok(
+        json!({"primary_tick":index+1,"world_tick_before":step.tick_before.raw(),"world_tick_after":step.tick_after.raw(),
+        "sampling_counter_after":checkpoint.sampling_counter,"sleeping":step.sleeping_organisms>0,"sleep_consolidations":step.sleep_consolidations,
+        "boundary_owners":owners(life,&life.host.world().research_swap_owners(life.own))?,
+        "alive":record.lifecycle().is_alive(),"energy":b.energy,"health":b.health,"injury":b.injury,
+        "active_memory_count":active.len(),"staged_memory_count":staged.len(),"decisions":decisions}),
+    )
+}
