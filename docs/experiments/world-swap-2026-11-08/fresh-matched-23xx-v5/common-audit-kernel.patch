+impl Count {
+    fn change(&mut self, returned: bool, cap: u16) -> Result<()> {
+        require(
+            if returned {
+                self.requested == self.returned + 1
+            } else {
+                self.requested == self.returned && self.requested < cap
+            },
+            "accounting",
+        )?;
+        if returned {
+            self.returned += 1;
+        } else {
+            self.requested += 1;
+        }
+        Ok(())
+    }
+    fn done(self) -> bool {
+        self.requested == self.returned
+    }
