+//! Closed scalar diagnostics. Never serializes native error text or private state.
+use super::*;
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Stage {
+    BeforeConstruction,
+    AssetConstruction,
+    LifeConstruction,
+    Preparation,
+    InitialBinding,
+    PairBarrier,
+    ResourceGuard,
+    HostStep,
+    StepValidation,
+    Replay,
+    Projection,
+    RowCollection,
+    Safeguards,
+    CheckpointRoundtrip,
+    Summary,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Code {
+    NativeOperation,
+    Io,
+    Serialization,
+    CpuHost,
+    Invariant,
+    AssetBinding,
+    ActualReplay,
+    FounderMutation,
+    TransferExecution,
+    FailedTransfer,
+    MealReceipt,
+    MealChannel,
+    Ownership,
+    TargetBinding,
+    SequenceBinding,
+    Population,
+    Clock,
+    Preservation,
+    Deadline,
+    Resource,
+    OutputBound,
+    Handshake,
+    Accounting,
+    SafetyStop,
+}
+#[derive(Debug)]
+struct Failure(Code);
+impl std::fmt::Display for Failure {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "closed diagnostic {:?}", self.0)
+    }
+}
+impl std::error::Error for Failure {}
+pub(super) fn gate_error(gate: &'static str) -> Box<dyn std::error::Error> {
+    let code = match gate {
+        "asset_binding" | "asset" => Code::AssetBinding,
+        "actual_replay" => Code::ActualReplay,
+        "immutable_replay" => Code::FounderMutation,
+        "transfer_execution" | "transfer_channel" | "execution_binding" => Code::TransferExecution,
+        "preparation safeguard" | "fixture safety stop" => Code::SafetyStop,
+        "failed_transfer" | "failure_binding" => Code::FailedTransfer,
+        "meal_receipt" | "physical_meal" | "joint_meal_binding" => Code::MealReceipt,
+        "meal_channel" => Code::MealChannel,
+        "owner_transfer" | "multiple_hold" | "acquire_receipt" | "release_receipt"
+        | "place_receipt" => Code::Ownership,
+        "selected_target" | "candidate_binding" | "swap_receipt" | "swap_phase" => {
+            Code::TargetBinding
+        }
+        "sequence_binding" | "actual_receipt_binding" => Code::SequenceBinding,
+        "population" | "audit_count" => Code::Population,
+        "actual_clock" | "clock" => Code::Clock,
+        "preservation" => Code::Preservation,
+        "deadline" => Code::Deadline,
+        "resource" => Code::Resource,
+        "output_bound" => Code::OutputBound,
+        "handshake" => Code::Handshake,
+        "accounting" | "row_count" | "tick_budget" | "diagnostic_accounting" => Code::Accounting,
+        _ => Code::Invariant,
+    };
+    Box::new(Failure(code))
+}
+pub(super) fn classify(error: &(dyn std::error::Error + 'static)) -> Code {
+    if let Some(f) = error.downcast_ref::<Failure>() {
+        f.0
+    } else if error.is::<std::io::Error>() {
+        Code::Io
+    } else if error.is::<serde_json::Error>() {
+        Code::Serialization
+    } else if error.is::<CpuHostError>() {
+        Code::CpuHost
+    } else {
+        Code::NativeOperation
+    }
+}
+#[derive(Clone, Debug, Serialize)]
+pub(super) struct Progress {
+    pub stage: Stage,
+    pub preparation_requested: u16,
+    pub preparation_returned: u16,
+    pub host_requested: u16,
+    pub host_returned: u16,
+    pub replay_requested: u16,
+    pub replay_returned: u16,
+    pub projected_steps: u16,
+    pub collected_rows: u16,
+}
+impl Default for Progress {
+    fn default() -> Self {
+        Self {
+            stage: Stage::BeforeConstruction,
+            preparation_requested: 0,
+            preparation_returned: 0,
+            host_requested: 0,
+            host_returned: 0,
+            replay_requested: 0,
+            replay_returned: 0,
+            projected_steps: 0,
+            collected_rows: 0,
+        }
+    }
+}
+impl Progress {
+    pub fn preparation(&mut self, returned: bool) -> Result<()> {
+        require(
+            self.preparation_requested < PREPARATION_TICKS || returned,
+            "diagnostic_accounting",
+        )?;
+        require(
+            if returned {
+                self.preparation_requested == self.preparation_returned + 1
+            } else {
+                self.preparation_requested == self.preparation_returned
+            },
+            "diagnostic_accounting",
+        )?;
+        self.stage = Stage::Preparation;
+        if returned {
+            self.preparation_returned += 1;
+        } else {
+            self.preparation_requested += 1;
+        }
+        Ok(())
+    }
+    pub fn host(&mut self, returned: bool) -> Result<()> {
+        require(
+            self.host_requested < PRIMARY_TICKS || returned,
+            "diagnostic_accounting",
+        )?;
+        require(
+            if returned {
+                self.host_requested == self.host_returned + 1
+            } else {
+                self.host_requested == self.host_returned
+            },
+            "diagnostic_accounting",
+        )?;
+        self.stage = if returned {
+            Stage::StepValidation
+        } else {
+            Stage::HostStep
+        };
+        if returned {
+            self.host_returned += 1;
+        } else {
+            self.host_requested += 1;
+        }
+        Ok(())
+    }
+    pub fn replay(&mut self, returned: bool) -> Result<()> {
+        require(
+            if returned {
+                self.replay_requested == self.replay_returned + 1
+            } else {
+                self.replay_requested == self.replay_returned
+                    && self.replay_requested < self.host_returned
+            },
+            "diagnostic_accounting",
+        )?;
+        self.stage = Stage::Replay;
+        if returned {
+            self.replay_returned += 1;
+        } else {
+            self.replay_requested += 1;
+        }
+        Ok(())
+    }
+    pub fn projected(&mut self) -> Result<()> {
+        require(
+            self.projected_steps < self.host_returned,
+            "diagnostic_accounting",
+        )?;
+        self.projected_steps += 1;
+        Ok(())
+    }
+    pub fn collected(&mut self) -> Result<()> {
+        require(
+            self.collected_rows < self.projected_steps,
+            "diagnostic_accounting",
+        )?;
+        self.collected_rows += 1;
+        Ok(())
+    }
+}
