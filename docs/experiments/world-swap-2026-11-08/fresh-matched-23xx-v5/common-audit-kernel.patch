+//! Proposed cfg(test) child of world_swap_receipt_projection.rs.
+//!
+//! Requires the separately reviewed transient channel `succeeded` field. This
+//! file deliberately does not compile against the frozen, unpatched source.
+//! Attach only to a NEW source revision using:
+//!   #[cfg(test)]
+//!   #[path = "world_swap_receipt_regression.rs"]
+//!   mod receipt_regression;
+//!
+//! No host, brain session, neural step, training, replay or study life is made.
+//! One externally selected arm runs exactly one fresh physical record, five
+//! registered single-channel actions, and four world-clock advances. The record
+//! is required by the public registered-motor API. All actions are literal EATs.
+//! Both arms together: two fresh records, ten actions, eight clock advances.
+//! Each action advances registered biology once; intervening clock commits do
+//! not advance that already-advanced biology a second time. World transactions
+//! take their ordinary internal rollback snapshots; no test world is branched.
+//! Nothing is persisted. No successful MeasuredChannelObservation is invented.
+
+use alife_core::{
+    ActionTarget, BiochemistryState, BrainCapacityClass, ChannelCommand, Confidence,
+    CreatureGenome, DurationTicks, ExperienceSequenceId, FoundationGeneticIdentity, Intensity,
+    MotorChannel, MotorCommandBundle, OrganismId, PhysicalContactKind, ReferenceActionFailure,
+    Tick, Vec3f, WorldEntityId,
+};
+use alife_world::{
+    ActionPhase, GripTransferKind, HeadlessActionIds, HeadlessMotorChannelReceipt,
+    HeadlessScenarioBuilder, HeadlessWorld, WorldOrganismRecord,
+};
+
+const PHYSICAL_SEED: u64 = 0x5753_5634;
+const OWN: OrganismId = OrganismId(7);
+const OTHER: OrganismId = OrganismId(99);
+const SCRIPT: [usize; 5] = [0, 1, 1, 1, 1];
+
+#[derive(Clone, Copy)]
+enum ExpectedArm {
+    Old,
+    New,
+}
+
+impl ExpectedArm {
+    fn from_reviewed_dispatch() -> Self {
+        // This must come from the reviewed build/source binding. Do not infer
+        // the expected arm from the receipt being tested or accept either arm.
+        match std::env::var("WORLD_SWAP_RECEIPT_EXPECTED_ARM").as_deref() {
+            Ok("old_world") => Self::Old,
+            Ok("new_world") => Self::New,
+            _ => panic!("set WORLD_SWAP_RECEIPT_EXPECTED_ARM from the reviewed source binding"),
+        }
+    }
+
+    fn events(self) -> [&'static str; 5] {
+        match self {
+            Self::Old => ["acquired", "placed_only", "acquired", "consumed", "failed"],
+            Self::New => ["acquired", "atomic_swap", "consumed", "failed", "failed"],
+        }
+    }
+}
+
+fn physical_fixture() -> (HeadlessWorld, WorldEntityId, [WorldEntityId; 2]) {
+    let mut world = HeadlessScenarioBuilder::new(PHYSICAL_SEED)
+        .agent("receipt-body", OWN, Vec3f::ZERO)
+        .food("receipt-a", Vec3f::new(0.0, 0.0, 0.6), 0.05)
+        .food("receipt-b", Vec3f::new(1.1, 0.0, 0.0), 0.05)
+        .build()
+        .unwrap();
+    let body = world.entity_id("receipt-body").unwrap();
+    let targets = [
+        world.entity_id("receipt-a").unwrap(),
+        world.entity_id("receipt-b").unwrap(),
+    ];
+    // The same small founder used by existing registered-motor unit tests,
+    // with only this disposable fixture's seed. No foundation asset is loaded.
+    let genome = CreatureGenome::early_mammal_founder(
+        PHYSICAL_SEED,
+        FoundationGeneticIdentity::new(10, 1, 7, BrainCapacityClass::N512_ID).unwrap(),
+    )
+    .unwrap();
+    let phenotype = genome.express().unwrap();
+    let biology = BiochemistryState::new(&phenotype, Tick::ZERO).unwrap();
+    world
+        .register_organism_record(
+            WorldOrganismRecord::new(OWN, body, genome, phenotype, biology, Tick::ZERO).unwrap(),
+        )
+        .unwrap();
+    assert_eq!(world.organism_registry().iter().count(), 1);
+    assert_eq!(world.object_snapshots().len(), 3);
+    (world, body, targets)
+}
+
+fn selected_eat(tick: Tick, sequence: u64, target: WorldEntityId) -> MotorCommandBundle {
+    MotorCommandBundle::new(
+        OWN,
+        ExperienceSequenceId::new(sequence).unwrap(),
+        tick,
+        vec![ChannelCommand::new(
+            MotorChannel::Manipulation,
+            HeadlessActionIds::EAT,
+            Some(ActionTarget::new(Some(target), None)),
+            Vec3f::ZERO,
+            Intensity::new(1.0).unwrap(),
+            DurationTicks::new(1),
+            0.0,
+            Confidence::new(0.9).unwrap(),
+            0,
+        )
+        .unwrap()],
+    )
+    .unwrap()
+}
+
+fn rejects(
+    label: &str,
+    real: &HeadlessMotorChannelReceipt,
+    corrupt: impl FnOnce(&mut HeadlessMotorChannelReceipt),
+) {
+    let mut copy = real.clone();
+    corrupt(&mut copy);
+    assert!(
+        copy.observation.is_none(),
+        "{label}: do not forge a measured observation"
+    );
+    assert!(
+        super::event(&copy, OWN).is_err(),
+        "accepted forged receipt: {label}"
+    );
+}
+
+fn reject_corrupted_receipts(
+    receipts: &[HeadlessMotorChannelReceipt],
+    targets: [WorldEntityId; 2],
+    arm: ExpectedArm,
+) {
+    let acquired = &receipts[0];
+    let meal = &receipts[match arm {
+        ExpectedArm::Old => 3,
+        ExpectedArm::New => 2,
+    }];
+    let failed = &receipts[4];
+    assert!(acquired.succeeded && meal.succeeded && !failed.succeeded);
+
+    // All nominal successes below first passed the projection untouched.
+    // The most important regression: missing locomotion telemetry must not
+    // conceal actual manipulation success OR override actual channel failure.
+    for real in [acquired, &receipts[1], meal] {
+        for channel in [
+            MotorChannel::Locomotion,
+            MotorChannel::Orientation,
+            MotorChannel::Vocal,
+            MotorChannel::Posture,
+        ] {
+            rejects("transfer on non-manipulation channel", real, |c| {
+                c.command.channel = channel
+            });
+        }
+        rejects("actual success bit cleared", real, |c| c.succeeded = false);
+        rejects("successful transfer with failure", real, |c| {
+            c.failure = Some(ReferenceActionFailure::MissingAffordance);
+        });
+        rejects("transfer without contact", real, |c| {
+            c.physical.contact = PhysicalContactKind::None;
+        });
+    }
+    rejects("acquisition in wrong EAT phase", acquired, |c| {
+        c.phase = ActionPhase::Completed
+    });
+    rejects("acquisition physical target mismatch", acquired, |c| {
+        c.physical.target_entity = Some(targets[1]);
+    });
+    rejects("acquisition selected target mismatch", acquired, |c| {
+        c.command.target = Some(ActionTarget::new(Some(targets[1]), None));
+    });
+    rejects("acquisition claims stealing", acquired, |c| {
+        c.grip_transfers[0].previous_owner = Some(OTHER);
+    });
+    rejects("acquisition names wrong new owner", acquired, |c| {
+        c.grip_transfers[0].new_owner = Some(OTHER);
+    });
+    rejects("meal in preparation phase", meal, |c| {
+        c.phase = ActionPhase::Preparation
+    });
+    rejects("meal mislabeled as GRAB", meal, |c| {
+        c.command.primitive = HeadlessActionIds::GRAB
+    });
+    rejects("meal physical target mismatch", meal, |c| {
+        c.physical.target_entity = Some(targets[0]);
+    });
+    rejects("meal retains possession", meal, |c| {
+        c.grip_transfers[0].new_owner = Some(OWN)
+    });
+    rejects("consumed contact without consumed transfer", meal, |c| {
+        c.grip_transfers.clear()
+    });
+
+    match arm {
+        ExpectedArm::Old => {
+            let placed = &receipts[1];
+            rejects(
+                "placement targets selected rather than placed object",
+                placed,
+                |c| {
+                    c.physical.target_entity = Some(targets[1]);
+                },
+            );
+            rejects("placement in completed EAT phase", placed, |c| {
+                c.phase = ActionPhase::Completed
+            });
+            rejects("placement claims another owner's possession", placed, |c| {
+                c.grip_transfers[0].previous_owner = Some(OTHER);
+            });
+        }
+        ExpectedArm::New => {
+            let swapped = &receipts[1];
+            rejects("atomic swap reverses transfer order", swapped, |c| {
+                c.grip_transfers.reverse()
+            });
+            rejects("atomic swap uses same object twice", swapped, |c| {
+                c.grip_transfers[0].object = c.grip_transfers[1].object;
+            });
+            rejects(
+                "atomic EAT swap claims completed meal phase",
+                swapped,
+                |c| {
+                    c.phase = ActionPhase::Completed;
+                },
+            );
+            rejects("atomic swap physical target mismatch", swapped, |c| {
+                c.physical.target_entity = Some(targets[0]);
+            });
+        }
+    }
+
+    // Begin with an ACTUAL failed consumed-target attempt, then graft a real
+    // acquired-B transfer onto it. Make target, contact and phase plausible so
+    // failure rejection cannot depend only on a trivially mismatched target.
+    let acquired_b = match arm {
+        ExpectedArm::Old => receipts[2].grip_transfers[0],
+        ExpectedArm::New => receipts[1].grip_transfers[1],
+    };
+    assert_eq!(acquired_b.kind, GripTransferKind::Acquired);
+    assert_eq!(acquired_b.object, targets[1]);
+    for clear_failure in [false, true] {
+        rejects("failed action with grafted transfer", failed, |c| {
+            c.grip_transfers = vec![acquired_b];
+            c.physical.contact = PhysicalContactKind::Touch;
+            c.phase = ActionPhase::Preparation;
+            if clear_failure {
+                c.failure = None;
+            }
+            // Keep the actual false success bit in BOTH variants.
+        });
+    }
+}
