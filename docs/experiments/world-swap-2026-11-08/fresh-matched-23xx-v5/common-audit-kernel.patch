+//! NEW reconstruction, not a recovered original artifact. Main remains disabled.
+//! One frozen v12 foundation, two matched seeds, old/new world, ordinary sleep.
+#![allow(dead_code)]
+use alife_core::*;
+use alife_runtime::canonical_preparation::foundation_construction_development;
+use alife_training::{cpu::*, AdamWConfig, StageTrainableMask, TrainingSequence};
+use alife_world::*;
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+#[path = "support/care_candidate.rs"]
