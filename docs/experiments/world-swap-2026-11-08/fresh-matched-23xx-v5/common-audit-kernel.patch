+//! SOURCE-ONLY proposal. Include only under cfg(test); main remains disabled.
+//! One fresh prepared host and one exact restore per independently bound world.
+use super::*;
+use serde_json::{json, Value};
+
+const FIXTURE_SEED: u64 = 0x5753_5635;
+const PAIRED_STEPS: u16 = 4;
+
+#[derive(Clone, Copy, Debug, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum FixtureStage {
+    BeforeConstruction,
+    PreparedBoundary,
+    InitialIdentity,
+    PairedState,
+    PostProjection,
+    Safeguards,
+    Finished,
+}
+/// Callback payload is bounded metadata, never a native error or checkpoint.
+/// `returned: false` must be durably recorded before dispatch; `true` records
+/// successful return. An observer error immediately aborts, without a retry.
+#[derive(Clone, Serialize)]
+#[serde(tag = "event", rename_all = "snake_case")]
+pub(super) enum FixtureEvent {
+    Stage { stage: FixtureStage },
+    AssetConstruction { returned: bool },
+    FreshConstruction { returned: bool },
+    Restore { returned: bool },
+    Preparation { returned: bool },
+    OrdinaryHost { returned: bool },
+    AuditedHost { returned: bool },
+    Replay { returned: bool },
+    Projection { returned: bool },
+    PairedStateEqual,
+    ProjectionStateUnchanged,
+    Evidence { evidence: Evidence },
+    ProjectedRow { row: Value },
+}
+#[derive(Clone, Default, Serialize)]
+pub(super) struct Evidence {
+    asset_bound: bool,
+    initial_checkpoint_equal: bool,
+    initial_body_biology_equal: bool,
+    initial_scene_equal: bool,
+    initial_sampling_equal: bool,
+    trainer_unchanged: bool,
+    nontrivial_neural_activity: bool,
+    real_decisions: u16,
+    candidate_sets: u16,
+    manipulation_channels: u16,
+    manipulation_transfers: u16,
+    held_h_safe_eat_candidates: u16,
+    held_h_safe_eat_attempts: u16,
+    held_h_safe_atomic_swaps: u16,
+}
+
+fn guard(host: &CpuCanonicalHost, own: OrganismId) -> Result<()> {
+    require(
+        host.world().organism_registry().iter().count() == 1,
+        "population",
+    )?;
+    preparation_world_guard(host.world(), own)
+}
+fn scene_bytes(host: &CpuCanonicalHost, targets: [WorldEntityId; 2]) -> Result<Vec<u8>> {
+    let objects = targets
+        .iter()
+        .map(|&id| {
+            host.world()
+                .entity(id)
+                .cloned()
+                .map(WorldObjectSaveState::from)
+                .ok_or("fixture scene target")
+        })
+        .collect::<std::result::Result<Vec<_>, _>>()?;
+    bytes(&objects)
+}
