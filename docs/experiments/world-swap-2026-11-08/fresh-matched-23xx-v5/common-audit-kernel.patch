+#[test]
+#[ignore = "source-only proposal: physical receipts require separately reviewed bounded dispatch"]
+fn actual_manipulation_receipts_without_locomotion_observations() {
+    let arm = ExpectedArm::from_reviewed_dispatch();
+    let expected = arm.events();
+    let (mut world, body, targets) = physical_fixture();
+    let mut receipts = Vec::with_capacity(SCRIPT.len());
+    let mut clock_advances = 0;
+
+    for (index, target_slot) in SCRIPT.into_iter().enumerate() {
+        assert_eq!(world.tick(), Tick::new(index as u64));
+        let before = targets.map(|id| world.entity(id).unwrap().clone());
+        let target = targets[target_slot];
+        let bundle = selected_eat(world.tick(), index as u64 + 1, target);
+        let transaction = world.apply_registered_motor_bundle(&bundle, body).unwrap();
+        assert_eq!(transaction.outcome_tick, Tick::new(index as u64 + 1));
+        assert_eq!(transaction.channel_receipts.len(), 1);
+        let actual = transaction.channel_receipts[0].clone();
+
+        assert_eq!(actual.command.channel, MotorChannel::Manipulation);
+        assert_eq!(actual.command.primitive, HeadlessActionIds::EAT);
+        assert_eq!(actual.command.target.and_then(|t| t.entity), Some(target));
+        assert!(actual.observation.is_none());
+        // Never consult transaction.succeeded or synthesize a channel result.
+        assert_eq!(actual.succeeded, expected[index] != "failed");
+        assert_eq!(super::event(&actual, OWN).unwrap(), expected[index]);
+        assert_eq!(transaction.grip_transfers, actual.grip_transfers);
+
+        let after = targets.map(|id| world.entity(id).unwrap().clone());
+        for transfer in &actual.grip_transfers {
+            let slot = targets
+                .iter()
+                .position(|id| *id == transfer.object)
+                .unwrap();
+            assert_eq!(transfer.previous_owner, before[slot].carried_by);
+            assert_eq!(transfer.new_owner, after[slot].carried_by);
+            assert_eq!(transfer.previous_position, before[slot].position);
+            assert_eq!(transfer.new_position, after[slot].position);
+        }
+        assert!(after.iter().filter(|o| o.carried_by == Some(OWN)).count() <= 1);
+        assert_eq!(world.entity(body).unwrap().position, Vec3f::ZERO);
+        assert!(!after[0].consumed, "the scripted test never consumes A");
+
+        match expected[index] {
+            "acquired" => {
+                assert_eq!(actual.phase, ActionPhase::Preparation);
+                assert_eq!(actual.grip_transfers.len(), 1);
+                assert_eq!(actual.grip_transfers[0].kind, GripTransferKind::Acquired);
+                assert_eq!(after[target_slot].carried_by, Some(OWN));
+                assert!(after[target_slot].activity_hold);
+                assert!(!after[target_slot].consumed);
+                assert_eq!(transaction.body_event.nutrition, 0.0);
+            }
+            "placed_only" => {
+                assert_eq!(actual.phase, ActionPhase::Preparation);
+                assert_eq!(actual.grip_transfers.len(), 1);
+                assert_eq!(actual.grip_transfers[0].kind, GripTransferKind::Placed);
+                assert_eq!(actual.grip_transfers[0].object, targets[0]);
+                assert_eq!(actual.physical.target_entity, Some(targets[0]));
+                assert!(after.iter().all(|o| o.carried_by.is_none() && !o.consumed));
+                assert_eq!(transaction.body_event.nutrition, 0.0);
+            }
+            "atomic_swap" => {
+                assert_eq!(actual.phase, ActionPhase::Preparation);
+                assert_eq!(actual.grip_transfers.len(), 2);
+                assert_eq!(actual.grip_transfers[0].kind, GripTransferKind::Placed);
+                assert_eq!(actual.grip_transfers[0].object, targets[0]);
+                assert_eq!(actual.grip_transfers[1].kind, GripTransferKind::Acquired);
+                assert_eq!(actual.grip_transfers[1].object, targets[1]);
+                assert_eq!(actual.physical.target_entity, Some(targets[1]));
+                assert_eq!(after[0].carried_by, None);
+                assert_eq!(after[1].carried_by, Some(OWN));
+                assert!(after[1].activity_hold && !after[1].consumed);
+                assert_eq!(transaction.body_event.nutrition, 0.0);
+            }
+            "consumed" => {
+                assert_eq!(actual.phase, ActionPhase::Completed);
+                assert_eq!(actual.grip_transfers.len(), 1);
+                assert_eq!(actual.grip_transfers[0].kind, GripTransferKind::Consumed);
+                assert_eq!(actual.physical.contact, PhysicalContactKind::Consumed);
+                assert_eq!(actual.physical.target_entity, Some(targets[1]));
+                assert!(after[1].consumed);
+                assert_eq!(after[1].carried_by, None);
+                assert_eq!(transaction.body_event.nutrition, 0.05);
+            }
+            "failed" => {
+                assert_eq!(actual.phase, ActionPhase::Attempt);
+                assert!(actual.failure.is_some());
+                assert!(actual.grip_transfers.is_empty());
+                assert_eq!(actual.physical.contact, PhysicalContactKind::None);
+                assert!(after[1].consumed);
+                assert_eq!(after[1].carried_by, None);
+                assert_eq!(transaction.body_event.nutrition, 0.0);
+            }
+            _ => unreachable!(),
+        }
+        let registered = world.organism_registry().get(OWN).unwrap();
+        assert_eq!(registered.biochemistry().tick, Tick::new(index as u64 + 1));
+        assert!(registered.lifecycle().is_alive());
+        assert_eq!(world.organism_registry().iter().count(), 1);
+        assert_eq!(world.object_snapshots().len(), 3);
+        receipts.push(actual);
+
+        if index + 1 < SCRIPT.len() {
+            let already_advanced = *world.organism_registry().get(OWN).unwrap().biochemistry();
+            world.try_advance_tick().unwrap();
+            clock_advances += 1;
+            assert_eq!(
+                world.organism_registry().get(OWN).unwrap().biochemistry(),
+                &already_advanced
+            );
+        }
+    }
+    assert_eq!(receipts.len(), 5);
+    assert_eq!(clock_advances, 4);
+    assert_eq!(world.tick(), Tick::new(4));
+    reject_corrupted_receipts(&receipts, targets, arm);
+}
