+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+const PREPARATION_TICKS: u16 = 600;
+const PRIMARY_TICKS: u16 = 256;
+const TEMPERATURE: f32 = 1.0;
+const ASSET_SHA256: &str = "6edcd6dd1dc5bfedf8f7b73bf605bb480e36c0ba022a316840a6f0bd87629632";
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum WorldVariant {
+    OldWorld,
+    NewWorld,
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Scene {
+    seed: u64,
+    harmful_slot: usize,
+    appearance: [usize; 2],
+    spawn_order: [usize; 2],
+}
+const SCENES: [Scene; 2] = [
+    Scene {
+        seed: 2026112301,
+        harmful_slot: 0,
+        appearance: [0, 1],
+        spawn_order: [0, 1],
+    },
+    Scene {
+        seed: 2026112302,
+        harmful_slot: 1,
+        appearance: [0, 1],
+        spawn_order: [0, 1],
+    },
+];
+fn bytes<T: Serialize>(x: &T) -> Result<Vec<u8>> {
+    Ok(serde_json::to_vec(x)?)
+}
+fn digest(b: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(b))
+}
+fn require(ok: bool, code: &'static str) -> Result<()> {
+    if ok {
+        Ok(())
+    } else {
+        Err(diagnostics::gate_error(code))
+    }
+}
+struct Life {
+    host: CpuCanonicalHost,
+    trainer: CpuFoundationTrainer,
+    own: OrganismId,
+    targets: [WorldEntityId; 2],
+    initial_body_biology: Vec<u8>,
+    initial_scene: Vec<u8>,
+    sampling_seed: u32,
+}
+fn body_biology(world: &HeadlessWorld, own: OrganismId) -> Result<Vec<u8>> {
+    let r = world
+        .organism_registry()
+        .get(own)
+        .ok_or("missing_organism")?;
+    let p = r.phenotype();
+    bytes(&(
+        r.organism_id(),
+        r.birth_tick(),
+        &p.body,
+        &p.chemistry,
+        &p.development,
+        &p.reproduction,
+        &p.predisposition,
+        r.embodiment(),
+        r.biochemistry(),
+        r.lifecycle(),
+    ))
+}
+fn preparation_guard(alive: bool, health: f32, injury: f32) -> bool {
+    alive && health.is_finite() && injury.is_finite() && health >= 0.70 && injury <= 0.25
+}
+fn preparation_world_guard(world: &HeadlessWorld, own: OrganismId) -> Result<()> {
+    let r = world
+        .organism_registry()
+        .get(own)
+        .ok_or("preparation organism")?;
+    require(
+        preparation_guard(
+            r.lifecycle().is_alive(),
+            r.biochemistry().body.health,
+            r.biochemistry().body.injury,
+        ),
+        "preparation safeguard",
+    )
+}
+fn make_life<const PREPARE: u16>(
+    scene: Scene,
+    frozen_asset: &FoundationWeightAsset,
+) -> Result<Life> {
+    make_life_observed::<PREPARE>(scene, frozen_asset, |_| Ok(()))
+}
+fn make_life_observed<const PREPARE: u16>(
+    scene: Scene,
+    frozen_asset: &FoundationWeightAsset,
+    mut preparation_progress: impl FnMut(bool) -> Result<()>,
+) -> Result<Life> {
+    let asset = frozen_asset.clone();
+    let mut config = CanonicalNewGameConfig::phase3(scene.seed, 1)?;
+    config.brain_class = BrainScaleTier::Standard2048;
+    config.sensor_profile = SensorProfile::GroundedObjectSlotsV1;
+    let mut game = create_canonical_new_game_with_n2048_memory_gain_candidate(&config, &asset)?;
+    let original = game
+        .world
+        .organism_registry()
+        .iter()
+        .next()
+        .ok_or("missing_founder")?
+        .clone();
+    let genome = original.phenotype().brain_genome.clone();
+    let development = foundation_construction_development(
+        &genome,
+        &BrainCapacityClass::n2048(),
+        &original.phenotype().development_state_at(Tick::ZERO)?,
+    )?;
+    let (p, _) = PhenotypeCompiler::compile_n2048_memory_gain_foundation_candidate(
+        genome,
+        development,
+        asset.clone(),
+    )?;
+    let trainer = CpuFoundationTrainer::new(
+        p.clone(),
+        asset,
+        StageTrainableMask::recurrent_only(&p)?,
+        AdamWConfig::default(),
+    )?;
+    let own = original.organism_id();
+    let mut world = HeadlessScenarioBuilder::new(scene.seed)
+        .agent("learner", own, Vec3f::ZERO)
+        .terrain_zone(
+            1,
+            "assay",
+            TerrainZoneKind::Meadow,
+            Vec3f::ZERO,
+            12.0,
+            0.0,
+            0.0,
+        )
+        .build()?;
+    let common = GroundedPhysicalProperties {
+        velocity: Vec3f::ZERO,
+        color: [0.9, 0.2, 0.2],
+        material: [0.35, 0.15, 0.65],
+        shape: [0.2, 0.8, 0.2],
+        chemical: [0.85, 0.1, 0.2],
+        surface_temperature: 0.1,
+        terrain: [0.5, 0.25],
+    };
+    let mut slots = [None, None];
+    for slot in scene.spawn_order {
+        let id = world.editor_spawn_object(WorldEditorSpawnSpec {
+            label: format!("resource_{slot}"),
+            kind: WorldObjectKind::Food,
+            organism_id: None,
+            position: Vec3f::new(0.35, 0.0, if slot == 0 { -0.35 } else { 0.35 }),
+            nutrition: 0.05,
+            hazard_pain: if slot == scene.harmful_slot {
+                0.35
+            } else {
+                0.0
+            },
+            radius: 0.5,
+            token_id: None,
+        })?;
+        let mut physical = common;
+        if scene.appearance[slot] == 1 {
+            physical.color = [0.2, 0.2, 0.9];
+        }
+        world.set_grounded_physical_properties(id, physical)?;
+        world.track_resource_lifecycle(id, EcologyZoneId(1), 16, 512)?;
+        slots[slot] = Some(id);
+    }
+    let mut chemistry = *original.biochemistry();
+    chemistry.body.set_energy(0.4)?;
+    world.register_organism_record(WorldOrganismRecord::new(
+        own,
+        world.entity_id("learner").ok_or("missing_body")?,
+        original.genome().clone(),
+        original.phenotype().clone(),
+        chemistry,
+        original.birth_tick(),
+    )?)?;
+    let targets = [
+        slots[scene.harmful_slot].ok_or("missing_h")?,
+        slots[1 - scene.harmful_slot].ok_or("missing_s")?,
+    ];
+    game.world = world;
+    let sampling_seed = (scene.seed ^ (scene.seed >> 32)) as u32;
+    let (host, _) =
+        CpuCanonicalHost::new_prepared_cohort(game, &trainer, sampling_seed, |world| {
+            preparation_world_guard(world, own)?;
+            for _ in 0..PREPARE {
+                preparation_progress(false)?;
+                world.try_advance_tick()?;
+                preparation_progress(true)?;
+                preparation_world_guard(world, own)?;
+            }
+            Ok::<_, Box<dyn std::error::Error>>(())
+        })?;
+    let initial_body_biology = body_biology(host.world(), own)?;
+    let initial_scene = bytes(
+        &targets
+            .iter()
+            .map(|&id| {
+                WorldObjectSaveState::from(host.world().entity(id).expect("new resource").clone())
+            })
+            .collect::<Vec<_>>(),
+    )?;
+    require(
+        host.checkpoint(&trainer)?
+            .residents
+            .iter()
+            .all(|r| r.memory.records.is_empty()),
+        "nonempty_initial_memory",
+    )?;
+    Ok(Life {
+        host,
+        trainer,
+        own,
+        targets,
+        initial_body_biology,
+        initial_scene,
+        sampling_seed,
+    })
+}
+#[derive(Serialize)]
+struct PairIdentity {
+    asset_sha256: String,
+    founder_optimizer_sha256: String,
+    full_initial_checkpoint_sha256: String,
+    initial_body_biology_sha256: String,
+    initial_scene_sha256: String,
+    sampling_seed: u32,
+    sampling_counter: u32,
+    actual_world_tick: u64,
+}
+fn pair_identity(life: &Life, asset: &FoundationWeightAsset) -> Result<PairIdentity> {
+    let checkpoint = life.host.checkpoint(&life.trainer)?;
+    require(checkpoint.sampling_counter == 0, "initial_sampling")?;
+    require(
+        checkpoint.residents.len() == 1 && checkpoint.residents[0].memory.records.is_empty(),
+        "initial_memory",
+    )?;
+    Ok(PairIdentity {
+        asset_sha256: digest(&asset.encode_canonical()?),
+        founder_optimizer_sha256: digest(&bytes(&life.trainer.checkpoint())?),
+        full_initial_checkpoint_sha256: digest(&bytes(&checkpoint)?),
+        initial_body_biology_sha256: digest(&life.initial_body_biology),
+        initial_scene_sha256: digest(&life.initial_scene),
+        sampling_seed: checkpoint.sampling_seed,
+        sampling_counter: checkpoint.sampling_counter,
+        actual_world_tick: life.host.world().tick().raw(),
+    })
+}
+trait AuditSink {
+    fn stage(&mut self, stage: diagnostics::Stage) -> Result<()>;
+    fn preparation_progress(&mut self, returned: bool) -> Result<()>;
+    fn host_returned(&mut self) -> Result<()>;
+    fn replay_progress(&mut self, returned: bool) -> Result<()>;
+    fn projected_step(&mut self) -> Result<()>;
+    fn guard(&mut self) -> Result<()>;
+    fn attempted_before_construction(&mut self, scene: Scene, variant: WorldVariant) -> Result<()>;
+    fn prepared_pair_barrier(&mut self, identity: &PairIdentity) -> Result<()>;
+    fn before_step(&mut self, life: &Life, primary_tick: u16) -> Result<()>;
+    fn actual_step(
+        &mut self,
+        life: &Life,
+        step: &CpuCanonicalStep,
+        primary_tick: u16,
+        projection: &serde_json::Value,
+    ) -> Result<()>;
+    fn finish(
+        &mut self,
+        life: &Life,
+        counts: &Counts,
+        founder_unchanged: bool,
+        roundtrip: bool,
+    ) -> Result<()>;
+}
+#[derive(Debug, Clone, Copy, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Stop {
+    TickBudget,
+    ThirdHarmfulMeal,
+    Health,
+    Injury,
+    Death,
+}
+#[derive(Serialize)]
+struct Counts {
+    ticks: u16,
+    decisions: u16,
+    sleeping_ticks: u16,
+    sleep_consolidations: u16,
+    meals: [u16; 2],
+    negative_harmful_meals: u16,
+    stop: Stop,
+    initial_energy: f32,
+    initial_health: f32,
+    initial_injury: f32,
+    final_energy: f32,
+    final_health: f32,
+    final_injury: f32,
+    min_health: f32,
+    max_injury: f32,
+}
+fn consumed(row: &CpuCollectedDecision, target: WorldEntityId) -> bool {
+    let physical = |o: &PhysicalActionOutcome| {
+        o.target_entity == Some(target) && o.contact == PhysicalContactKind::Consumed
+    };
+    let outcome = row.patch.outcome();
+    physical(&outcome.physical)
+        || outcome
+            .joint
+            .as_ref()
+            .is_some_and(|j| j.channel_outcomes.iter().any(|c| physical(&c.physical)))
+}
+fn verify_actual_replay(life: &Life, row: &CpuCollectedDecision) -> Result<()> {
+    let frozen = bytes(&life.trainer.checkpoint())?;
+    let sequence = TrainingSequence {
+        phenotype_hash: life.trainer.phenotype().phenotype_hash(),
+        initial: row.initial.clone(),
+        ticks: vec![row.replay_tick.clone()],
+        burn_in_ticks: 0,
+        memory_candidate_gain: life
+            .trainer
+            .phenotype()
+            .candidate_decoder()
+            .memory_channel()
+            .map_or(0., |m| m.max_candidate_gain()),
+    };
+    let mut output = life.trainer.evaluate_replay(&sequence)?;
+    let choice = sample_cpu_joint_action(
+        life.trainer.phenotype(),
+        row.patch.pre_action().perception(),
+        &output.candidate_logits.remove(0),
+        life.sampling_seed,
+        row.sampling_counter.ok_or("rng_counter")?,
+        TEMPERATURE,
+    )?;
+    require(bytes(&choice)? == bytes(&row.action)?, "actual_replay")?;
+    require(
+        bytes(&life.trainer.checkpoint())? == frozen,
+        "immutable_replay",
+    )
+}
+// WorldVariant is only a checked source/report identity, never a policy switch.
+fn run_reviewed(scene: Scene, variant: WorldVariant, sink: &mut impl AuditSink) -> Result<()> {
+    require(SCENES.contains(&scene), "unassigned_seed")?;
+    sink.guard()?;
+    sink.attempted_before_construction(scene, variant)?;
+    sink.stage(diagnostics::Stage::AssetConstruction)?;
+    let asset = legacy::construct()?;
+    require(
+        digest(&asset.encode_canonical()?) == ASSET_SHA256,
+        "asset_binding",
+    )?;
+    sink.stage(diagnostics::Stage::LifeConstruction)?;
+    let mut life = make_life_observed::<PREPARATION_TICKS>(scene, &asset, |returned| {
+        sink.preparation_progress(returned)
+    })?;
+    sink.stage(diagnostics::Stage::InitialBinding)?;
+    let initial_record = life
+        .host
+        .world()
+        .organism_registry()
+        .get(life.own)
+        .ok_or("initial_organism")?;
+    require(
+        initial_record.lifecycle().is_alive()
+            && initial_record.biochemistry().body.health >= 0.70
+            && initial_record.biochemistry().body.injury <= 0.25,
+        "initial_safeguard",
+    )?;
+    let identity = pair_identity(&life, &asset)?;
+    sink.stage(diagnostics::Stage::PairBarrier)?;
+    sink.prepared_pair_barrier(&identity)?;
+    sink.guard()?;
+    let founder = bytes(&life.trainer.checkpoint())?;
+    let body = life
+        .host
+        .world()
+        .organism_registry()
+        .get(life.own)
+        .ok_or("missing_body")?
+        .biochemistry()
+        .body;
+    let mut counts = Counts {
+        ticks: 0,
+        decisions: 0,
+        sleeping_ticks: 0,
+        sleep_consolidations: 0,
+        meals: [0, 0],
+        negative_harmful_meals: 0,
+        stop: Stop::TickBudget,
+        initial_energy: body.energy,
+        initial_health: body.health,
+        initial_injury: body.injury,
+        final_energy: body.energy,
+        final_health: body.health,
+        final_injury: body.injury,
+        min_health: body.health,
+        max_injury: body.injury,
+    };
+    for index in 0..PRIMARY_TICKS {
+        sink.stage(diagnostics::Stage::ResourceGuard)?;
+        sink.guard()?;
+        sink.before_step(&life, index)?;
+        let tick_before = life.host.world().tick().raw();
+        let step = life.host.step_with_swap_audit(&life.trainer, TEMPERATURE)?;
+        sink.host_returned()?;
+        counts.ticks += 1;
+        require(
+            life.host.world().tick().raw() == tick_before + 1,
+            "actual_clock",
+        )?;
+        require(
+            step.decisions.len() <= 1 && step.decisions.len() == step.swap_audits.len(),
+            "population",
+        )?;
+        counts.decisions += u16::try_from(step.decisions.len())?;
+        counts.sleeping_ticks += u16::from(step.sleeping_organisms > 0);
+        counts.sleep_consolidations += u16::try_from(step.sleep_consolidations)?;
+        for row in &step.decisions {
+            sink.replay_progress(false)?;
+            verify_actual_replay(&life, row)?;
+            sink.replay_progress(true)?;
+            for (role, target) in life.targets.iter().copied().enumerate() {
+                if consumed(row, target) {
+                    counts.meals[role] += 1;
+                    let p = row
+                        .patch
+                        .outcome()
+                        .measured_physiology
+                        .as_ref()
+                        .ok_or("physiology")?;
+                    counts.negative_harmful_meals += u16::from(
+                        role == 0
+                            && p.aversive_harm() > 0.
+                            && row.patch.outcome().experienced_valence().raw() < 0.,
+                    );
+                }
+            }
+        }
+        sink.stage(diagnostics::Stage::Projection)?;
+        let projection = projection::project(&life, &step, index)?;
+        sink.projected_step()?;
+        sink.stage(diagnostics::Stage::RowCollection)?;
+        sink.actual_step(&life, &step, index, &projection)?;
+        sink.stage(diagnostics::Stage::Safeguards)?;
+        let record = life
+            .host
+            .world()
+            .organism_registry()
+            .get(life.own)
+            .ok_or("missing_body")?;
+        let body = record.biochemistry().body;
+        counts.final_energy = body.energy;
+        counts.final_health = body.health;
+        counts.final_injury = body.injury;
+        counts.min_health = counts.min_health.min(body.health);
+        counts.max_injury = counts.max_injury.max(body.injury);
+        if !record.lifecycle().is_alive() {
+            counts.stop = Stop::Death;
+            break;
+        }
+        if body.health < 0.70 {
+            counts.stop = Stop::Health;
+            break;
+        }
+        if body.injury > 0.25 {
+            counts.stop = Stop::Injury;
+            break;
+        }
+        if counts.meals[0] >= 3 {
+            counts.stop = Stop::ThirdHarmfulMeal;
+            break;
+        }
+    }
+    sink.stage(diagnostics::Stage::CheckpointRoundtrip)?;
+    // No extra tick: this is a checkpoint byte roundtrip, not next-step proof.
+    let original = bytes(&life.host.checkpoint(&life.trainer)?)?;
+    let restored =
+        CpuCanonicalHost::from_checkpoint(serde_json::from_slice(&original)?, &life.trainer)?;
+    let roundtrip = original == bytes(&restored.checkpoint(&life.trainer)?)?;
+    let founder_unchanged = founder == bytes(&life.trainer.checkpoint())?;
+    require(roundtrip && founder_unchanged, "preservation")?;
+    sink.stage(diagnostics::Stage::Summary)?;
+    sink.finish(&life, &counts, founder_unchanged, roundtrip)
+}
+fn qualified_entry(
+    root: std::path::PathBuf,
+    binding_path: &std::path::Path,
+    scene_index: usize,
+    variant: WorldVariant,
+) -> Result<()> {
+    let scene = *SCENES.get(scene_index).ok_or("case")?;
+    let raw = std::fs::read(binding_path)?;
+    require(raw.len() <= 16384, "binding_bound")?;
+    let binding: native_sink::Binding = serde_json::from_slice(&raw)?;
+    let mut sink = native_sink::NativeSink::new(root, binding, scene, variant)?;
+    if let Err(error) = run_reviewed(scene, variant, &mut sink) {
+        sink.reject(error.as_ref())?;
+        return Err("case rejected; no retry".into());
+    }
+    Ok(())
+}
+struct ReviewedArgs {
+    root: std::path::PathBuf,
+    binding_path: std::path::PathBuf,
+    scene_index: usize,
+    variant: WorldVariant,
+}
+fn parse_reviewed_args(args: &[String]) -> Result<ReviewedArgs> {
+    require(args.len() == 6 && args[1] == "run-reviewed", "cli mode")?;
+    require(!args[2].is_empty() && !args[3].is_empty(), "cli path")?;
+    let scene_index = match args[4].as_str() {
+        "0" => 0,
+        "1" => 1,
+        _ => return Err("cli scene".into()),
+    };
+    let variant = match args[5].as_str() {
+        "old_world" => WorldVariant::OldWorld,
+        "new_world" => WorldVariant::NewWorld,
+        _ => return Err("cli world".into()),
+    };
+    Ok(ReviewedArgs {
+        root: args[2].as_str().into(),
+        binding_path: args[3].as_str().into(),
+        scene_index,
+        variant,
+    })
+}
+fn main() -> Result<()> {
+    Err("disabled source-only proposal; fresh matched v5 has no study dispatch".into())
+}
