+pub(super) fn run_prepared_fixture(
+    world: WorldVariant,
+    observe: &mut impl FnMut(FixtureEvent) -> Result<()>,
+) -> Result<Value> {
+    let mut evidence = Evidence::default();
+    let mut rows = Vec::new();
+    observe(FixtureEvent::Stage {
+        stage: FixtureStage::BeforeConstruction,
+    })?;
+    observe(FixtureEvent::AssetConstruction { returned: false })?;
+    let asset = legacy::construct()?;
+    observe(FixtureEvent::AssetConstruction { returned: true })?;
+    require(
+        digest(&asset.encode_canonical()?) == ASSET_SHA256,
+        "asset_binding",
+    )?;
+    evidence.asset_bound = true;
+    let scene = Scene {
+        seed: FIXTURE_SEED,
+        harmful_slot: 0,
+        appearance: [0, 1],
+        spawn_order: [0, 1],
+    };
+    observe(FixtureEvent::FreshConstruction { returned: false })?;
+    let mut life = make_life_observed::<600>(scene, &asset, |returned| {
+        observe(FixtureEvent::Preparation { returned })
+    })?;
+    observe(FixtureEvent::FreshConstruction { returned: true })?;
+    observe(FixtureEvent::Stage {
+        stage: FixtureStage::PreparedBoundary,
+    })?;
+    guard(&life.host, life.own)?;
+    let founder = bytes(&life.trainer.checkpoint())?;
+    let initial = life.host.checkpoint(&life.trainer)?;
+    require(
+        life.host.world().tick().raw() == 600
+            && initial.residents.len() == 1
+            && initial.sampling_seed == FIXTURE_SEED as u32
+            && initial.sampling_counter == 0
+            && initial.residents.iter().all(|r| {
+                r.memory.records.is_empty()
