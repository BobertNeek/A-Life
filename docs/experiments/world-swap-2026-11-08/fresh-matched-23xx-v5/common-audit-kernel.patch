+//! Reconstructed transient audit. No Serialize/checkpoint/learning field and no writeback.
+use super::*;
+use alife_world::{HeadlessMotorTransactionReceipt, SwapOwnership, SwapPhysicalFacts};
+#[derive(Debug, Clone)]
+pub struct CpuSwapMemorySource {
+    pub memory_id: u64,
+    pub sequence: u64,
+    pub tracked_target: u64,
+    pub action: u32,
+    pub family: u16,
+    pub contact: Option<PhysicalContactKind>,
+}
+#[derive(Debug, Clone)]
+pub struct CpuSwapCandidateAudit {
+    pub candidate_index: u16,
+    pub world_target: Option<WorldEntityId>,
+    pub tracked_target: Option<TrackedObjectId>,
+    pub slot_index: Option<u16>,
+    pub physical: SwapPhysicalFacts,
+    pub target_source_count: u16,
+    pub family_source_count: u16,
+    pub target_confidence: f32,
+    pub family_confidence: f32,
+    pub family_valence: f32,
+    pub best_family_source: Option<CpuSwapMemorySource>,
+}
+#[derive(Debug, Clone)]
+pub struct CpuSwapAudit {
+    pub sequence: ExperienceSequenceId,
+    pub frame_digest: PerceptionFrameDigest,
+    pub current_pain: f32,
+    pub candidates: Vec<CpuSwapCandidateAudit>,
+    pub motor: HeadlessMotorTransactionReceipt,
+    pub owners_before: Vec<SwapOwnership>,
+    pub owners_after: Vec<SwapOwnership>,
+    pub after: Vec<SwapPhysicalFacts>,
+}
+pub(super) fn swap_candidates(
+    world: &HeadlessWorld,
+    perception_world: &HeadlessWorld,
+    frame: &PerceptionFrame,
+    contexts: &[CandidateMemoryContextV1],
+    records: &[PortableMemoryRecordV2],
+) -> Result<Vec<CpuSwapCandidateAudit>, CpuHostError> {
+    frame.validate_contract()?;
+    let own = frame.organism_id();
+    frame
+        .candidates()
+        .iter()
+        .enumerate()
+        .map(|(i, candidate)| {
+            let index =
+                u16::try_from(i).map_err(|_| CpuHostError::State("audit candidate index"))?;
+            let (slot_index, tracked) = match candidate.observation {
+                CandidateObservationRef::None => (None, None),
+                CandidateObservationRef::ObjectSlot(slot_index) => {
+                    let slot = frame
+                        .grounded_object_slots()
+                        .iter()
+                        .find(|s| s.slot_index == slot_index)
+                        .ok_or(CpuHostError::State("audit slot binding"))?;
+                    let target = candidate
+                        .target
+                        .entity
+                        .ok_or(CpuHostError::State("audit missing target"))?;
+                    let object = perception_world
+                        .entity(target)
+                        .ok_or(CpuHostError::State("audit target binding"))?;
+                    let record = perception_world
+                        .tracked_objects()
+                        .records_for(own)
+                        .and_then(|mut records| {
+                            records.find(|r| r.tracking_key == object.tracking_key)
+                        })
+                        .ok_or(CpuHostError::State("audit tracking binding"))?;
+                    if record.tracked_object_id != slot.tracked_object_id {
+                        return Err(CpuHostError::State("audit tracked slot mismatch"));
+                    }
+                    (Some(slot_index), Some(slot.tracked_object_id))
+                }
+            };
+            let context = contexts
+                .iter()
+                .find(|c| c.candidate_index == index)
+                .ok_or(CpuHostError::State("audit recall context missing"))?;
+            context.validate_contract()?;
+            Ok(CpuSwapCandidateAudit {
+                candidate_index: index,
+                world_target: candidate.target.entity,
+                tracked_target: tracked,
+                slot_index,
+                physical: world.research_swap_physical_facts(
+                    own,
+                    candidate.action_id,
+                    candidate.target.entity,
+                ),
+                target_source_count: context.target_source_count,
+                family_source_count: context.family_source_count,
+                target_confidence: context.target_confidence.raw(),
+                family_confidence: context.family_confidence.raw(),
+                family_valence: context.family_value[0],
+                best_family_source: context
+                    .best_family_source
+                    .and_then(|id| records.iter().find(|r| r.memory_id_raw == id.raw()))
+                    .map(|r| CpuSwapMemorySource {
+                        memory_id: r.memory_id_raw,
+                        sequence: r.sealed_sequence_id_raw,
+                        tracked_target: r.tracked_object_id_raw,
+                        action: r.action_id_raw,
+                        family: r.family_raw,
+                        contact: r.outcome_contact,
+                    }),
+            })
+        })
+        .collect()
+}
