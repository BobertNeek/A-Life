+//! Reconstructed opt-in transient facts, never legality counterfactuals or policy inputs.
+use super::*;
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SwapOwner {
+    Missing,
+    Consumed,
+    Nobody,
+    ThisOrganism,
+    OtherOrganism,
+    Player,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum SwapGripMode {
+    None,
+    Activity,
+    Deliberate,
+}
+#[derive(Debug, Clone, PartialEq)]
+pub struct SwapOwnership {
+    pub target: WorldEntityId,
+    pub active: bool,
+    pub owner: SwapOwner,
+    pub mode: SwapGripMode,
+    pub position: Vec3f,
+}
+#[derive(Debug, Clone, PartialEq)]
+pub struct SwapPhysicalFacts {
+    pub tick: Tick,
+    pub organism: OrganismId,
+    pub target: Option<WorldEntityId>,
+    pub primitive: ActionId,
+    pub owner: SwapOwner,
+    pub mode: SwapGripMode,
+    pub active: bool,
+    pub self_held_object_count: usize,
+    pub actor_alive: bool,
+    pub manipulation_effector: bool,
+    pub physical_contact_reachable: Option<bool>,
+    pub grasp_reachable: Option<bool>,
+}
+impl HeadlessWorld {
+    fn swap_owner(&self, organism: OrganismId, object: &WorldObject) -> SwapOwner {
+        if object.consumed {
+            SwapOwner::Consumed
+        } else if self.player_held_object() == Some(object.id) {
+            SwapOwner::Player
+        } else if object.carried_by == Some(organism) {
+            SwapOwner::ThisOrganism
+        } else if object.carried_by.is_some() {
+            SwapOwner::OtherOrganism
+        } else {
+            SwapOwner::Nobody
+        }
+    }
+    pub fn research_swap_owners(&self, organism: OrganismId) -> Vec<SwapOwnership> {
+        self.objects
+            .values()
+            .map(|o| SwapOwnership {
+                target: o.id,
+                active: !o.consumed,
+                owner: self.swap_owner(organism, o),
+                mode: if o.consumed || o.carried_by.is_none() {
+                    SwapGripMode::None
+                } else if o.activity_hold {
+                    SwapGripMode::Activity
+                } else {
+                    SwapGripMode::Deliberate
+                },
+                position: o.position,
+            })
+            .collect()
+    }
+    pub fn research_swap_physical_facts(
+        &self,
+        organism: OrganismId,
+        primitive: ActionId,
+        target: Option<WorldEntityId>,
+    ) -> SwapPhysicalFacts {
+        let record = self.organism_registry.get(organism);
+        let agent = self.agent_entity_id(organism).ok();
+        let alive = agent
+            .and_then(|id| self.objects.get(&id.raw()))
+            .is_some_and(|a| !a.consumed && record.is_none_or(|r| r.lifecycle().is_alive()));
+        let effector = record.is_none_or(|r| {
+            r.embodiment()
+                .effector_gain(EffectorCapability::Manipulation)
+                > 0.
+        });
+        let mut facts = SwapPhysicalFacts {
+            tick: self.tick,
+            organism,
+            target,
+            primitive,
+            owner: SwapOwner::Missing,
+            mode: SwapGripMode::None,
+            active: false,
+            self_held_object_count: self
+                .objects
+                .values()
+                .filter(|o| !o.consumed && o.carried_by == Some(organism))
+                .count(),
+            actor_alive: alive,
+            manipulation_effector: effector,
+            physical_contact_reachable: None,
+            grasp_reachable: None,
+        };
+        let Some(id) = target else { return facts };
+        let Some(object) = self.objects.get(&id.raw()) else {
+            return facts;
+        };
+        facts.owner = self.swap_owner(organism, object);
+        facts.active = !object.consumed;
+        facts.mode = if object.consumed || object.carried_by.is_none() {
+            SwapGripMode::None
+        } else if object.activity_hold {
+            SwapGripMode::Activity
+        } else {
+            SwapGripMode::Deliberate
+        };
+        if let Some(agent) = agent {
+            if let Some(body) = self.objects.get(&agent.raw()) {
+                facts.physical_contact_reachable =
+                    Some(self.physical_contact_reachable(body.position, object.position));
+                facts.grasp_reachable = Some(self.grasp_target_is_reachable(organism, agent, id));
+            }
+        }
+        facts
+    }
+}
