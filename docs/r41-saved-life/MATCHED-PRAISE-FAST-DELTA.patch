diff --git a/crates/alife_game_app/src/foundation_training_cycle/saved_life_retention/matched_praise.rs b/crates/alife_game_app/src/foundation_training_cycle/saved_life_retention/matched_praise.rs
new file mode 100644
--- /dev/null
+++ b/crates/alife_game_app/src/foundation_training_cycle/saved_life_retention/matched_praise.rs
@@ -0,0 +1,671 @@
+//! Opt-in retained quiet / single World Praise diagnostic. Never score or authorize.
+use super::{digest, neutral_route, Result};
+use crate::gpu_live_runtime::{FoundationTrainingStep, GpuLiveBrainRuntime};
+use alife_core::{MotorChannel, OrganismId, PhysicalContactKind, Tick, Validate, Vec3f};
+use alife_world::{HeadlessActionIds, PlayerCareKind, PlayerCareKindSet, PlayerCareReceipt,
+    PlayerInteractionQueueOutcomeV1, PlayerInteractionV1};
+use neutral_route::{FixedRouteCoordinateV1, FixedRouteCutV1, NeutralRouteObserverSpecV1};
+use serde::{Deserialize, Serialize};
+use std::{fs, io::Read, path::Path};
+
+pub(super) const SCHEMA: u16 = 20;
+pub(super) const CUTS: u64 = 12;
+pub(super) const ANCHOR_OFFSET: u64 = 6;
+pub(super) const CONFIG_LIMIT: usize = 16_384;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Arm { Quiet, Praise }
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct QuietProofInputsV1 {
+    independent_a_sha256: String,
+    owner_readback_sha256: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Spec {
+    pub(super) arm: Arm,
+    pub(super) source_world_tick: u64,
+    hand_world_position: [f32; 3],
+    coordinates: [FixedRouteCoordinateV1; 8],
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    quiet_proof: Option<QuietProofInputsV1>,
+}
+
+fn hash_shape(s: &str) -> bool {
+    s.len() == 64 && s.bytes().any(|b| b != b'0')
+        && s.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+}
+
+impl Spec {
+    pub(super) fn validate(&self) -> Result<()> {
+        self.observation().validate()?;
+        self.position().validate()?;
+        if self.source_world_tick.checked_add(CUTS).is_none()
+            || !self.coordinates.iter().all(FixedRouteCoordinateV1::valid)
+            || self.coordinates.windows(2).any(|w| w[0].decoder_local_index >= w[1].decoder_local_index)
+            || self.coordinates.iter().enumerate().any(|(i, a)|
+                self.coordinates[..i].iter().any(|b| a.canonical_phenotype_index == b.canonical_phenotype_index
+                    || a.gpu_local_synapse_id == b.gpu_local_synapse_id))
+        {
+            return Err("matched Praise requires eight unique, sorted and typed Approach coordinates".into());
+        }
+        match (&self.arm, &self.quiet_proof) {
+            (Arm::Quiet, None) => Ok(()),
+            (Arm::Praise, Some(q)) if hash_shape(&q.independent_a_sha256)
+                && hash_shape(&q.owner_readback_sha256)
+                && q.independent_a_sha256 != q.owner_readback_sha256 => Ok(()),
+            _ => Err("matched Praise accepts quiet or Praise bound to actual independent quiet proof bytes".into()),
+        }
+    }
+
+    fn observation(&self) -> NeutralRouteObserverSpecV1 {
+        NeutralRouteObserverSpecV1 { source_world_tick: self.source_world_tick,
+            first_postcommit_world_offset: ANCHOR_OFFSET as u8, postcommit_boundary_count: 3 }
+    }
+
+    fn anchor_tick(&self) -> u64 { self.source_world_tick + ANCHOR_OFFSET }
+
+    fn position(&self) -> Vec3f {
+        let [x, y, z] = self.hand_world_position;
+        Vec3f::new(x, y, z)
+    }
+
+    fn common_spec_sha256(&self) -> Result<String> {
+        Ok(digest(&serde_json::to_vec(&("qualia-retained-matched-praise-common-v1", self.observation(),
+            self.hand_world_position.map(f32::to_bits), &self.coordinates))?))
+    }
+}
+
+/// Evidence link only, not the operator's authorization. Actual signed scope,
+/// evaluator bytes, independent 0/0, and native lease must be checked by host.
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct RootInputsV1 {
+    schema: String,
+    role: Arm,
+    run_id: String,
+    owner: u64,
+    manifest_sha256: String,
+    source_current_sha256: String,
+    evaluator_sha256: String,
+    independent_zero_sha256: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct VerifiedQuietAnchorV1 {
+    schema: String,
+    role: Arm,
+    independently_accepted: bool,
+    authorizes_next_arm: bool,
+    owned_native_process_reaped: bool,
+    actual_paid_window_observed: bool,
+    source_world_tick: u64,
+    owner: u64,
+    run_id: String,
+    source_current_sha256: String,
+    evaluator_sha256: String,
+    independent_zero_sha256: String,
+    common_spec_sha256: String,
+    actual_a_root_inputs_sha256: String,
+    actual_a_request_sha256: String,
+    actual_a_native_rows_sha256: String,
+    actual_a_native_receipt_sha256: String,
+    actual_a_native_process_sha256: String,
+    actual_a_fence_release_sha256: String,
+    actual_a_pre_cue_anchor_sha256: String,
+    actual_a_primary: CutCoordinatesV1,
+    actual_a_next: CutCoordinatesV1,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CutCoordinatesV1 {
+    origin_tick: u64,
+    world_tick: u64,
+    paid_candidate_index: u16,
+    actual_joint_candidate_slots: [u16; 6],
+    actual_representative_index: u16,
+    actual_admission_masks_sha256: String,
+    paid_own_energy_cost_f32: u32,
+    paid_own_displacement_f32: [u32; 3],
+    actual_world_pre_pose_xyzyaw_f32: [u32; 4],
+    actual_world_post_pose_xyzyaw_f32: [u32; 4],
+    work_sha256: String,
+    fast_generations: [u64; 2],
+    before_fast_bits: [u32; 8],
+    committed_fast_bits: [u32; 8],
+}
+
+impl CutCoordinatesV1 {
+    fn valid(&self) -> bool {
+        let xyz_pose_delta_matches_own_execution = self.actual_world_pre_pose_xyzyaw_f32.iter()
+            .chain(&self.actual_world_post_pose_xyzyaw_f32).all(|&b| f32::from_bits(b).is_finite())
+            && (0..3).all(|i|
+                (f32::from_bits(self.actual_world_post_pose_xyzyaw_f32[i])
+                 - f32::from_bits(self.actual_world_pre_pose_xyzyaw_f32[i])).to_bits()
+                == self.paid_own_displacement_f32[i]);
+        let positive = f32::from_bits(self.paid_own_energy_cost_f32);
+        self.origin_tick.checked_add(1) == Some(self.world_tick)
+            && self.paid_candidate_index != u16::MAX
+            && self.actual_joint_candidate_slots[0] == self.paid_candidate_index
+            && self.actual_representative_index != u16::MAX
+            && self.actual_joint_candidate_slots.contains(&self.actual_representative_index)
+            && hash_shape(&self.actual_admission_masks_sha256)
+            && positive.is_finite() && positive > 0.0
+            && self.paid_own_displacement_f32.iter().all(|&b| f32::from_bits(b).is_finite())
+            && self.paid_own_displacement_f32.iter().any(|&b| f32::from_bits(b) != 0.0)
+            && self.fast_generations[0] != 0
+            && self.fast_generations[0].checked_add(1) == Some(self.fast_generations[1])
+            && self.before_fast_bits.iter().chain(&self.committed_fast_bits)
+                .all(|&b| f32::from_bits(b).is_finite() && b != 0x8000_0000)
+            && xyz_pose_delta_matches_own_execution && hash_shape(&self.work_sha256)
+    }
+}
+
+#[derive(Serialize)]
+struct MatchedCoordinateDeltaV1 {
+    origin_tick: u64,
+    coordinate: FixedRouteCoordinateV1,
+    quiet_before_fast_f32: u32,
+    quiet_committed_fast_f32: u32,
+    praise_before_fast_f32: u32,
+    praise_committed_fast_f32: u32,
+    quiet_out_minus_in_f64_bits: u64,
+    praise_out_minus_in_f64_bits: u64,
+    praise_minus_quiet_increment_f64_bits: u64,
+}
+
+/// None means no supported matched numeric observation, not eight unchanged words.
+fn compare_cuts(a: &CutCoordinatesV1, b: &CutCoordinatesV1,
+    points: &[FixedRouteCoordinateV1; 8], require_common_input: bool,
+) -> Option<[MatchedCoordinateDeltaV1; 8]> {
+    if !a.valid() || !b.valid() || a.origin_tick != b.origin_tick || a.world_tick != b.world_tick
+        || a.fast_generations != b.fast_generations || a.paid_candidate_index != b.paid_candidate_index
+        || a.actual_joint_candidate_slots != b.actual_joint_candidate_slots
+        || a.actual_representative_index != b.actual_representative_index
+        || a.actual_admission_masks_sha256 != b.actual_admission_masks_sha256
+        || a.paid_own_energy_cost_f32 != b.paid_own_energy_cost_f32 || a.work_sha256 != b.work_sha256
+        || a.paid_own_displacement_f32 != b.paid_own_displacement_f32
+        || a.actual_world_pre_pose_xyzyaw_f32 != b.actual_world_pre_pose_xyzyaw_f32
+        || a.actual_world_post_pose_xyzyaw_f32 != b.actual_world_post_pose_xyzyaw_f32
+        || (require_common_input && a.before_fast_bits != b.before_fast_bits)
+    { return None; }
+    Some(std::array::from_fn(|i| {
+        let diff = |before, after| f64::from(f32::from_bits(after)) - f64::from(f32::from_bits(before));
+        let a_delta = diff(a.before_fast_bits[i], a.committed_fast_bits[i]);
+        let b_delta = diff(b.before_fast_bits[i], b.committed_fast_bits[i]);
+        MatchedCoordinateDeltaV1 {
+            origin_tick: b.origin_tick, coordinate: points[i],
+            quiet_before_fast_f32: a.before_fast_bits[i], quiet_committed_fast_f32: a.committed_fast_bits[i],
+            praise_before_fast_f32: b.before_fast_bits[i], praise_committed_fast_f32: b.committed_fast_bits[i],
+            quiet_out_minus_in_f64_bits: a_delta.to_bits(), praise_out_minus_in_f64_bits: b_delta.to_bits(),
+            praise_minus_quiet_increment_f64_bits: (b_delta - a_delta).to_bits(),
+        }
+    }))
+}
