+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum DoseStage { PendingAnchor, Quiet, Withheld, Ready, Queued, Applied }
+
+fn queue_due(stage: DoseStage, before: u64, at: u64) -> bool {
+    stage == DoseStage::Ready && before == at
+}
