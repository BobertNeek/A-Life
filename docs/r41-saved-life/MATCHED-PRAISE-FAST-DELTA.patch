+#[derive(Serialize)]
+struct BoundaryV1 {
+    world_tick: u64,
+    paid_locomotion: Option<PaidLocomotionV1>,
+    cut: Option<FixedRouteCutV1>,
+    numeric_paid_cut: Option<CutCoordinatesV1>,
+    unobserved_reason: Option<&'static str>,
+}
+
+pub(super) struct Probe {
+    spec: Spec,
+    binding: Binding,
+    stage: DoseStage,
+    boundaries: Vec<BoundaryV1>,
+    observed_care: Option<PlayerCareReceipt>,
+    acoustic: Vec<(u64, u32)>,
+    anchor_sha256: Option<String>,
+    control_confound: bool,
+}
+
+impl Probe {
+    pub(super) fn new(spec: Spec, binding: Binding, source_tick: u64,
+        pending_empty: bool, speech_empty: bool) -> Result<Self>
+    {
+        if !spec.observation().matches_restored_opening(source_tick, pending_empty, speech_empty) {
+            return Err("matched Praise requires the exact originally silent retained opening".into());
+        }
+        Ok(Self { spec, binding, stage: DoseStage::PendingAnchor, boundaries: Vec::new(),
+            observed_care: None, acoustic: Vec::new(), anchor_sha256: None, control_confound: false })
+    }
+
+    pub(super) fn maybe_queue(&mut self, runtime: &mut GpuLiveBrainRuntime, owner: OrganismId,
+        before: Tick) -> Result<()>
+    {
+        if before.raw() > self.spec.anchor_tick()
+            && matches!(self.stage, DoseStage::PendingAnchor | DoseStage::Ready)
+        {
+            // A missing/late authority never slides the intervention.
+            self.stage = DoseStage::Withheld;
+        }
+        if !queue_due(self.stage, before.raw(), self.spec.anchor_tick()) { return Ok(()); }
+        self.stage = DoseStage::Withheld; // refuse and never requeue even if the World returns no dose
+        match runtime.provide_player_interaction_v1(owner, self.spec.position(), PlayerInteractionV1::Praise)? {
+            PlayerInteractionQueueOutcomeV1::Queued => { self.stage = DoseStage::Queued; Ok(()) }
+            PlayerInteractionQueueOutcomeV1::NoReceivedDose => Err("actual World Hand queued no Praise".into()),
+        }
+    }
+
+    pub(super) fn observe(&mut self, runtime: &mut GpuLiveBrainRuntime, owner: OrganismId,
+        before: Tick, after: Tick, steps: &[FoundationTrainingStep], clean: bool,
+        pre_pose: Option<(Vec3f, f32)>, post_pose: Option<(Vec3f, f32)>,
+    ) -> Result<()>
+    {
+        self.control_confound |= !clean;
+        let latest = runtime.world().last_player_care(owner);
+        let fresh = latest.filter(|x| x.applied_tick.raw() > before.raw());
+        if after == before {
+            if fresh.is_some() || !steps.is_empty() { return Err("matched Praise pulse or row on a poll".into()); }
+            return Ok(());
+        }
+        let is_consumption_cut = self.stage == DoseStage::Queued && before.raw() == self.spec.anchor_tick();
+        match (is_consumption_cut, fresh) {
+            (true, Some(care)) if care.applied_tick == after
+                && care.kinds == PlayerCareKindSet::single(PlayerCareKind::Praise) =>
+            {
+                self.observed_care = Some(care);
+                self.stage = DoseStage::Applied;
+            }
+            (false, None) => {},
+            _ => return Err("matched Praise missing singleton real care or received foreign care".into()),
+        }
+        if external_speech(runtime, steps) {
+            return Err("matched Praise refuses exterior speech tokens".into());
+        }
+        if let [s] = steps {
+            let bits = s.frame.sensory().channels.auditory_acoustic[1].to_bits();
+            if self.observed_care.is_none() && bits != 0 {
+                return Err("matched Praise acoustic input without authoritative care".into());
+            }
+            self.acoustic.push((before.raw(), bits));
+        }
+        let world_tick = after.raw();
+        if !self.spec.observation().requested(world_tick) { return Ok(()); }
+        let mut paid = None;
+        let mut cut = None;
+        let mut numeric_paid_cut = None;
+        let mut reason = Some("ordinary_published_route_unobserved");
+        if let [step] = steps {
+            if clean {
+                paid = actual_paid_step(step);
+                if let Ok(value) = runtime.observe_fixed_retained_route_v1(
+                    self.spec.observation(), step, after, &self.spec.coordinates
+                ) {
+                    if let (Some(loc), Some(pre), Some(post)) =
+                        (paid.filter(|p| value.anchor_uses_paid_slot(p.actual_joint_candidate_index)), pre_pose, post_pose)
+                    {
+                        let (before_fast_bits, committed_fast_bits) = value.raw_fast_words();
+                        let row = CutCoordinatesV1 {
+                            origin_tick: before.raw(), world_tick, paid_candidate_index: loc.actual_joint_candidate_index,
+                            actual_joint_candidate_slots: value.motor_candidates(),
+                            actual_representative_index: step.behavior.representative_index,
+                            actual_admission_masks_sha256: digest(&serde_json::to_vec(&(
+                                &step.behavior.representative_mask, &step.behavior.motor_masks,
+                                &step.behavior.forced_motor_slots,
+                            ))?),
+                            paid_own_energy_cost_f32: loc.own_positive_energy_cost_f32,
+                            paid_own_displacement_f32: loc.own_physical_displacement_f32,
+                            actual_world_pre_pose_xyzyaw_f32: pose_words(pre),
+                            actual_world_post_pose_xyzyaw_f32: pose_words(post),
+                            work_sha256: digest(&serde_json::to_vec(&step.work)?),
+                            fast_generations: value.raw_generation_pair(), before_fast_bits, committed_fast_bits,
+                        };
+                        if row.valid() { numeric_paid_cut = Some(row); }
+                    }
+                    cut = Some(value);
+                    reason = None;
+                }
+            }
+        }
+        if world_tick == self.spec.anchor_tick() {
+            self.stage = match self.spec.arm { Arm::Quiet => DoseStage::Quiet, Arm::Praise => DoseStage::Withheld };
+            if let (Some(paid), Some(cut), Some(physical), [step]) =
+                (&paid, &cut, &numeric_paid_cut, steps)
+            {
+                if cut.all_active_nonzero() && cut.anchor_uses_paid_slot(paid.actual_joint_candidate_index)
+                    && self.observed_care.is_none() && !self.control_confound
+                {
+                    let a = digest(&serde_json::to_vec(&(
+                        "matched-praise-actual-before-sense-anchor-v1", self.spec.common_spec_sha256()?,
+                        runtime.world().canonical_signature_digest()?, &step.behavior.sampling,
+                        &step.work, &cut, paid, physical,
+                    ))?);
+                    self.anchor_sha256 = Some(a.clone());
+                    if self.binding.quiet.as_ref().is_some_and(|q| q.actual_a_pre_cue_anchor_sha256 == a) {
+                        self.stage = DoseStage::Ready;
+                    }
+                }
+            }
+        }
+        self.boundaries.push(BoundaryV1 { world_tick, paid_locomotion: paid, cut, numeric_paid_cut, unobserved_reason: reason });
+        Ok(())
+    }
+
+    pub(super) fn report(self, valid_stock_closure: bool) -> Result<serde_json::Value> {
+        let controls = valid_stock_closure && !self.control_confound
+            && self.boundaries.len() == 3 && self.acoustic.len() == CUTS as usize;
+        let mut primary = None;
+        let mut next = None;
+        if controls && self.stage == DoseStage::Applied {
+            if let (Some(a), [anchor, first, later]) = (&self.binding.quiet, self.boundaries.as_slice()) {
+                if let (Some(prior), Some(b)) = (&anchor.numeric_paid_cut, &first.numeric_paid_cut) {
+                    if self.anchor_sha256.as_deref() == Some(a.actual_a_pre_cue_anchor_sha256.as_str())
+                        && prior.committed_fast_bits == b.before_fast_bits
+                        && prior.fast_generations[1] == b.fast_generations[0]
+                    {
+                        primary = compare_cuts(&a.actual_a_primary, b, &self.spec.coordinates, true);
+                        if let (true, Some(l)) = (primary.is_some(), &later.numeric_paid_cut) {
+                            if b.committed_fast_bits == l.before_fast_bits
+                                && b.fast_generations[1] == l.fast_generations[0]
+                            {
+                                next = compare_cuts(&a.actual_a_next, l, &self.spec.coordinates, false);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        Ok(serde_json::json!({
+            "schema_version":1, "comparison_scope":"retained_matched_praise_fast_delta_only",
+            "role":self.spec.arm, "source_world_tick":self.spec.source_world_tick,
+            "common_spec_sha256":self.spec.common_spec_sha256()?,
+            "root_inputs_sha256":self.binding.root_sha256, "root_inputs":self.binding.root,
+            "quiet_proof_inputs": self.spec.quiet_proof, "actual_pre_cue_anchor_sha256":self.anchor_sha256,
+            "actual_dose_stage":self.stage, "actual_singleton_world_care":self.observed_care,
+            "sealed_row_acoustic_praise_bits":self.acoustic, "boundaries":self.boundaries,
+            "bounded_control_closure_intact":controls,
+            "primary_provisional_named_delta_comparison":primary,
+            "next_provisional_named_delta_comparison":next,
+            "packet_and_independent_same_role_raw_verification_required":true,
+            "scorecard_eligible":false,
+            "evaluation_only":true, "authorizes_next_arm":false,
+            "matched_credit_or_memory_verified":false,
+        }))
+    }
+}
