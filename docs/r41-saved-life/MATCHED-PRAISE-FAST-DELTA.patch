+        b.committed_fast_bits[0] = 0.25f32.to_bits();
+        assert!(f64::from_bits(compare_cuts(&a, &b, &c, true).unwrap()[0].praise_minus_quiet_increment_f64_bits) < 0.0);
+        b.before_fast_bits[0] = 0.27f32.to_bits();
+        assert!(compare_cuts(&a, &b, &c, true).is_none());
+        assert!(compare_cuts(&a, &b, &c, false).is_some());
+        b.paid_own_energy_cost_f32 = 0;
+        assert!(compare_cuts(&a, &b, &c, false).is_none());
+        b = cut();
+        b.actual_representative_index = 2;
+        assert!(compare_cuts(&a, &b, &c, true).is_none());
+        b = cut();
+        b.actual_joint_candidate_slots[0] = 1;
+        assert!(compare_cuts(&a, &b, &c, true).is_none());
+        b = cut();
+        b.actual_admission_masks_sha256 = "c".repeat(64);
+        assert!(compare_cuts(&a, &b, &c, true).is_none());
+        b = cut();
+        b.paid_own_displacement_f32[0] = 2.0f32.to_bits();
+        assert!(!b.valid()); // World pose cannot substantiate this settlement
+        b.actual_world_post_pose_xyzyaw_f32[0] = 2.0f32.to_bits();
+        assert!(b.valid()); // actual independently grounded drift, not an equal physical cut
+        assert!(compare_cuts(&a, &b, &c, true).is_none());
+        b = cut();
+        b.actual_world_post_pose_xyzyaw_f32[3] = 1.0f32.to_bits();
+        assert!(b.valid() && compare_cuts(&a, &b, &c, true).is_none());
+    }
+}
