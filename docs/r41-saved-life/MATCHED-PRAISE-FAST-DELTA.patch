+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct QuietOwnerReadbackV1 {
+    schema: String,
+    authorizes_next_arm: bool,
+    private_owner_only_before_and_after: bool,
+    raw_full_byte_stream_match: bool,
+    independent_a_sha256: String,
+    actual_a_native_process_sha256: String,
+    actual_a_fence_release_sha256: String,
+    archive_sha256: String,
+    archive_bytes: u64,
+}
+
+/// Exact owner-0400 inputs, same directory owner, no symlink, same held inode
+/// and stable metadata throughout. Nothing here grants a kernel lock or starts a run.
+#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
+fn read_evidence<T: serde::de::DeserializeOwned>(root: &Path, name: &str) -> Result<(T, String)> {
+    use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+    let dir = fs::symlink_metadata(root)?;
+    let path = root.join(name);
+    let before = fs::symlink_metadata(&path)?;
+    let stamp = |m: &fs::Metadata| (m.dev(), m.ino(), m.uid(), m.mode(), m.nlink(),
+        m.len(), m.mtime(), m.mtime_nsec(), m.ctime(), m.ctime_nsec());
+    if !dir.is_dir() || dir.mode() & 0o7777 != 0o700
+        || !before.is_file() || before.mode() & 0o7777 != 0o400
+        || before.uid() != dir.uid() || before.nlink() != 1 || before.len() == 0
+        || before.len() > CONFIG_LIMIT as u64
+    {
+        return Err("matched Praise requires bounded private immutable evidence inputs".into());
+    }
+    // Linux x86_64 O_NOFOLLOW | O_NONBLOCK; a raced FIFO never blocks this preflight.
+    let file = fs::OpenOptions::new().read(true).custom_flags(0x20800).open(&path)?;
+    if stamp(&file.metadata()?) != stamp(&before) {
+        return Err("matched Praise evidence inode changed before read".into());
+    }
+    let mut bytes = Vec::new();
+    (&file).take(CONFIG_LIMIT as u64 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 != before.len() || stamp(&file.metadata()?) != stamp(&before)
+        || stamp(&fs::symlink_metadata(&path)?) != stamp(&before)
+        || stamp(&fs::symlink_metadata(root)?) != stamp(&dir)
+    {
+        return Err("matched Praise evidence changed during read".into());
+    }
+    Ok((serde_json::from_slice(&bytes)?, digest(&bytes)))
+}
+
+#[cfg(not(all(target_os = "linux", target_arch = "x86_64")))]
+fn read_evidence<T: serde::de::DeserializeOwned>(_: &Path, _: &str) -> Result<(T, String)> {
+    Err("matched Praise private evidence admission is implemented only on Linux x86_64".into())
+}
+
+pub(super) struct Binding {
+    root_sha256: String,
+    root: RootInputsV1,
+    quiet: Option<VerifiedQuietAnchorV1>,
+}
+
+pub(super) fn bind_private_bytes(root: &Path, spec: &Spec, run: &str, owner: u64,
+    manifest_sha256: &str, current_sha256: &str) -> Result<Binding>
+{
+    let (inputs, root_sha256) =
+        read_evidence::<RootInputsV1>(root, "matched-praise-root-inputs.v1.json")?;
+    if inputs.schema != "qualia.private.retained_matched_praise.root_inputs.v1"
+        || inputs.role != spec.arm || inputs.run_id != run || inputs.owner != owner
+        || inputs.manifest_sha256 != manifest_sha256 || inputs.source_current_sha256 != current_sha256
+        || !hash_shape(&inputs.evaluator_sha256) || !hash_shape(&inputs.independent_zero_sha256)
+    {
+        return Err("matched Praise root-input bytes do not bind the exact manifest, role and source".into());
+    }
+    let quiet = if let Some(q) = &spec.quiet_proof {
+        let (a, a_sha) = read_evidence::<VerifiedQuietAnchorV1>(root, "matched-praise-a5-quiet.v1.json")?;
+        let (backup, backup_sha) = read_evidence::<QuietOwnerReadbackV1>(root, "matched-praise-a-owner.v1.json")?;
+        let (a_root, a_root_sha) =
+            read_evidence::<RootInputsV1>(root, "matched-praise-a-root-inputs.v1.json")?;
+        if a_sha != q.independent_a_sha256 || backup_sha != q.owner_readback_sha256
+            || a_root_sha != a.actual_a_root_inputs_sha256 || a_root_sha == root_sha256
+            || a_root.schema != inputs.schema || a_root.role != Arm::Quiet
+            || a_root.run_id != a.run_id || a_root.owner != inputs.owner
+            || a_root.manifest_sha256 != a.actual_a_request_sha256
+            || a_root.source_current_sha256 != inputs.source_current_sha256
+            || a_root.evaluator_sha256 != inputs.evaluator_sha256
+            || a_root.independent_zero_sha256 != inputs.independent_zero_sha256
+            || !validate_quiet_links(&inputs, spec, &a, &backup, &a_sha)?
+        {
+            return Err("matched Praise cross-role exact independent quiet and owner bytes do not agree".into());
+        }
+        Some(a)
+    } else { None };
+    Ok(Binding { root_sha256, root: inputs, quiet })
+}
+
+fn validate_quiet_links(root: &RootInputsV1, spec: &Spec, a: &VerifiedQuietAnchorV1,
+    backup: &QuietOwnerReadbackV1, a_sha: &str) -> Result<bool>
+{
+    Ok(a.schema == "qualia.private.retained_matched_praise.independent_quiet.v1"
+        && a.role == Arm::Quiet && a.independently_accepted && !a.authorizes_next_arm
+        && a.owned_native_process_reaped && a.actual_paid_window_observed
+        && a.source_world_tick == spec.source_world_tick && a.owner == root.owner
+        && !a.run_id.is_empty() && a.run_id != root.run_id
+        && a.source_current_sha256 == root.source_current_sha256
+        && a.evaluator_sha256 == root.evaluator_sha256
+        && a.independent_zero_sha256 == root.independent_zero_sha256
+        && a.common_spec_sha256 == spec.common_spec_sha256()?
+        && [&a.actual_a_root_inputs_sha256, &a.actual_a_request_sha256, &a.actual_a_native_rows_sha256,
+            &a.actual_a_native_receipt_sha256, &a.actual_a_native_process_sha256,
+            &a.actual_a_fence_release_sha256, &a.actual_a_pre_cue_anchor_sha256]
+            .into_iter().all(|s| hash_shape(s))
+        && a.actual_a_root_inputs_sha256 != a.actual_a_request_sha256
+        && a.actual_a_request_sha256 != root.manifest_sha256
+        && a.actual_a_native_process_sha256 != a.actual_a_fence_release_sha256
+        && a.actual_a_primary.valid() && a.actual_a_next.valid()
+        && a.actual_a_primary.origin_tick == spec.anchor_tick()
+        && a.actual_a_next.origin_tick == a.actual_a_primary.world_tick
+        && a.actual_a_next.before_fast_bits == a.actual_a_primary.committed_fast_bits
+        && a.actual_a_next.fast_generations[0] == a.actual_a_primary.fast_generations[1]
+        && backup.schema == "qualia.private.retained_matched_praise.quiet_owner_readback.v1"
+        && !backup.authorizes_next_arm && backup.private_owner_only_before_and_after
+        && backup.raw_full_byte_stream_match && backup.independent_a_sha256 == a_sha
+        && backup.actual_a_native_process_sha256 == a.actual_a_native_process_sha256
+        && backup.actual_a_fence_release_sha256 == a.actual_a_fence_release_sha256
+        && hash_shape(&backup.archive_sha256) && backup.archive_bytes > 0)
+}
