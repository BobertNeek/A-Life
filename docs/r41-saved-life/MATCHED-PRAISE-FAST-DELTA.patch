+#[derive(Clone, Copy, Serialize)]
+struct PaidLocomotionV1 {
+    actual_joint_candidate_index: u16,
+    own_positive_energy_cost_f32: u32,
+    own_physical_displacement_f32: [u32; 3],
+}
+
+fn displacement_words(v: Vec3f) -> [u32; 3] { [v.x.to_bits(), v.y.to_bits(), v.z.to_bits()] }
+fn pose_words((v, yaw): (Vec3f, f32)) -> [u32; 4] {
+    [v.x.to_bits(), v.y.to_bits(), v.z.to_bits(), yaw.to_bits()]
+}
+
+fn actual_paid_step(step: &FoundationTrainingStep) -> Option<PaidLocomotionV1> {
+    let slot = step.behavior.motor_indices[0];
+    let c = step.frame.candidates().get(usize::from(slot))?;
+    let p = step.patch.outcome();
+    let b = step.patch.selected_bundle()?;
+    let joint = p.joint.as_ref()?;
+    let cmd = b.channels.iter().find(|x| x.channel == MotorChannel::Locomotion)?;
+    let o = joint.channel_observations.iter().find(|x| x.channel == MotorChannel::Locomotion)?;
+    let ch = joint.channel_outcomes.iter().find(|x| x.channel == MotorChannel::Locomotion)?;
+    let e = ch.execution_evidence.as_ref()?;
+    let physical = &ch.physical;
+    let displacement = displacement_words(physical.displacement);
+    let energy = physical.energy_cost.raw();
+    (c.candidate_index == slot && c.action_id == HeadlessActionIds::STEP_FORWARD && c.family.raw() == 3
+        && c.target.entity.is_none() && c.target.position.is_none()
+        && cmd.primitive == c.action_id && cmd.target.is_none()
+        && o.executed && e.succeeded && e.primitive == c.action_id && e.command_target.is_none()
+        && physical.target_entity.is_none() && physical.contact == PhysicalContactKind::Moved
+        && energy.is_finite() && energy > 0.0 && physical.displacement.validate().is_ok()
+        && displacement.iter().any(|&bits| f32::from_bits(bits) != 0.0)
+        && displacement_words(o.displacement) == displacement).then_some(PaidLocomotionV1 {
+            actual_joint_candidate_index: slot,
+            own_positive_energy_cost_f32: energy.to_bits(),
+            own_physical_displacement_f32: displacement,
+        })
+}
+
+fn external_speech(runtime: &GpuLiveBrainRuntime, steps: &[FoundationTrainingStep]) -> bool {
+    use alife_core::UtteranceSourceKind::{Player, Teacher};
+    runtime.world().audible_utterances().iter().any(|x| matches!(x.source_kind, Player | Teacher))
+        || steps.iter().any(|s| s.frame.sensory().language_context.heard_tokens.iter().flatten()
+            .any(|x| matches!(x.source_kind, Player | Teacher)))
+}
