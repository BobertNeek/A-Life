diff --git a/crates/alife_core/tests/n4096_parked_h_only.rs b/crates/alife_core/tests/n4096_parked_h_only.rs
new file mode 100644
index 0000000..fcfc2ff
--- /dev/null
+++ b/crates/alife_core/tests/n4096_parked_h_only.rs
@@ -0,0 +1,87 @@
+#![cfg(feature = "research-n4096-parked-transport")]
+
+use alife_core::{
+    BrainCapacityClass, BrainGenome, BrainPhenotype, DevelopmentState, LobeKind, NormalizedScalar,
+    N2048FoundationLayoutV1, PhenotypeCompiler, PhenotypeCompilerInputs,
+    PhenotypeGrowthMigration, SensorProfile, Tick,
+};
+
+fn compile(seed: u64) -> (BrainPhenotype, PhenotypeCompilerInputs) {
+    let capacity = BrainCapacityClass::n2048();
+    let genome = BrainGenome::scaffold(seed, capacity.id());
+    let development =
+        DevelopmentState::new(genome.id, Tick::ZERO, NormalizedScalar::new(1.0).unwrap());
+    let inputs = PhenotypeCompilerInputs::try_new(
+        genome, &capacity, development, SensorProfile::GroundedObjectSlotsV1,
+    ).unwrap();
+    let phenotype = PhenotypeCompiler::compile_validated(&inputs,&capacity).unwrap();
+    (phenotype,inputs)
+}
+
+#[test]
+fn actual_compiler_emits_4096_h_only_layout_with_no_extra_decoder_or_recurrent_rows() {
+    let (original,input) = compile(0x4096_2048);
+    let raw = serde_json::to_vec(&original).unwrap();
+    let width = BrainPhenotype::compile_parked_n4096_h_only(&original, &input).unwrap();
+    assert!(width.is_parked_n4096_h_only());
+    assert_eq!(width.neuron_count(), 4096);
+    assert_eq!(width.synapses().len(), original.synapses().len());
+    assert_eq!(width.projections(),original.projections());
+    assert_eq!(width.replay_capture_plan(),original.replay_capture_plan());
+    assert_eq!(width.language_codebook(),original.language_codebook());
+    assert_eq!(width.candidate_decoder().motor_width(),original.candidate_decoder().motor_width());
+    assert_ne!(width.phenotype_hash(), original.phenotype_hash());
+    let source_layout=N2048FoundationLayoutV1::lobe_layout();
+    let address=|i| {
+        let r=source_layout.lobe_by_neuron_index(i).unwrap();
+        width.lobe_layout().region(r.kind).unwrap().start + i-r.start
+    };
+    let base_interoception = source_layout.region(LobeKind::InteroceptiveMotivational).unwrap();
+    let wider_interoception = width.lobe_layout().region(LobeKind::InteroceptiveMotivational).unwrap();
+    assert_eq!((base_interoception.start,wider_interoception.start),(256,512));
+    let mut saw_shifted_real_interoceptive_input=false;
+    let old_assignments=original.sensor_encoder().assignments();
+    let wide_assignments=width.sensor_encoder().assignments();
+    assert_eq!(old_assignments.len(),wide_assignments.len());
+    for (before, after) in old_assignments.iter().zip(wide_assignments) {
+        assert_eq!(after.target_neuron(),address(before.target_neuron()));
+        assert_eq!(before.source_group(),after.source_group());
+        assert_eq!(before.source_index(),after.source_index());
+        assert_eq!(before.scale().to_bits(),after.scale().to_bits());
+        assert_eq!(before.bias().to_bits(),after.bias().to_bits());
+        if base_interoception.contains_neuron(before.target_neuron()) {
+            saw_shifted_real_interoceptive_input=true;
+            assert_ne!(before.target_neuron(),after.target_neuron(),
+                "old receiver would falsely reject or leave an input in the wrong lobe");
+        }
+    }
+    assert!(saw_shifted_real_interoceptive_input,"fixture must contain a real shifted input");
+    for (before, after) in original.synapses().iter().zip(width.synapses()) {
+        assert_eq!(after.source(),address(before.source()));
+        assert_eq!(after.target(),address(before.target()));
+        assert_eq!(before.genetic_weight().to_bits(),after.genetic_weight().to_bits());
+        assert_eq!(before.alpha().to_bits(),after.alpha().to_bits());
+        assert_eq!(before.receptor_index(),after.receptor_index());
+        assert_eq!(before.route_index(),after.route_index());
+        assert_eq!(before.kind(),after.kind());
+    }
+    assert_eq!(serde_json::to_vec(&original).unwrap(),raw);
+    assert_eq!(serde_json::from_slice::<BrainPhenotype>(&raw).unwrap(),original);
+    assert!(serde_json::to_vec(&width).is_err());
+}
+
+#[test]
+fn parked_marker_is_never_promoted_or_imported_and_legacy_class4_stays_exact() {
+    let (original,input)=compile(0x4096_2049);
+    let (_foreign, foreign_input)=compile(0x4096_2050);
+    assert!(BrainPhenotype::compile_parked_n4096_h_only(&original,&foreign_input).is_err());
+    let old=PhenotypeGrowthMigration::compile_n2048_to_n4096(&original,&input).unwrap();
+    assert!(!old.phenotype.is_parked_n4096_h_only());
+    assert_eq!(old.phenotype.candidate_decoder().decoder_synapse_count(),7168);
+    let legacy_wire=serde_json::to_vec(&old.phenotype).unwrap();
+    assert_eq!(serde_json::from_slice::<BrainPhenotype>(&legacy_wire).unwrap(),old.phenotype);
+    assert!(BrainCapacityClass::production_for_id(old.phenotype.brain_class_id()).is_err());
+    let mut json=serde_json::to_value(&old.phenotype).unwrap();
+    json["parked_n4096_source_hash"]=serde_json::json!([1,2,3,4]);
+    assert!(!serde_json::from_value::<BrainPhenotype>(json).unwrap().is_parked_n4096_h_only());
+}
