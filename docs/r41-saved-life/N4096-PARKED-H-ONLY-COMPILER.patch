+        if source.compiler_inputs_digest() != source_inputs.canonical_digest()
+            || source.lobe_layout() != &crate::N2048FoundationLayoutV1::lobe_layout()
+            || source.foundation_abi().migrated_n2048_foundation_v1().is_some()
+            || source.neuron_count != base.execution().max_neurons()
+        {
+            return Err(fail);
+        }
+        let layout = super::N4096ResearchLayoutV1::lobe_layout()?;
+        let map = |old| super::migration::remap_packed_neuron(old, source.lobe_layout(), &layout);
+        let dormant = NeuronDynamics::new(
+            0.0, 1.0, crate::ActivationFunction::Tanh, 1.0, 0.0, 0.0,
+        );
+        let mut widened = source.clone();
+        widened.parked_n4096_source_hash = Some(source.phenotype_hash);
+        widened.brain_class_id = target.id();
+        widened.neuron_count = target.execution().max_neurons();
+        widened.neuron_dynamics = vec![dormant; widened.neuron_count as usize];
+        for (i, d) in source.neuron_dynamics.iter().copied().enumerate() {
+            widened.neuron_dynamics[map(i as u32)? as usize] = d;
+        }
+        for (next, old) in widened.synapses.iter_mut().zip(&source.synapses) {
+            let mut row = CompiledSynapse::new(map(old.source())?, map(old.target())?,
+                old.genetic_weight(), old.alpha(), old.route_index(), old.kind());
+            row.set_receptor_index(old.receptor_index());
+            *next = row;
+        }
+        let assignments = source.sensor_encoder.assignments().iter().map(|old| {
+            let (min, max) = old.clamp_range();
+            Ok(SensorEncoderAssignment::new(old.source_group(), old.source_index(),
+                map(old.target_neuron())?, old.scale(), old.bias(), min, max))
+        }).collect::<Result<Vec<_>, ScaffoldContractError>>()?;
+        widened.sensor_encoder = SensorEncoderPlan::try_new(source.sensor_profile, assignments)?;
+        widened.decoder = CandidateDecoderPlan::try_new(
+            map(source.decoder.motor_start())?, source.decoder.motor_width(),
+            source.decoder.feature_count(), source.decoder.flattened_input_lane_count(),
+            source.decoder.memory_channel().copied(), source.decoder.families().to_vec(),
+        )?;
+        // Keep route rows and their ordering, decoder indexing, exact old
+        // replay capture identities and history semantics. Whole live learned
+        // topology/banks are transported separately from immutable genetic rows.
+        widened.lobe_layout = layout;
+        widened.budgets.capacity_class_id = target.id();
+        widened.budgets.execution_abi_digest = target.canonical_digest();
+        widened.budgets.global.neuron_count = widened.neuron_count;
+        widened.persistent_address_map = PersistentAddressMap::compile(
+            &widened.lobe_layout, &widened.projections, &widened.synapses,
+        )?;
+        (widened.route_abi_digest, widened.plasticity_abi_digest) = compute_abi_digests(
+            &target, &widened.foundation_abi_selection, &widened.projections, &widened.synapses,
+        );
+        widened.sensor_encoder.validate_n2048_growth(&widened, source, source_inputs)?;
+        widened.phenotype_hash = widened.recompute_phenotype_hash()?;
+        widened.validate_against(&target)?;
+        Ok(widened)
+    }
