+            || self.foundation_abi_selection.migrated_n2048_foundation_v1().is_some()
+            || !old.regions.iter().zip(&new.regions).all(|(a, b)| {
+                a.kind == b.kind && a.len.checked_mul(2) == Some(b.len)
+                    && a.start % 16 == 0 && b.start % 16 == 0
+            })
+        {
+            return Err(fail);
+        }
+        let is_h = |i: u32| {
+            new.lobe_by_neuron_index(i).is_some_and(|region| {
+                old.region(region.kind).is_some_and(|prior| i - region.start < prior.len)
+            })
+        };
+        if self.synapses.iter().any(|row| !(is_h(row.source()) && is_h(row.target())))
