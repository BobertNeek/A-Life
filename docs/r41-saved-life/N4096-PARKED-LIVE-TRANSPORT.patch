+//! Internal, non-runnable N4096 transport. This file owns no GPU, resident,
+//! format, or permit. The destination phenotype hash is only a validated
+//! shape parameter; callers must later obtain it from the sealed compiler.
+#![allow(dead_code)] // First isolated slice: no production or runtime caller.
+
+use alife_core::{
+    BrainCapacityClass, CompiledSynapseKind, DendriticBranchSet, PhenotypeHash, ScaffoldContractError,
+    N2048FoundationLayoutV1, N4096ResearchLayoutV1,
+};
+use crate::{
+    GpuBrainCheckpointSnapshot, GpuLiveTopologyCheckpointV1, GpuV11Checkpoint,
+};
+use crate::research_n4096_shape::address_bands;
+
+type Result<T> = std::result::Result<T, ScaffoldContractError>;
+const OLD: usize = N2048FoundationLayoutV1::NEURON_COUNT as usize;
+const WIDE: usize = N4096ResearchLayoutV1::NEURON_COUNT as usize;
+const META_WORDS: usize = 8;
+
+fn invalid() -> ScaffoldContractError {
+    ScaffoldContractError::InvalidSparseProjectionSchema
+}
+
+struct HqAddresses {
+    forward: Vec<Option<u32>>,
+    inverse: Vec<Option<u32>>,
+}
+
+impl HqAddresses {
+    fn new() -> Result<Self> {
+        let mut forward = vec![None; OLD];
+        let mut inverse = vec![None; WIDE];
+        for band in address_bands().map_err(|_| invalid())? {
+            for (old, new) in band.old.zip(band.inherited_h) {
+                if forward[old as usize].replace(new).is_some()
+                    || inverse[new as usize].replace(old).is_some()
+                {
+                    return Err(invalid());
+                }
+            }
+        }
+        let values: Vec<_> = forward.iter().flatten().collect();
+        if values.len() != OLD || values.windows(2).any(|p| p[0] >= p[1])
+            || inverse.iter().flatten().count() != OLD
+        {
+            return Err(invalid());
+        }
+        Ok(Self { forward, inverse })
+    }
+}
+
+fn address(map: &[Option<u32>], old: u32) -> Result<u32> {
+    map.get(old as usize).copied().flatten().ok_or_else(invalid)
+}
+
+fn transport_v11(
+    old: &GpuV11Checkpoint, map: &[Option<u32>], new_count: u32,
+) -> Result<GpuV11Checkpoint> {
+    if old.neuron_count as usize != map.len() || old.pending_lifetime_synapse.is_some() {
+        return Err(invalid());
+    }
+    let mut out = old.clone();
+    out.neuron_count = new_count;
+    let mut branches = out.dendritic_branches.branches().to_vec();
+    for branch in &mut branches {
+        branch.target = address(map, branch.target)?;
+        for tap in &mut branch.inputs {
+            tap.source = address(map, tap.source)?;
+        }
+    }
+    out.dendritic_branches = DendriticBranchSet::new(branches)?;
+    out.structural = old.structural
+        .remap_parked_research_addresses(new_count, map).map_err(|_| invalid())?;
+    for span in &mut out.sparse_spans {
+        span.target = address(map, span.target)?;
+        for edge in &mut span.edges {
+            edge.source = address(map, edge.source)?;
+            edge.target = address(map, edge.target)?;
+        }
+    }
+    // Work receipts are retained historical observations. They neither mint
+    // a replay capability nor claim that the wider layout performed the work.
+    Ok(out)
+}
+
+fn exact_v11(a: &GpuV11Checkpoint, b: &GpuV11Checkpoint) -> bool {
+    a == b && a.dendritic_branches.branches().iter().zip(b.dendritic_branches.branches())
+        .all(|(p, q)| p.threshold.to_bits() == q.threshold.to_bits()
+            && p.output_gain.to_bits() == q.output_gain.to_bits()
+            && p.inputs.iter().zip(&q.inputs).all(|(x, y)| x.weight.to_bits() == y.weight.to_bits()))
+        && a.sparse_spans.iter().zip(&b.sparse_spans)
+            .all(|(p, q)| p.edges.iter().zip(&q.edges)
+                .all(|(x, y)| x.weight.to_bits() == y.weight.to_bits()))
+}
+
+fn transport_topology(
+    old: &GpuLiveTopologyCheckpointV1, source_cap: &BrainCapacityClass,
+    target_cap: &BrainCapacityClass, map: &[Option<u32>], target_hash: PhenotypeHash,
+) -> Result<GpuLiveTopologyCheckpointV1> {
+    old.validate_for_capacity(source_cap)?;
+    let n = target_cap.execution().max_neurons();
+    if old.neuron_count as usize != map.len() || target_hash == PhenotypeHash([0; 4]) {
+        return Err(invalid());
+    }
+    let recurrent = old.recurrent_synapse_count as usize;
+    let decoder = old.decoder_synapse_count as usize;
+    let total = old.total_synapse_count as usize;
+    if total > target_cap.execution().max_total_synapses() as usize
+        || recurrent > target_cap.execution().max_recurrent_synapses() as usize
+        || old.synapse_learning_metadata_words.len() != total.checked_mul(META_WORDS).ok_or_else(invalid)?
+        || old.decoder_eligibility_metadata_words.len() != decoder.checked_mul(META_WORDS).ok_or_else(invalid)?
+    {
+        return Err(invalid());
+    }
+
+    let mut out = old.clone();
+    out.phenotype_hash = target_hash;
+    out.neuron_count = n;
+    // A stable monotone H map and empty Q reductions preserve byte order of
+    // real live CSR edges, including acquired edges and within-target order.
+    let mut counts = vec![0u32; n as usize];
+    for (i, (&wide, pair)) in map.iter().zip(old.target_offsets.windows(2)).enumerate() {
+        if let Some(wide) = wide {
+            let count = counts.get_mut(wide as usize).ok_or_else(invalid)?;
+            *count = pair[1] - pair[0];
+            for local in pair[0] as usize..pair[1] as usize {
+                let meta = &old.synapse_learning_metadata_words[local*META_WORDS..][..META_WORDS];
+                if meta[0] as usize != local || meta[1] != CompiledSynapseKind::RECURRENT_RAW
+                    || meta[2] != old.source_indices[local] || meta[3] as usize != i
+                    || meta[5] as usize != local || meta[6] != u32::MAX || meta[7] != 0
+                {
+                    return Err(invalid());
+                }
+            }
+        } else if pair[0] != pair[1] {
+            return Err(invalid());
+        }
+    }
+    let mut offsets = Vec::with_capacity(n as usize+1);
+    offsets.push(0u32);
+    for count in counts {
+        offsets.push(offsets.last().copied().unwrap_or(0).checked_add(count).ok_or_else(invalid)?);
+    }
+    if offsets.last().copied() != Some(old.recurrent_synapse_count) {
+        return Err(invalid());
+    }
+    out.target_offsets = offsets;
+    for source in &mut out.source_indices {
+        *source = address(map, *source)?;
+    }
+    for (i, words) in out.synapse_learning_metadata_words.chunks_exact_mut(META_WORDS).enumerate() {
+        if words[0] as usize != i || words[7] != 0 {
+            return Err(invalid());
+        }
+        words[2] = address(map, words[2])?;
+        words[3] = address(map, words[3])?;
+    }
+    // The checked production codec's motor_index in eligibility metadata
+    // is an absolute activation-neuron address, NOT its decoder-local ordinal.
+    // Other decoder globals/lane/order are unchanged, so all bank/replay
+    // physical row IDs remain stable. No sorting/rerouting to make this pass.
+    for (i, words) in out.decoder_eligibility_metadata_words.chunks_exact_mut(META_WORDS).enumerate() {
+        let id = recurrent.checked_add(i).ok_or_else(invalid)?;
+        let old_syn = &old.synapse_learning_metadata_words[id*META_WORDS..][..META_WORDS];
+        if words[0] as usize != id || words[4] != old_syn[2] || words[5] != old_syn[4]
+            || words[6] as usize != i || words[7] != 0
+            || old_syn[1] != CompiledSynapseKind::DECODER_RAW
+            || old_syn[5] as usize != i || old_syn[6] as usize != i
+        {
+            return Err(invalid());
+        }
+        words[4] = address(map, words[4])?;
+    }
+    out.v11_checkpoint = transport_v11(&old.v11_checkpoint, map, n)?;
+    out.canonical_digest = out.recompute_canonical_digest()?;
+    out.validate_for_capacity(target_cap)?;
+    Ok(out)
+}
+
+fn transport_activation(
+    old: &[u32], map: &[Option<u32>], new_count: usize, stride: usize,
+) -> Result<Vec<u32>> {
+    if !matches!(stride, 1 | 2) || old.len() != map.len().checked_mul(stride).ok_or_else(invalid)? {
+        return Err(invalid());
+    }
+    let mut result = vec![0u32; new_count.checked_mul(stride).ok_or_else(invalid)?];
+    for (i, values) in old.chunks_exact(stride).enumerate() {
+        if let Some(new) = map[i] {
+            let start = new as usize * stride;
+            result.get_mut(start..start+stride).ok_or_else(invalid)?.copy_from_slice(values);
+        } else if values.iter().any(|word| *word != 0) {
+            return Err(invalid()); // Reject negative zero in any Q lane.
+        }
+    }
+    Ok(result)
+}
+
+fn transport_snapshot(
+    old: &GpuBrainCheckpointSnapshot, old_topology: &GpuLiveTopologyCheckpointV1,
+    new_topology: &GpuLiveTopologyCheckpointV1, map: &[Option<u32>],
+) -> Result<GpuBrainCheckpointSnapshot> {
+    let mut parts = old.clone().into_parts();
+    if parts.phenotype_hash != old_topology.phenotype_hash
+        || parts.activation_a_bits.len() != old_topology.neuron_count as usize
+        || parts.lifetime_bank_0_bits.len() != old_topology.total_synapse_count as usize
+        || parts.recurrent_eligibility_bank_0_bits.len() != old_topology.recurrent_synapse_count as usize
+        || parts.decoder_eligibility_bank_0_bits.len() != old_topology.decoder_synapse_count as usize
+        || parts.pending_eligibility.is_some()
+        || parts.inactive_eligibility_generation != 0
+    {
+        return Err(invalid());
+    }
+    let n = new_topology.neuron_count as usize;
+    parts.activation_a_bits = transport_activation(&parts.activation_a_bits, map, n, 1)?;
+    parts.activation_b_bits = transport_activation(&parts.activation_b_bits, map, n, 1)?;
+    parts.neuron_homeostasis_bits = transport_activation(&parts.neuron_homeostasis_bits, map, n, 2)?;
+    parts.phenotype_hash = new_topology.phenotype_hash;
+    if let Some(ref mut key) = parts.last_learning_replay_key {
+        if key.organism_id != parts.organism_id || key.phenotype_hash != old_topology.phenotype_hash {
+            return Err(ScaffoldContractError::LearningEvidenceMismatch);
+        }
+        // Re-key the in-bank duplicate guard only; the same organism,
+        // sequence, ring, physical span IDs, cursor and journal generation
+        // remain unchanged. This never reissues a scheduler/durable permit.
+        key.phenotype_hash = new_topology.phenotype_hash;
+    }
+    GpuBrainCheckpointSnapshot::try_from_parts(parts)
+}
+
+// No Deserialize/public threshold or resident authority. A later backend
+// transaction may consume this only after its actual source/compiled plan
+// ownership check. This is an expected translation, not device readback.
+pub(crate) struct ParkedExpectedTransport {
+    topology: GpuLiveTopologyCheckpointV1,
+    native: GpuBrainCheckpointSnapshot,
+}
+
+impl ParkedExpectedTransport {
+    pub(crate) fn derive_exact(
+        old: &GpuLiveTopologyCheckpointV1, native: &GpuBrainCheckpointSnapshot,
+        compiled_target_shape: PhenotypeHash,
+    ) -> Result<Self> {
+        let map = HqAddresses::new()?;
+        let base = BrainCapacityClass::n2048();
+        let width = BrainCapacityClass::n4096_research();
+        if compiled_target_shape == old.phenotype_hash {
+            return Err(ScaffoldContractError::BrainOwnershipMismatch);
+        }
+        let topology = transport_topology(old, &base, &width, &map.forward, compiled_target_shape)?;
+        let wide_native = transport_snapshot(native, old, &topology, &map.forward)?;
+        let derived = Self { topology, native: wide_native };
+        derived.verify_projection_back(old, native, &map)?;
+        Ok(derived)
+    }
+
+    fn verify_projection_back(
+        &self, old: &GpuLiveTopologyCheckpointV1, native: &GpuBrainCheckpointSnapshot,
+        map: &HqAddresses,
+    ) -> Result<()> {
+        let base = BrainCapacityClass::n2048();
+        let width = BrainCapacityClass::n4096_research();
+        let back = transport_topology(&self.topology, &width, &base, &map.inverse, old.phenotype_hash)?;
+        let back_native = transport_snapshot(&self.native, &self.topology, &back, &map.inverse)?;
+        if &back != old || !exact_v11(&back.v11_checkpoint, &old.v11_checkpoint)
+            || &back_native != native || back_native.canonical_digest() != native.canonical_digest()
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+
+    // Expected topology recomputation alone is not readback. The device
+    // caller must use an independently mapped capture tied to its actual slot.
+    pub(crate) fn verify_actual_mapped(
+        &self, mapped_topology: &GpuLiveTopologyCheckpointV1,
+        mapped_native: &GpuBrainCheckpointSnapshot,
+    ) -> Result<()> {
+        if mapped_topology != &self.topology
+            || !exact_v11(&mapped_topology.v11_checkpoint, &self.topology.v11_checkpoint)
+            || mapped_native != &self.native
+            || mapped_native.canonical_digest() != self.native.canonical_digest()
+        {
+            return Err(invalid());
+        }
+        Ok(())
+    }
+}
