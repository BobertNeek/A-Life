+                sequence_id: ExperienceSequenceId(7),
+            }),
+            pending_eligibility: None,
+        }).unwrap();
+        (topology, native)
+    }
+
+    #[test]
+    fn parked_transport_preserves_csr_v11_and_complete_learned_bank_roundtrip() {
+        let (source, native) = fixture();
+        let id = PhenotypeHash([5,6,7,8]);
+        let expected = ParkedExpectedTransport::derive_exact(&source,&native,id).unwrap();
+        let map = HqAddresses::new().unwrap();
+        let h = address(&map.forward, 280).unwrap();
+        let h_target = address(&map.forward, 440).unwrap();
+        let h_decoder = address(&map.forward, 1800).unwrap();
+        let wide = &expected.topology;
+        assert_eq!(wide.target_offsets.len(), WIDE+1);
+        assert_eq!(&wide.target_offsets[h_target as usize..][..2], &[0,1]);
+        assert_eq!(wide.source_indices, [h]);
+        assert_eq!(wide.decoder_eligibility_metadata_words[4], h_decoder);
+        assert_eq!(wide.v11_checkpoint.dendritic_branches.branches()[0].target,h_target);
+        let frame=expected.native.clone().into_parts();
+        assert_eq!(frame.activation_a_bits[h as usize], (-0.125f32).to_bits());
+        assert_eq!(wide.v11_checkpoint.dendritic_branches.branches()[0].inputs[0].weight.to_bits(), (-0.0f32).to_bits());
+        assert!(map.inverse.iter().enumerate().filter(|(_, row)| row.is_none())
+            .all(|(i, _)| frame.activation_a_bits[i] | frame.activation_b_bits[i]
+                | frame.neuron_homeostasis_bits[i*2] | frame.neuron_homeostasis_bits[i*2+1] == 0));
+        assert_eq!(frame.last_learning_replay_key.unwrap().phenotype_hash,id);
+        assert_eq!(frame.lifetime_bank_1_bits,native.clone().into_parts().lifetime_bank_1_bits);
+        assert_eq!(frame.replay_samples,native.into_parts().replay_samples);
+    }
+
+    #[test]
+    fn parked_transport_rejects_q_alias_order_and_bad_ordered_readback() {
+        let (source, native) = fixture();
+        let id = PhenotypeHash([5,6,7,8]);
+        let expected = ParkedExpectedTransport::derive_exact(&source,&native,id).unwrap();
+        let map = HqAddresses::new().unwrap();
+        let q = map.inverse.iter().position(Option::is_none).unwrap();
+        let mut bad=expected.native.clone().into_parts();
+        // Authoritative snapshots already reject raw negative zero (including
+        // on H). Exercise the mapped raw check without unwrapping such a save.
+        bad.activation_b_bits[q]=(-0.0f32).to_bits();
+        assert!(transport_activation(&bad.activation_b_bits,&map.inverse,OLD,1).is_err());
+        assert!(GpuBrainCheckpointSnapshot::try_from_parts(bad.clone()).is_err());
+        // A nonzero Q word is a valid float, but not valid parked readback.
+        bad.activation_b_bits[q]=1.0f32.to_bits();
+        let bad=GpuBrainCheckpointSnapshot::try_from_parts(bad).unwrap();
+        assert!(expected.verify_actual_mapped(&expected.topology,&bad).is_err());
+        assert!(transport_snapshot(&bad,&expected.topology,&source,&map.inverse).is_err());
+        let mut foreign=source.clone();
+        foreign.decoder_eligibility_metadata_words[4]+=1;
+        foreign.canonical_digest=foreign.recompute_canonical_digest().unwrap();
+        assert!(ParkedExpectedTransport::derive_exact(&foreign,&native,id).is_err());
+        let mut aliased=map.forward.clone();
+        aliased[1]=aliased[0];
+        assert!(source.v11_checkpoint.structural
+            .remap_parked_research_addresses(WIDE as u32,&aliased).is_err());
+        let mut reordered=map.forward.clone();
+        reordered.swap(0,1);
+        assert!(source.v11_checkpoint.structural
+            .remap_parked_research_addresses(WIDE as u32,&reordered).is_err());
+        assert!(ParkedExpectedTransport::derive_exact(&source,&native,source.phenotype_hash).is_err());
+    }
