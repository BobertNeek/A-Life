+    /// Lossless order-preserving persistent-address transport for a detached
+    /// class-4 research layout. Missing addresses may represent unused wide
+    /// reserve lanes, but a candidate or live edge may never use one.
+    #[doc(hidden)]
+    #[cfg(feature = "research-n4096-parked-transport")]
+    pub fn remap_parked_research_addresses(
+        &self,
+        target_count: u32,
+        from_to: &[Option<u32>],
+    ) -> Result<Self, StructuralPlasticityError> {
+        self.validate_contract()?;
+        if from_to.len() != self.neuron_count as usize
+            || !matches!((self.neuron_count, target_count), (2048, 4096) | (4096, 2048))
+        {
+            return Err(StructuralPlasticityError::InvalidInputLength);
+        }
+        let used = from_to.iter().flatten().copied().collect::<Vec<_>>();
+        if used.len() != 2048
+            || used.iter().any(|&index| index >= target_count)
+            || used.windows(2).any(|pair| pair[0] >= pair[1])
+        {
+            return Err(StructuralPlasticityError::NodeOutOfRange);
+        }
+        let remap = |index: u32| {
+            from_to.get(index as usize).copied().flatten()
+                .ok_or(StructuralPlasticityError::NodeOutOfRange)
+        };
+        let mut mapped = self.clone();
+        mapped.neuron_count = target_count;
+        for candidate in mapped.candidates.values_mut().flatten() {
+            candidate.source = remap(candidate.source)?;
+            candidate.target = remap(candidate.target)?;
+        }
+        let mut connections = BTreeMap::new();
+        for (&old_target, edges) in &self.connections {
+            let target = remap(old_target)?;
+            let mut next_edges = edges.clone();
+            for edge in &mut next_edges {
+                edge.source = remap(edge.source)?;
+                edge.target = target;
+            }
+            if connections.insert(target, next_edges).is_some() {
+                return Err(StructuralPlasticityError::DuplicateConnection);
+            }
+        }
+        mapped.connections = connections;
+        mapped.validate_contract()?;
+        Ok(mapped)
+    }
+
