+//! CPU-only fail-closed parser tests. No Current, runtime, or ordinary witness.
+use std::{fs, os::unix::fs::PermissionsExt, path::PathBuf, time::{SystemTime, UNIX_EPOCH}};
+use serde_json::{json,Value};
+
+struct Scratch(PathBuf);
+impl Drop for Scratch {
+    fn drop(&mut self){let _=fs::remove_dir_all(&self.0);}
+}
+fn expect_parser_refusal(label:&str,wire:Value,expected:&str,synthetic_current:bool) {
+    let t=SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos();
+    let root=std::env::temp_dir().join(format!("n4096-parked-wire-{label}-{}-{t}",std::process::id()));
+    fs::create_dir(&root).unwrap();
+    let root=Scratch(root.canonicalize().unwrap());
+    fs::set_permissions(&root.0,fs::Permissions::from_mode(0o700)).unwrap();
+    let manifest=root.0.join("manifest.json");
+    let current=root.0.join("test-Current");
+    let invalid=b"synthetic non-checkpoint in an isolated parser test";
+    if synthetic_current {
+        fs::write(&current,invalid).unwrap();
+        fs::set_permissions(&current,fs::Permissions::from_mode(0o400)).unwrap();
+    }
+    let output=root.0.join("absent-output");
+    fs::write(&manifest,serde_json::to_vec(&wire).unwrap()).unwrap();
+    fs::set_permissions(&manifest,fs::Permissions::from_mode(0o400)).unwrap();
+    let result=alife_game_app::evaluate_saved_life_retention_experiment(
+        &root.0,&current,&output,&manifest,
+    ).unwrap_err().to_string();
+    assert!(result.contains(expected),"{result}");
+    assert!(!output.exists());
+    if synthetic_current {
+        assert_eq!(fs::read(&current).unwrap().as_slice(),invalid);
+    } else {
+        assert!(!current.exists());
+    }
+}
+fn fail_before_current(label:&str,wire:Value,expected:&str) {
+    expect_parser_refusal(label,wire,expected,false);
+}
+#[test]
+fn ordinary_schema1_refuses_parked_resident_scenario_before_checkpoint_decode() {
+    // The ordinary schema still admits/stat-checks its file paths before parsing.
+    // This intentionally invalid file makes a checkpoint decode distinguishable
+    // from the exact typed refusal being asserted.
+    let expected=if cfg!(feature="retained-n4096-parked-resident-zero") {
+        "parked N4096 resident requires its exact schema17 admission"
+    } else {
+        "unknown variant `n4096_parked_resident_zero`"
+    };
+    expect_parser_refusal("schema1-parked-scenario",json!({
+        "schema":1,"run_id":"schema1-parked-refusal","owner":1,
+        "source_current_sha256":"1".repeat(64),"scenario":"n4096_parked_resident_zero",
+        "intervention":{"kind":"control"},"evaluation_nonce":1,
+        "max_decisions":0,"max_world_ticks":0,"deadline_unix_seconds":1,
+        "max_output_bytes":1024,
+    }),expected,true);
+}
+#[cfg(not(feature="retained-n4096-parked-resident-zero"))]
+#[test]
+fn parked_schema17_is_off_before_checkpoint() {
+    fail_before_current("off",json!({"schema":17}),"parked resident experimental scope is disabled");
+}
+#[cfg(feature="retained-n4096-parked-resident-zero")]
+#[test]
+fn parked_schema17_refuses_ordinary_alias_and_injected_state_before_checkpoint() {
+    let digest="1".repeat(64);
+    let s="qualia.saved_life.n4096_parked_resident_zero.v1";
+    fail_before_current("ordinary-alias",json!({
+        "schema":17,"scope":"qualia.saved_life.n4096_ordinary_zero_proof.v1","admission_sha256":digest,
+    }),"parked N4096 unsupported schema");
+    for extra in ["max_decisions","activation_bits","force_rebind","same_elf_ordinary_proof"] {
+        let mut j=json!({"schema":17,"scope":s,"admission_sha256":digest});
+        j[extra]=json!(true);
+        fail_before_current(extra,j,"unknown field");
+    }
+}
