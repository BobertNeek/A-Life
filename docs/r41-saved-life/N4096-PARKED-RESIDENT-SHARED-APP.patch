+//! Separate schema17 witnessed native registry transport, 0/0 only.
+//! Expected words come from immutable prior proof and cannot supply a brain.
+
+use super::*;
+use super::n4096_auxiliary_intake::{self as shared,exact_sha,hash_file,private_path};
+use alife_core::{OrganismId, Tick};
+use alife_gpu_backend::GpuLiveTopologyCheckpointV1;
+use alife_training::CurrentTrainingCheckpointV1;
+use alife_world::{AssetManifest,GpuBrainSaveState};
+use serde::{Deserialize,Serialize};
+use std::io::Read;
+
+pub(super) const SCHEMA:u16=17;
+pub(super) const SCOPE:&str="qualia.saved_life.n4096_parked_resident_zero.v1";
+const ADMISSION:&str="n4096-parked-resident-admission.v1.json";
+const ORDINARY_ACCEPTED:&str="same-elf-independent-ordinary-accepted.v1.json";
+const ORDINARY_NATIVE:&str="same-elf-ordinary-native-0-0.json";
+const ORDINARY_PROCESS:&str="same-elf-ordinary-host-process.json";
+const ORDINARY_RELEASE:&str="same-elf-ordinary-fence-release.json";
+const PRIOR_CARRIER:&str="prior-independent-n4096-carrier-accepted.json";
+const PRIOR_CARRIER_NATIVE:&str="prior-n4096-carrier-native-0-0.json";
+const MAX_CONTROL:u64=32*1024;
+const MAX_NATIVE:u64=2*1024*1024;
+const MAX_ELF:u64=256*1024*1024;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {schema:u16,scope:String,admission_sha256:String}
+
+#[derive(Debug,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Admission {
+    schema:u16,scope:String,
+    pub(super) run_id:String,pub(super) owner:u64,pub(super) evaluation_nonce:u64,
+    pub(super) deadline_unix_seconds:u64,pub(super) source_current_sha256:String,
+    evaluator_sha256:String,source_world_json_sha256:String,source_sleep_journal_sha256:String,
+    source_live_topology_sha256:String,
+    ordinary_acceptance_sha256:String,prior_carrier_independent_acceptance_sha256:String,
+    maximum_admitted_device_peak_bytes:u64,
+}
+#[derive(Debug,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct AcceptedOrdinary {
+    schema:String, evaluator_sha256:String, source_current_sha256:String,
+    source_world_json_sha256:String,source_sleep_journal_sha256:String,
+    source_live_topology_sha256:String,owner:u64,world_tick:u64,
+    native_raw_sha256:String,native_process_sha256:String,fence_release_sha256:String,
+    source_regular_software_zero_finished_and_independently_accepted:bool,
+}
+#[derive(Debug,Serialize)]
+pub(super) struct Spec {
+    admission:Admission, ordinary:AcceptedOrdinary,
+    source_world:[u64;4], source_native:[u64;4],carrier_hq:[u64;4],
+    sampler_sha256:String, recorded_device_limits:[u64;4], source_counters:[u64;5],
+}
+
+fn private_bytes(root:&Path,name:&str,max:u64)->Result<Vec<u8>> {
+    let p=root.join(name);
+    private_path(&p,0o400,false)?;
+    let length=fs::symlink_metadata(&p)?.len();
+    if length==0||length>max { return Err("parked N4096 evidence length refused".into()); }
+    let mut raw=Vec::new();
+    fs::File::open(&p)?.take(max+1).read_to_end(&mut raw)?;
+    if raw.len() as u64!=length { return Err("parked N4096 evidence length changed".into()); }
+    Ok(raw)
+}
+fn val_bytes(root:&Path,name:&str,max:u64,want:&str)->Result<Vec<u8>> {
+    let raw=private_bytes(root,name,max)?;
+    if !exact_sha(want)||digest(&raw)!=want {
+        return Err("parked N4096 exact referenced evidence digest refused".into());
+    }
+    Ok(raw)
+}
+fn words<const N:usize>(value:&serde_json::Value)->Result<[u64;N]> {
+    let a=value.as_array().ok_or("parked N4096 expects typed uint words")?;
+    let mut w=[0;N];
+    if a.len()!=N {return Err("parked N4096 typed word extent differs".into())}
+    for (v,p) in a.iter().zip(w.iter_mut()) { *p=v.as_u64().ok_or("parked N4096 word is not u64")?; }
+    if w.iter().all(|x|*x==0){return Err("parked N4096 empty word proof".into())}
+    Ok(w)
+}
+
+pub(super) fn resolve(root:&Path,manifest:&Path,bytes:&[u8],at:u64)->Result<Spec>{
+    if bytes.len() as u64>MAX_CONTROL {return Err("parked N4096 envelope too large".into());}
+    let e:Envelope=serde_json::from_slice(bytes)?;
+    if e.schema!=SCHEMA||e.scope!=SCOPE||!exact_sha(&e.admission_sha256)
+        ||std::env::var_os("ALIFE_EXPLICIT_RETENTION_ARCHIVE_TEST").is_some()
+        ||std::env::var_os("ALIFE_EXPLICIT_FIXED_HOST_PRESSURE_NS").is_some()
+    {
+        return Err("parked N4096 unsupported schema, archive, or fixed pressure".into())
+    }
+    private_path(root,0o700,true)?;private_path(manifest,0o400,false)?;
+    if manifest==root.join(ADMISSION) {return Err("parked N4096 requires distinct manifest/admission".into())}
+    let a:Admission=serde_json::from_slice(&val_bytes(root,ADMISSION,MAX_CONTROL,&e.admission_sha256)?)?;
+    if a.schema!=1||a.scope!=SCOPE||a.owner==0||a.evaluation_nonce==0
+        ||a.run_id.is_empty()||a.run_id.len()>64
+        ||!a.run_id.bytes().all(|x|x.is_ascii_alphanumeric()||x==b'_'||x==b'-')
+        ||!(at<a.deadline_unix_seconds&&a.deadline_unix_seconds<=at.saturating_add(120))
+        ||a.maximum_admitted_device_peak_bytes==0
+        ||![&a.source_current_sha256,&a.evaluator_sha256,&a.source_world_json_sha256,
+             &a.source_sleep_journal_sha256,&a.source_live_topology_sha256,
+             &a.ordinary_acceptance_sha256,&a.prior_carrier_independent_acceptance_sha256]
+            .into_iter().all(|d|exact_sha(d))
+        ||hash_file(&std::env::current_exe()?,MAX_ELF)?!=a.evaluator_sha256
+    { return Err("parked N4096 unproven admitted cut or evaluator".into()); }
+    for name in ["n4096-auxiliary-admission.v1.json","n4096-ordinary-zero-admission.v1.json",
+        "wsp-crossed-out-of-reach-admission.v1.json","wsp-armed-admission.v1.json"] {
+        match fs::symlink_metadata(root.join(name)){
+            Err(e) if e.kind()==std::io::ErrorKind::NotFound=>(),
+            _=>return Err("parked N4096 cannot share another admitted arm".into()),
+        }
+    }
+
+    let ordinary:AcceptedOrdinary=serde_json::from_slice(&val_bytes(
+        root,ORDINARY_ACCEPTED,MAX_CONTROL,&a.ordinary_acceptance_sha256,
+    )?)?;
+    if ordinary.schema!="qualia.private.parked-n4096.same-elf-ordinary-independently-accepted.v1"
+        ||!ordinary.source_regular_software_zero_finished_and_independently_accepted
+        ||ordinary.evaluator_sha256!=a.evaluator_sha256||ordinary.source_current_sha256!=a.source_current_sha256
+        ||ordinary.source_world_json_sha256!=a.source_world_json_sha256
+        ||ordinary.source_sleep_journal_sha256!=a.source_sleep_journal_sha256
+        ||ordinary.source_live_topology_sha256!=a.source_live_topology_sha256
+        ||ordinary.owner!=a.owner||ordinary.world_tick==0
+    {return Err("parked N4096 requires verified same-new-ELF ordinary witness".into())}
+    let off:serde_json::Value=serde_json::from_slice(&val_bytes(root,ORDINARY_RELEASE,MAX_CONTROL,&ordinary.fence_release_sha256)?)?;
+    let host:serde_json::Value=serde_json::from_slice(&val_bytes(root,ORDINARY_PROCESS,MAX_CONTROL,&ordinary.native_process_sha256)?)?;
+    let child=host["child_pid"].as_u64().ok_or("missing ordinary native pid")?;
+    let supervising_process=host["process_parent_pid"].as_u64().ok_or("missing ordinary supervisor pid")?;
+    let source:serde_json::Value=serde_json::from_slice(&val_bytes(root,ORDINARY_NATIVE,MAX_NATIVE,&ordinary.native_raw_sha256)?)?;
+    let o=&source["n4096_ordinary_zero_proof"];
+    if child==0||supervising_process==0||child==supervising_process
+        ||host["evaluator_sha256"].as_str()!=Some(a.evaluator_sha256.as_str())
+        ||host["source_current_sha256"].as_str()!=Some(a.source_current_sha256.as_str())
+        ||host["native_receipt_sha256"].as_str()!=Some(ordinary.native_raw_sha256.as_str())
+        ||host["group_reaped"].as_bool()!=Some(true)||host["returncode"].as_i64()!=Some(0)
+        ||off["process_sha256"].as_str()!=Some(ordinary.native_process_sha256.as_str())
+        ||off["native_receipt_sha256"].as_str()!=Some(ordinary.native_raw_sha256.as_str())
+        ||off["clean_fence_release"].as_bool()!=Some(true)||off["child_group_reaped"].as_bool()!=Some(true)
+        ||off["child_inherited_native_ofd"].as_bool()!=Some(true)
+        ||source["status"].as_str()!=Some("n4096_ordinary_zero_proof_only")
+        ||source["captured_decisions"].as_u64()!=Some(0)||source["world_ticks"].as_u64()!=Some(0)
+        ||source["control_calls"].as_u64()!=Some(0)||source["software_simulation"].as_bool()!=Some(true)
+        ||source["neural_execution"].as_bool()!=Some(false)
+        ||o["scope"].as_str()!=Some(shared::ORDINARY_SCOPE)||o["owner"].as_u64()!=Some(ordinary.owner)
+        ||o["evaluator_sha256"].as_str()!=Some(a.evaluator_sha256.as_str())
+        ||o["source_current_sha256"].as_str()!=Some(a.source_current_sha256.as_str())
+        ||o["source_world_json_sha256"].as_str()!=Some(a.source_world_json_sha256.as_str())
+        ||o["source_sleep_journal_sha256"].as_str()!=Some(a.source_sleep_journal_sha256.as_str())
+        ||o["source_live_topology_sha256"].as_str()!=Some(a.source_live_topology_sha256.as_str())
+        ||o["world_tick_before_after"].as_u64()!=Some(ordinary.world_tick)
+        ||o["physical_class4_allocation_bytes"].as_u64()!=Some(0)
+        ||o["checkpoint_published"].as_bool()!=Some(false)||o["scored"].as_bool()!=Some(false)
+    {return Err("parked N4096 actual ordinary source/release is not genuine 0/0".into())}
+    let source_world=words(&o["restored_world_signature"])?;
+    let source_native=words(&o["restored_native_snapshot"])?;
+    if words::<4>(&o["native_restore_asset_digest"])?!=source_native {return Err("ordinary preload digest mismatch".into())}
+    let source_counters=words(&o["ordinary_dispatch_counters_before_after"])?;
+    let sampler_sha256=o["ordinary_sampler_sha256"].as_str().filter(|s|exact_sha(s))
+        .ok_or("parked N4096 missing exact ordinary sampler")?.to_string();
+    let carrier:serde_json::Value=serde_json::from_slice(&val_bytes(
+        root,PRIOR_CARRIER,MAX_CONTROL,&a.prior_carrier_independent_acceptance_sha256,
+    )?)?;
+    if carrier["scope"].as_str()!=Some(shared::SCOPE)
+        ||carrier["source_current_sha256"].as_str()!=Some(a.source_current_sha256.as_str())
+        ||carrier["source_world_sha256"].as_str()!=Some(a.source_world_json_sha256.as_str())
+        ||carrier["source_durable_sleep_journal_sha256"].as_str()!=Some(a.source_sleep_journal_sha256.as_str())
+        ||carrier["source_full_live_topology_sha256"].as_str()!=Some(a.source_live_topology_sha256.as_str())
+        ||carrier["same_ordinary_sampler_sha256"].as_str()!=Some(sampler_sha256.as_str())
+        ||words::<4>(&carrier["source_ordinary_restored_world_u64"])?!=source_world
+        ||words::<4>(&carrier["source_ordinary_native_snapshot_u64"])?!=source_native
+        ||words::<5>(&carrier["source_ordinary_dispatch_counters_u64"])?!=source_counters
+        ||carrier["actual_mapped_h_source_bit_identity_words"].as_u64()!=Some(8192)
+        ||carrier["actual_mapped_q_literal_positive_zero_words"].as_u64()!=Some(8192)
+        ||carrier["authentic_both_locks_released"].as_bool()!=Some(true)
+        ||carrier["width_resident_admitted"].as_bool()!=Some(false)
+        ||carrier["neural_execution"].as_bool()!=Some(false)
+    {return Err("parked N4096 prior physical carrier does not match authentic ordinary state".into())}
+    let carrier_hq=words(&carrier["actual_device_mapped_h_q_u64"])?;
+    let carrier_raw_sha=carrier["raw_pins"]["retention"].as_str().ok_or("missing accepted carrier raw pin")?;
+    let carrier_native:serde_json::Value=serde_json::from_slice(&val_bytes(
+        root,PRIOR_CARRIER_NATIVE,MAX_NATIVE,carrier_raw_sha,
+    )?)?;
+    let d=&carrier_native["n4096_auxiliary_zero_inspection"]["bounded_physical_device"];
+    let recorded_device_limits=words(&d["recorded_device_limits_digest"])?;
+    if carrier["exact_same_ordinary_hardware"].as_bool()!=Some(true)
+        || carrier_native["status"].as_str()!=Some("n4096_auxiliary_zero_inspection_only")
+        || words::<4>(&d["device_exact_h_q_readback_digest"])?!=carrier_hq
+        || recorded_device_limits!=words::<4>(&source["hardware"]["limits_digest"])?
+        || carrier_native["hardware"]!=source["hardware"]
+    { return Err("parked prior mapped device limits or provenance differ".into()); }
+    Ok(Spec{admission:a,ordinary,source_world,source_native,carrier_hq,
+        sampler_sha256,recorded_device_limits,source_counters})
+}
+
+impl Spec {
+    pub(super) fn admission(&self)->&Admission { &self.admission }
+    fn shared(&self)->shared::Admission{
+        let a=&self.admission;
+        shared::Admission::parked_source_contract(
+            a.run_id.clone(),a.owner,a.evaluation_nonce,a.deadline_unix_seconds,
+            a.source_current_sha256.clone(),a.evaluator_sha256.clone(),a.source_world_json_sha256.clone(),
+            a.source_sleep_journal_sha256.clone(),a.source_live_topology_sha256.clone(),
+            self.source_world,self.source_native,
+        )
+    }
+    pub(super) fn require_zero_request(&self,request:&SavedLifeRetentionRequest)->Result<()>{
+        self.shared().require_zero_request(request)
+    }
+    pub(super) fn require_portable_bytes(&self,current:&CurrentTrainingCheckpointV1)->Result<()>{
+        self.shared().require_portable_bytes(current)
+    }
+    pub(super) fn exact_saved_topology(&self,current:&CurrentTrainingCheckpointV1,
+        manifest:&AssetManifest,checkpoints:&[GpuBrainSaveState],owner:OrganismId,tick:Tick,
+    )->Result<GpuLiveTopologyCheckpointV1>{
+        self.shared().exact_saved_topology(current,manifest,checkpoints,owner,tick)
+    }
+    pub(super) fn witness(&self,runtime:GpuLiveBrainRuntime,current:&CurrentTrainingCheckpointV1,
+        owner:OrganismId,source:&Path,source_sha:&str,expected:&GpuLiveTopologyCheckpointV1,
+    )->Result<serde_json::Value>{
+        let a=&self.admission;
+        let sampling=runtime.foundation_training_sampling_state().ok_or("missing ordinary sampler")?;
+        if runtime.world().seed()!=current.seed||runtime.world().tick().raw()!=self.ordinary.world_tick
+            ||runtime.world().canonical_signature_digest()?.words!=self.source_world
+            ||source_sha!=a.source_current_sha256.as_str()||owner.raw()!=a.owner||now()?>=a.deadline_unix_seconds
+            ||Some(&sampling)!=current.saved_training_sampling()?.as_ref()
+            ||digest(&serde_json::to_vec(&sampling)?)!=self.sampler_sha256
+            ||runtime.live_foundation_compiler_inputs(owner)?!=&current.handoff.compiler_inputs
+        {return Err("parked N4096 restored World, compiler or sampler does not match real ordinary 0/0".into());}
+        let result=runtime.into_parked_n4096_zero_witness(
+            owner,self.source_world,self.source_native,self.source_counters,expected,
+            self.carrier_hq,self.recorded_device_limits,a.maximum_admitted_device_peak_bytes,
+        )?;
+        if now()?>=a.deadline_unix_seconds||hash_file(source,alife_training::MAX_CURRENT_CHECKPOINT_BYTES)?!=source_sha{
+            return Err("parked N4096 outlived or changed source".into())
+        }
+        Ok(serde_json::json!({
+            "scope":SCOPE,"ordinary_independent_acceptance_sha256":a.ordinary_acceptance_sha256,
+            "prior_carrier_independent_acceptance_sha256":a.prior_carrier_independent_acceptance_sha256,
+            "world_tick_before_after":self.ordinary.world_tick,"restored_world_signature":self.source_world,
+            "ordinary_sampler_sha256":self.sampler_sha256,"source_current_sha256":source_sha,
+            "evaluator_sha256":a.evaluator_sha256,"parked_native_registry":result,
+            "app_registry_has_exact_same_parked_owner":true,"inference_or_checkpoint_authority":false,
+            "paid_world_ticks":0,"paid_decisions":0,"scorecard_eligible":false,
+        }))
+    }
+}
