+    #[cfg(feature = "retained-n4096-auxiliary")]
+    pub(crate) fn verify_detached_n4096_restored_resident(
+        &mut self,
+        owner: OrganismId,
+        expected_neural: [u64; 4],
+        expected_v11: &alife_gpu_backend::GpuV11Checkpoint,
