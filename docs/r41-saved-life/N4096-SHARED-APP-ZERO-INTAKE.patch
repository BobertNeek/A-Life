@@ -0,0 +1,294 @@
+//! Strict, detached 0/0 intake for one physical AUXILIARY class-4 carrier.
+//! No scenario, policy edit, World tick, wider resident, or scoring path.
+
+use super::*;
+use alife_core::{BrainCapacityClass, OrganismId, SleepPhase, Tick};
+use alife_gpu_backend::{GpuLiveTopologyCheckpointV1, GpuV11Checkpoint};
+use alife_training::CurrentTrainingCheckpointV1;
+use alife_world::{AssetManifest, GpuBrainSaveState};
+use serde::{Deserialize, Serialize};
+use std::io::Read;
+
+pub(super) const SCHEMA: u16 = 12;
+pub(super) const SCOPE: &str = "qualia.saved_life.n4096_auxiliary_zero.v1";
+pub(super) const OUTPUT_BYTES: u64 = 256 * 1024 * 1024;
+const LEAF: &str = "n4096-auxiliary-admission.v1.json";
+const MAX_CONTROL: u64 = 16 * 1024;
+const MAX_ELF: u64 = 256 * 1024 * 1024;
+const MAX_TOPOLOGY: usize = 16 * 1024 * 1024;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    schema: u16,
+    scope: String,
+    admission_sha256: String,
+}
+
+#[derive(Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Admission {
+    schema: u16,
+    scope: String,
+    pub(super) run_id: String,
+    pub(super) owner: u64,
+    pub(super) evaluation_nonce: u64,
+    pub(super) deadline_unix_seconds: u64,
+    pub(super) source_current_sha256: String,
+    evaluator_sha256: String,
+    source_world_json_sha256: String,
+    source_sleep_journal_sha256: String,
+    source_live_topology_sha256: String,
+    expected_restored_world_signature: [u64; 4],
+    expected_restored_native_snapshot: [u64; 4],
+}
+
+fn exact_sha(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|c| matches!(c, b'0'..=b'9' | b'a'..=b'f'))
+}
+
+fn envelope(bytes: &[u8]) -> Result<Envelope> {
+    if bytes.len() as u64 > MAX_CONTROL {
+        return Err("N4096 auxiliary manifest exceeds bounded input".into());
+    }
+    let envelope: Envelope = serde_json::from_slice(bytes)?;
+    if envelope.schema != SCHEMA || envelope.scope != SCOPE || !exact_sha(&envelope.admission_sha256) {
+        return Err("unexpected N4096 auxiliary zero envelope".into());
+    }
+    Ok(envelope)
+}
+
+fn parse_admission(bytes: &[u8], expected_sha: &str, now: u64) -> Result<Admission> {
+    if bytes.len() as u64 > MAX_CONTROL || digest(bytes) != expected_sha {
+        return Err("N4096 auxiliary exact admission digest mismatch".into());
+    }
+    let a: Admission = serde_json::from_slice(bytes)?;
+    if a.schema != 1 || a.scope != SCOPE || a.owner == 0 || a.evaluation_nonce == 0
+        || a.run_id.is_empty() || a.run_id.len() > 64
+        || !a.run_id.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'_' | b'-'))
+        || a.deadline_unix_seconds <= now || a.deadline_unix_seconds > now.saturating_add(120)
+        || a.expected_restored_world_signature == [0; 4]
+        || a.expected_restored_native_snapshot == [0; 4]
+        || ![&a.source_current_sha256, &a.evaluator_sha256, &a.source_world_json_sha256,
+             &a.source_sleep_journal_sha256, &a.source_live_topology_sha256].into_iter().all(|v| exact_sha(v))
+    {
+        return Err("N4096 auxiliary admission identity, digest, or deadline refused".into());
+    }
+    Ok(a)
+}
+
+#[cfg(target_os = "linux")]
+fn private_path(path: &Path, mode: u32, dir: bool) -> Result<()> {
+    use std::os::unix::fs::MetadataExt;
+    let m = fs::symlink_metadata(path)?;
+    // A Linux detached owner-only admission, never ordinary user gameplay.
+    if path.canonicalize()? != path || m.mode() & 0o7777 != mode
+        || m.uid() != fs::metadata("/proc/self")?.uid()
+        || (if dir { !m.is_dir() } else { !m.is_file() })
+    {
+        return Err("N4096 auxiliary requires canonical owner-only admission files".into());
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn private_path(_: &Path, _: u32, _: bool) -> Result<()> {
+    Err("N4096 auxiliary inspection is admitted only on the pinned Linux test runtime".into())
+}
+
+fn hash_file(path: &Path, ceiling: u64) -> Result<String> {
+    let m = fs::symlink_metadata(path)?;
+    if !m.is_file() || m.len() == 0 || m.len() > ceiling {
+        return Err("N4096 auxiliary requires a bounded regular pinned file".into());
+    }
+    let mut source = fs::File::open(path)?.take(ceiling + 1);
+    let mut hasher = Sha256::new();
+    let mut bytes = 0u64;
+    let mut chunk = [0u8; 65536];
+    loop {
+        let n = source.read(&mut chunk)?;
+        if n == 0 {
+            break;
+        }
+        bytes += n as u64;
+        hasher.update(&chunk[..n]);
+    }
+    if bytes != m.len() {
+        return Err("N4096 auxiliary file length changed while hashing".into());
+    }
+    Ok(format!("{:x}", hasher.finalize()))
+}
+
+pub(super) fn resolve(root: &Path, bytes: &[u8], now: u64) -> Result<Admission> {
+    let e = envelope(bytes)?;
+    private_path(root, 0o700, true)?;
+    let path = root.join(LEAF);
+    private_path(&path, 0o400, false)?;
+    let mut raw = Vec::new();
+    fs::File::open(&path)?.take(MAX_CONTROL + 1).read_to_end(&mut raw)?;
+    let a = parse_admission(&raw, &e.admission_sha256, now)?;
+    if hash_file(&std::env::current_exe()?, MAX_ELF)? != a.evaluator_sha256 {
+        return Err("N4096 auxiliary evaluator executable mismatch".into());
+    }
+    Ok(a)
+}
+
+pub(super) fn validate_private_source(root: &Path, source: &Path) -> Result<()> {
+    if !source.starts_with(root) {
+        return Err("N4096 auxiliary Current must be local to its admission".into());
+    }
+    private_path(source, 0o400, false)
+}
+
+impl Admission {
+    pub(super) fn require_zero_request(&self, r: &SavedLifeRetentionRequest) -> Result<()> {
+        if r.schema != 3 || r.max_decisions != 0 || r.max_world_ticks != 0
+            || r.cue_free_food_placement || r.navigation_task.is_some() || r.direct_weights.is_some()
+            || r.evaluation_nonce != self.evaluation_nonce || r.deadline_unix_seconds != self.deadline_unix_seconds
+            || r.finalization_deadline_unix_seconds.is_some() || r.max_output_bytes != OUTPUT_BYTES
+            || std::env::var("ALIFE_EXPLICIT_SOFTWARE_RETENTION_TEST").ok().as_deref() != Some("1")
+            || std::env::var("ALIFE_EXPLICIT_RETENTION_ARCHIVE_TEST").ok().as_deref() == Some("1")
+            || std::env::var("ALIFE_EXPLICIT_FIXED_HOST_PRESSURE_NS").ok().is_some()
+        {
+            return Err("N4096 auxiliary requires an unmodified explicit software 0/0 inspection".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn require_portable_bytes(&self, current: &CurrentTrainingCheckpointV1) -> Result<()> {
+        let life = current.life.as_ref().ok_or("N4096 auxiliary requires full saved life")?;
+        if digest(life.world_json.as_bytes()) != self.source_world_json_sha256
+            || digest(life.sleep_journal_json.as_bytes()) != self.source_sleep_journal_sha256
+        {
+            return Err("N4096 auxiliary exact World/journal source hashes differ".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn exact_saved_v11(
+        &self,
+        current: &CurrentTrainingCheckpointV1,
+        manifest: &AssetManifest,
+        checkpoints: &[GpuBrainSaveState],
+        owner: OrganismId,
+        world_tick: Tick,
+    ) -> Result<GpuV11Checkpoint> {
+        let [g] = checkpoints else { return Err("N4096 auxiliary requires one exact saved brain".into()); };
+        if g.organism_id != owner || owner.raw() != self.owner || g.checkpoint_tick != world_tick
+            || g.capacity_class_id != BrainCapacityClass::n2048().id()
+            || g.sleep.phase != SleepPhase::Awake || g.pending_eligibility.is_some()
+            || g.pending_experience_transaction.is_some() || g.learning_transaction_generation == 0
+        {
+            return Err("N4096 auxiliary source resident/cut is not an exact awake ordinary N2048".into());
+        }
+        let reference = g.live_structural_topology.as_ref().ok_or("missing exact saved live topology")?;
+        let mut matches = manifest.entries.iter().filter(|leaf| leaf.asset_id == reference.asset_id);
+        let saved = matches.next().ok_or("missing exact live topology manifest reference")?;
+        if matches.next().is_some() || saved.digest != reference.digest
+            || saved.size_bytes.is_none_or(|n| n == 0 || n > MAX_TOPOLOGY as u64)
+        {
+            return Err("N4096 auxiliary live topology identity/size refused".into());
+        }
+        let life = current.life.as_ref().ok_or("N4096 auxiliary requires full saved life")?;
+        let wire = life.asset_bytes(&saved.relative_path)?;
+        if saved.size_bytes != Some(wire.len() as u64) || digest(&wire) != self.source_live_topology_sha256 {
+            return Err("N4096 auxiliary exact live topology bytes differ".into());
+        }
+        let topology: GpuLiveTopologyCheckpointV1 = serde_json::from_slice(&wire)?;
+        topology.validate_for_capacity(&BrainCapacityClass::n2048())?;
+        if topology.phenotype_hash != g.phenotype_hash || topology.neuron_count != 2048 {
+            return Err("N4096 auxiliary live topology phenotype binding differs".into());
+        }
+        Ok(topology.v11_checkpoint)
+    }
+
+    pub(super) fn inspect_exact_zero(
+        &self,
+        runtime: &mut GpuLiveBrainRuntime,
+        current: &CurrentTrainingCheckpointV1,
+        owner: OrganismId,
+        source: &Path,
+        source_sha: &str,
+        expected_v11: &GpuV11Checkpoint,
+    ) -> Result<serde_json::Value> {
+        let world = runtime.world();
+        let before = world.canonical_signature_digest()?;
+        let tick = world.tick();
+        let sampling = runtime.foundation_training_sampling_state();
+        if before.words != self.expected_restored_world_signature || world.seed() != current.seed
+            || source_sha != self.source_current_sha256.as_str()
+            || sampling.is_none() || sampling != current.saved_training_sampling()?
+            || now()? >= self.deadline_unix_seconds
+        {
+            return Err("N4096 auxiliary actual restored World/Current/sampling differs before device copy".into());
+        }
+        let device = runtime.verify_detached_n4096_restored_resident(
+            owner, self.expected_restored_native_snapshot, expected_v11,
+        )?;
+        if runtime.world().tick() != tick || runtime.world().canonical_signature_digest()? != before
+            || runtime.foundation_training_sampling_state() != sampling
+            || runtime.live_foundation_compiler_inputs(owner)? != &current.handoff.compiler_inputs
+            || now()? >= self.deadline_unix_seconds
+            || hash_file(source, alife_training::MAX_CURRENT_CHECKPOINT_BYTES)? != source_sha
+            || device.checkpoint_tick_asserted_by_caller != tick.raw()
+        {
+            return Err("N4096 auxiliary changed or outlived exact ordinary restored cut".into());
+        }
+        Ok(serde_json::json!({
+            "kind": "detached_class4_0_0_device_carrier_inspection",
+            "actual_restored_world_signature_before_after": before,
+            "actual_world_tick_before_after": tick.raw(),
+            "ordinary_sampler_unchanged": true,
+            "source_current_sha256": source_sha,
+            "source_world_json_sha256": self.source_world_json_sha256,
+            "source_sleep_journal_sha256": self.source_sleep_journal_sha256,
+            "source_live_topology_sha256": self.source_live_topology_sha256,
+            "evaluator_sha256": self.evaluator_sha256,
+            "paid_world_ticks": 0, "paid_decisions": 0,
+            "checkpoint_published": false, "scored": false, "native_wider_resident": false,
+            "bounded_physical_device": device,
+        }))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn exact_envelope() -> serde_json::Value {
+        serde_json::json!({"schema":12,"scope":SCOPE,"admission_sha256":"a".repeat(64)})
+    }
+    fn exact_admission() -> serde_json::Value {
+        serde_json::json!({"schema":1,"scope":SCOPE,"run_id":"shape-only","owner":1,"evaluation_nonce":3,
+            "deadline_unix_seconds":110,"source_current_sha256":"a".repeat(64),"evaluator_sha256":"b".repeat(64),
+            "source_world_json_sha256":"c".repeat(64),"source_sleep_journal_sha256":"d".repeat(64),
+            "source_live_topology_sha256":"e".repeat(64),"expected_restored_world_signature":[1,2,3,4],
+            "expected_restored_native_snapshot":[5,6,7,8]})
+    }
+
+    #[test]
+    fn n4096_aux_wire_has_no_world_clock_or_behavior_knobs() {
+        let m = exact_envelope();
+        assert!(envelope(&serde_json::to_vec(&m).unwrap()).is_ok());
+        for forbidden in ["source_tick", "max_world_ticks", "direct_weights", "fixture_id", "pending_state"] {
+            let mut refused = m.clone();
+            refused[forbidden] = serde_json::json!(1);
+            assert!(envelope(&serde_json::to_vec(&refused).unwrap()).is_err());
+        }
+    }
+
+    #[test]
+    fn n4096_aux_admission_requires_exact_private_hash_and_live_world_neural_pins() {
+        let a = exact_admission();
+        let b = serde_json::to_vec(&a).unwrap();
+        assert!(parse_admission(&b, &digest(&b), 100).is_ok());
+        assert!(parse_admission(&b, &"f".repeat(64), 100).is_err());
+        assert!(parse_admission(&b, &digest(&b), 110).is_err());
+        for key in ["expected_restored_world_signature", "expected_restored_native_snapshot"] {
+            let mut rejected = a.clone();
+            rejected[key] = serde_json::json!([0,0,0,0]);
+            let bytes = serde_json::to_vec(&rejected).unwrap();
+            assert!(parse_admission(&bytes, &digest(&bytes), 100).is_err());
+        }
+    }
+}
