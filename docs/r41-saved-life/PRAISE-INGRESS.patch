@@ -0,0 +1,246 @@
+//! Exposed, unscored current-action Praise diagnostic. Scheduling and receipt
+//! observation only: no reward scalar, forced decision, replay, or UI click.
+use alife_core::{Tick, Validate, Vec3f};
+use alife_world::{PlayerCareKind, PlayerCareKindSet, PlayerCareReceipt};
+use serde::{Deserialize, Serialize};
+
+pub(super) const SCHEMA: u16 = 18;
+pub(super) const CUTS: u64 = 4;
+pub(super) const MAX_BYTES: usize = 16 * 1024;
+pub(super) const MIN_OUTPUT: u64 = 128 * 1024 * 1024;
+pub(super) const MAX_OUTPUT: u64 = 256 * 1024 * 1024;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Arm {
+    Quiet,
+    Praise,
+    DelayedYoked,
+}
+
+impl Arm {
+    fn offset(self) -> Option<u64> {
+        match self {
+            Self::Quiet => None,
+            Self::Praise => Some(0),
+            Self::DelayedYoked => Some(2),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Spec {
+    pub(super) arm: Arm,
+    pub(super) expected_start_world_tick: u64,
+    pub(super) hand_world_position: [f32; 3],
+}
+
+impl Spec {
+    pub(super) fn validate(self) -> Result<(), &'static str> {
+        if self.expected_start_world_tick.checked_add(CUTS).is_none()
+            || self.hand_world_position.iter().any(|n| !n.is_finite())
+            || self.position().validate().is_err()
+        {
+            return Err("praise calibration invalid restored tick or Hand origin");
+        }
+        Ok(())
+    }
+
+    pub(super) fn position(self) -> Vec3f {
+        let [x, y, z] = self.hand_world_position;
+        Vec3f::new(x, y, z)
+    }
+
+    pub(super) fn bind(
+        self, world_tick: u64, pending_care_empty: bool,
+    ) -> Result<Probe, &'static str> {
+        self.validate()?;
+        if self.expected_start_world_tick != world_tick || !pending_care_empty {
+            return Err("praise calibration requires exact restored tick with no pending player care");
+        }
+        Ok(Probe {
+            scheduled: self.arm.offset().map(|offset| world_tick + offset),
+            origin: world_tick,
+            queued: None,
+            observed: None,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Copy, Serialize)]
+pub(super) struct ObservedPlayerDose {
+    pub(super) consume_world_tick: Tick,
+    pub(super) actual_world_receipt: PlayerCareReceipt,
+    /// An ordinary sealed decision row co-occurs. Such a row can describe
+    /// a failed or zero-cost action. False includes passive consumption.
+    pub(super) same_boundary_has_sealed_decision_row: bool,
+}
+
+pub(super) struct Probe {
+    origin: u64,
+    scheduled: Option<u64>,
+    queued: Option<u64>,
+    observed: Option<ObservedPlayerDose>,
+}
+
+impl Probe {
+    pub(super) fn should_queue(&self, before: u64) -> Result<bool, &'static str> {
+        let offset = before.checked_sub(self.origin).ok_or("praise calibration clock regressed")?;
+        if offset >= CUTS {
+            return Err("praise calibration exceeded its cut bound");
+        }
+        if self.queued.is_none() && self.scheduled.is_some_and(|t| before > t) {
+            return Err("praise calibration passed an unserved scheduled boundary");
+        }
+        Ok(self.queued.is_none() && self.scheduled == Some(before))
+    }
+
+    pub(super) fn accepted_queue(&mut self, before: u64) -> Result<(), &'static str> {
+        if !self.should_queue(before)? {
+            return Err("praise calibration queue is not a one-shot at its admitted boundary");
+        }
+        self.queued = Some(before);
+        Ok(())
+    }
+
+    pub(super) fn observe(
+        &mut self, before: Tick, after: Tick, latest: Option<PlayerCareReceipt>, sealed_decision_row: bool,
+    ) -> Result<Option<ObservedPlayerDose>, &'static str> {
+        let wanted = self.queued == Some(before.raw()) && self.observed.is_none();
+        if after == before {
+            if sealed_decision_row || latest.is_some_and(|r| r.applied_tick.raw() > before.raw()) {
+                return Err("praise calibration saw a dose/row without a World cut");
+            }
+            // Polling can repeat a world tick; never redeliver.
+            return Ok(None);
+        }
+        if before.raw().checked_add(1) != Some(after.raw()) {
+            return Err("praise calibration saw a noncanonical World cut");
+        }
+        let fresh = latest.filter(|r| r.applied_tick.raw() > before.raw());
+        match (wanted, fresh) {
+            (false, None) => Ok(None), // old historical receipt is not a new dose
+            (true, Some(r)) if r.applied_tick == after
+                && r.kinds == PlayerCareKindSet::single(PlayerCareKind::Praise) =>
+            {
+                let dose = ObservedPlayerDose {
+                    consume_world_tick: after,
+                    actual_world_receipt: r,
+                    same_boundary_has_sealed_decision_row: sealed_decision_row,
+                };
+                self.observed = Some(dose);
+                Ok(Some(dose))
+            }
+            _ => Err("praise calibration missing or unexpected authoritative player dose"),
+        }
+    }
+
+    pub(super) fn summary(&self, spec: Spec) -> serde_json::Value {
+        serde_json::json!({
+            "scope": "retained-player-praise-calibration-v1",
+            "arm": spec.arm,
+            "restored_world_tick": self.origin,
+            "scheduled_queue_world_tick": self.scheduled,
+            "queued_world_tick": self.queued,
+            "observed_player_dose": self.observed,
+            "scheduled_delivery_completed": if self.scheduled.is_some() {
+                Some(self.observed.is_some())
+            } else { None },
+            "displayed_action_observed": false,
+            "ui_click_observed": false,
+            "retrospective_tag_present": false,
+            "physical_payment_verified": false,
+            "credited_route_verified": false,
+            "reserve_verified": false,
+            "learning_effect_verified": false,
+            "scorecard_eligible": false
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn make(arm: Arm) -> Spec {
+        Spec { arm, expected_start_world_tick: 100, hand_world_position: [0.0; 3] }
+    }
+
+    fn tick(n: u64) -> Tick { Tick::new(n) }
+
+    // Pure reducer fixture, not a claim that World delivered anything.
+    fn care(n: u64, kind: PlayerCareKind) -> PlayerCareReceipt {
+        PlayerCareReceipt {
+            kinds: PlayerCareKindSet::single(kind), applied_tick: tick(n),
+            praise_signal_before: 0.0, praise_signal_after: 0.25,
+            loneliness_before: 0.0, loneliness_after: 0.0,
+        }
+    }
+
+    #[test]
+    fn exact_scope_offsets_and_poll_do_not_duplicate_a_queued_event() {
+        let mut quiet = make(Arm::Quiet).bind(100, true).unwrap();
+        for n in 100..104 { assert!(!quiet.should_queue(n).unwrap()); }
+        assert!(quiet.should_queue(104).is_err());
+        assert!(quiet.observe(tick(100), tick(101), Some(care(99, PlayerCareKind::Praise)), true).unwrap().is_none());
+        let mut immediate = make(Arm::Praise).bind(100, true).unwrap();
+        assert!(immediate.should_queue(100).unwrap());
+        immediate.accepted_queue(100).unwrap();
+        assert!(!immediate.should_queue(100).unwrap());
+        assert!(immediate.accepted_queue(100).is_err());
+        assert!(immediate.observe(tick(100), tick(100), None, false).unwrap().is_none());
+        let row = immediate.observe(tick(100), tick(101), Some(care(101, PlayerCareKind::Praise)), true).unwrap().unwrap();
+        assert!(row.same_boundary_has_sealed_decision_row);
+        assert!(!immediate.should_queue(101).unwrap());
+        assert!(immediate.observe(tick(101), tick(102), Some(care(101, PlayerCareKind::Praise)), true).unwrap().is_none());
+        let mut delayed = make(Arm::DelayedYoked).bind(100, true).unwrap();
+        assert!(!delayed.should_queue(100).unwrap());
+        assert!(!delayed.should_queue(101).unwrap());
+        assert!(delayed.should_queue(102).unwrap());
+        assert!(delayed.should_queue(103).is_err());
+        delayed.accepted_queue(102).unwrap();
+        assert!(!delayed.should_queue(102).unwrap());
+    }
+
+    #[test]
+    fn failed_or_zero_cost_sealed_decision_is_not_physical_payment_evidence() {
+        // Both synthetic rows may exist on a settled World boundary. The
+        // ingress observer receives only row presence, not a cost verdict.
+        for (action_succeeded, physical_cost) in [(false, 0.25_f32), (true, 0.0_f32)] {
+            assert!(!action_succeeded || physical_cost == 0.0);
+            let spec = make(Arm::Praise);
+            let mut probe = spec.bind(100, true).unwrap();
+            probe.accepted_queue(100).unwrap();
+            let dose = probe.observe(tick(100), tick(101), Some(care(101, PlayerCareKind::Praise)), true)
+                .unwrap().unwrap();
+            let wire = serde_json::to_value(dose).unwrap();
+            assert_eq!(wire["same_boundary_has_sealed_decision_row"], true);
+            assert!(wire.get("same_boundary_has_paid_row").is_none());
+            assert_eq!(probe.summary(spec)["physical_payment_verified"], false);
+            assert_eq!(probe.summary(spec)["credited_route_verified"], false);
+        }
+    }
+
+    #[test]
+    fn passive_consumption_has_no_sealed_decision_and_unexpected_doses_are_refused() {
+        let s = make(Arm::DelayedYoked);
+        let mut probe = s.bind(100, true).unwrap();
+        probe.accepted_queue(102).unwrap();
+        let row = probe.observe(tick(102), tick(103), Some(care(103, PlayerCareKind::Praise)), false).unwrap().unwrap();
+        assert!(!row.same_boundary_has_sealed_decision_row);
+        assert_eq!(probe.summary(s)["credited_route_verified"], false);
+        assert_eq!(probe.summary(s)["retrospective_tag_present"], false);
+        assert!(probe.observe(tick(103), tick(104), Some(care(104, PlayerCareKind::Praise)), true).is_err());
+        let mut miss = make(Arm::Praise).bind(100, true).unwrap();
+        miss.accepted_queue(100).unwrap();
+        assert!(miss.observe(tick(100), tick(101), None, true).is_err());
+        assert!(miss.observe(tick(100), tick(101), Some(care(101, PlayerCareKind::Pet)), true).is_err());
+        assert!(miss.observe(tick(100), tick(100), Some(care(101, PlayerCareKind::Praise)), false).is_err());
+        assert!(miss.observe(tick(100), tick(102), None, false).is_err());
+        assert!(make(Arm::Praise).bind(99, true).is_err());
+        assert!(make(Arm::Praise).bind(100, false).is_err());
+        let bad = Spec { expected_start_world_tick: u64::MAX, ..make(Arm::Quiet) };
+        assert!(bad.validate().is_err());
+    }
+}
