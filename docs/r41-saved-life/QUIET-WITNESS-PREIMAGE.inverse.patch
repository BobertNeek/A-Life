-#[test]
-fn held_witness_refuses_deterministic_replacement_before_raw_bytes() {
-    use std::os::unix::fs::DirBuilderExt;
-    use std::time::{SystemTime, UNIX_EPOCH};
-    let parent = std::env::temp_dir().join(format!("qualia-quiet-inert-{}-{}",
-        std::process::id(), SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos()));
-    fs::DirBuilder::new().mode(0o700).create(&parent).unwrap();
-    let parent = parent.canonicalize().unwrap();
-    let output = parent.join("original");
-    let moved = parent.join("retired");
-    fs::DirBuilder::new().mode(0o700).create(&output).unwrap();
-    let original = fs::symlink_metadata(&output).unwrap();
-    let held = OpenOptions::new().read(true).custom_flags(0x30000).open(&output).unwrap();
-    let budget = alife_storage::OutputBudget::register(&output, 4096).unwrap();
-    check_directory(&output, &held, &original).unwrap();
-    fs::rename(&output, &moved).unwrap();
-    fs::DirBuilder::new().mode(0o700).create(&output).unwrap();
-    let original_leaf_fd = create_in_held_output(&held).unwrap();
-    let first = original_leaf_fd.metadata().unwrap();
-    assert!(check_witness_binding(
