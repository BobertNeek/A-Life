-#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
-fn check_witness_binding(
-    output: &Path, logical: &Path, held: &File, directory: &fs::Metadata,
-    file: &File, first: &fs::Metadata, len: u64,
-) -> Result<()> {
-    check_directory(output, held, directory)?;
-    if logical != output.join(NAME) || !alife_storage::budget_for(logical)?
-            .is_some_and(|b| b.root() == output)
-    {
-        return Err("quiet witness lost its exact logical output accounting".into());
-    }
-    let opened = file.metadata()?;
-    let named = fs::symlink_metadata(logical)?;
-    if !opened.is_file() || opened.mode() & 0o7777 != 0o400 || opened.nlink() != 1
-        || opened.dev() != directory.dev() || opened.uid() != directory.uid()
-        || inode_key(first) != inode_key(&opened) || inode_key(&opened) != inode_key(&named)
-        || opened.len() != len || named.len() != len
-    {
-        return Err("quiet witness expected owner-private held/qualified leaf changed".into());
-    }
-    // Last path check is after the logical leaf and quota lookup.
-    check_directory(output, held, directory)
-}
