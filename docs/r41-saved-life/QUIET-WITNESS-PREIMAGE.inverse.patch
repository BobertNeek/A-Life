-#[cfg(all(target_os = "linux", target_arch = "x86_64"))]
-fn write_private_budgeted(output: &Path, bytes: &[u8]) -> Result<()> {
-    use std::io::Write;
-    let directory = fs::symlink_metadata(output)?;
-    let logical = output.join(NAME);
-    // O_DIRECTORY | O_NOFOLLOW. The producer will never create via logical.
-    let held = OpenOptions::new().read(true).custom_flags(0x30000).open(output)?;
-    check_directory(output, &held, &directory)?;
-    if !alife_storage::budget_for(&logical)?.is_some_and(|b| b.root() == output) {
-        return Err("quiet witness requires the actual private budgeted native output".into());
-    }
-
-    let file = create_in_held_output(&held)?;
-    let first = file.metadata()?;
-    check_witness_binding(output, &logical, &held, &directory, &file, &first, 0)?;
-    // Register the same held empty file against the authenticated logical quota.
-    // A second path+FD check after registration is mandatory BEFORE any bytes.
-    let mut writer = alife_storage::writer(&logical, file)?;
-    check_witness_binding(output, &logical, &held, &directory, writer.get_ref(), &first, 0)?;
-    writer.write_all(bytes)?;
-    writer.sync_all()?;
-    let mut readback = vec![0; bytes.len()];
-    writer.get_ref().read_exact_at(&mut readback, 0)?;
-    if readback != bytes {
-        return Err("quiet witness final held bytes are not the produced evidence".into());
-    }
-    held.sync_all()?;
-    check_witness_binding(
-        output, &logical, &held, &directory, writer.get_ref(), &first, bytes.len() as u64,
-    )
-}
