-    assert!(!output.join(NAME).exists());
-    assert_eq!(fs::symlink_metadata(moved.join(NAME)).unwrap().len(), 0);
-    assert_eq!(original_leaf_fd.metadata().unwrap().len(), 0);
-    drop(original_leaf_fd);
-    drop(budget);
-    drop(held);
-    fs::remove_dir_all(parent).unwrap();
-}
