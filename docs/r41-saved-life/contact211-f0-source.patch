+//! Feature-gated pre-dispatch physical witness. No routing, selection or world mutation.
+use super::*;
+use alife_core::{
+    CandidateActionFamily, CandidateObservationRef, PerceptionFrameDigest,
+    TrackedObjectId, MAX_GROUNDED_OBJECT_SLOTS,
+};
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Contact211WorldRow {
+    pub candidate_index: u16,
+    pub observed_slot: u16,
+    pub track: TrackedObjectId,
+    pub physical_target: WorldEntityId,
+    pub appearance_f9_14_bits: [u32; 6],
+    pub free_legal_before_motion: bool,
+}
+
+/// Process-local diagnostics only. Do not serialize into the checkpoint or feed selectors.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Contact211WorldWitness {
+    pub organism: OrganismId,
+    pub decision_tick: Tick,
+    pub frame_digest: PerceptionFrameDigest,
+    pub current_world_signature: HeadlessWorldSignatureDigest,
+    pub hand_actually_empty: bool,
+    pub sealed_candidate_count: u16,
+    pub rows: Vec<Contact211WorldRow>,
+}
+
+impl HeadlessWorld {
+    /// From the finalized frame and its original captured native observation transport,
+    /// under the actual pre-dispatch World borrow. Old/outcome observer frames cannot bind.
+    pub fn contact211_world_witness(
+        &self,
+        frame: &PerceptionFrame,
+        binding: &GroundedCandidateBinding,
+    ) -> Result<Contact211WorldWitness, ScaffoldContractError> {
+        let invalid = || ScaffoldContractError::InvalidDecisionEvidence;
+        frame.validate()?;
+        let host = frame.organism_id();
+        if frame.tick() != self.tick() || frame.candidates().is_empty()
+            || frame.candidates().len() > 32
+        {
+            return Err(invalid());
+        }
+        let actor = self.agent_entity_id(host)?;
+        let body = self.objects.get(&actor.raw()).ok_or_else(invalid)?;
+        let record = self.organism_registry.get(host).ok_or_else(invalid)?;
+        if body.consumed || body.organism_id != Some(host) || !record.lifecycle().is_alive()
+            || point_bits(frame.body().pose.translation) != point_bits(body.position)
+        {
+            return Err(invalid());
+        }
+        let empty = !self.objects.values().any(|object|
+            !object.consumed && object.carried_by == Some(host));
+        let mut rows = Vec::new();
+        let mut seen_slots = BTreeSet::new();
+        let mut seen_tracks = BTreeSet::new();
+        let mut seen_targets = BTreeSet::new();
+        for (i, offer) in frame.candidates().iter().enumerate() {
+            if offer.action_id != HeadlessActionIds::GRAB {
+                continue;
+            }
+            let CandidateObservationRef::ObjectSlot(observed_slot) = offer.observation else {
+                return Err(invalid());
+            };
+            if usize::from(offer.candidate_index) != i
+                || usize::from(observed_slot) >= MAX_GROUNDED_OBJECT_SLOTS
+                || offer.family != CandidateActionFamily::Contact
+            {
+                return Err(invalid());
+            }
+            let observed = frame.grounded_object_slots().iter()
+                .find(|o| o.slot_index == observed_slot).ok_or_else(invalid)?;
+            let (captured, transport) =
+                binding.contact211_transport(host, frame.tick(), observed_slot)?;
+            let target = self.objects.get(&transport.transport_entity.raw()).ok_or_else(invalid)?;
+            if observed.tracked_object_id != captured.tracked_object_id
+                || appearance_bits(observed) != appearance_bits(captured)
+                || offer.target.entity != Some(transport.transport_entity)
+                || offer.target.position.map(point_bits) != Some(point_bits(transport.target_position))
+                || point_bits(target.position) != point_bits(transport.target_position)
+                || (9..15).any(|j| offer.features.0[j].to_bits() != appearance_bits(observed)[j-9])
+                || !seen_slots.insert(observed_slot)
+                || !seen_tracks.insert(observed.tracked_object_id.raw())
+                || !seen_targets.insert(transport.transport_entity.raw())
+            {
+                return Err(invalid());
+            }
+            let free = !target.consumed && target.carried_by.is_none() && !target.activity_hold
+                && self.player_held_object() != Some(transport.transport_entity);
+            rows.push(Contact211WorldRow {
+                candidate_index: offer.candidate_index,
+                observed_slot,
+                track: observed.tracked_object_id,
+                physical_target: transport.transport_entity,
+                appearance_f9_14_bits: appearance_bits(observed),
+                free_legal_before_motion: free
+                    && self.grab_target_is_legal(host, actor, transport.transport_entity),
+            });
+        }
+        Ok(Contact211WorldWitness {
+            organism: host,
+            decision_tick: frame.tick(),
+            frame_digest: frame.frame_digest(),
+            current_world_signature: self.canonical_signature_digest()?,
+            hand_actually_empty: empty,
+            sealed_candidate_count: frame.candidates().len() as u16,
+            rows,
+        })
+    }
+}
+
+fn point_bits(v: Vec3f) -> [u32; 3] { [v.x.to_bits(), v.y.to_bits(), v.z.to_bits()] }
+fn appearance_bits(o: &alife_core::GroundedObjectSlotV1) -> [u32; 6] {
+    let [a, b, c] = o.material;
+    let [d, e, f] = o.shape;
+    [a, b, c, d, e, f].map(f32::to_bits)
+}
