@@ -0,0 +1,118 @@
+//! Process-local operator F0 witness; not wired into command-line/evaluator policy.
+use super::*;
+use alife_core::PerceptionFrameDigest;
+use alife_gpu_backend::training_rollout::{Contact211PresampleAdmission, Contact211PresampleReport};
+use alife_world::{Contact211WorldWitness, HeadlessWorldSignatureDigest};
+
+#[derive(Debug)]
+pub struct Contact211WitnessRequest {
+    pub organism: OrganismId,
+    pub decision_tick: Tick,
+    pub expected_frame: PerceptionFrameDigest,
+    pub expected_world: HeadlessWorldSignatureDigest,
+}
+
+#[derive(Debug)]
+pub struct Contact211F0Witness {
+    pub world: Contact211WorldWitness,
+    pub presample: Contact211PresampleReport,
+}
+
+impl GpuLiveBrainRuntime {
+    /// Operator supplies separately authenticated expected digests, not a fixture identity or
+    /// desired action. Accepted only for the current single resident in signed inference.
+    pub fn request_contact211_witness(
+        &mut self,
+        request: Contact211WitnessRequest,
+    ) -> Result<(), ScaffoldContractError> {
+        if self.contact211_request.is_some()
+            || request.decision_tick != self.world.tick()
+            || self.residents.len() != 1 || !self.residents.contains_key(&request.organism.raw())
+            || self.training_sampling.is_none_or(|sampling| sampling.demonstrator.is_some())
+            || self.training_demonstrator.is_some()
+            || request.expected_world.words == [0; 4]
+            || request.expected_frame.0 == [0; 4]
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        self.contact211_request = Some(request);
+        self.contact211_captured = None;
+        self.contact211_pending = None;
+        self.contact211_completed = None;
+        Ok(())
+    }
+
+    pub fn take_contact211_witness(&mut self) -> Option<Contact211F0Witness> {
+        self.contact211_completed.take()
+    }
+
+    pub(super) fn capture_contact211_world_if_admitted(
+        &mut self, frame: &PerceptionFrame, binding: Option<&alife_world::GroundedCandidateBinding>,
+    ) {
+        let Some(request) = self.contact211_request.as_ref() else { return; };
+        if request.organism != frame.organism_id() || request.decision_tick != frame.tick()
+            || request.expected_frame != frame.frame_digest()
+        {
+            return;
+        }
+        self.contact211_captured = binding
+            .and_then(|binding| self.world.contact211_world_witness(frame, binding).ok())
+            .filter(|w| w.current_world_signature == request.expected_world);
+    }
+
+    pub(super) fn submit_contact211_witness_or_stock(
+        &mut self, batch: &GpuClosedLoopMemoryBatchInput<'_>, prepared: &[PreparedGpuBrainFrame],
+        before: &[alife_gpu_backend::training_rollout::GpuTrainingStateSnapshot],
+        configs: &[alife_gpu_backend::GpuTrainingSamplingConfig],
+    ) -> Result<Vec<alife_gpu_backend::GpuClosedLoopTick>, ScaffoldContractError> {
+        // Missing/stale/unmatched: same stock method with the original sampler/RNG and budget.
+        let (Some(request), Some(world), [prepared], [before]) =
+            (self.contact211_request.take(), self.contact211_captured.take(), prepared, before)
+        else {
+            return self.backend.tick_memory_batch_training(batch, configs);
+        };
+        if request.organism != world.organism || self.world.tick() != world.decision_tick
+            || world.frame_digest != prepared.frame.frame_digest() || prepared.handle != before.handle
+            || before.tick != world.decision_tick.raw()
+            || self.world.canonical_signature_digest().ok() != Some(world.current_world_signature)
+        {
+            return self.backend.tick_memory_batch_training(batch, configs);
+        }
+        let gate = Contact211PresampleAdmission {
+            handle: prepared.handle, tick: world.decision_tick, frame_digest: world.frame_digest,
+            world_signature_words: world.current_world_signature.words,
+            next_dispatch_generation: self.backend.contact211_presample_expected_dispatch(),
+            expected_weight_generation: before.active_weight_generation,
+        };
+        let (ticks, proof) = self.backend.tick_memory_batch_training_contact211_witness(
+            batch, configs, Some(gate),
+        )?;
+        // Join only as evidence. An observation miss does not roll back, retry or edit stock.
+        if let Some(presample) = proof.filter(|p| {
+            p.frame_digest == world.frame_digest && p.tick == world.decision_tick
+                && p.world_signature_words == world.current_world_signature.words
+                && p.rows.len() == world.rows.len()
+                && p.rows.iter().zip(&world.rows).all(|(g, w)| {
+                    g.candidate_index == w.candidate_index
+                        && g.observed_f9_14_bits == w.appearance_f9_14_bits
+                })
+        }) {
+            self.contact211_pending = Some(Contact211F0Witness { world, presample });
+        }
+        Ok(ticks)
+    }
+
+    pub(super) fn finish_contact211_after_successful_staged_tick(&mut self) {
+        self.contact211_completed = self.contact211_pending.take().filter(|proof|
+            proof.world.decision_tick.raw().checked_add(1) == Some(self.world.tick().raw()));
+    }
+
+    pub(super) fn reset_contact211_before_staged_tick(&mut self) {
+        self.contact211_captured = None;
+        self.contact211_pending = None;
+        self.contact211_completed = None;
+        if self.contact211_request.as_ref().is_some_and(|r| r.decision_tick != self.world.tick()) {
+            self.contact211_request = None;
+        }
+    }
+}
