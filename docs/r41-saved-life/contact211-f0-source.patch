+    pub rows: Vec<Contact211ProjectedRow>,
+}
+
+#[cfg(feature = "contact211-witness")]
+#[derive(Debug, PartialEq, Eq)]
+pub struct Contact211ProjectedRow {
+    pub candidate_index: u16,
+    pub stock_f32_bits: u32,
+    pub projected_representative: bool,
+    pub independently_projected_hand: bool,
+    pub representative_can_force_hand: bool,
+    pub observed_f9_14_bits: [u32; 6],
+}
+
+/// Verification-only reconstruction of source-exact signed native factor predicates
+/// from untouched post-context words copied *before* the GPU sampler. Never call it on
+/// an old post-selection receipt and never return chosen candidates as proof.
+#[cfg(feature = "contact211-witness")]
+pub(crate) fn contact211_presample_support(
+    frame: &PerceptionFrame,
+    tick: &crate::GpuClosedLoopTick,
+    used: Contact211PresampleAdmission,
+) -> Result<Contact211PresampleReport, ScaffoldContractError> {
+    let invalid = || ScaffoldContractError::InvalidDecisionEvidence;
+    let receipt = tick.training_rollout.as_ref().ok_or_else(invalid)?;
+    let count = frame.candidates().len();
+    if count == 0 || count > 32 || tick.handle != used.handle
+        || tick.dispatch_generation != used.next_dispatch_generation
+        || receipt.dispatch_generation != used.next_dispatch_generation
+        || receipt.active_weight_generation != used.expected_weight_generation
+        || tick.frame_digest != used.frame_digest
+        || receipt.frame_digest != frame.frame_digest()
+        || receipt.organism_id != frame.organism_id().raw()
+        || receipt.tick != frame.tick().raw()
+        || receipt.logits.len() != count || receipt.forced_motor_slots.len() != count
+        || receipt.decoder_input_stride < 15
+        || count.checked_mul(receipt.decoder_input_stride) != Some(receipt.decoder_inputs.len())
+    {
+        return Err(ScaffoldContractError::InvalidDecisionEvidence);
+    }
+    let mut out = Vec::new();
+    // alife_world's public type is intentionally not imported into this backend.
+    const NATIVE_GRAB: u32 = 211;
+    for (i, candidate) in frame.candidates().iter().enumerate() {
+        if candidate.action_id.raw() != NATIVE_GRAB { continue; }
+        let bit = 1u32 << i;
+        let logit = receipt.logits[i];
+        let representative = receipt.representative_mask & bit != 0;
+        let independent_hand = receipt.motor_masks[2] & bit != 0;
+        let forcing_hand = representative && receipt.forced_motor_slots[i] == 2;
+        if representative != (logit.to_bits() != 0x7fc0_0001 && logit.is_finite())
+            || independent_hand && !representative
+        {
+            return Err(ScaffoldContractError::InvalidDecisionEvidence);
+        }
+        let start = i * receipt.decoder_input_stride;
+        let observed_f9_14_bits = std::array::from_fn(|j| receipt.decoder_inputs[start + 9 + j].to_bits());
+        if (0..6).any(|j| observed_f9_14_bits[j] != candidate.features.0[9+j].to_bits()) {
+            return Err(invalid());
+        }
+        out.push(Contact211ProjectedRow {
+            candidate_index: i as u16,
+            stock_f32_bits: logit.to_bits(),
+            projected_representative: representative,
+            independently_projected_hand: independent_hand,
+            representative_can_force_hand: forcing_hand,
+            observed_f9_14_bits,
+        });
+    }
+    Ok(Contact211PresampleReport {
+        handle: used.handle, tick: used.tick, frame_digest: used.frame_digest,
+        world_signature_words: used.world_signature_words,
+        dispatch_generation: receipt.dispatch_generation,
+        weight_generation: receipt.active_weight_generation,
+        rows: out,
     })
 }
 
