+// Appended only to the detached, signed decode module. Production shaders/sampler untouched.
+const CONTACT211_RANK32_MAGIC:u32 = 0x51333243u;
+const CONTACT211_RANK32_PAYLOAD_WORDS:u32 = 252u;
+
+fn contact211_rank32_unit(x:f32) -> bool {
+  return finite_decode(x) && x >= 0.0 && x <= 1.0;
+}
+
+fn contact211_rank32_pattern(port:u32, rails:u32, weights:u32) -> f32 {
+  var result=1.0;
+  for (var j=0u; j<8u; j++) {
+    let x=bitcast<f32>(frame_payload_words[port + rails + j]);
+    let w=bitcast<f32>(frame_payload_words[port + weights + j]);
+    if (!finite_decode(x) || x == 0.0 || abs(x)>1.0 || abs(w)!=1.0) { return 0.0; }
+    result=min(result,max(0.0,x*w));
+  }
+  return result;
+}
+
+@compute @workgroup_size(1)
+fn apply_contact211_rank32(@builtin(global_invocation_id) gid:vec3<u32>) {
+  if (any(gid != vec3<u32>(0u))) { return; }
+  let header=load_perception_header(0u);
+  if (!activity_contract_prevalidated(header) || (header.reserved & 0x80000000u)==0u
+      || header.candidate_count==0u || header.candidate_count>32u) { return; }
+  let sampling=header.reserved & 0x7fffffffu;
+  let port=sampling+11u;
+  if (!span_within(port, CONTACT211_RANK32_PAYLOAD_WORDS, arrayLength(&frame_payload_words))
+      || frame_payload_words[sampling+3u]!=0u
+      || frame_payload_words[port]!=CONTACT211_RANK32_MAGIC || frame_payload_words[port+1u]!=1u
+      || frame_payload_words[port+2u]!=header.candidate_count
+      || frame_payload_words[port+5u]!=header.tick_lo || frame_payload_words[port+6u]!=header.tick_hi
+      || frame_payload_words[port+7u]!=header.slot || frame_payload_words[port+8u]!=header.slot_generation
+      || frame_payload_words[port+9u]!=header.dispatch_generation_lo
+      || frame_payload_words[port+10u]!=header.dispatch_generation_hi) { return; }
+  let roster=frame_payload_words[port+3u];
+  let legal=frame_payload_words[port+4u];
+  let grip=bitcast<f32>(frame_payload_words[port+11u]);
+  let gain=bitcast<f32>(frame_payload_words[port+58u]);
+  let band=bitcast<f32>(frame_payload_words[port+59u]);
+  if (roster==0u || (legal & ~roster)!=0u || !contact211_rank32_unit(grip) || grip==1.0
+      || !finite_decode(gain) || gain<=0.0 || gain>32.0
+      || !finite_decode(band) || band<=0.0 || band>=1.0) { return; }
+
+  let verb=contact211_rank32_pattern(port,12u,28u);
+  let noun_minus=contact211_rank32_pattern(port,20u,36u);
+  let noun_plus=contact211_rank32_pattern(port,20u,44u);
+  let purpose=min(verb,noun_plus)-min(verb,noun_minus);
+  if (purpose==0.0) { return; }
+
+  let brain=brain_slots[header.brain_slot_index];
+  var seen=0u;
+  var count=0u;
+  var indexes:array<u32,2>;
+  var axes:array<f32,2>;
+  var stock:array<f32,2>;
+  for (var i=0u; i<header.candidate_count; i++) {
+    let offer=load_candidate(header.candidate_offset+i*8u);
+    let bit=1u<<i;
+    // Action kind identifies a stock logistical port, never a noun or target.
+    if (offer.action_id!=211u) {
+      if ((roster & bit)!=0u) { return; }
+      continue;
+    }
+    if ((roster & bit)==0u || offer.candidate_index!=i || offer.family!=5u
+        || offer.observation_slot_or_max>=16u || factorized_motor_slot(offer.kind)!=2u
+        || !span_within(offer.feature_offset, 15u, arrayLength(&frame_payload_words))) { return; }
+    seen=seen|bit;
+    var axis=0.0;
+    for (var j=0u; j<6u; j++) {
+      let feature=frame_payload_words[offer.feature_offset+9u+j];
+      if (feature!=frame_payload_words[port+60u+i*6u+j]) { return; }
+      let x=bitcast<f32>(feature);
+      let k=bitcast<f32>(frame_payload_words[port+52u+j]);
+      if (!contact211_rank32_unit(x) || !finite_decode(k) || abs(k)>1.0) { return; }
+      axis=axis+x*k;
+    }
+    // Same stock projection predicates used by the existing native signed
+    // sampler, before changing any logit. A representative can force Hand when
+    // the independent Hand channel is disabled.
+    let projected=(training_candidate_allowed(header,brain,i,0u)
+            && factorized_motor_slot(offer.kind)==2u)
+        || training_candidate_allowed(header,brain,i,3u);
+    if ((legal & bit)!=0u && projected) {
+      // Only this initial paired scope. A third legal projected prop, including
+      // an appearance alias, forces full abstention rather than rank tie break.
+      if (count>=2u) { return; }
+      indexes[count]=i;
+      axes[count]=axis;
+      stock[count]=load_state_f32(brain.candidate_logit_offset+i);
+      count++;
+    }
+  }
+  if (seen!=roster || count!=2u) { return; }
+  let direction=sign(purpose);
+  let a=direction*axes[0];
+  let b=direction*axes[1];
+  if (max(a,b)<band || abs(a-b)<band) { return; }
+  let strength=gain*purpose*(1.0-grip);
+  let new_a=stock[0]+strength*axes[0];
+  let new_b=stock[1]+strength*axes[1];
+  if (!finite_decode(new_a) || !finite_decode(new_b)) { return; }
+  store_state_f32(brain.candidate_logit_offset+indexes[0],new_a);
+  store_state_f32(brain.candidate_logit_offset+indexes[1],new_b);
+}
