+// A detached signed one-cut payload; never serialized into the incumbent
+// checkpoint or constructed by a normal game dispatch.
+#[cfg(feature = "contact211-rank32")]
+pub(crate) const CONTACT211_RANK32_PAYLOAD_WORDS: usize = 252;
+
+#[cfg(feature = "contact211-rank32")]
+pub struct Contact211Rank32Input {
+    pub(crate) words: [u32; CONTACT211_RANK32_PAYLOAD_WORDS],
+    pub(crate) frame_digest: PerceptionFrameDigest,
+    pub(crate) organism: alife_core::OrganismId,
+    pub(crate) decision_tick: alife_core::Tick,
+}
+
+#[cfg(feature = "contact211-rank32")]
+impl Contact211Rank32Input {
+    pub fn try_bind(
+        frame: &PerceptionFrame, rails: [u32; 16], grip: f32, weights: [u32; 32],
+        roster: &[(u16, u16, [u32; 6], bool)],
+    ) -> Result<Self, ScaffoldContractError> {
+        use alife_core::{CandidateActionFamily, CandidateObservationRef};
+        let invalid = ScaffoldContractError::InvalidDecisionEvidence;
+        let count = frame.candidates().len();
+        if count == 0 || count > 32 || roster.is_empty() || roster.len() > 32
+            || !(0.0..1.0).contains(&grip)
+            || rails.iter().any(|b| {
+                let f = f32::from_bits(*b); !f.is_finite() || f == 0.0 || f.abs() > 1.0
+            })
+            || !rails[..8].iter().all(|b| f32::from_bits(*b).abs() == f32::from_bits(rails[0]).abs())
+            || !rails[8..].iter().all(|b| f32::from_bits(*b).abs() == f32::from_bits(rails[8]).abs())
+            || weights[..24].iter().any(|b| f32::from_bits(*b).abs() != 1.0)
+            || weights[24..30].iter().any(|b| {
+                let f=f32::from_bits(*b); !f.is_finite() || f.abs()>1.0
+            })
+            || !(0.0..=32.0).contains(&f32::from_bits(weights[30]))
+            || !(0.0 < f32::from_bits(weights[31]) && f32::from_bits(weights[31]) < 1.0)
+        {
+            return Err(invalid);
+        }
+        let mut words = [0; CONTACT211_RANK32_PAYLOAD_WORDS];
+        words[0] = 0x51333243;
+        words[1] = 1;
+        words[2] = count as u32;
+        words[11] = grip.to_bits();
+        words[12..28].copy_from_slice(&rails);
+        words[28..60].copy_from_slice(&weights);
+        let mut slots = 0_u32;
+        for &(i, slot, features, legal) in roster {
+            let Some(c) = frame.candidates().get(usize::from(i)) else { return Err(invalid); };
+            let i = usize::from(i);
+            let mark = 1_u32 << i;
+            if slot >= 16 || slots & (1_u32 << slot) != 0 || words[3] & mark != 0
+                || c.action_id.raw() != 211 || c.family != CandidateActionFamily::Contact
+                || c.observation != CandidateObservationRef::ObjectSlot(slot)
+                || (0..6).any(|j| c.features.0[9+j].to_bits() != features[j]
+                    || !(0.0..=1.0).contains(&f32::from_bits(features[j])))
+            {
+                return Err(invalid);
+            }
+            slots |= 1_u32 << slot;
+            words[3] |= mark;
+            if legal { words[4] |= mark; }
+            words[60+i*6..66+i*6].copy_from_slice(&features);
+        }
+        if frame.candidates().iter().enumerate().any(|(i,c)| {
+            (c.action_id.raw()==211) != (words[3] & (1_u32<<i) != 0)
+        }) {
+            return Err(invalid);
+        }
+        Ok(Self{ words, frame_digest: frame.frame_digest(), organism: frame.organism_id(), decision_tick: frame.tick() })
+    }
 }
 
