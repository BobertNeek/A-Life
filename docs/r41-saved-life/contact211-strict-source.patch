@@ -0,0 +1,288 @@
+//! Separate schema-7 observer-only admission layered over an exact, admitted native cue cell.
+use super::{digest, now, Result};
+use crate::gpu_live_runtime::{Contact211WitnessRequest, GpuLiveBrainRuntime};
+use alife_core::{OrganismId, PerceptionFrameDigest, Tick};
+use alife_world::{Contact211WorldWitness, HeadlessWorldSignatureDigest};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{fs, io::Read, path::Path};
+
+pub(super) const SCHEMA: u16 = 7;
+const SCOPE: &str = "qualia.saved_life.contact211_f0_parity.v1";
+const ADMIT: &str = "qualia.saved_life.contact211_f0_admission.v1";
+const TRANSCRIPT: &str = "qualia.saved_life.contact211_f0_stock_reference.v1";
+const ARM_MODE: &str = "observer_only_one_signed_cut_fixed_0ns";
+const CELL: &str = "contact211-language-cell.schema5.json";
+const PERMIT: &str = "contact211-f0-admission.v1.json";
+const GRANT: &str = "contact211-operator-grant.v1.json";
+const REFERENCE: &str = "contact211-stock-reference.v1.json";
+const MAX: usize = 8192;
+
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Arm { StockReference, PresampleWitness }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    schema: u16,
+    scope: String,
+    language_manifest_sha256: String,
+    admission_sha256: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Admission {
+    schema: String,
+    scope: String,
+    behavior_scope: String,
+    arm: Arm,
+    current_sha256: String,
+    language_manifest_sha256: String,
+    evaluator_sha256: String,
+    independent_operator_grant_sha256: String,
+    expires_unix_seconds: u64,
+    max_decisions: u64,
+    max_world_ticks: u64,
+    prior_stock_reference_sha256: Option<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OperatorGrant {
+    schema: String,
+    scope: String,
+    arm: Arm,
+    current_sha256: String,
+    evaluator_sha256: String,
+    language_manifest_sha256: String,
+    prior_stock_reference_sha256: Option<String>,
+    max_decisions: u64,
+    max_world_ticks: u64,
+    live_selection_edit: bool,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct StockReference {
+    schema: String,
+    source_current_sha256: String,
+    evaluator_sha256: String,
+    language_manifest_sha256: String,
+    stock_arm_admission_sha256: String,
+    stock_arm_outer_manifest_sha256: String,
+    original_physical_rows_sha256: String,
+    owner: u64,
+    tick: u64,
+    frame: PerceptionFrameDigest,
+    world: HeadlessWorldSignatureDigest,
+}
+
+#[derive(Serialize)]
+pub(super) struct Scope {
+    schema: &'static str,
+    arm: Arm,
+    language_manifest_sha256: String,
+    admission_sha256: String,
+    current_sha256: String,
+    evaluator_sha256: String,
+    frozen_stock_reference_sha256: Option<String>,
+    #[serde(skip)]
+    reference: Option<StockReference>,
+    expires_unix_seconds: u64,
+}
+
+fn exact(s: &str) -> bool {
+    s.len() == 64 && s.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+}
+fn read_local(root: &Path, name: &str) -> Result<Vec<u8>> {
+    let path = root.join(name);
+    if path.canonicalize()? != path || !fs::symlink_metadata(&path)?.is_file() {
+        return Err("Contact211 requires a distinct canonical regular admission leaf".into());
+    }
+    let mut b = Vec::new();
+    fs::File::open(path)?.take(MAX as u64 + 1).read_to_end(&mut b)?;
+    if b.is_empty() || b.len() > MAX {
+        return Err("Contact211 admission exceeds bounded leaf".into());
+    }
+    Ok(b)
+}
+
+// Digest checks bind approved bytes but do not confer external launch authority.
+pub(super) fn resolve(root: &Path, bytes: &[u8]) -> Result<(Scope, Vec<u8>)> {
+    if bytes.is_empty() || bytes.len() > MAX {
+        return Err("Contact211 invalid outer manifest length".into());
+    }
+    let x: Envelope = serde_json::from_slice(bytes)?;
+    if x.schema != SCHEMA || x.scope != SCOPE
+        || !exact(&x.language_manifest_sha256) || !exact(&x.admission_sha256) {
+        return Err("Contact211 unsupported observer-only envelope".into());
+    }
+    let raw = read_local(root, PERMIT)?;
+    if digest(&raw) != x.admission_sha256 {
+        return Err("Contact211 separately approved permit hash mismatch".into());
+    }
+    let a: Admission = serde_json::from_slice(&raw)?;
+    let current_time = now()?;
+    if a.schema != ADMIT || a.scope != SCOPE || a.behavior_scope != ARM_MODE
+        || !exact(&a.current_sha256) || !exact(&a.evaluator_sha256)
+        || !exact(&a.independent_operator_grant_sha256)
+        || a.language_manifest_sha256 != x.language_manifest_sha256
+        || a.max_decisions != 1 || a.max_world_ticks != 1
+        || a.expires_unix_seconds <= current_time || a.expires_unix_seconds > current_time.saturating_add(600)
+        || digest(&fs::read(std::env::current_exe()?)?) != a.evaluator_sha256
+    {
+        return Err("Contact211 mismatched or expired signed-scope inputs".into());
+    }
+    let raw_grant = read_local(root, GRANT)?;
+    if digest(&raw_grant) != a.independent_operator_grant_sha256 {
+        return Err("Contact211 external operator grant digest differs".into());
+    }
+    let grant: OperatorGrant = serde_json::from_slice(&raw_grant)?;
+    if grant.schema != "qualia.saved_life.contact211_f0_operator_grant.v1" || grant.scope != SCOPE
+        || grant.arm != a.arm || grant.current_sha256 != a.current_sha256
+        || grant.evaluator_sha256 != a.evaluator_sha256
+        || grant.language_manifest_sha256 != a.language_manifest_sha256
+        || grant.prior_stock_reference_sha256 != a.prior_stock_reference_sha256
+        || grant.max_decisions != 1 || grant.max_world_ticks != 1 || grant.live_selection_edit
+    {
+        return Err("Contact211 operator grant does not bind this observer-only arm".into());
+    }
+    let nested = read_local(root, CELL)?;
+    if digest(&nested) != x.language_manifest_sha256 {
+        return Err("Contact211 nested native cue cell changed".into());
+    }
+    let reference = match (a.arm, &a.prior_stock_reference_sha256) {
+        (Arm::StockReference, None) => None,
+        (Arm::PresampleWitness, Some(xref)) if exact(xref) => {
+            let rb = read_local(root, REFERENCE)?;
+            if digest(&rb) != *xref { return Err("Contact211 prior reference hash mismatch".into()); }
+            let r: StockReference = serde_json::from_slice(&rb)?;
+            if r.schema != TRANSCRIPT || r.source_current_sha256 != a.current_sha256
+                || r.evaluator_sha256 != a.evaluator_sha256
+                || r.language_manifest_sha256 != x.language_manifest_sha256
+                || !exact(&r.stock_arm_admission_sha256)
+                || r.stock_arm_admission_sha256 == x.admission_sha256
+                || !exact(&r.stock_arm_outer_manifest_sha256)
+                || r.stock_arm_outer_manifest_sha256 == digest(bytes)
+                || !exact(&r.original_physical_rows_sha256) || r.owner == 0
+                || r.frame.0 == [0; 4] || r.world.words == [0; 4]
+            {
+                return Err("Contact211 witness needs independent prior stock pre-dispatch evidence".into());
+            }
+            Some(r)
+        }
+        _ => return Err("Contact211 arm/reference scope differs".into()),
+    };
+    Ok((Scope {
+        schema: SCOPE, arm: a.arm, language_manifest_sha256: a.language_manifest_sha256,
+        admission_sha256: x.admission_sha256, current_sha256: a.current_sha256,
+        evaluator_sha256: a.evaluator_sha256, frozen_stock_reference_sha256: a.prior_stock_reference_sha256,
+        reference, expires_unix_seconds: a.expires_unix_seconds,
+    }, nested))
+}
+
+impl Scope {
+    pub(super) fn binds_source_and_deadline(&self, current: &str, deadline: u64) -> bool {
+        current == self.current_sha256 && deadline <= self.expires_unix_seconds
+    }
+    pub(super) fn arm(&self, runtime: &mut GpuLiveBrainRuntime, owner: OrganismId, tick: Tick) -> Result<()> {
+        if now()? >= self.expires_unix_seconds {
+            return Err("Contact211 admission expired before dispatch".into());
+        }
+        if let Some(prior) = &self.reference {
+            if prior.owner != owner.raw() || prior.tick != tick.raw() {
+                return Err("Contact211 prior frozen owner/tick differs".into());
+            }
+            runtime.request_contact211_witness_strict(Contact211WitnessRequest {
+                organism: owner, decision_tick: tick, expected_frame: prior.frame, expected_world: prior.world,
+            })?;
+        } else {
+            runtime.request_contact211_stock_reference(owner, tick)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn collect(&self, runtime: &mut GpuLiveBrainRuntime, step: &crate::gpu_live_runtime::FoundationTrainingStep) -> Result<Value> {
+        let (world, proof) = match self.arm {
+            Arm::StockReference => (runtime.take_contact211_stock_reference().ok_or("Contact211 missing actual stock predispatch World/frame")?, None),
+            Arm::PresampleWitness => {
+                let capture = runtime.take_contact211_witness().ok_or("Contact211 witness not independently admitted at current cut")?;
+                (capture.world, Some(capture.presample))
+            }
+        };
+        let count = step.frame.candidates().len();
+        if world.organism != step.frame.organism_id() || world.frame_digest != step.frame.frame_digest()
+            || world.decision_tick != step.frame.tick() || usize::from(world.sealed_candidate_count) != count
+            || count == 0 || count > 32
+            || step.behavior.logits.len() != count || step.behavior.forced_motor_slots.len() != count
+        {
+            return Err("Contact211 moved or mismatched actual stage".into());
+        }
+        if let Some(p) = &proof {
+            if p.dispatch_generation != step.behavior.dispatch_generation || p.weight_generation != step.behavior.active_weight_generation
+                || p.handle != step.after_inference.handle || p.rows.len() != world.rows.len()
+                || p.rows.iter().any(|r| {
+                    let i = usize::from(r.candidate_index);
+                    if i >= count { return true; }
+                    let bit = 1_u32 << i;
+                    r.stock_f32_bits != step.behavior.logits[i].to_bits()
+                        || r.projected_representative != (step.behavior.representative_mask & bit != 0)
+                        || r.independently_projected_hand != (step.behavior.motor_masks[2] & bit != 0)
+                        || r.representative_can_force_hand != (step.behavior.representative_mask & bit != 0
+                                                              && step.behavior.forced_motor_slots[i] == 2)
+                })
+            {
+                return Err("Contact211 post-proof candidate observation differs from stock receipt".into());
+            }
+        }
+        let observed_world = world_json(&world);
+        let gpu = proof.map(|p| json!({
+            "dispatch_generation":p.dispatch_generation, "weight_generation":p.weight_generation,
+            "slot":p.handle.slot(), "slot_generation":p.handle.generation(),
+            "rows":p.rows.into_iter().map(|r| json!({
+                "index":r.candidate_index, "stock_f32_bits":r.stock_f32_bits,
+                "rep":r.projected_representative, "hand":r.independently_projected_hand,
+                "forces_hand":r.representative_can_force_hand, "f9_14_bits":r.observed_f9_14_bits
+            })).collect::<Vec<_>>(),
+        }));
+        Ok(json!({"scope":SCOPE, "arm":self.arm, "observer_only":true, "world":observed_world,
+                  "actual_pre_sampler_gpu":gpu, "unchanged_signed_decision": {
+                    "all_stock_logit_u32_bits":step.behavior.logits.iter().map(|f|f.to_bits()).collect::<Vec<_>>(),
+                    "all_stock_decoder_input_u32_bits":step.behavior.decoder_inputs.iter().map(|f|f.to_bits()).collect::<Vec<_>>(),
+                    "representative_mask":step.behavior.representative_mask,"motor_masks":step.behavior.motor_masks,
+                    "motor_indices":step.behavior.motor_indices,"forced_motor_slots":step.behavior.forced_motor_slots,
+                    "representative_index":step.behavior.representative_index, "dispatch_generation":step.behavior.dispatch_generation,
+                    "weight_generation":step.behavior.active_weight_generation, "slot":step.after_inference.handle.slot(),
+                    "slot_generation":step.after_inference.handle.generation(), "sampling":step.behavior.sampling,
+                  }, "bonus_enabled":false, "official_score_eligible":false}))
+    }
+
+    /// Emit a small seed only after complete native stock run integrity. It is
+    /// not an admission and cannot validate any future run without new approval.
+    pub(super) fn publish_stock_reference(
+        &self, directory: &Path, observer: &Value, rows_sha256: &str, outer_sha256: &str
+    ) -> Result<()> {
+        if self.arm != Arm::StockReference { return Ok(()); }
+        #[derive(Deserialize)]
+        struct Observed { owner: u64, tick: u64, frame: PerceptionFrameDigest, world_signature: HeadlessWorldSignatureDigest }
+        let w: Observed = serde_json::from_value(observer["world"].clone())?;
+        if !exact(rows_sha256) || !exact(outer_sha256) { return Err("Contact211 lacks sealed stock receipt digests".into()); }
+        let result = StockReference { schema: TRANSCRIPT.into(), source_current_sha256: self.current_sha256.clone(),
+            evaluator_sha256:self.evaluator_sha256.clone(),language_manifest_sha256:self.language_manifest_sha256.clone(),
+            stock_arm_admission_sha256:self.admission_sha256.clone(), stock_arm_outer_manifest_sha256:outer_sha256.into(),
+            original_physical_rows_sha256:rows_sha256.into(), owner:w.owner,tick:w.tick,frame:w.frame,world:w.world_signature };
+        alife_storage::write(directory.join(REFERENCE), serde_json::to_vec_pretty(&result)?)?;
+        Ok(())
+    }
+}
+
+fn world_json(w: &Contact211WorldWitness) -> Value {
+    json!({"owner":w.organism.raw(),"tick":w.decision_tick.raw(),"frame":w.frame_digest,
+        "world_signature":w.current_world_signature,"hand_empty":w.hand_actually_empty,
+        "full_candidate_count":w.sealed_candidate_count,
+        "rows":w.rows.iter().map(|r| json!({"index":r.candidate_index,"observed_slot":r.observed_slot,
+            "track":r.track.raw(),"physical_body":r.physical_target.raw(),"f9_14_bits":r.appearance_f9_14_bits,
+            "current_free_legal":r.free_legal_before_motion})).collect::<Vec<_>>()})
+}
