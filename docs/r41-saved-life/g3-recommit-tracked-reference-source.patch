+// Private operator pins come from the separately authenticated historical
+// failure; neither missing nor arbitrary replacement signatures are defaults.
+fn recorded_world_signature(name: &str) -> HeadlessWorldSignatureDigest {
+    let wire = env::var(name).unwrap_or_else(|_| panic!("{name} is required"));
+    assert!(wire.len() <= 160, "recorded world signature exceeds its bound");
+    let value: HeadlessWorldSignatureDigest =
+        serde_json::from_str(&wire).expect("typed recorded canonical world signature");
+    assert_eq!(value.schema_version, HEADLESS_WORLD_SIGNATURE_SCHEMA_VERSION);
+    assert_eq!(
+        serde_json::to_string(&value).expect("canonical signature wire"),
+        wire,
+        "recorded world signature must be the exact canonical typed wire"
+    );
+    value
+}
