+//! Compile-only in hosted CI. These opt-in tests own a real ordinary gameplay
+//! runtime and original backend (one writer). Never point them at a live save.
+#![cfg(all(feature = "gpu-tests", feature = "replay-epoch-research"))]
+
+use std::{fs, path::Path, time::{Duration, Instant}};
+
+use alife_core::{BrainScaleTier, ConsolidationState, OrganismId, PolicyBackend, SleepPhase, Tick};
+use alife_game_app::{
+    AppShellLaunchConfig, CanonicalNewGameLaunchRequest, GameAppShellError, GpuLiveBrainRuntime,
+    GpuLiveTickOutcome, create_canonical_new_game_software_runtime_test,
+};
+use alife_gpu_backend::{GpuClosedLoopBackend, GpuRuntimeProfile};
+use alife_runtime::{GpuDurableSaveManifest, GpuLoadedSaveManifest, GpuReplayEpochStatusV2, GpuRuntimeError};
+use alife_world::{AssetManifest, RuntimeConfig};
+
+fn wait_step(deadline: Instant) {
+    assert!(Instant::now() < deadline, "bounded replay epoch probe timed out");
+    std::thread::sleep(Duration::from_millis(2));
+}
+
+fn resident_brain(
+    opened: &GpuLoadedSaveManifest,
+    owner: OrganismId,
+) -> &alife_world::persistence::GpuBrainSaveState {
+    opened.save.creatures.iter().find(|c| c.organism_id == owner)
+        .unwrap().gpu_brain.as_ref().unwrap()
+}
+
+fn software_backend() -> Result<GpuClosedLoopBackend, alife_core::ScaffoldContractError> {
+    let backend =
+        GpuClosedLoopBackend::new_software_vulkan_runtime_test(GpuRuntimeProfile::production_v1())?;
+    let adapter = backend.software_runtime_test_adapter_info().expect("actual test adapter");
+    assert_eq!(format!("{:?}", adapter.backend), "Vulkan");
+    assert_eq!(format!("{:?}", adapter.device_type), "Cpu");
+    Ok(backend)
+}
+
+fn launch_config(
+    scratch: &Path, assets: &Path, current: &Path, opened: &GpuLoadedSaveManifest, name: &str,
+) -> AppShellLaunchConfig {
+    let launch = AppShellLaunchConfig {
+        fixture_root: scratch.to_path_buf(),
+        config_path: scratch.join(format!("{name}.config.json")),
+        asset_manifest_path: scratch.join(format!("{name}.assets.json")),
+        save_path: current.to_path_buf(),
+        asset_root: assets.to_path_buf(),
+        start_paused: false,
+        brain_policy: PolicyBackend::NeuralClosedLoopGpu,
+    };
+    fs::write(&launch.config_path, serde_json::to_vec_pretty(&opened.save.config).unwrap()).unwrap();
+    fs::write(&launch.asset_manifest_path, serde_json::to_vec_pretty(&opened.save.assets).unwrap()).unwrap();
+    launch
+}
+
+fn check_playable_full_cut(cold: bool) {
+    assert_eq!(std::env::var("QUALIA_REPLAY_EPOCH_VULKAN_MODE").ok().as_deref(),
+        Some("isolated-software-vulkan-runtime-test"));
+
+    let scratch = std::env::current_dir().unwrap().join(format!(
+        "replay-epoch-live-{}-{}", std::process::id(), if cold { "cold" } else { "warm" },
+    ));
+    // Do not overwrite a prior trial, even if it failed.
+    fs::create_dir(&scratch).unwrap();
+    let assets = scratch.join("assets");
+    fs::create_dir(&assets).unwrap();
+    let current = scratch.join("current.json");
+    let mut config = RuntimeConfig::deterministic_default(31_117, BrainScaleTier::Nano512);
