+    pub(super) fn active_sealed_replay_epoch(&self) -> bool {
+        matches!(&self.exact_checkpoint_work,
+            ExactPopulationCheckpointRuntimeWorkV1::AwaitingJournal { permit, .. }
+                if permit.published().replay_epoch_status() == GpuReplayEpochStatusV2::Unconsumed)
+            || matches!(&self.exact_checkpoint_work,
+                ExactPopulationCheckpointRuntimeWorkV1::JournalWorker { journal_commit: Some(commit), .. }
+                    if commit.contains_sealed_replay_epoch)
+    }
+
+    pub(super) fn require_single_living_replay_epoch_resident(&self)
+        -> Result<OrganismId, GameAppShellError>
+    {
+        let denied = || alife_runtime::GpuRuntimeError::ReplayEpochRequiresSingleLivingResident;
+        let mut records = self.world.organism_registry().iter();
+        let first = records.next().ok_or_else(denied)?;
+        let id = first.organism_id();
+        if !first.lifecycle().is_alive() || records.next().is_some()
+            || self.handles.len() != 1 || self.residents.len() != 1
+            || !self.handles.contains_key(&id.raw()) || !self.residents.contains_key(&id.raw())
+        {
+            return Err(denied().into());
+        }
+        Ok(id)
+    }
+
+    // Only marked genesis holds the whole world. After a neutral shutdown
+    // drain, this old runtime cannot silently continue; freshly reopen G1.
+    pub(super) fn replay_epoch_before_tick(
+        &self,
+    ) -> Result<Option<GpuLiveNoProgressReason>, GameAppShellError> {
+        let Some(cut) = self.replay_epoch_execution_cut else { return Ok(None); };
+        self.require_single_living_replay_epoch_resident()?;
+        if !self.schedule_sleep || self.world.tick() != cut.source_tick
+            || self.world.canonical_signature_digest()? != cut.world_signature
+            || self.exact_checkpoint_coordinator.active_identity().is_none_or(|id|
+                id.transaction_id != cut.transaction_id || id.checkpoint_tick != cut.source_tick)
+        {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        match &self.exact_checkpoint_work {
+            ExactPopulationCheckpointRuntimeWorkV1::Capture { .. }
+            | ExactPopulationCheckpointRuntimeWorkV1::Worker { .. }
+            | ExactPopulationCheckpointRuntimeWorkV1::CommitWorker { .. } =>
+                Ok(Some(GpuLiveNoProgressReason::CheckpointPublicationPending)),
+            ExactPopulationCheckpointRuntimeWorkV1::AwaitingJournal { permit, .. }
+                if permit.transaction_id() == cut.transaction_id
+                    && permit.epoch_commit_scope().is_some()
+                    && permit.published().replay_epoch_live_world_signature()? == cut.world_signature =>
+                Ok(None),
+            _ => Err(ScaffoldContractError::ConsolidationGenerationMismatch.into()),
+        }
+    }
+
+    pub(super) fn defer_restored_replay_epoch(
+        &mut self, journal: GpuSleepTransactionJournalV2,
+    ) -> Result<(), GameAppShellError> {
+        self.require_single_living_replay_epoch_resident()?;
+        if self.deferred_replay_epoch.is_some() || !self.persistence_idle_for_shutdown()
+            || !journal.entries.is_empty()
+        {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        let durability = self.checkpoint_durability.as_ref()
+            .ok_or(ScaffoldContractError::MissingPhaseData)?;
+        if durability.published.replay_epoch_status() != GpuReplayEpochStatusV2::Unconsumed
+            || durability.published.save.world.tick != self.world.tick()
+            || durability.durable_manifest.load_sleep_transaction_journal(&durability.published)? != journal
+        {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        let digest = durability.published.digest.clone();
+        let manifest_path = durability.durable_manifest.save_path().to_path_buf();
+        let world_signature = self.world.canonical_signature_digest()?;
+        if world_signature != durability.published.replay_epoch_live_world_signature()? {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        let handles = self.handles.clone();
+        let neural_authority = self.validate_replay_epoch_residents()?;
+        self.deferred_replay_epoch = Some(DeferredReplayEpochV2 {
+            digest, manifest_path, world_signature, handles, journal, neural_authority,
+        });
+        Ok(())
+    }
+
+    fn validate_replay_epoch_residents(
+        &mut self,
+    ) -> Result<BTreeMap<u64, SleepJournalNeuralAuthority>, GameAppShellError> {
+        let durability = self.checkpoint_durability.as_ref()
+            .ok_or(ScaffoldContractError::MissingPhaseData)?;
+        if self.world.organism_registry().iter().any(|r| !r.lifecycle().is_alive()) {
+            // Retirement owns its own writes. This exact replay arm refuses
+            // a pending death before handing ownership to that staged path.
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        let found = self.prospective_live_organism_ids();
+        if found.len() != self.handles.len() || !self.handles.keys().all(|id| found.contains(id)) {
+            return Err(ScaffoldContractError::BrainOwnershipMismatch.into());
+        }
+        let mut staged_rows = BTreeMap::new();
+        for creature in &durability.published.save.creatures {
+            let raw = creature.organism_id.raw();
+            let Some(brain) = &creature.gpu_brain else {
+                return Err(ScaffoldContractError::BrainOwnershipMismatch.into());
+            };
+            let handle = *self.handles.get(&raw).ok_or(ScaffoldContractError::BrainOwnershipMismatch)?;
+            let resident = self.residents.get(&raw).ok_or(ScaffoldContractError::BrainOwnershipMismatch)?;
+            if resident.sleep_scheduler.state() != brain.sleep || handle.phenotype_hash() != brain.phenotype_hash {
+                return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+            }
+            if let ConsolidationState::Completed { request, staged } = brain.sleep.consolidation {
+                // This existing poll reads the owned staging receipt, not a
+                // commit or a new job. Restore already validated the staged buffers.
+                let receipt = self.backend.poll_sleep_consolidation(handle, staged.job_id)?
+                    .ok_or(ScaffoldContractError::ConsolidationGenerationMismatch)?;
+                if receipt.staged != staged || receipt.handle != handle
+                    || receipt.phenotype_hash != request.phenotype_hash
+                    || receipt.input_digest != request.input_digest || receipt.replay_digest != request.replay_digest
+                {
+                    return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+                }
+                let authority = capture_sleep_journal_neural_authority(&mut self.backend, handle)?;
+                if staged_rows.insert(raw, authority).is_some() {
+                    return Err(ScaffoldContractError::BrainOwnershipMismatch.into());
+                }
+            }
+        }
+        if staged_rows.is_empty() || self.handles.len() != durability.published.save.creatures.len() {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        Ok(staged_rows)
+    }
