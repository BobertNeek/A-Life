+    pub(super) fn admit_deferred_replay_epoch_before_tick(
+        &mut self,
+    ) -> Result<Option<GpuLiveNoProgressReason>, GameAppShellError> {
+        if self.deferred_replay_epoch.is_none() {
+            return Ok(None);
+        }
+        if !self.schedule_sleep {
+            self.deferred_replay_epoch = None;
+            return Ok(None);
+        }
+        if !self.persistence_idle_for_shutdown()
+            || !self.pending_exact_sleep_journal_entries.is_empty()
+            || self.manual_checkpoint_waiting_for_sleep_journal.is_some()
+        {
+            return Ok(Some(GpuLiveNoProgressReason::CheckpointPublicationPending));
+        }
+        let intent = self.deferred_replay_epoch.as_ref().expect("deferred intent checked above");
+        let durability = self.checkpoint_durability.as_ref()
+            .ok_or(ScaffoldContractError::MissingPhaseData)?;
+        let current = durability.durable_manifest.load()?;
+        if current.replay_epoch_status() != GpuReplayEpochStatusV2::Unconsumed
+            || current.digest != intent.digest || durability.published.digest != intent.digest
+            || durability.durable_manifest.save_path() != intent.manifest_path.as_path()
+            || current.save.world.tick != self.world.tick()
+            || self.world.canonical_signature_digest()? != intent.world_signature
+            || self.handles != intent.handles
+            || durability.durable_manifest.load_sleep_transaction_journal(&current)? != intent.journal
+        {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        let population = self.prospective_live_organism_ids().len();
+        let reserve = validate_sleep_journal_population(
+            population, self.backend.runtime_profile().max_hot_brains,
+        )?;
+        let capacity = self.prospective_sleep_journal_capacity(population)?;
+        if !exact_sleep_journal_tick_fits(
+            self.pending_exact_sleep_journal_entries.len(), reserve, capacity, true,
+        )? {
+            return Ok(Some(GpuLiveNoProgressReason::CheckpointPublicationPending));
+        }
+        let actual = self.validate_replay_epoch_residents()?;
+        let intent = self.deferred_replay_epoch.as_ref().expect("deferred intent retained");
+        if actual.len() != intent.neural_authority.len() {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        for (&raw, sealed) in &intent.neural_authority {
+            let handle = *intent.handles.get(&raw).ok_or(ScaffoldContractError::BrainOwnershipMismatch)?;
+            if actual.get(&raw).is_none() {
+                return Err(ScaffoldContractError::BrainOwnershipMismatch.into());
+            }
+            validate_sleep_journal_neural_authority(&mut self.backend, handle, sealed)?;
+        }
+        let journal = intent.journal.clone();
+        let world_signature = intent.world_signature;
+        self.admit_restored_durable_completed_recommit(journal)?;
+        if !self.active_sealed_replay_epoch() {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch.into());
+        }
+        let ExactPopulationCheckpointRuntimeWorkV1::AwaitingJournal { permit, .. } =
+            &self.exact_checkpoint_work else {
+                return Err(ScaffoldContractError::MissingPhaseData.into());
+            };
+        self.replay_epoch_execution_cut = Some(ReplayEpochExecutionCutV2 {
+            transaction_id: permit.transaction_id(),
+            source_tick: self.world.tick(),
+            world_signature,
+        });
+        self.deferred_replay_epoch = None;
+        Ok(None)
+    }
