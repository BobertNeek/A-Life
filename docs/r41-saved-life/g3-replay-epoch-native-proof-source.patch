+// In this narrow detached research lane the permanently authoritative living
+// roster is the saved biological registry, not the perceived world actor map.
+// An explicitly nonresident teacher, prey or prop is not another resident.
+fn require_single_living_replay_epoch_resident(
+    save: &PortableSaveFile,
+) -> Result<OrganismId, GameAppShellError> {
+    let failed = || GameAppShellError::ReplayEpochRequiresSingleLivingResident;
+    let records = save.world.organism_records.as_ref().ok_or_else(failed)?;
+    let [record] = records.as_slice() else { return Err(failed()); };
+    let [creature] = save.creatures.as_slice() else { return Err(failed()); };
+    let owner = record.organism_id();
+    if !record.lifecycle().is_alive()
+        || creature.organism_id != owner
+        || creature.gpu_brain.as_ref().is_none_or(|brain| brain.organism_id != owner)
+        || save.world.external_actor_ids.as_ref().is_some_and(|ids| ids.contains(&owner))
+    {
+        return Err(failed());
+    }
+    Ok(owner)
+}
