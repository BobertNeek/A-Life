+impl GpuReplayEpochSealV2 {
+    fn validate_shape(&self, generation: u64, predecessor: Option<[u64; 4]>)
+        -> Result<(), ScaffoldContractError>
+    {
+        let next = self.original_generation.checked_add(1)
+            .ok_or(ScaffoldContractError::ConsolidationGenerationMismatch)?;
+        if self.original_generation == 0 || self.capture_transaction == 0
+            || self.origin_population_digest == [0; 4]
+            || self.completions.len() != 1
+            || self.completions.windows(2).any(|r| r[0].organism_id.raw() >= r[1].organism_id.raw())
+            || (self.consumed_edges.is_none()
+                && (generation != self.original_generation || predecessor != self.origin_predecessor_digest))
+            || (self.consumed_edges.is_some() && generation < next)
+            || self.native_commit_digests.len() != self.consumed_edges.as_ref().map_or(0, Vec::len)
+            || self.native_commit_digests.contains(&[0; 4])
+        {
+            return Err(ScaffoldContractError::ConsolidationGenerationMismatch);
+        }
+        for item in &self.completions {
+            item.validate()?;
+        }
+        if let Some(edges) = &self.consumed_edges {
+            if edges.len() != self.completions.len() {
+                return Err(ScaffoldContractError::ConsolidationGenerationMismatch);
+            }
+            for (edge, item) in edges.iter().zip(&self.completions) {
+                edge.validate()?;
+                if edge.organism_id != item.organism_id || edge.source != item.completed
+                    || edge.transition_ordinal != 0
+                    || Some(edge.transition_tick.raw()) != item.tick.raw().checked_add(1)
+                    || !matches!(edge.target.consolidation, ConsolidationState::Committed { .. })
+                {
+                    return Err(ScaffoldContractError::ConsolidationGenerationMismatch);
+                }
+            }
+        }
