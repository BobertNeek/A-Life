+        Err(GpuRuntimeError::ConsumedReplayEpochRequiresFullCheckpoint { .. })));
+    assert!(durable.publish_replay_epoch_commit_profiled(&receipt_only, &journal, false, Vec::new()).is_err());
+
+    // Isolated copy of the fully authenticated genuine receipt stream; an
+    // empty legacy clear and a second fresh open still do not make it playable.
+    let receipt_fork = scratch.join("receipt-only-proof");
+    fs::create_dir(&receipt_fork).unwrap();
+    for entry in fs::read_dir(&scratch).unwrap() {
+        let entry = entry.unwrap();
+        if entry.file_type().unwrap().is_file() {
+            fs::copy(entry.path(), receipt_fork.join(entry.file_name())).unwrap();
+        }
+    }
+    let fork_current = receipt_fork.join(current.file_name().unwrap());
+    let (fork, pre_clear) = GpuDurableSaveManifest::open_loaded(&fork_current, &assets).unwrap();
+    assert_eq!(pre_clear, receipt_only);
+    let empty = alife_runtime::GpuSleepTransactionJournalV2::empty(&pre_clear).unwrap();
+    fork.publish_sleep_transaction_journal(&pre_clear, &empty).unwrap();
+    let (_, first_open) = GpuDurableSaveManifest::open_loaded(&fork_current, &assets).unwrap();
+    let (_, second_open) = GpuDurableSaveManifest::open_loaded(&fork_current, &assets).unwrap();
+    assert_eq!(first_open, second_open);
+    assert_eq!(second_open.authority_generation().unwrap(), receipt_only.authority_generation().unwrap() + 1);
+    assert_eq!(second_open.replay_epoch_status(), GpuReplayEpochStatusV2::Consumed);
+    assert_eq!(second_open.save, receipt_only.save);
+    assert_eq!(fork.load_sleep_transaction_journal(&second_open).unwrap(), empty);
+    assert!(matches!(second_open.require_playable_replay_epoch(),
+        Err(GpuRuntimeError::ConsumedReplayEpochRequiresFullCheckpoint { .. })));
+    assert!(fork.publish_sleep_transaction_journal(&second_open, &journal).is_err());
+
+    // Only the still-live truly committed runtime can supply this later complete
+    // native cut; a journal-only restart cannot manufacture it.
+    loop {
+        let current_sleep = live.sleep_state_for_test(owner).unwrap();
+        if current_sleep.phase == SleepPhase::Awake {
+            assert_eq!(current_sleep.last_consolidated_cycle_id, request.cycle_id);
+            assert_eq!(current_sleep.cycles_completed, 1);
+            break;
+        }
+        live.tick_outcome().unwrap();
+        wait_step(deadline);
+    }
+    live.request_exact_checkpoint_for_test().unwrap();
+    while !live.persistence_idle_for_shutdown_for_test() {
+        live.poll_persistence_for_shutdown_for_test().unwrap();
+        wait_step(deadline);
+    }
+    let full = durable.load().unwrap();
+    full.require_playable_replay_epoch().unwrap();
+    assert!(full.authority_generation() > receipt_only.authority_generation());
+    assert!(full.save.world.tick > receipt_only.save.world.tick);
+    assert!(durable.load_sleep_transaction_journal(&full).unwrap().entries.is_empty());
+    let frozen_neural = live.learning_state_for_test(owner).unwrap();
+    let frozen_weights = live.active_lifetime_weights_for_test(owner).unwrap();
+    let frozen_fast = live.active_fast_weights_for_test(owner).unwrap();
+    let frozen_sleep = live.sleep_state_for_test(owner).unwrap();
+    let frozen_memory = live.memory_sidecar_for_test(owner).unwrap().clone();
+    let frozen_world = live.world_snapshot().canonical_signature_digest().unwrap();
+    drop(live);
+    let launch = launch_config(&scratch, &assets, &current, &full, "fully-committed");
+    let mut resumed = GpuLiveBrainRuntime::from_p34_launch_with_backend(&launch, software_backend).unwrap();
+    assert_eq!(resumed.world_tick_for_test(), full.save.world.tick);
+    assert_eq!(resumed.world_snapshot().canonical_signature_digest().unwrap(), frozen_world);
+    assert_eq!(resumed.learning_state_for_test(owner).unwrap(), frozen_neural);
+    assert_eq!(resumed.active_lifetime_weights_for_test(owner).unwrap(), frozen_weights);
+    assert_eq!(resumed.active_fast_weights_for_test(owner).unwrap(), frozen_fast);
+    assert_eq!(resumed.sleep_state_for_test(owner).unwrap(), frozen_sleep);
+    // Avoid asserting metrics/caches that the memory contract does not
+    // persist; compare the serialized production bank/source state.
+    assert_eq!(resumed.memory_sidecar_for_test(owner).unwrap().bank(), frozen_memory.bank());
+    drop(resumed);
+    // Preserve receipt directory, even after success, for independent review.
+}
