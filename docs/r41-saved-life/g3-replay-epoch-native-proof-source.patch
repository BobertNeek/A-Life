+    ) -> Result<(), GameAppShellError> {
+        let resident = require_single_living_replay_epoch_resident(save)?;
+        if self.completions.len() != 1 || self.completions[0].organism_id != resident {
+            return Err(GameAppShellError::ReplayEpochRequiresSingleLivingResident);
+        }
+        let failed = || GameAppShellError::from(ScaffoldContractError::ConsolidationGenerationMismatch);
+        let mut staged = save.creatures.iter().filter_map(|c| {
+            let gpu = c.gpu_brain.as_ref()?;
+            matches!(gpu.sleep.consolidation, ConsolidationState::Completed { .. })
+                .then_some((c.organism_id, gpu.sleep))
+        }).collect::<Vec<_>>();
+        staged.sort_by_key(|item| item.0.raw());
+        if staged.len() != self.completions.len() {
+            return Err(failed());
+        }
+        for (item, actual) in self.completions.iter().zip(staged) {
+            if (item.organism_id, item.completed) != actual || item.tick != save.world.tick
+                || !save.world.organism_records.as_ref().is_some_and(|records| {
+                    records.iter().any(|r| r.organism_id() == item.organism_id && r.lifecycle().is_alive())
+                })
+            {
+                return Err(failed());
+            }
+        }
+        match &self.consumed_edges {
+            None if journal.entries.is_empty() => Ok(()),
+            Some(edges) => {
+                let actual = completed_promotion_edges(&journal.entries);
+                let next = self.original_generation.checked_add(1).ok_or_else(failed)?;
+                if (generation == next && actual.as_slice() != edges.as_slice())
+                    || actual.iter().any(|e| !edges.contains(e)) {
+                    return Err(failed());
+                }
+                Ok(())
+            }
+            None => Err(failed()),
+        }
+    }
+}
