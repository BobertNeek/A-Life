+    };
+    request.request_digest = request.recompute_request_digest().unwrap();
+    controller.apply_consolidation_driver_event(ConsolidationDriverEvent::Prepared { request }).unwrap();
+    let job_id = ConsolidationJobId::try_from_raw(9).unwrap();
+    controller.apply_consolidation_driver_event(ConsolidationDriverEvent::Submitted { request, job_id }).unwrap();
+    let submitted = controller.state();
+    let mut staged = ConsolidationStagedOutput {
+        job_id, output_generation: 2, output_weight_bank: 1, output_digest: [9; 4],
+        eligibility_reset_generation: 2, output_eligibility_bank: 1, eligibility_output_digest: [5; 4],
+        replay_journal_generation: 2, replay_journal_cursor: 0, replay_journal_event_count: 0,
+        replay_journal_output_digest: [6; 4], staging_digest: [0; 4],
+        promoted_fast_l1_bits: 1.0f32.to_bits(), replay_induced_fast_l1_bits: 0,
+    };
+    staged.staging_digest = staged.recompute_staging_digest(&request, 1, 1).unwrap();
+    controller.apply_consolidation_driver_event(ConsolidationDriverEvent::Completed { request, staged }).unwrap();
+    let completed = controller.state();
+    let proof = GpuReplayEpochCompletionV2::try_new(organism, cut, submitted, completed).unwrap();
+    assert!(GpuReplayEpochCompletionV2::try_new(organism, cut, completed, completed).is_err());
+
+
+    // This exact Completed shape is only a legacy save. A real device readback
+    // is a type requirement at the marked APIs, so plain storage cannot mint.
+    let (exact, _) = sleep_storage_fixture(&root, "epoch-storage-fixture", cut, Some(completed));
+    fs::write(&path, serde_json::to_vec_pretty(&exact).unwrap()).unwrap();
+    let (durable, initial) = GpuDurableSaveManifest::open_loaded(&path, &root).unwrap();
+    assert!(proof.matches_captured(organism, cut, resident_sleep(&initial)));
+    assert_eq!(initial.replay_epoch_status(), GpuReplayEpochStatusV2::Unknown);
+    let legacy_empty = GpuSleepTransactionJournalV2::empty(&initial).unwrap();
+    durable.publish_sleep_transaction_journal(&initial, &legacy_empty).unwrap();
+    let (_, false_g1) = GpuDurableSaveManifest::open_loaded(&path, &root).unwrap();
+    assert_eq!(false_g1.authority_generation(), Some(1));
+    assert_eq!(false_g1.save, exact);
+    assert_eq!(false_g1.replay_epoch_status(), GpuReplayEpochStatusV2::Unknown);
+    false_g1.require_playable_replay_epoch().unwrap();
+    assert_eq!(false_g1.require_single_living_replay_epoch_resident().unwrap(), organism);
+
+    // The exact admission code counts biological residents, not supervised
+    // actors. These alternate typed shapes never mutate the original pointer.
+    let mut multi = false_g1.clone();
+    multi.save.world = current_organism_save_roster("two-live", cut, Some(true)).world;
+    assert!(matches!(multi.require_single_living_replay_epoch_resident(),
+        Err(GpuRuntimeError::ReplayEpochRequiresSingleLivingResident)));
+    let mut none = false_g1.clone();
+    none.save.world.organism_records = Some(Vec::new());
+    assert!(matches!(none.require_single_living_replay_epoch_resident(),
+        Err(GpuRuntimeError::ReplayEpochRequiresSingleLivingResident)));
+    let mut external_only = false_g1.clone();
+    external_only.save.world = current_organism_save_roster("one-and-external", cut, Some(false)).world;
+    assert_eq!(external_only.save.world.external_actor_ids.as_deref(), Some(&[OrganismId(2)][..]));
+    assert_eq!(external_only.require_single_living_replay_epoch_resident().unwrap(), organism);
+    let mut owner_alias = external_only.clone();
+    owner_alias.save.world.external_actor_ids = Some(vec![organism]);
+    assert!(matches!(owner_alias.require_single_living_replay_epoch_resident(),
+        Err(GpuRuntimeError::ReplayEpochRequiresSingleLivingResident)));
+
+    controller.apply_consolidation_driver_event(ConsolidationDriverEvent::Committed {
+        cycle_id, output_generation: staged.output_generation, output_digest: staged.output_digest,
+    }).unwrap();
+    let edge = GpuSleepTransactionJournalEntryV2::try_new(
+        organism, Tick::new(13), completed, controller.state(),
+    ).unwrap();
+    let next = GpuSleepTransactionJournalV2::try_new(
+        legacy_empty.exact_base_manifest_digest.clone(), cut, vec![edge],
+    ).unwrap();
+    let original_pointer = fs::read(&path).unwrap();
+    assert!(durable.publish_replay_epoch_commit_profiled(&false_g1, &next, false, Vec::new()).is_err());
+    assert_eq!(fs::read(&path).unwrap(), original_pointer);
+    // Legacy playback's documented policy remains compatible, but even a
+    // complete legacy journal edge and its empty rewrite stay Unknown.
+    durable.publish_sleep_transaction_journal(&false_g1, &next).unwrap();
+    let g2 = durable.load().unwrap();
+    assert_eq!(g2.replay_epoch_status(), GpuReplayEpochStatusV2::Unknown);
+    durable.publish_sleep_transaction_journal(&g2, &legacy_empty).unwrap();
+    let g3 = durable.load().unwrap();
+    assert_eq!(g3.authority_generation(), Some(3));
+    assert_eq!(g3.replay_epoch_status(), GpuReplayEpochStatusV2::Unknown);
+    assert_eq!(g3.save, exact);
+    assert_eq!(durable.load_sleep_transaction_journal(&g3).unwrap(), legacy_empty);
+    fs::remove_dir_all(root).unwrap();
+}
+
+fn resident_sleep(base: &alife_runtime::GpuLoadedSaveManifest) -> alife_core::SleepState {
+    base.save.creatures[0].gpu_brain.as_ref().unwrap().sleep
+}
