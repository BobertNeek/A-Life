+#[test]
+#[ignore = "requires explicit detached writer lease and a qualified real Vulkan backend"]
+fn warm_epoch_consumes_once_then_normal_exact_save_reopens() {
+    check_playable_full_cut(false);
+}
+
+#[test]
+#[ignore = "requires explicit detached writer lease and a qualified real Vulkan backend"]
+fn restored_epoch_admits_on_first_ordinary_tick_then_normal_exact_save_reopens() {
+    check_playable_full_cut(true);
+}
