+#[cfg(test)]
+mod guard_tests {
+    use super::*;
+
+    const SUBJECT: (u64, u64) = (91, 700);
+    const EXTERNAL: u64 = 84;
+    const ACTOR: ActorBinding = (EXTERNAL, 595, WorldObjectKind::Agent);
+    const RESIDENT: ActorBinding = (SUBJECT.0, SUBJECT.1, WorldObjectKind::Agent);
+
+    fn admit(roles: &[(u64, u64)], externals: &[u64], saved: &[ActorBinding], restored: &[ActorBinding]) -> bool {
+        exact_same_life_bindings(SUBJECT, roles, externals, saved, restored)
+    }
+
+    #[test]
+    fn exact_owner_and_authenticated_external_are_admitted_regardless_of_order() {
+        assert!(admit(&[SUBJECT], &[], &[RESIDENT], &[RESIDENT]));
+        assert!(admit(&[SUBJECT], &[EXTERNAL], &[RESIDENT, ACTOR], &[ACTOR, RESIDENT]));
+    }
+
+    #[test]
+    fn missing_extra_reassigned_and_swapped_actor_pairs_are_refused() {
+        let saved = [RESIDENT, ACTOR];
+        let extra = (17, 285, WorldObjectKind::Agent);
+        let moved = (EXTERNAL, 199, WorldObjectKind::Agent);
+        for roster in [
+            vec![RESIDENT], vec![ACTOR], vec![RESIDENT, ACTOR, extra], vec![RESIDENT, moved],
+            vec![(SUBJECT.0, ACTOR.1, WorldObjectKind::Agent),
+                 (EXTERNAL, SUBJECT.1, WorldObjectKind::Agent)],
+        ] {
+            assert!(!admit(&[SUBJECT], &[EXTERNAL], &saved, &roster));
+        }
+    }
+
+    #[test]
+    fn aliased_bindings_and_missing_or_extra_external_authority_are_refused() {
+        let saved = [RESIDENT, ACTOR];
+        let alias_owner = (EXTERNAL, 596, WorldObjectKind::Agent);
+        let alias_entity = (EXTERNAL, SUBJECT.1, WorldObjectKind::Agent);
+        for alias in [
+            vec![RESIDENT, ACTOR, ACTOR],
+            vec![RESIDENT, ACTOR, alias_owner],
+            vec![RESIDENT, alias_entity],
+        ] {
+            assert!(!admit(&[SUBJECT], &[EXTERNAL], &saved, &alias));
+            assert!(!admit(&[SUBJECT], &[EXTERNAL], &alias, &alias));
+        }
+        for declared in [vec![], vec![EXTERNAL, EXTERNAL], vec![EXTERNAL, 17],
+                         vec![EXTERNAL, SUBJECT.0], vec![0, EXTERNAL]] {
+            assert!(!admit(&[SUBJECT], &declared, &saved, &saved));
+        }
+    }
+
+    #[test]
+    fn resident_external_role_changes_remaps_and_object_kind_changes_are_refused() {
+        let rows = [RESIDENT, ACTOR];
+        for roles in [
+            vec![],
+            vec![(EXTERNAL, ACTOR.1)],
+            vec![SUBJECT, (EXTERNAL, ACTOR.1)],
+            vec![(SUBJECT.0, ACTOR.1)],
+        ] {
+            assert!(!admit(&roles, &[EXTERNAL], &rows, &rows));
+        }
+        let changed_kind = (EXTERNAL, ACTOR.1, WorldObjectKind::Ball);
+        assert!(!admit(&[SUBJECT], &[EXTERNAL], &rows, &[RESIDENT, changed_kind]));
+        let malformed_role = [RESIDENT, changed_kind];
+        assert!(!admit(&[SUBJECT], &[EXTERNAL], &malformed_role, &malformed_role));
+    }
+}
