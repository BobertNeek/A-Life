+type ActorBinding = (u64, u64, WorldObjectKind);
+
+fn exact_actor_map(
+    rows: &[ActorBinding],
+) -> Option<BTreeMap<u64, (u64, WorldObjectKind)>> {
+    let mut owners = BTreeMap::new();
+    let mut entities = BTreeSet::new();
+    for &(owner, entity, kind) in rows {
+        if owner == 0 || entity == 0 || !entities.insert(entity)
+            || owners.insert(owner, (entity, kind)).is_some()
+        {
+            return None;
+        }
+    }
+    Some(owners)
+}
+
+// An external actor is a sealed world object, not a biological registry row.
+// Verify the two authorities separately, and never remove actors for hashing.
+fn exact_same_life_bindings(
+    saved_resident: (u64, u64),
+    restored_registry: &[(u64, u64)],
+    declared_externals: &[u64],
+    saved_actors: &[ActorBinding],
+    restored_actors: &[ActorBinding],
+) -> bool {
+    if restored_registry != [saved_resident] {
+        return false;
+    }
+    let Some(saved) = exact_actor_map(saved_actors) else {
+        return false;
+    };
+    let Some(restored) = exact_actor_map(restored_actors) else {
+        return false;
+    };
+    if saved != restored
+        || saved.get(&saved_resident.0) != Some(&(saved_resident.1, WorldObjectKind::Agent))
+    {
+        return false;
+    }
+    let mut sealed_agents = BTreeSet::from([saved_resident.0]);
+    if declared_externals.iter().any(|&id| id == 0 || !sealed_agents.insert(id)) {
+        return false;
+    }
+    let saved_agents = saved.iter().filter_map(|(&id, &(_, kind))| {
+        (kind == WorldObjectKind::Agent).then_some(id)
+    }).collect::<BTreeSet<_>>();
+    saved_agents == sealed_agents
+}
