+def cmd_close_native_fault(args: argparse.Namespace) -> dict[str, Any]:
+    if not all((args.native_fault, args.fault_archive, args.fault_readback,
+                args.fault_evidence_sha256, args.fault_readback_sha256)):
+        raise SurgeryLoopError("native fault closure requires all independent evidence/readback and archive arguments")
+    if not args.reason.strip():
+        raise SurgeryLoopError("closure must state why the failed run is being retired")
+    path = pathlib.Path(args.state).resolve()
+    with native_fault_lease(path) as check_lease, state_lock(path):
+        state = load_state(path)
+        target = [p for p in state["in_flight_patches"] if p["patch_id"] == args.patch_id
+                  and p["target_base_id"] == state["active_base_id"] and p["status"] == "unscored"]
+        if len(target) != 1:
+            raise SurgeryLoopError("native fault must target one exact active unscored patch")
+        fault = attest_native_fault(path, state, target[0], args)
+        check_lease()
+        # Authenticated closure is operational progress, not a comparison or recovery.
+        now = utc_now_iso()
+        target[0].update(status="closed", closed_at_utc=now,
+                         closure_reason=args.reason, native_fault_closure=fault)
+        state["last_candidate_closed_utc"] = now
+        write_json_atomic(path, state)
+        return target[0]
