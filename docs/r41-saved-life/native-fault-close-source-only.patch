+def private_fault_file(path: pathlib.Path) -> pathlib.Path:
+    info = path.lstat()
+    native_fault_assert(stat.S_ISREG(info.st_mode) and info.st_uid == os.getuid()
+                        and not info.st_mode & 0o077 and path.resolve() == path,
+                        f"not an owner-only regular file: {path.name}")
+    return path
+
