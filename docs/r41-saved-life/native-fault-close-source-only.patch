+@contextmanager
+def native_fault_lease(state_path: pathlib.Path) -> Iterator[Callable[[], None]]:
+    """Take the runner's existing single lane, before taking the state lock."""
+    if sys.platform != "linux":
+        raise SurgeryLoopError("native fault closure requires the hosted Linux lease")
+    import fcntl
+
+    guard = state_path.parent.parent / ".qualia-stock-U-A-exclusive.lock"
+    fd = os.open(guard, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        def check_identity() -> None:
+            a, b = os.fstat(fd), guard.lstat()
+            if ((a.st_dev, a.st_ino) != (b.st_dev, b.st_ino)
+                    or not stat.S_ISREG(a.st_mode) or stat.S_IMODE(a.st_mode) != 0o600
+                    or a.st_uid != os.getuid() or a.st_size != 0 or a.st_nlink != 1):
+                raise SurgeryLoopError("native runner lease identity is invalid")
+        check_identity()
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise SurgeryLoopError("native runner is still busy; no candidate closure") from exc
+        check_identity()
+        yield check_identity
+    finally:
+        os.close(fd)
+
+
+def native_fault_assert(condition: Any, detail: str) -> None:
+    if not condition:
+        raise SurgeryLoopError(f"native fault closure: {detail}")
+
