+//! Byte-only encoder shared by the real recorder and its no-device fixture.
+//! These arrays are filled only by already-proven native spans in the App.
+pub(super) const SECTION_WORDS: [usize; 6] = [77, 256, 2048, 2048, 2048, 4096];
+const METADATA_MAX: usize = 4096;
+const WORDS: usize = 77 + 256 + 3 * 2048 + 4096;
+
+pub(super) fn frame(metadata: &[u8], sections: [&[u32]; 6]) -> Option<Vec<u8>> {
+    if metadata.is_empty() || metadata.len() > METADATA_MAX
+        || sections.iter().map(|s| s.len()).ne(SECTION_WORDS)
+    {
+        return None;
+    }
+    let mut out = Vec::with_capacity(4 + metadata.len() + WORDS * 4);
+    out.extend_from_slice(&u32::try_from(metadata.len()).ok()?.to_le_bytes());
+    out.extend_from_slice(metadata);
+    for words in sections {
+        for word in words {
+            out.extend_from_slice(&word.to_le_bytes());
+        }
+    }
+    Some(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn actual_encoder_preserves_full_order_exact_bits_and_width() {
+        let m = b"{\"label\":\"artificial-wire-fixture-not-neural-data\"}";
+        let a: [Vec<u32>; 6] = std::array::from_fn(|i| {
+            let mut s = vec![0x1111_1111 * (i as u32 + 1); SECTION_WORDS[i]];
+            s[0] = 0x8000_0000; // negative zero bits must survive
+            s[1] = 0x7fc0_0001 + i as u32; // reject normalization of arbitrary raw bits
+            s
+        });
+        let b = frame(m, std::array::from_fn(|i| a[i].as_slice())).unwrap();
+        assert_eq!(b.len(), 4 + m.len() + WORDS * 4);
+        assert_eq!(&b[..4], &(m.len() as u32).to_le_bytes());
+        assert_eq!(&b[4..4 + m.len()], m);
+        let mut offset = 4 + m.len();
+        for section in &a {
+            for w in section {
+                assert_eq!(&b[offset..offset + 4], &w.to_le_bytes());
+                offset += 4;
+            }
+        }
+        assert_eq!(offset, b.len());
+    }
+
+    #[test]
+    fn actual_encoder_refuses_wrong_section_layout_or_metadata_bound() {
+        let a: [Vec<u32>; 6] = std::array::from_fn(|i| vec![0; SECTION_WORDS[i]]);
+        let mut exact: [&[u32]; 6] = std::array::from_fn(|i| a[i].as_slice());
+        assert!(frame(b"{}", exact).is_some());
+        assert!(frame(b"", exact).is_none());
+        assert!(frame(&[b' '; METADATA_MAX + 1], exact).is_none());
+        exact.swap(0, 1);
+        assert!(frame(b"{}", exact).is_none());
+        exact.swap(0, 1);
+        exact[2] = &exact[2][1..];
+        assert!(frame(b"{}", exact).is_none());
+    }
+}
