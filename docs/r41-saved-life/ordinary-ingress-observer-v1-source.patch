+        g.reference_parity_sha256 = Some("c".repeat(64));
+        assert!(checked_grant(&g, Mode::Capture, &scope, "run-a").is_err());
+        g.reference_acceptance_sha256 = Some("e".repeat(64));
+        assert!(checked_grant(&g, Mode::Capture, &scope, "run-a").is_err());
+        g.independent_verifier_sha256 = Some("c".repeat(64));
+        assert!(checked_grant(&g, Mode::Capture, &scope, "run-a").is_err());
+        g.independent_comparison_sha256 = Some("d".repeat(64));
+        assert!(checked_grant(&g, Mode::Capture, &scope, "run-a").is_ok());
+        assert!(checked_grant(&g, Mode::Capture, &"f".repeat(64), "run-a").is_err());
+        assert!(checked_grant(&g, Mode::Capture, &scope, "run-b").is_err());
+        g.scorecard_eligible = true;
+        assert!(checked_grant(&g, Mode::Capture, &scope, "run-a").is_err());
+    }
+}
