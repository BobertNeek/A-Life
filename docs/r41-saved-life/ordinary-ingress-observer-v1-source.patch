+//! Exact ordinary JSONL parity with one source-proven wall timing exclusion.
+//! Retained original rows are never rewritten. No floating-point is parsed
+//! and reserialized to form the comparison digest.
+use super::*;
+use serde::Deserialize;
+use std::{collections::BTreeSet, ops::Range};
+
+pub(super) const NORMALIZATION: &str = "ordinary-ingress-jsonl-fixed0-previous-gpu-ns-only.v1";
+pub(super) const MAX_ROW_BYTES: usize = 1024 * 1024;
+
+fn ws(b: u8) -> bool {
+    matches!(b, b' ' | b'\t' | b'\r' | b'\n')
+}
+fn trim(mut r: &[u8]) -> &[u8] {
+    while r.first().copied().is_some_and(ws) {
+        r = &r[1..];
+    }
+    r
+}
+fn take_json<'a, T: Deserialize<'a>>(r: &mut &'a [u8]) -> Result<T> {
+    *r = trim(r);
+    let raw = *r;
+    let mut stream = serde_json::Deserializer::from_slice(raw).into_iter::<T>();
+    let item = stream.next().ok_or("ordinary ingress missing JSON value")??;
+    let end = stream.byte_offset();
+    if end == 0 || end > raw.len() {
+        return Err("ordinary ingress invalid JSON token boundary".into());
+    }
+    *r = &raw[end..];
+    Ok(item)
+}
+
+fn object_members<'a, const N: usize>(raw: &'a [u8], keys: [&str; N]) -> Result<[&'a [u8]; N]> {
+    let mut remaining = trim(raw).strip_prefix(b"{").ok_or("ordinary ingress JSON object required")?;
+    let mut spans = [None; N];
+    let mut seen = BTreeSet::new();
+    loop {
+        let key: String = take_json(&mut remaining)?;
+        if !seen.insert(key.clone()) {
+            return Err("ordinary ingress duplicate native JSON member".into());
+        }
+        remaining = trim(trim(remaining).strip_prefix(b":").ok_or("ordinary ingress JSON colon missing")?);
+        let begin = remaining;
+        take_json::<serde::de::IgnoredAny>(&mut remaining)?;
+        if let Some(i) = keys.iter().position(|v| *v == key.as_str()) {
+            spans[i] = Some(&begin[..begin.len() - remaining.len()]);
+        }
+        remaining = trim(remaining);
+        if let Some(tail) = remaining.strip_prefix(b",") {
+            remaining = tail;
+        } else if let Some(tail) = remaining.strip_prefix(b"}") {
+            if !trim(tail).is_empty() { return Err("ordinary ingress trailing JSON data".into()); }
+            break;
+        } else {
+            return Err("ordinary ingress JSON member delimiter missing".into());
+        }
+    }
+    if spans.iter().any(Option::is_none) {
+        return Err("ordinary ingress required typed row fields missing".into());
+    }
+    // Each array element was checked above; no fallback to an empty span.
+    Ok(spans.map(|s| s.expect("all expected native fields found")))
+}
+
+/// Qualifies an original single-resident fixed-0 row and identifies the
+/// one lexical integer to replace for a comparison digest. All other raw
+/// characters (including shape, whitespace and original f64 lexemes) remain.
+/// Actual raw receipt/hashes retain this wall scalar too.
+fn timing_span(raw: &[u8], row_index: usize, actor: u64, tick: u64) -> Result<Range<usize>> {
+    if raw.len() > MAX_ROW_BYTES || !raw.ends_with(b"\n") {
+        return Err("ordinary ingress native JSONL line exceeds bound or is unterminated".into());
+    }
+    let [index,decision,organism,frame,policy] = object_members(raw, [
+        "row","decision_tick","organism","frame_digest","observer_host_pressure_control",
+    ])?;
+    let digest: [u64; 4] = serde_json::from_slice(frame)?;
+    if serde_json::from_slice::<usize>(index)? != row_index
+        || serde_json::from_slice::<u64>(decision)? != tick
+        || serde_json::from_slice::<u64>(organism)? != actor
+    { return Err("ordinary ingress raw row actor/cursor changed".into()); }
+
+    let [scope,fields,samples] = object_members(policy, ["scope","tuple_fields","samples"])?;
+    let [wall_field, applied_field]: [String; 2] = serde_json::from_slice(fields)?;
+    if serde_json::from_slice::<String>(scope)? != "controlled_host_pressure_not_fixed_neural_work"
+        || wall_field != "actual_previous_gpu_time_ns" || applied_field != "applied_throttle_decision"
+    { return Err("ordinary ingress typed fixed-0 pressure emission differs".into()); }
+
+    let sample_array = trim(samples).strip_prefix(b"[").ok_or("ordinary ingress pressure samples need array")?;
+    let mut tuple = trim(trim(sample_array).strip_prefix(b"[").ok_or("ordinary ingress pressure tuple missing")?);
+    let scalar = tuple;
+    let observed = take_json::<u64>(&mut tuple)?;
+    let integer = &scalar[..scalar.len() - tuple.len()];
+    if integer.is_empty() || integer.iter().any(|b| !b.is_ascii_digit())
+        || observed.to_string().as_bytes() != integer
+    { return Err("ordinary ingress wall scalar is not the exact unsigned integer wire".into()); }
+    tuple = trim(tuple).strip_prefix(b",").ok_or("ordinary ingress pressure tuple separator missing")?;
+    let actual: alife_core::NeuralThrottleDecision = take_json(&mut tuple)?;
+    let outer_tail = trim(tuple).strip_prefix(b"]").ok_or("ordinary ingress pressure tuple has extra fields")?;
+    let trailing = trim(outer_tail).strip_prefix(b"]").ok_or("ordinary ingress pressure row has another sample")?;
+    if !trim(trailing).is_empty()
+        || actual.organism_id_raw != actor || actual.tick != tick || actual.frame_digest != digest
+        || actual.pressure.completed_gpu_time_ns != 0 || actual.pressure.completed_gpu_time_bucket != 0
+        || actual.pressure.organism_id_raw != actor || actual.pressure.tick != tick
+        || actual.pressure.frame_digest != digest || actual.microsteps == 0
+    { return Err("ordinary ingress refuses to ignore time when real fixed-0 pressure/identity do not match".into()); }
+
+    // 'integer' borrows from nested slices of the exact original raw row.
+    let start = (integer.as_ptr() as usize).checked_sub(raw.as_ptr() as usize)
+        .ok_or("ordinary ingress lexical span precedes original bytes")?;
+    let end = start.checked_add(integer.len()).ok_or("ordinary ingress lexical span overflow")?;
+    if raw.get(start..end) != Some(integer) {
+        return Err("ordinary ingress lexical span is not the original field".into());
+    }
+    Ok(start..end)
+}
+
+pub(super) fn update(
+    h: &mut Sha256, row: &[u8], index: usize, owner: u64, tick: u64,
+) -> Result<()> {
+    let span = timing_span(row, index, owner, tick)?;
+    h.update(&row[..span.start]);
+    h.update(b"0"); // The only permitted wall-scalar comparison substitution.
+    h.update(&row[span.end..]);
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn top_level_scanner_rejects_escaped_alias_and_preserves_lexical_f64() {
+        let v = br#"{"setup":{"x":206.83912658691406},"field":["hy\\\"phen"]}"#;
+        let [setup] = object_members(v, ["setup"]).unwrap();
+        assert_eq!(setup, br#"{"x":206.83912658691406}"#);
+        assert!(object_members(br#"{"field":1,"f\u0069eld":2}"#, ["field"]).is_err());
+        assert!(object_members(br#"{"field":3,"other":0} false"#, ["field"]).is_err());
+    }
+
+    // Synthetic wire layout only; never live evidence.
+    fn row_for_parser(real_ns: u64, applied: u64, additional_native_outcome: u32) -> Vec<u8> {
+        let frame = [1, 2, 3, 4];
+        let p = serde_json::json!({
+            "brain_atp_bucket":1, "brain_atp_fraction_q16":76, "class_id_raw":3,
+            "completed_gpu_time_bucket":0, "completed_gpu_time_ns":applied,
+            "dispatch_generation":8, "frame_digest":frame, "handle_generation":2,
+            "handle_slot":0, "logical_heap_pressure_q16":2, "neural_heap_pressure_bucket":0,
+            "organism_id_raw":3, "policy_version":1, "queue_depth":0, "queue_depth_bucket":0,
+            "sample_digest":frame, "schema_version":1, "sequence_cursor":8,
+            "source_dispatch_generation":7, "source_frame_digest":frame, "tick":3074,
+        });
+        let decision = serde_json::json!({
+            "class_id_raw":3, "decision_digest":frame, "dispatch_generation":8,
+            "enabled_route_ids":[0], "frame_digest":frame, "handle_generation":2, "handle_slot":0,
+            "level":"Reduced", "microsteps":3, "organism_id_raw":3, "policy_digest":frame,
+            "policy_version":1, "pressure":p, "pressure_digest":frame, "route_schedule_digest":frame,
+            "schema_version":1, "sequence_cursor":8, "tick":3074,
+        });
+        let v = serde_json::json!({
+            "row":0, "organism":3, "decision_tick":3074, "frame_digest":frame,
+            "observer_host_pressure_control":{
+                "scope":"controlled_host_pressure_not_fixed_neural_work",
+                "tuple_fields":["actual_previous_gpu_time_ns","applied_throttle_decision"],
+                "samples":[[real_ns,decision]],
+            },
+            "full_outcome":additional_native_outcome,
+        });
+        let mut bytes = serde_json::to_vec(&v).unwrap();
+        bytes.push(b'\n');
+        bytes
+    }
+
+    #[test]
+    fn one_wall_scalar_only_ignores_value_where_actual_pressure_is_fixed_zero() {
+        let hash = |r: &[u8]| -> Result<String> {
+            let mut h = Sha256::new();
+            update(&mut h, r, 0, 3, 3074)?;
+            Ok(format!("{:x}", h.finalize()))
+        };
+        assert_eq!(hash(&row_for_parser(4, 0, 1)).unwrap(), hash(&row_for_parser(8192, 0, 1)).unwrap());
+        assert_ne!(hash(&row_for_parser(4, 0, 1)).unwrap(), hash(&row_for_parser(4, 0, 2)).unwrap());
+        assert!(hash(&row_for_parser(4, 1, 1)).is_err());
+    }
+
+    #[test]
+    fn absent_or_unterminated_controlled_evidence_refuses() {
+        assert!(timing_span(br#"{"row":0}"#, 0, 3, 3074).is_err());
+        assert!(timing_span(b"{\"row\":0}\n", 0, 3, 3074).is_err());
+    }
+}
