+        let measured = &r["ordinary_ingress_observation_v1"];
+        let evidence = ReferenceEvidence {
+            state_window_sha256: measured["state_window_sha256"].as_str().filter(|v| is_sha(v))
+                .ok_or("ordinary ingress Reference actual state window digest missing")?.to_owned(),
+            ordinary_action_evidence_sha256: normalized_rows_sha256.clone(),
+            exact_native_endpoint_sha256: h.final_checkpoint_sha256.clone(),
+            persisted_continuation: PersistedContinuation::deserialize(
+                &r["final_endpoint"]["ordinary_ingress_persisted_continuation_v1"])?,
+        };
+        if r["retained_experiment"]["identity"]["ordinary_ingress"]["raw_proc_environ_sha256"] != p.raw_proc_environ_sha256
+            || measured["raw_proc_environ_sha256"] != p.raw_proc_environ_sha256
+            || measured["ordinary_action_evidence_sha256"] != normalized_rows_sha256
+            || PersistedContinuation::deserialize(&measured["persisted_continuation"])? != evidence.persisted_continuation
+            || evidence.parity() != a.parity_sha256
+        {
+            return Err("ordinary ingress Reference original state/row/continuation joins differ".into());
+        }
+        Some(evidence)
+    } else { None };
+    rehash(&out.join("final.alife-checkpoint"), &h.final_checkpoint_sha256, NATIVE_CURRENT)?;
+    Ok(Observed {
+        process:p, release:f, exact_sampler_after:r["sampling_after"].clone(),
+        exact_hardware:r["hardware"].clone(), normalized_rows_sha256, reference_evidence,
+    })
+}
+
+pub(super) fn accept(e: Expected<'_>) -> Result<ReferenceEvidence> {
+    let a: Acceptance = json_leaf(e.acceptance_path, e.acceptance_sha256, SMALL)?;
+    if a.schema != SCHEMA || a.evaluator_sha256 != e.evaluator_sha256
+        || a.independent_verifier_sha256 != e.comparator_sha256
+        || a.independent_comparison_sha256 != e.comparison_sha256
+        || a.current_sha256 != e.current_sha256 || a.scope_sha256 != e.scope_sha256
+        || a.case_id != e.case_id || a.owner != e.owner || a.evaluation_nonce != e.evaluation_nonce
+        || a.window_start_tick != e.window_start_tick || a.parity_sha256 != e.parity_sha256
+        || a.compiled_sensor_profile != "GroundedTerrainVisionV1"
+        || !a.independently_accepted || a.scorecard_eligible
+        || [&a.opening_world_sha256,&a.initial_phenotype_sha256,&a.sampling_sha256,&a.native_setup_sha256]
+            .iter().any(|s| !is_sha(s))
+        || a.off.role != Role::DefaultOff || a.reference.role != Role::Reference
+        || a.off.run_id == a.reference.run_id || a.off.run_id == e.capture_run_id
+        || a.reference.run_id == e.capture_run_id || a.off.relative_room == a.reference.relative_room
+        || a.off.process_sha256 == a.reference.process_sha256 || a.off.release_sha256 == a.reference.release_sha256
+        || a.off.native_receipt_sha256 == a.reference.native_receipt_sha256
+        || a.off.authority_sha256 == a.reference.authority_sha256
+        || a.off.manifest_sha256 == a.reference.manifest_sha256
+        || a.off.final_checkpoint_sha256 != a.reference.final_checkpoint_sha256
+    {
+        return Err("ordinary ingress independent OFF/Reference closed pair scope or exact parity differs".into());
+    }
+    // The independently approved comparator bytes are a read-only provenance
+    // pin and are never invoked by this program.
+    let v = checked_path(e.root, "ordinary-ingress-independent-verifier.v1.source")?;
+    rehash(&v, e.comparator_sha256, VERIFIER_SOURCE)?;
+    let p = checked_path(e.root, "ordinary-ingress-off-reference-comparison.v3.json")?;
+    let c: Comparison = json_leaf(&p, e.comparison_sha256, SMALL)?;
+    if c.schema != "qualia.saved_life.ordinary_ingress_off_reference_comparison.v3"
+        || c.independent_verifier_sha256 != e.comparator_sha256 || c.evaluator_sha256 != e.evaluator_sha256
+        || c.scope_sha256 != e.scope_sha256 || c.current_sha256 != e.current_sha256
+        || c.native_setup_sha256 != a.native_setup_sha256 || c.reference_parity_sha256 != a.parity_sha256
+        || c.off_process_sha256 != a.off.process_sha256 || c.off_release_sha256 != a.off.release_sha256
+        || c.off_native_receipt_sha256 != a.off.native_receipt_sha256
+        || c.reference_process_sha256 != a.reference.process_sha256 || c.reference_release_sha256 != a.reference.release_sha256
+        || c.reference_native_receipt_sha256 != a.reference.native_receipt_sha256
+        || c.off_raw_rows_sha256 != a.off.rows_sha256 || c.reference_raw_rows_sha256 != a.reference.rows_sha256
+        || c.row_normalization != super::ordinary_ingress_row_parity::NORMALIZATION
+        || !is_sha(&c.normalized_ordinary_rows_sha256)
+        || c.byte_equal_final_checkpoint_sha256 != a.off.final_checkpoint_sha256
+        || !is_sha(&c.identical_actual_clean_environment_sha256)
+        || !is_sha(&c.identical_actual_raw_proc_environ_sha256)
+        || c.identical_actual_raw_proc_environ_sha256 != e.capture_raw_proc_environ_sha256
+        || c.off_original_portable_persisted_continuation != c.reference_original_portable_persisted_continuation
+        || c.scorecard_eligible
+    { return Err("ordinary ingress separate immutable OFF→Reference comparison differs".into()); }
+    let off = check_arm(e.root, &a, &a.off)?;
+    let reference = check_arm(e.root, &a, &a.reference)?;
+    let evidence = reference.reference_evidence
+        .ok_or("ordinary ingress genuine Reference joined evidence missing")?;
+    if evidence.persisted_continuation != c.reference_original_portable_persisted_continuation
+        || off.process.boot_id != reference.process.boot_id || off.process.fence_device != reference.process.fence_device
+        || off.process.fence_inode != reference.process.fence_inode || off.process.child == reference.process.child
+        || off.release.actual_shared_fence_released_utc >= reference.process.started_at_utc
+        || off.process.source_asset_sha256 != reference.process.source_asset_sha256
+        || off.process.clean_env_sha256 != reference.process.clean_env_sha256
+        || off.process.clean_env_sha256 != c.identical_actual_clean_environment_sha256
+        || off.process.raw_proc_environ_sha256 != reference.process.raw_proc_environ_sha256
+        || off.process.raw_proc_environ_sha256 != c.identical_actual_raw_proc_environ_sha256
+        || off.exact_sampler_after != reference.exact_sampler_after || off.exact_hardware != reference.exact_hardware
+        || off.normalized_rows_sha256 != c.normalized_ordinary_rows_sha256
+        || reference.normalized_rows_sha256 != c.normalized_ordinary_rows_sha256
+    { return Err("ordinary ingress predecessor processes are not a serial matched same-ELF pair".into()); }
+    Ok(evidence)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn actual_process_chronology_uses_fixed_utc_and_rejects_naive_or_fractionless() {
+        assert!(fixed_utc("2026-01-02T03:04:05.000006+00:00"));
+        assert!(!fixed_utc("2026-01-02T03:04:05Z"));
+        assert!(!fixed_utc("2026-01-02T03:04:05.000006-07:00"));
+        assert!(!fixed_utc("2026-01-02T03:04:05.00000a+00:00"));
+        assert!(id("reference-A_1"));
+        assert!(!id("../reference"));
+    }
+}
