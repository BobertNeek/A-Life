+fn check_arm(root: &Path, a: &Acceptance, h: &Arm) -> Result<Observed> {
+    if !id(&h.relative_room) || !id(&h.run_id) || [
+        &h.authority_sha256, &h.manifest_sha256, &h.started_sha256, &h.process_sha256,
+        &h.release_sha256, &h.native_receipt_sha256, &h.rows_sha256, &h.final_checkpoint_sha256,
