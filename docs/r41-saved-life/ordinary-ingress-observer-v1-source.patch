+#[cfg(feature = "retained-ordinary-ingress-observer-v1")]
+fn resolve_ordinary_ingress(root: &Path, bytes: &[u8]) -> Result<ResolvedExperiment> {
+    use super::ordinary_ingress_observer as observer;
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Envelope {
+        schema: u16,
+        settings: ManifestV1,
+        mode: observer::Mode,
+        window_start_tick: u64,
+        operator_grant_sha256: String,
+    }
+    if bytes.len() > MAX_SMALL_CONFIG_BYTES {
+        return Err("ordinary ingress typed manifest exceeds its small cap".into());
+    }
+    let e: Envelope = serde_json::from_slice(bytes)?;
+    let card = e.settings.card_case.as_deref()
+        .and_then(super::card_cases::case).ok_or("ordinary ingress needs a published stock case")?;
+    if e.schema != observer::MANIFEST_SCHEMA
+        || e.settings.schema != 1
+        || e.settings.scenario != ScenarioV1::PublishedCardCase
+        || !matches!(&e.settings.intervention, InterventionV1::Control {})
+        || !card.player_tokens.is_empty() || card.navigation.is_some()
+        || e.settings.max_decisions != 256 || e.settings.max_world_ticks != 256
+    {
+        return Err("ordinary ingress refuses changes to the original stand-alone cue-free stock 256/256".into());
+    }
+    let settings = serde_json::to_vec(&e.settings)?;
+    let mut resolved = resolve(&settings)?;
+    // Existing digest excludes run labels and wall deadlines. Add the true
+    // evaluation nonce because both stock processes must preserve it exactly.
+    let scope_sha256 = digest(&serde_json::to_vec(&(
+        observer::PURPOSE, &resolved.identity.semantic_settings_sha256,
+        e.settings.evaluation_nonce, e.window_start_tick,
+    ))?);
+    let g = canonical_inside(root, &root.join("ordinary-ingress-operator-grant.v1.json"))?;
+    let predecessor = if e.mode == observer::Mode::Capture {
+        Some(canonical_inside(root, &root.join("ordinary-ingress-reference-accepted.v4.json"))?)
+    } else { None };
+    let context = observer::OpenInputs {
+        root, grant_path: &g, independent_acceptance: predecessor.as_deref(),
+        run_id: &e.settings.run_id, current_sha256: &e.settings.source_current_sha256,
+        case_id: e.settings.card_case.as_deref().ok_or("ordinary ingress missing real case")?,
+        owner: e.settings.owner, evaluation_nonce: e.settings.evaluation_nonce,
+        window_start_tick: e.window_start_tick,
+    };
+    let scope = observer::grant(context, scope_sha256, e.operator_grant_sha256, e.mode)?;
+    resolved.identity.schema = observer::MANIFEST_SCHEMA;
+    resolved.identity.manifest_sha256 = digest(bytes);
+    resolved.identity.ordinary_ingress = Some(scope);
