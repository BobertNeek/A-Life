+        || f.root_ticket_sha256 != h.authority_sha256 || f.process_sha256 != h.process_sha256
+        || p.manifest_sha256 != h.manifest_sha256 || start.manifest_sha256 != h.manifest_sha256
+        || start.evaluator_sha256 != a.evaluator_sha256 || p.genuine_executable_sha256 != a.evaluator_sha256
+        || start.source_current_sha256 != a.current_sha256 || p.source_current_sha256 != a.current_sha256
+        || p.world_sha256 != a.opening_world_sha256 || p.boot_id.is_empty()
+        || start.boot_id != p.boot_id || f.boot_id != p.boot_id
+        || start.fence_device != p.fence_device || f.fence_device != p.fence_device
+        || start.fence_inode != p.fence_inode || f.fence_inode != p.fence_inode || p.fence_inode == 0
