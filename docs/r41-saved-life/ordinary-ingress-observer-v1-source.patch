+fn private_file(path: &Path, cap: u64) -> Result<(fs::File, u64)> {
+    if path.canonicalize()? != path {
+        return Err("ordinary ingress predecessor file is redirected".into());
+    }
+    let f = fs::File::open(path)?;
+    let meta = f.metadata()?;
+    if !meta.is_file() || meta.len() == 0 || meta.len() > cap {
+        return Err("ordinary ingress predecessor bytes outside policy".into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if meta.permissions().mode() & 0o077 != 0 {
+            return Err("ordinary ingress predecessor file is not owner-only".into());
+        }
+    }
+    Ok((f, meta.len()))
+}
+fn json_leaf<T: serde::de::DeserializeOwned>(path: &Path, sha: &str, cap: u64) -> Result<T> {
+    let (f, raw_len) = private_file(path, cap)?;
+    let mut bytes = Vec::new();
+    f.take(cap + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 != raw_len || digest(&bytes) != sha {
+        return Err("ordinary ingress predecessor metadata hash changed".into());
+    }
+    Ok(serde_json::from_slice(&bytes)?)
+}
+fn rehash(path: &Path, expected: &str, cap: u64) -> Result<()> {
+    let (mut f, length) = private_file(path, cap)?;
+    let mut h = Sha256::new();
+    let mut b = [0u8; 64 * 1024];
+    let mut n = 0;
+    loop {
+        let k = f.read(&mut b)?;
+        if k == 0 { break; }
+        n += k as u64;
+        if n > length { return Err("ordinary ingress predecessor grew".into()); }
+        h.update(&b[..k]);
+    }
+    if n != length || format!("{:x}", h.finalize()) != expected {
+        return Err("ordinary ingress real predecessor leaf digest differs".into());
+    }
+    Ok(())
+}
+fn closed_rows(path: &Path, raw_expected: &str, a: &Acceptance) -> Result<String> {
+    use super::ordinary_ingress_row_parity as parity;
+    let (file, length) = private_file(path, NATIVE_ROWS)?;
+    let mut reader = BufReader::with_capacity(64 * 1024, file);
+    let mut raw = Sha256::new();
+    let mut normalized = Sha256::new();
+    let mut line = Vec::new();
+    let mut n = 0u64;
+    for index in 0..256 {
+        line.clear();
+        let read = (&mut reader).take(parity::MAX_ROW_BYTES as u64 + 1)
+            .read_until(b'\n', &mut line)?;
+        n = n.checked_add(read as u64).ok_or("ordinary ingress raw rows length overflow")?;
+        if n > length { return Err("ordinary ingress raw row file grew".into()); }
+        raw.update(&line);
+        let tick = a.window_start_tick.checked_add(index as u64).ok_or("ordinary ingress tick overflow")?;
+        parity::update(&mut normalized, &line, index, a.owner, tick)?;
+    }
+    if !reader.fill_buf()?.is_empty() || n != length || format!("{:x}", raw.finalize()) != raw_expected {
+        return Err("ordinary ingress real original rows SHA/length/cut count differs".into());
+    }
+    Ok(format!("{:x}", normalized.finalize()))
+}
