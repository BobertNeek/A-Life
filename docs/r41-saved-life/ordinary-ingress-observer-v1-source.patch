+fn checked_path(root: &Path, name: &str) -> Result<PathBuf> {
+    let p = root.join(name);
+    // Reject redirecting paths; case rooms are independent single components
+    // and every file name used here is fixed by this source.
+    if p.canonicalize()? != p { return Err("ordinary ingress provenance path redirected".into()); }
+    Ok(p)
+}
