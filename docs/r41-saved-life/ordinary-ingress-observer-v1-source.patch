+//! Private serialization of already-captured stock inference boundaries.
+//! This module does not call World perception, the backend, or another readback.
+use super::*;
+use alife_gpu_backend::{
+    GpuPerceptionUpload, training_rollout::GpuTrainingStateSnapshot as Snapshot,
+};
+use serde::{Deserialize, Serialize};
+use std::{io::Read, ops::Range};
+
+/// Detached registry reservation; a merged successor must check its namespace.
+pub(super) const MANIFEST_SCHEMA: u16 = 81;
+pub(super) const MAX_BYTES: usize = 512 * 1024;
+const GRANT_LIMIT: usize = 16 * 1024;
+const WINDOW_CUTS: usize = 8;
+const NEURONS: usize = 2048;
+const NAME: &str = "ordinary-ingress-observation.v1.bin";
+const MAGIC: &[u8] = b"ALIFE-INGRESS-OBSERVATION-1\n";
+pub(super) const PURPOSE: &str = "qualia.saved_life.ordinary_ingress_operator_grant.v4";
+
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Mode {
+    Reference,
+    Capture,
+}
+
+#[derive(Debug, Clone, Serialize)]
+pub(super) struct Scope {
+    pub mode: Mode,
+    pub window_start_tick: u64,
+    pub scope_sha256: String,
+    pub evaluator_sha256: String,
+    pub grant_sha256: String,
+    pub raw_proc_environ_sha256: String,
+    pub reference_parity_sha256: Option<String>,
+    pub reference_acceptance_sha256: Option<String>,
+    pub independent_verifier_sha256: Option<String>,
+    pub independent_comparison_sha256: Option<String>,
+    pub scorecard_eligible: bool,
+    #[serde(skip)]
+    reference: Option<ReferenceEvidence>,
+}
+
+/// This is a real restore input and its original integrity seal, not a
+/// comparator exclusion or a field used by the current observation.
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct PersistedContinuation {
+    pub next_completed_gpu_time_ns: u64,
+    pub throttle_sequence_digest: [u64; 4],
+}
+
+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub(super) struct ReferenceEvidence {
+    pub state_window_sha256: String,
+    pub ordinary_action_evidence_sha256: String,
+    pub exact_native_endpoint_sha256: String,
+    pub persisted_continuation: PersistedContinuation,
+}
+
+impl ReferenceEvidence {
+    pub(super) fn parity(&self) -> String {
+        let t = self.persisted_continuation;
+        // Fixed-width digests, decimal typed integers and explicit separators.
+        let [a,b,c,d] = t.throttle_sequence_digest;
+        digest(format!("ordinary-ingress-parity-v3\n{}\n{}\n{}\n{}\n{a},{b},{c},{d}\n",
+            self.state_window_sha256, self.ordinary_action_evidence_sha256,
+            self.exact_native_endpoint_sha256, t.next_completed_gpu_time_ns).as_bytes())
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Grant {
+    schema: String,
+    run_id: String,
+    scope_sha256: String,
+    evaluator_sha256: String,
+    expected_raw_exec_environment_sha256: String,
+    mode: Mode,
+    reference_parity_sha256: Option<String>,
+    reference_acceptance_sha256: Option<String>,
+    independent_verifier_sha256: Option<String>,
+    independent_comparison_sha256: Option<String>,
+    scorecard_eligible: bool,
+}
+
+fn is_sha(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|ch| ch.is_ascii_digit() || (b'a'..=b'f').contains(&ch))
+}
+
+#[cfg(target_os = "linux")]
+fn actual_executable_digest() -> Result<String> {
+    // Hash the running kernel inode, not a subsequently swapped pathname.
+    bounded_executable_digest(Path::new("/proc/self/exe"))
+}
+
+#[cfg(not(target_os = "linux"))]
+fn actual_executable_digest() -> Result<String> {
+    Err("ordinary ingress is limited to the verified owner-private Linux recorder".into())
+}
+
+#[cfg(target_os = "linux")]
+fn bounded_executable_digest(path: &Path) -> Result<String> {
+    let mut f = fs::File::open(path)?;
+    let meta = f.metadata()?;
+    let len = meta.len();
+    if !meta.is_file() || len == 0 || len > 128 * 1024 * 1024 {
+        return Err("ordinary ingress evaluator digest source exceeds bounds".into());
+    }
+    let mut b = [0u8; 65_536];
+    let mut sha = Sha256::new();
+    let mut observed = 0u64;
+    loop {
+        let n = f.read(&mut b)?;
+        if n == 0 {
+            break;
+        }
+        observed += n as u64;
+        if observed > len {
+            return Err("ordinary ingress evaluator grew during digest".into());
+        }
+        sha.update(&b[..n]);
+    }
+    if observed != len {
+        return Err("ordinary ingress evaluator length changed".into());
+    }
+    Ok(format!("{:x}", sha.finalize()))
+}
+
+#[cfg(target_os = "linux")]
+fn actual_raw_exec_environment_digest() -> Result<String> {
+    let cap = 16 * 1024;
+    let mut b = Vec::new();
+    fs::File::open("/proc/self/environ")?.take((cap + 1) as u64).read_to_end(&mut b)?;
+    if b.is_empty() || b.len() > cap || b.last() != Some(&0) {
+        return Err("ordinary ingress bounded raw executing environment unavailable".into());
+    }
+    let mut names = std::collections::BTreeSet::new();
+    for item in b[..b.len() - 1].split(|v| *v == 0) {
+        let Some(eq) = item.iter().position(|v| *v == b'=') else {
+            return Err("ordinary ingress raw executing environment malformed".into());
+        };
+        if eq == 0 || !names.insert(&item[..eq]) {
+            return Err("ordinary ingress raw executing environment name repeated/empty".into());
+        }
+    }
+    Ok(digest(&b))
+}
+
+#[cfg(not(target_os = "linux"))]
+fn actual_raw_exec_environment_digest() -> Result<String> {
+    Err("ordinary ingress requires the actual Linux process environment".into())
+}
+
+fn read_bounded_private(path: &Path, limit: usize) -> Result<Vec<u8>> {
+    let f = fs::File::open(path)?;
+    let meta = f.metadata()?;
+    if !meta.is_file() || meta.len() == 0 || meta.len() > limit as u64 {
+        return Err("ordinary ingress authority must be a bounded regular file".into());
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if meta.permissions().mode() & 0o077 != 0 {
+            return Err("ordinary ingress authority must be owner-only".into());
+        }
+    }
+    let mut b = Vec::new();
+    f.take((limit + 1) as u64).read_to_end(&mut b)?;
+    if b.len() > limit || b.len() as u64 != meta.len() {
+        return Err("ordinary ingress authority file changed while reading".into());
+    }
+    Ok(b)
+}
+
+fn checked_grant(g: &Grant, mode: Mode, scope: &str, run_id: &str) -> Result<()> {
+    let phase_ok = match mode {
+        Mode::Reference => g.reference_parity_sha256.is_none()
+            && g.reference_acceptance_sha256.is_none()
+            && g.independent_verifier_sha256.is_none() && g.independent_comparison_sha256.is_none(),
+        Mode::Capture => g.reference_parity_sha256.as_deref().is_some_and(is_sha)
+            && g.reference_acceptance_sha256.as_deref().is_some_and(is_sha)
+            && g.independent_verifier_sha256.as_deref().is_some_and(is_sha)
+            && g.independent_comparison_sha256.as_deref().is_some_and(is_sha),
+    };
+    if g.schema != PURPOSE || !is_sha(&g.evaluator_sha256)
+        || !is_sha(&g.expected_raw_exec_environment_sha256) || g.mode != mode
+        || g.scope_sha256 != scope || g.run_id != run_id || g.scorecard_eligible || !phase_ok
+    {
+        return Err("ordinary ingress independent grant scope/phase refused".into());
+    }
+    Ok(())
+}
+
+pub(super) struct OpenInputs<'a> {
+    pub root: &'a Path,
+    pub grant_path: &'a Path,
+    pub independent_acceptance: Option<&'a Path>,
+    pub run_id: &'a str,
+    pub current_sha256: &'a str,
+    pub case_id: &'a str,
+    pub owner: u64,
+    pub evaluation_nonce: u64,
+    pub window_start_tick: u64,
+}
+
+pub(super) fn grant(
+    inputs: OpenInputs<'_>,
+    scope_sha256: String,
+    grant_sha256: String,
+    mode: Mode,
+) -> Result<Scope> {
+    let OpenInputs { root, grant_path, independent_acceptance, run_id, current_sha256,
+        case_id, owner, evaluation_nonce, window_start_tick } = inputs;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        if fs::metadata(root)?.permissions().mode() & 0o077 != 0 {
+            return Err("ordinary ingress requires an owner-private admission root".into());
+        }
+    }
+    if window_start_tick == 0 || window_start_tick.checked_add(256).is_none()
+        || !is_sha(&scope_sha256) || !is_sha(&grant_sha256)
+    {
+        return Err("ordinary ingress window or grant hash refused".into());
+    }
+    let b = read_bounded_private(grant_path, GRANT_LIMIT)?;
+    if digest(&b) != grant_sha256 {
+        return Err("ordinary ingress grant file digest changed".into());
+    }
+    let g: Grant = serde_json::from_slice(&b)?;
+    checked_grant(&g, mode, &scope_sha256, run_id)?;
+    if actual_executable_digest()? != g.evaluator_sha256 {
+        return Err("ordinary ingress recorder requires the exact qualified evaluator".into());
+    }
+    let raw_proc_environ_sha256 = actual_raw_exec_environment_digest()?;
+    if raw_proc_environ_sha256 != g.expected_raw_exec_environment_sha256 {
+        return Err("ordinary ingress actual raw executing environment differs from the private grant".into());
+    }
+    let reference = match (mode, independent_acceptance) {
+        (Mode::Reference, None) => None,
+        (Mode::Capture, Some(p)) => {
+            use super::ordinary_ingress_predecessor as predecessor;
+            Some(predecessor::accept(predecessor::Expected {
+                root, acceptance_path: p, acceptance_sha256: g.reference_acceptance_sha256.as_deref()
+                    .ok_or("ordinary ingress reference acceptance missing")?,
+                comparator_sha256: g.independent_verifier_sha256.as_deref()
+                    .ok_or("ordinary ingress comparator missing")?,
+                comparison_sha256: g.independent_comparison_sha256.as_deref()
+                    .ok_or("ordinary ingress comparison missing")?,
+                evaluator_sha256: &g.evaluator_sha256, parity_sha256: g.reference_parity_sha256.as_deref()
+                    .ok_or("ordinary ingress reference parity missing")?,
+                current_sha256, scope_sha256: &scope_sha256, case_id, capture_run_id: run_id,
+                capture_raw_proc_environ_sha256: &raw_proc_environ_sha256,
+                owner, evaluation_nonce, window_start_tick,
+            })?)
+        }
+        _ => return Err("ordinary ingress reference role differs".into()),
+    };
+    Ok(Scope {
+        mode,
+        window_start_tick,
+        scope_sha256,
+        evaluator_sha256: g.evaluator_sha256,
+        grant_sha256,
+        raw_proc_environ_sha256,
+        reference_parity_sha256: g.reference_parity_sha256,
+        reference_acceptance_sha256: g.reference_acceptance_sha256,
+        independent_verifier_sha256: g.independent_verifier_sha256,
+        independent_comparison_sha256: g.independent_comparison_sha256,
+        scorecard_eligible: false,
+        reference,
+    })
+}
+
+pub(super) fn validate_live_scope(scope: &Scope, source_tick: u64) -> Result<()> {
+    if source_tick != scope.window_start_tick {
+        return Err("ordinary ingress recorder requires the unchanged saved opening".into());
+    }
+    Ok(())
+}
+
+/// Case and sample counter are joined after the ordinary stage, never fed into it.
+pub(super) struct Observer<'a> {
+    scope: &'a Scope,
+    next_tick: u64,
+    frames: usize,
+    actions_seen: usize,
+    state: Sha256,
+    actions: Sha256,
+    bytes: Vec<u8>,
+    fault: Option<&'static str>,
+}
+
+impl<'a> Observer<'a> {
+    pub(super) fn new(scope: &'a Scope) -> Self {
+        Self {
+            scope,
+            next_tick: scope.window_start_tick,
+            frames: 0,
+            actions_seen: 0,
+            state: Sha256::new(),
+            actions: Sha256::new(),
+            bytes: if scope.mode == Mode::Capture { MAGIC.to_vec() } else { Vec::new() },
+            fault: None,
+        }
+    }
+
+    /// Capture failures invalidate only this observation, not an ordinary native row.
+    pub(super) fn observe(&mut self, step: &crate::FoundationTrainingStep, emitted_row_bytes: &[u8]) {
+        if self.fault.is_some() {
+            return;
+        }
+        if self.observe_checked(step, emitted_row_bytes).is_err() {
+            self.fault = Some("already-captured frame, state, parity or byte bound invalid");
+        }
+    }
+
+    fn observe_checked(
+        &mut self,
+        step: &crate::FoundationTrainingStep,
+        emitted_row_bytes: &[u8],
+    ) -> Result<()> {
+        let tick = step.frame.tick().raw();
+        let offset = u64::try_from(self.actions_seen)?;
+        if self.scope.window_start_tick.checked_add(offset) != Some(tick) || offset >= 256 {
+            return Err("ordinary ingress requires sequential native rows".into());
+        }
+
+        // Consume the complete bytes that will be written, never a
+        // float-roundtripped reconstruction. Only the separately logged
+        // previous actual GPU stopwatch is excluded by the typed comparator.
+        super::ordinary_ingress_row_parity::update(
+            &mut self.actions, emitted_row_bytes, self.actions_seen, step.frame.organism_id().raw(), tick,
+        )?;
+        self.actions_seen += 1;
+
+        if self.frames == WINDOW_CUTS {
+            return Ok(());
+        }
+        if tick != self.next_tick {
+            return Err("ordinary ingress missing actual observed tick".into());
+        }
+        let capture = capture(step)?;
+        let len = u32::try_from(capture.len())?.to_le_bytes();
+        self.state.update(len);
+        self.state.update(&capture);
+        if self.scope.mode == Mode::Capture {
+            let next = self.bytes.len().checked_add(len.len()).and_then(|v| v.checked_add(capture.len()))
+                .ok_or("ordinary ingress sidecar size overflow")?;
+            if next > MAX_BYTES {
+                return Err("ordinary ingress sidecar byte bound exceeded".into());
+            }
+            self.bytes.extend_from_slice(&len);
+            self.bytes.extend_from_slice(&capture);
+        }
+        self.frames += 1;
+        self.next_tick = self.next_tick.checked_add(1).ok_or("ordinary ingress tick overflow")?;
+        Ok(())
+    }
+
+    pub(super) fn finish(
+        self,
+        output: &Path,
+        ordinary_integrity: bool,
+        final_endpoint: &serde_json::Value,
+    ) -> serde_json::Value {
+        let fail = |reason| serde_json::json!({
+            "version":1, "accepted":false, "reason":reason, "scorecard_eligible":false,
+        });
+        if let Some(reason) = self.fault {
+            return fail(reason);
+        }
+        let Some(endpoint) = final_endpoint["sha256"].as_str().filter(|s| is_sha(s)) else {
+            return fail("missing exact native living endpoint");
+        };
+        let Ok(persisted_continuation) = PersistedContinuation::deserialize(
+            &final_endpoint["ordinary_ingress_persisted_continuation_v1"],
+        ) else {
+            return fail("missing typed authentic persisted continuation witness");
+        };
+        if !ordinary_integrity || self.frames != WINDOW_CUTS || self.actions_seen != 256 {
+            return fail("ordinary native retention or eight-cut coverage incomplete");
+        }
+        let state = format!("{:x}", self.state.finalize());
+        let actions = format!("{:x}", self.actions.finalize());
+        let evidence = ReferenceEvidence {
+            state_window_sha256: state,
+            ordinary_action_evidence_sha256: actions,
+            exact_native_endpoint_sha256: endpoint.to_owned(),
+            persisted_continuation,
+        };
+        let parity = evidence.parity();
+        let mut out = serde_json::json!({
+            "version":1, "accepted":true, "mode":self.scope.mode, "scorecard_eligible":false,
+            "scope_sha256":self.scope.scope_sha256, "grant_sha256":self.scope.grant_sha256,
+            "evaluator_sha256":self.scope.evaluator_sha256,
+            "raw_proc_environ_sha256":self.scope.raw_proc_environ_sha256,
+            "recorded_decisions":self.frames,
+            "ordinary_decisions":self.actions_seen, "window_start_tick":self.scope.window_start_tick,
+            "sensor_profile":"GroundedTerrainVisionV1",
+            "exact_native_endpoint_sha256":endpoint, "state_window_sha256":evidence.state_window_sha256,
+            "ordinary_action_evidence_sha256":evidence.ordinary_action_evidence_sha256, "parity_sha256":parity,
+            "persisted_continuation":evidence.persisted_continuation,
+            "row_normalization":super::ordinary_ingress_row_parity::NORMALIZATION,
+        });
+        if self.scope.mode == Mode::Reference {
+            return out;
+        }
+        let Some(reference) = self.scope.reference.as_ref() else {
+            return fail("missing exact independently joined reference");
+        };
+        if self.scope.reference_parity_sha256.as_deref() != Some(parity.as_str())
+            || reference != &evidence
+        {
+            // Keep factually separate diagnostics, never emit the hidden
+            // sidecar on a row/state OR original portable endpoint mismatch.
+            out["accepted"] = serde_json::json!(false);
+            out["reason"] = serde_json::json!("exact state/action/portable continuation differs");
+            out["reference_evidence"] = serde_json::json!(reference);
+            out["exact_component_matches"] = serde_json::json!({
+                "state_window":reference.state_window_sha256 == evidence.state_window_sha256,
+                "ordinary_rows":reference.ordinary_action_evidence_sha256 == evidence.ordinary_action_evidence_sha256,
+                "original_portable_endpoint":reference.exact_native_endpoint_sha256 == evidence.exact_native_endpoint_sha256,
+                "persisted_elapsed_input":reference.persisted_continuation.next_completed_gpu_time_ns
+                    == evidence.persisted_continuation.next_completed_gpu_time_ns,
+                "persisted_throttle_seal":reference.persisted_continuation.throttle_sequence_digest
+                    == evidence.persisted_continuation.throttle_sequence_digest,
+            });
+            return out;
+        }
+        let path = output.join(NAME);
+        if publish_sidecar(&path, &self.bytes).is_err() {
+            return fail("private sidecar publication did not close");
+        }
+        out["reference_acceptance_sha256"] = serde_json::json!(self.scope.reference_acceptance_sha256.as_deref());
+        out["independent_verifier_sha256"] = serde_json::json!(self.scope.independent_verifier_sha256.as_deref());
+        out["independent_comparison_sha256"] = serde_json::json!(self.scope.independent_comparison_sha256.as_deref());
+        out["private_sidecar_file"] = serde_json::json!(NAME);
+        out["private_sidecar_sha256"] = serde_json::json!(digest(&self.bytes));
+        out["private_sidecar_bytes"] = serde_json::json!(self.bytes.len());
+        out
+    }
+}
+
+fn publish_sidecar(path: &Path, bytes: &[u8]) -> Result<()> {
+    if bytes.len() > MAX_BYTES || !bytes.starts_with(MAGIC) {
+        return Err("ordinary ingress sidecar bytes outside schema".into());
+    }
+    let mut opts = fs::OpenOptions::new();
+    opts.create_new(true).write(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        opts.mode(0o600);
+    }
+    let f = opts.open(path)?;
+    let sync = f.try_clone()?;
+    let mut writer = alife_storage::writer(path, f)?;
+    writer.write_all(bytes)?;
+    writer.flush()?;
+    sync.sync_all()?;
+    drop(writer);
+    // Preserve any incomplete path on failure but never mark it accepted.
+    let mut saved = Vec::new();
+    fs::File::open(path)?.take((MAX_BYTES + 1) as u64).read_to_end(&mut saved)?;
+    if saved != bytes {
+        return Err("ordinary ingress sidecar readback differs".into());
+    }
+    Ok(())
+}
+
+fn checked_range(words: &[u32], base: u32, span: Range<u32>, length: usize) -> Result<&[u32]> {
+    let start = span.start.checked_sub(base).ok_or("ordinary ingress range before slot")? as usize;
+    let end = span.end.checked_sub(base).ok_or("ordinary ingress end before slot")? as usize;
+    if end.checked_sub(start) != Some(length) {
+        return Err("ordinary ingress unexpected word count".into());
+    }
+    words.get(start..end).ok_or_else(|| "ordinary ingress range beyond captured words".into())
+}
+
+fn captured_words(s: &Snapshot, span: Range<u32>, length: usize) -> Result<&[u32]> {
+    checked_range(&s.mutable_words, s.mutable_word_base, span, length)
+}
+
+fn active(s: &Snapshot) -> Result<&[u32]> {
+    let r = s.brain_slot.word_ranges();
+    let span = match s.active_activation_side {
+        0 => r.activation_a_words.clone(),
+        1 => r.activation_b_words.clone(),
+        _ => return Err("ordinary ingress activation side invalid".into()),
+    };
+    captured_words(s, span, NEURONS)
+}
+
+fn digest_words(words: &[u32]) -> String {
+    let mut h = Sha256::new();
+    for w in words {
+        h.update(w.to_le_bytes());
+    }
+    format!("{:x}", h.finalize())
+}
+
+fn active_weights(s: &Snapshot) -> Result<(usize, String, String)> {
+    let r = s.brain_slot.word_ranges();
+    let (f, l) = match s.active_weight_bank {
+        0 => (&r.fast_weight_words, &r.lifetime_weight_words),
+        1 => (&r.fast_weight_bank_1_words, &r.lifetime_weight_bank_1_words),
+        _ => return Err("ordinary ingress invalid active weight bank".into()),
+    };
+    let n = s.brain_slot.record().synapse_count;
+    let take = |r: &Range<u32>| -> Result<&[u32]> {
+        let end = r.start.checked_add(n).ok_or("ordinary ingress weight range overflow")?;
+        if end > r.end || n == 0 {
+            return Err("ordinary ingress GPU weights outside slot extent".into());
+        }
+        captured_words(s, r.start..end, n as usize)
+    };
+    Ok((n as usize, digest_words(take(f)?), digest_words(take(l)?)))
+}
+
+fn capture(step: &crate::FoundationTrainingStep) -> Result<Vec<u8>> {
+    let frame = &step.frame;
+    let before = &step.before;
+    let after = &step.after_inference;
+    let b = &step.behavior;
+    let tick = frame.tick().raw();
+    let actor = frame.organism_id().raw();
+    if frame.sensor_profile() != alife_core::SensorProfile::GroundedTerrainVisionV1
+        || before.tick != tick || after.tick != tick || b.tick != tick || b.organism_id != actor
+        || before.handle != after.handle || before.handle.organism_id() != frame.organism_id()
+        || before.phenotype.phenotype_hash() != after.phenotype.phenotype_hash()
+        || b.frame_digest != frame.frame_digest() || b.sampling.demonstrator.is_some()
+        || before.active_weight_generation != b.active_weight_generation
+        || after.active_weight_generation != b.active_weight_generation
+        || after.logical_dispatch_generation != b.dispatch_generation
+        || step.memory_upload.final_frame_digest() != b.frame_digest
+        || step.work.organism_id_raw != actor || step.work.tick != tick
+        || step.work.dispatch_generation != b.dispatch_generation
+        || step.work.frame_digest != b.frame_digest.0
+        || step.throttle.organism_id_raw != actor || step.throttle.tick != tick
+        || step.throttle.dispatch_generation != b.dispatch_generation
+        || step.throttle.frame_digest != b.frame_digest.0
+        || step.throttle.handle_generation != before.handle.generation()
+        || step.throttle.handle_slot != before.handle.slot()
+        || step.throttle.pressure.completed_gpu_time_ns != 0
+        || step.throttle.microsteps == 0
+        || step.patch.header().organism_id != frame.organism_id()
+        || step.patch.outcome().outcome_tick.raw() != tick.checked_add(1).ok_or("tick overflow")?
+    {
+        return Err("ordinary ingress snapshot/native identity mismatch".into());
+    }
+    let r = step.memory_upload.neural_receptor_effects().ok_or("missing native receptor row")?;
+    if r.source_tick != frame.tick() {
+        return Err("ordinary ingress receptor provenance differs".into());
+    }
+    let upload = GpuPerceptionUpload::try_from_frame(frame, &before.brain_slot, u32::from(before.active_activation_side))?;
+    let local = upload.frame_binding;
+    let accepted = step.memory_upload.perception_binding();
+    if local.slot != accepted.slot || local.slot_generation != accepted.slot_generation
+        || local.tick != accepted.tick || local.candidate_count != accepted.candidate_count
+        || local.base_frame_digest != accepted.base_frame_digest || local.context_digest != accepted.context_digest
+        || local.final_frame_digest != accepted.final_frame_digest
+        || upload.header.sensory_offset != 0 || b.decoder_input_stride != 36
+    {
+        return Err("ordinary ingress deterministic finalized frame re-pack mismatch".into());
+    }
+    let payload = &upload.frame_payload_words;
+    let h = payload.len().checked_sub(256).ok_or("ordinary ingress language span missing")?;
+    let expected = 77usize.checked_add(frame.candidates().len().checked_mul(36)
+        .ok_or("ordinary ingress candidate size overflow")?).ok_or("ordinary ingress size overflow")?;
+    if h != expected {
+        return Err("ordinary ingress fixed 77-word/256-language profile differs".into());
+    }
+    let raw77 = payload.get(..77).ok_or("ordinary ingress fixed words missing")?;
+    let lang = payload.get(h..).ok_or("ordinary ingress heard/prior words missing")?;
+    let pre_home = captured_words(before, before.brain_slot.word_ranges().homeostasis_words.clone(), 2 * NEURONS)?;
+    let post_home = captured_words(after, after.brain_slot.word_ranges().homeostasis_words.clone(), 2 * NEURONS)?;
+    // Only post-inference encoded_input belongs to the *current* frame.
+    let post_input = captured_words(after, after.brain_slot.word_ranges().encoded_input_words.clone(), NEURONS)?;
+    let pre_active = active(before)?;
+    let post_active = active(after)?;
+    let pre_weights = active_weights(before)?;
+    let post_weights = active_weights(after)?;
+    let topology = |s: &Snapshot| -> Result<String> {
+        // Use the actual V11 plus the ordered typed acquired structural slice.
+        // The pinned source and mature topology determine immutable inherited coordinates.
+        let edges = s.structural_synapses.iter().map(|a| (
+            a.slot_index, a.source, a.target, a.route, a.genetic_weight.to_bits(), a.alpha.to_bits()
+        )).collect::<Vec<_>>();
+        Ok(digest(&serde_json::to_vec(&(&s.v11, edges))?))
+    };
+    let metadata = serde_json::to_vec(&serde_json::json!({
+        "actor":actor, "tick":tick, "frame_digest":b.frame_digest,
+        "phenotype":before.phenotype.phenotype_hash(),
+        "base_frame_digest":frame.base_digest(),
+        "slot":before.handle.slot(), "slot_generation":before.handle.generation(),
+        "dispatch":b.dispatch_generation, "preceding_label":before.logical_dispatch_generation,
+        "sampling":b.sampling,
+        "pre_activation_side":before.active_activation_side,
+        "post_activation_side":after.active_activation_side,
+        "pre_active_weight_bank":before.active_weight_bank, "post_active_weight_bank":after.active_weight_bank,
+        "active_weight_generation":b.active_weight_generation,
+        "pre_active_weight_count_fast_lifetime_sha256":pre_weights,
+        "post_active_weight_count_fast_lifetime_sha256":post_weights,
+        "pre_topology_v11_sha256":topology(before)?, "post_topology_v11_sha256":topology(after)?,
+        "post_homeostasis_sha256":digest_words(post_home), "microsteps":step.throttle.microsteps,
+        "enabled_routes":step.throttle.enabled_route_ids,
+        "route_schedule_digest":step.throttle.route_schedule_digest,
+        "neural_work_receipt_digest":step.work.receipt_digest,
+        "receptor_source_chemistry_version":r.source_chemistry_version,
+        "receptor_effect_f32_bits_order": [
+            r.interoceptive_gain, r.regional_excitability, r.projection_gain, r.local_threshold_shift,
+            r.attention_gain, r.plasticity_appetitive, r.plasticity_aversive, r.structural_growth_gate,
+            r.sleep_gate, r.consolidation_gate,
+        ].map(f32::to_bits),
+        "ordered_sections": {
+            "finalized_frame_deterministic_raw77_not_device_copy":77,
+            "finalized_frame_deterministic_heard_and_prior256_not_device_copy":256,
+            "gpu_post_current_encoded_input":NEURONS,
+            "gpu_pre_active":NEURONS, "gpu_post_active":NEURONS,
+            "gpu_pre_homeostasis":2*NEURONS,
+        },
+    }))?;
+    // Per frame: metadata byte length, compact JSON, then fixed-order little-endian words.
+    super::ordinary_ingress_wire::frame(
+        &metadata, [raw77, lang, post_input, pre_active, post_active, pre_home],
+    ).ok_or_else(|| "ordinary ingress per-frame wire layout or byte bound differs".into())
+}
+
+#[cfg(test)]
