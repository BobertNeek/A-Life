+fn parse_request(bytes: &[u8]) -> Result<alife_game_app::SavedLifeRetentionRequest, Error> {
+    if bytes.len() > FULL_REQUEST_LIMIT {
+        return Err("retention request exceeds 1048576 bytes".into());
+    }
+    if bytes.len() > LEGACY_REQUEST_LIMIT {
+        if let Ok(request) =
+            serde_json::from_slice::<alife_game_app::SavedLifeRetentionRequest>(bytes)
+        {
+            if request
+                .direct_weights
+                .as_ref()
+                .is_some_and(|weights| weights.schema == 3)
+            {
+                return Ok(request);
+            }
+        }
+        return Err("retention request exceeds 262144 bytes".into());
+    }
+    Ok(serde_json::from_slice(bytes)?)
+}
