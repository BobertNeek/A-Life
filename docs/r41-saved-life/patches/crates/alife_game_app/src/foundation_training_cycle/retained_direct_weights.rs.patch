+// Schema 1 retains decoder-only admission. Schema 2 explicitly opts into
+// existing recurrent genetic coordinates; topology, dynamics and mutable state
+// remain protected by the native weight-only policy transition.
+// Schema 3 is an isolated research opt-in for the full trainable neural policy.
+// Speech is never admitted by schema 3, even if a future stage were to train it.
+const LEGACY_EDIT_LIMIT: usize = 8192;
+const FULL_EDIT_LIMIT: usize = 31_744;
+
+fn direct_edit_limit(schema: u16) -> usize {
+    match schema {
+        1 | 2 => LEGACY_EDIT_LIMIT,
+        3 => FULL_EDIT_LIMIT,
+        _ => 0,
+    }
+}
+
+/// Cheap registry admission, before opening Current. The native transition still
+/// checks every coordinate against the actual compiled phenotype and stage mask.
+#[cfg(feature = "gpu-tests")]
+pub(super) fn validate_experiment_edit_shape(request: &DirectWeightEditRequest) -> Result<()> {
+    if direct_edit_limit(request.schema) == 0
+        || request.generator_id.is_empty()
+        || request.generator_id.len() > 256
+        || request.edits.is_empty()
+        || request.edits.len() > direct_edit_limit(request.schema)
+    {
+        return Err("experiment compatibility: unsupported direct-weight schema or edit bounds".into());
+    }
+    let mut seen = std::collections::BTreeSet::new();
+    if request.edits.iter().any(|(index, bits)| !seen.insert(*index) || !f32::from_bits(*bits).is_finite()) {
+        return Err("experiment direct-weight edits require unique finite typed coordinates".into());
+    }
+    Ok(())
+}
+fn admitted_direct_kind(schema: u16, kind: CompiledSynapseKind) -> bool {
+    match (schema, kind) {
+        (1 | 2, CompiledSynapseKind::Decoder(c)) => c.head() == DecoderHeadKind::ActionCandidate,
+        (2 | 3, CompiledSynapseKind::Recurrent) => true,
+        (3, CompiledSynapseKind::Decoder(c)) => c.head() != DecoderHeadKind::SpeechPayload,
+        _ => false,
+    }
+}
+
 fn sha(bytes: &[u8]) -> String {
     format!("{:x}", Sha256::digest(bytes))
+}
+
+fn validate_direct_request(bytes: &[u8], request: &DirectWeightEditRequest) -> Result<()> {
+    if direct_edit_limit(request.schema) == 0
+        || request.source_current_sha256 != sha(bytes)
+        || request.generator_id.is_empty()
+        || request.generator_id.len() > 256
+        || request.edits.len() > direct_edit_limit(request.schema)
+    {
+        return Err("invalid direct-weight request/source/generator/bound".into());
+    }
+    Ok(())
 }
 
