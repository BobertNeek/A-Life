+#[cfg(test)]
+mod direct_admission_tests {
+    use super::*;
+    use alife_core::{
+        BrainCapacityClass, BrainGenome, DevelopmentState, NormalizedScalar, PhenotypeCompiler,
+        SensorProfile, Tick,
+    };
+    use alife_training::StageTrainableMask;
+
+    #[test]
+    fn full_schema_admits_all_non_speech_and_rejects_bad_coordinates() {
+        let g = BrainGenome::scaffold(0x2048_2026, BrainCapacityClass::N2048_ID);
+        let d = DevelopmentState::new(g.id, Tick::ZERO, NormalizedScalar::new(1.0).unwrap());
+        let (p, _) = PhenotypeCompiler::compile_n2048_anchored_v2_graph(
+            g,
+            d,
+            SensorProfile::GroundedObjectSlotsV1,
+        )
+        .unwrap();
+        let old: Vec<_> = p.synapses().iter().map(|s| s.genetic_weight()).collect();
+        let coordinate = |head| {
+            p.synapses()
+                .iter()
+                .position(|s| {
+                    matches!(s.kind(),
+            CompiledSynapseKind::Decoder(c) if c.head() == head)
+                })
+                .unwrap()
+        };
+        let recurrent = p
+            .synapses()
+            .iter()
+            .position(|s| s.kind() == CompiledSynapseKind::Recurrent)
+            .unwrap();
+        let action = coordinate(DecoderHeadKind::ActionCandidate);
+        let memory = coordinate(DecoderHeadKind::MemoryContext);
+        let speech = coordinate(DecoderHeadKind::SpeechPayload);
+        let all = (0..old.len() as u32).collect::<Vec<_>>();
+        let non_speech: Vec<_> = all
+            .iter()
+            .copied()
+            .filter(|&i| {
+                !matches!(p.synapses()[i as usize].kind(),
+            CompiledSynapseKind::Decoder(c) if c.head() == DecoderHeadKind::SpeechPayload)
+            })
+            .collect();
+        assert_eq!(non_speech.len(), direct_edit_limit(3));
+        assert_eq!(all.len() - non_speech.len(), 1024);
+        let stage = StageTrainableMask::from_synapse_indices(&p, &non_speech).unwrap();
+        let overbroad_stage = StageTrainableMask::from_synapse_indices(&p, &all).unwrap();
+        let action_stage = StageTrainableMask::from_synapse_indices(&p, &[action as u32]).unwrap();
+        let request = |schema, edits| DirectWeightEditRequest {
+            schema,
+            source_current_sha256: sha(b"bound source"),
+            generator_id: "test".into(),
+            edits,
+        };
+        let full = request(
+            3,
+            non_speech
+                .iter()
+                .map(|&i| {
+                    let i = i as usize;
+                    let value: f32 = if old[i] == 0.25 { -0.25 } else { 0.25 };
+                    (i, value.to_bits())
+                })
+                .collect(),
+        );
+        assert!(validate_direct_request(b"bound source", &full).is_ok());
+        assert!(validate_direct_request(b"wrong source", &full).is_err());
+        let mut bounded = full.clone();
+        bounded.edits.push(bounded.edits[0]);
+        assert!(validate_direct_request(b"bound source", &bounded).is_err());
+        bounded.edits.truncate(8193);
+        for old_schema in [1, 2] {
+            bounded.schema = old_schema;
+            assert!(validate_direct_request(b"bound source", &bounded).is_err());
+        }
+        bounded.schema = 3;
+        bounded.generator_id.clear();
+        assert!(validate_direct_request(b"bound source", &bounded).is_err());
+        bounded.generator_id = "x".repeat(257);
+        assert!(validate_direct_request(b"bound source", &bounded).is_err());
+        assert!(validate_direct_request(b"bound source", &request(4, vec![])).is_err());
+        let next = apply_checked_direct_edits(&p, &old, &stage, &full).unwrap();
+        for (i, (a, b)) in old.iter().zip(&next).enumerate() {
+            assert_eq!(a.to_bits() != b.to_bits(), stage.is_trainable(i));
+        }
+        let no_op = request(3, vec![(action, old[action].to_bits())]);
+        let no_op_proposal = apply_checked_direct_edits(&p, &old, &stage, &no_op).unwrap();
+        assert_eq!(count_changed_weight_bits(&old, &no_op_proposal), 0);
+        assert_eq!(count_changed_weight_bits(&[0.0], &[-0.0]), 1);
+        let v = 0.25_f32.to_bits();
+        assert!(
+            apply_checked_direct_edits(&p, &old, &stage, &request(3, vec![(memory, v)])).is_ok()
+        );
+        assert!(apply_checked_direct_edits(
+            &p,
+            &old,
+            &action_stage,
+            &request(3, vec![(memory, v)])
+        )
+        .is_err());
+        for edits in [
+            vec![(speech, v)],
+            vec![(action, v), (action, v)],
+            vec![(old.len(), v)],
+            vec![(action, f32::NAN.to_bits())],
+            vec![(action, f32::INFINITY.to_bits())],
+        ] {
+            assert!(
+                apply_checked_direct_edits(&p, &old, &overbroad_stage, &request(3, edits)).is_err()
+            );
+        }
+        assert_eq!(direct_edit_limit(1), 8192);
+        assert_eq!(direct_edit_limit(2), 8192);
+        assert_eq!(direct_edit_limit(4), 0);
+        for (schema, allowed) in [
+            (1, [true, false, false, false]),
+            (2, [true, true, false, false]),
+            (3, [true, true, true, false]),
+            (4, [false; 4]),
+        ] {
+            for (index, allowed) in [action, recurrent, memory, speech].into_iter().zip(allowed) {
+                assert_eq!(
+                    apply_checked_direct_edits(
+                        &p,
+                        &old,
+                        &overbroad_stage,
+                        &request(schema, vec![(index, v)])
+                    )
+                    .is_ok(),
+                    allowed
+                );
+            }
+        }
+    }
+}
