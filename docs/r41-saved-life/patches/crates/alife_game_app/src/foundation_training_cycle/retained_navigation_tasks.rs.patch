+    #[test]
+    fn novel_shapes_have_clear_routes_blocked_shortcuts_and_valid_scoring() {
+        for kind in [
+            TaskKind::DoglegCorridor,
+            TaskKind::UDetour,
+            TaskKind::DoorwayChambers,
+        ] {
+            let layout = shape_layout(kind).unwrap();
+            assert!(layout.walls.iter().all(|p| p[0].hypot(p[1]) < 10.0));
+            assert!(layout
+                .walls
+                .iter()
+                .all(|&w| segment_distance(layout.goal, layout.goal, w) > 0.9));
+            let (mut gates, mut invalid) = (0, false);
+            for segment in layout.route.windows(2) {
+                assert!(
+                    layout
+                        .walls
+                        .iter()
+                        .all(|&w| segment_distance(segment[0], segment[1], w) > 0.9),
+                    "insufficient body clearance {kind:?}"
+                );
+                score_shape_segment(&layout, &mut gates, &mut invalid, segment[0], segment[1]);
+            }
+            assert_eq!(gates as usize, layout.gates.len(), "{kind:?}");
+            assert!(!invalid, "{kind:?}");
+            let (mut direct_gates, mut direct_invalid) = (0, false);
+            score_shape_segment(
+                &layout,
+                &mut direct_gates,
+                &mut direct_invalid,
+                [0.0, 0.0],
+                layout.goal,
+            );
+            assert!(
+                direct_invalid,
+                "straight shortcut must hit actual wall geometry {kind:?}"
+            );
+            assert_eq!(direct_gates, 0);
+            let (mut reverse_gates, mut reverse_invalid) = (0, false);
+            score_shape_segment(
+                &layout,
+                &mut reverse_gates,
+                &mut reverse_invalid,
+                layout.goal,
+                [0.0, 0.0],
+            );
+            assert!(
+                reverse_invalid,
+                "reverse wall shortcut not rejected {kind:?}"
+            );
+            assert_eq!(reverse_gates, 0);
+            // Reversing the same physically clear route is legal backtracking,
+            // not a fresh gate or a bogus wall-crossing violation.
+            for segment in layout.route.windows(2).rev() {
+                score_shape_segment(&layout, &mut gates, &mut invalid, segment[1], segment[0]);
+            }
+            assert!(!invalid, "backtracking rejected {kind:?}");
+            assert_eq!(gates as usize, layout.gates.len());
+            let wall = layout.walls[0];
+            let (mut gates, mut invalid) = (0, false);
+            score_shape_segment(
+                &layout,
+                &mut gates,
+                &mut invalid,
+                [wall[0] - 1.0, wall[1]],
+                [wall[0] + 1.0, wall[1]],
+            );
+            assert!(invalid, "teleport across wall not rejected {kind:?}");
+            let (mut gates, mut invalid) = (0, false);
+            score_shape_segment(&layout, &mut gates, &mut invalid, [0.0, 0.0], [99.0, 99.0]);
+            assert!(invalid, "exterior shortcut not rejected {kind:?}");
+        }
+    }
