+// Experiment-only fixed public geometry. Existing fixture paths remain unchanged.
+#[derive(Clone, Copy)]
+struct ShapeGate {
+    axis: usize,
+    plane: f32,
+    direction: f32,
+    low: f32,
+    high: f32,
+}
+struct ShapeLayout {
+    walls: Vec<[f32; 2]>,
+    regions: Vec<[f32; 4]>, // inclusive x_min, x_max, z_min, z_max
+    gates: Vec<ShapeGate>,
+    goal: [f32; 2],
+    route: Vec<[f32; 2]>, // geometry-test witness, never supplied to the organism
+}
+fn wall_line(walls: &mut Vec<[f32; 2]>, p: [f32; 2], q: [f32; 2]) {
+    let steps = ((q[0] - p[0]).abs().max((q[1] - p[1]).abs()) * 2.0).round() as usize;
+    for i in 0..=steps {
+        let t = i as f32 / steps.max(1) as f32;
+        let v = [p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])];
+        if !walls.contains(&v) {
+            walls.push(v);
+        }
+    }
+}
