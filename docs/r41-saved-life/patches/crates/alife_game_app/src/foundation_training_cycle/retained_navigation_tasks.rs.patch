+fn segment_distance(p: [f32; 2], q: [f32; 2], w: [f32; 2]) -> f32 {
+    let d = [q[0] - p[0], q[1] - p[1]];
+    let norm = d[0] * d[0] + d[1] * d[1];
+    let t = if norm > 0.0 {
+        (((w[0] - p[0]) * d[0] + (w[1] - p[1]) * d[1]) / norm).clamp(0.0, 1.0)
+    } else {
+        0.0
+    };
+    (p[0] + t * d[0] - w[0]).hypot(p[1] + t * d[1] - w[1])
+}
+fn score_shape_segment(
+    layout: &ShapeLayout,
+    gates: &mut u8,
+    invalid: &mut bool,
+    p: [f32; 2],
+    q: [f32; 2],
+) {
+    let inside = |v: [f32; 2]| {
+        layout
+            .regions
+            .iter()
+            .any(|r| v[0] >= r[0] && v[0] <= r[1] && v[1] >= r[2] && v[1] <= r[3])
+    };
+    if p.iter().chain(q.iter()).any(|x| !x.is_finite())
+        || !inside(p)
+        || !inside(q)
+        || layout
+            .walls
+            .iter()
+            .any(|&w| segment_distance(p, q, w) <= 0.35)
+    {
+        *invalid = true;
+        return;
+    }
+    // Check gates in physical crossing order, not list order, including reverse-facing portals.
+    let mut crossings = Vec::new();
+    for (i, g) in layout.gates.iter().enumerate() {
+        let before = g.direction * (p[g.axis] - g.plane);
+        let after = g.direction * (q[g.axis] - g.plane);
+        if before < 0.0 && after >= 0.0 {
+            let t = (g.plane - p[g.axis]) / (q[g.axis] - p[g.axis]);
+            let other = 1 - g.axis;
+            let v = p[other] + t * (q[other] - p[other]);
+            // Crossing the extended plane outside the portal is ordinary exploration,
+            // not a completed gate. Actual walls and enclosure are checked above.
+            if v > g.low && v < g.high {
+                crossings.push((t, i as u8));
+            }
+        }
+    }
+    crossings.sort_by(|a, b| a.0.total_cmp(&b.0));
+    for (_, i) in crossings {
+        if *gates < i {
+            *invalid = true;
+        } else if *gates == i {
+            *gates += 1;
+        }
+    }
+}
