+type R<T>=Result<T,Box<dyn std::error::Error>>;
+// Registered R2 setup. No neural action, body displacement, update, step, reward, forced orientation, or call to an AI provider.
+#[derive(Clone,Copy)]
+struct Graded { layout: i8, danger: Option<bool>, tokens: &'static [u16] }
+fn graded_condition(m:&str)->Option<Graded>{
+ let (layout,danger,tokens):(i8,Option<bool>,&[u16])=match m{
+ "r2-grade-left"=>(1,Some(true),&[]),"r2-grade-right"=>(-1,Some(true),&[]),
+ "r2-grade-inert-left"=>(1,Some(false),&[]),"r2-grade-inert-right"=>(-1,Some(false),&[]),
+ _=>{let x=m.strip_prefix("r2-word-")?;let (side,x)=if let Some(x)=x.strip_prefix("mirror-"){(-1,x)}else{(1,x)};
+ let tokens:&[u16]=match x{"silence"=>&[],"approach-food"=>&[6,1],"approach-toy"=>&[6,2],"retreat-food"=>&[7,1],"retreat-toy"=>&[7,2],_=>return None};
+ (side,None,tokens)}};
+ Some(Graded{layout,danger,tokens})
+}
+fn graded_distance(a:Vec3f,b:Vec3f)->f32{((a.x-b.x).powi(2)+(a.y-b.y).powi(2)+(a.z-b.z).powi(2)).sqrt()}
+fn graded_setup(w:&mut HeadlessWorld,id:OrganismId,mode:&str,c:Graded)->R<Value>{
+ let t=w.tick();if t.raw()!=3074||id.raw()!=3||!w.audible_utterances().is_empty(){return Err("not the clean admitted L starting body".into())}
+ let mut s=w.clone();let old=s.object_snapshots();let body=old.iter().find(|o|o.organism_id==Some(id)).ok_or("missing source body")?.clone();
+ let food=WorldEntityId(2);let toy=WorldEntityId(4);let f=s.entity(food).ok_or("missing original edible")?;let y=s.entity(toy).ok_or("missing original toy")?;
+ if f.kind!=K::Food || !(f.nutrition>0.) || f.hazard_pain!=0. || y.kind!=K::ActivityToy || [f,y].iter().any(|o|o.consumed||o.carried_by.is_some()||o.activity_hold||o.teacher_channel.is_some()){return Err("inadmissible native referents".into())}
+ let (sin,cos)=body.body_yaw.sin_cos();let side=f32::from(c.layout);
