+}
+
+// The typed manifest registry is the only caller; no historical runner toggles.
+pub(super) fn configure(world: &mut HeadlessWorld, owner: OrganismId, case: &str) -> R<Value> {
+    if let Some(spec) = graded_condition(case) { return graded_setup(world, owner, case, spec); }
+    if case.starts_with("r12-word-") { return reference_probe(world, owner, case); }
+    if case.starts_with("r14-word-") { return reference14(world, owner, case); }
