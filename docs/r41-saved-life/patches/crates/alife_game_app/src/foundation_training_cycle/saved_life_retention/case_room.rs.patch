+// Source-only opt-in. Append inside lv8_matched_room.rs. No steps/sampler, teacher policy, target injection, or brain access.
+fn reference_probe(w: &mut HeadlessWorld, id: OrganismId, mode: &str) -> R<Value> {
+    let tail = mode.strip_prefix("r12-word-").ok_or("wrong R12 namespace")?;
+    let (mirror, tail) = tail.strip_prefix("mirror-").map_or((false, tail), |p| (true, p));
+    let (layout, phrase) = ["food-obstacle", "food", "ball", "obstacle", "empty"]
+        .into_iter().find_map(|n| tail.strip_prefix(n)?.strip_prefix('-').map(|p| (n,p)))
+        .ok_or("unknown R12 physical inventory")?;
+    let tokens: &[u16] = match phrase {
+        "silence" => &[], "approach-food" => &[6,1], "retreat-food" => &[7,1],
+        "approach-toy" => &[6,2], "retreat-toy" => &[7,2], "approach-obstacle" => &[6,4],
+        "retreat-obstacle" => &[7,4], "approach-fruit" => &[6,16], "retreat-fruit" => &[7,16],
+        "approach-ball" => &[6,14], "retreat-ball" => &[7,14],
+        _ => return Err("unregistered literal R12 cue".into()),
+    };
+    let t = w.tick();
+    if t.raw()!=3074 || id.raw()!=3 || !w.audible_utterances().is_empty() || w.terrain().is_some() {
+        return Err("wrong starting room, receiver, or nonquiet prehistory".into());
+    }
+    let mut s=w.clone();
+    let old=w.object_snapshots();
+    let a=old.iter().find(|o|o.organism_id==Some(id)).ok_or("no source receiver")?;
+    let others=[(2,K::Food),(3,K::Ball),(4,K::ActivityToy),(6,K::Obstacle),(7,K::Obstacle),(9,K::Food),(10,K::Food)];
+    let relevant=|k:K|matches!(k,K::Food|K::ActivityToy|K::Ball|K::Obstacle);
+    if old.len()!=10 || old.iter().filter(|o|relevant(o.kind)).count()!=others.len()
+        || others.iter().any(|&(i,k)| !old.iter().any(|o| o.id.raw()==i && o.kind==k && o.consumed==(i==10)
+                && o.carried_by.is_none() && !o.activity_hold && o.teacher_channel.is_none()))
+        || s.player_held_object().is_some() {
+        return Err("unexpected original inventory or carrier".into());
+    }
+    // Native ecology owns the original remote food #2 and spent original moving food #10. Clear these
+    // two fixture registrations identically in every arm; no mutation of any original creature or sensory channel.
+    let mut e=s.ecology().clone();
+    if e.resources.len()!=1 || e.resources[0].object_id.raw()!=2 || e.autonomous_critters.len()!=1
+        || e.autonomous_critters[0].object_id.raw()!=10 || !e.spawn_policies.is_empty(){
+        return Err("unexpected food lifecycle, prey, or active respawn policy".into());
+    }
+    e.resources.clear(); e.autonomous_critters.clear();
+    s.configure_ecology(e)?;
+    for (i,_) in others { s.editor_remove_object(WorldEntityId(i))?; }
+    let (sn,cs)=a.body_yaw.sin_cos();
+    let at=|f:f32,l:f32|Vec3f::new(a.position.x+f*cs-l*sn,a.position.y,a.position.z+f*sn+l*cs);
+    let sign=if mirror {-1.0}else{1.0};
+    // Food and Ball each occupy the IDENTICAL target slot in their one-object arms; neither room ID nor
+    // side determines the correct noun. Across food-only vs food+obstacle the same food keeps its position.
+    let primary=at(2.20,sign*1.25); let other=at(2.20,-sign*1.25);
+    let f=s.editor_spawn_object(WorldEditorSpawnSpec{label:"reference sample A".into(),kind:K::Food,organism_id:None,position:primary,nutrition:0.45,hazard_pain:0.,radius:0.32,token_id:None})?;
+    s.set_food_variety(f,alife_world::FoodVariety::Fruit)?;
+    let y=s.spawn_toy("reference sample B",primary,true)?;
+    let o=s.editor_spawn_object(WorldEditorSpawnSpec{label:"reference sample C".into(),kind:K::Obstacle,organism_id:None,position:other,nutrition:0.,hazard_pain:0.,radius:0.32,token_id:None})?;
+    let mut keep=Vec::new();
+    let mut subjects=Vec::new();
+    let (mut food,mut toy,mut obstacle)=(Value::Null,Value::Null,Value::Null);
+    // Allocate exactly the same three entities in the same order before any removal in every arm.
+    for (entity,kind,p,present) in [(f,K::Food,primary,matches!(layout,"food"|"food-obstacle")),
+            (y,K::Ball,primary,layout=="ball"),(o,K::Obstacle,other,matches!(layout,"obstacle"|"food-obstacle"))] {
+        if !present { s.editor_remove_object(entity)?; continue; }
+        let real=s.entity(entity).ok_or("present referent is absent")?;
+        if real.kind!=kind || real.position!=p || real.consumed || real.carried_by.is_some() || real.hazard_pain!=0. {
+            return Err("invalid actual material, location, ownership or hidden harm".into());
+        }
+        let mut obj=json!({"kind":kind,"id":entity,"p":real.position});
+        if kind==K::Food{obj["nutrition"]=json!(real.nutrition);food=obj.clone();}
+        if kind==K::Ball{toy=obj.clone();}
+        if kind==K::Obstacle{obstacle=obj.clone();}
+        keep.push(entity);subjects.push(obj);
+    }
+    let roster=s.object_snapshots();
+    if roster.len()!=3+keep.len() || roster.iter().filter(|v|relevant(v.kind)).any(|v|!keep.contains(&v.id))
+        || old.iter().filter(|v|!relevant(v.kind)).any(|v|s.entity(v.id)!=Some(v)) {
+        return Err("wrong global physical inventory or changed unrelated body".into());
+    }
+    let pre=s.sensory_report(id,t)?;
+    let vis=pre.visible_entities.iter().map(|v|v.id).collect::<Vec<_>>();
+    if vis.len()!=keep.len()||keep.iter().any(|v|!vis.contains(v))||!pre.contact_entities.is_empty()
+        ||pre.core_snapshot.language_context.heard_tokens.iter().any(Option::is_some) {
+        return Err("visible referents differ from clean physical conditions, unexpected hearing or contact".into());
+    }
+    if !tokens.is_empty() {
+        s.emit_player_tokens(Some(id),at(0.34,0.14),tokens.iter().map(|v|LanguageTokenId::new(*v)).collect::<Result<Vec<_>,_>>()?)?;
+    }
+    let post=s.sensory_report(id,t)?;
+    let heard=post.core_snapshot.language_context.heard_tokens.iter().flatten().map(|u|u.token_id).collect::<Vec<_>>();
+    if heard!=tokens.iter().map(|u|u32::from(*u)).collect::<Vec<_>>() || post.visible_entities.iter().map(|v|v.id).collect::<Vec<_>>()!=vis
+        || post.contact_entities!=pre.contact_entities || s.tick()!=t || s.entity(a.id)!=Some(a)
+        || s.organism_registry().get(id)!=w.organism_registry().get(id) || s.object_snapshots()!=roster {
+        return Err("wrong actual hearing, scene changed, or receiver advanced".into());
+    }
+    let digest=|v:&alife_core::SensorySnapshot|->R<String>{Ok(format!("{:x}",<sha2::Sha256 as sha2::Digest>::digest(serde_json::to_vec(v)?)))};
+    let ans=json!({"kind":"R12-crossed-physical-reference-v1","mode":mode,"mirror":mirror,
+        "at_tick":t,"body_position":a.position,"body_yaw":a.body_yaw,"food":food,"toy":toy,"obstacle":obstacle,"hazard":null,
+        "subjects":subjects,"slots":{"primary":primary,"other":other},"visible":vis,"heard":heard,
+        "before_sound_sha256":digest(&pre.core_snapshot)?,"after_sound_sha256":digest(&post.core_snapshot)?,
+        "biological_choices":0,"forced_action":false,"body_changed":false,"global_reference_counts_verified":true,
+        "common_removed_source_ids":[2,3,4,6,7,9,10],"common_allocated_ids":[f,y,o],
+        "physical_control":"zero or named native Fruit/Ball/Obstacle entries globally, empty sensory field otherwise; retained agents and remote hazard unchanged; native sensory report, no scored IDs or answer fed to neural input"});
+    *w=s;Ok(ans)
+}
