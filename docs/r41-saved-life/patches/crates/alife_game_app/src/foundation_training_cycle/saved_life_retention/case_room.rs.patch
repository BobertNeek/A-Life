+ let (fwd,lat)=if c.danger.is_some(){(1.65,0.84)}else{(2.15,0.92)};
+ let fp=at(fwd,-lat*side);let yp=at(fwd,lat*side);
+ for(oid,p) in [(food,fp),(toy,yp)]{s.editor_move_object(oid,p)?;s.editor_move_object(oid,p)?;let z=s.entity(oid).ok_or("lost positioned object")?;
+ if graded_distance(z.position,p)>1e-4 || z.grounded_physical.velocity!=Vec3f::ZERO{return Err("move did not make stationary matched props".into())}}
+ let mut hazard=None;let mut hazard_json=Value::Null;
+ if let Some(dangerous)=c.danger{
+  let hp=at(0.12,0.59*side);let radius=0.61;let dose=if dangerous{0.16}else{0.};
+  let h=s.editor_spawn_object(WorldEditorSpawnSpec{label:"private contact sample".into(),kind:K::Hazard,organism_id:None,position:hp,nutrition:0.,hazard_pain:dose,radius,token_id:None})?;
+  let mut g=s.entity(h).ok_or("missing graded contact surface")?.grounded_physical;g.surface_temperature=0.84;s.set_grounded_physical_properties(h,g)?;
+  let opening_depth=radius-graded_distance(body.position,hp);
+  // From this acute geometry the safe-food ray points OUT immediately, not back through the heat after departure.
+  let vx=fp.x-body.position.x;let vz=fp.z-body.position.z;let nx=body.position.x-hp.x;let nz=body.position.z-hp.z;
+  let outdot=(vx*nx+vz*nz)/(vx.hypot(vz)*nx.hypot(nz));if !(0.007..0.009).contains(&opening_depth) || outdot<=0.20{return Err("missing measured graded clearance or outward food corridor".into())}
+  hazard=Some(h);hazard_json=json!({"id":h,"p":hp,"radius":radius,"surface_temperature":0.84,"contact":true,"hidden_pain":dose,"opening_penetration_m":opening_depth,"initial_radial_cosine_toward_food":outdot});
+ }
+ // This study is registered only for the historical flat/non-heightfield save. A terrain-enabled save needs an independently qualified route.
+ if s.terrain().is_some(){return Err("graded study requires original unbound heightfield".into())}
+ let rr=alife_world::LocomotionLimits::default().body_radius;
+ let segment_distance=|p:Vec3f,q:Vec3f,x:Vec3f|{let (dx,dz)=(q.x-p.x,q.z-p.z);let u=(((x.x-p.x)*dx+(x.z-p.z)*dz)/(dx*dx+dz*dz)).clamp(0.,1.);graded_distance(Vec3f::new(p.x+u*dx,p.y,p.z+u*dz),x)};
+ for o in &old{if o.kind==K::Obstacle&&!o.consumed && ([fp,yp].iter().any(|p|segment_distance(body.position,*p,o.position)<=o.radius+rr)
