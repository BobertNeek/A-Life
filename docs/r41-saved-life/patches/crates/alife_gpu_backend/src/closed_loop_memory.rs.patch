+
+    /// Attach the already World-bound exact finalized candidate rows. The
+    /// retaining App is the trusted producer. This is not a raw policy input.
+    pub fn bind_visible_self_grip_v1(
+        &mut self,
+        frame: &PerceptionFrame,
+        observer: alife_core::OrganismId,
+        tick: Tick,
+        final_digest: PerceptionFrameDigest,
+        words: &[u32],
+        weights: [u32; 16],
+    ) -> Result<(), GpuClosedLoopError> {
+        if self.offset_domain != GpuMemoryOffsetDomain::Local
+            || self.visible_self_grip_v1.is_some()
+            || frame.organism_id() != observer || frame.tick() != tick
+            || self.perception_binding.tick != tick || frame.frame_digest() != final_digest
+            || self.final_frame_digest != final_digest
+            || frame.sensor_profile() != alife_core::SensorProfile::GroundedTerrainVisionV1
+            || words.len() != frame.candidates().len()
+            || !(1..=32).contains(&words.len())
+            || words.iter().any(|&w| !matches!(w, 0 | 0x3f80_0000))
+            || words.iter().zip(frame.candidates()).any(|(&w, candidate)| {
+                w != 0 && !matches!(candidate.observation, alife_core::CandidateObservationRef::ObjectSlot(_))
+            })
+            || !matches!(weights[0], 0 | 0xc100_0000)
+            || weights.iter().any(|&v| v != weights[0])
+        {
+            return Err(GpuClosedLoopError::MalformedUpload);
+        }
+        self.visible_self_grip_v1 = Some(VisibleSelfGripFrameV1 { words: words.to_vec(), weights });
+        Ok(())
     }
 
