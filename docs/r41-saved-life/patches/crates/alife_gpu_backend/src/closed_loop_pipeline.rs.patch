+fn superimpose_visible_self_grip_v1(stock: &str) -> String {
+    // Use exactly the old context kernel, with one insertion at the stock
+    // final-logit write in each supported memory-plan branch. Only active
+    // packets select this specialization; the stock module is not rewritten.
+    let stock = stock.replace(
+        "store_state_f32(logit_index, composed);",
+        "store_state_f32(logit_index, visible_self_grip_v1(row_base, header, brain, candidate, composed));",
+    ).replace(
+        "store_state_f32(logit_index,\n      base_logit\n        + clamp(delta, -plan.max_candidate_gain, plan.max_candidate_gain)\n        + clamp(cognitive_delta, -0.5, 0.5));",
+        "let composed = base_logit + clamp(delta, -plan.max_candidate_gain, plan.max_candidate_gain) + clamp(cognitive_delta, -0.5, 0.5);\n    store_state_f32(logit_index, visible_self_grip_v1(row_base, header, brain, candidate, composed));",
+    );
+    assert_eq!(stock.matches("visible_self_grip_v1(row_base").count(), 2);
+    stock + include_str!("../shaders/visible_self_grip_v1.wgsl")
 }
 
