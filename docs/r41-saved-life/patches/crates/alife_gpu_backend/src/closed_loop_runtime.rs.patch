+#[cfg(feature = "gpu-tests")]
+fn validate_controlled_host_pressure(
+    software: bool,
+    replay: bool,
+    completed: u64,
+    ns: u64,
+) -> Result<(), ScaffoldContractError> {
+    if !software || replay || completed != 0 || !matches!(ns, 0 | 2_000_000 | 4_000_000 | 8_000_000)
+    {
+        return Err(ScaffoldContractError::BrainActivitySequenceMismatch);
+    }
+    Ok(())
+}
+
+#[cfg(all(test, feature = "gpu-tests"))]
+mod controlled_host_pressure_tests {
+    use super::*;
+    #[test]
+    fn explicit_software_only_before_dispatch_and_without_replay() {
+        for ns in [0, 2_000_000, 4_000_000, 8_000_000] {
+            assert!(validate_controlled_host_pressure(true, false, 0, ns).is_ok());
+            assert!(validate_controlled_host_pressure(false, false, 0, ns).is_err());
+            assert!(validate_controlled_host_pressure(true, true, 0, ns).is_err());
+            assert!(validate_controlled_host_pressure(true, false, 1, ns).is_err());
+        }
+        assert!(validate_controlled_host_pressure(true, false, 0, 1).is_err());
+    }
+}
