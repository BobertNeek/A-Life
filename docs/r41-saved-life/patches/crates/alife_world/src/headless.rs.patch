+    // Join only this call's actual visible observations to the slots emitted
+    // from that same snapshot. Never recover an emitter from tracking history.
+    fn near_field_volatile_exposure(
+        &self,
+        snapshot: &PhysicalObservationSnapshot,
+        grounded: &crate::GroundedSensingFrame,
+    ) -> Result<Vec<f32>, ScaffoldContractError> {
+        let origin = snapshot.observer_pose.translation;
+        grounded
+            .transports()
+            .iter()
+            .map(|transport| {
+                let source = snapshot
+                    .visible
+                    .iter()
+                    .find(|source| source.transport_entity == transport.transport_entity)
+                    .filter(|source| source.position == transport.target_position)
+                    .ok_or(ScaffoldContractError::InvalidPerceptionFrame)?;
+                let d = distance(origin, source.position);
+                let exposure = if !source.contact
+                    && d < EAT_RADIUS
+                    && self.physical_contact_reachable(origin, source.position)
+                {
+                    (1.0 - d / EAT_RADIUS).clamp(0.0, 1.0)
+                } else {
+                    0.0
+                };
+                Ok(exposure)
+            })
+            .collect()
+    }
