+#[cfg(test)]
+mod near_field_volatile_tests {
+    use super::*;
+
+    const LEARNER: OrganismId = OrganismId(1);
+    const PROFILE: SensorProfile = SensorProfile::GroundedTerrainVisionV1;
+
+    #[test]
+    fn retained_scent_uses_same_index_and_preserves_nonvolatile_lanes() {
+        let (opening, target) = world(
+            WorldObjectKind::Food,
+            Vec3f::new(0.6, 0.0, 0.0),
+            [0.5; 3],
+            [0.8, -0.5, 0.9],
+        );
+        let tick = opening.tick();
+        let homeostasis = HomeostaticSnapshot::baseline(tick);
+        let mut stock = opening.clone();
+        let mut control = opening.clone();
+        let mut sample = opening;
+        let stock_index = stock.build_perception_batch_index().unwrap();
+        let control_index = control.build_perception_batch_index().unwrap();
+        let sample_index = sample.build_perception_batch_index().unwrap();
+        let (stock, stock_binding) = stock
+            .perception_frame_draft_indexed_with_bindings(LEARNER, tick, PROFILE, homeostasis, &stock_index)
+            .unwrap();
+        let (control, control_binding) = control
+            .perception_frame_draft_indexed_for_retention(LEARNER, tick, PROFILE, homeostasis, &control_index, false)
+            .unwrap();
+        let (sample, _) = sample
+            .perception_frame_draft_indexed_for_retention(LEARNER, tick, PROFILE, homeostasis, &sample_index, true)
+            .unwrap();
+        let stock = stock.finalize(PerceptionContextBlock::empty()).unwrap();
+        let control = control.finalize(PerceptionContextBlock::empty()).unwrap();
+        let sample = sample.finalize(PerceptionContextBlock::empty()).unwrap();
+        assert!(stock_binding.is_some());
+        assert_eq!(stock_binding, control_binding);
+        assert_eq!(serde_json::to_vec(&stock).unwrap(), serde_json::to_vec(&control).unwrap());
+        let off = local(&control, target).unwrap();
+        let on = local(&sample, target).unwrap();
+        assert_eq!(off, [0.0; 4]);
+        assert!(on[0] > 0.0);
+        assert_eq!(off[2].to_bits(), on[2].to_bits());
+        assert_eq!(off[3].to_bits(), on[3].to_bits());
+        assert_eq!(control.sensory(), sample.sensory());
+        assert_eq!(control.candidates().len(), sample.candidates().len());
+        for (off, on) in control.candidates().iter().zip(sample.candidates()) {
+            let mut projected = on.clone();
+            projected.features.0[15..17].copy_from_slice(&off.features.0[15..17]);
+            assert_eq!(serde_json::to_vec(off).unwrap(), serde_json::to_vec(&projected).unwrap());
+        }
+    }
+
+    fn sample(world: &mut HeadlessWorld, experimental: bool) -> PerceptionFrame {
+        let tick = world.tick;
+        let body = HomeostaticSnapshot::baseline(tick);
+        if experimental {
+            world
+                .perception_frame_draft_with_near_field_volatile(LEARNER, tick, PROFILE, body)
+                .unwrap()
+                .0
+                .finalize(PerceptionContextBlock::empty())
+                .unwrap()
+        } else {
+            world.perception_frame(LEARNER, tick, PROFILE, body).unwrap()
+        }
+    }
+
+    fn world(
+        kind: WorldObjectKind,
+        position: Vec3f,
+        appearance: [f32; 3],
+        emitter: [f32; 3],
+    ) -> (HeadlessWorld, WorldEntityId) {
+        let mut world = HeadlessScenarioBuilder::new(60_093)
+            .agent("observer", LEARNER, Vec3f::ZERO)
+            .build()
+            .unwrap();
+        let target = world
+            .editor_spawn_object(WorldEditorSpawnSpec {
+                label: "target".into(),
+                kind,
+                organism_id: None,
+                position,
+                nutrition: if kind == WorldObjectKind::Food { 0.6 } else { 0.0 },
+                hazard_pain: 0.0,
+                radius: 0.25,
+                token_id: None,
+            })
+            .unwrap();
+        let mut props = world.entity(target).unwrap().grounded_physical;
+        props.color = appearance;
+        props.material = appearance;
+        props.shape = appearance;
+        props.chemical = emitter;
+        world.set_grounded_physical_properties(target, props).unwrap();
+        (world, target)
+    }
+
+    fn local(frame: &PerceptionFrame, target: WorldEntityId) -> Option<[f32; 4]> {
+        frame
+            .candidates()
+            .iter()
+            .find(|candidate| candidate.target.entity == Some(target))
+            .map(|candidate| candidate.features.0[15..19].try_into().unwrap())
+    }
+
+    #[test]
+    fn scent_follows_emitters_not_object_kind_or_appearance() {
+        for kind in [WorldObjectKind::Food, WorldObjectKind::Ball] {
+            for appearance in [[0.15, 0.8, 0.1], [0.85, 0.2, 0.9]] {
+                for emitter in [[0.8, -0.5, 0.9], [0.0, 0.0, 0.9]] {
+                    let (mut world, target) =
+                        world(kind, Vec3f::new(0.6, 0.0, 0.0), appearance, emitter);
+                    let stock = sample(&mut world.clone(), false);
+                    let experiment = sample(&mut world, true);
+                    assert_eq!(local(&stock, target), Some([0.0; 4]));
+                    let expected = 1.0 - 0.6 / EAT_RADIUS;
+                    assert_eq!(
+                        local(&experiment, target),
+                        Some([emitter[0] * expected, emitter[1] * expected, 0.0, 0.0])
+                    );
+                    assert_eq!(stock.sensory(), experiment.sensory());
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn clear_reach_cutoff_hidden_and_transparent_solid() {
+        for (x, visible) in [(EAT_RADIUS, true), (1.5, true), (-0.6, false)] {
+            let (mut world, target) = world(
+                WorldObjectKind::Food,
+                Vec3f::new(x, 0.0, 0.0),
+                [0.5; 3],
+                [0.8, -0.5, 0.9],
+            );
+            assert_eq!(local(&sample(&mut world, true), target), visible.then_some([0.0; 4]));
+        }
+        let (mut world, target) = world(
+            WorldObjectKind::Food,
+            Vec3f::new(0.9, 0.0, 0.0),
+            [0.5; 3],
+            [0.8, -0.5, 0.9],
+        );
+        let wall = world.editor_spawn_object(WorldEditorSpawnSpec {
+            label: "wall".into(),
+            kind: WorldObjectKind::Obstacle,
+            organism_id: None,
+            position: Vec3f::new(0.45, 0.0, 0.0),
+            nutrition: 0.0,
+            hazard_pain: 0.0,
+            radius: 0.12,
+            token_id: None,
+        }).unwrap();
+        world.editor_set_optical_opacity(wall, 0.0).unwrap();
+        let stock = sample(&mut world.clone(), false);
+        let experiment = sample(&mut world, true);
+        assert_eq!(local(&experiment, target), Some([0.0; 4]));
+        assert_eq!(stock.sensory(), experiment.sensory());
+    }
+
+    #[test]
+    fn disabled_chemical_receptor_and_stale_slot_do_not_expose_volatile_cues() {
+        let (mut current, target) = world(
+            WorldObjectKind::Food,
+            Vec3f::new(0.6, 0.0, 0.0),
+            [0.5; 3],
+            [0.8, -0.5, 0.9],
+        );
+        assert!(local(&sample(&mut current, true), target).unwrap()[0] > 0.0);
+        // Use constructed, validated embodiment metadata, not a modified acquired save.
+        let genome = alife_core::CreatureGenome::early_mammal_founder(
+            60_094,
+            alife_core::FoundationGeneticIdentity::new(
+                10, 1, 7, alife_core::BrainCapacityClass::N512_ID,
+            ).unwrap(),
+        ).unwrap();
+        let phenotype = genome.express().unwrap();
+        let ordinary = EmbodimentState::from_phenotype(
+            current.agent_entity_id(LEARNER).unwrap(), Tick::ZERO, &phenotype,
+        ).unwrap();
+        let mut wire = serde_json::to_value(&ordinary).unwrap();
+        let ports = wire["sensors"].as_array().unwrap().clone();
+        let old = wire["sensor_calibration"].as_array().unwrap().clone();
+        let mut remaining = Vec::new();
+        let mut values = Vec::new();
+        let mut offset = 0;
+        for port in ports {
+            let width = port["value_lanes"].as_u64().unwrap() as usize;
+            if port["capability"].as_str() != Some("Chemical") {
+                remaining.push(port);
+                values.extend_from_slice(&old[offset..offset + width]);
+            }
+            offset += width;
+        }
+        wire["sensors"] = serde_json::json!(remaining);
+        wire["sensor_calibration"] = serde_json::json!(values);
+        let disabled: EmbodimentState = serde_json::from_value(wire).unwrap();
+        disabled.validate_contract().unwrap();
+        assert_eq!(disabled.sensor_gain(SensorCapability::Chemical), 0.0);
+        let observer = current.agent_for(LEARNER).unwrap();
+        let snapshot = current.physical_observation_snapshot_from_objects(
+            LEARNER, current.tick, observer, current.objects.values(), true,
+        ).unwrap();
+        let mut grounded =
+            GroundedSensorExtractor::extract(&snapshot, &mut current.tracked_objects).unwrap();
+        let exposure = current.near_field_volatile_exposure(&snapshot, &grounded).unwrap();
+        assert!(exposure.iter().any(|value| *value > 0.0));
+        grounded.calibrate_near_field_volatile(Some(&disabled), &exposure).unwrap();
+        assert!(grounded.slots().iter().all(|slot| slot.chemical == [0.0; 3]));
+
+        current.editor_move_object(target, Vec3f::new(-0.6, 0.0, 0.0)).unwrap();
+        current.advance_tick();
+        assert!(local(&sample(&mut current, true), target).is_none());
+    }
+
+    #[test]
+    fn owned_taste_is_unchanged_and_real_pickup_precedes_own_meal() {
+        let (mut world, target) = world(
+            WorldObjectKind::Food,
+            Vec3f::new(0.6, 0.0, 0.0),
+            [0.5; 3],
+            [0.8, -0.5, 0.9],
+        );
+        let free = local(&sample(&mut world, true), target).unwrap();
+        assert!(free[0] > 0.0);
+        assert_eq!(&free[2..], &[0.0, 0.0]);
+        let eat = HeadlessWorldCommand::eat(LEARNER, target).unwrap();
+        let pickup = world.apply_command(&eat).unwrap();
+        assert!(pickup.execution.succeeded);
+        assert_eq!(pickup.execution.physical.energy_cost.raw(), 0.06);
+        assert_eq!(pickup.body_event.nutrition, 0.0);
+        assert_eq!(world.entity(target).unwrap().carried_by, Some(LEARNER));
+
+        world.advance_tick();
+        let owned = local(&sample(&mut world, true), target).unwrap();
+        let stock_owned = local(&sample(&mut world.clone(), false), target).unwrap();
+        assert_eq!(owned.map(f32::to_bits), stock_owned.map(f32::to_bits));
+        assert_eq!(owned, [0.8, -0.5, 0.9, 1.0]);
+        let meal = world.apply_command(&eat).unwrap();
+        assert!(meal.execution.succeeded);
+        assert_eq!(meal.execution.physical.energy_cost.raw(), 0.03);
+        assert_eq!(meal.body_event.nutrition, 0.6);
+        assert!(world.entity(target).unwrap().consumed);
     }
