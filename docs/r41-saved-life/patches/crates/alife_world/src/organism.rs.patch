+// `f32::exp2` has platform-dependent rounding. A saved phenotype remains
+// authoritative; tolerate one adjacent positive f32 only for this derived field.
+// Every other phenotype field and all original state digests must still agree.
+fn expressed_phenotype_matches_saved(
+    saved: &CreaturePhenotype,
+    expressed: &CreaturePhenotype,
+) -> bool {
+    if saved == expressed {
+        return true;
+    }
+    let a = saved.body.metabolic_turnover;
+    let b = expressed.body.metabolic_turnover;
+    if !a.is_finite()
+        || !b.is_finite()
+        || a <= 0.0
+        || b <= 0.0
+        || a.to_bits().abs_diff(b.to_bits()) > 1
+    {
+        return false;
+    }
+    let mut comparison = expressed.clone();
+    comparison.body.metabolic_turnover = a;
+    saved == &comparison
 }
 
