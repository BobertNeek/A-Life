+        saved.body.metabolic_turnover = f32::from_bits(bits + 1);
+        assert!(expressed_phenotype_matches_saved(&saved, &expressed));
+        assert_eq!(saved.body.metabolic_turnover.to_bits(), bits + 1);
+        saved.body.metabolic_turnover = f32::from_bits(bits + 2);
+        assert!(!expressed_phenotype_matches_saved(&saved, &expressed));
+        saved.body.metabolic_turnover = f32::NAN;
+        assert!(!expressed_phenotype_matches_saved(&saved, &expressed));
