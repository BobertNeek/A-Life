+        let p=u.synapse_learning_metadata.get(g0 as usize).ok_or("missing native packed synapse identity")?;
+        let gene=u.genetic_weights.get(g0 as usize).ok_or("missing packed inherited weight")?.to_bits();
+        let alpha=u.alpha.get(g0 as usize).ok_or("missing packed inherited alpha")?.to_bits();
