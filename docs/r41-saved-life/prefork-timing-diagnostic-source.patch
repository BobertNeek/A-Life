+            b"{\n  \"a\": [\n    17.012345678901234567,\n    -0.0,\n    {}\n  ],\n  \"s\": \"x\\\\t\"\n}");
+        assert!(members(br#"{"a":0,"\u0061":1}"#,["a"]).is_err());
+    }
