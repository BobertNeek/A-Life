+fn profile_contract(w:&ProfileWire)->bool{
+    const N:u32=2048;const WEIGHTS:u32=32768;const SP:u32=32;const WORDS:u32=SP*SP;
+    w.schema=="qualia.private.note19.stock_v11_profile.v1" && w.owner>0 && w.first>0
+       && w.first.checked_add(6)==Some(w.fork) && w.first.checked_add(256).is_some()
+       && profile_id(&w.primary_case) && profile_id(&w.foil_case) && w.primary_case!=w.foil_case
+       && [&w.phenotype_identity_sha256,&w.initial_phenotype_asset_sha256,&w.source_descriptor_sha256]
+          .into_iter().all(|s|pin(s))
+       && w.axes.iter().all(|x|*x<N)
+       && w.axes.iter().enumerate().all(|(i,x)|!w.axes[..i].contains(x))
+       && w.branch_count>=3 && w.branch_count<=N as usize
+       && w.rows.iter().enumerate().all(|(i,r)|r.ordinal<w.branch_count
+          && (i==0||w.rows[i-1].ordinal.checked_add(1)==Some(r.ordinal))
+          && r.target==w.rows[0].target && w.axes.contains(&r.target)
+          && r.operand_a!=r.operand_b && w.axes.contains(&r.operand_a) && w.axes.contains(&r.operand_b)
+          && f32::from_bits(r.threshold_bits).is_finite()
+          && f32::from_bits(r.output_gain_bits).is_finite() && f32::from_bits(r.output_gain_bits)!=0.0)
