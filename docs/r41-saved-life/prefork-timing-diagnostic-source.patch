+/// Call only after the unchanged schema81 snapshot identity checks used
+/// for in-memory hashing, and only inside the separate new role. This
+/// function cannot write or release anything.
+pub(super) fn build(step:&crate::FoundationTrainingStep,pf:&VerifiedStockV11Profile)->Result<Vec<u8>>{
+    let (pre,post,b)=(&step.before,&step.after_inference,&step.behavior);
+    let tick=step.frame.tick().raw();
