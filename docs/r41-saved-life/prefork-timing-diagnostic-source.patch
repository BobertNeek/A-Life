+//! Detached, owner-only research projection of existing App snapshots.
+//! No launch/dispatch/state change/storage. Not schema81.
+use super::*;
+use super::ordinary_ingress_native_custody::{VerifiedStockV11Profile,V11Expectation};
+use alife_core::{CompiledSynapseKind, DecoderHeadKind};
+use alife_gpu_backend::{training_rollout::GpuTrainingStateSnapshot as Snapshot,GpuPhenotypeUpload};
+use std::ops::Range;
+
+const WIDTH:u32=2048;
+const W:u32=32;
+const COUNT:u32=1024;
+pub(super) const MAX_BYTES:usize=96*1024;
+
+fn words(s:&Snapshot,r:Range<u32>)->Result<&[u32]> {
+    let a=r.start.checked_sub(s.mutable_word_base).ok_or("prefork range before slot")?;
+    let b=r.end.checked_sub(s.mutable_word_base).ok_or("prefork range before slot")?;
+    s.mutable_words.get(a as usize..b as usize).ok_or_else(||"prefork outside actual capture".into())
+}
+fn bank(s:&Snapshot,side:u8)->Result<&[u32]> {
+    let r=s.brain_slot.word_ranges();
+    let span=match side {
+        0=>r.activation_a_words.clone(),
+        1=>r.activation_b_words.clone(),
+        _=>return Err("prefork bad activation side".into()),
+    };
+    if span.len()!=WIDTH as usize {return Err("prefork exact width mismatch".into());}
+    words(s,span)
+}
+fn axes(a:&[u32],layout:&[u32;8])->Result<[u32;8]> {
+    let mut x=[0;8];
+    for (i,k) in layout.iter().enumerate(){
+        x[i]=*a.get(*k as usize).ok_or("prefork tap outside active bank")?;
+        if !f32::from_bits(x[i]).is_finite(){return Err("nonfinite prefork tap".into());}
+    }
+    Ok(x)
+}
+fn sides(a:u8,b:u8,n:u8)->bool {
+    a<2 && b<2 && (1..=4).contains(&n) && a^(n&1)==b
+}
+fn gates(x:[u32;8],axes:&[u32;8],rows:&[V11Expectation;3])->Result<[(u32,bool);3]> {
+    let mut out=[(0,false);3];
+    let f=|n|->Result<f32>{
+        let j=axes.iter().position(|&k|k==n).ok_or("missing independently bounded operand")?;
+        Ok(f32::from_bits(x[j]))
+    };
+    // Taps are actual +1/-1, independently checked against both native
+    // descriptors. Calculation is operand-derived, never an observed GPU mask.
+    for (i,r) in rows.iter().enumerate() {
+        let excess=(f(r.operand_a)?-f(r.operand_b)?)-f32::from_bits(r.threshold_bits);
+        if !excess.is_finite(){return Err("nonfinite V11 excess".into());}
+        out[i]=(excess.to_bits(),excess>0.0);
+    }
+    Ok(out)
+}
+fn gather_binding(s:&Snapshot,pf:&VerifiedStockV11Profile)->Result<(u32,String)>{
+    let plan=s.phenotype.speech_decoder().ok_or("no native SpeechPayload")?;
+    plan.validate_against(&s.phenotype)?;
+    let c=plan.decoder_synapse_start();
+    let info=s.brain_slot.record();
+    if plan.head()!=DecoderHeadKind::SpeechPayload || plan.input_width()!=32 || plan.output_width()!=32
+       || plan.decoder_synapse_count()!=COUNT || c!=pf.canonical_payload
+       || s.phenotype.synapses().len()!=32768 {
+        return Err("prefork typed mature payload plan changed".into());
+    }
+    // The canonical phenotype is NOT in the backend-head order. Use the
+    // same pure native packing API used to admit the original phenotype.
+    let u=GpuPhenotypeUpload::try_from(s.phenotype.as_ref())?;
+    let base_recurrent=u32::try_from(u.source_indices.len())?;
+    if base_recurrent!=pf.base_recurrent || u.decoder_eligibility_metadata.len() as u32!=32768-base_recurrent
+        || u.canonical_to_local_synapse.len()!=32768 || u.synapse_learning_metadata.len()!=32768
+        || u.decoder_eligibility_metadata.iter().filter(|m|m.decoder_head==DecoderHeadKind::SpeechPayload.raw()).count()!=COUNT as usize {
+        return Err("genuine stock auxiliary decoder packing differs".into());
+    }
+    // Native bucket.rs:3396–3407 increments each decoder global ID on
+    // actual recurrent-prefix insertion. The independent stock profile
+    // commits the original count, also checked on the actual short snapshot.
+    let delta=info.recurrent_synapse_count.checked_sub(base_recurrent).ok_or("missing live recurrent prefix")?;
+    if delta!=pf.live_prefix_insertion || info.synapse_count.checked_sub(32768)!=Some(delta)
+       || s.structural_synapses.len()!=delta as usize
+       || s.structural_synapses.iter().any(|e|e.slot_index>=info.recurrent_synapse_count) {
+        return Err("no exact typed mature live decoder displacement".into());
+    }
