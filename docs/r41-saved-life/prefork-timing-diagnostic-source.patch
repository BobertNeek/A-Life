+           &t.profile_sha256,&t.independent_profile_proof_sha256]
+          .iter().any(|p|!pin(p)){
+        return Err("separate scoped true Note19 root authority refused".into());
+    }
+    if s.root_ticket_sha256!=root_sha || s.case_id!=t.case_id || s.run_id!=t.run_id
+        || s.evaluator_sha256!=t.evaluator_sha256 || s.raw_proc_environ_sha256!=t.raw_proc_environ_sha256
+        || s.argv_sha256!=t.argv_sha256 || s.boot!=t.boot || s.manifest_sha256!=t.manifest_sha256
+        || (s.fence_device,s.fence_inode)!=(t.fence_device,t.fence_inode)
+        || s.actual_start_monotonic_ns==0 || s.case_pair_sha256!=t.case_pair_sha256 || s.foil_pair_sha256!=t.foil_pair_sha256
+        || digest(&bounded(Path::new("/proc/self/environ"),1<<20)?)!=s.raw_proc_environ_sha256
+        || digest(&bounded(Path::new("/proc/self/cmdline"),64<<10)?)!=s.argv_sha256 || hash_exe(Path::new("/proc/self/exe"))?!=s.evaluator_sha256{
+        return Err("guarded Note19 real process executable/argv/environment differs".into());
+    }
+    let controller=Path::new("/proc").join(peer_pid.to_string());
+    if hash_exe(&controller.join("exe"))?!=s.custody_identity.controller_exe_sha256
+      || digest(&bounded(&controller.join("cmdline"),64<<10)?)!=s.custody_identity.controller_argv_sha256
+      || digest(&bounded(&controller.join("environ"),1<<20)?)!=s.custody_identity.controller_environ_sha256
+      || process(peer_pid)?!=s.parent{
+        return Err("actual separately pinned controller launch identity refused".into());
+    }
+    // This channel conveys the independent host pin, not an expected digest
+    // supplied by the profile file. The private controller must have already
+    // checked the same immutable permit and profile BEFORE spawn.
+    let leaves=&s.custody_identity.authority_leaves;
+    let permit=private_bound(&e.room.join("note19-profile-permit.json"),8192,Some(&leaves[1]))?;
+    let profile=private_bound(&e.room.join("note19-stock-v11-profile.json"),8192,Some(&leaves[2]))?;
+    let proof=private_bound(&e.room.join("note19-stock-profile-proof.json"),8192,Some(&leaves[3]))?;
+    if !s.custody_identity.actual(exact_private_directory(e.root,owner_uid)?,exact_private_directory(e.room,owner_uid)?){
+        return Err("independently stamped private rooms changed".into());
+    }
+    let profile=verify_profile(&permit,&profile,&proof,&s.permit_sha256,&s.profile_sha256,
+        &s.independent_profile_proof_sha256,&root_sha,&t,&s.custody_identity)?;
+    let m=fs::File::from(duplicate(d.residual_memfd)?);
+    let k=m.metadata()?;
+    let link=fs::read_link(format!("/proc/self/fd/{}",d.residual_memfd))?;
+    if !link.to_string_lossy().starts_with("/memfd:qualia-note19-held") || k.len()!=CAP || k.nlink()!=0
+      || k.uid()!=fs::metadata(format!("/proc/{}",s.parent.pid))?.uid()
+      || k.mode()&0o077!=0 || get_seals(&m)!=PRESEAL{
+        return Err("required anonymous verifier-only sized custody missing".into());
+    }
+    let mut zero=[0u8;4];m.read_exact_at(&mut zero,0)?;
+    if zero!=[0;4]{return Err("cannot reuse previously populated custody".into());}
+    let verified=ordinary_ingress_predecessor::prove_timing_ancestry(e.root, e.case_id,e.run_id,e.current_sha256,
+        e.semantic_sha256, e.owner,e.nonce,&s,&profile)?;
+    Ok(Scope{case_id:t.case_id,run_id:t.run_id,root_ticket_sha256:root_sha,actual_start_sha256:start_sha,
+        scorecard_eligible:false,verified,start:s,profile,fence_fd:d.fence_fd,m})
+}
