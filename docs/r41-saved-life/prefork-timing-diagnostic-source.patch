+fn current_identity(s:&HostStart,fence:i32)->Result<()>{
+    if process(s.child.pid)?!=s.child || process(s.parent.pid)?!=s.parent
+        || std::process::id()!=s.child.pid || s.child.ppid!=s.parent.pid
+        || s.child.pgrp!=s.child.pid || s.child.session!=s.child.pid
+        || actual_boot()?!=s.boot{
+        return Err("lost actual diagnostic parent/start/pidfd provenance".into());
+    }
+    let l=fs::metadata(format!("/proc/{}/fd/{fence}",s.child.pid))?;
+    let p=fs::metadata(format!("/proc/{}/fd/{fence}",s.parent.pid))?;
+    if (l.dev(),l.ino())!=(s.fence_device,s.fence_inode) || (p.dev(),p.ino())!=(l.dev(),l.ino())
+        || lockline(s.child.pid,fence)?!=lockline(s.parent.pid,fence)?{
+        return Err("lost already-held common process OFD".into());
+    }
+    Ok(())
+}
+pub(super) fn authorize(d:Descriptors,e:Expected<'_>)->Result<Scope>{
