+fn material_fork_row(raw:&[u8],tick:u64,actor:u64)->Result<ForkFrame>{
+    let q:serde_json::Value=serde_json::from_slice(raw)?;
+    if q["decision_tick"]!=tick || q["organism"]!=actor{
+        return Err("Note19 nonmatched physical fork row".into());
+    }
+    let list=q["joint_physical"]["channel_outcomes"].as_array().ok_or("no actual per-channel paid execution")?;
+    let mut it=list.iter().filter(|x|x["channel"]=="Locomotion");
+    let x=it.next().ok_or("no genuine locomotion cut")?;
+    if it.next().is_some(){return Err("ambiguous physical locomotion".into());}
+    let e=&x["execution_evidence"];let p=&x["physical"];
+    let f=|v:&serde_json::Value|->Result<u32>{
+        let x=v.as_f64().ok_or("missing actual f32 physical value")? as f32;
+        if !x.is_finite(){return Err("nonfinite actual locomotion".into());}
+        Ok(x.to_bits())
+    };
+    let locomotion=ForkSlice{
+        primitive:u32::try_from(e["primitive"].as_u64().ok_or("missing real primitive")?)?,
+        succeeded:e["succeeded"].as_bool().ok_or("missing actual execution status")?,
+        contact:p["contact"].as_str().ok_or("missing actual contact")?.to_owned(),
+        direction_bits:[f(&p["displacement"]["x"])?,f(&p["displacement"]["y"])?,f(&p["displacement"]["z"])?],
+        paid_energy_bits:f(&p["energy_cost"])?,
+    };
+    let mut physics=Vec::with_capacity(list.len());
+    for channel in list {
+        let mut q=channel.clone();
+        q["execution_evidence"].as_object_mut().ok_or("missing per-slot execution")?.remove("command_target");
+        q["physical"].as_object_mut().ok_or("missing per-slot physics")?.remove("target_entity");
+        physics.push(q);
+    }
+    let pose_before=q["observer_pose_before"].as_array().ok_or("missing real pre-action pose")?.clone();
+    let pose_after=q["observer_pose_after"].as_array().ok_or("missing real post-action pose")?.clone();
+    if pose_before.len()!=2 || pose_after.len()!=2 {return Err("invalid original body pose cut".into());}
+    Ok(ForkFrame{locomotion,physics,pose_before,pose_after})
+}
