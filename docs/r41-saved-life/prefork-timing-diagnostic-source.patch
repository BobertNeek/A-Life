+    }
+    let (off,reference)=(timing_final(root,&a.off,owner,profile.first+256)?,timing_final(root,&a.reference,owner,profile.first+256)?);
+    let (bo,br)=(timing_final(root,&b.off,owner,profile.first+256)?,timing_final(root,&b.reference,owner,profile.first+256)?);
+    if !exact_timing_relation(&off,&reference) || !exact_timing_relation(&bo,&br){
+        return Err("true independently matched raw endpoint proof beyond timing-only relation".into());
+    }
+    let e=y.reference_evidence.as_ref().ok_or("actual Reference evidence absent")?;
+    if e.persisted_continuation.next_completed_gpu_time_ns!=reference.actual_next_gpu_ns
+       || e.persisted_continuation.throttle_sequence_digest!=reference.actual_throttle_seal{
+        return Err("actual native Reference persisted continuation wire mismatch".into());
+    }
+    let arm=|h:&Arm|ArmKey {run_id:h.run_id.clone(),signed_root_ticket_sha256:h.authority_sha256.clone(),
+        started_witness_sha256:h.started_sha256.clone(),process_group_identity_sha256:h.process_sha256.clone(),
+        exact_native_retention_sha256:h.native_receipt_sha256.clone(),exact_raw_rows_sha256:h.rows_sha256.clone()};
+    let common=digest(&serde_json::to_vec(&(&start.boot,start.fence_device,start.fence_inode,
+        &start.raw_proc_environ_sha256,&y.exact_hardware,&y.exact_sampler_after))?);
+    Ok(TimingAncestry{native_setup_sha256:a.native_setup_sha256.clone(),actual_reference_hardware:y.exact_hardware.clone(),
+        actual_reference_final_sampler:y.exact_sampler_after.clone(),case:IndependentlyClosedCase{
+        case_id:a.case_id,matched_current_sha256:current.into(),actual_executing_elf_sha256:start.evaluator_sha256.clone(),
+        frozen_case_and_native_setup_sha256:a.native_setup_sha256,
+        actual_boot_environment_hardware_and_seed_sha256:common,independent_disposition_sha256:start.case_pair_sha256.clone(),
+        selected_reference_state_sha256:e.state_window_sha256.clone(),
+        selected_reference_complete_projected_rows_sha256:e.ordinary_action_evidence_sha256.clone(),
+        actual_off:arm(&a.off),actual_reference:arm(&a.reference),off_raw_endpoint:off,reference_raw_endpoint:reference,
+    }})
+}
