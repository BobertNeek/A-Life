+    let b:Acceptance=json_leaf(&checked_path(root,"note19-counterfactual-case.json")?,&start.foil_pair_sha256,SMALL)?;
+    let (root_label,foil_label)=(profile.primary_case.as_str(),profile.foil_case.as_str());
+    if a.case_id!=case || ![(root_label,foil_label),(foil_label,root_label)].contains(&(a.case_id.as_str(),b.case_id.as_str()))
+       || a.case_id==b.case_id || a.owner!=owner || b.owner!=owner || a.current_sha256!=current || b.current_sha256!=current
+       || a.evaluation_nonce!=nonce || b.evaluation_nonce!=nonce || a.initial_phenotype_sha256!=b.initial_phenotype_sha256
+       || a.sampling_sha256!=b.sampling_sha256 || a.native_setup_sha256==b.native_setup_sha256{
+        return Err("Note19 independently matched real pair roles/source did not join".into());
+    }
+    let compare_scope=digest(&serde_json::to_vec(&(super::ordinary_ingress_observer::PURPOSE,semantic,nonce,profile.first))?);
+    if a.scope_sha256!=compare_scope{return Err("actually prepared same-case semantic setup differs".into());}
+    let (x,y)=same_new_pair(root,&a,run,start,profile)?;let (u,v)=same_new_pair(root,&b,run,start,profile)?;
+    let all=[&a.off,&a.reference,&b.off,&b.reference];
+    let names=all.iter().map(|k|k.run_id.as_str()).collect::<std::collections::BTreeSet<_>>();
+    let rooms=all.iter().map(|k|k.relative_room.as_str()).collect::<std::collections::BTreeSet<_>>();
+    let ids=[&x.process.child,&y.process.child,&u.process.child,&v.process.child];
+    if names.len()!=4 || rooms.len()!=4 || ids.iter().enumerate().any(|(i,p)|ids[..i].iter().any(|q| q.pid==p.pid && q.namespace==p.namespace && q.proc_start_ticks==p.proc_start_ticks))
