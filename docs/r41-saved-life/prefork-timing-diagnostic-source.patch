+#[derive(Debug,Clone,PartialEq,Eq,Serialize)]
+pub(super) struct Endpoint {
+    pub raw_sha256:String,
+    pub body_without_timing_sha256:String,
+    pub world_without_timing_sha256:String,
+    pub journal_without_timing_sha256:String,
+    pub actual_next_gpu_ns:u64,
+    pub actual_throttle_seal:[u64;4],
+    pub actual_world_anchor:String,
+    pub actual_journal_seal:[u64;4],
+    pub actual_private_life_sha256:String,
+}
+
+pub(super) fn endpoint(raw:&[u8],trusted_raw:&str,actor:u64,tick:u64)->Result<Endpoint>{
+    if raw.len()<=HEADER || raw.len()>LIMIT || &raw[..16]!=b"ALIFE-CURRENT-1\n"
+        || u64::from_le_bytes(raw[16..24].try_into()?)!=(raw.len()-HEADER) as u64
+        || Sha256::digest(&raw[HEADER..])[..]!=raw[24..HEADER] || digest(raw)!=trusted_raw{
+        return Err("false exact native checkpoint bytes/header SHA".into());
+    }
+    let body=&raw[HEADER..];
+    let [life,tag]=members(body,["life","same_individual"])?;
+    let [world_quote,journal_quote]=members(life,["world_json","sleep_journal_json"])?;
+    let [life_hash_raw]=members(tag,["private_life_sha256"])?;
+    let life_hash:String=native_scalar(life_hash_raw)?;
+    if digest(life)!=life_hash || world_quote.len()>NESTED || journal_quote.len()>NESTED{
+        return Err("false private-life seal or nested extent".into());
+    }
+    let world:String=native_scalar(world_quote)?;
+    let journal:String=native_scalar(journal_quote)?;
+    let world_raw=world.as_bytes();let journal_raw=journal.as_bytes();
+    let portable=PortableSaveFile::from_json_str(&world)?;
+    if portable.creatures.len()!=1 || portable.creatures[0].organism_id.raw()!=actor
+        || portable.world.tick.raw()!=tick{
+        return Err("unmatched single actor or World final cut".into());
+    }
+    let gpu=portable.creatures[0].gpu_brain.as_ref().ok_or("missing living GPU stock")?;
+    if gpu.checkpoint_tick.raw()!=tick{return Err("native cognitive endpoint differs".into());}
+    let [creatures]=members(world_raw,["creatures"])?;
+    let [gpu_raw]=members(single(creatures)?,["gpu_brain"])?;
+    let [throttle_raw]=members(gpu_raw,["throttle_replay"])?;
+    let [next_raw,sequence_raw]=members(throttle_raw,["next_completed_gpu_time_ns","sequence_digest"])?;
+    let next:u64=native_scalar(next_raw)?;let seq:[u64;4]=native_scalar(sequence_raw)?;
+    let t:ThrottleReplaySaveState=serde_json::from_slice(throttle_raw)?;
+    t.validate()?;
+    let previous=t.last_checkpoint.as_ref().ok_or("no actual previously applied throttle")?;
+    if t!=gpu.throttle_replay || t.next_completed_gpu_time_ns!=next || t.sequence_digest!=seq
+        || next==0 || previous.completed_gpu_time_ns!=0 || previous.organism_id_raw!=actor
+        || previous.tick.checked_add(1)!=Some(tick) || t.last_world_atp_tick!=Some(previous.tick){
+        return Err("unsupported pressure/timing evidence".into());
+    }
+    let [anchor_raw,journal_seal_raw]=members(journal_raw,["exact_base_manifest_digest","journal_digest"])?;
+    let anchor:String=native_scalar(anchor_raw)?;let journal_seal:[u64;4]=native_scalar(journal_seal_raw)?;
+    let j:GpuSleepTransactionJournalV2=serde_json::from_slice(journal_raw)?;
+    j.validate()?;
+    let observed_anchor=PortableAssetDigest::for_bytes(&pretty_compact(world_raw)?).0;
+    if !j.entries.is_empty() || j.exact_base_checkpoint_tick.raw()!=tick
+        || j.journal_digest!=journal_seal || j.exact_base_manifest_digest!=anchor || observed_anchor!=anchor{
+        return Err("false actual exact world anchor or sleep journal seal".into());
+    }
+    let w=project_hash(world_raw,vec![(span(world_raw,next_raw)?,b"0".to_vec()),
+        (span(world_raw,sequence_raw)?,b"[0,0,0,0]".to_vec())])?;
+    let s=project_hash(journal_raw,vec![(span(journal_raw,anchor_raw)?,b"0".to_vec()),
+        (span(journal_raw,journal_seal_raw)?,b"[0,0,0,0]".to_vec())])?;
+    let body_digest=project_hash(body,vec![
+        (span(body,world_quote)?,serde_json::to_vec(&format!("fixed-world:{w}"))?),
+        (span(body,journal_quote)?,serde_json::to_vec(&format!("fixed-journal:{s}"))?),
+        (span(body,life_hash_raw)?,b"0".to_vec())])?;
+    Ok(Endpoint{raw_sha256:trusted_raw.into(),body_without_timing_sha256:body_digest,
+        world_without_timing_sha256:w,journal_without_timing_sha256:s,
+        actual_next_gpu_ns:next,actual_throttle_seal:seq,actual_world_anchor:anchor,
+        actual_journal_seal:journal_seal,actual_private_life_sha256:life_hash})
+}
+
+pub(super) fn exact_timing_relation(a:&Endpoint,b:&Endpoint)->bool{
+    a.raw_sha256!=b.raw_sha256 && a.actual_next_gpu_ns!=b.actual_next_gpu_ns
+      && a.actual_world_anchor!=b.actual_world_anchor && a.actual_private_life_sha256!=b.actual_private_life_sha256
+      && a.actual_throttle_seal.iter().zip(b.actual_throttle_seal).all(|(x,y)|*x!=y)
+      && a.actual_journal_seal.iter().zip(b.actual_journal_seal).all(|(x,y)|*x!=y)
+      && a.body_without_timing_sha256==b.body_without_timing_sha256
+      && a.world_without_timing_sha256==b.world_without_timing_sha256
+      && a.journal_without_timing_sha256==b.journal_without_timing_sha256
+}
+
+#[cfg(test)]
+mod tests{
