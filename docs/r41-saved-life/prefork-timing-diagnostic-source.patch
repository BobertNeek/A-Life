+       || pre.active_weight_generation!=b.active_weight_generation
+       || post.active_weight_generation!=b.active_weight_generation
+       || pre.active_weight_bank!=post.active_weight_bank
+       || post.logical_dispatch_generation!=b.dispatch_generation
+       || step.throttle.dispatch_generation!=b.dispatch_generation
+       || step.throttle.pressure.completed_gpu_time_ns!=0
+       || step.work.counters.microsteps!=u32::from(n)
+       || step.work.counters.neuron_updates!=u64::from(WIDTH)*u64::from(n) {
+        return Err("not actual matched pre/post resident boundary".into());
+    }
+    let q=pre.v11.dendritic_branches.branches();
+    if q.len()!=pf.branch_count || q!=post.v11.dendritic_branches.branches(){
+        return Err("actual V11 descriptor provenance changed".into());
+    }
+    for r in &pf.rows{
+        let d=q.get(r.ordinal).ok_or("missing exact independent stock V11 ordinal")?;
+        if d.target!=r.target || d.threshold.to_bits()!=r.threshold_bits || d.output_gain.to_bits()!=r.output_gain_bits
+           || d.inputs.len()!=2 || d.inputs[0].source!=r.operand_a || d.inputs[0].weight.to_bits()!=1f32.to_bits()
+           || d.inputs[1].source!=r.operand_b || d.inputs[1].weight.to_bits()!=(-1f32).to_bits(){
+            return Err("not the three exact independently bound stock payload V11 branches".into());
+        }
+    }
+    let first=axes(bank(pre,pre.active_activation_side)?,&pf.axes)?;
+    // The final dispatch reads its predecessor from the other ping-pong
+    // bank. On 3 microsteps its middle predecessor has been overwritten.
+    let last=if n>1 {axes(bank(post,post.active_activation_side^1)?,&pf.axes)?} else {first};
+    let active=bank(post,post.active_activation_side)?;
+    let activations=active.get(pf.speech_input as usize..(pf.speech_input+W) as usize).ok_or("missing 32 final payload inputs")?;
+    if activations.iter().any(|v|!f32::from_bits(*v).is_finite()){
+        return Err("nonfinite actual final payload input".into());
+    }
+    let (global_start,immutable_digest,matrix)=payload(post,pf)?;
+    let h=serde_json::to_vec(&serde_json::json!({
+        "schema":"qualia.private.r44.prefork_residual_frame.v1",
+        "organism":b.organism_id,"tick":tick,"frame_digest":b.frame_digest,
+        "slot":pre.handle.slot(),"slot_generation":pre.handle.generation(),
+        "phenotype":post.phenotype.phenotype_hash(),"actual_dispatch":b.dispatch_generation,
+        "enabled_routes":step.throttle.enabled_route_ids,
+        "route_schedule_digest":step.throttle.route_schedule_digest,
+        "actual_microsteps":n,"represented_microstep_sources":[0,n-1],
+        "unrecorded_middle_microsteps":n.saturating_sub(2),
+        "axes":pf.axes,"native_first_firing_operand_bits":first,"native_last_firing_operand_bits":last,
+        "v11_first_derived_pre_gate_excess_bits_and_open":gates(first,&pf.axes,&pf.rows)?,
+        "v11_last_derived_pre_gate_excess_bits_and_open":gates(last,&pf.axes,&pf.rows)?,
+        "v11_typed_rows":pf.rows.each_ref().map(|r|r.ordinal),"authoritative_observed_gpu_gate_mask":false,
+        "active_weight_generation":b.active_weight_generation,"active_weight_bank":post.active_weight_bank,
+        "payload_live_global_start":global_start,"payload_mutable_word_order":["fast","lifetime"],
+        "payload_immutable_genetic_alpha_words_sha256":immutable_digest,
+        "payload_activation_count":W,"payload_coordinate_count":COUNT,
+        "scorecard_eligible":false,"continuation_equivalent":false,"authorizes_capture":false,
+    }))?;
+    let mut bytes=Vec::with_capacity(4+h.len()+4*(activations.len()+matrix.len()));
+    bytes.extend_from_slice(&u32::try_from(h.len())?.to_le_bytes());
+    bytes.extend_from_slice(&h);
+    for v in activations.iter().chain(matrix.iter()){bytes.extend_from_slice(&v.to_le_bytes());}
+    if bytes.len()>MAX_BYTES/7 {return Err("prefork seven-cut aggregate wire cap".into());}
+    Ok(bytes)
+}
