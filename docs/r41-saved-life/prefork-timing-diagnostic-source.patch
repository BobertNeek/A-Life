+           || m.input_lane!=i/W || m.motor_index!=syn.source() || m.reserved!=0
+           || p.global_synapse_id!=g0 || p.source_neuron!=syn.source() || p.target_neuron!=syn.target()
+           || p.kind!=syn.kind().kind_raw() || gene!=syn.genetic_weight().to_bits() || alpha!=syn.alpha().to_bits() {
+            return Err("true native packed payload coordinate/metadata/bit mapping mismatch".into());
+        }
+        let live=g0.checked_add(delta).ok_or("live payload ID overflow")?;
+        let first=*start.get_or_insert(live);
+        if first.checked_add(i)!=Some(live){
+            return Err("actual packed payload mapping is not a contiguous typed 32x32 slice".into());
+        }
+        immutable.update(gene.to_le_bytes()); immutable.update(alpha.to_le_bytes());
+    }
+    let g=start.ok_or("empty live payload binding")?;
+    if g.checked_add(COUNT)!=Some(info.synapse_count){
+        return Err("actual checked payload mapping does not terminate at live bank extent".into());
+    }
+    Ok((g,format!("{:x}",immutable.finalize())))
+}
+fn payload(s:&Snapshot,pf:&VerifiedStockV11Profile)->Result<(u32,String,Vec<u32>)>{
+    let (g,immutable)=gather_binding(s,pf)?;
+    let r=s.brain_slot.word_ranges();
+    let trim=|b:&Range<u32>|->Result<Range<u32>>{
+        let i=b.start.checked_add(g).ok_or("weight start overflow")?;
+        let j=i.checked_add(COUNT).ok_or("weight end overflow")?;
+        if j>b.end{return Err("payload outside active bank extent".into());}
+        Ok(i..j)
+    };
+    let (f,l)=match s.active_weight_bank {
+        0=>(&r.fast_weight_words,&r.lifetime_weight_words),
+        1=>(&r.fast_weight_bank_1_words,&r.lifetime_weight_bank_1_words),
+        _=>return Err("invalid active native payload weight bank".into()),
+    };
+    let f=words(s,trim(f)?)?; let l=words(s,trim(l)?)?;
+    let mut out=Vec::with_capacity(COUNT as usize*2);
+    for (&fast,&life) in f.iter().zip(l) {
+        if !f32::from_bits(fast).is_finite() || !f32::from_bits(life).is_finite(){
+            return Err("nonfinite same-generation payload weight".into());
+        }
+        out.extend_from_slice(&[fast,life]);
+    }
+    Ok((g,immutable,out))
+}
