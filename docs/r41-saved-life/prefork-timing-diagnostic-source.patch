+fn resolve_prefork_timing_diagnostic(root:&Path, room:&Path, bytes:&[u8])->Result<ResolvedExperiment>{
+    use super::ordinary_ingress_native_custody as diag;
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Envelope{schema:u16,settings:ManifestV1,custody:diag::Descriptors}
+    if bytes.len()>MAX_SMALL_CONFIG_BYTES{return Err("Note19 typed manifest exceeds cap".into());}
+    let e:Envelope=serde_json::from_slice(bytes)?;
+    let card=e.settings.card_case.as_deref().and_then(super::card_cases::case)
+        .ok_or("Note19 requires a genuine published Root/foil case")?;
+    if e.schema!=diag::SCHEMA || e.settings.schema!=1 || e.settings.scenario!=ScenarioV1::PublishedCardCase
+       || !matches!(&e.settings.intervention,InterventionV1::Control{})
+       || !card.player_tokens.is_empty() || card.navigation.is_some()
+       || e.settings.max_decisions!=256 || e.settings.max_world_ticks!=256
+       || e.settings.max_output_bytes!=256*1024*1024
+       || std::env::var("ALIFE_EXPLICIT_FIXED_HOST_PRESSURE_NS").as_deref()!=Ok("0"){
+        return Err("Note19 only permits unchanged cue-free stock Control 256/256 with real fixed applied pressure 0".into());
+    }
+    let mut p=resolve(&serde_json::to_vec(&e.settings)?)?;
+    let exact_manifest=digest(bytes);
+    let scope=diag::authorize(e.custody,diag::Expected{
+        root,room,run_id:&e.settings.run_id,case_id:e.settings.card_case.as_deref().ok_or("Note19 case missing")?,
+        current_sha256:&e.settings.source_current_sha256,actual_manifest_sha256:&exact_manifest,
+        owner:e.settings.owner,nonce:e.settings.evaluation_nonce,semantic_sha256:&p.identity.semantic_settings_sha256,
+    })?;
+    p.identity.schema=diag::SCHEMA;p.identity.manifest_sha256=exact_manifest;p.identity.prefork_timing_diagnostic=Some(scope);
+    Ok(p)
 }
 
