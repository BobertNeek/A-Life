+fn actual_fork(root:&[ForkFrame],foil:&[ForkFrame])->bool{
+    root.len()==7 && foil.len()==7 && root[..6]==foil[..6] && root[6]!=foil[6] && root[6].pose_before==foil[6].pose_before
+      && root[6].locomotion.primitive==103 && f32::from_bits(root[6].locomotion.paid_energy_bits)==0.0
+      && root[6].locomotion.direction_bits.iter().all(|x|f32::from_bits(*x)==0.0)
+      && foil[6].locomotion.primitive==101 && foil[6].locomotion.succeeded && foil[6].locomotion.contact=="Moved"
+      && f32::from_bits(foil[6].locomotion.paid_energy_bits)>0.0
+      && foil[6].locomotion.direction_bits.iter().any(|x|f32::from_bits(*x)!=0.0)
+}
