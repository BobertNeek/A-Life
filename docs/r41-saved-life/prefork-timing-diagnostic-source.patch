+pub(super) struct Held<'a>{
+    s:&'a Scope, count:usize,cuts:usize,state:Sha256,action:Sha256,bytes:Vec<u8>,failed:bool,
+}
+impl<'a> Held<'a>{
+    pub(super) fn new(s:&'a Scope,tick:u64)->Result<Self>{
+        if tick!=s.profile.first{return Err("Note19 not at authentic opening".into());}
+        Ok(Self{s,count:0,cuts:0,state:Sha256::new(),action:Sha256::new(),bytes:b"ALIFE-NOTE19-PREFORK-1\n".to_vec(),failed:false})
+    }
+    pub(super) fn observe(&mut self,step:&crate::FoundationTrainingStep,row:&[u8]){
+        if !self.failed && self.cut(step,row).is_err(){self.failed=true;self.bytes.clear();}
+    }
+    fn cut(&mut self,step:&crate::FoundationTrainingStep,row:&[u8])->Result<()>{
+        let tick=step.frame.tick().raw();
+        if tick!=self.s.profile.first+self.count as u64 || self.count>=256{return Err("new diagnostic row not sequential".into());}
+        ordinary_ingress_row_parity::update(&mut self.action,row,self.count,step.frame.organism_id().raw(),tick)?;
+        if self.count<8{
+            let par=ordinary_ingress_observer::capture(step)?;
+            self.state.update(u32::try_from(par.len())?.to_le_bytes());
+            self.state.update(&par);
+        }
+        if tick<=self.s.profile.fork{
+            let v=residual::build(step,&self.s.profile)?;
+            if self.bytes.len()+4+v.len()>residual::MAX_BYTES{return Err("new diagnostic residual cap".into());}
+            self.bytes.extend_from_slice(&u32::try_from(v.len())?.to_le_bytes());
+            self.bytes.extend_from_slice(&v);self.cuts+=1;
+        }
+        self.count+=1;
+        Ok(())
+    }
+    pub(super) fn finish(self,output:&Path,integrity:bool,receipt:&serde_json::Value)->Result<Pending<'a>>{
+        if !integrity||self.failed||self.count!=256||self.cuts!=D::CUTS{return Err("Note19 complete held capture is not qualified".into());}
+        let s=self.s;
+        current_identity(&s.start,s.fence_fd)?;
+        let raw_sha=receipt["final_endpoint"]["sha256"].as_str().filter(|x|pin(x)).ok_or("actual Note19 final already published is missing")?;
+        let rows=receipt["rows_sha256"].as_str().filter(|x|pin(x)).ok_or("actual raw rows missing")?;
+        let raw=private(&output.join("final.alife-checkpoint"),64<<20)?;
+        let end=timing::endpoint(&raw,raw_sha,s.profile.owner,s.profile.first+256)?;
+        drop(raw);
+        let state=format!("{:x}",self.state.finalize());
+        let action=format!("{:x}",self.action.finalize());
+        let observed_setup=digest(&serde_json::to_vec(&receipt["published_case_setup"])?);
+        if receipt["retained_experiment"]["identity"]["run_id"]!=s.run_id || observed_setup!=s.verified.native_setup_sha256
+           || receipt["retained_experiment"]["identity"]["manifest_sha256"]!=s.start.manifest_sha256
+           || receipt["source_sha256"]!=s.verified.case.matched_current_sha256
+           || receipt["hardware"]!=s.verified.actual_reference_hardware
+           || receipt["sampling_after"]!=s.verified.actual_reference_final_sampler
+           || raw_sha==s.verified.case.off_raw_endpoint.raw_sha256 || raw_sha==s.verified.case.reference_raw_endpoint.raw_sha256
+           || rows==s.verified.case.actual_off.exact_raw_rows_sha256 || rows==s.verified.case.actual_reference.exact_raw_rows_sha256{
+            return Err("actual new run alias or incompatible setup".into());
+        }
+        let f=D::diagnostic_disposition(&s.verified.case,&FreshDiagnosticCandidate{
+            authority_purpose:D::PURPOSE,authorized_independent_disposition_sha256:&s.start.case_pair_sha256,
+            signed_fresh_diagnostic_ticket_sha256:&s.root_ticket_sha256,matched_current_sha256:&s.verified.case.matched_current_sha256,
+            actual_executing_elf_sha256:&s.start.evaluator_sha256,frozen_case_and_native_setup_sha256:&observed_setup,
+            actual_boot_environment_hardware_and_seed_sha256:&s.verified.case.actual_boot_environment_hardware_and_seed_sha256,
+            case_id:&s.case_id,run_id:&s.run_id,actual_ordinary_persisted_original:&end,
+            actual_state_window_sha256:&state,actual_complete_projected_rows_sha256:&action,
+            actual_control_decisions:self.count,actual_world_ticks:receipt["world_ticks"].as_u64().unwrap_or(0),
+        })?;
+        let mut out=serde_json::to_value(f)?;
+        out["ready_for_private_custody_verification"]=serde_json::json!(true);
+        out["actual_start_sha256"]=serde_json::json!(s.actual_start_sha256);
+        out["root_ticket_sha256"]=serde_json::json!(s.root_ticket_sha256);
+        out["run_id"]=serde_json::json!(s.run_id);
+        out["private_profile_permit_sha256"]=serde_json::json!(s.start.permit_sha256);
+        out["private_expected_profile_sha256"]=serde_json::json!(s.start.profile_sha256);
+        out["actual_raw_rows_sha256"]=serde_json::json!(rows);
+        out["actual_raw_endpoint_sha256"]=serde_json::json!(raw_sha);
+        out["actual_state_window_sha256"]=serde_json::json!(state);
+        out["actual_complete_projected_rows_sha256"]=serde_json::json!(action);
+        out["held_payload_sha256"]=serde_json::json!(digest(&self.bytes));
+        out["held_payload_bytes"]=serde_json::json!(self.bytes.len());
+        Ok(Pending{s,bytes:self.bytes,observation:out})
+    }
+}
+pub(super) struct Pending<'a>{s:&'a Scope,bytes:Vec<u8>,pub observation:serde_json::Value}
+impl Pending<'_>{
+    pub(super) fn seal_after_receipt(self)->Result<()>{
+        current_identity(&self.s.start,self.s.fence_fd)?;
+        let f=&self.s.m;
+        if get_seals(f)!=PRESEAL || self.bytes.is_empty() || self.bytes.len()>residual::MAX_BYTES{
+            return Err("unavailable bounded anonymous custody".into());
+        }
+        // Only the real accepted native candidate's memory crosses to the
+        // verifier-owned anonymous file, AFTER the real native receipt.
+        f.write_all_at(&u32::try_from(self.bytes.len())?.to_le_bytes(),0)?;
+        f.write_all_at(&self.bytes,4)?;
+        f.sync_all()?;
+        let rc=unsafe{fcntl(f.as_raw_fd(),ADD,0x1|0x8)};
+        if rc!=0 || get_seals(f)!=SEALED{return Err("unqualified sealed custody, do not consume".into());}
+        Ok(())
+    }
+}
