+//! Default-off diagnostic endpoint relation. Does not grant any role, change
+//! either checkpoint, change schema81, or certify a continuation.
+//! Caller must separately bind genuine native raw reads/parents before use.
+use super::*;
+use alife_runtime::GpuSleepTransactionJournalV2;
+use alife_world::{PortableAssetDigest, PortableSaveFile, ThrottleReplaySaveState};
+use serde::{Deserialize, Serialize};
+use std::{collections::BTreeSet, ops::Range};
+
+const HEADER:usize=56;
+const LIMIT:usize=64*1024*1024;
+const NESTED:usize=8*1024*1024;
+
+fn ws(b:u8)->bool{matches!(b,b' '|b'\r'|b'\n'|b'\t')}
+fn trim(mut b:&[u8])->&[u8]{
+    while b.first().copied().is_some_and(ws){b=&b[1..];}
+    b
+}
+fn take<'a,T:Deserialize<'a>>(r:&mut &'a [u8])->Result<T>{
+    *r=trim(r);
+    let raw=*r;
+    let mut it=serde_json::Deserializer::from_slice(raw).into_iter::<T>();
+    let x=it.next().ok_or("missing JSON token")??;
+    let n=it.byte_offset();
+    if n==0 || n>raw.len(){return Err("invalid lexical token boundary".into());}
+    *r=&raw[n..];
+    Ok(x)
+}
+fn members<'a,const N:usize>(raw:&'a [u8], wanted:[&str;N])->Result<[&'a [u8];N]>{
+    let mut r=trim(raw).strip_prefix(b"{").ok_or("diagnostic object required")?;
+    let mut found=[None;N];
+    let mut seen=BTreeSet::new();
+    loop{
+        let key:String=take(&mut r)?;
+        if seen.len()>=16384 || !seen.insert(key.clone()){return Err("duplicate or excessive diagnostic object members".into());}
+        r=trim(trim(r).strip_prefix(b":").ok_or("missing diagnostic colon")?);
+        let start=r;
+        take::<serde::de::IgnoredAny>(&mut r)?;
+        if let Some(i)=wanted.iter().position(|k|*k==key.as_str()){found[i]=Some(&start[..start.len()-r.len()]);}
+        let q=trim(r);
+        if let Some(t)=q.strip_prefix(b","){r=t;}
+        else if let Some(t)=q.strip_prefix(b"}"){
+            if !trim(t).is_empty(){return Err("trailing diagnostic object".into());}
+            break;
+        }else{return Err("invalid diagnostic object delimiter".into());}
+    }
+    if found.iter().any(Option::is_none){return Err("missing exact projected member".into());}
+    Ok(found.map(|x|x.expect("checked members")))
+}
+fn single(raw:&[u8])->Result<&[u8]>{
+    let mut q=trim(trim(raw).strip_prefix(b"[").ok_or("expected single creature")?);
+    let start=q;
+    take::<serde::de::IgnoredAny>(&mut q)?;
+    let bound=start.len()-q.len();
+    let tail=trim(q).strip_prefix(b"]").ok_or("expected sole creature")?;
+    if !trim(tail).is_empty(){return Err("unexpected creature array tail".into());}
+    Ok(&start[..bound])
+}
+fn span(raw:&[u8],p:&[u8])->Result<Range<usize>>{
+    let a=(p.as_ptr() as usize).checked_sub(raw.as_ptr() as usize).ok_or("projection starts before original")?;
+    let b=a.checked_add(p.len()).ok_or("projection offset overflow")?;
+    if raw.get(a..b)!=Some(p) || a==b{return Err("projection not inside original".into());}
+    Ok(a..b)
+}
+fn project_hash(raw:&[u8],mut changes:Vec<(Range<usize>,Vec<u8>)>)->Result<String>{
+    changes.sort_by_key(|x|x.0.start);
+    let mut h=Sha256::new();let mut at=0;
+    for (r,marker) in changes{
+        h.update(raw.get(at..r.start).ok_or("overlapping projection")?);
+        h.update(marker);at=r.end;
+    }
+    h.update(raw.get(at..).ok_or("outside projection")?);
+    Ok(format!("{:x}",h.finalize()))
+}
+fn native_scalar<'a,T>(x:&'a [u8])->Result<T> where T:Deserialize<'a>+Serialize{
+    let v=serde_json::from_slice(x)?;
+    if serde_json::to_vec(&v)?!=x{return Err("non-native exact timed-field lexeme".into());}
+    Ok(v)
+}
+fn pretty_compact(raw:&[u8])->Result<Vec<u8>>{
+    // Reproduce serde_json's two-space PrettyFormatter without Float parse
+    // and reserialization. The entire typed world is checked independently.
+    let mut out=Vec::with_capacity(raw.len());
+    let mut groups:Vec<(u8,bool)>=Vec::new();let mut i=0;
+    let line=|out:&mut Vec<u8>,n:usize|{
+        out.push(b'\n'); for _ in 0..n{out.extend_from_slice(b"  ");}
+    };
+    while i<raw.len(){
+        let b=raw[i];
+        if ws(b){return Err("expected compact exact producer world".into());}
+        if matches!(b,b'}'|b']'){
+            let (open,contents)=groups.pop().ok_or("unbalanced compact world")?;
+            if !matches!((open,b),(b'{',b'}')|(b'[',b']')){return Err("invalid world bracket".into());}
+            if contents{line(&mut out,groups.len());}
+            out.push(b);i+=1;continue;
+        }
+        let n=groups.len();
+        if let Some(last)=groups.last_mut(){
+            if !last.1{last.1=true;line(&mut out,n);}
+        }
+        match b{
+            b'{'|b'['=>{groups.push((b,false));out.push(b);i+=1;}
+            b','=>{out.push(b);line(&mut out,groups.len());i+=1;}
+            b':'=>{out.extend_from_slice(b": ");i+=1;}
+            b'"'=>{
+                let start=i;
+                i+=1;
+                let mut closed=false;
+                while i<raw.len(){
+                    match raw[i]{
+                        b'\\'=>{i=i.checked_add(2).ok_or("malformed world escape")?;}
+                        b'"'=>{i+=1;closed=true;break;}
+                        _=>i+=1,
+                    }
+                }
+                if !closed{return Err("unfinished compact world string".into());}
+                out.extend_from_slice(&raw[start..i]);
+            }
+            _=>{out.push(b);i+=1;}
+        }
+        if groups.len()>128 || out.len()>NESTED{return Err("bounded diagnostic pretty projection exceeded".into());}
+    }
+    if !groups.is_empty(){return Err("unclosed compact producer world".into());}
+    Ok(out)
+}
