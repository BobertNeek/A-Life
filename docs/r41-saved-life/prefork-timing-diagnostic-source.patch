+fn real_fork_rows(root:&Path,a:&Acceptance,first:u64)->Result<Vec<ForkFrame>>{
+    let out=checked_path(&checked_path(root,&a.off.relative_room)?,"native-output")?;
+    let (f,len)=private_file(&out.join("rows.jsonl"),NATIVE_ROWS)?;
+    let mut reader=BufReader::with_capacity(64<<10,f);let mut out=Vec::new();let mut line=Vec::new();
+    let mut raw=Sha256::new();let mut n=0u64;
+    for i in 0..256 {
+        line.clear();
+        n+=(&mut reader).take((1<<20)+1).read_until(b'\n',&mut line)? as u64;
+        if line.is_empty()||line.len()>1<<20||n>len{return Err("actual fork original bounded rows missing".into());}
+        raw.update(&line);
+        if i<7{out.push(material_fork_row(&line,first+i as u64,a.owner)?);}
+    }
+    if n!=len || !reader.fill_buf()?.is_empty() || format!("{:x}",raw.finalize())!=a.off.rows_sha256{
+        return Err("actual OFF originals changed while checking real physical fork".into());
+    }
+    Ok(out)
+}
