+    }
+    let aa=real_fork_rows(root,&a,profile.first)?;let bb=real_fork_rows(root,&b,profile.first)?;
+    if !(if a.case_id==root_label{actual_fork(&aa,&bb)}else{actual_fork(&bb,&aa)}){
