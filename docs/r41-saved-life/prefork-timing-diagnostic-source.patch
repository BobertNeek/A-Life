+fn same_new_pair(root:&Path,a:&Acceptance,run:&str,start:&super::ordinary_ingress_native_custody::HostStart,
+    profile:&super::ordinary_ingress_native_custody::VerifiedStockV11Profile)->Result<(Observed,Observed)>{
+    if a.schema!="qualia.private.note19.sealed_same_case_timing_parents.v1" || !a.independently_accepted
+       || a.scorecard_eligible || a.evaluator_sha256!=start.evaluator_sha256 || a.window_start_tick!=profile.first
+       || a.initial_phenotype_sha256!=profile.initial_phenotype_asset_sha256
+       || a.compiled_sensor_profile!="GroundedTerrainVisionV1"
+       || ![a.scope_sha256.as_str(),a.current_sha256.as_str(),a.independent_verifier_sha256.as_str(),
+          a.independent_comparison_sha256.as_str(),a.native_setup_sha256.as_str(),a.sampling_sha256.as_str(),
+          a.parity_sha256.as_str(),a.opening_world_sha256.as_str(),a.initial_phenotype_sha256.as_str()].into_iter().all(is_sha)
+       || a.off.role!=Role::DefaultOff || a.reference.role!=Role::Reference
+       || a.off.run_id==a.reference.run_id || a.off.run_id==run || a.reference.run_id==run
+       || a.off.relative_room==a.reference.relative_room
+       || a.off.authority_sha256==a.reference.authority_sha256
+       || a.off.manifest_sha256==a.reference.manifest_sha256 || a.off.started_sha256==a.reference.started_sha256
+       || a.off.process_sha256==a.reference.process_sha256 || a.off.release_sha256==a.reference.release_sha256
+       || a.off.rows_sha256==a.reference.rows_sha256 || a.off.native_receipt_sha256==a.reference.native_receipt_sha256
+       || a.off.final_checkpoint_sha256==a.reference.final_checkpoint_sha256{
+       return Err("Note19 genuine same-case already-closed pair identities differ".into());
+    }
+    // These exact bytes must be separately reviewed and pinned by the protected
+    // host authority. Unlike 81, this is a timing-only disposition, not a substituted proof.
+    rehash(&checked_path(root,"note19-independent-verifier.source")?,&a.independent_verifier_sha256,VERIFIER_SOURCE)?;
+    let note=checked_path(root,if a.case_id==profile.primary_case {"note19-root-independent-comparison.json"}
+        else {"note19-foil-independent-comparison.json"})?;
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Independent{
+        schema:String,current_sha256:String,evaluator_sha256:String,case_id:String,
+        off_process:String,reference_process:String,off_release:String,reference_release:String,
+        raw_finals:[String;2],complete_projected_rows_sha256:String,scope_sha256:String,
+        can_grant_capture_or_continuation_or_score:bool,
+    }
+    let n:Independent=json_leaf(&note,&a.independent_comparison_sha256,SMALL)?;
+    if n.schema!="qualia.private.note19.independent_same_case_projection.v1"
+      || n.current_sha256!=a.current_sha256 || n.evaluator_sha256!=a.evaluator_sha256 || n.case_id!=a.case_id
+      || n.off_process!=a.off.process_sha256 || n.reference_process!=a.reference.process_sha256
