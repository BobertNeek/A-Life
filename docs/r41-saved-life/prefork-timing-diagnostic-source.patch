+++ b/crates/alife_game_app/src/foundation_training_cycle/saved_life_retention/ordinary_ingress_diagnostic_role.rs
@@ -0,0 +1,190 @@
+//! Separate Note19 disposition, never the schema81 Capture predecessor API.
+//! Detached App review core. This file contains no path handling or grant mint.
+use super::*;
+use super::ordinary_ingress_timing_relation::{exact_timing_relation,Endpoint};
+use serde::Serialize;
+
+pub(super) const PURPOSE:&str="qualia.saved_life.prefork_timing_diagnostic.v1";
+pub(super) const CUTS:usize=7;
+pub(super) const NO_SCORE:bool=false;
+
+fn pin(s:&str)->bool{
+    s.len()==64 && s.bytes().all(|c|c.is_ascii_digit()||(b'a'..=b'f').contains(&c)) && s.bytes().any(|c|c!=b'0')
+}
+
+#[derive(Debug,Clone,PartialEq,Eq,Serialize)]
+pub(super) struct ArmKey {
+    pub run_id:String,
+    pub signed_root_ticket_sha256:String,
+    pub started_witness_sha256:String,
+    pub process_group_identity_sha256:String,
+    pub exact_native_retention_sha256:String,
+    pub exact_raw_rows_sha256:String,
+}
+
+/// Constructed only after independent rooted OFF/Reference comparison and
+/// immutable raw file and actual process/fence rehash. This is deliberately
+/// not Deserialize: a user JSON cannot construct this runtime type.
+pub(super) struct IndependentlyClosedCase {
+    pub case_id:String,
+    pub matched_current_sha256:String,
+    pub actual_executing_elf_sha256:String,
+    pub frozen_case_and_native_setup_sha256:String,
+    pub actual_boot_environment_hardware_and_seed_sha256:String,
+    pub independent_disposition_sha256:String,
+    pub selected_reference_state_sha256:String,
+    pub selected_reference_complete_projected_rows_sha256:String,
+    pub actual_off:ArmKey,
+    pub actual_reference:ArmKey,
+    pub off_raw_endpoint:Endpoint,
+    pub reference_raw_endpoint:Endpoint,
+}
+
+/// Same scope identity must come from actual prepared candidate/reference
+/// and trusted separately minted new diagnostic host authority, not from
+/// deserializing a user-copied HOLD or supplying this scope from CLI.
+pub(super) struct FreshDiagnosticCandidate<'a>{
+    pub authority_purpose:&'a str,
+    pub authorized_independent_disposition_sha256:&'a str,
+    pub signed_fresh_diagnostic_ticket_sha256:&'a str,
+    pub matched_current_sha256:&'a str,
+    pub actual_executing_elf_sha256:&'a str,
+    pub frozen_case_and_native_setup_sha256:&'a str,
+    pub actual_boot_environment_hardware_and_seed_sha256:&'a str,
+    pub case_id:&'a str,
+    pub run_id:&'a str,
+    pub actual_ordinary_persisted_original:&'a Endpoint,
+    pub actual_state_window_sha256:&'a str,
+    pub actual_complete_projected_rows_sha256:&'a str,
+    pub actual_control_decisions:usize,
+    pub actual_world_ticks:u64,
+}
+
+// A helper may never issue either old Capture or future continuation authority.
+// Keep actual distinct native endpoints and the stored next-input differences.
+#[derive(Serialize)]
+pub(super) struct DiagnosticDisposition<'a>{
+    pub schema:&'static str,
+    pub case_id:&'a str,
+    pub paired_actual_raw_endpoint_sha256:[&'a str;3],
+    pub distinct_actual_next_dispatch_gpu_ns:[u64;3],
+    pub diagnostic_scope_only:bool,
+    pub ordinary_checkpoint_equal:bool,
+    pub equal_future_behavior_proven:bool,
+    pub scorecard_eligible:bool,
+    pub authorizes_next_or_reopen:bool,
+}
+
+pub(super) fn diagnostic_disposition<'a>(
+    pair:&'a IndependentlyClosedCase,
+    c:&FreshDiagnosticCandidate<'a>,
+) -> Result<DiagnosticDisposition<'a>>{
+    // This is only a finish predicate. A reviewed ordinary
+    // operator must have an independently anchored root ticket and a real
+    // same-ELF OFF/Reference close before the separate diagnostic starts.
+    let a=&pair.actual_off;
+    let r=&pair.actual_reference;
+    if c.authority_purpose!=PURPOSE || c.case_id!=pair.case_id
+        || !["artificial-primary","artificial-foil"].contains(&c.case_id)
+        || c.authorized_independent_disposition_sha256!=pair.independent_disposition_sha256
+        || c.matched_current_sha256!=pair.matched_current_sha256
+        || c.actual_executing_elf_sha256!=pair.actual_executing_elf_sha256
+        || c.frozen_case_and_native_setup_sha256!=pair.frozen_case_and_native_setup_sha256
+        || c.actual_boot_environment_hardware_and_seed_sha256!=pair.actual_boot_environment_hardware_and_seed_sha256
+        || c.actual_state_window_sha256!=pair.selected_reference_state_sha256
+        || c.actual_complete_projected_rows_sha256!=pair.selected_reference_complete_projected_rows_sha256
+        || c.actual_control_decisions!=256 || c.actual_world_ticks!=256
+        || a.run_id==r.run_id || c.run_id==a.run_id || c.run_id==r.run_id
+        || a.process_group_identity_sha256==r.process_group_identity_sha256
+        || a.started_witness_sha256==r.started_witness_sha256
+        || a.signed_root_ticket_sha256==r.signed_root_ticket_sha256
+        || [a.signed_root_ticket_sha256.as_str(),r.signed_root_ticket_sha256.as_str()].contains(&c.signed_fresh_diagnostic_ticket_sha256)
+        || [a.signed_root_ticket_sha256.as_str(),a.started_witness_sha256.as_str(),a.process_group_identity_sha256.as_str(),
+            a.exact_native_retention_sha256.as_str(),a.exact_raw_rows_sha256.as_str(),
+            r.signed_root_ticket_sha256.as_str(),r.started_witness_sha256.as_str(),r.process_group_identity_sha256.as_str(),
+            r.exact_native_retention_sha256.as_str(),r.exact_raw_rows_sha256.as_str(),
+            c.signed_fresh_diagnostic_ticket_sha256,c.authorized_independent_disposition_sha256,
+            c.matched_current_sha256,c.actual_executing_elf_sha256,c.frozen_case_and_native_setup_sha256,
+            c.actual_boot_environment_hardware_and_seed_sha256,c.actual_state_window_sha256,
+            c.actual_complete_projected_rows_sha256].into_iter().any(|s|!pin(s))
+        || !exact_timing_relation(&pair.off_raw_endpoint,&pair.reference_raw_endpoint)
+        || !exact_timing_relation(&pair.reference_raw_endpoint,c.actual_ordinary_persisted_original)
+        || !exact_timing_relation(&pair.off_raw_endpoint,c.actual_ordinary_persisted_original)
+    {
+        return Err("timing-separated diagnostic did not match rooted actual stock/Reference/control proof".into());
+    }
+    let off=&pair.off_raw_endpoint;
+    let rf=&pair.reference_raw_endpoint;
+    let x=c.actual_ordinary_persisted_original;
+    Ok(DiagnosticDisposition{
+        schema:PURPOSE,case_id:c.case_id,
+        paired_actual_raw_endpoint_sha256:[&off.raw_sha256,&rf.raw_sha256,&x.raw_sha256],
+        distinct_actual_next_dispatch_gpu_ns:[off.actual_next_gpu_ns,rf.actual_next_gpu_ns,x.actual_next_gpu_ns],
+        diagnostic_scope_only:true,ordinary_checkpoint_equal:false,equal_future_behavior_proven:false,
+        scorecard_eligible:NO_SCORE,authorizes_next_or_reopen:false,
+    })
+}
+
+#[cfg(test)]
+mod tests{
+    use super::*;
+    const A:&str="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
+    const B:&str="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
+    const C:&str="cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc";
+    const R:&str="artificial-primary";
+    fn end(w:&str,k:u64)->Endpoint{
+        Endpoint{
+            raw_sha256:w.into(),body_without_timing_sha256:A.into(),
+            world_without_timing_sha256:A.into(),journal_without_timing_sha256:B.into(),
+            actual_next_gpu_ns:k,actual_throttle_seal:[k;4],actual_world_anchor:w.into(),
+            actual_journal_seal:[k+1;4],actual_private_life_sha256:w.into(),
+        }
+    }
+    fn arm(l:&str,w:&str)->ArmKey{
+        ArmKey{run_id:l.into(),signed_root_ticket_sha256:w.into(),
+            started_witness_sha256:w.into(),process_group_identity_sha256:w.into(),
+            exact_native_retention_sha256:w.into(),exact_raw_rows_sha256:w.into()}
+    }
+    fn pair()->IndependentlyClosedCase{
+        IndependentlyClosedCase{case_id:R.into(),matched_current_sha256:A.into(),
+            actual_executing_elf_sha256:A.into(),frozen_case_and_native_setup_sha256:A.into(),
+            actual_boot_environment_hardware_and_seed_sha256:A.into(),independent_disposition_sha256:A.into(),
+            selected_reference_state_sha256:A.into(),selected_reference_complete_projected_rows_sha256:A.into(),
+            actual_off:arm("off",A),actual_reference:arm("ref",B),
+            off_raw_endpoint:end(A,1),reference_raw_endpoint:end(B,2)}
+    }
+    fn candidate(x:&Endpoint)->FreshDiagnosticCandidate<'_>{
+        FreshDiagnosticCandidate{authority_purpose:PURPOSE,authorized_independent_disposition_sha256:A,
+            signed_fresh_diagnostic_ticket_sha256:C,matched_current_sha256:A,
+            actual_executing_elf_sha256:A,frozen_case_and_native_setup_sha256:A,
+            actual_boot_environment_hardware_and_seed_sha256:A,case_id:R,run_id:"actual-new",
+            actual_ordinary_persisted_original:x,actual_state_window_sha256:A,
+            actual_complete_projected_rows_sha256:A,actual_control_decisions:256,actual_world_ticks:256}
+    }
+    #[test]
+    fn diagnostic_only_must_have_distinct_true_timing_and_never_grants(){
+        let p=pair();let x=end(C,3);let c=candidate(&x);
+        let r=diagnostic_disposition(&p,&c).unwrap();
+        assert!(r.diagnostic_scope_only && !r.ordinary_checkpoint_equal && !r.equal_future_behavior_proven);
+        assert!(!r.scorecard_eligible && !r.authorizes_next_or_reopen);
+        assert_eq!(r.distinct_actual_next_dispatch_gpu_ns,[1,2,3]);
+    }
+    #[test]
+    fn rejects_alias_false_ancestry_and_other_role(){
+        let p=pair();let x=end(C,3);let mut c=candidate(&x);
+        c.authorized_independent_disposition_sha256=B;
+        assert!(diagnostic_disposition(&p,&c).is_err());
+        c.authorized_independent_disposition_sha256=A;c.run_id="ref";
+        assert!(diagnostic_disposition(&p,&c).is_err());
+        c.run_id="actual-new";c.case_id="artificial-foil";
+        assert!(diagnostic_disposition(&p,&c).is_err());
