+//! Source-only test crate, not a GPU backend or a game evaluator.
+#[cfg(test)]
+mod tests {
+    const ABI: &str = include_str!("../inputs/closed_loop_abi.wgsl");
+    const ACTIVITY: &str = include_str!("../inputs/closed_loop_activity_validation.wgsl");
+    const STOCK: &str = include_str!("../inputs/closed_loop_recurrent.wgsl");
+    const DETACHED: &str = include_str!("../inputs/detached_recurrent.wgsl");
+
+    const STOCK_REQUEST_HOOK: &str = include_str!("../inputs/stock_request_hook.txt");
+    const NATIVE_GUARD: &str = include_str!("../inputs/native_training_guard.txt");
+
+    fn training_guard(source: &str) -> String {
+        assert!(!source.contains("fn select_candidate("));
+        assert_eq!(source.matches(STOCK_REQUEST_HOOK).count(), 1);
+        assert!(NATIVE_GUARD.contains("count - offset < 11u"));
+        assert!(NATIVE_GUARD.starts_with(STOCK_REQUEST_HOOK));
+        source.replacen(STOCK_REQUEST_HOOK, NATIVE_GUARD, 1)
+    }
+
+    fn validate(assembled: &str) -> naga::Module {
+        let module = naga::front::wgsl::parse_str(assembled)
+            .unwrap_or_else(|e| panic!("{}", e.emit_to_string(assembled)));
+        naga::valid::Validator::new(
+            naga::valid::ValidationFlags::all(),
+            naga::valid::Capabilities::empty(),
+        )
+        .validate(&module)
+        .expect("detached or stock recurrent shader must pass actual Naga validation");
+        module
+    }
+
+    fn entries(m: &naga::Module) -> Vec<(&str, naga::ShaderStage, [u32; 3])> {
+        m.entry_points
+            .iter()
+            .map(|e| (e.name.as_str(), e.stage, e.workgroup_size))
+            .collect()
+    }
+
+    fn globals(m: &naga::Module) -> Vec<(u32, u32, &str)> {
+        let mut r: Vec<_> = m.global_variables.iter().filter_map(|(_, v)|
+            v.binding.as_ref().map(|b| (b.group, b.binding, v.name.as_deref().unwrap_or("")))
+        ).collect();
+        r.sort_unstable();
+        r
+    }
+
+    fn overrides(m: &naga::Module) -> Vec<&str> {
+        let mut r: Vec<_> = m.overrides.iter().map(|(_, v)| v.name.as_deref().unwrap_or("")).collect();
+        r.sort_unstable();
+        r
+    }
+
+    fn same_seams(stock: &naga::Module, observer: &naga::Module) {
+        assert_eq!(entries(stock), entries(observer));
+        assert_eq!(globals(stock), globals(observer));
+        assert_eq!(globals(stock).len(), 7);
+        assert!(overrides(stock).contains(&"microstep_index"));
+        let mut expected = overrides(stock);
+        expected.extend(["note24_observation_target", "note24_observer_enabled"]);
+        expected.sort_unstable();
+        assert_eq!(expected, overrides(observer));
+        assert!(DETACHED.contains("override note24_observer_enabled:bool = false;"));
+        assert!(DETACHED.contains("override note24_observation_target:u32 = 0xffffffffu;"));
+        assert!(!STOCK.contains("note24_observer_enabled"));
+    }
+
+    #[test]
+    fn stock_and_detached_recurrent_have_same_stock_entrypoints_binding_abi() {
+        let stock = [ABI, ACTIVITY, STOCK].concat();
+        let detached = [ABI, ACTIVITY, DETACHED].concat();
+        same_seams(&validate(&stock), &validate(&detached));
+    }
+
+    #[test]
+    fn exact_training_guard_composition_validates_stock_and_detached_recurrent() {
+        let stock = training_guard(&[ABI, ACTIVITY, STOCK].concat());
+        let detached = training_guard(&[ABI, ACTIVITY, DETACHED].concat());
+        same_seams(&validate(&stock), &validate(&detached));
+    }
+}
