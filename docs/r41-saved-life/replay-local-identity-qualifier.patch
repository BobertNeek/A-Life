+    #[test]
+    fn rejects_malformed_native_identity_words_in_the_relocated_slot() {
+        let capacity = BrainCapacityClass::n512();
+        let genome = BrainGenome::scaffold(97, capacity.id());
+        let development =
+            DevelopmentState::new(genome.id, Tick::ZERO, NormalizedScalar::new(0.35).unwrap());
+        let phenotype = PhenotypeCompiler::compile(
+            &genome,
+            &capacity,
+            &development,
+            alife_core::SensorProfile::GroundedObjectSlotsV1,
+        )
+        .unwrap();
+        let plan = GpuFixedClassArenaPlan::new(capacity, 2, 512 * 1024 * 1024).unwrap();
+        let mut upload = plan.prepare_slot_upload(1, 3, &phenotype).unwrap();
+        let expected = upload.sleep_replay_local_endpoints(0).unwrap();
+        let local = (upload.ranges.layout.synapse_learning_metadata_words.start
+            - upload.ranges.immutable_plan_words.start) as usize;
+        // Prove the owned ABI read works even when borrowing a 16-byte
+        // aligned record would deterministically fail. The actual upload
+        // below still tests the production resolver on the native slot.
+        #[repr(C, align(16))]
+        struct AlignedWords([u32; 9]);
+        let stride = std::mem::size_of::<GpuSynapseLearningMetadata>()
+            / std::mem::size_of::<u32>();
+        let mut storage = AlignedWords([0; 9]);
+        storage.0[1..].copy_from_slice(&upload.immutable_plan_words[local..local + stride]);
+        let words = &storage.0[1..];
+        assert_eq!(
+            words.as_ptr() as usize % std::mem::align_of::<GpuSynapseLearningMetadata>(),
+            std::mem::size_of::<u32>()
+        );
+        assert!(bytemuck::try_from_bytes::<GpuSynapseLearningMetadata>(
+            bytemuck::cast_slice(words)
+        ).is_err());
+        let owned = GpuSynapseLearningMetadata::from_words(words).unwrap();
+        assert_eq!(owned.global_synapse_id, 0);
+        assert_eq!((owned.source_neuron, owned.target_neuron), expected);
+
+        let out_of_range = upload.record().neuron_count;
+        for (offset, invalid) in [
+            (std::mem::offset_of!(GpuSynapseLearningMetadata, global_synapse_id), 1),
+            (std::mem::offset_of!(GpuSynapseLearningMetadata, kind), 2),
+            (std::mem::offset_of!(GpuSynapseLearningMetadata, reserved), 1),
+            (std::mem::offset_of!(GpuSynapseLearningMetadata, source_neuron), out_of_range),
+            (std::mem::offset_of!(GpuSynapseLearningMetadata, target_neuron), out_of_range),
+        ] {
+            let index = local + offset / std::mem::size_of::<u32>();
+            let saved = std::mem::replace(&mut upload.immutable_plan_words[index], invalid);
+            assert_eq!(upload.sleep_replay_local_endpoints(0), Err(GpuClosedLoopError::MalformedUpload));
+            upload.immutable_plan_words[index] = saved;
+            assert_eq!(upload.sleep_replay_local_endpoints(0).unwrap(), expected);
+        }
+    }
+}
