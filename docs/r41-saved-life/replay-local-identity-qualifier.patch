+#[test]
+fn rejects_foreign_arena_out_of_range_reserved_and_stale_digest() {
+    let (capacity, phenotype) = scaffold();
+    let plan = GpuFixedClassArenaPlan::new(capacity, 1, 512 * 1024 * 1024).unwrap();
+    let foreign_plan = GpuFixedClassArenaPlan::new(capacity, 1, 512 * 1024 * 1024).unwrap();
+    let state = GpuV11CausalState::for_phenotype(&phenotype).unwrap();
+    let base = plan.prepare_slot_upload(0, 9, &phenotype).unwrap();
+    let slot = compile_v11_slot_upload(&plan, base.brain_slot(), &phenotype, &state).unwrap();
+    let replay = batch(&[(0, 17)]);
+    assert_eq!(
+        collect_v11_sleep_replay_local_activity(&foreign_plan, slot.brain_slot(), &phenotype, &state, &replay),
+        Err(ScaffoldContractError::InvalidSparseProjectionSchema)
+    );
+    let mut bad_span = replay.clone();
+    bad_span.synapse_spans[0].reserved = 1;
+    bad_span.canonical_digest = bad_span.recompute_canonical_digest().unwrap();
+    let mut stale = replay;
+    stale.eligibility_samples[0].eligibility_q15 = 18;
+    for invalid in [batch(&[(slot.record().synapse_count, 0)]), bad_span, stale] {
+        assert_eq!(
+            collect_v11_sleep_replay_local_activity(&plan, slot.brain_slot(), &phenotype, &state, &invalid),
+            Err(ScaffoldContractError::ConsolidationGenerationMismatch)
+        );
+    }
+}
