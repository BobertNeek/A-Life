+// CPU-only planning boundary used by the real sleep structural caller. The
+// authenticated resident is selected by the caller before entering this step.
+fn collect_v11_sleep_replay_local_activity(
+    plan: &GpuFixedClassArenaPlan,
+    slot: &GpuBrainSlot,
+    phenotype: &BrainPhenotype,
+    state: &GpuV11CausalState,
+    replay: &alife_core::sleep::BoundedReplayBatch,
+) -> Result<Vec<(u32, u32, u32)>, ScaffoldContractError> {
+    let native = compile_v11_slot_upload(
+        plan, slot, phenotype, state,
+    )
+    .map_err(map_gpu_contract_error)?;
+    if native.brain_slot() != slot {
+        return Err(ScaffoldContractError::InvalidSparseProjectionSchema);
+    }
+    replay.validate_contract(
+        phenotype.replay_capture_plan().event_capacity(),
+        phenotype.replay_capture_plan().sample_capacity(),
+        slot.record().synapse_count,
+    )?;
+    let mut active = Vec::with_capacity(32);
+    for span in &replay.synapse_spans {
+        let invalid = || ScaffoldContractError::ConsolidationGenerationMismatch;
+        let start = usize::try_from(span.sample_start).map_err(|_| invalid())?;
+        let count = usize::try_from(span.sample_count).map_err(|_| invalid())?;
+        let end = start.checked_add(count).ok_or_else(|| invalid())?;
+        let samples = replay.eligibility_samples.get(start..end).ok_or_else(invalid)?;
+        let eligibility = samples
+            .iter()
+            .map(|sample| u32::from(sample.eligibility_q15.unsigned_abs()))
+            .max()
+            .unwrap_or(0);
+        if eligibility == 0 {
+            continue;
+        }
+        let (source, target) = native
+            .sleep_replay_local_endpoints(span.local_synapse_id)
+            .map_err(map_gpu_contract_error)?;
+        active.push((source, target, eligibility));
+        if active.len() == 32 {
+            break;
+        }
+    }
+    drop(native);
+    Ok(active)
+}
