+#[test]
+fn inserted_recurrence_and_shifted_action_decoder_survive_nonzero_slot_relocation() {
+    let (capacity, phenotype) = scaffold();
+    let plan = GpuFixedClassArenaPlan::new(capacity, 2, 512 * 1024 * 1024).unwrap();
+    let plain = crate::GpuPhenotypeUpload::try_from(&phenotype).unwrap();
+    let target = 0;
+    let insertion = plain.target_offsets[target as usize + 1];
+    assert!((insertion as usize) < plain.source_indices.len());
+    let source = (1..phenotype.neuron_count())
+        .find(|&source| !phenotype.synapses().iter().any(|s| {
+            s.kind() == CompiledSynapseKind::Recurrent && s.source() == source && s.target() == target
+        }))
+        .unwrap();
+
+    let mut state = GpuV11CausalState::for_phenotype(&phenotype).unwrap();
+    // This input exercises the ordinary V11 insertion machinery only. It
+    // makes no claim about how a living model would discover these endpoints.
+    let edge = CoactivationEvidence {
+        region: 0,
+        source,
+        target,
+        coactivation: 100,
+        eligibility: 0,
+        concept_gap_support: 0,
+    };
+    assert_eq!(state.apply_structural_phase(&[edge]).unwrap().structural.accepted_edges, 1);
+
+    let base = plan.prepare_slot_upload(1, 7, &phenotype).unwrap();
+    let native = compile_v11_slot_upload(&plan, base.brain_slot(), &phenotype, &state).unwrap();
+    assert_eq!(native.record().recurrent_synapse_count, base.record().recurrent_synapse_count + 1);
+    assert_eq!(native.record().synapse_count, base.record().synapse_count + 1);
+    assert_eq!((native.record().slot, native.record().slot_generation), (1, 7));
+    let topology = native.live_topology_checkpoint(phenotype.phenotype_hash(), state.checkpoint()).unwrap();
+    assert_eq!(topology.target_offsets[target as usize + 1], insertion + 1);
+    assert_eq!(topology.source_indices[insertion as usize], source);
+    assert_eq!(topology.route_indices[insertion as usize], 0);
+    assert_eq!(topology.alpha_bits[insertion as usize], (-0.0_f32).to_bits());
+
+    let displaced_canonical = plain.canonical_to_local_synapse.iter()
+        .position(|&id| id == insertion).unwrap();
+    let displaced = &phenotype.synapses()[displaced_canonical];
+    assert_eq!(displaced.kind(), CompiledSynapseKind::Recurrent);
+    assert_ne!((displaced.source(), displaced.target()), (source, target));
+    assert_eq!(topology.source_indices[insertion as usize + 1], displaced.source());
+
+    let decoder_before = plain.decoder_weight_indices[0].global_synapse_id;
+    let decoder_after = topology.decoder_weight_global_synapse_ids[0];
+    assert_eq!(decoder_after, decoder_before + 1);
+    let decoder = &phenotype.synapses()[plain.canonical_to_local_synapse.iter()
+        .position(|&id| id == decoder_before).unwrap()];
+    assert!(matches!(
+        decoder.kind(),
+        CompiledSynapseKind::Decoder(coordinate)
+            if coordinate.head() == alife_core::DecoderHeadKind::ActionCandidate
+    ));
+    assert!(decoder_before >= base.record().recurrent_synapse_count);
+    // The last new local ID is outside the old canonical count, but inside
+    // the actual resident count. Test this upper legal boundary too.
+    let last_before = base.record().synapse_count - 1;
+    let last_after = native.record().synapse_count - 1;
+    assert_eq!(last_after, base.record().synapse_count);
+    assert!(decoder_after < last_after);
+    let last = &phenotype.synapses()[plain.canonical_to_local_synapse.iter()
+        .position(|&id| id == last_before).unwrap()];
+    let replay = batch(&[(insertion, 41), (insertion + 1, -42), (decoder_after, 43), (last_after, 44)]);
+    let expected = vec![
+        (source, target, 41),
+        (displaced.source(), displaced.target(), 42),
+        (decoder.source(), decoder.target(), 43),
+        (last.source(), last.target(), 44),
+    ];
+    assert_eq!(
+        collect_v11_sleep_replay_local_activity(&plan, native.brain_slot(), &phenotype, &state, &replay)
+            .unwrap(),
+        expected
+    );
+
+    // Independently join one real physical capture-plan span whose stored ID
+    // changed after insertion. Supply an in-code sample, not a retained event.
+    let old_spans = base.qualification_physical_sleep_spans().unwrap();
+    let new_spans = native.qualification_physical_sleep_spans().unwrap();
+    assert_eq!(old_spans.len(), new_spans.len());
+    let (old_span, new_span) = old_spans.iter().zip(&new_spans)
+        .find(|(old, _)| {
+            old.local_synapse_id >= insertion
+                && old.local_synapse_id < base.record().recurrent_synapse_count
+        })
+        .expect("the physical plan should retain a displaced captured recurrent row");
+    assert_eq!(old_span.sample_start, new_span.sample_start);
+    assert_eq!(old_span.local_synapse_id + 1, new_span.local_synapse_id);
+    let captured = &phenotype.synapses()[plain.canonical_to_local_synapse.iter()
+        .position(|&id| id == old_span.local_synapse_id).unwrap()];
+    assert_eq!(
+        collect_v11_sleep_replay_local_activity(
+            &plan, native.brain_slot(), &phenotype, &state,
+            &batch(&[(new_span.local_synapse_id, -31)]),
+        ).unwrap(),
+        vec![(captured.source(), captured.target(), 31)],
+    );
+
+    // Rebuilding the other physical slot from the same topology must not
+    // reinterpret a local ordinal as an absolute plan-buffer address.
+    let other_base = plan.prepare_slot_upload(0, 3, &phenotype).unwrap();
+    let other = compile_v11_slot_upload(&plan, other_base.brain_slot(), &phenotype, &state).unwrap();
+    assert_ne!(native.brain_slot().word_ranges(), other.brain_slot().word_ranges());
+    assert_eq!(
+        collect_v11_sleep_replay_local_activity(&plan, other.brain_slot(), &phenotype, &state, &replay)
+            .unwrap(),
+        expected
+    );
+    // Same slot/generation, but the supplied resident plan pre-dates the insertion.
+    assert_eq!(
+        collect_v11_sleep_replay_local_activity(&plan, base.brain_slot(), &phenotype, &state, &replay),
+        Err(ScaffoldContractError::InvalidSparseProjectionSchema)
+    );
+}
