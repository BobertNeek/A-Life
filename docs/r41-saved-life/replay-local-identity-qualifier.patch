+//! Device-free address tests. In-code scaffold and events are mechanism
+//! fixtures, not retained-lifetime data, learned behavior, or a score.
+use super::*;
+use alife_core::sleep::{
+    BoundedReplayBatch, ReplayEligibilitySample, ReplaySynapseSpan, SleepReplayEvent,
+    BOUNDED_REPLAY_BATCH_SCHEMA_VERSION,
+};
+use alife_core::{
+    BrainGenome, CandidateFeatureDigest, CompiledSynapseKind, DevelopmentState,
+    ExperienceSequenceId, NeuromodulatorSample, NeuromodulatoryFrame, NormalizedScalar,
+    PhenotypeCompiler, Tick,
+};
+
+fn scaffold() -> (BrainCapacityClass, BrainPhenotype) {
+    let capacity = BrainCapacityClass::n2048();
+    let genome = BrainGenome::scaffold(97, capacity.id());
+    let development =
+        DevelopmentState::new(genome.id, Tick::ZERO, NormalizedScalar::new(0.35).unwrap());
+    let phenotype = PhenotypeCompiler::compile(
+        &genome,
+        &capacity,
+        &development,
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .unwrap();
+    (capacity, phenotype)
+}
+
+fn batch(lanes: &[(u32, i16)]) -> BoundedReplayBatch {
+    let mut replay = BoundedReplayBatch {
+        schema_version: BOUNDED_REPLAY_BATCH_SCHEMA_VERSION,
+        events: vec![SleepReplayEvent {
+            sequence_id: ExperienceSequenceId(1),
+            originating_tick: Tick::new(7),
+            frame_digest: PerceptionFrameDigest([11, 0, 0, 0]),
+            candidate_feature_digest: CandidateFeatureDigest([13, 0]),
+            action_id: ActionId(1),
+            family: CandidateActionFamily::Idle,
+            modulator: NeuromodulatorSample::from_frame(
+                NeuromodulatoryFrame::try_new([0.0; 8]).unwrap(),
+            ),
+        }],
+        synapse_spans: lanes
+            .iter()
+            .enumerate()
+            .map(|(index, &(id, _))| ReplaySynapseSpan {
+                local_synapse_id: id,
+                sample_start: index as u32,
+                sample_count: 1,
+                reserved: 0,
+            })
+            .collect(),
+        eligibility_samples: lanes
+            .iter()
+            .map(|&(_, eligibility_q15)| ReplayEligibilitySample {
+                event_index: 0,
+                eligibility_q15,
+            })
+            .collect(),
+        canonical_digest: [0; 4],
+    };
+    replay.canonical_digest = replay.recompute_canonical_digest().unwrap();
+    replay
+}
+
+#[test]
+fn native_target_major_is_not_the_canonical_ordinal() {
+    let (capacity, phenotype) = scaffold();
+    let plan = GpuFixedClassArenaPlan::new(capacity, 1, 512 * 1024 * 1024).unwrap();
+    let state = GpuV11CausalState::for_phenotype(&phenotype).unwrap();
+    let base = plan.prepare_slot_upload(0, 1, &phenotype).unwrap();
+    let native = compile_v11_slot_upload(&plan, base.brain_slot(), &phenotype, &state).unwrap();
+    let plain = crate::GpuPhenotypeUpload::try_from(&phenotype).unwrap();
+    let (canonical, local) = plain
+        .canonical_to_local_synapse
+        .iter()
+        .copied()
+        .enumerate()
+        .find(|&(canonical, local)| {
+            let inherited = &phenotype.synapses()[canonical];
+            let wrong = &phenotype.synapses()[local as usize];
+            inherited.kind() == CompiledSynapseKind::Recurrent
+                && (inherited.source(), inherited.target()) != (wrong.source(), wrong.target())
+        })
+        .expect("public scaffold must exercise a semantic ordinal mismatch");
+    let expected = &phenotype.synapses()[canonical];
+    assert_eq!(plain.source_indices[local as usize], expected.source());
+    let target = expected.target() as usize;
+    assert!((plain.target_offsets[target]..plain.target_offsets[target + 1]).contains(&local));
+    let replay = batch(&[(local, -51)]);
+    assert_eq!(
+        collect_v11_sleep_replay_local_activity(
+            &plan, native.brain_slot(), &phenotype, &state, &replay,
+        )
+        .unwrap(),
+        vec![(expected.source(), expected.target(), 51)]
+    );
+}
