+    /// Read typed local neuron endpoints from the owner-bound immutable
+    /// upload plan, including shifted decoder IDs and inserted recurrent edges.
+    /// The replay caller obtains that plan via the resident V11 compiler.
+    pub(crate) fn sleep_replay_local_endpoints(
+        &self,
+        local_id: u32,
+    ) -> Result<(u32, u32), GpuClosedLoopError> {
+        let slot = self.brain_slot.record();
+        if local_id >= slot.synapse_count {
+            return Err(GpuClosedLoopError::MalformedUpload);
+        }
+        let base = self.ranges.immutable_plan_words.start;
+        let range = &self.ranges.layout.synapse_learning_metadata_words;
+        let stride = (std::mem::size_of::<GpuSynapseLearningMetadata>()
+            / std::mem::size_of::<u32>()) as u32;
+        let index = local_id
+            .checked_mul(stride)
+            .and_then(|i| range.start.checked_add(i))
+            .ok_or(GpuClosedLoopError::ArithmeticOverflow)?;
+        let end = index.checked_add(stride).ok_or(GpuClosedLoopError::ArithmeticOverflow)?;
+        if index < base || end > range.end {
+            return Err(GpuClosedLoopError::MalformedUpload);
+        }
+        let words = self.immutable_plan_words
+            .get((index - base) as usize..(end - base) as usize)
+            .ok_or(GpuClosedLoopError::MalformedUpload)?;
+        let row = bytemuck::try_from_bytes::<GpuSynapseLearningMetadata>(bytemuck::cast_slice(words))
+            .map_err(|_| GpuClosedLoopError::MalformedUpload)?;
+        let kind = if local_id < slot.recurrent_synapse_count { 1 } else { 2 };
+        if row.global_synapse_id != local_id || row.kind != kind || row.reserved != 0
+            || row.source_neuron >= slot.neuron_count || row.target_neuron >= slot.neuron_count
+        {
+            return Err(GpuClosedLoopError::MalformedUpload);
+        }
+        Ok((row.source_neuron, row.target_neuron))
+    }
