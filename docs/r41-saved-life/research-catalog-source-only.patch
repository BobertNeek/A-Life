+//! Bounded physical research setup and native observation; no behavior/scoring hooks.
+use super::*;
+use alife_core::{OrganismId, Vec3f, WorldEntityId};
+use alife_world::{HeadlessWorld, WorldEditorSpawnSpec, WorldObjectKind as Kind};
+use serde::{Deserialize, Serialize};
+use std::collections::BTreeSet;
+use std::io::Read;
+
+#[path = "research_fixture_label.rs"]
+mod fixture_label;
+
+pub(super) const CATALOG_FILE: &str = "research-catalog.v1.json";
+pub(super) const ADMISSION_FILE: &str = "operator-research-admission.v1.json";
+pub(super) const FOUNDATION_FILE: &str = "input.alife-foundation";
+const RUBRIC_FILE: &str = "research-rubric.v1.json";
+const MAX_CATALOG_BYTES: usize = 256 * 1024;
+const MAX_FOUNDATION_BYTES: usize = 1024 * 1024;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case", deny_unknown_fields)]
+pub(super) enum Input {
+    CompleteSavedLife {},
+    FoundationOnExplicitHost { foundation_sha256: String },
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Manifest {
+    pub(super) schema: u16,
+    pub(super) run_id: String,
+    pub(super) owner: u64,
+    pub(super) source_current_sha256: String,
+    pub(super) profile: String,
+    catalog_sha256: String,
+    rubric_sha256: String,
+    case_id: String,
+    evaluator_sha256: String,
+    expected_world_seed: u64,
+    pub(super) evaluation_nonce: u64,
+    pub(super) deadline_unix_seconds: u64,
+    pub(super) finalization_deadline_unix_seconds: Option<u64>,
+    pub(super) max_output_bytes: u64,
+    input: Input,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Admission {
+    schema: String,
+    catalog_sha256: String,
+    rubric_sha256: String,
+    evaluator_sha256: String,
+    admitted_case_ids: Vec<String>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Catalog {
+    schema: String,
+    catalog_id: String,
+    cases: Vec<Case>,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Case {
+    id: String,
+    pub(super) max_decisions: usize,
+    pub(super) max_world_ticks: u64,
+    objects: Vec<Object>,
+    opening_contacts: Vec<String>,
+}
+
+#[derive(Clone, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Object {
+    slot: String,
+    kind: Material,
+    forward_mm: i16,
+    left_mm: i16,
+    radius_mm: u16,
+    temperature_milli: i16,
+    pain_milli: u16,
+    nutrition_milli: u16,
+}
+
+#[derive(Clone, Copy, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Material { Hazard, Obstacle, Food }
+
+impl Material {
+    fn native(self) -> Kind {
+        match self { Self::Hazard => Kind::Hazard, Self::Obstacle => Kind::Obstacle, Self::Food => Kind::Food }
+    }
+}
+
+/// Only observer/receipt code can serialize this. Nothing from it is a policy input.
+#[derive(Serialize)]
+pub(super) struct Identity {
+    profile: &'static str,
+    catalog_id: String,
+    catalog_sha256: String,
+    rubric_sha256: String,
+    admission_sha256: String,
+    case_id: String,
+    fixture_sha256: String,
+    evaluator_sha256: String,
+    expected_world_seed: u64,
+    evaluation_nonce: u64,
+    input: Input,
+    #[serde(skip)]
+    pub(super) case: Case,
+    #[serde(skip)]
+    pub(super) foundation: Option<FoundationWeightAsset>,
+}
+
+fn slug(s: &str) -> bool {
+    !s.is_empty() && s.len() <= 64
+        && s.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || matches!(b, b'-' | b'_'))
+}
+
+fn read_inside(root: &Path, name: &str, max: usize) -> Result<Vec<u8>> {
+    let path = root.join(name);
+    if path.canonicalize()? != path || !fs::symlink_metadata(&path)?.is_file() {
+        return Err("research catalog input must be a distinct canonical local file".into());
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(path)?.take((max + 1) as u64).read_to_end(&mut bytes)?;
+    if bytes.len() > max { return Err("research catalog closure exceeds its byte bound".into()); }
+    Ok(bytes)
+}
+
+fn validate_case(case: &Case) -> Result<()> {
+    if !slug(&case.id) || !(1..=256).contains(&case.max_decisions)
+        || !(1..=2048).contains(&case.max_world_ticks) || case.max_world_ticks < case.max_decisions as u64
+        || !(1..=4).contains(&case.objects.len())
+    { return Err("invalid research case identity, horizon, or object count".into()); }
+    let mut slots = BTreeSet::new();
+    let mut implied_contacts = BTreeSet::new();
+    for (i, item) in case.objects.iter().enumerate() {
+        let f = i64::from(item.forward_mm);
+        let l = i64::from(item.left_mm);
+        let r = i64::from(item.radius_mm);
+        let d = f * f + l * l;
+        if !slug(&item.slot) || !slots.insert(item.slot.as_str()) || !(100..=750).contains(&r)
+            || !(100..=2600).contains(&f) || l.abs() > 1600 || d > 3000 * 3000
+            || !(-900..=900).contains(&item.temperature_milli)
+            || match item.kind {
+                Material::Hazard => item.pain_milli > 250 || item.nutrition_milli != 0,
+                Material::Obstacle => item.pain_milli != 0 || item.nutrition_milli != 0,
+                Material::Food => item.pain_milli != 0 || !(50..=1000).contains(&item.nutrition_milli),
+            }
+        { return Err("invalid bounded physical research object".into()); }
+        if d <= (r - 2).pow(2) {
+            if d < (r - 25).pow(2) { return Err("opening contact exceeds shallow placement bound".into()); }
+            implied_contacts.insert(item.slot.as_str());
+        } else if d <= (r + 2).pow(2) {
+            return Err("opening fixture is numerically ambiguous at its surface".into());
+        }
+        for prior in &case.objects[..i] {
+            let dx = f - i64::from(prior.forward_mm);
+            let dz = l - i64::from(prior.left_mm);
+            if dx * dx + dz * dz <= (r + i64::from(prior.radius_mm) + 20).pow(2) {
+                return Err("research fixture physical bodies overlap".into());
+            }
+        }
+    }
+    let contacts = case.opening_contacts.iter().map(String::as_str).collect::<BTreeSet<_>>();
+    if contacts.len() != case.opening_contacts.len() || contacts != implied_contacts {
+        return Err("research opening contact does not match physical layout".into());
+    }
+    Ok(())
+}
+
+pub(super) fn resolve(root: &Path, config: &Manifest, exact_sha: fn(&str) -> bool) -> Result<Identity> {
+    if config.schema != 2 || config.profile != "research_catalog_v1" || !slug(&config.case_id)
+        || ![&config.catalog_sha256, &config.rubric_sha256, &config.evaluator_sha256].iter().all(|v| exact_sha(v))
+    { return Err("invalid research manifest identity".into()); }
+    let admission_bytes = read_inside(root, ADMISSION_FILE, MAX_CATALOG_BYTES)?;
+    let admission: Admission = serde_json::from_slice(&admission_bytes)?;
+    let admitted_ids = admission.admitted_case_ids.iter().map(String::as_str).collect::<BTreeSet<_>>();
+    if admission.schema != "qualia.saved_life.operator_research_admission.v1"
+        || admission.catalog_sha256 != config.catalog_sha256 || admission.rubric_sha256 != config.rubric_sha256
+        || admission.evaluator_sha256 != config.evaluator_sha256 || !admitted_ids.contains(config.case_id.as_str())
+        || admitted_ids.len() != admission.admitted_case_ids.len() || admitted_ids.len() > 64
+        || !admitted_ids.iter().all(|id| slug(id))
+    { return Err("research case, evaluator or rubric was not explicitly admitted".into()); }
+    let running = std::env::current_exe()?;
+    if digest(&fs::read(running)?) != config.evaluator_sha256 {
+        return Err("research manifest evaluator digest does not name the running binary".into());
+    }
+    let catalog_bytes = read_inside(root, CATALOG_FILE, MAX_CATALOG_BYTES)?;
+    let rubric_bytes = read_inside(root, RUBRIC_FILE, MAX_CATALOG_BYTES)?;
+    if digest(&catalog_bytes) != config.catalog_sha256 || digest(&rubric_bytes) != config.rubric_sha256 {
+        return Err("research catalog or external rubric bytes changed".into());
+    }
+    let catalog: Catalog = serde_json::from_slice(&catalog_bytes)?;
+    if catalog.schema != "qualia.saved_life.research_catalog.v1" || !slug(&catalog.catalog_id)
+        || !(1..=64).contains(&catalog.cases.len())
+    { return Err("unsupported research catalog or case count".into()); }
+    let mut all = BTreeSet::new();
+    for case in &catalog.cases {
+        validate_case(case)?;
+        if !all.insert(case.id.as_str()) { return Err("duplicate research catalog case".into()); }
+    }
+    if !admitted_ids.is_subset(&all) { return Err("operator admission names an unknown catalog case".into()); }
+    let case = catalog.cases.iter().find(|case| case.id == config.case_id).ok_or("unknown admitted research case")?.clone();
+    let foundation = match &config.input {
+        Input::CompleteSavedLife {} => None,
+        Input::FoundationOnExplicitHost { foundation_sha256 } => {
+            let bytes = read_inside(root, FOUNDATION_FILE, MAX_FOUNDATION_BYTES)?;
+            if !exact_sha(foundation_sha256) || digest(&bytes) != *foundation_sha256 {
+                return Err("standalone Foundation digest mismatch".into());
+            }
+            let asset = FoundationWeightAsset::decode_canonical(&bytes)
+                .map_err(|_| "unsupported standalone Foundation format (exact canonical asset required)")?;
+            if asset.encode_canonical()? != bytes { return Err("Foundation asset is not byte-canonical".into()); }
+            Some(asset)
+        }
+    };
+    let fixture = format!("qualia-research-fixture/v1\0{}\0{}", config.catalog_sha256, case.id);
+    Ok(Identity {
+        profile: "research_catalog_v1", catalog_id: catalog.catalog_id, catalog_sha256: config.catalog_sha256.clone(),
+        rubric_sha256: config.rubric_sha256.clone(), admission_sha256: digest(&admission_bytes), case_id: case.id.clone(),
+        fixture_sha256: digest(fixture.as_bytes()), evaluator_sha256: config.evaluator_sha256.clone(),
+        expected_world_seed: config.expected_world_seed, evaluation_nonce: config.evaluation_nonce,
+        input: config.input.clone(), case, foundation,
+    })
+}
+
+impl Identity {
+    pub(super) fn validate_world_seed(&self, world_seed: u64) -> Result<()> {
+        if world_seed != self.expected_world_seed { return Err("research source world seed differs from the matched contract".into()); }
+        Ok(())
+    }
+}
+
+/// Reuse the native legal-weight transition. Refuse any asset whose exact
+/// bytes cannot be reconstructed on this host's legal protected stage.
+pub(super) fn foundation_edit(
+    target: &FoundationWeightAsset,
+    host: &alife_training::CurrentTrainingCheckpointV1,
+    source_sha: &str,
+) -> Result<Option<DirectWeightEditRequest>> {
+    let host_asset = host.handoff.compiler_inputs.n2048_candidate_asset().ok_or("host lacks a native N2048 Foundation")?;
+    if target == host_asset { return Ok(None); }
+    let phenotype = alife_training::compile_validated_n2048_cached(&host.handoff.compiler_inputs, &alife_core::BrainCapacityClass::n2048())?;
+    target.validate_against(&phenotype).map_err(|_| "standalone Foundation is incompatible with explicit host ABI")?;
+    let rebuilt = FoundationWeightAsset::from_trained_weights(&phenotype, target.weights().to_vec(), host_asset.manifest().training_stage())?;
+    if &rebuilt != target { return Err("unsupported exact Foundation pathway/provenance on this host".into()); }
+    let edits = host.handoff.actor.weights.iter().zip(target.weights()).enumerate()
+        .filter_map(|(i, (a, b))| (a.to_bits() != b.to_bits()).then(|| (i, b.to_bits()))).collect::<Vec<_>>();
+    let edit = DirectWeightEditRequest {schema: 3, source_current_sha256: source_sha.into(),
+        generator_id: "canonical-foundation-on-explicit-host-v1".into(), edits};
+    retained_direct_weights::validate_experiment_edit_shape(&edit)?;
+    Ok(Some(edit))
+}
+
+pub(super) struct Opened {
+    slots: Vec<(String, WorldEntityId)>,
+    pub(super) setup: serde_json::Value,
+}
+
+fn meters(v: impl Into<i32>) -> f32 { v.into() as f32 / 1000.0 }
+
+fn dist(a: Vec3f, b: Vec3f) -> f32 { (a.x-b.x).hypot(a.z-b.z).hypot(a.y-b.y) }
+
+pub(super) fn configure(world: &mut HeadlessWorld, owner: OrganismId, fixture: &Case) -> Result<Opened> {
+    let tick = world.tick();
+    let old = world.object_snapshots();
+    let body = old.iter().find(|o| o.organism_id == Some(owner)).ok_or("research fixture needs the actual saved body")?;
+    if world.terrain().is_some() || world.player_held_object().is_some() || !world.audible_utterances().is_empty()
+        || !world.sensory_report(owner, tick)?.contact_entities.is_empty()
+    { return Err("research fixture requires a clear, flat, unheld, quiet opening; no source normalization".into()); }
+    let mut staged = world.clone();
+    let (sin, cos) = body.body_yaw.sin_cos();
+    let mut slots = Vec::new();
+    let mut placed = Vec::new();
+    for (ordinal, obj) in fixture.objects.iter().enumerate() {
+        let (f, l, r) = (meters(obj.forward_mm), meters(obj.left_mm), meters(obj.radius_mm));
+        let pos = Vec3f::new(body.position.x + f*cos - l*sin, body.position.y, body.position.z + f*sin + l*cos);
+        if old.iter().any(|o| o.id != body.id && !o.consumed && dist(pos, o.position) <= o.radius+r+0.02) {
+            return Err("research layout collides with pre-existing saved-world geometry".into());
+        }
+        let label = fixture_label::neutral_label(ordinal, |candidate| staged.entity_id(candidate).is_some())
+            .ok_or("research fixture local allocator label namespace exhausted")?;
+        let id = staged.editor_spawn_object(WorldEditorSpawnSpec { label, kind: obj.kind.native(),
+            organism_id: None, position: pos, nutrition: meters(obj.nutrition_milli), hazard_pain: meters(obj.pain_milli),
+            radius: r, token_id: None })?;
+        let mut physical = staged.entity(id).ok_or("missing real placed object")?.grounded_physical;
+        physical.surface_temperature = meters(obj.temperature_milli);
+        staged.set_grounded_physical_properties(id, physical)?;
+        let actual = staged.entity(id).ok_or("missing native fixture physical readback")?;
+        if actual.kind != obj.kind.native() || actual.position != pos || actual.radius != r
+            || actual.nutrition != meters(obj.nutrition_milli) || actual.hazard_pain != meters(obj.pain_milli)
+            || actual.grounded_physical != physical || actual.carried_by.is_some() || actual.consumed
+            || actual.teacher_channel.is_some() || actual.token_id.is_some()
+        { return Err("native object differs from admitted physical setup".into()); }
+        placed.push(serde_json::json!({"slot":obj.slot,"id": id,"kind":actual.kind,"position":actual.position,
+            "radius":actual.radius,"nutrition":actual.nutrition,"surface_temperature":physical.surface_temperature,
+            "hazard_pain":actual.hazard_pain,"opening_radial_clearance_m":dist(body.position, pos)-r}));
+        slots.push((obj.slot.clone(),id));
+    }
+    let opening = staged.sensory_report(owner, tick)?;
+    let contact = opening.contact_entities.iter().map(|id| id.raw()).collect::<BTreeSet<_>>();
+    let expected = slots.iter().filter_map(|(slot,id)| fixture.opening_contacts.contains(slot).then_some(id.raw())).collect::<BTreeSet<_>>();
+    if contact != expected || slots.iter().any(|(_,id)| !contact.contains(&id.raw()) && !opening.visible_entities.iter().any(|v| v.id == *id))
+        || opening.core_snapshot.language_context.heard_tokens.iter().any(Option::is_some)
+        || staged.tick() != tick || staged.organism_registry().get(owner) != world.organism_registry().get(owner)
+        || old.iter().any(|o| staged.entity(o.id) != Some(o))
+    { return Err("opening actual contact/visibility differs, or an original saved object, body, or time changed".into()); }
+    let setup = serde_json::json!({"kind":"bounded_body_relative_physical_fixture_v1", "tick":tick,
+        "body_position":body.position,"body_yaw":body.body_yaw,"objects":placed,"contacts":contact,
+        "opening_body_observation":observe(&staged, owner, false, &slots)?});
+    *world = staged;
+    Ok(Opened {slots, setup})
+}
+
+pub(super) fn observe(world: &HeadlessWorld, owner: OrganismId, decision: bool, slots: &[(String, WorldEntityId)]) -> Result<serde_json::Value> {
+    let tick = world.tick();
+    let rec = world.organism_registry().get(owner);
+    let alive = rec.is_some_and(|r| r.lifecycle().is_alive());
+    let body = rec.and_then(|r| world.entity(r.world_entity_id()));
+    let bio = rec.map(|r| r.biochemistry());
+    let contacts = if alive { Some(world.sensory_report(owner, tick)?.contact_entities) } else { None };
+    let obs = slots.iter().map(|(slot, id)| (slot, id, world.entity(*id))).map(|(slot,id,obj)| serde_json::json!({
+        "slot":slot,"id":id,"present":obj.is_some(),"consumed":obj.map(|o|o.consumed),
+        "carrier":obj.and_then(|o|o.carried_by),"position":obj.map(|o|o.position),
+        "radial_clearance_m":body.zip(obj).map(|(b,o)|dist(b.position,o.position)-o.radius)
+    })).collect::<Vec<_>>();
+    Ok(serde_json::json!({"tick":tick,"alive":alive,"pose":body.map(|o|(o.position,o.body_yaw)),
+        "health":bio.map(|b|b.body.health),"injury":bio.map(|b|b.body.injury),"pain":bio.map(|b|b.homeostasis.drives.pain),
+        "actual_contacts":contacts,"decision_paid_or_observed_in_rows":decision,"objects":obs}))
+}
+
+impl Opened {
+    pub(super) fn observe(&self, world: &HeadlessWorld, owner: OrganismId, decision: bool) -> Result<serde_json::Value> {
+        observe(world, owner, decision, &self.slots)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn both_supplied_families_are_data_for_one_resolver() {
+        let raw = include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/../../docs/research-saved-life/research-catalog.v1.json"));
+        let catalog: Catalog = serde_json::from_slice(raw).expect("checked-in catalog schema");
+        assert_eq!(catalog.cases.len(), 8);
+        for case in &catalog.cases { validate_case(case).expect("admitted geometry"); }
+        assert!(catalog.cases.iter().any(|case| case.id == "contact-hot-left" && case.objects[0].pain_milli == 160));
+        assert!(catalog.cases.iter().any(|case| case.id == "reach-food" && case.opening_contacts.is_empty()));
+    }
+
+    #[test]
+    fn malformed_physical_layout_and_behavior_fields_are_refused() {
+        let raw = include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/../../docs/research-saved-life/research-catalog.v1.json"));
+        let mut base: serde_json::Value = serde_json::from_slice(raw).unwrap();
+        let mut obj = base["cases"][0]["objects"][0].clone();
+        obj["policy_answer"] = serde_json::json!(102);
+        assert!(serde_json::from_value::<Object>(obj).is_err());
+        base["cases"][0]["objects"][0]["radius_mm"] = serde_json::json!(700);
+        let catalog: Catalog = serde_json::from_value(base).unwrap();
+        assert!(validate_case(&catalog.cases[0]).is_err());
+    }
+}
