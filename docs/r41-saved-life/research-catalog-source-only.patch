+#!/usr/bin/env python3
+"""Device-free CLI tests. Synthetic test artifacts are never evaluation evidence."""
+import copy
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+from types import SimpleNamespace
+import unittest
+
+import research_saved_life_catalog as runner
+
+ROOT = Path(__file__).resolve().parents[1]
+DATA = ROOT / "docs/research-saved-life"
+
+
+class CatalogCLI(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory(prefix="qualia-catalog-test.")
+        self.addCleanup(self._tmp.cleanup)
+        self.tmp = Path(self._tmp.name)
+        self.catalog = runner.parse((DATA / runner.CATALOG).read_bytes())
+        self.rubric = runner.parse((DATA / runner.RUBRIC).read_bytes())
+        self.a_current = self.tmp / "fake-current-a"
+        self.b_current = self.tmp / "fake-current-b"
+        self.a_current.write_text("TEST ONLY; not a Current")
+        self.b_current.write_text("TEST ONLY; different history identity")
+        self.evaluator = self.tmp / "no-execute"
+        self.evaluator.write_text("TEST ONLY; not an executable")
+
+    def go(self, case="contact-hot-left", *, missing_current=False, extras=(), a_overrides=None, raw_catalog=None,
+           no_b_current=False, same_host=False):
+        a, b = ((self.tmp / "missing-first-current") if missing_current else self.a_current), self.b_current
+        if same_host:
+            b = a
+        cat, rub, admit = (self.tmp / s for s in (runner.CATALOG,runner.RUBRIC,runner.ADMISSION))
+        cat.write_bytes(raw_catalog if raw_catalog is not None else json.dumps(self.catalog).encode())
+        rub.write_text(json.dumps(self.rubric))
+        admission = dict(schema="qualia.saved_life.operator_research_admission.v1",catalog_sha256=runner.sha(cat),
+                         rubric_sha256=runner.sha(rub),evaluator_sha256=runner.sha(self.evaluator),
+                         admitted_case_ids=list(self.rubric["cases"]))
+        admission.update(a_overrides or {})
+        admit.write_text(json.dumps(admission))
+        argv = [sys.executable,str(ROOT/"scripts/research_saved_life_catalog.py"),"--case",case,
+                "--world-seed","77","--nonce","87","--admission",str(admit),"--admission-sha256",runner.sha(admit),
+                "--rubric",str(rub),"--catalog",str(cat),"--evaluator",str(self.evaluator),"--a-current",str(a),
+                "--a-sha256",runner.sha(self.a_current),"--a-owner","3"]
+        if not no_b_current:
+            argv.extend(["--b-current",str(b),"--b-sha256",runner.sha(self.a_current if same_host else b),"--b-owner","3"])
+        return subprocess.run(argv+list(extras),capture_output=True,text=True)
+
+    def refused(self, result, reason):
+        self.assertEqual(result.returncode,2,result)
+        self.assertEqual(result.stdout,"")
+        self.assertIn(reason,result.stderr)
+
+    def test_same_entrypoint_two_catalog_families_and_foils(self):
+        cases = ["contact-hot-left","contact-same-hot-harmless-left","contact-warm-edible-left","reach-food","reach-inert"]
+        seen = set()
+        for case in cases:
+            result = self.go(case)
+            self.assertEqual(result.returncode,0,result)
+            report = runner.parse(result.stdout)
+            self.assertEqual(report["comparison_kind"],"independent_saved_life_comparison")
+            self.assertFalse(report["promotion_eligible"])
+            a, b = report["arm_manifests"].values()
+            self.assertNotEqual(a["source_current_sha256"],b["source_current_sha256"])
+            self.assertEqual(a["expected_world_seed"],b["expected_world_seed"])
+            self.assertEqual(a["evaluation_nonce"],b["evaluation_nonce"])
+            self.assertEqual(a["case_id"],b["case_id"])
+            self.assertNotIn("objects",a)
+            seen.add(report["fixture_sha256"])
+        self.assertEqual(len(seen),len(cases))
+
+    def test_explicit_same_host_typed_foundation_separate(self):
+        foundation = self.tmp / "not-a-real-foundation-device-free"
+        foundation.write_text("TEST ONLY")
+        result = self.go(same_host=True,extras=("--b-foundation",str(foundation),"--b-foundation-sha256",runner.sha(foundation)))
+        self.assertEqual(result.returncode,0,result)
+        report = runner.parse(result.stdout)
+        self.assertEqual(report["comparison_kind"],"same_host_foundation_comparison")
+        self.assertEqual(report["arm_manifests"]["B"]["input"],{"kind":"foundation_on_explicit_host","foundation_sha256":runner.sha(foundation)})
+        self.refused(self.go(same_host=True,extras=("--b-foundation",str(foundation))),"incomplete explicit host")
+        self.refused(self.go(no_b_current=True),"--b-current")
+
+    def test_rejects_unadmitted_and_malformed_before_checkpoint_access(self):
+        self.refused(self.go("not-admitted",missing_current=True),"case not explicitly admitted")
+        self.refused(self.go(missing_current=True,a_overrides={"catalog_sha256":"0"*64}),"unadmitted research catalog")
+        self.refused(self.go(missing_current=True,a_overrides={"evaluator_sha256":runner.V1_ELF}),"unadmitted research catalog")
+        self.refused(self.go(missing_current=True,raw_catalog=b'{"schema":1,"schema":2}'),"duplicate JSON field")
+        self.catalog["cases"][0]["objects"][0]["policy_answer"] = 102
+        self.refused(self.go(missing_current=True),"invalid physical object fields")
+        del self.catalog["cases"][0]["objects"][0]["policy_answer"]
+        self.catalog["cases"][0]["objects"][0]["radius_mm"] = 700
+        self.refused(self.go(missing_current=True),"opening contact too deep")
+        self.catalog["cases"][0]["objects"][0]["radius_mm"] = 610
+        self.catalog["cases"][0]["opening_contacts"] = []
+        self.refused(self.go(missing_current=True),"opening contacts do not match")
+
+    def test_checks_source_hashes_and_refuses_execution_without_receipts(self):
+        self.refused(self.go(missing_current=True),"expected regular private input")
+        self.refused(self.go(extras=("--b-sha256","7"*64)),"SHA-256 mismatch")
+        self.refused(self.go(extras=("--execute",)),"execute requires existing shared lease")
+
+    def test_observer_requires_paid_same_target_and_sustained_physical_exit(self):
+        t0, subject = 123, 19
+        def frame(tick, clearance, injured):
+            return dict(tick=tick,actual_contacts=[subject] if clearance<0 else [],alive=True,
+                        injury=injured,objects=[dict(id=subject,radial_clearance_m=clearance)])
+        native = dict(world_ticks=4,captured_decisions=1,organism_id=3,research_physical_setup=dict(
+            tick=t0,objects=[dict(slot="sample-a",id=subject)],contacts=[subject],opening_body_observation=frame(t0,-0.008,0)),
+            research_native_body_observations=[frame(t0+i,value,.04) for i,value in enumerate((.080,.086,.093,.10),1)])
+        row = dict(row=0,organism=3,decision_tick=t0,outcome_tick=t0+1,food_events=[],joint_physical=dict(channel_outcomes=[{
+            "channel":"Locomotion","execution_evidence":dict(primitive=102,command_target=subject,succeeded=True)}]))
+        study = SimpleNamespace(rubric=self.rubric,case={"id":"contact-hot-left"})
+        self.assertTrue(runner.score_native(native,[row],study)["passed"])
+        wrong = copy.deepcopy(row)
+        wrong["joint_physical"]["channel_outcomes"][0]["execution_evidence"]["command_target"] = 17
+        self.assertFalse(runner.score_native(native,[wrong],study)["passed"])
+        native["research_native_body_observations"][1] = frame(t0+2,-0.001,.04)
+        self.assertFalse(runner.score_native(native,[row],study)["passed"])
+
+
+if __name__ == "__main__":
+    unittest.main()
