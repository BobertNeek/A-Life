+//! Local allocator names are bookkeeping only, never catalog or behavior data.
+
+pub(super) fn neutral_label(ordinal: usize, mut occupied: impl FnMut(&str) -> bool) -> Option<String> {
+    (0..=16).map(|attempt| format!("research sample {ordinal}-{attempt}"))
+        .find(|label| !occupied(label))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::neutral_label;
+    use alife_core::Vec3f;
+    use alife_world::{HeadlessWorld, WorldEditorSpawnSpec, WorldObjectKind};
+
+    #[test]
+    fn actual_world_allocator_admits_two_distinct_research_props() {
+        let mut world = HeadlessWorld::new(17);
+        let mut ids = Vec::new();
+        // First occupied local name simulates an original host prop, not a research result.
+        for (label, kind, x, nutrition, pain) in [
+            (Some("research sample 0-0"), WorldObjectKind::Obstacle, 4.0, 0.0, 0.0),
+            (None, WorldObjectKind::Hazard, 0.6, 0.0, 0.16),
+            (None, WorldObjectKind::Food, 1.7, 0.65, 0.0),
+        ] {
+            let ordinal = ids.len().saturating_sub(1);
+            let label = label.map(str::to_owned).unwrap_or_else(|| {
+                neutral_label(ordinal, |candidate| world.entity_id(candidate).is_some()).unwrap()
+            });
+            let id = world.editor_spawn_object(WorldEditorSpawnSpec {
+                label: label.clone(), kind, organism_id: None, position: Vec3f::new(x, 0.0, 0.0),
+                nutrition, hazard_pain: pain, radius: 0.32, token_id: None,
+            }).expect("ordinary native editor accepts each neutral, unique local label");
+            assert_eq!(world.entity_id(&label), Some(id));
+            assert!(!ids.contains(&id));
+            ids.push(id);
+        }
+        assert_eq!(world.entity(ids[1]).unwrap().hazard_pain, 0.16);
+        assert_eq!(world.entity(ids[2]).unwrap().nutrition, 0.65);
+    }
+}
