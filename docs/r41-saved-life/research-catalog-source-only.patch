+++ b/scripts/research_saved_life_catalog.py
@@ -0,0 +1,527 @@
+#!/usr/bin/env python3
+"""Prepare or run paired, independently admitted native saved-life research.
+
+Research only: this never reads or writes SURGERY_STATE or emits promotion evidence.
+"""
+import argparse
+from dataclasses import dataclass
+import fcntl
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import shutil
+import signal
+import stat
+import subprocess
+import time
+import re
+
+CATALOG = "research-catalog.v1.json"
+RUBRIC = "research-rubric.v1.json"
+ADMISSION = "operator-research-admission.v1.json"
+PROC = "process.json"
+CAP = 256 * 1024
+ARM_LIMIT = 512 * 1024 * 1024
+DISK_FLOOR = 9_900_000_000
+RUN_MIN_AVAILABLE_KB = 5_242_880
+V1_ELF = "588b60942ded9959eef5860e96bf546b2acd05a71fe6a6d77d9296304ff22bf6"
+DRIVER_SHA = "0004262f4dc95585492d55925face67a79a7c869ad8760b42ae01bd0bdb807a2"
+ICD_SHA = "9a6a0d616f3f2efc2d227f89653047e5330ff634b0519ffbf1b2c60dc1c0e0e7"
+
+
+def require(ok, message):
+    if not ok:
+        raise ValueError(message)
+
+
+def bytes_sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def pin_syntax(value):
+    return isinstance(value, str) and re.fullmatch(r"[a-f0-9]{64}", value) is not None
+
+
+def sha(path):
+    require(path.is_file() and not path.is_symlink(), f"expected regular private input: {path}")
+    with path.open("rb") as handle:
+        return hashlib.file_digest(handle, "sha256").hexdigest()
+
+
+def assert_pin(path, expected):
+    require(pin_syntax(expected) and sha(path) == expected, f"SHA-256 mismatch: {path}")
+
+
+def unique_fields(items):
+    fields = dict(items)
+    require(len(fields) == len(items), "duplicate JSON field")
+    return fields
+
+
+def parse(raw):
+    def invalid(s):
+        raise ValueError(f"invalid JSON number: {s}")
+    return json.loads(raw, object_pairs_hook=unique_fields, parse_constant=invalid)
+
+
+def read_small(path):
+    require(path.is_file() and not path.is_symlink(), f"expected regular local JSON: {path}")
+    with path.open("rb") as handle:
+        raw = handle.read(CAP + 1)
+    require(len(raw) <= CAP, "bounded research JSON too large")
+    return raw
+
+
+def write_json(path, obj):
+    with path.open("x", encoding="utf-8") as handle:
+        json.dump(obj, handle, ensure_ascii=True, allow_nan=False, sort_keys=True, indent=2)
+        handle.write("\n")
+
+
+def exact_keys(item, expected, name):
+    require(isinstance(item, dict) and item.keys() == set(expected.split()), f"invalid {name} fields")
+
+
+def slug(value):
+    return isinstance(value, str) and re.fullmatch(r"[a-z0-9_-]{1,64}", value) is not None
+
+
+def bounded(value, bottom, top):
+    return type(value) is int and bottom <= value <= top
+
+
+def validate_case(case):
+    exact_keys(case, "id max_decisions max_world_ticks objects opening_contacts", "research case")
+    require(slug(case["id"]) and bounded(case["max_decisions"], 1, 256)
+            and bounded(case["max_world_ticks"], case["max_decisions"], 2048)
+            and isinstance(case["objects"], list) and 1 <= len(case["objects"]) <= 4,
+            "invalid research bounds or id")
+    points, slots, contacts = [], set(), set()
+    for obj in case["objects"]:
+        exact_keys(obj, "slot kind forward_mm left_mm radius_mm temperature_milli pain_milli nutrition_milli", "physical object")
+        slot, kind, f, l, r, temp, pain, meal = (obj[k] for k in (
+            "slot", "kind", "forward_mm", "left_mm", "radius_mm", "temperature_milli", "pain_milli", "nutrition_milli"))
+        require(slug(slot) and slot not in slots and bounded(f, 100, 2600) and bounded(l, -1600, 1600)
+                and f*f+l*l <= 3000**2 and bounded(r, 100, 750) and bounded(temp, -900, 900)
+                and bounded(pain, 0, 250) and bounded(meal, 0, 1000)
+                and ((kind == "hazard" and meal == 0) or (kind == "obstacle" and pain == meal == 0)
+                     or (kind == "food" and pain == 0 and 50 <= meal <= 1000)), "invalid bounded physical object")
+        slots.add(slot)
+        for a, b, c in points:
+            require((a-f)**2+(b-l)**2 > (c+r+20)**2, "physical fixture objects overlap")
+        points.append((f,l,r))
+        d = f*f+l*l
+        require(d >= (r-25)**2, "opening contact too deep")
+        if d <= (r-2)**2:
+            contacts.add(slot)
+        else:
+            require(d > (r+2)**2, "ambiguous physical opening contact")
+    expected = case["opening_contacts"]
+    require(isinstance(expected, list) and all(slug(e) for e in expected) and contacts == set(expected)
+            and len(contacts) == len(expected), "opening contacts do not match physical layout")
+
+
+@dataclass(frozen=True)
+class Research:
+    raw: dict
+    admission: dict
+    catalog: dict
+    rubric: dict
+    case: dict
+
+    @property
+    def fixture(self):
+        return bytes_sha(f"qualia-research-fixture/v1\0{self.admission['catalog_sha256']}\0{self.case['id']}".encode())
+
+
+def research(args):
+    inputs = {ADMISSION: read_small(args.admission), CATALOG: read_small(args.catalog), RUBRIC: read_small(args.rubric)}
+    require(pin_syntax(args.admission_sha256) and bytes_sha(inputs[ADMISSION]) == args.admission_sha256,
+            "operator admission SHA-256 mismatch")
+    a, c, r = (parse(inputs[f]) for f in inputs)
+    exact_keys(a, "schema catalog_sha256 rubric_sha256 evaluator_sha256 admitted_case_ids", "operator admission")
+    require(a["schema"] == "qualia.saved_life.operator_research_admission.v1" and pin_syntax(a["evaluator_sha256"])
+            and a["evaluator_sha256"] != V1_ELF and a["catalog_sha256"] == bytes_sha(inputs[CATALOG])
+            and a["rubric_sha256"] == bytes_sha(inputs[RUBRIC]), "unadmitted research catalog, external rubric, or evaluator")
+    exact_keys(c, "schema catalog_id cases", "catalog")
+    require(c["schema"] == "qualia.saved_life.research_catalog.v1" and slug(c["catalog_id"])
+            and isinstance(c["cases"], list) and 1 <= len(c["cases"]) <= 64, "unsupported research catalog")
+    cases = {}
+    for row in c["cases"]:
+        validate_case(row)
+        require(row["id"] not in cases,"duplicate research catalog case")
+        cases[row["id"]] = row
+    ids = a["admitted_case_ids"]
+    require(isinstance(ids,list) and all(slug(k) for k in ids) and len(ids) == len(set(ids))
+            and set(ids) <= cases.keys() and args.case in ids, "case not explicitly admitted")
+    exact_keys(r, "schema rubric_id policy thresholds cases", "study rubric")
+    require(r["schema"] == "qualia.saved_life.research_rubric.v1" and slug(r["rubric_id"])
+            and isinstance(r["policy"], str) and r["cases"].keys() == cases.keys(), "unmatched research rubric inventory")
+    threshold_bounds = dict(escape_decisions=(1,32), outside_world_intervals=(1,16), min_radial_gain_mm=(1,1000),
+                            maximum_injury_increment_milli=(0,1000))
+    exact_keys(r["thresholds"]," ".join(threshold_bounds),"observer thresholds")
+    require(all(bounded(r["thresholds"][k], *v) for k,v in threshold_bounds.items()), "unbounded observer rubric")
+    for name, spec in r["cases"].items():
+        exact_keys(spec,"metric subject","observer case")
+        require(spec["metric"] in ("protective_exit","harmless_contact","native_meal","no_fake_meal")
+                and spec["subject"] in {x["slot"] for x in cases[name]["objects"]}, "unbound observer rubric subject")
+    assert_pin(args.evaluator, a["evaluator_sha256"])
+    return Research(inputs, a, c, r, cases[args.case])
+
+
+@dataclass(frozen=True)
+class Input:
+    label: str
+    current: Path
+    current_sha: str
+    owner: int
+    foundation: Path | None
+    foundation_sha: str | None
+
+    def mode(self):
+        return ({"kind":"foundation_on_explicit_host","foundation_sha256":self.foundation_sha}
+                if self.foundation else {"kind":"complete_saved_life"})
+
+
+def input_arm(args, label):
+    key = label.lower()
+    current, current_sha, owner, foundation, foundation_sha = (getattr(args, f"{key}_{k}") for k in (
+        "current", "sha256", "owner", "foundation", "foundation_sha256"))
+    require((foundation is None) == (foundation_sha is None) and bounded(owner, 1, 2**64-1), "incomplete explicit host/asset or invalid owner")
+    assert_pin(current, current_sha)
+    if foundation:
+        require(0 < foundation.stat().st_size <= 1024*1024, "unsupported standalone Foundation size")
+        assert_pin(foundation, foundation_sha)
+    return Input(label, current, current_sha, owner, foundation, foundation_sha)
+
+
+def command_manifest(args, study, arm, *, now):
+    return {"schema":2,"profile":"research_catalog_v1","run_id":f"research-{study.case['id'][:45]}-{arm.label}",
+            "owner":arm.owner,"source_current_sha256":arm.current_sha,"input":arm.mode(),"case_id":study.case["id"],
+            "catalog_sha256":study.admission["catalog_sha256"],"rubric_sha256":study.admission["rubric_sha256"],
+            "evaluator_sha256":study.admission["evaluator_sha256"],"expected_world_seed":args.world_seed,
+            "evaluation_nonce":args.nonce,"deadline_unix_seconds":now+420,"finalization_deadline_unix_seconds":now+510,
+            "max_output_bytes":ARM_LIMIT}
+
+
+def reopen_anchor(args, study, arm):
+    prefix = arm.label.lower()
+    accepted_path, accepted_pin, process_path, process_pin, raw_path = (getattr(args,f"{prefix}_{k}") for k in (
+        "reopen", "reopen_sha256", "reopen_process", "reopen_process_sha256", "reopen_raw"))
+    require(all(x is not None for x in (accepted_path,accepted_pin,process_path,process_pin,raw_path)),
+            "execute requires independently pinned zero-cut accepted/native/process evidence for both host Currents")
+    assert_pin(accepted_path,accepted_pin)
+    assert_pin(process_path,process_pin)
+    accepted, process = parse(read_small(accepted_path)), parse(read_small(process_path))
+    assert_pin(raw_path,accepted["receipt_sha256"])
+    raw = parse(read_small(raw_path))
+    expected = study.admission["evaluator_sha256"]
+    require(accepted["schema"] == "qualia.accepted_saved_life_reopen.v1" and accepted["source_current_sha256"] == arm.current_sha
+            and accepted["executable_sha256"] == expected and accepted["semantic_prior_mode"] == "off"
+            and all(accepted[k] is True for k in ("independently_accepted","zero_cut","same_individual","source_unchanged",
+                 "gpu_restored","private_world_memory_neural_and_sampling_preserved")), "wrong independently accepted reopen")
+    require(bounded(accepted["tick_start"],1,2**64-1) and accepted["tick_end"] == accepted["tick_start"]
+            and bounded(accepted["parent_pid"],1,2**31-1) and bounded(accepted["child_pid"],1,2**31-1)
+            and accepted["parent_pid"] != accepted["child_pid"] and accepted["child_exit"] == 0,
+            "reopen must be a successful stationary separate process")
+    require(all(process[k]==v for k,v in dict(evaluator_sha256=expected,current_sha256=arm.current_sha,
+        native_receipt_sha256=accepted["receipt_sha256"],parent_pid=accepted["parent_pid"],child_pid=accepted["child_pid"],
+        finished_at=accepted["finished_at"],exit_code=0).items()), "zero-cut process/acceptance pins disagree")
+    ep = raw["final_endpoint"]
+    require(raw["stop_reason"] == "restore_only" and raw["source_sha256"] == ep["source_current_sha256"] == arm.current_sha
+            and raw["source_world_tick"] == ep["world_tick"] == accepted["tick_start"] and raw["organism_id"] == arm.owner
+            and all(raw[k] is True for k in ("source_unchanged","gpu_restored","software_simulation_integrity_valid"))
+            and all(type(raw[k]) is int and raw[k] == 0 for k in ("captured_decisions","world_ticks","offline_actor_updates","offline_value_updates"))
+            and all(ep[k] is True for k in ("same_individual","private_world_memory_neural_and_sampling_preserved","actor_value_Adam_unchanged"))
+            and all(ep["zero_step_equality"][k] is True for k in ("world_json_byteequal", "sleep_journal_byteequal",
+                 "private_asset_closure_byteequal","saved_sampling_equal")), "native zero-cut receipt does not prove retained life")
+    return {"accepted_sha256":accepted_pin,"process_sha256":process_pin,"native_sha256":accepted["receipt_sha256"],"tick":accepted["tick_start"]}
+
+
+def guard_lease(fd, path):
+    a, b = os.fstat(fd), path.lstat()
+    require((a.st_dev,a.st_ino) == (b.st_dev,b.st_ino) and stat.S_ISREG(a.st_mode)
+            and stat.S_IMODE(a.st_mode) == 0o600 and a.st_size == 0 and a.st_nlink == 1 and a.st_uid == os.getuid(),
+            "shared native lease identity changed")
+
+
+def resource_floor(path):
+    available = int(next(line.split()[1] for line in Path("/proc/meminfo").read_text().splitlines() if line.startswith("MemAvailable:")))
+    require(shutil.disk_usage(path).free >= DISK_FLOOR and available >= RUN_MIN_AVAILABLE_KB, "shared native resource floor")
+
+
+def proc_group_alive(pid):
+    for p in Path("/proc").glob("[0-9]*/stat"):
+        try:
+            tail = p.read_text().rsplit(")",1)[1].split()
+            if tail[0] not in ("X","Z") and int(tail[2]) == pid:
+                return True
+        except (OSError,IndexError,ValueError):
+            continue
+    return False
+
+
+def score_native(result, rows, study):
+    """External read-only scoring. The simulator receives no metric or answer."""
+    opening = result["research_physical_setup"]
+    spec = study.rubric["cases"][study.case["id"]]
+    thresholds = study.rubric["thresholds"]
+    subject = next(o for o in opening["objects"] if o["slot"] == spec["subject"])
+    target, t0 = subject["id"], opening["tick"]
+    post = result["research_native_body_observations"]
+    require([x["tick"] for x in post] == list(range(t0+1,t0+1+result["world_ticks"]))
+            and len(rows) == result["captured_decisions"]
+            and all(x["row"] == i and x["organism"] == result["organism_id"] for i,x in enumerate(rows)),
+            "native row/continuous observation count or identity mismatch")
+    require(bool(rows), "no native biological decision evidence")
+    by_tick = {x["tick"]:x for x in [opening["opening_body_observation"],*post]}
+    require(all(x["outcome_tick"] in by_tick and x["decision_tick"] == x["outcome_tick"]-1 for x in rows),
+            "native decisions do not bind to enclosing world intervals")
+
+    def clearance(frame):
+        return next(x["radial_clearance_m"] for x in frame["objects"] if x["id"] == target)
+
+    def paid(row, channel, primitive):
+        return any(c["channel"] == channel and e["primitive"] == primitive and e["command_target"] == target and e["succeeded"] is True
+                   for c in row["joint_physical"]["channel_outcomes"] if (e:=c.get("execution_evidence")) is not None)
+
+    early = rows[:thresholds["escape_decisions"]]
+    paid_flees = [r for r in early if paid(r,"Locomotion",102)]
+    flees = [r for r in paid_flees if clearance(by_tick[r["outcome_tick"]]) is not None
+             and clearance(by_tick[r["decision_tick"]]) is not None
+             and clearance(by_tick[r["outcome_tick"]]) > clearance(by_tick[r["decision_tick"]])]
+    first_flee = flees[0]["row"] + 1 if flees else None
+    first_flee_tick = flees[0]["outcome_tick"] if flees else None
+    opened_contact = target in opening["contacts"]
+    width = thresholds["outside_world_intervals"]
+    gain = thresholds["min_radial_gain_mm"] / 1000
+    injury0 = by_tick[t0]["injury"]
+    start_clearance = clearance(by_tick[t0])
+    exit_tick = None
+    peak_injury = None
+    if first_flee_tick is not None:
+        for i,x in enumerate(post):
+            hold = post[i:i+width]
+            if not first_flee_tick <= x["tick"] <= early[-1]["outcome_tick"] or len(hold) != width:
+                continue
+            if all(y["alive"] and target not in y["actual_contacts"] and clearance(y) is not None
+                   and clearance(y) >= 0 and clearance(y)-start_clearance >= gain for y in hold):
+                exit_tick = x["tick"]
+                peak_injury = max(z["injury"] - injury0 for z in post[:i+width])
+                break
+    acquired = None
+    meal_tick = None
+    nutrition = None
+    for r in rows:
+        for food in r["food_events"]:
+            if food["target"] != target:
+                continue
+            if (food["acquired"] is True and food["after"]["owner"] == result["organism_id"]
+                    and (paid(r,"Manipulation",210) or paid(r,"Manipulation",211))):
+                acquired = r["outcome_tick"]
+            if (acquired is not None and paid(r,"Manipulation",210) and r["outcome_tick"] > acquired
+                    and food["consumed"] is True and food["nourished"] is True
+                    and food["before"]["owner"] == result["organism_id"] and food["hazard_pain_before"] == 0
+                    and math.isfinite(food["nutrition_before"]) and food["nutrition_before"] > 0):
+                meal_tick, nutrition = r["outcome_tick"], food["nutrition_before"]
+                break
+        if meal_tick is not None:
+            break
+    metric = spec["metric"]
+    if metric == "protective_exit":
+        require(opened_contact, "required genuine protective contact did not materialize")
+        passed = exit_tick is not None and peak_injury <= thresholds["maximum_injury_increment_milli"] / 1000
+    elif metric == "harmless_contact":
+        require(opened_contact, "required harmless contact did not materialize")
+        passed = len(early) == thresholds["escape_decisions"] and not paid_flees
+    elif metric == "native_meal":
+        passed = meal_tick is not None
+    else:
+        passed = (len(early) == thresholds["escape_decisions"] and not any(f["target"] == target and f["nourished"]
+                  for r in rows for f in r["food_events"]))
+    return {"metric":metric,"subject":spec["subject"],"passed":passed,"actual_opening_contact":opened_contact,
+            "early_paid_targeted_flees":len(paid_flees),
+            "first_paid_outward_flee_decision":first_flee,"first_sustained_egress_tick":exit_tick,
+            "peak_injury_increment_to_egress":peak_injury,"actual_acquisition_tick":acquired,
+            "actual_nourished_meal_tick":meal_tick,"actual_food_nutrition":nutrition}
+
+
+def measured_receipt(work, arm, study, manifest, pin):
+    root = work/"native"
+    rr = root/"retention.json"
+    result = parse(rr.read_bytes())
+    body = result["retained_experiment"]
+    profile = result["research_catalog"]
+    require(result["source_sha256"] == arm.current_sha and result["source_world_seed"] == manifest["expected_world_seed"]
+            and result["organism_id"] == arm.owner and body["identity"]["manifest_sha256"] == pin
+            and body["scorecard_eligible"] is False and result["source_unchanged"] is True and result["prior_remained_off"] is True
+            and result["measurement_valid"] is True and result["coverage_complete"] is True and result["gpu_restored"] is True
+            and result["software_simulation_integrity_valid"] is True and result["final_endpoint"]["same_individual"] is True,
+            "invalid native research evidence or identity")
+    for k, v in {k:manifest[k] for k in ("case_id","catalog_sha256","rubric_sha256","evaluator_sha256",
+             "evaluation_nonce","expected_world_seed","input")}.items():
+        require(profile[k] == v, f"native research receipt drift: {k}")
+    require(profile["admission_sha256"] == bytes_sha(study.raw[ADMISSION]) and profile["fixture_sha256"] == study.fixture
+            and result["request"]["evaluation_nonce"] == manifest["evaluation_nonce"]
+            and all(result["request"][k] == study.case[k] for k in ("max_decisions","max_world_ticks")),
+            "native fixture or budget differs from admitted identity")
+    assert_pin(root/"rows.jsonl",result["rows_sha256"])
+    with (root/"rows.jsonl").open("rb") as handle:
+        observer_keys = ("row","organism","decision_tick","outcome_tick","joint_physical","food_events")
+        rows = [{k: value[k] for k in observer_keys} for line in handle if (value:=parse(line)) is not None]
+    measured = score_native(result,rows,study)
+    if arm.foundation:
+        aux = result["research_foundation_host"]
+        require(aux["exact_asset_installed"] is True and aux["same_individual_and_acquired_state_retained"] is True,
+                "unsupported Foundation host installation")
+        expected_current = aux["effective_current_sha256"]
+        if expected_current != arm.current_sha:
+            assert_pin(root/"CALIBRATED-PARENT.alife-checkpoint",expected_current)
+    else:
+        require(result["request"]["direct_weights"] is None and "direct_weight_calibration" not in result,
+                "complete saved life unexpectedly recompiled direct weights")
+        expected_current = arm.current_sha
+    return {"native_receipt_sha256":sha(rr),"rows_sha256":result["rows_sha256"],"effective_current_sha256":expected_current,
+            "captured_decisions":result["captured_decisions"],"world_ticks":result["world_ticks"],"sampling_before":result["sampling_before"],
+            "physical_setup":result["research_physical_setup"],"measured_outcome":measured}
+
+
+def run_arm(args, study, arm, work, leased, reopen):
+    resource_floor(work.parent)
+    require(shutil.disk_usage(work.parent).free >= DISK_FLOOR + ARM_LIMIT + arm.current.stat().st_size,
+            "insufficient resource headroom to keep the shared 9.9 GB floor throughout an arm")
+    work.mkdir(mode=0o700)
+    current = work/"input.alife-checkpoint"
+    shutil.copyfile(arm.current,current)
+    current.chmod(0o400)
+    assert_pin(current,arm.current_sha)
+    for name, raw in study.raw.items():
+        (work/name).write_bytes(raw)
+        (work/name).chmod(0o400)
+    if arm.foundation:
+        shutil.copyfile(arm.foundation,work/"input.alife-foundation")
+        assert_pin(work/"input.alife-foundation",arm.foundation_sha)
+        (work/"input.alife-foundation").chmod(0o400)
+    for f in ("home","tmp","cache","runtime"):
+        (work/f).mkdir(mode=0o700)
+    now = int(time.time())
+    manifest = command_manifest(args,study,arm,now=now)
+    manifest_path = work/"manifest.json"
+    write_json(manifest_path,manifest)
+    manifest_pin = sha(manifest_path)
+    child_env = {"PATH":"/usr/bin:/bin","LANG":"C.UTF-8","HOME":str(work/"home"),"TMPDIR":str(work/"tmp"),
+        "XDG_CACHE_HOME":str(work/"cache"),"XDG_RUNTIME_DIR":str(work/"runtime"),
+        "ALIFE_EXPLICIT_FIXED_HOST_PRESSURE_NS":"0","ALIFE_EXPLICIT_SOFTWARE_RETENTION_TEST":"1",
+        "ALIFE_SLM_PRIOR":"off","ALIFE_SLM_PRIOR_BACKEND":"off","LD_LIBRARY_PATH":str(args.lavapipe_so.resolve().parent),
+        "VK_DRIVER_FILES":str(args.lavapipe_icd.resolve())}
+    cmd = [str(args.evaluator.resolve()),"--experiment-manifest",str(work),str(current),str(work/"native"),str(manifest_path)]
+    stopped = None
+    with (work/"stdout").open("xb") as stdout,(work/"stderr").open("xb") as stderr:
+        child = subprocess.Popen(cmd,cwd=work,env=child_env,stdin=subprocess.DEVNULL,stdout=stdout,stderr=stderr,start_new_session=True)
+        try:
+            while child.poll() is None:
+                guard_lease(leased,args.lease)
+                resource_floor(work)
+                require(time.time() < now + 540, "native research arm deadline reached")
+                require(sum(p.stat().st_blocks*512 for p in work.rglob("*") if p.is_file()) <= 1_000_000_000,
+                        "native research arm artifact cap reached")
+                time.sleep(0.2)
+        except (OSError, ValueError) as exc:
+            stopped = str(exc)
+        finally:
+            for sig in (signal.SIGTERM,signal.SIGKILL):
+                if child.poll() is not None and not proc_group_alive(child.pid):
+                    break
+                try:
+                    os.killpg(child.pid,sig)
+                except ProcessLookupError:
+                    pass
+                try:
+                    child.wait(5)
+                except subprocess.TimeoutExpired:
+                    continue
+    rr = work/"native/retention.json"
+    process = {"parent_pid":os.getpid(),"child_pid":child.pid,"exit_code":child.returncode,"stop":stopped,
+               "native_receipt_sha256":sha(rr) if rr.is_file() else None,"manifest_sha256":manifest_pin,"reopen":reopen,
+               "current_sha256":arm.current_sha,"evaluator_sha256":manifest["evaluator_sha256"],"group_reaped":not proc_group_alive(child.pid)}
+    write_json(work/PROC,process)
+    require(not stopped and child.returncode == 0 and process["group_reaped"], f"native research arm did not complete: {stopped or child.returncode}")
+    assert_pin(arm.current,arm.current_sha)
+    assert_pin(current,arm.current_sha)
+    if arm.foundation:
+        assert_pin(arm.foundation,arm.foundation_sha)
+        assert_pin(work/"input.alife-foundation",arm.foundation_sha)
+    assert_pin(args.evaluator,manifest["evaluator_sha256"])
+    return measured_receipt(work,arm,study,manifest,manifest_pin)
+
+
+def start_live(args, study, arms, names):
+    require(all(x is not None for x in (args.lease,args.lavapipe_so,args.lavapipe_icd,args.output)),
+            "execute requires existing shared lease, exact Vulkan driver and private output")
+    require(args.lease.is_absolute() and args.lease.name == ".qualia-stock-U-A-exclusive.lock" and not args.lease.is_symlink(),
+            "execute requires the operator-configured existing shared native lease")
+    require(args.lavapipe_so.name == "libvulkan_lvp.so", "wrong software Vulkan driver name")
+    assert_pin(args.lavapipe_so,DRIVER_SHA)
+    assert_pin(args.lavapipe_icd,ICD_SHA)
+    reopens = [reopen_anchor(args,study,arm) for arm in arms]
+    output = args.output.parent.resolve(strict=True)/args.output.name
+    require(output.name not in {"", ".", ".."} and not output.exists() and not output.is_symlink(), "output must be a new isolated run")
+    with args.lease.open("rb") as lease:
+        guard_lease(lease.fileno(),args.lease)
+        fcntl.flock(lease,fcntl.LOCK_EX | fcntl.LOCK_NB)
+        resource_floor(output.parent)
+        output.mkdir(mode=0o700)
+        evidence = [run_arm(args,study,a,output/a.label,lease.fileno(),r) for a,r in zip(arms,reopens,strict=True)]
+        names["verified_native_arms"] = {a.label:e for a,e in zip(arms,evidence,strict=True)}
+        if arms[0].current_sha == arms[1].current_sha:
+            require(evidence[0]["sampling_before"] == evidence[1]["sampling_before"]
+                    and evidence[0]["physical_setup"] == evidence[1]["physical_setup"], "matched-host opening or sampler drift")
+        write_json(output/"comparison.json",names)
+    return names
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    for key in ("catalog","rubric","admission","evaluator"):
+        p.add_argument(f"--{key}",required=True,type=Path)
+    for key in ("admission-sha256","case"):
+        p.add_argument(f"--{key}",required=True)
+    for key in ("world-seed","nonce"):
+        p.add_argument(f"--{key}",required=True,type=int)
+    for key in ("output","lease","lavapipe-so","lavapipe-icd"):
+        p.add_argument(f"--{key}",type=Path)
+    for key in ("a","b"):
+        p.add_argument(f"--{key}-current",required=True,type=Path)
+        p.add_argument(f"--{key}-sha256",required=True)
+        p.add_argument(f"--{key}-owner",required=True,type=int)
+        for item in ("foundation","reopen","reopen-process","reopen-raw"):
+            p.add_argument(f"--{key}-{item}",type=Path)
+        for item in ("foundation-sha256","reopen-sha256","reopen-process-sha256"):
+            p.add_argument(f"--{key}-{item}")
+    p.add_argument("--execute",action="store_true",help="operator/verifier only; default is device-free plan")
+    args = p.parse_args()
+    try:
+        require(bounded(args.world_seed,0,2**64-1) and bounded(args.nonce,1,2**64-1), "invalid matched seed/nonce")
+        study = research(args)  # validate admitted layout before hashing either Current
+        arms = [input_arm(args,k) for k in ("A","B")]
+        kind = ("independent_saved_life_comparison" if arms[0].current_sha != arms[1].current_sha else
+                "same_host_foundation_comparison" if arms[0].foundation_sha != arms[1].foundation_sha else "same_input_repeat")
+        require(arms[0].current_sha != arms[1].current_sha or arms[0].owner == arms[1].owner, "same Current must specify the same live owner")
+        result = {"schema":"qualia.saved_life.research_comparison.v1","comparison_kind":kind,
+                  "promotion_eligible":False,"catalog_sha256":study.admission["catalog_sha256"],
+                  "rubric_sha256":study.admission["rubric_sha256"],"evaluator_sha256":study.admission["evaluator_sha256"],
+                  "fixture_sha256":study.fixture,"case_id":study.case["id"],"source_world_seed":args.world_seed,
+                  "evaluation_nonce":args.nonce,"same_fixture_not_same_acquired_history":kind=="independent_saved_life_comparison",
+                  "arm_manifests":{arm.label:command_manifest(args,study,arm,now=int(time.time())) for arm in arms}}
+        if args.execute:
+            os.umask(0o077)
+            result = start_live(args,study,arms,result)
+        print(json.dumps(result,indent=2,allow_nan=False))
+    except (OSError,ValueError,TypeError,KeyError,AttributeError,OverflowError) as exc:
+        p.exit(2,f"research comparison refused: {exc}\n")
+
+
+if __name__ == "__main__":
+    main()
