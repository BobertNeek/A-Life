@@ -0,0 +1,785 @@
+//! Detached schema-6 opening witnesses. No full composition trial or policy port.
+use super::{digest, Result};
+use alife_core::{
+    ActionKind, CandidateActionFamily, CandidateObservationRef, LanguageTokenId, OrganismId,
+    PerceptionFrame,
+    SensorProfile, Tick, UtteranceSourceKind, Vec3f, WorldEntityId,
+};
+use alife_gpu_backend::{GpuTrainingBehaviorKind, GpuTrainingRolloutReceipt};
+use alife_world::{AudibleUtterance, HeadlessActionIds, HeadlessWorld, WorldObjectKind};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{fs, io::Read, path::Path};
+
+pub(super) const SCHEMA: u16 = 6;
+pub(super) const OUTPUT_BYTES: u64 = 256 * 1024 * 1024;
+pub(super) const GEOMETRY_LEAF: &str = "language-composition-geometry-proof.v3.json";
+const OPENING_PAIR_LEAF: &str = "language-composition-opening-pair-proof.v1.json";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Phase {
+    Geometry,
+    Opening,
+    Ttl,
+}
+
+impl Phase {
+    pub(super) fn decisions(self) -> usize {
+        match self {
+            Self::Geometry => 0,
+            Self::Opening => 1,
+            Self::Ttl => 3,
+        }
+    }
+
+    fn accepts(self, tokens: &[LanguageTokenId]) -> bool {
+        match self {
+            Self::Geometry => tokens.is_empty(),
+            Self::Opening | Self::Ttl => tokens.iter().map(|x| x.raw()).eq([9]),
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Layout { A, B }
+
+#[derive(Clone, Debug, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+struct Cell {
+    layout: Layout,
+    player_tokens: Vec<LanguageTokenId>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Manifest {
+    schema: u16,
+    fixture_id: String,
+    pub(super) run_id: String,
+    pub(super) source_current_sha256: String,
+    admission_sha256: String,
+    phase: Phase,
+    cell: Cell,
+    pub(super) deadline_unix_seconds: u64,
+    pub(super) finalization_deadline_unix_seconds: Option<u64>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Admission {
+    schema: String,
+    fixture_id: String,
+    phase: Phase,
+    run_id: String,
+    cell: Cell,
+    source_current_sha256: String,
+    evaluator_sha256: String,
+    fixture_sha256: String,
+    rubric_sha256: String,
+    operator_grant_sha256: String,
+    geometry_proof_sha256: Option<String>,
+    opening_pair_proof_sha256: Option<String>,
+}
+
+/// Deployment-specific owner, geometry and data digests stay in the separately
+/// admitted private leaf, not in distributed source or arbitrary manifest fields.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Fixture {
+    schema: String,
+    fixture_id: String,
+    source_current_sha256: String,
+    pub owner: u64,
+    tick: u64,
+    world_seed: u64,
+    object_count: usize,
+    pub nonce: u64,
+    props_food_ball: [WorldEntityId; 2],
+    berths_forward_left_mm: [[i32; 2]; 2],
+}
+
+#[derive(Serialize)]
+pub(super) struct Identity {
+    pub(super) phase: Phase,
+    cell: Cell,
+    fixture_id: String,
+    evaluator_sha256: String,
+    fixture_sha256: String,
+    admission_sha256: String,
+    rubric_sha256: String,
+    operator_grant_sha256: String,
+    source_current_sha256: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    geometry_proof_sha256: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    opening_pair_proof_sha256: Option<String>,
+    #[serde(skip)]
+    parent_geometry_setup_sha256: Option<String>,
+    #[serde(skip)]
+    fixture: Fixture,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct GeometryProof {
+    schema: String,
+    fixture_sha256: String,
+    source_current_sha256: String,
+    evaluator_sha256: String,
+    layout: Layout,
+    owner: u64,
+    world_tick: u64,
+    accepted_decisions: u64,
+    world_ticks: u64,
+    backend_constructed: bool,
+    runtime_or_queue_constructed: bool,
+    player_utterances_emitted: u64,
+    setup_sha256: String,
+    setup: Value,
+}
+
+// This is an external independent qualification of closed native runs, not
+// live authorization by self-assertion. The operator supplies a separately
+// verified, exact grant covering a single TTL layout and this proof's bytes.
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct TtlOperatorGrant {
+    schema: String,
+    phase: Phase,
+    fixture_id: String,
+    run_id: String,
+    cell: Cell,
+    source_current_sha256: String,
+    evaluator_sha256: String,
+    fixture_sha256: String,
+    rubric_sha256: String,
+    geometry_proof_sha256: String,
+    opening_pair_proof_sha256: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OpeningPairProof {
+    schema: String,
+    phase: Phase,
+    fixture_id: String,
+    source_current_sha256: String,
+    evaluator_sha256: String,
+    fixture_sha256: String,
+    rubric_sha256: String,
+    owner: u64,
+    opening_tick: u64,
+    opening_player_tokens: Vec<LanguageTokenId>,
+    layouts: [OpeningArm; 2],
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OpeningArm {
+    layout: Layout,
+    run_id: String,
+    accepted_decisions: u64,
+    world_ticks: u64,
+    manifest_sha256: String,
+    admission_sha256: String,
+    operator_grant_sha256: String,
+    geometry_proof_sha256: String,
+    retention_sha256: String,
+    rows_sha256: String,
+    final_current_sha256: String,
+}
+
+fn check_ttl_predecessor(
+    m: &Manifest, a: &Admission, f: &Fixture, grant: &TtlOperatorGrant, p: &OpeningPairProof,
+) -> Result<()> {
+    let pin = a.opening_pair_proof_sha256.as_deref().ok_or("TTL has no opening pair pin")?;
+    if grant.schema != "qualia.saved_life.language_composition_ttl_operator_grant.v1"
+        || grant.phase != Phase::Ttl || grant.fixture_id != a.fixture_id || grant.run_id != m.run_id
+        || grant.cell != m.cell || grant.source_current_sha256 != a.source_current_sha256
+        || grant.evaluator_sha256 != a.evaluator_sha256 || grant.fixture_sha256 != a.fixture_sha256
+        || grant.rubric_sha256 != a.rubric_sha256 || grant.opening_pair_proof_sha256 != pin
+        || a.geometry_proof_sha256.as_deref() != Some(grant.geometry_proof_sha256.as_str())
+        || p.schema != "qualia.saved_life.language_composition_opening_pair_proof.v1"
+        || p.phase != Phase::Opening || p.fixture_id != a.fixture_id
+        || p.source_current_sha256 != a.source_current_sha256 || p.evaluator_sha256 != a.evaluator_sha256
+        || p.fixture_sha256 != a.fixture_sha256 || p.rubric_sha256 != a.rubric_sha256
+        || p.owner != f.owner || p.opening_tick != f.tick || !Phase::Opening.accepts(&p.opening_player_tokens)
+    {
+        return Err("TTL operator grant or independently verified opening pair has a different identity".into());
+    }
+    let [x, y] = &p.layouts;
+    if x.layout != Layout::A || y.layout != Layout::B || x.run_id == y.run_id
+        || x.geometry_proof_sha256 == y.geometry_proof_sha256
+        || x.manifest_sha256 == y.manifest_sha256 || x.admission_sha256 == y.admission_sha256
+        || x.retention_sha256 == y.retention_sha256 || x.rows_sha256 == y.rows_sha256
+        || x.final_current_sha256 == y.final_current_sha256
+    {
+        return Err("TTL predecessor must be two distinct crossed opening witnesses".into());
+    }
+    for arm in &p.layouts {
+        if arm.accepted_decisions != 1 || arm.world_ticks != 1 || !is_slug(&arm.run_id)
+            || arm.run_id == m.run_id || arm.operator_grant_sha256 == a.operator_grant_sha256
+            || ![&arm.manifest_sha256, &arm.admission_sha256, &arm.operator_grant_sha256,
+                &arm.geometry_proof_sha256, &arm.retention_sha256, &arm.rows_sha256,
+                &arm.final_current_sha256].iter().all(|s| is_digest(s))
+            || (arm.layout == m.cell.layout && arm.geometry_proof_sha256 != grant.geometry_proof_sha256)
+        {
+            return Err("TTL predecessor is not the two exact separately granted 1/1 openings".into());
+        }
+    }
+    Ok(())
+}
+
+fn is_digest(pin: &str) -> bool {
+    pin.len() == 64 && pin.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+}
+fn is_slug(s: &str) -> bool {
+    !s.is_empty() && s.len() <= 80
+        && s.bytes().all(|c| c.is_ascii_alphanumeric() || matches!(c, b'_' | b'-'))
+}
+fn read_leaf(root: &Path, name: &str, limit: usize) -> Result<Vec<u8>> {
+    let path = root.join(name);
+    if path.canonicalize()? != path || !fs::symlink_metadata(&path)?.is_file() {
+        return Err("v3 requires a regular canonical sidecar".into());
+    }
+    let mut bytes = Vec::new();
+    fs::File::open(path)?.take((limit + 1) as u64).read_to_end(&mut bytes)?;
+    if bytes.is_empty() || bytes.len() > limit {
+        return Err("v3 sidecar outside bounded size".into());
+    }
+    Ok(bytes)
+}
+
+fn parse_manifest(bytes: &[u8]) -> Result<Manifest> {
+    if bytes.len() > 8192 { return Err("v3 manifest exceeds bound".into()); }
+    let m: Manifest = serde_json::from_slice(bytes)?;
+    if m.schema != SCHEMA || !is_slug(&m.fixture_id) || !is_slug(&m.run_id)
+        || !is_digest(&m.source_current_sha256) || !is_digest(&m.admission_sha256)
+        || !m.phase.accepts(&m.cell.player_tokens)
+    {
+        return Err("v3 manifest phase, scope or genuine Player token vector refused".into());
+    }
+    Ok(m)
+}
+
+fn exact_fixture(f: &Fixture, m: &Manifest) -> bool {
+    let [[near, left], [far, right]] = f.berths_forward_left_mm;
+    f.schema == "qualia.saved_life.language_composition_fixture.v3"
+        && f.fixture_id == m.fixture_id && f.source_current_sha256 == m.source_current_sha256
+        && f.owner != 0 && f.tick.checked_add(3).is_some() && f.nonce != 0
+        && (3..=32).contains(&f.object_count)
+        && f.props_food_ball[0] != f.props_food_ball[1]
+        && (1000..=2500).contains(&near) && (1000..=2500).contains(&far)
+        && near < far && (1300..=1800).contains(&left)
+        && (-1800..=-1300).contains(&right) && left == -right
+}
+
+pub(super) fn resolve(root: &Path, bytes: &[u8]) -> Result<(Manifest, Identity)> {
+    let m = parse_manifest(bytes)?;
+    let raw = read_leaf(root, "language-composition-admission.v3.json", 8192)?;
+    if digest(&raw) != m.admission_sha256 { return Err("v3 admission hash mismatch".into()); }
+    let a: Admission = serde_json::from_slice(&raw)?;
+    if a.schema != "qualia.saved_life.language_composition_admission.v3"
+        || a.fixture_id != m.fixture_id || a.phase != m.phase || a.run_id != m.run_id
+        || a.cell != m.cell || a.source_current_sha256 != m.source_current_sha256
+        || ![&a.fixture_sha256, &a.rubric_sha256, &a.evaluator_sha256, &a.operator_grant_sha256]
+            .iter().all(|s| is_digest(s))
+    {
+        return Err("wrong v3 admission identity or phase".into());
+    }
+    let fixture = read_leaf(root, "language-composition-fixture.v3.json", 8192)?;
+    let grant = read_leaf(root, "language-composition-operator-grant.v3.json", 65_536)?;
+    if digest(&fixture) != a.fixture_sha256
+        || digest(&read_leaf(root, "language-composition-rubric.v3.json", 65_536)?) != a.rubric_sha256
+        || digest(&grant) != a.operator_grant_sha256
+        || digest(&fs::read(std::env::current_exe()?)?) != a.evaluator_sha256
+    {
+        return Err("v3 fixture/rubric/operator grant/executable bytes differ".into());
+    }
+    let f: Fixture = serde_json::from_slice(&fixture)?;
+    if !exact_fixture(&f, &m) { return Err("v3 fixture outside scoped geometry".into()); }
+
+    let setup_pin = match (m.phase, a.geometry_proof_sha256.as_deref()) {
+        (Phase::Geometry, None) => None,
+        (Phase::Opening | Phase::Ttl, Some(pin)) if is_digest(pin) => {
+            let b = read_leaf(root, GEOMETRY_LEAF, 65_536)?;
+            if digest(&b) != pin { return Err("v3 geometry predecessor hash mismatch".into()); }
+            let v: GeometryProof = serde_json::from_slice(&b)?;
+            if v.schema != "qualia.saved_life.language_composition_geometry.v3"
+                || v.fixture_sha256 != a.fixture_sha256 || v.source_current_sha256 != a.source_current_sha256
+                || v.evaluator_sha256 != a.evaluator_sha256 || v.layout != m.cell.layout
+                || v.owner != f.owner || v.world_tick != f.tick || v.accepted_decisions != 0 || v.world_ticks != 0
+                || v.backend_constructed || v.runtime_or_queue_constructed || v.player_utterances_emitted != 0
+                || digest(&serde_json::to_vec(&v.setup)?) != v.setup_sha256
+            {
+                return Err("v3 predecessor is not exact zero-dispatch geometry".into());
+            }
+            Some(v.setup_sha256)
+        }
+        _ => return Err("v3 phase requires its own independent geometry predecessor".into()),
+    };
+    match (m.phase, a.opening_pair_proof_sha256.as_deref()) {
+        (Phase::Ttl, Some(pin)) if is_digest(pin) => {
+            let proof = read_leaf(root, OPENING_PAIR_LEAF, 16_384)?;
+            if digest(&proof) != pin {
+                return Err("TTL paired opening predecessor bytes differ".into());
+            }
+            check_ttl_predecessor(&m, &a, &f, &serde_json::from_slice(&grant)?, &serde_json::from_slice(&proof)?)?;
+        }
+        (Phase::Geometry | Phase::Opening, None) => {}
+        _ => return Err("only TTL requires its own independently approved 1/1 opening pair".into()),
+    }
+    let identity = Identity {
+        phase: m.phase, cell: m.cell.clone(), fixture_id: m.fixture_id.clone(),
+        evaluator_sha256: a.evaluator_sha256, fixture_sha256: a.fixture_sha256,
+        admission_sha256: m.admission_sha256.clone(), rubric_sha256: a.rubric_sha256,
+        operator_grant_sha256: a.operator_grant_sha256, source_current_sha256: m.source_current_sha256.clone(),
+        geometry_proof_sha256: a.geometry_proof_sha256,
+        opening_pair_proof_sha256: a.opening_pair_proof_sha256,
+        parent_geometry_setup_sha256: setup_pin, fixture: f,
+    };
+    Ok((m, identity))
+}
+
+#[derive(Clone, Copy, Serialize)]
+struct Prop {
+    entity: WorldEntityId,
+    position: Vec3f,
+    velocity: Vec3f,
+    owner: Option<OrganismId>,
+    player_held: bool,
+    activity_hold: bool,
+    consumed: bool,
+    native_grab_legal: bool,
+    pending_intervention: bool,
+}
+
+impl Prop {
+    fn free(&self) -> bool {
+        self.owner.is_none() && !self.player_held && !self.activity_hold
+            && !self.consumed && !self.pending_intervention
+    }
+}
+
+#[derive(Serialize)]
+pub(super) struct Snapshot {
+    owner: OrganismId,
+    tick: u64,
+    body_position: Vec3f,
+    body_yaw: f32,
+    props: [Prop; 2],
+}
+
+pub(super) struct Opened {
+    layout: Layout,
+    props: [WorldEntityId; 2],
+    atom: AudibleUtterance,
+    pub(super) setup: Value,
+}
+
+fn snapshot(world: &HeadlessWorld, owner: OrganismId, props: [WorldEntityId; 2]) -> Result<Snapshot> {
+    let rec = world.organism_registry().get(owner).ok_or("missing same v3 resident")?;
+    let body = world.entity(rec.world_entity_id()).ok_or("missing same v3 body")?;
+    let prop = |id| -> Result<Prop> {
+        let x = world.entity(id).ok_or("missing exact stock v3 prop")?;
+        let (pending_intervention, native_grab_legal) = world.retained_language_pilot_grab_probe(owner, id);
+        Ok(Prop { entity: id, position: x.position, velocity: x.grounded_physical.velocity, owner: x.carried_by,
+            player_held: world.player_held_object()==Some(id), activity_hold:x.activity_hold, consumed:x.consumed,
+            native_grab_legal, pending_intervention })
+    };
+    Ok(Snapshot { owner, tick: world.tick().raw(), body_position: body.position, body_yaw: body.body_yaw,
+        props: [prop(props[0])?, prop(props[1])?] })
+}
+
+impl Identity {
+    pub(super) fn owner(&self) -> u64 { self.fixture.owner }
+    pub(super) fn nonce(&self) -> u64 { self.fixture.nonce }
+
+    fn scene(&self, world: &HeadlessWorld, owner: OrganismId) -> Result<(HeadlessWorld, Value)> {
+        let p = self.fixture.props_food_ball;
+        let old = world.object_snapshots();
+        let start = snapshot(world, owner, p)?;
+        let rec = world.organism_registry().get(owner).ok_or("no same v3 resident")?;
+        if owner.raw() != self.fixture.owner || start.tick != self.fixture.tick
+            || world.seed() != self.fixture.world_seed || old.len() != self.fixture.object_count
+            || !rec.lifecycle().is_alive() || world.terrain().is_some() || world.player_held_object().is_some()
+            || !world.audible_utterances().is_empty()
+            || old.iter().any(|o| o.carried_by == Some(owner) || o.teacher_channel.is_some())
+            || !start.props.iter().all(|o| o.free() && o.velocity == Vec3f::ZERO)
+        {
+            return Err("v3 exact clean living fixture opening refused".into());
+        }
+        let (sn, cs) = start.body_yaw.sin_cos();
+        let at = |f: i32, l: i32| {
+            let f = f as f32 / 1000.0;
+            let l = l as f32 / 1000.0;
+            Vec3f::new(start.body_position.x + f * cs - l * sn, start.body_position.y,
+                start.body_position.z + f * sn + l * cs)
+        };
+        let [a,b] = self.fixture.berths_forward_left_mm.map(|[f,l]| at(f,l));
+        let berths = match self.cell.layout { Layout::A => [a,b], Layout::B => [b,a] };
+        let mut staged = world.clone();
+        for ((id, pos), kind) in p.into_iter().zip(berths).zip([WorldObjectKind::Food, WorldObjectKind::Ball]) {
+            let mut value = world.entity(id).ok_or("missing original v3 prop")?.clone();
+            if value.kind != kind || value.organism_id.is_some() || value.token_id.is_some()
+                || value.hazard_pain != 0.0 || !value.radius.is_finite() || value.radius <= 0.0
+                || value.radius > 0.5
+            {
+                return Err("v3 refuses a synthesized, nonstationary or wrong-kind prop".into());
+            }
+            value.position = pos;
+            staged.editor_move_object(id, pos)?;
+            staged.editor_move_object(id, pos)?;
+            if staged.entity(id) != Some(&value) {
+                return Err("v3 editor changed more than the existing stationary prop center".into());
+            }
+        }
+        let mut ecology = staged.ecology().clone();
+        ecology.metrics = world.ecology().metrics.clone();
+        let sensed = staged.sensory_report(owner, staged.tick())?;
+        let visible: Vec<_> = sensed.visible_entities.iter().map(|x| x.id).collect();
+        if &ecology != world.ecology() || staged.tick()!=world.tick()
+            || staged.organism_registry().get(owner)!=Some(rec)
+            || old.iter().any(|o| !p.contains(&o.id) && staged.entity(o.id)!=Some(o))
+            || visible.len()!=2 || !p.iter().all(|id| visible.contains(id)) || !sensed.contact_entities.is_empty()
+            || sensed.core_snapshot.language_context.heard_tokens.iter().any(Option::is_some)
+        {
+            return Err("v3 geometry does not have the exact quiet same-body/props opening".into());
+        }
+        let geometry = staged.retained_language_composition_geometry(owner, p)?;
+        let scene = snapshot(&staged, owner, p)?;
+        // A stock scene report is neither a sealed frame nor a candidate/menu claim.
+        Ok((staged, json!({"schema_version":3,"geometry_only":true,"body_and_props":scene,
+            "true_visible_world_props":visible,"stock_sweep_and_grip_witnesses":geometry,
+            "no_action_was_submitted":true,"not_sealed_candidate_evidence":true})))
+    }
+
+    pub(super) fn geometry(&self, world: &HeadlessWorld, owner: OrganismId) -> Result<Value> {
+        if self.phase != Phase::Geometry { return Err("wrong v3 zero-step phase".into()); }
+        let (_, setup) = self.scene(world, owner)?;
+        Ok(json!({"schema":"qualia.saved_life.language_composition_geometry.v3",
+            "fixture_sha256":self.fixture_sha256,"source_current_sha256":self.source_current_sha256,
+            "evaluator_sha256":self.evaluator_sha256,"layout":self.cell.layout,"owner":owner.raw(),
+            "world_tick":world.tick().raw(),"accepted_decisions":0,"world_ticks":0,
+            "backend_constructed":false,"runtime_or_queue_constructed":false,"player_utterances_emitted":0,
+            "setup_sha256":digest(&serde_json::to_vec(&setup)?),"setup":setup}))
+    }
+
+    pub(super) fn check_parent_geometry(&self, world: &HeadlessWorld, owner: OrganismId) -> Result<()> {
+        if self.phase == Phase::Geometry { return Err("unexpected v3 native geometry check".into()); }
+        let (_, setup) = self.scene(world, owner)?;
+        let pin = digest(&serde_json::to_vec(&setup)?);
+        if self.parent_geometry_setup_sha256.as_deref() != Some(pin.as_str()) {
+            return Err("v3 opening differs from the bound zero-dispatch witness".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn configure(&self, world: &mut HeadlessWorld, owner: OrganismId) -> Result<Opened> {
+        if self.phase == Phase::Geometry { return Err("geometry phase cannot emit".into()); }
+        let (mut staged, setup) = self.scene(world, owner)?;
+        let setup_sha = digest(&serde_json::to_vec(&setup)?);
+        if self.parent_geometry_setup_sha256.as_deref() != Some(setup_sha.as_str()) {
+            return Err("v3 initial geometry differs from separately admitted zero-step witness".into());
+        }
+        let now = staged.tick();
+        let opening = snapshot(&staged, owner, self.fixture.props_food_ball)?;
+        let pos = opening.body_position;
+        let (sn,cs) = opening.body_yaw.sin_cos();
+        let source = Vec3f::new(pos.x + 0.25 * cs, pos.y, pos.z + 0.25 * sn);
+        let atom = staged.emit_player_tokens(Some(owner), source, self.cell.player_tokens.clone())?;
+        if staged.audible_utterances().as_slice() != std::slice::from_ref(&atom)
+            || atom.source_kind!=UtteranceSourceKind::Player || atom.addressee!=Some(owner)
+            || atom.emitted_tick!=now || now.raw().checked_add(1)!=Some(atom.expires_after_tick.raw())
+            || atom.speaker_id.is_some() || atom.teacher_channel.is_some()
+            || atom.confidence.raw().to_bits()!=1.0_f32.to_bits()
+        {
+            return Err("v3 witness did not emit exactly one ordinary addressed Player atom".into());
+        }
+        let gains = self.cell.player_tokens.iter().map(|t| {
+            staged.retained_language_pilot_word_gain(owner, u32::from(t.raw()))
+        }).collect::<Vec<_>>();
+        let setup = json!({"geometry_setup_sha256":setup_sha,"geometry":setup,
+            "native_player_utterance":atom,"inherited_word_gain":gains,"phase":self.phase,
+            "observer_only":true,"preview_is_not_outcome":true});
+        *world = staged;
+        Ok(Opened { layout: self.cell.layout, props: self.fixture.props_food_ball, atom, setup })
+    }
+}
+
+fn exact_position(a: Vec3f, b: Vec3f) -> bool {
+    a.x.to_bits() == b.x.to_bits() && a.y.to_bits() == b.y.to_bits() && a.z.to_bits() == b.z.to_bits()
+}
+
+#[derive(Clone, Copy, Serialize)]
+struct OfferSupport {
+    channel_mask: bool,
+    representative_can_fill_channel: bool,
+    supported: bool,
+}
+
+fn offer_support(
+    logit: f32, candidate_bit: u32, motor_slot: u8,
+    channel_mask: u32, representative_mask: u32, force_slot: u8,
+) -> Result<OfferSupport> {
+    let channel_mask = channel_mask & candidate_bit != 0;
+    let representative = representative_mask & candidate_bit != 0;
+    // Matches stock build_receipt: finite entries enter the representative
+    // menu; independent channel support can be absent without hiding a rep.
+    if force_slot != motor_slot || representative != logit.is_finite() || (channel_mask && !representative) {
+        return Err("v3 stock candidate support disagrees with receipt slot or logit".into());
+    }
+    Ok(OfferSupport {
+        channel_mask,
+        representative_can_fill_channel: representative,
+        supported: channel_mask || representative,
+    })
+}
+
+impl Opened {
+    pub(super) fn capture(&self, world: &HeadlessWorld, owner: OrganismId) -> Result<Snapshot> {
+        snapshot(world, owner, self.props)
+    }
+
+    pub(super) fn observe(
+        &self,
+        frame: &PerceptionFrame,
+        behavior: &GpuTrainingRolloutReceipt,
+        before: Snapshot,
+        world: &HeadlessWorld,
+        outcome: Tick,
+    ) -> Result<Value> {
+        let id = frame.organism_id();
+        let tick = frame.tick();
+        if self.atom.addressee!=Some(id) || before.owner!=id || before.tick!=tick.raw()
+            || tick.raw().checked_add(1)!=Some(outcome.raw()) || outcome!=world.tick()
+            || frame.sensor_profile()!=SensorProfile::GroundedTerrainVisionV1
+            || !exact_position(frame.body().pose.translation, before.body_position)
+            || behavior.organism_id != id.raw() || behavior.tick != tick.raw()
+            || behavior.frame_digest != frame.frame_digest()
+            || behavior.behavior != GpuTrainingBehaviorKind::OnPolicy || behavior.sampling.demonstrator.is_some()
+            || behavior.logits.len() != frame.candidates().len()
+            || behavior.forced_motor_slots.len() != frame.candidates().len()
+        {
+            return Err("v3 cannot join prior World truth to actual sealed frame and outcome".into());
+        }
+        let heard = &frame.sensory().language_context.heard_tokens;
+        if heard.iter().flatten().any(|x| x.source_kind==UtteranceSourceKind::Teacher) {
+            return Err("v3 Teacher input observed".into());
+        }
+        let players = heard.iter().flatten().filter(|x| x.source_kind==UtteranceSourceKind::Player).collect::<Vec<_>>();
+        let current = tick.raw()<=self.atom.expires_after_tick.raw();
+        if tick.raw()<self.atom.emitted_tick.raw()
+            || (current && (players.len()!=self.atom.tokens.len()
+                || heard.iter().flatten().count()!=players.len()
+                || !players.iter().zip(&self.atom.tokens).enumerate().all(|(i,(h,t))| {
+                    h.utterance_id==self.atom.utterance_id && usize::from(h.sequence_position)==i
+                     && h.addressee==self.atom.addressee && h.source_position==self.atom.source_position
+                     && h.source_entity.is_none() && h.speaker_id.is_none() && h.teacher_channel.is_none()
+                     && h.token_id==u32::from(t.raw()) && h.confidence.raw().is_finite() && h.confidence.raw()>0.0
+                })))
+            || (!current && !players.is_empty())
+        {
+            return Err("unexpected v3 sealed Player source, vector or expiry".into());
+        }
+        let mut rows = Vec::new();
+        let mut approach = [None,None];
+        let mut witnessed_kind = [[false;2];2];
+        for (i,c) in frame.candidates().iter().enumerate() {
+            let Some(which) = self.props.iter().position(|t| c.target.entity==Some(*t)) else { continue };
+            let (kind, motor_slot, expected_kind, expected_family) = if c.action_id==HeadlessActionIds::APPROACH {
+                (0, 0u8, ActionKind::Move, CandidateActionFamily::Approach)
+            } else if c.action_id==HeadlessActionIds::GRAB {
+                (1, 2u8, ActionKind::Interact, CandidateActionFamily::Contact)
+            } else { continue };
+            let prop = &before.props[which];
+            if c.kind != expected_kind || c.family != expected_family || c.target.entity != Some(prop.entity)
+                || !c.target.position.is_some_and(|p| exact_position(p, prop.position))
+            {
+                return Err("v3 candidate action kind/family or exact predecision target transport differs".into());
+            }
+            let CandidateObservationRef::ObjectSlot(slot_index)=c.observation else {
+                return Err("v3 action is not a current object slot".into());
+            };
+            let slot=frame.grounded_object_slots().iter().find(|s| s.slot_index==slot_index)
+                .ok_or("v3 sealed object slot is absent")?;
+            let slot_features=slot.candidate_features()?;
+            if witnessed_kind[which][kind] || usize::from(c.candidate_index)!=i
+                || !c.features.0.iter().zip(&slot_features.0).all(|(x,y)| x.to_bits()==y.to_bits())
+                || c.sensor_confidence.raw().to_bits()!=slot.confidence.raw().to_bits()
+            {
+                return Err("v3 duplicate or mismatched sealed candidate physical descriptor".into());
+            }
+            witnessed_kind[which][kind]=true;
+            let bit=1_u32.checked_shl(u32::try_from(i)?).ok_or("v3 candidate roster too large")?;
+            let support = offer_support(
+                behavior.logits[i], bit, motor_slot, behavior.motor_masks[usize::from(motor_slot)],
+                behavior.representative_mask, behavior.forced_motor_slots[i],
+            )?;
+            if kind==0 {
+                if tick == self.atom.emitted_tick {
+                    let pos = before.props[which].position;
+                    let own = before.body_position;
+                    let physical_range = (pos.x-own.x).hypot(pos.y-own.y).hypot(pos.z-own.z);
+                    let range = physical_range / alife_world::GROUNDED_VISION_RADIUS;
+                    if (slot.distance-range).abs() > 0.0001 || slot.confidence.raw() <= 0.0 {
+                        return Err("v3 slot range/confidence contradicts actual free predecision prop".into());
+                    }
+                }
+                approach[which]=Some((slot_index,slot.tracked_object_id,i,slot.distance,support.supported));
+            }
+            rows.push(json!({"candidate":c,"slot":slot,"native_world_target":prop.entity,
+                "candidate_index":i,"world_transport_bits_match":true,"stock_policy_support":support,
+                "native_predecision_grab_legal":prop.native_grab_legal}));
+        }
+        if tick==self.atom.emitted_tick {
+            let Some((a,b))=approach[0].zip(approach[1]) else {
+                return Err("v3 opening lacks two independently bound actual Approach101 candidates".into());
+            };
+            let slot_order = match self.layout {
+                Layout::A => a.0<b.0 && a.3<b.3,
+                Layout::B => b.0<a.0 && b.3<a.3,
+            };
+            if !a.4 || !b.4 {
+                return Err("v3 opening has bound Approach101 descriptors but not two stock-policy-supported offers".into());
+            }
+            if !slot_order || a.1==b.1 || a.2==b.2
+                || !before.props.iter().all(|p| p.free() && !p.native_grab_legal && p.velocity==Vec3f::ZERO)
+            {
+                return Err("v3 opening slot/track/legality proof failed".into());
+            }
+        }
