+            .hypot(before.body_position.y-self.atom.source_position.y)
+            .hypot(before.body_position.z-self.atom.source_position.z);
+        let after = self.capture(world, id)?;
+        Ok(json!({"schema_version":3,"observer_only":true,"sealed_frame_digest":frame.frame_digest(),
+            "decision_tick":tick.raw(),"outcome_tick":outcome.raw(),"organism":id.raw(),
+            "native_behavior_frame_digest":behavior.frame_digest,
+            "same_target_current_bindings":rows,"sealed_heard_tokens":heard,"current_player_atom":current,
+            "listener_source_distance_m":sound_distance,"before":before,"after":after,
+            "local_scope_not_composition_score":true}))
+    }
