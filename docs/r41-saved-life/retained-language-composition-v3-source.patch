+    /// Geometry-only witness on a disposable scene. Does not perform a move,
+    /// change the caller, reserve a candidate, or predict how a creature acts.
+    /// The hypothetical endpoints test the same stock perception/reach rules,
+    /// not force a path or provide an input to cognition.
+    #[cfg(feature = "retained-language-composition-v3")]
+    pub fn retained_language_composition_geometry(
+        &self,
+        owner: OrganismId,
+        props: [WorldEntityId; 2],
+    ) -> Result<[(Vec3f, Vec3f); 2], ScaffoldContractError> {
+        let bad = || ScaffoldContractError::InvalidDecisionEvidence;
+        let body = self.agent_for(owner)?;
+        let start = body.position;
+        let open_y = start.y;
+        if props[0] == props[1]
+            || self.terrain.is_some()
+            || start.y != 0.0
+            || self.player_held_object().is_some()
+            || self.objects.values().any(|o| o.carried_by == Some(owner))
+        {
+            return Err(bad());
+        }
+        let targets = [
+            self.entity(props[0]).ok_or_else(bad)?,
+            self.entity(props[1]).ok_or_else(bad)?,
+        ];
+        if distance(targets[0].position, targets[1].position) <= 2.0 * EAT_RADIUS {
+            return Err(bad());
+        }
+        let mut result = [(Vec3f::ZERO, Vec3f::ZERO); 2];
+        for (i, target) in targets.into_iter().enumerate() {
+            let d = distance(start, target.position);
+            if !d.is_finite()
+                || d <= EAT_RADIUS + MOVE_STEP
+                || d > 4.0
+                || target.position.y != open_y
+                || target.consumed
+                || target.activity_hold
+                || target.carried_by.is_some()
+                || target.grounded_physical.velocity != Vec3f::ZERO
+                || !self.object_in_sight(body, target)
+                || self.visible_motion_target(owner, target.id)?.is_none()
+                || self.retained_language_pilot_grab_probe(owner, target.id) != (false, false)
+            {
+                return Err(bad());
+            }
+            let inside = EAT_RADIUS - 0.1;
+            let end = add(start, scale(subtract(target.position, start), 1.0 - inside / d));
+            end.validate()?;
+            if self.first_motion_blocker(start, end).is_some()
+                || !self.solid_segment_clear(start, end)
+                || self.objects.values().any(|o| {
+                    !o.consumed && o.id != body.id
+                        && matches!(o.kind, WorldObjectKind::Hazard | WorldObjectKind::Agent)
+                        && motion_sphere_entry(start, end, o.position, o.radius
+                            + self.locomotion_body_radius()).is_some()
+                })
+            {
+                return Err(bad());
+            }
+            let mut hypothetical = self.clone();
+            // Set only the queried body point in discarded scratch. None of
+            // tick/apply/queued motor paths is called; never commit this clone.
+            hypothetical.objects.get_mut(&body.id.raw()).ok_or_else(bad)?.position = end;
+            if hypothetical.visible_motion_target(owner, target.id)?.is_none()
+                || hypothetical.retained_language_pilot_grab_probe(owner, target.id) != (false, true)
+                || hypothetical.retained_language_pilot_grab_probe(owner, props[1 - i]) != (false, false)
+                || hypothetical.body_contacts_at(body.id, end) != (None, false)
+            {
+                return Err(bad());
+            }
+            result[i] = (target.position, end);
+        }
+        Ok(result)
+    }
