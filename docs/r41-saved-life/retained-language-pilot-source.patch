+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn language_pilot_reads_a_real_player_atom_and_declines_foreign_or_expired() {
+        let owner = OrganismId(3);
+        let other = OrganismId(4);
+        let speaker = Vec3f::new(0.25, 0.0, 0.0);
+        let mut world = alife_world::HeadlessScenarioBuilder::new(77)
+            .agent("pilot-listener", owner, Vec3f::ZERO)
+            .social_agent("pilot-other", other, Vec3f::new(2.0, 0.0, 0.0), 0.0)
+            .build().unwrap();
+        let t = world.tick();
+        let words = [9, 1].map(|x| LanguageTokenId::new(x).unwrap());
+        let atom = world.emit_player_tokens(Some(owner), speaker, words.to_vec()).unwrap();
+        let heard = |w: &HeadlessWorld, who| {
+            w.sensory_report(who, w.tick()).unwrap().core_snapshot.language_context.heard_tokens
+        };
+        assert_eq!(atom.confidence.raw().to_bits(), 1.0_f32.to_bits());
+        assert!(hear(&heard(&world, owner), &atom, t).is_ok());
+        assert!(hear(&heard(&world, other), &atom, t).is_err());
+        assert_eq!(world.advance_tick().raw(), t.raw() + 1);
+        assert!(hear(&heard(&world, owner), &atom, world.tick()).is_ok());
+        assert_eq!(world.advance_tick().raw(), t.raw() + 2);
+        let h0 = heard(&world, owner);
+        assert!(h0.iter().flatten().all(|h| h.source_kind != UtteranceSourceKind::Player));
+        assert!(hear(&h0, &atom, world.tick()).is_ok());
+    }
+
+    #[test]
+    fn language_pilot_rejects_unbounded_or_answer_bearing_manifest() {
+        let mut m = json!({"schema":SCHEMA,"fixture_id":ID,"run_id":"opaque-0",
+            "source_current_sha256":SOURCE,"admission_sha256":"a".repeat(64),
+            "cell":{"layout":"a","tokens":[9,1]},"deadline_unix_seconds":1});
+        let parse = |v: &Value| parse_manifest(&serde_json::to_vec(v).unwrap()).is_ok();
+        assert!(parse(&m));
+        m["cell"]["tokens"] = json!([9,1,14]); assert!(!parse(&m));
+        m["cell"]["tokens"] = json!([9,2]); assert!(!parse(&m));
+        m["cell"]["tokens"] = json!([9,14]); assert!(parse(&m));
+        m["cell"]["expected_entity"] = json!(2); assert!(!parse(&m));
+        m["cell"].as_object_mut().unwrap().remove("expected_entity");
+        m["source_current_sha256"] = json!("b".repeat(64)); assert!(!parse(&m));
+    }
