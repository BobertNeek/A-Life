+/// Device-free reproduction through the exact production remapper. Never
+/// opens a mature save or creates a GPU device.
+#[doc(hidden)]
+#[cfg(feature = "gpu-tests")]
+pub fn replay_span_remap_probe_for_test() -> Result<(u32, u32), GpuClosedLoopError> {
+    use alife_core::{BrainGenome, DevelopmentState, NormalizedScalar, PhenotypeCompiler, SensorProfile, Tick};
+    let capacity = BrainCapacityClass::n512();
+    let genome = BrainGenome::scaffold(705, capacity.id());
+    let development = DevelopmentState::new(
+        genome.id,
+        Tick::ZERO,
+        NormalizedScalar::new(0.35).map_err(|_| GpuClosedLoopError::MalformedUpload)?,
+    );
+    let phenotype = PhenotypeCompiler::compile(
+        &genome,
+        &capacity,
+        &development,
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .map_err(|_| GpuClosedLoopError::MalformedUpload)?;
+    let plan = GpuFixedClassArenaPlan::new(capacity, 1, 512 * 1024 * 1024)?;
+    let previous = plan.prepare_slot_upload(0, 1, &phenotype)?;
+    let base = previous.ranges.mutable_state_words.start;
+    let ranges = &previous.ranges.layout;
+    let canonical = read_pod_prefix::<GpuReplaySynapseSpanRecord>(
+        &previous.mutable_state_words,
+        base,
+        &ranges.replay_span_words,
+        previous.brain_slot.counts.replay_capture_synapses,
+    )?;
+    // Restored replay may legitimately keep a different enabled synapse in a
+    // physical slot. Preserve original offsets and a consistent event count.
+    for i in 0..canonical.len().saturating_sub(1) {
+        for id in canonical[i].local_synapse_id + 1..canonical[i + 1].local_synapse_id {
+            let mut spans = canonical.clone();
+            spans[i].local_synapse_id = id;
+            for span in &mut spans {
+                span.sample_count = 3;
+            }
+            let mut live = previous.mutable_state_words.clone();
+            let mut state: GpuSlotLearningStateRecord =
+                read_pod_at(&live, base, ranges.learning_state_words.start)?;
+            state.replay_event_count = 3;
+            state.replay_cursor = 3;
+            store_pod_at(&mut live, base, ranges.learning_state_words.start, &state)?;
+            store_pod_slice_at(&mut live, base, ranges.replay_span_words.start, &spans)?;
+            if validate_learning_slot_layout(
+                previous.record(),
+                previous.brain_slot().typed_counts(),
+                ranges,
+                &previous.immutable_plan_words,
+                previous.ranges.immutable_plan_words.start,
+                &previous.immutable_weight_words,
+                previous.ranges.immutable_weight_words.start,
+                &live,
+                base,
+            )
+            .is_err()
+            {
+                continue;
+            }
+            let next = plan
+                .prepare_slot_upload(0, 1, &phenotype)?
+                .with_remapped_live_mutable_state(&previous, live)?;
+            let actual = read_pod_prefix::<GpuReplaySynapseSpanRecord>(
+                &next.mutable_state_words,
+                base,
+                &ranges.replay_span_words,
+                spans.len(),
+            )?;
+            return Ok((state.replay_event_count, actual[i].sample_count));
+        }
+    }
+    Err(GpuClosedLoopError::MalformedUpload)
+}
