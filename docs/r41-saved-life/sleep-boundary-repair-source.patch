+#[cfg(all(test, feature = "gpu-tests"))]
+mod first_sleep_generation_regression {
+    use alife_core::sleep::{
+        ConsolidationDriverEvent, ConsolidationIntent, SleepConsolidationConfig,
+        SleepController, SleepPhase, SleepState, SleepTrigger,
+    };
+    use alife_core::{OrganismId, ScaffoldContractError, Tick};
+    use alife_runtime::{GpuSleepTransactionJournalEntryV2, GpuSleepTransactionJournalV2};
+
+    #[test]
+    fn first_sleep_generation_regression_repairs_ring_through_lifetime_growth() {
+        let (retired_default_count, preserved_live_count) =
+            alife_gpu_backend::replay_span_remap_probe_for_test().unwrap();
+        assert_eq!(retired_default_count, 0);
+        assert_eq!(preserved_live_count, 3);
+    }
+
+    #[test]
+    fn first_sleep_generation_regression_validates_pending_transition_generation() {
+        // A public synthetic clock, no private archive and no GPU work.
+        let organism = OrganismId(7);
+        let awake = SleepState::awake_at(Tick::new(50));
+        let mut phase = SleepController::restore(SleepConsolidationConfig::reference(), awake)
+            .unwrap();
+        phase.force_sleep(Tick::new(50), SleepTrigger::SeizureHyperactivity).unwrap();
+        let recovery = phase.state();
+        assert_eq!(recovery.phase, SleepPhase::ForcedRecoverySleep);
+        assert!(phase.advance(Tick::new(57)).unwrap().is_none());
+        assert!(phase.advance(Tick::new(58)).unwrap().is_some());
+        let consolidating = phase.state();
+        assert_eq!(consolidating.phase, SleepPhase::Consolidating);
+        let persisted = |cycle_id| ConsolidationDriverEvent::ReplayAssetPersisted {
+            intent: ConsolidationIntent { cycle_id },
+            replay_digest: [1, 2, 3, 4],
+            replay_event_count: 3,
+            replay_eligibility_sample_count: 12,
+        };
+        assert_eq!(
+            phase.apply_consolidation_driver_event(persisted(recovery.active_cycle_id + 1)),
+            Err(ScaffoldContractError::ConsolidationGenerationMismatch)
+        );
+        assert_eq!(phase.state(), consolidating);
+        phase.apply_consolidation_driver_event(persisted(recovery.active_cycle_id)).unwrap();
+        let pending = phase.state();
+        let edge = |ordinal, source, target| {
+            GpuSleepTransactionJournalEntryV2::try_new_with_ordinal(
+                organism, Tick::new(59), ordinal, source, target,
+            )
+            .unwrap()
+        };
+        let mut entries = vec![GpuSleepTransactionJournalEntryV2::try_new(
+            organism, Tick::new(51), awake, recovery,
+        ).unwrap()];
+        entries.push(edge(0, recovery, consolidating));
+        entries.push(edge(1, consolidating, pending));
+        let anchor = "fnv1a64:0123456789abcdef".to_string();
+        GpuSleepTransactionJournalV2::try_new(anchor.clone(), Tick::new(50), entries.clone())
+            .unwrap();
+        entries.swap(1, 2);
+        assert_eq!(
+            GpuSleepTransactionJournalV2::try_new(anchor, Tick::new(50), entries),
+            Err(ScaffoldContractError::ConsolidationGenerationMismatch)
+        );
+    }
