+/// Device-free reproduction through the exact production remapper. Never
+/// opens a mature save or creates a GPU device.
+#[doc(hidden)]
+#[cfg(feature = "gpu-tests")]
+pub fn replay_span_remap_probe_for_test() -> Result<(u32, u32), GpuClosedLoopError> {
+    use alife_core::{BrainGenome, DevelopmentState, NormalizedScalar, PhenotypeCompiler, SensorProfile, Tick};
+    let capacity = BrainCapacityClass::n512();
+    let genome = BrainGenome::scaffold(705, capacity.id());
+    let development = DevelopmentState::new(
+        genome.id,
+        Tick::ZERO,
+        NormalizedScalar::new(0.35).map_err(|_| GpuClosedLoopError::MalformedUpload)?,
+    );
+    let phenotype = PhenotypeCompiler::compile(
+        &genome,
+        &capacity,
+        &development,
+        SensorProfile::GroundedObjectSlotsV1,
+    )
+    .map_err(|_| GpuClosedLoopError::MalformedUpload)?;
+    let plan = GpuFixedClassArenaPlan::new(capacity, 1, 512 * 1024 * 1024)?;
+    let previous = plan.prepare_slot_upload(0, 1, &phenotype)?;
+    let inherited = phenotype.synapses().iter()
+        .filter(|s| s.kind() == alife_core::CompiledSynapseKind::Recurrent)
+        .nth(previous.record().recurrent_synapse_count as usize / 2)
+        .ok_or(GpuClosedLoopError::MalformedUpload)?;
+    let addition = AddLifetimeSynapse {
+        source: inherited.source(),
+        target: inherited.target(),
+        route: u32::from(inherited.route_index()),
+        initial_weight: 0.125,
+        evidence: alife_core::CoactivationEvidence {
+            region: inherited.route_index(),
+            source: inherited.source(),
+            target: inherited.target(),
+            coactivation: 1,
+            eligibility: 1,
+            concept_gap_support: 0,
+        },
+    };
+    let base = previous.ranges.mutable_state_words.start;
+    let ranges = &previous.ranges.layout;
+    let canonical = read_pod_prefix::<GpuReplaySynapseSpanRecord>(
+        &previous.mutable_state_words,
+        base,
+        &ranges.replay_span_words,
+        previous.brain_slot.counts.replay_capture_synapses,
+    )?;
+    // Restored replay may legitimately keep a different enabled synapse in a
+    // physical slot. Preserve original offsets and a consistent event count.
+    for i in 0..canonical.len().saturating_sub(1) {
+        for id in canonical[i].local_synapse_id + 1..canonical[i + 1].local_synapse_id {
+            let mut spans = canonical.clone();
+            spans[i].local_synapse_id = id;
+            for span in &mut spans {
+                span.sample_count = 3;
+            }
+            let mut live = previous.mutable_state_words.clone();
+            let mut state: GpuSlotLearningStateRecord =
+                read_pod_at(&live, base, ranges.learning_state_words.start)?;
+            state.replay_event_count = 3;
+            state.replay_cursor = 3;
+            store_pod_at(&mut live, base, ranges.learning_state_words.start, &state)?;
+            store_pod_slice_at(&mut live, base, ranges.replay_span_words.start, &spans)?;
+            if validate_learning_slot_layout(
+                previous.record(),
+                previous.counts(),
+                ranges,
+                &previous.immutable_plan_words,
+                previous.ranges.immutable_plan_words.start,
+                &previous.immutable_weight_words,
+                previous.ranges.immutable_weight_words.start,
+                &live,
+                base,
+            )
+            .is_err()
+            {
+                continue;
+            }
+            let next = plan
+                .prepare_slot_upload(0, 1, &phenotype)?
+                .with_remapped_live_mutable_state(&previous, live)?;
+            let actual = read_pod_prefix::<GpuReplaySynapseSpanRecord>(
+                &next.mutable_state_words,
+                base,
+                &ranges.replay_span_words,
+                spans.len(),
+            )?;
+            // Isolate the precise retired default-to-zero rule using the
+            // same valid input; the replaced canonical ID is absent.
+            let old_count = spans.iter()
+                .find(|span| span.local_synapse_id == canonical[i].local_synapse_id)
+                .map(|span| span.sample_count)
+                .unwrap_or(0);
+            if old_count != 0 || actual[i].sample_count != state.replay_event_count
+                || actual[i].local_synapse_id != id {
+                return Err(GpuClosedLoopError::MalformedUpload);
+            }
+            let sample_begin = (ranges.replay_sample_words.start - base) as usize;
+            let sample_end = (ranges.replay_sample_words.end - base) as usize;
+            let mut live = next.mutable_state_words.clone();
+            // Distinguish physical sample slots to detect any data movement.
+            for (j, word) in live[sample_begin..sample_end].iter_mut().enumerate() {
+                *word = 0x1234_0000_u32.wrapping_add(j as u32);
+            }
+            let mut grown = plan.prepare_slot_upload(0, 1, &phenotype)?
+                .with_added_lifetime_synapse(&addition)?
+                .with_remapped_live_mutable_state(&previous, live.clone())?;
+            let grown_spans = read_pod_prefix::<GpuReplaySynapseSpanRecord>(
+                &grown.mutable_state_words, base, &ranges.replay_span_words, spans.len(),
+            )?;
+            let old_edges = recurrent_edge_identities(&previous)?;
+            let new_edges = recurrent_edge_identities(&grown)?;
+            let old_recurrent = previous.record().recurrent_synapse_count;
+            let new_recurrent = grown.record().recurrent_synapse_count;
+            let same_pair = spans.iter().zip(&grown_spans).all(|(a, b)| {
+                let edge_matches = if a.local_synapse_id < old_recurrent {
+                    old_edges.get(a.local_synapse_id as usize)
+                        == new_edges.get(b.local_synapse_id as usize)
+                } else {
+                    a.local_synapse_id.checked_sub(old_recurrent)
+                        == b.local_synapse_id.checked_sub(new_recurrent)
+                };
+                edge_matches && a.sample_start == b.sample_start
+                    && a.sample_count == b.sample_count && a.reserved == b.reserved
+            });
+            if !same_pair || !spans.iter().zip(&grown_spans)
+                .any(|(a, b)| a.local_synapse_id != b.local_synapse_id)
+                || grown.mutable_state_words[sample_begin..sample_end]
+                    != live[sample_begin..sample_end] {
+                return Err(GpuClosedLoopError::MalformedUpload);
+            }
+            let grown_state: GpuSlotLearningStateRecord =
+                read_pod_at(&grown.mutable_state_words, base, ranges.learning_state_words.start)?;
+            if grown_state.replay_event_count != state.replay_event_count
+                || grown_state.replay_cursor != state.replay_cursor
+                || grown_state.replay_generation_lo != state.replay_generation_lo
+                || grown_state.replay_generation_hi != state.replay_generation_hi {
+                return Err(GpuClosedLoopError::MalformedUpload);
+            }
+            // A genuinely stale slot generation must still reject, even
+            // with byte-valid frozen ring contents.
+            let stale_rejected = matches!(
+                plan.prepare_slot_upload(0, 2, &phenotype)?
+                    .with_remapped_live_mutable_state(&previous, live.clone()),
+                Err(GpuClosedLoopError::StaleOrForeignHandle)
+            );
+            if !stale_rejected {
+                return Err(GpuClosedLoopError::MalformedUpload);
+            }
+            // A valid live capture of a learned edge cannot be rebound to
+            // a different ancestral synapse if that edge is gone.
+            let mut inherited_ids = BTreeMap::<_, usize>::new();
+            for edge in old_edges {
+                *inherited_ids.entry(edge).or_default() += 1;
+            }
+            let learned_id = new_edges.iter().position(|edge| {
+                let count = inherited_ids.entry(*edge).or_default();
+                if *count == 0 {
+                    true
+                } else {
+                    *count -= 1;
+                    false
+                }
+            }).ok_or(GpuClosedLoopError::MalformedUpload)?;
+            let learned_u32 = u32::try_from(learned_id)
+                .map_err(|_| GpuClosedLoopError::ArithmeticOverflow)?;
+            let capture_i = grown_spans.partition_point(|span| span.local_synapse_id < learned_u32)
+                .min(grown_spans.len() - 1);
+            let mut captured = grown_spans.clone();
+            let inherited_capture_index = captured[capture_i].local_synapse_id as usize;
+            captured[capture_i].local_synapse_id = learned_u32;
+            // The synthetic fixture needs an enabled receptor for this
+            // learned edge to qualify as a valid captured span.
+            let plan_base = grown.ranges.immutable_plan_words.start;
+            let mut metadata = read_pod_prefix::<GpuSynapseLearningMetadata>(
+                &grown.immutable_plan_words, plan_base, &ranges.synapse_learning_metadata_words,
+                grown.record().synapse_count as usize,
+            )?;
+            metadata[learned_id].receptor_index = metadata[inherited_capture_index].receptor_index;
+            store_pod_slice_at(
+                &mut grown.immutable_plan_words, plan_base,
+                ranges.synapse_learning_metadata_words.start, &metadata,
+            )?;
+            let mut learned_live = grown.mutable_state_words.clone();
+            store_pod_slice_at(&mut learned_live, base, ranges.replay_span_words.start, &captured)?;
+            validate_learning_slot_layout(
+                grown.record(), grown.counts(), ranges, &grown.immutable_plan_words, plan_base,
+                &grown.immutable_weight_words, grown.ranges.immutable_weight_words.start,
+                &learned_live, base,
+            )?;
+            if !matches!(
+                plan.prepare_slot_upload(0, 1, &phenotype)?
+                    .with_remapped_live_mutable_state(&grown, learned_live),
+                Err(GpuClosedLoopError::MalformedUpload)
+            ) {
+                return Err(GpuClosedLoopError::MalformedUpload);
+            }
+            return Ok((old_count, grown_spans[i].sample_count));
+        }
+    }
+    Err(GpuClosedLoopError::MalformedUpload)
+}
