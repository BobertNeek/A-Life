+#[test]
+fn one_synthetic_native_plan_materialization_does_not_qualify_a_reciprocal_life() {
+    use super::GpuV11CausalState;
+    use alife_core::{
+        BrainGenome, CoactivationEvidence, DevelopmentState, NormalizedScalar, PhenotypeCompiler,
+        SensorProfile, Tick,
+    };
+    let capacity = BrainCapacityClass::n2048();
+    let genome = BrainGenome::scaffold(0xF0A0_CA11, capacity.id());
+    let development = DevelopmentState::new(genome.id, Tick::ZERO, NormalizedScalar::new(0.35).unwrap());
+    let phenotype = PhenotypeCompiler::compile(&genome, &capacity, &development,
+                                               SensorProfile::GroundedObjectSlotsV1).unwrap();
+    let source = phenotype.lobe_layout().region(LobeKind::TemporalPredictive).unwrap().start;
+    let memory = phenotype.lobe_layout().region(LobeKind::MemoryInterface).unwrap();
+    let target = (memory.start..memory.start + memory.len).find(|&target|
+        !phenotype.synapses().iter().any(|r| r.kind() == CompiledSynapseKind::Recurrent
+            && (r.source(), r.target()) == (source, target))).unwrap();
+    // Isolated CPU scaffold only; its queue starts empty, unlike real R44.
+    // Legacy region=route expresses this ONE synthetic phase. It cannot prove that
+    // mature resident route admission, a live slot, or the reverse phase exists.
+    let mut state = GpuV11CausalState::for_phenotype(&phenotype).unwrap();
+    let before = GpuLiveTopologyCheckpointV1::recompile_for_phenotype(&phenotype, state.checkpoint()).unwrap();
+    let work = state.apply_structural_phase(&[CoactivationEvidence { region: 9, source, target,
+        coactivation: 100, eligibility: 0, concept_gap_support: 0 }]).unwrap();
+    assert_eq!(work.structural.accepted_edges, 1);
+    let pending = state.pending_lifetime_synapse().unwrap();
+    let edge = Direction { source, target, route: 9, installed_bits: pending.initial_weight.to_bits() };
+    // Validate ordinary pending restore first. A synthetic clear is only preparation
+    // for rebuilding the CPU plan, not evidence of actual native commit/reopen.
+    GpuV11CausalState::restore(state.checkpoint()).unwrap();
+    state.clear_pending_lifetime_synapse(&pending).unwrap();
+    let after = GpuLiveTopologyCheckpointV1::recompile_for_phenotype(&phenotype, state.checkpoint()).unwrap();
+    let readback: GpuLiveTopologyCheckpointV1 =
+        serde_json::from_slice(&serde_json::to_vec(&after).unwrap()).unwrap();
+    prove_exact_one_materialized_direction(&phenotype, &before, &after, &readback, edge).unwrap();
+    let mut counterfeit = readback;
+    counterfeit.memory_weight_indices.push(0);
+    counterfeit.canonical_digest = counterfeit.recompute_canonical_digest().unwrap();
+    assert!(prove_exact_one_materialized_direction(&phenotype, &before, &after, &counterfeit, edge).is_err());
+    assert!(prove_exact_one_materialized_direction(&phenotype, &before, &after, &after,
+        Direction { route: 0, ..edge }).is_err());
+}
