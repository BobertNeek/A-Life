+        env:Option<EnvIds>, argv:Option<String>, anchors:Option<String>,
+        fnormalized:String, started:String, released:String,
+        raw_timing:Option<Endpoint>,first_fork_rows:Option<Vec<ForkFrame>>,
+    }
+    impl From<Observed> for ObservedTiming{
+        fn from(v:Observed)->Self{
+            Self{child:v.process.child,exact_hardware:v.exact_hardware,exact_sampler_after:v.exact_sampler_after,
+                 reference_evidence:v.reference_evidence,env:None,argv:None,anchors:None,
+                 fnormalized:v.normalized_rows_sha256,started:v.process.started_at_utc,
+                 released:v.release.actual_shared_fence_released_utc,raw_timing:None,first_fork_rows:None}
+        }
+    }
+    pub(super) fn cross_distinct(xs:[&ObservedTiming;4])->bool{
+        let ids=xs.iter().filter_map(|x|x.env.as_ref()).collect::<Vec<_>>();
+        if ids.is_empty(){return true;} // Exact unchanged legacy pair parser.
+        let all=ids.iter().flat_map(|q|environment_keys(q)).collect::<BTreeSet<_>>();
+        let argv=xs.iter().filter_map(|q|q.argv.as_ref()).collect::<BTreeSet<_>>();
+        let anchors=xs.iter().filter_map(|q|q.anchors.as_ref()).collect::<BTreeSet<_>>();
+        // Every actual interval is checked against every other, not only the
+        // two same-case orderings. Equal release/start is not a proven handoff.
+        let proper=xs.iter().all(|p|p.started<p.released);
+        let serial=xs.iter().enumerate().all(|(i,p)|
+           xs[..i].iter().all(|q|q.released<p.started||p.released<q.started));
+        ids.len()==4&&all.len()==20&&argv.len()==4&&anchors.len()==1&&proper&&serial
+    }
+
+    pub(super) fn fork_rows(root:&Path,a:&Acceptance,off:&mut ObservedTiming)->Result<Vec<ForkFrame>>{
+        match off.first_fork_rows.take() {
+            Some(r) if r.len()==7=>Ok(r),
+            None if off.env.is_none()=>real_fork_rows(root,a,a.window_start_tick),
+            _=>Err("v5 actual raw rows custody not complete; no reopen fallback".into()),
+        }
+    }
+
+    pub(super) fn timed_original(root:&Path,a:&Acceptance,h:&Arm,w:&mut ObservedTiming)->Result<Endpoint>{
+        match w.raw_timing.take(){
+            Some(x)=>Ok(x),
+            None if w.env.is_none()=>timing_final(root,h,a.owner,a.window_start_tick+256),
+            _=>Err("v5 actual raw timing custody not complete; no reopen fallback".into()),
+        }
+    }
+
+    fn arm(root:&Path,a:&Acceptance,h:&Arm,v:&V5Pair,src:&SourceProof,which:usize,
+           start:&HostStart,profile:&VerifiedStockV11Profile)->Result<ObservedTiming>{
+        if !id(&h.relative_room)||!id(&h.run_id){return Err("unknown literal v5 ancestor room/run".into());}
+        let room=checked_path(root,&h.relative_room)?;
+        let root_uid=dir_id(root)?.2;
+        if dir_id(&room)?.2!=root_uid {return Err("wrong v5 original owner".into());}
+        let s:Event=hashed(&room.join("started.json"),&h.started_sha256,SMALL)?;
+        let p:Event=hashed(&room.join("process.json"),&h.process_sha256,SMALL)?;
+        let f:Fence=hashed(&room.join("fence-release.json"),&h.release_sha256,SMALL)?;
+        let expected_ref=h.role==Role::Reference;
+        let argv=&v.actual_exec_argv_sha256[which];
+        if !same_event(&s,&p)||!started_only(&s)||!terminal(&p,&f)
+          || p.schema!=p.role.schema()||p.role!=f.role||p.role.is_ref()!=expected_ref
+          || p.role.is_foil()!=(a.case_id==profile.foil_case)
+          || p.boot!=start.boot||f.boot!=start.boot||p.fence!=[start.fence_device,start.fence_inode]||p.fence!=f.fence
+          || p.run_id!=h.run_id||f.run_id!=h.run_id||p.case!=a.case_id
+          || p.root_ticket_sha256!=h.authority_sha256||f.root_ticket_sha256!=h.authority_sha256
+          || f.process_sha256!=h.process_sha256||p.manifest_sha256!=h.manifest_sha256
+          || p.keeper_evaluator_sha256!=a.evaluator_sha256||p.parent_source_current_sha256!=a.current_sha256
+          || p.actual_proc_argv_sha256.as_str()!=argv.as_str()||p.actual_proc_environment_sha256!=start.raw_proc_environ_sha256
+          || Path::new(&p.actual_proc_cwd)!=root||p.driver_sha256.as_deref()!=Some(v.actual_driver_sha256.as_str())
+          || p.child.pid<2||p.child.ppid!=p.parent.pid||p.child.pid!=p.child.pgrp||p.child.pid!=p.child.session
+          || p.child.start_ticks<p.parent.start_ticks||p.parent.start_ticks==0||!p.child.namespace.starts_with("pid:[")
+          || p.child.namespace!=p.parent.namespace||p.child.same(&start.child)
+          || p.same_elf_zero_independent_sha256!=src.independently_sealed_source_zero_sha256
+          || p.same_elf_zero_exact_owner_readback_sha256!=src.exact_source_owner_readback_sha256
+          || p.runtime_fork_prescribed!=(if p.role.is_foil(){Some(false)}else{None})
+          || [p.root_actual_independent_sha256.as_deref(),p.root_actual_owner_readback_sha256.as_deref()]
+               .iter().any(|q|if p.role.is_foil(){!q.is_some_and(pin)}else{q.is_some()})
+          || p.real_post_source_quiet.samples!=129||p.real_post_source_quiet.elapsed_seconds<16.
+          || !p.real_post_source_quiet.elapsed_seconds.is_finite()
+          || p.real_post_source_quiet.minimum_disk_bytes<10_424_142_016
+          || p.real_post_source_quiet.minimum_ram_kib<6_300_000
+          || p.fresh_empty_env_identities!=env_ids(&room)?
+          || !fixed_utc(&p.started_utc)||!fixed_utc(&f.actual_shared_fence_released_utc)
+          || !fixed_utc(&start.actual_start_utc)
+          || p.reaped_utc.as_ref().is_none_or(|s|!fixed_utc(s)||s<=&p.started_utc||s>&f.actual_shared_fence_released_utc)
+          || f.actual_shared_fence_released_utc>=start.actual_start_utc{
+            return Err("same-ELF v5 actual original start/reap/fence/role/owner/env refused".into());
+        }
+        let hashes=p.output_raw_sha256.as_ref().ok_or("no v5 actual raw original hashes")?;
+        if hashes.len()!=3
+           || hashes.get("rows.jsonl")!=Some(&h.rows_sha256)
+           || hashes.get("retention.json")!=Some(&h.native_receipt_sha256)
+           || hashes.get("final.alife-checkpoint")!=Some(&h.final_checkpoint_sha256)
+           || !p.stdout_sha256.as_deref().is_some_and(pin)||!p.stderr_sha256.as_deref().is_some_and(pin){
+            return Err("v5 actual raw native asset hash missing".into());
+        }
+        let ticket:serde_json::Value=hashed(&room.join("root-authority.json"),&h.authority_sha256,SMALL)?;
+        let t=ticket.as_object().ok_or("v5 authority not an object")?;
+        let field=|n:&str|t.get(n).and_then(serde_json::Value::as_str);
+        if field("run_id")!=Some(h.run_id.as_str())||field("case")!=Some(a.case_id.as_str())
+          || field("evaluator_sha256")!=Some(a.evaluator_sha256.as_str())||field("current_sha256")!=Some(a.current_sha256.as_str())
+          || field("manifest_sha256")!=Some(h.manifest_sha256.as_str())||field("boot_id")!=Some(p.boot.as_str())
+          || field("raw_proc_environ_sha256")!=Some(p.actual_proc_environment_sha256.as_str())
+          || t.get("root_operator_authorization").and_then(serde_json::Value::as_bool)!=Some(true)
+          || t.get("scorecard_eligible").and_then(serde_json::Value::as_bool)!=Some(false)
+          || t.get("fence_device").and_then(serde_json::Value::as_u64)!=Some(p.fence[0])
+          || t.get("fence_inode").and_then(serde_json::Value::as_u64)!=Some(p.fence[1]){
+            return Err("v5 original independently hashed authority scope mismatch".into());
+        }
+        let m:serde_json::Value=hashed(&room.join("experiment.json"),&h.manifest_sha256,SMALL)?;
+        manifest(&m,h,a)?;
+        let out=checked_path(&room,"native-output")?;
+        let r:serde_json::Value=hashed(&out.join("retention.json"),&h.native_receipt_sha256,NATIVE_JSON)?;
+        native(&r,h,a)?;
+        if r["sampling_before"]!=p.sampler_before{return Err("real original v5 sampler differs from checked start".into());}
+        let semantic=r["retained_experiment"]["identity"]["semantic_settings_sha256"].as_str().filter(|s|pin(s))
+            .ok_or("real native v5 case semantic unbound")?;
+        let computed=digest(&serde_json::to_vec(&(super::super::ordinary_ingress_observer::PURPOSE,semantic,a.evaluation_nonce,a.window_start_tick))?);
+        if computed!=a.scope_sha256{return Err("real native v5 case scope differs".into());}
+        let (projected,fork_rows)=exact_raw_rows(&out.join("rows.jsonl"),h,a)?;
+        let raw_timing=exact_raw_timing(&out.join("final.alife-checkpoint"),h,a)?;
+        let ev=if expected_ref{
+            let measured=&r["ordinary_ingress_observation_v1"];
+            let e=ReferenceEvidence{
+                state_window_sha256:measured["state_window_sha256"].as_str().filter(|s|pin(s)).ok_or("missing v5 digest Reference exact state")?.to_owned(),
+                ordinary_action_evidence_sha256:projected.clone(),exact_native_endpoint_sha256:h.final_checkpoint_sha256.clone(),
+                persisted_continuation:PersistedContinuation::deserialize(&r["final_endpoint"]["ordinary_ingress_persisted_continuation_v1"])?,
+            };
+            if measured["raw_proc_environ_sha256"]!=p.actual_proc_environment_sha256
+              || r["retained_experiment"]["identity"]["ordinary_ingress"]["raw_proc_environ_sha256"]!=p.actual_proc_environment_sha256
+              || measured["ordinary_action_evidence_sha256"]!=projected
+              || PersistedContinuation::deserialize(&measured["persisted_continuation"])?!=e.persisted_continuation
+              || e.parity()!=a.parity_sha256 || out.join("ordinary-ingress-observation.v1.bin").symlink_metadata().is_ok(){
+                return Err("v5 original Reference actual digest or no-export shape mismatch".into());
+            }
+            Some(e)
+        }else{None};
+        // Only verified projections leave the held original FDs. Neither raw path
+        // is reopened for the v5 fork or timing relation; no constructed old receipt.
+        Ok(ObservedTiming{
+            child:Child{pid:p.child.pid,ppid:p.child.ppid,pgrp:p.child.pgrp,session:p.child.session,
+                namespace:p.child.namespace,proc_start_ticks:p.child.start_ticks},
+            exact_hardware:r["hardware"].clone(),exact_sampler_after:r["sampling_after"].clone(),
+            reference_evidence:ev,env:Some(p.fresh_empty_env_identities),argv:Some(p.actual_proc_argv_sha256),
+            anchors:Some(v.exact_source_anchor_sha256.clone()),fnormalized:projected,started:p.started_utc,
+            released:f.actual_shared_fence_released_utc,raw_timing:Some(raw_timing),
+            first_fork_rows:if expected_ref{None}else{Some(fork_rows)},
+        })
+    }
+
+    pub(super) fn compare(root:&Path,input:&Input,run:&str,start:&HostStart,profile:&VerifiedStockV11Profile)
+        ->Result<(ObservedTiming,ObservedTiming)>{
+        let v=match input {
+            Input::Legacy(a)=>{let (x,y)=same_new_pair(root,a,run,start,profile)?;return Ok((x.into(),y.into()));}
+            Input::Current(v)=>v,
+        };
+        let a=&v.pair;
+        if v.schema!=V5||a.schema!=V5||!a.independently_accepted||a.scorecard_eligible
+          ||a.evaluator_sha256!=start.evaluator_sha256||a.window_start_tick!=profile.first
+          ||a.initial_phenotype_sha256!=profile.initial_phenotype_asset_sha256
+          ||a.compiled_sensor_profile!="GroundedTerrainVisionV1"||a.off.role!=Role::DefaultOff||a.reference.role!=Role::Reference
+          ||a.off.run_id==a.reference.run_id||a.off.run_id==run||a.reference.run_id==run||a.off.relative_room==a.reference.relative_room
+          ||a.off.authority_sha256==a.reference.authority_sha256||a.off.manifest_sha256==a.reference.manifest_sha256
+          ||a.off.started_sha256==a.reference.started_sha256||a.off.process_sha256==a.reference.process_sha256
+          ||a.off.release_sha256==a.reference.release_sha256||a.off.rows_sha256==a.reference.rows_sha256
+          ||a.off.native_receipt_sha256==a.reference.native_receipt_sha256||a.off.final_checkpoint_sha256==a.reference.final_checkpoint_sha256
+          ||v.actual_exec_argv_sha256[0]==v.actual_exec_argv_sha256[1]||v.independently_accepted_originals[0]==v.independently_accepted_originals[1]
+          ||v.exact_owner_original_readbacks[0]==v.exact_owner_original_readbacks[1]
+          ||![&a.scope_sha256,&a.current_sha256,&a.independent_verifier_sha256,&a.independent_comparison_sha256,
+               &a.native_setup_sha256,&a.sampling_sha256,&a.parity_sha256,&a.opening_world_sha256,&a.initial_phenotype_sha256,
+               &v.actual_driver_sha256,&v.exact_source_anchor_sha256,&v.exact_timing_relation_sha256]
+             .into_iter().chain(v.actual_exec_argv_sha256.iter()).chain(v.independently_accepted_originals.iter())
+             .chain(v.exact_owner_original_readbacks.iter()).all(|s|pin(s)){
+            return Err("explicit actual v5 ancestry requires exact two separately accepted original stock roles".into());
+        }
+        let source:SourceProof=hashed(&root.join("note19-v5-original-source-anchor.json"),&v.exact_source_anchor_sha256,SMALL)?;
+        let ph=source.source_assets.iter().filter(|(k,_)|k.starts_with("gpu-brain/phenotype-")).map(|(_,q)|q.as_str()).collect::<Vec<_>>();
+        if source.schema!="qualia.private.note19.original_v5_source_anchor.v1"||source.current_sha256!=a.current_sha256
+          ||source.evaluator_sha256!=a.evaluator_sha256||source.source_opening_world_sha256!=a.opening_world_sha256
+          ||source.descriptor_sha256!=profile.source_descriptor_sha256||source.source_assets.len()!=13
+          ||ph.as_slice()!=[a.initial_phenotype_sha256.as_str()]
+          ||!source.source_assets.values().all(|s|pin(s))||!pin(&source.independently_sealed_source_zero_sha256)
+          ||!pin(&source.exact_source_owner_readback_sha256)||!source.independently_verified_original_source||source.authorizes_next{
+            return Err("independently pinned original v5 source anchors absent or false".into());
+        }
+        rehash(&checked_path(root,"note19-independent-verifier.source")?,&a.independent_verifier_sha256,VERIFIER_SOURCE)?;
+        let n:Independent=hashed(&root.join(if a.case_id==profile.primary_case{"note19-root-independent-comparison.json"}
+            else{"note19-foil-independent-comparison.json"}),&a.independent_comparison_sha256,SMALL)?;
+        if n.schema!="qualia.private.note19.independent_actual_v5_same_case_projection.v1"
+          ||n.current_sha256!=a.current_sha256||n.evaluator_sha256!=a.evaluator_sha256||n.case_id!=a.case_id
+          ||n.off_process!=a.off.process_sha256||n.reference_process!=a.reference.process_sha256
+          ||n.off_release!=a.off.release_sha256||n.reference_release!=a.reference.release_sha256
+          ||n.raw_finals!=[a.off.final_checkpoint_sha256.clone(),a.reference.final_checkpoint_sha256.clone()]
+          ||n.scope_sha256!=a.scope_sha256||n.can_grant_capture_or_continuation_or_score
+          ||n.exact_source_anchor_sha256!=v.exact_source_anchor_sha256
+          ||n.independently_accepted_originals!=v.independently_accepted_originals
+          ||n.exact_owner_original_readbacks!=v.exact_owner_original_readbacks
+          ||n.exact_timing_relation_sha256!=v.exact_timing_relation_sha256||!pin(&n.complete_projected_rows_sha256){
+            return Err("actual v5 independent per-case original scope or custody changed".into());
+        }
+        let x=arm(root,a,&a.off,v,&source,0,start,profile)?;
+        let y=arm(root,a,&a.reference,v,&source,1,start,profile)?;
+        if x.child==y.child||x.released>=y.started||x.exact_sampler_after!=y.exact_sampler_after
+          ||x.exact_hardware!=y.exact_hardware||x.fnormalized!=n.complete_projected_rows_sha256||y.fnormalized!=n.complete_projected_rows_sha256{
+            return Err("actual separate v5 same-case custody, role, rows or sampler compare false".into());
+        }
+        Ok((x,y))
+    }
+}
