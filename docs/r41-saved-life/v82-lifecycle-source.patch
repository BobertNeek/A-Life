+    fn pin(s:&str)->bool{is_sha(s)&&s.bytes().any(|v|v!=b'0')}
+    fn snap(m:&fs::Metadata)->(u64,u64,u32,u32,u64,u64,i64,i64,i64,i64){
+        (m.dev(),m.ino(),m.uid(),m.mode(),m.nlink(),m.len(),m.mtime(),m.mtime_nsec(),m.ctime(),m.ctime_nsec())
+    }
+    fn v5_owner(m:&fs::Metadata)->Result<()>{
+        if m.uid()!=fs::metadata("/proc/self")?.uid()||m.nlink()!=1{
+            return Err("actual v5 original owner or link count refused".into());
+        }
+        Ok(())
+    }
+    fn open_original(path:&Path,cap:u64,v5:bool)->Result<(fs::File,fs::Metadata)>{
+        // Baseline read conditions deliberately preserve accepted legacy
+        // canonical, private regular bytes. Owner/nlink are v5-only.
+        let m=fs::symlink_metadata(path)?;
+        if path.canonicalize()?!=path || !m.is_file() || m.mode()&0o077!=0 || m.len()==0 || m.len()>cap{
+            return Err("Note19 bounded canonical private regular input required".into());
+        }
+        if v5{v5_owner(&m)?;}
+        // Linux O_NOFOLLOW | O_NONBLOCK. A FIFO substituted after lstat
+        // cannot hang the open. Never read until the opened FD is the
+        // exact initial regular inode; a nonblocking FIFO FD is refused.
+        const FLAGS:i32=0x20000|0o4000;
+        let f=fs::OpenOptions::new().read(true).custom_flags(FLAGS).open(path)?;
+        if snap(&f.metadata()?)!=snap(&m){return Err("actual protected original changed at open".into());}
+        Ok((f,m))
+    }
+    fn safe_original(path:&Path,cap:u64)->Result<(fs::File,fs::Metadata)>{
+        open_original(path,cap,true)
+    }
+    fn stable(f:&fs::File,path:&Path,m:&fs::Metadata)->Result<()>{
+        if snap(&f.metadata()?)!=snap(m)||snap(&fs::symlink_metadata(path)?)!=snap(m){
+            return Err("actual protected original inode changed while read or decoded".into());
+        }
+        Ok(())
+    }
+    fn held_bytes(f:&fs::File,m:&fs::Metadata,expected:&str,cap:u64)->Result<Vec<u8>>{
+        let mut b=Vec::with_capacity(m.len() as usize);
+        f.take(cap+1).read_to_end(&mut b)?;
+        if b.len() as u64!=m.len()||digest(&b)!=expected{
+            return Err("actual protected original byte hash changed".into());
+        }
+        Ok(b)
+    }
+    fn hashed<T:serde::de::DeserializeOwned>(path:&Path,expected:&str,cap:u64)->Result<T>{
+        if !pin(expected){return Err("actual v5 independent original pin required".into());}
+        let (f,m)=safe_original(path,cap)?;
+        let b=held_bytes(&f,&m,expected,cap)?;
+        let v=serde_json::from_slice(&b)?;
+        stable(&f,path,&m)?;
+        Ok(v)
+    }
+    // No blocking legacy probe. Discriminator and selected full role use
+    // the same authenticated bytes from one still-held checked descriptor.
+    pub(super) fn read(path:&Path,expected:&str)->Result<Input>{
+        let (f,m)=open_original(path,SMALL,false)?;
+        let b=held_bytes(&f,&m,expected,SMALL)?;
+        let kind:Tag=serde_json::from_slice(&b)?;
+        let input=match kind.schema.as_str(){
+            LEGACY=>Input::Legacy(serde_json::from_slice(&b)?),
+            V5=>{
+                if !pin(expected){return Err("actual v5 independent ancestor pin required".into());}
+                v5_owner(&m)?;
+                Input::Current(serde_json::from_slice(&b)?)
+            }
+            _=>return Err("unknown typed Note19 lifecycle ancestry version".into()),
+        };
+        stable(&f,path,&m)?;
+        Ok(input)
+    }
