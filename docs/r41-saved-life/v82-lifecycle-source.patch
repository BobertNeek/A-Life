+    fn exact_raw_rows(path:&Path,h:&Arm,a:&Acceptance)->Result<(String,Vec<ForkFrame>)>{
+        use super::super::ordinary_ingress_row_parity as parity;
+        let (f,m)=safe_original(path,NATIVE_ROWS)?;
+        let mut stream=BufReader::with_capacity(64<<10,f);
+        let (mut raw,mut projected)=(Sha256::new(),Sha256::new());
+        let mut line=Vec::new();let mut count=0u64;let mut fork=Vec::new();
+        for i in 0..256 {
+            line.clear();
+            let n=(&mut stream).take(parity::MAX_ROW_BYTES as u64+1).read_until(b'\n',&mut line)?;
+            count=count.checked_add(n as u64).ok_or("v5 bounded stable original row extent")?;
+            if count>m.len()||n==0||n>parity::MAX_ROW_BYTES as usize{
+                return Err("v5 exact original row bound or missing decision".into());
+            }
+            let tick=a.window_start_tick.checked_add(i as u64).ok_or("v5 decision range overflow")?;
+            raw.update(&line);
+            parity::update(&mut projected,&line,i,a.owner,tick)?;
+            if h.role==Role::DefaultOff&&i<7{fork.push(material_fork_row(&line,tick,a.owner)?);}
+        }
+        if count!=m.len()||!stream.fill_buf()?.is_empty()||format!("{:x}",raw.finalize())!=h.rows_sha256{
+            return Err("v5 full raw original row SHA/coverage differs".into());
+        }
+        stable(stream.get_ref(),path,&m)?;
+        Ok((format!("{:x}",projected.finalize()),fork))
+    }
