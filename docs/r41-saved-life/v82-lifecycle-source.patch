+    fn exact_raw_timing(path:&Path,h:&Arm,a:&Acceptance)->Result<Endpoint>{
+        let (f,m)=safe_original(path,64<<20)?;
+        let mut bytes=Vec::with_capacity(m.len() as usize);
+        (&f).take(m.len()+1).read_to_end(&mut bytes)?;
+        if bytes.len() as u64!=m.len(){return Err("v5 exact portable original grew or truncated".into());}
+        let tick=a.window_start_tick.checked_add(256).ok_or("v5 portable tick overflow")?;
+        let relation=super::super::ordinary_ingress_timing_relation::endpoint(
+               &bytes,&h.final_checkpoint_sha256,a.owner,tick)?;
+        // Same owner-only FD spans full header/body hash and typed timing decode.
+        stable(&f,path,&m)?;
+        Ok(relation)
+    }
