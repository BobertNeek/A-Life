+}
+
+#[derive(Clone, Copy, Debug)]
+struct CurrentTrack {
+    identity: TrackIdentity,
+    native_approach_index: u16,
+    position: Vec3f,
+    confidence: f32,
+    features: [f32; 6],
+}
+
+#[derive(Clone, Debug)]
+pub(super) struct BeforeCut {
+    actor: OrganismId,
+    tick: Tick,
+    digest: PerceptionFrameDigest,
+    body: Vec3f,
+    tracks: Vec<CurrentTrack>,
+}
+
+#[derive(Clone, Copy, Debug)]
+struct PriorPaidApproach {
+    actor: OrganismId,
+    outcome_tick: Tick,
+    track: TrackIdentity,
+    confidence: f32,
+    closure_m: f64,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(super) struct ContextWord {
+    pub(super) amount: f32,
+    pub(super) appearance: [f32; 6],
+    pub(super) confidence: f32,
+    pub(super) recent_closure_m: f64,
+}
+
+#[derive(Debug)]
+pub(super) struct Session {
+    pub(super) owner: OrganismId,
+    weights: Option<WordLocalWeightsV1>,
+    prior: Option<PriorPaidApproach>,
+    // Pending capture is not committed prior. It is absent after failed or
+    // skipped staging; only the outer successful actual tick can finish it.
+    pub(super) pending: Option<BeforeCut>,
+    pub(super) observed: Option<ContextWord>,
+}
+
+impl Session {
+    pub(super) fn new(owner: OrganismId, weights: Option<WordLocalWeightsV1>) -> Result<Self, ScaffoldContractError> {
+        Ok(Self { owner, weights: weights.map(WordLocalWeightsV1::validate).transpose()?,
+            prior: None, pending: None, observed: None })
+    }
+
+    pub(super) fn preselection(&mut self, world: &HeadlessWorld, frame: &PerceptionFrame,
+        binding: Option<&GroundedCandidateBinding>,
+    ) -> Option<ContextWord> {
+        let old = self.prior.take();
+        self.pending = binding.and_then(|b| BeforeCut::capture(world, frame, b, self.owner));
+        self.observed = self.pending.as_ref().zip(old).and_then(|(now, prior)| {
+            if now.actor != prior.actor || now.tick != prior.outcome_tick {
+                return None;
+            }
+            let target = now.tracks.iter().find(|x| x.identity == prior.track)?;
+            let confidence = target.confidence.min(prior.confidence);
+            Some(ContextWord {
+                amount: self.weights.and_then(|w| w.delta(target.features, confidence, prior.closure_m)).unwrap_or(0.0),
+                appearance: target.features, confidence, recent_closure_m: prior.closure_m,
+            })
+        });
+        self.observed
+    }
+
+    pub(super) fn settled(&mut self, world: &HeadlessWorld, steps: &[FoundationTrainingStep]) {
+        if !self.pending.as_ref().is_some_and(|pending| steps.len() == 1
+            && steps[0].frame.frame_digest() == pending.digest
+            && steps[0].frame.tick() == pending.tick)
+        {
+            self.observed = None;
+        }
+        self.prior = self.pending.take().and_then(|before| {
+            let [step] = steps else { return None; };
+            before.settled(world, step)
+        });
+    }
+
+    pub(super) fn abort(&mut self) {
+        self.prior = None;
+        self.pending = None;
+        self.observed = None;
+    }
+}
+
+fn position_bits(v: Vec3f) -> [u32; 3] { [v.x.to_bits(), v.y.to_bits(), v.z.to_bits()] }
+
+fn difference(a: Vec3f, b: Vec3f) -> [f64; 3] {
+    [f64::from(a.x) - f64::from(b.x), f64::from(a.y) - f64::from(b.y), f64::from(a.z) - f64::from(b.z)]
+}
+
+fn norm([x, y, z]: [f64; 3]) -> f64 { x.hypot(y).hypot(z) }
+
+fn radial_m(before: Vec3f, after: Vec3f, target: Vec3f, real_delta: Vec3f) -> Option<f64> {
+    let [dx, dy, dz] = difference(after, before);
+    let error = norm([dx - f64::from(real_delta.x), dy - f64::from(real_delta.y), dz - f64::from(real_delta.z)]);
+    let closure = norm(difference(before, target)) - norm(difference(after, target));
+    (error.is_finite() && error <= MOTION_AGREEMENT_M && closure.is_finite() && closure >= MIN_CLOSURE_M)
+        .then_some(closure)
+}
+
+impl BeforeCut {
+    fn capture(world: &HeadlessWorld, frame: &PerceptionFrame,
+        binding: &GroundedCandidateBinding, owner: OrganismId,
+    ) -> Option<Self> {
+        let tick = frame.tick();
+        if frame.organism_id() != owner || tick != world.tick()
+            || frame.sensor_profile() != SensorProfile::GroundedTerrainVisionV1
+            || frame.grounded_object_slots().len() > 32 || frame.candidates().len() > 32
+        {
+            return None;
+        }
+        let resident = world.organism_registry().get(owner)?;
+        let actor = world.entity(resident.world_entity_id())?;
+        if !resident.lifecycle().is_alive() || actor.organism_id != Some(owner) || actor.consumed
+            || position_bits(actor.position) != position_bits(frame.body().pose.translation)
+        {
+            return None;
+        }
+        let mut tracks: Vec<CurrentTrack> = Vec::new();
+        for (idx, c) in frame.candidates().iter().enumerate().filter(|(_, c)| c.action_id == HeadlessActionIds::APPROACH) {
+            let (CandidateObservationRef::ObjectSlot(slot), Some(id), Some(position)) =
+                (c.observation, c.target.entity, c.target.position) else { continue; };
+            if c.kind != ActionKind::Move || c.family != CandidateActionFamily::Approach
+                || usize::from(c.candidate_index) != idx
+                || !binding.matches_word_local_transport_v1(frame, c)
+            { return None; }
+            let seen = frame.grounded_object_slots().iter().find(|s| s.slot_index == slot)?;
+            let obj = world.entity(id)?;
+            if obj.consumed || obj.carried_by.is_some() || obj.activity_hold || world.player_held_object() == Some(id) {
+                continue;
+            }
+            let hit = world.tracked_objects().record(owner, seen.tracked_object_id)?;
+            let f = seen.candidate_features().ok()?.0;
+            let features = [f[9], f[10], f[11], f[12], f[13], f[14]];
+            let confidence = seen.confidence.raw();
+            if position_bits(obj.position) != position_bits(position)
+                || hit.tracking_key != obj.tracking_key || hit.tracking_provenance != obj.tracking_provenance
+                || obj.tracking_provenance.canonical_key() != obj.tracking_key || hit.last_seen_tick != tick
+                || !(0.0..=1.0).contains(&confidence) || confidence == 0.0
+                || confidence.to_bits() != c.sensor_confidence.raw().to_bits()
+                || f.iter().zip(&c.features.0).any(|(x, y)| x.to_bits() != y.to_bits())
+                || !features.iter().all(|x| (0.0..=1.0).contains(x))
+                || tracks.iter().any(|x| x.identity.spawn == obj.tracking_key
+                    || x.identity.track == seen.tracked_object_id || x.identity.target == id)
+            {
+                return None;
+            }
+            tracks.push(CurrentTrack {
+                identity: TrackIdentity { target: id, track: seen.tracked_object_id,
+                    spawn: obj.tracking_key, provenance: obj.tracking_provenance },
+                native_approach_index: c.candidate_index, position, confidence, features,
+            });
+        }
+        Some(Self { actor: owner, tick, digest: frame.frame_digest(), body: actor.position, tracks })
+    }
+
+    fn settled(self, world: &HeadlessWorld, step: &FoundationTrainingStep) -> Option<PriorPaidApproach> {
+        let out = step.patch.outcome();
+        if self.tick.raw().checked_add(1) != Some(out.outcome_tick.raw()) || world.tick() != out.outcome_tick
+            || out.organism_id != self.actor || step.frame.organism_id() != self.actor
+            || step.frame.tick() != self.tick || step.frame.frame_digest() != self.digest
+            || step.patch.pre_action().perception().frame_digest() != self.digest
+            || step.behavior.frame_digest != self.digest || step.behavior.organism_id != self.actor.raw()
+            || step.behavior.tick != self.tick.raw() || step.behavior.sampling.demonstrator.is_some()
+            || step.behavior.behavior != alife_gpu_backend::GpuTrainingBehaviorKind::OnPolicy
+        { return None; }
+        let mut commands = step.patch.selected_bundle()?.channels.iter().filter(|x| x.channel == MotorChannel::Locomotion);
+        let cmd = commands.next()?;
+        let mut outcomes = out.joint.as_ref()?.channel_outcomes.iter().filter(|x| x.channel == MotorChannel::Locomotion);
+        let loc = outcomes.next()?;
+        let evidence = loc.execution_evidence.as_ref()?;
+        let chosen = self.tracks.iter().find(|r| r.native_approach_index == step.behavior.motor_indices[0])?;
+        let target = cmd.target?;
+        let cost = loc.physical.energy_cost.raw();
+        if commands.next().is_some() || outcomes.next().is_some()
+            || cmd.primitive != HeadlessActionIds::APPROACH || evidence.primitive != cmd.primitive
+            || !evidence.succeeded || !(cost.is_finite() && cost > 0.0)
+            || loc.physical.contact != PhysicalContactKind::Moved
+            || target.entity != Some(chosen.identity.target) || evidence.command_target != target.entity
+            || loc.physical.target_entity != target.entity || target.position.map(position_bits) != Some(position_bits(chosen.position))
+            || out.joint.as_ref()?.channel_outcomes.iter().filter(|x| x.channel != MotorChannel::Locomotion)
+                .any(|x| norm(difference(x.physical.displacement, Vec3f::ZERO)) > MOTION_AGREEMENT_M)
+        { return None; }
+        let obj = world.entity(chosen.identity.target)?;
+        let resident = world.organism_registry().get(self.actor)?;
+        let actor = world.entity(resident.world_entity_id())?;
+        if !resident.lifecycle().is_alive() || actor.organism_id != Some(self.actor) || actor.consumed
+            || obj.consumed || obj.carried_by.is_some() || obj.activity_hold || world.player_held_object() == Some(obj.id)
+            || position_bits(obj.position) != position_bits(chosen.position)
+            || obj.tracking_key != chosen.identity.spawn || obj.tracking_provenance != chosen.identity.provenance
+        { return None; }
+        Some(PriorPaidApproach { actor: self.actor, outcome_tick: out.outcome_tick,
+            track: chosen.identity, confidence: chosen.confidence,
+            closure_m: radial_m(self.body, actor.position, chosen.position, loc.physical.displacement)? })
+    }
+}
+
+/// One arm's actual stock sampler input. "Before" is supplied only by
+/// independently matching an observer-only arm; it is never inferred by
+/// subtracting the proposed correction from the signed arm's GPU result.
+#[derive(Clone, Debug, serde::Serialize)]
+pub(crate) struct WordScoreWitnessV1 {
+    frame_digest: PerceptionFrameDigest,
+    organism: OrganismId,
+    decision_tick: Tick,
+    actual_weight_generation: u64,
+    actual_dispatch_generation: u64,
+    native_word_candidate_index: Option<u16>,
+    native_word_finite_presampler_score_bits: Option<u32>,
+    native_representative_mask: u32,
+    native_motor_masks: [u32; 6],
+    native_vocal_channel_choice: u16,
+    admitted_port_word_index: Option<u32>,
+    admitted_port_amount_bits: Option<u32>,
+    proposed_context_delta_bits: Option<u32>,
+    score_source: &'static str,
+}
+
+pub(super) fn score_witness(
+    step: &FoundationTrainingStep, context: Option<ContextWord>,
+) -> Result<WordScoreWitnessV1, ScaffoldContractError> {
+    let frame = &step.frame;
+    let b = &step.behavior;
+    let rows = frame.candidates();
+    if frame.frame_digest() != b.frame_digest || frame.tick().raw() != b.tick
+        || frame.organism_id().raw() != b.organism_id
+        || step.patch.pre_action().perception().frame_digest() != frame.frame_digest()
+        || step.after_inference.logical_dispatch_generation != b.dispatch_generation
+        || step.after_inference.active_weight_generation != b.active_weight_generation
+        || b.logits.len() != rows.len() || b.forced_motor_slots.len() != rows.len()
+        || b.sampling.demonstrator.is_some()
+        || b.behavior != alife_gpu_backend::GpuTrainingBehaviorKind::OnPolicy
+    { return Err(ScaffoldContractError::InvalidDecisionEvidence); }
+    let word = unique_native_word(rows)?;
+    let admitted = step.memory_upload.admitted_word_local_grounding_v1();
+    let proposed = context.map(|c| c.amount);
+    let expected = Option::zip(word, proposed.filter(|v| *v > 0.0))
+        .map(|(i,v)| (u32::from(i),v.to_bits()));
+    if admitted.map(|(i,v)| (i,v.to_bits())) != expected {
+        return Err(ScaffoldContractError::InvalidDecisionEvidence);
+    }
+    let raw = if let Some(i) = word {
+        let j = usize::from(i);
+        let score = b.logits[j];
+        let mask = 1u32 << j;
+        if b.forced_motor_slots[j] != 3 || (b.representative_mask & mask != 0) != score.is_finite()
+            || (b.motor_masks[3] & mask != 0 && !score.is_finite())
+        { return Err(ScaffoldContractError::InvalidDecisionEvidence); }
+        score.is_finite().then(|| score.to_bits())
+    } else { None };
+    Ok(WordScoreWitnessV1 {
+        frame_digest: frame.frame_digest(),
+        organism: frame.organism_id(),
+        decision_tick: frame.tick(),
+        actual_weight_generation: b.active_weight_generation,
+        actual_dispatch_generation: b.dispatch_generation,
+        native_word_candidate_index: word,
+        native_word_finite_presampler_score_bits: raw,
+        native_representative_mask: b.representative_mask,
+        native_motor_masks: b.motor_masks,
+        native_vocal_channel_choice: b.motor_indices[3],
+        admitted_port_word_index: admitted.map(|(i,_)| i),
+        admitted_port_amount_bits: admitted.map(|(_,v)| v.to_bits()),
+        proposed_context_delta_bits: proposed.map(f32::to_bits),
+        score_source: "actual_native_selector_final_logit_bits",
+    })
+}
+
+fn unique_native_word(rows: &[alife_core::ActionCandidate])
+    -> Result<Option<u16>, ScaffoldContractError>
+{
+    if rows.len() > 32 { return Err(ScaffoldContractError::InvalidDecisionEvidence); }
+    let mut words = rows.iter().enumerate().filter(|(_,c)| c.action_id == ActionKind::Vocalize.canonical_id());
+    let Some((i,c)) = words.next() else { return Ok(None); };
+    if words.next().is_some() || usize::from(c.candidate_index) != i
+        || c.kind != ActionKind::Vocalize || c.family != CandidateActionFamily::Other
+        || c.observation != CandidateObservationRef::None
+        || c.target.entity.is_some() || c.target.position.is_some()
+        || c.features.0[22].to_bits() != 1.0f32.to_bits()
+        || c.features.0[23].to_bits() != 1.0f32.to_bits()
+    { return Err(ScaffoldContractError::InvalidDecisionEvidence); }
+    Ok(Some(c.candidate_index))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn paid_motion_agrees_with_body_and_closes_same_fixed_target() {
+        let a = Vec3f::new(0.0, 0.0, 0.0);
+        let b = Vec3f::new(0.041, 0.0, 0.0);
+        let t = Vec3f::new(1.0, 0.0, 0.0);
+        assert!(radial_m(a, b, t, b).unwrap() > 0.04);
+        assert!(radial_m(a, b, t, a).is_none());
+        assert!(radial_m(a, a, t, a).is_none());
+        assert!(radial_m(b, a, t, Vec3f::new(-0.041, 0.0, 0.0)).is_none());
+    }
+    #[test]
+    fn signed_material_abstains_without_suppressing_stock_word() {
+        let w = WordLocalWeightsV1 { coefficients: [-64.0, 64.0, 0.0, 0.0, 0.0, 0.0] };
+        assert_eq!(w.delta([0.0, 1.0, 0.5, 0.5, 0.5, 0.5], 1.0, 0.04), Some(96.0));
+        assert_eq!(w.delta([1.0, 0.0, 0.5, 0.5, 0.5, 0.5], 1.0, 0.04), Some(0.0));
+        assert_eq!(w.delta([0.0, 1.0, 0.5, 0.5, 0.5, 0.5], 1.0, 0.0), None);
+        assert_eq!(w.delta([0.0, 1.0, 0.5, 0.5, 0.5, 0.5], f32::NAN, 0.04), None);
+        assert!(WordLocalWeightsV1 { coefficients: [100.0; 6] }.validate().is_err());
+    }
+}
