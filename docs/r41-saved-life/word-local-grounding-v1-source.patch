+//! Optional, process-local Word context at the actual finalized live cut.
+//! No scene, target ID, token, outcome or teacher bit is a decoder input.
+use super::*;
+use alife_core::{
+    ActionKind, CandidateActionFamily, CandidateObservationRef, MotorChannel, PerceptionFrameDigest,
+    PhysicalContactKind, TrackedObjectId, Vec3f,
+};
+use alife_world::{GroundedCandidateBinding, HeadlessActionIds, PhysicalTrackingKey, PhysicalTrackingProvenance};
+
+const MIN_CLOSURE_M: f64 = 0.001;
+const MOTION_AGREEMENT_M: f64 = 0.0001;
+const FULL_CLOSURE_M: f64 = 0.04;
+const MAX_WORD_DELTA: f32 = 96.0;
+const MAX_WORD_WEIGHT_L1: f32 = 256.0;
+
+#[derive(Clone, Copy, Debug, serde::Deserialize, serde::Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct WordLocalWeightsV1 {
+    // In order: centered native material f9–11 and shape f12–14.
+    coefficients: [f32; 6],
+}
+
+impl WordLocalWeightsV1 {
+    pub(crate) fn validate(self) -> Result<Self, ScaffoldContractError> {
+        if self.coefficients.iter().all(|w| w.is_finite() && w.abs() <= 128.0)
+            && self.coefficients.iter().map(|w| w.abs()).sum::<f32>() <= MAX_WORD_WEIGHT_L1
+        {
+            return Ok(self);
+        }
+        Err(ScaffoldContractError::InvalidPerceptionFrame)
+    }
+
+    fn delta(self, features: [f32; 6], confidence: f32, closure_m: f64) -> Option<f32> {
+        self.validate().ok()?;
+        if !features.iter().all(|x| (0.0..=1.0).contains(x))
+            || !(0.0..=1.0).contains(&confidence)
+            || !closure_m.is_finite() || closure_m < MIN_CLOSURE_M
+        {
+            return None;
+        }
+        let signed_affinity = self.coefficients.iter().zip(features)
+            .fold(0.0f32, |sum, (w, x)| sum + w * (x * 2.0 - 1.0));
+        let gate = (closure_m / FULL_CLOSURE_M).min(1.0) as f32 * confidence;
+        // Negative affinity abstains from adding new contextual evidence. It
+        // must not suppress the mature actor's existing autonomous word.
+        Some((signed_affinity * gate).clamp(0.0, MAX_WORD_DELTA))
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct TrackIdentity {
+    target: WorldEntityId,
+    track: TrackedObjectId,
