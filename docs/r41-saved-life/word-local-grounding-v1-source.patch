+// Versioned optional Word-local candidate bid. Legacy stock module untouched.
+fn word_local_grounding_v1(
+    row_base: u32, header: GpuMemoryContextHeader, brain: GpuBrainSlotRecord,
+    candidate: GpuCandidateRecord, stock: f32
+) -> f32 {
+  let packet = header.neural_receptor_effects_offset + 16u;
+  let length = arrayLength(&frame_payload_words);
+  let p = load_perception_header(row_base);
+  if (packet > length || 10u > length - packet
+      || frame_payload_words[packet] != 0x574c4731u
+      || frame_payload_words[packet + 1u] != 1u
+      || frame_payload_words[packet + 2u] != p.slot
+      || frame_payload_words[packet + 3u] != p.slot_generation
+      || frame_payload_words[packet + 4u] != p.tick_lo
+      || frame_payload_words[packet + 5u] != p.tick_hi
+      || frame_payload_words[packet + 6u] != p.dispatch_generation_lo
+      || frame_payload_words[packet + 7u] != p.dispatch_generation_hi
+      || frame_payload_words[packet + 8u] >= header.candidate_count) {
+    atomicOr(&mutable_state_words[brain.diagnostic_offset + MEMORY_CONTEXT_DIAGNOSTIC_LANE],
+      CONTRACT_INVALID_DIAGNOSTIC_BIT);
+    return stock;
+  }
+  if (candidate.candidate_index != frame_payload_words[packet + 8u]) { return stock; }
+  let d = bitcast<f32>(frame_payload_words[packet + 9u]);
+  if (candidate.action_id != 400u || candidate.kind != 6u || candidate.family != 7u
+      || candidate.observation_slot_or_max != 0xffffffffu
+      || !(d > 0.0 && d <= 96.0)) {
+    atomicOr(&mutable_state_words[brain.diagnostic_offset + MEMORY_CONTEXT_DIAGNOSTIC_LANE],
+      CONTRACT_INVALID_DIAGNOSTIC_BIT);
+    return stock;
+  }
+  if (!finite_memory_value(stock)) { return stock; }
+  if (!finite_memory_value(stock + d)) {
+    atomicOr(&mutable_state_words[brain.diagnostic_offset + MEMORY_CONTEXT_DIAGNOSTIC_LANE],
+      CONTRACT_INVALID_DIAGNOSTIC_BIT);
+    return stock;
+  }
+  return stock + d;
+}
