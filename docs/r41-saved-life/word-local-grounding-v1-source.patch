+#[cfg(feature = "retained-word-local-grounding-v1")]
+fn resolve_word_local(root: &Path, bytes: &[u8]) -> Result<ResolvedExperiment> {
+    use std::io::Read;
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Envelope {
+        schema: u16,
+        settings: ManifestV1,
+        mode: WordLocalMode,
+        operator_grant_sha256: String,
+    }
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Grant {
+        schema: String,
+        evaluator_sha256: String,
+        source_current_sha256: String,
+        run_id: String,
+        unchanged_settings_sha256: String,
+        mode_sha256: String,
+        scorecard_eligible: bool,
+    }
+    let e: Envelope = serde_json::from_slice(bytes)?;
+    if bytes.len() > MAX_SMALL_CONFIG_BYTES || e.schema != 10
+        || !exact_sha256(&e.operator_grant_sha256)
+        || !matches!(&e.settings.intervention, InterventionV1::Control {})
+        || e.settings.scenario != ScenarioV1::PublishedCardCase
+        || e.settings.max_decisions != 256 || e.settings.max_world_ticks != 256
+    {
+        return Err("unsupported Word-local scope/settings".into());
+    }
+    if let WordLocalMode::SignedEdit { weights } = e.mode {
+        weights.validate()?;
+    }
+    let mode_sha256 = digest(&serde_json::to_vec(&e.mode)?);
+    // Nested byte identity uses canonical serde struct serialization over
+    // the strict stock typed fields; no hidden setup or coordinate vector.
+    let settings = serde_json::to_vec(&e.settings)?;
+    let unchanged_settings_sha256 = digest(&settings);
+    let p = canonical_inside(root, &root.join("word-local-operator-grant.v1.json"))?;
+    let length = fs::metadata(&p)?;
+    if !length.is_file() || length.len() > 16_384 {
+        return Err("invalid bounded Word-local grant".into());
+    }
+    let mut raw = Vec::new();
+    fs::File::open(p)?.take(16_385).read_to_end(&mut raw)?;
+    if raw.len() > 16_384 || digest(&raw) != e.operator_grant_sha256 {
+        return Err("Word-local grant hash mismatch".into());
+    }
+    let g: Grant = serde_json::from_slice(&raw)?;
+    if g.schema != "qualia.saved_life.word_local_operator_grant.v1"
+        || g.scorecard_eligible || !exact_sha256(&g.evaluator_sha256)
+        || digest(&fs::read(std::env::current_exe()?)?) != g.evaluator_sha256
+        || g.run_id != e.settings.run_id || g.source_current_sha256 != e.settings.source_current_sha256
+        || g.unchanged_settings_sha256 != unchanged_settings_sha256 || g.mode_sha256 != mode_sha256
+    {
+        return Err("Word-local grant scope or evaluator differs".into());
+    }
+    let mut resolved = resolve(&settings)?;
+    resolved.identity.schema = 10;
+    resolved.identity.manifest_sha256 = digest(bytes);
+    resolved.identity.semantic_settings_sha256 = digest(&serde_json::to_vec(&(
+        "word-local-grounding-v1", &resolved.identity.semantic_settings_sha256, &mode_sha256,
+    ))?);
+    resolved.identity.intervention = match e.mode {
+        WordLocalMode::ObserverOnly => "word_local_observer_only",
+        WordLocalMode::SignedEdit { .. } => "word_local_signed_edit",
+    };
+    resolved.identity.word_local_grounding = Some(WordLocalScope {
+        mode: e.mode, evaluator_sha256: g.evaluator_sha256,
+        grant_sha256: e.operator_grant_sha256, unchanged_settings_sha256, scorecard_eligible: false,
+    });
+    Ok(resolved)
 }
 
