--- /dev/null
+++ b/crates/alife_gpu_backend/shaders/wsp_approach_v2.wgsl
@@ -0,0 +1,116 @@
+// Detached, explicitly signed single-row optional contribution pass.
+// No action APIs or sampler alteration. All addresses are typed native frame words.
+// At entrance each precontext capture already holds actual stock context logits.
+const WSP_APPROACH_MAGIC:u32 = 0x32505357u;
+const WSP_APPROACH_WORDS:u32 = 72u;
+const WSP_MIN_AXIS:f32 = 0.03125;
+
+fn wsp_approach_agreement(port:u32, rail:u32, proto:u32) -> f32 {
+    var v=1.0;
+    for (var i=0u;i<8u;i++) {
+        let w=bitcast<f32>(frame_payload_words[port+proto+i]);
+        let x=bitcast<f32>(frame_payload_words[port+rail+i]);
+        if (abs(w)!=1.0 || !finite_decode(x) || x==0.0 || abs(x)>1.0) { return 0.0; }
+        v=min(v,max(0.0,x*w));
+    }
+    return v;
+}
+
+fn wsp_approach_map_is_live(brain:GpuBrainSlotRecord, family:GpuDecoderFamilyRecord,
+                            global_id:u32, lane:u32, motor:u32) -> bool {
+    if (family.family_raw!=3u || family.decoder_synapse_count!=384u
+        || family.weight_index_count!=family.decoder_synapse_count
+        || !span_within(family.decoder_synapse_start,family.decoder_synapse_count,brain.synapse_count)
+        || global_id<family.decoder_synapse_start
+        || global_id-family.decoder_synapse_start>=family.decoder_synapse_count) { return false; }
+    let map=load_decoder_weight_index(family.weight_index_start+4u*(global_id-family.decoder_synapse_start));
+    return map.global_synapse_id==global_id && map.motor_index==motor && map.input_lane==lane
+        && map.reserved0==0u;
+}
+
+@compute @workgroup_size(1)
+fn apply_wsp_approach_v2(@builtin(global_invocation_id) gid:vec3<u32>) {
+    if (any(gid!=vec3<u32>(0u))) { return; }
+    let header=load_perception_header(0u);
+    if (!activity_contract_prevalidated(header) || (header.reserved & 0x80000000u)==0u
+        || header.candidate_count<2u || header.candidate_count>32u) { return; }
+    let sampling=header.reserved & 0x7fffffffu;
+    let port=sampling+11u;
+    if (!span_within(port,WSP_APPROACH_WORDS,arrayLength(&frame_payload_words))
+        || frame_payload_words[sampling+3u]!=0u
+        || frame_payload_words[port]!=WSP_APPROACH_MAGIC || frame_payload_words[port+1u]!=1u
+        || frame_payload_words[port+2u]!=1u || frame_payload_words[port+10u]!=1u
+        || frame_payload_words[port+3u]!=header.candidate_count
+        || frame_payload_words[port+4u]!=header.tick_lo || frame_payload_words[port+5u]!=header.tick_hi
+        || frame_payload_words[port+6u]!=header.slot || frame_payload_words[port+7u]!=header.slot_generation
+        || frame_payload_words[port+8u]!=header.dispatch_generation_lo
+        || frame_payload_words[port+9u]!=header.dispatch_generation_hi
+        || frame_payload_words[port+51u]!=0x41000000u
+        || frame_payload_words[port+52u]!=0x41800000u
+        || frame_payload_words[port+53u]!=0xc1800000u) { return; }
+    let verb=wsp_approach_agreement(port,11u,27u);
+    let noun_food=wsp_approach_agreement(port,19u,35u);
+    let noun_object=wsp_approach_agreement(port,19u,43u);
+    let pulse=min(verb,noun_object)-min(verb,noun_food);
+    if (pulse==0.0) { return; }
+    let brain=brain_slots[header.brain_slot_index];
+    let decoder=load_decoder_plan(brain.decoder_plan_offset);
+    if (decoder.schema_version!=1u || decoder.family_offset!=brain.decoder_family_offset
+        || decoder.family_count!=8u || decoder.feature_count!=24u
+        || decoder.motor_start!=1728u || decoder.motor_width<=55u
+        || !span_within(decoder.motor_start,decoder.motor_width,brain.neuron_count)) { return; }
+    let family=find_decoder_family(decoder,3u);
+    if (!wsp_approach_map_is_live(brain,family,25752u,1u,55u)
+        || !wsp_approach_map_is_live(brain,family,25896u,10u,55u)
+        || !wsp_approach_map_is_live(brain,family,25912u,11u,55u)) { return; }
+    let side=atomicLoad(&mutable_state_words[brain.diagnostic_offset+3u]);
+    if (side>1u) { return; }
+    let activation=select(brain.activation_a_offset,brain.activation_b_offset,side==1u);
+    let a=load_state_f32(activation+decoder.motor_start+55u);
+    if (!finite_decode(a) || a<=0.0 || a>1.0) { return; }
+    let i0=frame_payload_words[port+54u]; let i1=frame_payload_words[port+63u];
+    let slot0=frame_payload_words[port+55u]; let slot1=frame_payload_words[port+64u];
+    if (i0>=header.candidate_count || i1>=header.candidate_count || i0==i1
+        || slot0>=16u || slot1>=16u || slot0==slot1) { return; }
+    var axes:array<f32,2>;
+    var alignments:array<f32,2>;
+    var stock:array<f32,2>;
+    var seen=0u;
+    for (var i=0u;i<header.candidate_count;i++) {
+        let offer=load_candidate(header.candidate_offset+i*8u);
+        let named=i==i0 || i==i1;
+        if (!named) { if (offer.action_id==101u) { return; } continue; }
+        let j=select(0u,1u,i==i1);
+        let at=port+54u+9u*j;
+        if (offer.action_id!=101u || offer.kind!=ACTION_KIND_MOVE || offer.family!=3u
+            || offer.candidate_index!=i || offer.observation_slot_or_max!=frame_payload_words[at+1u]
+            || !span_within(offer.feature_offset,24u,arrayLength(&frame_payload_words))
+            || (!training_candidate_allowed(header,brain,i,1u)
+                && !training_candidate_allowed(header,brain,i,0u))) { return; }
+        let bearing_word=frame_payload_words[offer.feature_offset+1u];
+        let f1=bitcast<f32>(bearing_word);
+        if (bearing_word!=frame_payload_words[at+2u] || !finite_decode(f1) || abs(f1)>1.0) { return; }
+        for (var k=0u;k<6u;k++) {
+            let word=frame_payload_words[offer.feature_offset+9u+k];
+            let x=bitcast<f32>(word);
+            if (word!=frame_payload_words[at+3u+k] || !finite_decode(x) || x<0.0 || x>1.0) { return; }
+        }
+        axes[j]=bitcast<f32>(frame_payload_words[offer.feature_offset+10u])
+            - bitcast<f32>(frame_payload_words[offer.feature_offset+11u]);
+        alignments[j]=max(0.0,f1);
+        stock[j]=load_state_f32(brain.candidate_logit_offset+i);
+        seen|=1u<<j;
+    }
+    if (seen!=3u || max(axes[0],axes[1])<WSP_MIN_AXIS || min(axes[0],axes[1]) > -WSP_MIN_AXIS) { return; }
+    let d1=((pulse*a)*bitcast<f32>(frame_payload_words[port+52u]));
+    let d2=((abs(pulse)*a)*bitcast<f32>(frame_payload_words[port+51u]));
+    var next:array<f32,2>;
+    for (var j=0u;j<2u;j++) {
+        let q=axes[j];
+        let d=d1*q+select(0.0,d2*alignments[j],pulse*q>=WSP_MIN_AXIS*abs(pulse));
+        next[j]=stock[j]+d;
+        if (!finite_decode(d) || abs(d)>24.0 || !finite_decode(next[j])) { return; }
+    }
+    store_state_f32(brain.candidate_logit_offset+i0,next[0]);
+    store_state_f32(brain.candidate_logit_offset+i1,next[1]);
+}
