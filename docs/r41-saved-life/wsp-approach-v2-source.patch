new file mode 100644
--- /dev/null
+++ b/crates/alife_game_app/src/gpu_live_runtime/wsp_approach_runtime.rs
@@ -0,0 +1,124 @@
+//! Narrow private authority between prepared World and the normal signed GPU sampler.
+use super::*;
+use alife_core::{ActionKind,CandidateActionFamily,CandidateObservationRef,PerceptionFrameDigest,UtteranceSourceKind};
+use alife_gpu_backend::training_rollout::{WspApproachV2Input,WspApproachV2Receipt};
+use alife_world::{AudibleUtterance,HeadlessActionIds};
+
+#[derive(Clone,Debug,serde::Deserialize,serde::Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct WspApproachV2Reference {
+    pub frame:PerceptionFrameDigest,
+    pub world_before:HeadlessWorldSignatureDigest,
+    pub active_weight_generation:u64,
+    pub sampling:alife_gpu_backend::GpuTrainingSamplingConfig,
+    pub stock_post_context_u32:Vec<u32>,
+}
+
+#[derive(Debug)]
+pub(super) struct Request {
+    pub owner:OrganismId,
+    pub tick:Tick,
+    pub world:HeadlessWorldSignatureDigest,
+    pub atom:Option<AudibleUtterance>,
+    pub prototype:[u32;24],
+    pub reference:Option<WspApproachV2Reference>,
+}
+
+impl GpuLiveBrainRuntime {
+    pub(crate) fn arm_wsp_approach_v2(
+        &mut self,owner:OrganismId, prot:[u32;24], atom:Option<AudibleUtterance>,
+        reference:Option<WspApproachV2Reference>,
+    ) -> Result<(),ScaffoldContractError> {
+        let bad=||ScaffoldContractError::InvalidDecisionEvidence;
+        if self.wsp_approach_request.is_some() || self.wsp_approach_receipt.is_some()
+            || self.handles.len()!=1 || self.residents.len()!=1 || !self.handles.contains_key(&owner.raw())
+            || self.training_demonstrator.is_some() || self.training_sampling.is_none_or(|s|s.demonstrator.is_some())
+            || self.sensor_profile!=SensorProfile::GroundedTerrainVisionV1
+            || self.residents.get(&owner.raw()).is_none_or(|r|r.sleep_scheduler.state().phase!=SleepPhase::Awake) {
+            return Err(bad());
+        }
+        if self.world.audible_utterances().as_slice()!=atom.as_slice()
+            || atom.as_ref().is_some_and(|a|a.addressee!=Some(owner) || a.source_kind!=UtteranceSourceKind::Player
+                || a.speaker_id.is_some() || a.teacher_channel.is_some() || a.emitted_tick!=self.world.tick()
+                || a.emitted_tick.raw().checked_add(1)!=Some(a.expires_after_tick.raw())
+                || !(1..=2).contains(&a.tokens.len())) {
+            return Err(bad());
+        }
+        let world=self.world.canonical_signature_digest()?;
+        if reference.as_ref().is_some_and(|r|r.world_before!=world) || world.words==[0;4] { return Err(bad()); }
+        self.wsp_approach_request=Some(Request {owner,tick:self.world.tick(),world,atom,prototype:prot,reference});
+        Ok(())
+    }
+
+    pub(crate) fn take_wsp_approach_v2(
+        &mut self,
+    ) -> Option<(WspApproachV2Reference,WspApproachV2Receipt)> {
+        self.wsp_approach_receipt.take()
+    }
+
+    pub(super) fn prepare_wsp_approach_v2(
+        &mut self, batch:&[PreparedGpuBrainFrame],
+    ) -> Result<Option<(WspApproachV2Input,Request)>,ScaffoldContractError> {
+        let Some(r)=self.wsp_approach_request.take() else { return Ok(None); };
+        let bad=||ScaffoldContractError::InvalidDecisionEvidence;
+        let [item]=batch else { return Err(bad()); };
+        let f=&item.frame;
+        let tick=self.world.tick();
+        if f.organism_id()!=r.owner || f.tick()!=r.tick || tick!=r.tick || self.handles.get(&r.owner.raw())!=Some(&item.handle)
+            || r.reference.as_ref().is_some_and(|v|v.frame!=f.frame_digest())
+            || self.world.audible_utterances().as_slice()!=r.atom.as_slice() || self.world.player_held_object().is_some()
+            || self.world.object_snapshots().iter().any(|o|!o.consumed && o.carried_by==Some(r.owner)) {
+            return Err(bad());
+        }
+        let body=self.world.entity(item.world_entity_id).ok_or_else(bad)?;
+        let pbits=|p:alife_core::Vec3f|[p.x,p.y,p.z].map(f32::to_bits);
+        if body.organism_id!=Some(r.owner) || body.consumed || pbits(body.position)!=pbits(f.body().pose.translation)
+            || f.sensory().language_context.teacher_channel_marker.is_some() {
+            return Err(bad());
+        }
+        let heard=&f.sensory().language_context.heard_tokens;
+        let num=r.atom.as_ref().map_or(0,|a|a.tokens.len());
+        if heard[num..].iter().any(Option::is_some) { return Err(bad()); }
+        if let Some(atom)=&r.atom {
+            for (i,w) in atom.tokens.iter().enumerate() {
+                if !heard[i].as_ref().is_some_and(|h|h.utterance_id==atom.utterance_id
+                    && h.source_kind==UtteranceSourceKind::Player && h.addressee==Some(r.owner)
+                    && h.teacher_channel.is_none() && h.source_entity.is_none() && h.speaker_id.is_none()
+                    && usize::from(h.sequence_position)==i && h.token_id==u32::from(w.raw())
+                    && pbits(h.source_position)==pbits(atom.source_position)
+                    && h.confidence.raw().is_finite() && 0.0<h.confidence.raw() && h.confidence.raw()<=1.0) {
+                    return Err(bad());
+                }
+            }
+        }
+        let slots=f.grounded_object_slots(); let [_,_]=slots else {return Err(bad());};
+        let mut indexes=Vec::with_capacity(2);
+        let mut targets=Vec::with_capacity(2);
+        let mut tracks=Vec::with_capacity(2);
+        for (i,c) in f.candidates().iter().enumerate().filter(|(_,c)|c.action_id==HeadlessActionIds::APPROACH) {
+            if indexes.len()==2 || c.kind!=ActionKind::Move || c.family!=CandidateActionFamily::Approach {
+                return Err(bad());
+            }
+            let CandidateObservationRef::ObjectSlot(slot)=c.observation else {return Err(bad());};
+            let s=slots.iter().find(|w|w.slot_index==slot).ok_or_else(bad)?;
+            let target=c.target.entity.ok_or_else(bad)?;
+            let object=self.world.entity(target).ok_or_else(bad)?;
+            let track=self.world.tracked_objects().record(r.owner,s.tracked_object_id).ok_or_else(bad)?;
+            if targets.contains(&target) || tracks.contains(&s.tracked_object_id)
+                || object.consumed || object.carried_by.is_some() || object.organism_id.is_some() || object.activity_hold
+                || object.grounded_physical.velocity!=alife_core::Vec3f::ZERO || !c.target.position.is_some_and(|p|pbits(p)==pbits(object.position))
+                || track.tracking_key!=object.tracking_key || track.tracking_provenance!=object.tracking_provenance
+                || track.last_seen_tick!=tick || track.tracking_provenance.canonical_key()!=track.tracking_key
+                || self.world.retained_language_pilot_grab_probe(r.owner,target)!=(false,false)
+                || !(c.sensor_confidence.raw()>0.0 && c.sensor_confidence.raw().to_bits()==s.confidence.raw().to_bits())
+                || !c.features.0.iter().zip(s.candidate_features()?.0).all(|(a,b)|a.to_bits()==b.to_bits()) {
+                return Err(bad());
+            }
+            targets.push(target);tracks.push(s.tracked_object_id);indexes.push(i);
+        }
+        let indexes=<[usize;2]>::try_from(indexes).map_err(|_|bad())?;
+        let scope=WspApproachV2Input::seal(f,indexes,r.prototype,
+            r.reference.as_ref().map(|x|x.stock_post_context_u32.clone()))?;
+        Ok(Some((scope,r)))
+    }
+}
