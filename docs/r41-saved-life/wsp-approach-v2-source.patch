 use std::sync::Arc;
 
 pub(crate) const TRAINING_PAYLOAD_TAG: u32 = 0x8000_0000;
+
+#[cfg(feature = "wsp-approach-v2")]
+pub(crate) const WSP_APPROACH_WORDS: usize = 72;
+
+#[cfg(feature = "wsp-approach-v2")]
+#[derive(Debug, Clone)]
+pub struct WspApproachV2Input {
+    pub(crate) frame: PerceptionFrameDigest,
+    tick: u64,
+    role_edit: bool,
+    two_words: bool,
+    rails: [u32;16],
+    prototype: [u32;24],
+    offers: [[u32;9];2],
+    pub(crate) expected_stock: Option<Vec<u32>>,
+}
+
+#[cfg(feature = "wsp-approach-v2")]
+impl WspApproachV2Input {
+    /// Admission caller still must independently certify physical World/track/free-hand
+    /// authority; this validates the immutable native frame, not any motion outcome.
+    pub fn seal(frame: &PerceptionFrame, ascending_actual_offers: [usize;2], prototype: [u32;24],
+                expected_stock: Option<Vec<u32>>) -> Result<Self, ScaffoldContractError> {
+        use alife_core::{CandidateActionFamily, CandidateObservationRef, Validate};
+        let bad=||ScaffoldContractError::InvalidDecisionEvidence;
+        frame.validate()?;
+        let count=frame.candidates().len();
+        if count<2 || count>32 || ascending_actual_offers[0]>=ascending_actual_offers[1]
+            || prototype.iter().any(|x| f32::from_bits(*x).abs()!=1.0)
+            || expected_stock.as_ref().is_some_and(|x| x.len()!=count) {
+            return Err(bad());
+        }
+        let h=&frame.sensory().language_context.heard_tokens;
+        let two_words=matches!((h[0],h[1]),(Some(_),Some(_)));
+        if h[2..].iter().any(Option::is_some) || (h[0].is_none() && h[1].is_some()) {
+            return Err(bad());
+        }
+        let all_lanes=frame.sensory().language_prior_neural_lanes();
+        let rails=std::array::from_fn(|i|all_lanes[i].to_bits());
+        let mut offers=[[0u32;9];2];
+        let mut j=0;
+        for (i,c) in frame.candidates().iter().enumerate().filter(|(_,c)|c.action_id.raw()==101) {
+            if j>=2 || ascending_actual_offers[j]!=i || c.family!=CandidateActionFamily::Approach
+                || c.kind!=ActionKind::Move || i!=usize::from(c.candidate_index) {
+                return Err(bad());
+            }
+            let CandidateObservationRef::ObjectSlot(s)=c.observation else { return Err(bad()); };
+            if s>=16 { return Err(bad()); }
+            let f=c.features.0;
+            if !f[1].is_finite() || f[1].abs()>1.0 || f[9..15].iter().any(|v|!(0.0..=1.0).contains(v)) {
+                return Err(bad());
+            }
+            offers[j]=[i as u32,u32::from(s),f[1].to_bits(),f[9].to_bits(),f[10].to_bits(),f[11].to_bits(),
+                       f[12].to_bits(),f[13].to_bits(),f[14].to_bits()];
+            j+=1;
+        }
+        if j!=2 || offers[0][1]==offers[1][1] { return Err(bad()); }
+        let role_edit=expected_stock.is_some();
+        Ok(Self{frame:frame.frame_digest(),tick:frame.tick().raw(),role_edit,two_words,rails,prototype,offers,expected_stock})
+    }
+
+    pub(crate) fn payload(&self,count:u32,tick:u64,slot:u32,generation:u32,dispatch:u64)
+        -> Option<[u32;WSP_APPROACH_WORDS]> {
+        if tick!=self.tick || count<2 || count>32 || self.offers[1][0]>=count { return None; }
+        let mut p=[0u32;WSP_APPROACH_WORDS];
+        p[..11].copy_from_slice(&[0x32505357,1,u32::from(self.role_edit),count,tick as u32,(tick>>32) as u32,
+                                slot,generation,dispatch as u32,(dispatch>>32) as u32,u32::from(self.two_words)]);
+        p[11..27].copy_from_slice(&self.rails);
+        p[27..51].copy_from_slice(&self.prototype);
+        p[51..54].copy_from_slice(&[0x41000000,0x41800000,0xc1800000]);
+        p[54..63].copy_from_slice(&self.offers[0]); p[63..72].copy_from_slice(&self.offers[1]);
+        Some(p)
+    }
+
+    pub(crate) fn captures(&self,before:&[u32],after:&[u32]) -> Result<WspApproachV2Receipt,ScaffoldContractError> {
+        let bad=||ScaffoldContractError::InvalidDecisionEvidence;
+        if before.len()!=after.len() || before.len()<2 || before.len()>32
+            || self.expected_stock.as_deref().is_some_and(|x|x!=before) {
+            return Err(bad());
+        }
+        let mut changed=[false;2];
+        for (i,(a,b)) in before.iter().zip(after).enumerate() {
+            if a==b { continue; }
+            if !self.role_edit || !self.two_words || !f32::from_bits(*a).is_finite() || !f32::from_bits(*b).is_finite() {
+                return Err(bad());
+            }
+            let j=self.offers.iter().position(|x|x[0] as usize==i).ok_or_else(bad)?;
+            changed[j]=true;
+        }
+        // One effectful logit and one f32-rounded-to-stock is permissible, but
+        // the readback preserves both bits rather than inferring application.
+        Ok(WspApproachV2Receipt{treatment_requested:self.role_edit,two_native_words:self.two_words,
+            before_optional_u32:before.to_vec(),just_before_stock_sampler_u32:after.to_vec(),
+            verified_same_stock_reference:self.role_edit,changed_101:changed})
+    }
+}
