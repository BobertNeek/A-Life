+#[cfg(feature = "wsp-approach-v2")]
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct WspApproachV2Receipt {
+    pub treatment_requested: bool,
+    pub two_native_words: bool,
+    pub before_optional_u32: Vec<u32>,
+    pub just_before_stock_sampler_u32: Vec<u32>,
+    pub verified_same_stock_reference: bool,
+    pub changed_101: [bool;2],
+}
+
+#[cfg(all(test,feature = "wsp-approach-v2"))]
+#[test]
+fn wsp_approach_capture_rejects_wrong_stock_and_nonlocal_change() {
+    let x=WspApproachV2Input{frame:PerceptionFrameDigest([0;4]),tick:1,role_edit:true,two_words:true,
+        rails:[0;16],prototype:[0;24],offers:[[1;9],[3;9]],expected_stock:Some(vec![0;4])};
+    assert!(x.captures(&[0;4], &[0,1,0,1]).is_ok());
+    assert!(x.captures(&[0;4], &[1,0,0,0]).is_err());
+    assert!(x.captures(&[1,0,0,0], &[1,0,0,0]).is_err());
+    assert!(WspApproachV2Input{two_words:false,..x.clone()}.captures(&[0;4], &[0,1,0,0]).is_err());
+    assert!(WspApproachV2Input{role_edit:false,expected_stock:None,..x}.captures(&[0;4], &[0,1,0,0]).is_err());
+}
