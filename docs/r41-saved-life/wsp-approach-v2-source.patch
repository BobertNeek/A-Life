+const EXACT_CANDIDATE:&str="27cf133126051c9ff83c0a3d4270d195b133e55ccba23672866e20b33b2dfb65";
+const EXACT_CUE_PROTOTYPES:&str="488d8e0e3d551aae6d71657277d6698ee5fefbe64ea11bcae7f51cc92aa34d9c";
+
+#[derive(Clone,Copy,Debug,Serialize,Deserialize,PartialEq,Eq)]
+#[serde(rename_all="snake_case")]
+enum Arm { PresampleReference, ConditionalDelta }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope { schema:u16, scope:String, inner_sha256:String, admission_sha256:String }
+
+#[derive(Deserialize,Serialize,PartialEq,Eq)]
+#[serde(deny_unknown_fields)]
+struct Bind {
+    scope:String,
+    run_id:String,
+    arm:Arm,
+    source_current_sha256:String,
+    evaluator_sha256:String,
+    inner_sha256:String,
+    fixture_sha256:String,
+    rubric_sha256:String,
+    geometry_sha256:String,
+    candidate_sha256:String,
+    cue_prototype_sha256:String,
+    pressure_ns:u64,
+    expires_unix_seconds:u64,
+    max_decisions:u8,
+    max_world_ticks:u8,
+    scorecard_eligible:bool,
+    stock_retention_sha256:Option<String>,
+    stock_rows_sha256:Option<String>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Permit { schema:String, binding:Bind, independent_operator_grant_sha256:String }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Grant { schema:String, binding:Bind }
+
+#[derive(Serialize)]
+pub struct Scope {
+    binding:Bind,
+    approval_sha256:String,
+    #[serde(skip)] pub prototype:[u32;24],
+    #[serde(skip)] pub stock:Option<WspApproachV2Reference>,
+}
+
+impl Scope {
+    pub fn is_treatment(&self)->bool {self.binding.arm==Arm::ConditionalDelta}
+    pub fn label(&self)->&'static str {
+        if self.is_treatment() {"wsp_approach_v2_conditional_delta"} else {"wsp_approach_v2_presample_reference"}
+    }
+    pub fn still_live(&self)->Result<()> {
+        if super::super::now()? >= self.binding.expires_unix_seconds {
+            return Err("WSP Approach V2 operator envelope expired".into());
+        }
+        Ok(())
+    }
+    pub fn bind_inner(&self,identity:&Identity, run_id:&str, finalization:Option<u64>)->Result<()> {
+        let m=&self.binding;
+        if identity.phase!=Phase::WspApproachV2 || m.run_id!=run_id
+            || m.evaluator_sha256!=identity.evaluator_sha256 || m.fixture_sha256!=identity.fixture_sha256
+            || m.rubric_sha256!=identity.rubric_sha256 || Some(m.geometry_sha256.as_str())!=identity.geometry_proof_sha256.as_deref()
+            || identity.source_current_sha256!=EXACT_PARENT
+            || finalization.is_none_or(|t|t>m.expires_unix_seconds) {
+            return Err("WSP Approach V2 different nested geometry/clock authority".into());
+        }
+        Ok(())
+    }
+}
+
+fn hash_leaf(root:&Path,name:&str,pin:&str,limit:usize)->Result<Vec<u8>> {
+    let x=read_leaf(root,name,limit)?;
+    if !is_digest(pin) || digest(&x)!=pin {return Err("WSP Approach V2 exact local leaf mismatch".into());}
+    Ok(x)
+}
+
+pub fn resolve(root:&Path, bytes:&[u8])->Result<(Scope,Vec<u8>)> {
+    if bytes.len()>8192 { return Err("WSP Approach V2 envelope too large".into()); }
+    let m:Envelope=serde_json::from_slice(bytes)?;
+    if m.schema!=SCHEMA || m.scope!=SCOPE { return Err("unexpected WSP Approach V2 envelope".into()); }
+    let raw=hash_leaf(root,"wsp-approach-v2-admission.json",&m.admission_sha256,8192)?;
+    let v:Permit=serde_json::from_slice(&raw)?;
+    let g_raw=hash_leaf(root,"wsp-approach-v2-operator-grant.json",&v.independent_operator_grant_sha256,8192)?;
+    let g:Grant=serde_json::from_slice(&g_raw)?;
+    let b=&v.binding;
+    let now=super::super::now()?;
+    if v.schema!="qualia.saved_life.wsp_approach_v2_admission.v1"
+        || g.schema!="qualia.saved_life.wsp_approach_v2_operator_grant.v1" || g.binding!=v.binding
+        || b.scope!=SCOPE || b.source_current_sha256!=EXACT_PARENT || b.inner_sha256!=m.inner_sha256
+        || b.candidate_sha256!=EXACT_CANDIDATE || b.cue_prototype_sha256!=EXACT_CUE_PROTOTYPES
+        || b.scorecard_eligible || b.pressure_ns!=0 || b.max_decisions!=1 || b.max_world_ticks!=1
+        || b.expires_unix_seconds<=now || b.expires_unix_seconds>now.saturating_add(600)
+        || ![&b.evaluator_sha256,&b.fixture_sha256,&b.rubric_sha256,&b.geometry_sha256].iter().all(|x|is_digest(x))
+        || b.run_id.is_empty() || b.run_id.len()>64 {
+        return Err("WSP Approach V2 scope/identity/expiry mismatch".into());
+    }
+    let inner=hash_leaf(root,"wsp-approach-v2-inner.schema6.json",&b.inner_sha256,8192)?;
+    let _candidate=hash_leaf(root,"wsp-approach-v2-weight-delta.json",EXACT_CANDIDATE,32768)?;
+    let p=hash_leaf(root,"wsp-approach-v2-existing-lexical-prototypes.json",EXACT_CUE_PROTOTYPES,8192)?;
+    let p:Value=serde_json::from_slice(&p)?;
+    let words:[[u32;8];3]=serde_json::from_value(p["prototype_f32_bits_3x8"].clone())?;
+    let prototype=std::array::from_fn(|i| words[i/8][i%8]);
+    let stock=match (b.arm,b.stock_retention_sha256.as_deref(),b.stock_rows_sha256.as_deref()) {
+        (Arm::PresampleReference,None,None)=>None,
+        (Arm::ConditionalDelta,Some(ret),Some(rows))=>{
+            let r:Value=serde_json::from_slice(&hash_leaf(root,"wsp-approach-v2-native-stock-retention.json",ret,4*1024*1024)?)?;
+            let raw=hash_leaf(root,"wsp-approach-v2-native-stock-rows.jsonl",rows,512*1024)?;
+            let mut lines=raw.split(|x|*x==b'\n');
+            let line=lines.next().filter(|s|!s.is_empty()).ok_or("no stock reference row")?;
+            if lines.any(|s|!s.is_empty()) {return Err("WSP stock reference was not one decision".into());}
+            let row:Value=serde_json::from_slice(line)?;
+            if r["status"]!="finished" || !r["error"].is_null()
+                || r["rows_sha256"]!=rows || r["source_sha256"]!=EXACT_PARENT || r["captured_decisions"]!=1
+                || r["control_calls"]!=1 || r["world_ticks"]!=1 || r["source_unchanged"]!=true
+                || r["saved_policy_base_unchanged"]!=true || r["software_simulation"]!=true
+                || r["wsp_approach_v2_integrity"]!=true || r["scorecard_eligible"]==true
+                || r["retained_experiment"]["scorecard_eligible"]!=false
+                || r["retained_experiment"]["identity"]["schema"]!=SCHEMA
+                || r["retained_experiment"]["identity"]["intervention"]!="wsp_approach_v2_presample_reference"
+                || r["retained_experiment"]["identity"]["wsp_approach_v2"]["binding"]["arm"]!="presample_reference"
+                || r["retained_experiment"]["identity"]["wsp_approach_v2"]["binding"]["inner_sha256"]!=b.inner_sha256
+                || r["retained_experiment"]["identity"]["wsp_approach_v2"]["binding"]["evaluator_sha256"]!=b.evaluator_sha256
+                || r["wsp_approach_v2_opening_receipt"]!=row["wsp_approach_v2_opening_receipt"]
+                || row["wsp_approach_v2_opening_receipt"]["presample"]["treatment_requested"]!=false
+                || row["wsp_approach_v2_opening_receipt"]["presample"]["changed_101"]!=json!([false,false])
+                || row["wsp_approach_v2_opening_receipt"]["presample"]["before_optional_u32"]!=
+                   row["wsp_approach_v2_opening_receipt"]["presample"]["just_before_stock_sampler_u32"] {
+                return Err("WSP Approach V2 exact true stock mate is absent or effectful".into());
+            }
+            let reference:WspApproachV2Reference=serde_json::from_value(row["wsp_approach_v2_opening_receipt"]["reference"].clone())?;
+            if row["frame_digest"]!=serde_json::to_value(reference.frame)?
+                || row["wsp_approach_v2_opening_receipt"]["presample"]["before_optional_u32"]!=
+                   serde_json::to_value(&reference.stock_post_context_u32)? { return Err("WSP captured stock words not bound to same frame".into()); }
+            Some(reference)
+        }
+        _=>return Err("WSP Approach V2 arm cannot borrow a different authority".into()),
+    };
+    Ok((Scope{binding:v.binding,approval_sha256:m.admission_sha256,prototype,stock},inner))
+}
