+        d.ticks_remaining=d.ticks_remaining.saturating_sub(1);
+        d.last_receipt=Some(NativeArmedReceipt{decision:step.frame.tick(),after:outcome.outcome_tick,frame:step.frame.frame_digest(),
+            true_complete_heard:c.had_actual_heard_pair,original_graded_lexical_f32_bits:c.original_graded_lexical_f32_bits,
+            true_active_atom_dropout:c.authenticated_active_dropout,
+            carried_target:if matches!(c.readout,Readout::Carry{..}){c.chosen.map(|z|z.physical_target)}else{None},
+            submitted_armed_payload:submitted,genuine_paid_same_target_pickup:earned,
+            genuinely_observed_referent:c.chosen.map(|z|z.physical_target),world_rows:c.world.rows,presample});
+    }
+
+    pub(crate) fn take_wsp_armed_receipt(&mut self)->Option<NativeArmedReceipt>{
+        self.wsp_armed.as_mut()?.last_receipt.take()
+    }
