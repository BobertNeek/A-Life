+//! Detached two-cell direct WeightCode. Only opaque witnesses produced by the
+//! signed World/runtime adapter may enter; this module never chooses an action.
+//! OFF omits the adapter and preserves byte-identical stock sampler inputs.
+
+pub(super) const WEIGHT_WORDS: [u32; 4] = [1050673152, 1042284544, 1050673152, 1042284544];
+const ONE_CUT_UNIT_NORM: f32 = f32::from_bits(1039384091);
+const LEFT_WEIGHT: usize = 0;
+const RIGHT_WEIGHT: usize = 2;
+
+/// The arm is digest/role-bound at admission, immutable through the run. Both
+/// process independent cohorts have unchanged immediate cue readout.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(super) enum Phase { ImmediateControl, ArmedRetention }
+
+/// Native identity and generation are verified by the producer. Tick is a
+/// genuine World cut, never a behavior-feature or a cue fabricated from time.
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(super) struct Stamp {
+    pub(super) tick: u64,
+    pub(super) owner: u64,
+    pub(super) runtime_generation: u64,
+    pub(super) frame: [u64; 4],
+    pub(super) world: [u64; 4],
+}
+
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(super) struct Atom {
+    pub(super) id: u64,
+    pub(super) birth: u64,
+    pub(super) expires: u64,
+    pub(super) acoustic_digest: [u64; 4], // exact source/addressee/ordered packet/spawn
+}
+
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(super) struct Track {
+    pub(super) track: u64,
+    pub(super) spawn: [u64; 2],
+    pub(super) target: u64,
+}
+
+/// These values are constructed by a single authoritative pre-dispatch
+/// World+PerceptionFrame adapter, NOT from a manifest or logical label.
+#[derive(Debug, Copy, Clone)]
+pub(super) enum Evidence {
+    /// Exact complete same-current-atom signed rails and uniquely winning live visual feature.
+    Heard { atom: Atom, target: Track, signed: f32 },
+    /// The *same actual live atom* still exists. Renderer produced all empty
+    /// heard rows for this same frame and rebound the still-visible target.
+    /// No alternate track can inherit the old state.
+    NativeDropout { atom: Atom, target: Track },
+    /// No authorizable cue: acoustic absence / ambiguity / conflicting tracks /
+    /// non-free or invalid state / stale provenance. Never writes a logit.
+    Reset,
+}
+
+#[derive(Debug, Copy, Clone, PartialEq)]
+pub(super) enum Readout {
+    NoTransfer,
+    /// Existing immediate qualified path, not any special new injector.
+    Immediate,
+    /// Separate signed experimental retention bit; never written into actual HeardTokens.
+    Carry { target: Track, signed: f32 },
+}
+
+#[derive(Debug, Copy, Clone, PartialEq, Eq)]
+pub(super) enum Settlement {
+    /// Full successful same-stamp outcome; ordinary no-acquisition continuation.
+    Empty,
+    /// Real paid 211 plus completed world grip transfer for this exact target.
+    PaidAcquired(Track),
+    /// Actual own hand occupied by a different / unproven target.
+    OtherOccupancy,
+}
+
+#[derive(Debug, Copy, Clone)]
+struct Live { atom: Atom, target: Track, q: [f32; 2] }
+
+/// Only one staged signed native frame may remain pending. No learned state is
+/// published until true settled same-cut outcome; exceptions fail disarmed.
+#[derive(Debug, Copy, Clone)]
+struct Plan { stamp: Stamp, next: Option<Live>, retire: Option<Atom>, readout: Readout }
+
+#[derive(Debug)]
+pub(super) struct ArmedCueLatch {
+    phase: Phase,
+    who: (u64,u64),
+    previous: Option<u64>,
+    live: Option<Live>,
+    retired: Option<Atom>,
+    pending: Option<Plan>,
+    fault: bool,
+}
+
+fn valid_atom(a: Atom, t: u64) -> bool {
+    a.id != 0 && a.acoustic_digest != [0;4] && a.birth <= t && t <= a.expires
+        && a.expires.checked_sub(a.birth).is_some_and(|d|d<=1)
+}
+fn valid_track(t: Track) -> bool { t.track != 0 && t.spawn != [0;2] && t.target != 0 }
+
+fn advance(q: [f32;2], drive: f32) -> [f32;2] {
+    let u=[(-drive).max(0.0),drive.max(0.0)];
+    let mut cells=q;
+    for _ in 0..4 {
+        for (i,w) in [LEFT_WEIGHT,RIGHT_WEIGHT].into_iter().enumerate() {
+            let recurrent=f32::from_bits(WEIGHT_WORDS[w])*cells[i];
+            let entry=f32::from_bits(WEIGHT_WORDS[w+1])*u[i];
+            cells[i]=0.75*cells[i]+0.25*(recurrent+entry).tanh();
+        }
+    }
+    cells
+}
+
+impl ArmedCueLatch {
+    pub(super) fn new(phase: Phase, owner: u64, runtime_generation: u64) -> Option<Self> {
+        if owner==0 || runtime_generation==0 {return None;}
+        Some(Self {phase,who:(owner,runtime_generation),previous:None,live:None,
+                  retired:None,pending:None,fault:false})
+    }
+
+    /// Begin once, before actual signed sampler. None denotes a failed scope,
+    /// whereas NoTransfer is true stock-isomorphic dispatch for a valid scope.
+    pub(super) fn prepare(&mut self, stamp: Stamp, valid_empty_hand: bool, e: Evidence) -> Option<Readout> {
+        if self.fault || self.pending.is_some() || self.who!=(stamp.owner,stamp.runtime_generation)
+           || stamp.frame==[0;4] || stamp.world==[0;4]
+           || self.previous.is_some_and(|p|p.checked_add(1)!=Some(stamp.tick)) {
+            self.abort();return None;
+        }
+        let old=self.live;
+        let mut plan=Plan {stamp,next:None,retire:old.map(|x|x.atom),readout:Readout::NoTransfer};
+        if valid_empty_hand {
+            let scope=match e {
+                Evidence::Heard{atom,target,signed} if signed.is_finite() && signed!=0.0 && signed.abs()<=1.0 =>
+                    Some((atom,target,signed)),
+                Evidence::NativeDropout{atom,target} if old.is_some() => Some((atom,target,0.0)),
+                _=>None,
+            };
+            if let Some((atom,target,signed))=scope {
+                // Another utterance or referent cannot inherit old state. It
+                // starts from zero only if no prior state remained and its real
+                // signed pair was newly heard on this very cut.
+                let custody_bound=old.is_none_or(|x|x.atom==atom && x.target==target);
+                let new_only_current=old.is_some() || (signed!=0.0 && atom.birth==stamp.tick);
+                let opponent_unchanged=old.is_none_or(|x| signed==0.0 || (x.q[1]-x.q[0]).signum()==signed.signum());
+                if valid_atom(atom,stamp.tick) && valid_track(target) && custody_bound
+                   && new_only_current && opponent_unchanged && self.retired!=Some(atom) {
+                    // Discretize only the already-proved positive-confidence
+                    // complete native lexical event, not Sound or stored words.
+                    // NoTransfer on unavailable, rejected or unknown event.
+                    let input=if signed==0.0 {0.0}else{signed.signum()};
+                    let q=advance(old.map_or([0.0;2],|x|x.q),input);
+                    let carry=((q[1]-q[0])/ONE_CUT_UNIT_NORM).clamp(-1.0,1.0);
+                    if carry.is_finite() && carry!=0.0 {
+                        plan.next=Some(Live{atom,target,q});
+                        plan.retire=None;
+                        if signed!=0.0 { plan.readout=Readout::Immediate; }
+                        else if self.phase==Phase::ArmedRetention {
+                            plan.readout=Readout::Carry{target,signed:carry};
+                        }
+                    }
+                }
+            }
+        }
+        self.pending=Some(plan);
+        Some(plan.readout)
+    }
+
+    pub(super) fn bound(&self) -> Option<(Track,f32,Atom)> {
+        let v=self.live?;
+        (!self.fault).then_some((v.target,v.q[1]-v.q[0],v.atom))
+    }
+
+    /// Step's authenticated paid/custody adapter calls once after World
+    /// transaction. Return Some(true) only for actually earned same-target pickup.
+    pub(super) fn commit(&mut self, stamp: Stamp, outcome_tick: u64, settled: Settlement) -> Option<bool> {
+        if self.fault {return None;}
+        let Some(plan)=self.pending.take() else {self.abort();return None;};
+        if plan.stamp!=stamp || stamp.tick.checked_add(1)!=Some(outcome_tick) {
+            self.abort();return None;
+        }
+        let earned=matches!((plan.next,settled),
+            (Some(x),Settlement::PaidAcquired(track)) if x.target==track);
+        self.previous=Some(stamp.tick);
+        self.retired=self.retired.filter(|x|x.expires>=stamp.tick);
+        if let Some(a)=plan.retire {self.retired=Some(a);}
+        if settled!=Settlement::Empty {
+            if let Some(x)=plan.next {self.retired=Some(x.atom);}
+            self.live=None;
+        } else {
+            self.live=plan.next;
+        }
+        Some(earned)
+    }
+
+    pub(super) fn abort(&mut self) {
+        self.pending=None;
+        self.live=None;
+        self.retired=None;
+        self.fault=true;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    const ATOM:Atom=Atom{id:19,birth:7,expires:8,acoustic_digest:[1,2,3,4]};
+    const TRACK:Track=Track{track:21,spawn:[5,4],target:18};
+    fn cut(t:u64)->Stamp{Stamp{tick:t,owner:3,runtime_generation:37,frame:[1,1,2,1],world:[2,2,3,2]}}
+    fn start(phase:Phase)->ArmedCueLatch {
+        let mut s=ArmedCueLatch::new(phase,3,37).unwrap();
+        let e=Evidence::Heard{atom:ATOM,target:TRACK,signed:0.75};
+        assert_eq!(s.prepare(cut(7),true,e),Some(Readout::Immediate));
+        assert!(s.live.is_none(), "cannot publish prior to actual settlement");
+        assert_eq!(s.commit(cut(7),8,Settlement::Empty),Some(false));
+        s
+    }
+    #[test]
+    fn genuine_dropout_is_only_treatment_then_true_silence() {
+        let mut a=start(Phase::ImmediateControl);
+        let mut b=start(Phase::ArmedRetention);
+        let e=Evidence::NativeDropout{atom:ATOM,target:TRACK};
+        assert_eq!(a.prepare(cut(8),true,e),Some(Readout::NoTransfer));
+        assert!(matches!(b.prepare(cut(8),true,e),Some(Readout::Carry{target:TRACK,signed}) if 0.0<signed&&signed<=1.0));
+        assert_eq!(a.commit(cut(8),9,Settlement::Empty),Some(false));
+        assert_eq!(b.commit(cut(8),9,Settlement::PaidAcquired(TRACK)),Some(true));
+        assert_eq!(b.prepare(cut(9),true,e),Some(Readout::NoTransfer));
+        assert_eq!(a.prepare(cut(9),true,Evidence::Reset),Some(Readout::NoTransfer));
+    }
+    #[test]
+    fn wrong_or_duplicate_binding_does_not_transmit() {
+        let mut x=start(Phase::ArmedRetention);
+        let other=Track{spawn:[4,5],..TRACK};
+        assert_eq!(x.prepare(cut(8),true,Evidence::NativeDropout{atom:ATOM,target:other}),Some(Readout::NoTransfer));
+        assert_eq!(x.prepare(cut(8),true,Evidence::NativeDropout{atom:ATOM,target:TRACK}),None);
+        assert_eq!(x.commit(cut(8),9,Settlement::Empty),None);
+    }
+    #[test]
+    fn only_paid_same_target_earns_reset() {
+        let mut x=start(Phase::ArmedRetention);
+        assert!(matches!(x.prepare(cut(8),true,Evidence::NativeDropout{atom:ATOM,target:TRACK}),
+            Some(Readout::Carry{..})));
+        assert_eq!(x.commit(cut(8),9,Settlement::OtherOccupancy),Some(false));
+        assert!(x.live.is_none());
+    }
+}
