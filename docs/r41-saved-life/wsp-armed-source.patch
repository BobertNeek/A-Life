+    let wp:Value=serde_json::from_slice(&wp)?;
+    if wp["schema"]!="qualia.private.wsp_cue_latch_armed.weightcode.v1"
+        || wp["exact_R44_current_sha256"]!=CURRENT || wp["f32_bits"]!=json!(WORDS)
+        || wp["modified_inherited_words"]!=0 || wp["global_recurrence_multiplier"]!=json!(1.0)
+        {return Err("armed latch packet is not exact fixed direct weights".into());}
+    let l:Lexical=serde_json::from_slice(&lex)?;
+    if l.schema!="qualia.experimental.contact_lexical_rank1.weights.v1" || l.source_current_sha256!=CURRENT
+       || l.source_actor_plane_sha256!="292dd9a7a26816e603e1d331d1c2715194442b2770b65c6ca4e2152f78a20bf3"
+       || !l.train_free || !hex(&l.vocabulary_source_sha256)||l.convention.is_empty()
+       {return Err("armed latch original lexical readout lineage differs".into());}
+    let mut w=[0;32];
+    for (i,q) in l.prototype_f32_bits_3x8.into_iter().enumerate(){w[i*8..i*8+8].copy_from_slice(&q);}
