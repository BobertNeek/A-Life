+//! Isolated signed same-executable causal trial. No old admission accepts this.
+use super::{digest, now, Result};
+use crate::gpu_live_runtime::{FoundationTrainingStep, GpuLiveBrainRuntime};
+use alife_core::OrganismId;
+use serde::{Deserialize,Serialize};
+use serde_json::{json,Value};
+use std::{fs,io::Read,path::Path};
+
+pub(super) const SCHEMA:u16=13;
+pub(super) const LIMIT:usize=3;
+const CURRENT:&str="55672f322eadc64e223289d9df9883f62d0cc01aa97c0478119ad6c51d2852ee";
+const LEXICAL:&str="488d8e0e3d551aae6d71657277d6698ee5fefbe64ea11bcae7f51cc92aa34d9c";
+const WEIGHTCODE:&str="460521877d9828fe9169e47c81dd3c7972957a98292dd499b4712077bac9483e";
+const WORDS:[u32;4]=[1050673152,1042284544,1050673152,1042284544];
+const NAME:&str="qualia.saved_life.wsp_cue_latch_armed.v1";
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq,Serialize,Deserialize)]
+#[serde(rename_all="snake_case")]
+enum Role { Instantaneous, Armed }
+#[derive(Clone,Copy,Debug,PartialEq,Eq,Serialize,Deserialize)]
+#[serde(rename_all="snake_case")]
+enum Geometry { OriginalContact, AcousticAndReachEdge }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Outer {schema:u16,scope:String,language_sha256:String,admission_sha256:String}
+
+#[derive(Debug,PartialEq,Eq,Serialize,Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    scope:String, trial:String, role:Role, geometry:Geometry,
+    current_sha256:String, evaluator_sha256:String, language_sha256:String,
+    old_lexical_sha256:String, recurrent_weightcode_sha256:String,
+    output_max_decisions:u8, output_max_ticks:u8,
+    controlled_gpu_ns:u64, expires_unix_seconds:u64,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Admission {schema:String,binding:Binding,independent_grant_sha256:String}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Grant {schema:String,binding:Binding}
+
+#[derive(Serialize)]
+pub(super) struct Scope {
+    schema:&'static str,binding:Binding,admission_sha256:String,
+    #[serde(skip)] lexical:[u32;32],
+}
+fn hex(v:&str)->bool {v.len()==64 && v.bytes().all(|i|matches!(i,b'0'..=b'9'|b'a'..=b'f'))}
+fn read(f:&Path,max:u64)->Result<Vec<u8>>{
+    let file=fs::File::open(f)?;
+    let mut b=Vec::new();
+    file.take(max+1).read_to_end(&mut b)?;
+    if b.is_empty() || b.len() as u64>max {return Err("armed latch leaf exceeds limit".into());}
+    Ok(b)
+}
+fn leaf(root:&Path,n:&str)->Result<Vec<u8>>{
+    let f=root.join(n);
+    if f.canonicalize()?!=f || !fs::symlink_metadata(&f)?.is_file() {return Err("armed latch noncanonical leaf".into());}
+    read(&f,16384)
+}
+fn no_leaf(root:&Path,n:&str)->Result<()>{
+    match fs::symlink_metadata(root.join(n)){
+        Err(e) if e.kind()==std::io::ErrorKind::NotFound=>Ok(()),
+        _=>Err("armed latch cannot coexist with an unrelated authorization or treatment packet".into()),
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Lexical {
+    schema:String, source_current_sha256:String, source_actor_plane_sha256:String, train_free:bool,
+    vocabulary_source_sha256:String, convention:String, prototype_f32_bits_3x8:[[u32;8];3],
+    candidate_actual_f9_14_f32_bits:[u32;6], bounded_gain_and_ambiguity_f32_bits:[u32;2],
+}
+
+pub(super) fn resolve(root:&Path,raw:&[u8])->Result<(Scope,Vec<u8>)>{
+    if raw.len()>16384{return Err("armed latch outer bytes exceed limit".into());}
+    let p:Outer=serde_json::from_slice(raw)?;
+    if p.schema!=SCHEMA || p.scope!=NAME||!hex(&p.admission_sha256)||!hex(&p.language_sha256){
+        return Err("armed latch scope/envelope mismatch".into());
+    }
+    let a_raw=leaf(root,"wsp-armed-admission.v1.json")?;
+    if digest(&a_raw)!=p.admission_sha256{return Err("armed latch admission identity mismatch".into());}
+    let a:Admission=serde_json::from_slice(&a_raw)?;
+    let v=a.binding;
+    let t=now()?;
+    if a.schema!="qualia.saved_life.wsp_cue_latch_armed.admission.v1"
+       || !hex(&a.independent_grant_sha256) || v.scope!=NAME || v.trial.is_empty() || v.trial.len()>64
+       || !v.trial.bytes().all(|b|b.is_ascii_alphanumeric() || matches!(b,b'_'|b'-')) || v.current_sha256!=CURRENT
+       || !hex(&v.evaluator_sha256) || v.language_sha256!=p.language_sha256
+       || v.old_lexical_sha256!=LEXICAL || v.recurrent_weightcode_sha256!=WEIGHTCODE
+       || v.output_max_decisions!=LIMIT as u8 || v.output_max_ticks!=LIMIT as u8 || v.controlled_gpu_ns!=0
+       || v.expires_unix_seconds<=t || v.expires_unix_seconds>t.saturating_add(600)
+    {return Err("armed latch exact run/current/policy/scope/expiry is not admitted".into());}
+    let g=leaf(root,"wsp-armed-independent-grant.v1.json")?;
+    if digest(&g)!=a.independent_grant_sha256{return Err("armed latch independent grant digest mismatch".into());}
+    let g:Grant=serde_json::from_slice(&g)?;
+    if g.schema!="qualia.saved_life.wsp_cue_latch_armed.independent_grant.v1"||g.binding!=v
+       {return Err("armed latch operator granted a different trial/authority".into());}
+    for name in ["cue-latch-admission.v1.json","contact211-f0-admission.v1.json",
+       "contact211-rank32.weights.v1.json","contact211-stock-reference.v1.json"] {no_leaf(root,name)?;}
+    let exe=std::env::current_exe()?;
+    if digest(&read(&exe,256*1024*1024)?)!=v.evaluator_sha256{return Err("armed latch executing ELF differs".into());}
+    let inner=leaf(root,"wsp-armed-language-cell.schema5.json")?;
+    let lex=leaf(root,"wsp-armed-existing-lexical.v1.json")?;
+    let wp=leaf(root,"wsp-armed-direct-weightcode.v1.json")?;
+    if digest(&inner)!=v.language_sha256 || digest(&lex)!=LEXICAL || digest(&wp)!=WEIGHTCODE
