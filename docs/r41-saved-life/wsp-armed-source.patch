+            "physical_target_audit_only":b.physical_target.raw(),"actual_pre_world_free_legal":b.free_legal_before_motion,
+            "actual_logit_bits_before_sampler":w.stock_f32_bits,
+            "actual_representative":w.projected_representative,
+            "actual_hand":w.independently_projected_hand,
+            "representative_forces_hand":w.representative_can_force_hand,
+        })).collect::<Vec<_>>();
+        Ok(json!({
+            "schema":1,"scope":NAME,"decision_tick":q.decision,"outcome_tick":q.after,
+            "frame":q.frame,"world_signature":q.presample.world_signature_words,
+            "dispatch_generation":q.presample.dispatch_generation,"weight_generation":q.presample.weight_generation,
+            "current_true_complete_cue":q.true_complete_heard,
