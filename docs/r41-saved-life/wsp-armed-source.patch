+//! Fresh-contact protocol driver; constructed by a separately authorized
+//! research evaluator, never by schema8/9/11 or an ordinary World dispatch.
+use super::*;
+use alife_core::{MotorChannel, PerceptionFrameDigest};
+use alife_gpu_backend::training_rollout::{Contact211PresampleAdmission, Contact211PresampleReport,
+    Contact211Rank32Input, GpuTrainingStateSnapshot};
+use alife_world::{ActionPhase, Contact211WorldRow, Contact211WorldWitness, CueLatchTrackWitness, GripTransferKind,
+    HeadlessActionIds};
+use sha2::{Digest,Sha256};
+use super::cue_latch_observer::verify_atom;
+use super::wsp_armed_latch::{ArmedCueLatch, Atom, Evidence, Phase, Readout, Settlement, Stamp, Track};
+
+const CURRENT:&str="55672f322eadc64e223289d9df9883f62d0cc01aa97c0478119ad6c51d2852ee";
+const LEXICAL_WORDS:&str="3bfb032d8b445caccecbc3a1400935cee21e471c2e333216125f172c4449e1f6";
+
+#[derive(Debug)]
+struct Cut {
+    stamp: Stamp,
+    world: Contact211WorldWitness,
+    readout: Readout,
+    expected_pre_life_handle: GpuBrainHandle,
+    chosen: Option<CueLatchTrackWitness>,
+    had_actual_heard_pair: bool,
+    original_graded_lexical_f32_bits: u32,
+    authenticated_active_dropout: bool,
+    native_dispatch: Option<(u64,u32,bool,Contact211PresampleReport)>,
+}
+#[derive(Debug)]
+pub(super) struct Driver {
+    owner: OrganismId,
+    handle: GpuBrainHandle,
+    core: ArmedCueLatch,
+    words: [u32;32],
+    lexical: [f32;32],
+    ticks_remaining: u8,
+    armed_prepared: Option<Cut>,
+    last_receipt: Option<NativeArmedReceipt>,
+    terminal: bool,
+}
+#[derive(Debug)]
+pub(crate) struct NativeArmedReceipt {
+    pub(crate) decision: Tick,
+    pub(crate) after: Tick,
+    pub(crate) frame: PerceptionFrameDigest,
+    pub(crate) true_complete_heard: bool,
+    pub(crate) original_graded_lexical_f32_bits: u32,
+    pub(crate) true_active_atom_dropout: bool,
+    pub(crate) carried_target: Option<WorldEntityId>,
+    pub(crate) genuinely_observed_referent: Option<WorldEntityId>,
+    pub(crate) world_rows: Vec<Contact211WorldRow>,
+    pub(crate) submitted_armed_payload: bool,
+    pub(crate) genuine_paid_same_target_pickup: bool,
+    pub(crate) presample: Contact211PresampleReport,
+}
+
+fn bad() -> ScaffoldContractError { ScaffoldContractError::InvalidDecisionEvidence }
+fn track(t:CueLatchTrackWitness) -> Track {
+    Track{track:t.observed_track.raw(),spawn:t.physical_spawn_key.0,target:t.physical_target.raw()}
+}
+
+fn visual_referent(rows:&[CueLatchTrackWitness], lexical:&[f32;32], s:f32) -> Option<CueLatchTrackWitness> {
+    if !s.is_finite() || s==0.0 || !(2..=32).contains(&rows.len()){return None;}
+    let band=lexical[31];
+    let mut winner=None;
+    let mut runnerup=f32::NEG_INFINITY;
+    for &r in rows {
+        let mut score=0.0_f32;
+        for (j,b) in r.appearance_bits.into_iter().enumerate() {
+            let x=f32::from_bits(b);
+            if !(0.0..=1.0).contains(&x) {return None;}
+            score+=x*lexical[24+j];
+        }
+        let score=score*s.signum();
+        if winner.is_none_or(|(v,_):(f32,CueLatchTrackWitness)|score>v) {
+            if let Some((v,_))=winner {runnerup=runnerup.max(v);}
+            winner=Some((score,r));
+        } else {runnerup=runnerup.max(score);}
+    }
+    let (value,r)=winner?;
+    (value>=band && value-runnerup>=band && r.current_target_free && r.stock_approach_offered).then_some(r)
+}
+
+fn checked_actual_presample_delta(p:&Contact211PresampleReport,w:&Contact211WorldWitness,submitted:bool)->bool {
+    if p.rows.len()!=w.rows.len() || !p.rows.iter().zip(&w.rows).all(|(g,o)|
+        g.candidate_index==o.candidate_index && g.observed_f9_14_bits==o.appearance_f9_14_bits) {return false;}
+    let Some((before,after))=&p.true_after_context_before_treatment_and_before_sampler else {
+        return !submitted;
+    };
+    if !submitted || before.len()!=after.len() || before.len()!=usize::from(w.sealed_candidate_count) {return false;}
+    let changes=before.iter().zip(after).enumerate().filter(|(_, (a,b))|a!=b).collect::<Vec<_>>();
+    changes.len()<=2 && changes.into_iter().all(|(i,(&a,&b))|
+       f32::from_bits(a).is_finite() && f32::from_bits(b).is_finite() &&
+       p.rows.iter().zip(&w.rows).any(|(g,o)|usize::from(g.candidate_index)==i
+         && o.free_legal_before_motion && g.stock_f32_bits==b
+         && (g.independently_projected_hand || g.representative_can_force_hand)))
+}
+
+fn opaque_atom(a:super::cue_latch_observer::Atom, owner:OrganismId) -> Atom {
+    let mut b=Vec::new();
+    b.extend(a.id.to_le_bytes());
+    b.extend(a.emitted.raw().to_le_bytes());
+    b.extend(a.expires.raw().to_le_bytes());
+    b.extend(owner.raw().to_le_bytes());
+    for u in a.position_bits.into_iter().chain(a.words) {b.extend(u.to_le_bytes());}
+    let digest=Sha256::digest(&b);
+    Atom{id:a.id,birth:a.emitted.raw(),expires:a.expires.raw(),
+        acoustic_digest:std::array::from_fn(|i|u64::from_le_bytes(digest[i*8..i*8+8].try_into().expect("32 digest bytes")))}
+}
+
+impl GpuLiveBrainRuntime {
+    /// Source-integration seam only. A future sealed *different* evaluator
+    /// profile owns actual independent authorization, never a command flag.
+    pub(crate) fn begin_wsp_armed_checked(
+        &mut self, owner: OrganismId, verified_current:&str, phase_is_armed:bool,
+        old_lexical:[u32;32], explicit_weightcode:[u32;4], len:u8,
+    ) -> Result<(),ScaffoldContractError> {
+        let handle=*self.handles.get(&owner.raw()).ok_or_else(bad)?;
+        let word_sha=format!("{:x}",Sha256::digest(old_lexical.iter().flat_map(|w|w.to_le_bytes()).collect::<Vec<_>>()));
+        if verified_current!=CURRENT || word_sha!=LEXICAL_WORDS
+            || explicit_weightcode!=super::wsp_armed_latch::WEIGHT_WORDS
+            || self.wsp_armed.is_some() || self.cue_latch_observer.is_some() || self.contact211_request.is_some()
+            || self.handles.len()!=1 || self.residents.len()!=1
+            || self.residents.get(&owner.raw()).is_none_or(|r|r.sleep_scheduler.state().phase!=SleepPhase::Awake)
+            || self.training_sampling.is_none_or(|x|x.demonstrator.is_some())
+            || self.training_demonstrator.is_some() || self.sensor_profile!=SensorProfile::GroundedTerrainVisionV1
+            || len!=3
+        {return Err(bad());}
+        // Full handle (includes backend instance) is checked below on every cut.
+        let phase=if phase_is_armed {Phase::ArmedRetention}else{Phase::ImmediateControl};
+        let core=ArmedCueLatch::new(phase,owner.raw(),u64::from(handle.generation())).ok_or_else(bad)?;
+        self.wsp_armed=Some(Driver{owner,handle,core,words:old_lexical,lexical:old_lexical.map(f32::from_bits),
+            ticks_remaining:len,armed_prepared:None,last_receipt:None,terminal:false});
+        Ok(())
+    }
+
+    pub(super) fn capture_wsp_armed(
+        &mut self, frame:&PerceptionFrame, binding:Option<&alife_world::GroundedCandidateBinding>,
+        handle:GpuBrainHandle,
+    ) -> Result<(),ScaffoldContractError> {
+        let Some(d)=self.wsp_armed.as_mut() else {return Ok(());};
+        if d.terminal || d.ticks_remaining==0 || d.armed_prepared.is_some()
+            || handle!=d.handle || frame.organism_id()!=d.owner || self.contact211_request.is_some()
+        {return Err(bad());}
+        let binding=binding.ok_or_else(bad)?;
+        let w=self.world.cue_latch_world_witness(frame,binding)?;
+        let contact=self.world.contact211_world_witness(frame,binding)?;
+        if contact.decision_tick!=w.tick || contact.organism!=w.organism
+            || contact.frame_digest!=w.frame_digest || contact.current_world_signature!=w.world_signature
+            || contact.hand_actually_empty!=w.hand_empty {return Err(bad());}
+        let stamp=Stamp{tick:w.tick.raw(),owner:w.organism.raw(),runtime_generation:u64::from(handle.generation()),
+            frame:w.frame_digest.0,world:w.world_signature.words};
+        let empty=frame.sensory().language_context.heard_tokens.iter().all(Option::is_none);
+        let (a,u)=verify_atom(&self.world,frame,&d.lexical);
+        let heard=a.is_some() && u.is_some_and(|f|f!=0.0) && !empty;
+        let old=d.core.bound();
+        let chosen=if heard {
+            visual_referent(&w.tracks,&d.lexical,u.unwrap_or(0.0))
+        } else if u==Some(0.0) && empty && a.is_some_and(|v|
+            old.is_some_and(|t|opaque_atom(v,d.owner)==t.2)) {
+            old.and_then(|t|visual_referent(&w.tracks,&d.lexical,t.1))
+                .filter(|r|old.is_some_and(|t|t.0==track(*r)))
+        } else {None};
+        let evidence=match (a,chosen) {
+            (Some(a),Some(t)) if heard=>Evidence::Heard{atom:opaque_atom(a,d.owner),target:track(t),signed:u.unwrap_or(0.0)},
+            (Some(a),Some(t)) if empty&&u==Some(0.0)=>Evidence::NativeDropout{atom:opaque_atom(a,d.owner),target:track(t)},
+            _=>Evidence::Reset,
+        };
+        let authenticated_active_dropout=w.hand_empty && matches!(evidence,Evidence::NativeDropout{..});
+        let readout=d.core.prepare(stamp,w.hand_empty,evidence).ok_or_else(bad)?;
+        d.armed_prepared=Some(Cut{stamp,world:contact,readout,expected_pre_life_handle:handle,
+            chosen,had_actual_heard_pair:heard,
+            original_graded_lexical_f32_bits:if heard {u.expect("verified complete positive-confidence cue").to_bits()}else{0},
+            authenticated_active_dropout,native_dispatch:None});
+        d.last_receipt=None;
+        Ok(())
+    }
+
+    pub(super) fn submit_wsp_armed_signed(
+        &mut self, batch:&GpuClosedLoopMemoryBatchInput<'_>, prepared:&[PreparedGpuBrainFrame],
+        before:&[GpuTrainingStateSnapshot], configs:&[alife_gpu_backend::GpuTrainingSamplingConfig], next_counter:u32,
+    ) -> Result<Vec<alife_gpu_backend::GpuClosedLoopTick>,ScaffoldContractError>{
+        let [row]=prepared else {return Err(bad());};
+        let [saved]=before else {return Err(bad());};
+        let [config]=configs else {return Err(bad());};
+        let d=self.wsp_armed.as_ref().ok_or_else(bad)?;
+        let c=d.armed_prepared.as_ref().ok_or_else(bad)?;
+        let f=&row.frame;
+        if c.native_dispatch.is_some() || d.terminal || config.demonstrator.is_some()
+            || row.handle!=d.handle || row.handle!=c.expected_pre_life_handle || row.handle!=saved.handle
+            || saved.tick!=c.stamp.tick || f.tick().raw()!=c.stamp.tick || f.frame_digest().0!=c.stamp.frame
+            || self.world.tick()!=c.world.decision_tick || self.world.canonical_signature_digest()?!=c.world.current_world_signature
+            || self.contact211_request.is_some()
+            || self.training_sampling.is_none_or(|p|p.demonstrator.is_some()||p.counter.checked_add(1)!=Some(next_counter))
+        {return Err(bad());}
+        let gate=Contact211PresampleAdmission {handle:row.handle,tick:f.tick(),frame_digest:f.frame_digest(),
+            world_signature_words:c.stamp.world,next_dispatch_generation:self.backend.contact211_presample_expected_dispatch(),
