+//! Separate bounded retained observation admission. Never scores, edits policy, or starts a second tick.
+use super::{digest, now, Result};
+use crate::gpu_live_runtime::{CueLatchObserverReceipt, FoundationTrainingStep, GpuLiveBrainRuntime};
+use alife_core::{MotorChannel, OrganismId};
+use alife_world::HeadlessActionIds;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::{fs, io::Read, path::Path};
+
+pub(super) const SCHEMA: u16 = 9;
+pub(super) const DECISIONS: usize = 3;
+pub(super) const TICKS: u64 = 3;
+const OWNER: u64 = 3;
+const OPENING: u64 = 3074;
+const SCOPE: &str = "qualia.saved_life.wsp_cue_latch_observer.v1";
+const PERMIT: &str = "cue-latch-admission.v1.json";
+const GRANT: &str = "cue-latch-operator-grant.v1.json";
+const CELL: &str = "cue-latch-language-cell.schema5.json";
+const PACKET: &str = "cue-latch-lexical-source.v1.json";
+const SOURCE: &str = "55672f322eadc64e223289d9df9883f62d0cc01aa97c0478119ad6c51d2852ee";
+const ACTOR: &str = "292dd9a7a26816e603e1d331d1c2715194442b2770b65c6ca4e2152f78a20bf3";
+const READOUT_PIN: &str = "488d8e0e3d551aae6d71657277d6698ee5fefbe64ea11bcae7f51cc92aa34d9c";
+const SEED_PIN: &str = "4387cc1c544db90f4408c4526d211a7c2cadebc626fc81b5d3ee6b989f5e9981";
+const SEED_WORDS: [u32; 2] = [1052770304, 1048576000];
+const MAX_LEAF: u64 = 8192;
+const MAX_EXECUTABLE: u64 = 256 * 1024 * 1024;
+
+#[derive(Debug, Copy, Clone, PartialEq, Eq, Deserialize, Serialize)]
+#[serde(rename_all = "snake_case")]
+enum Arm { Control, Observe }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    schema: u16,
+    scope: String,
+    language_manifest_sha256: String,
+    admission_sha256: String,
+}
+
+#[derive(Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    scope: String,
+    run_id: String,
+    arm: Arm,
+    current_sha256: String,
+    evaluator_sha256: String,
+    language_manifest_sha256: String,
+    max_decisions: u8,
+    max_world_ticks: u8,
+    fixed_host_pressure_ns: u64,
+    expires_unix_seconds: u64,
+    #[serde(deserialize_with = "optional")]
+    lexical_packet_sha256: Option<String>,
+    #[serde(deserialize_with = "optional")]
+    observer_seed_sha256: Option<String>,
+    observer_only_no_selection_edit: bool,
+}
+
+/// Match nullable exact topology without letting a missing key imply consent.
+fn optional<'de, D>(d: D) -> std::result::Result<Option<String>, D::Error>
+where D: serde::Deserializer<'de> { Option::<String>::deserialize(d) }
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Admission {
+    schema: String,
+    binding: Binding,
+    independent_operator_grant_sha256: String,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Grant {
+    schema: String,
+    binding: Binding,
+}
+
+#[derive(Serialize)]
+pub(super) struct Scope {
+    schema: &'static str,
+    binding: Binding,
+    admission_sha256: String,
+    #[serde(skip)]
+    lexical: Option<[u32; 32]>,
+}
+
+fn hex(s: &str) -> bool {
+    s.len() == 64 && s.bytes().all(|b| matches!(b, b'0'..=b'9' | b'a'..=b'f'))
+}
+
+fn read_local(root: &Path, name: &str) -> Result<Vec<u8>> {
+    let p = root.join(name);
+    if p.canonicalize()? != p || !fs::symlink_metadata(&p)?.is_file() {
+        return Err("WSP CUE LATCH requires a canonical local admission leaf".into());
+    }
+    read_bounded(&p, MAX_LEAF)
+}
+
+fn read_bounded(p: &Path, limit: u64) -> Result<Vec<u8>> {
+    let f=fs::File::open(p)?;
+    if f.metadata()?.len() > limit { return Err("WSP CUE LATCH file exceeds scope bound".into()); }
+    let mut raw=Vec::new();
+    f.take(limit+1).read_to_end(&mut raw)?;
+    if raw.is_empty() || raw.len() as u64 > limit { return Err("WSP CUE LATCH length is not bounded".into()); }
+    Ok(raw)
+}
+
+fn envelope(b: &[u8]) -> Result<Envelope> {
+    if b.len() as u64 > MAX_LEAF {return Err("WSP CUE LATCH outer manifest too large".into());}
+    let m: Envelope=serde_json::from_slice(b)?;
+    if m.schema!=SCHEMA || m.scope!=SCOPE ||
+        !hex(&m.admission_sha256) || !hex(&m.language_manifest_sha256) {
+        return Err("unsupported WSP CUE LATCH envelope".into());
+    }
+    Ok(m)
+}
+
+fn validate_binding(m: &Envelope, b: &Binding, t: u64) -> Result<()> {
+    if b.scope!=SCOPE || b.current_sha256!=SOURCE || !hex(&b.evaluator_sha256)
+        || b.run_id.is_empty() || b.run_id.len()>64
+        || !b.run_id.bytes().all(|k| k.is_ascii_alphanumeric() || k==b'-' || k==b'_')
+        || b.language_manifest_sha256!=m.language_manifest_sha256 || !b.observer_only_no_selection_edit
+        || b.max_decisions as usize!=DECISIONS || u64::from(b.max_world_ticks)!=TICKS || b.fixed_host_pressure_ns!=0
+        || b.expires_unix_seconds<=t || b.expires_unix_seconds>t.saturating_add(600)
+    { return Err("WSP CUE LATCH detached scope, deadline or selector guard differs".into()); }
+    match (b.arm,b.lexical_packet_sha256.as_deref(),b.observer_seed_sha256.as_deref()) {
+        (Arm::Control,None,None) | (Arm::Observe,Some(READOUT_PIN),Some(SEED_PIN)) => Ok(()),
+        _ => Err("WSP CUE LATCH observer/control weight authority differs".into())
+    }
+}
+
+fn parse_lexical(raw: &[u8]) -> Result<[u32; 32]> {
+    if digest(raw)!=READOUT_PIN { return Err("WSP CUE LATCH exact lexical words differ".into()); }
+    #[derive(Deserialize)]
+    #[serde(deny_unknown_fields)]
+    struct Exact {
+        schema: String, source_current_sha256: String, source_actor_plane_sha256: String, train_free: bool,
+        vocabulary_source_sha256: String, convention: String, prototype_f32_bits_3x8: [[u32; 8]; 3],
+        candidate_actual_f9_14_f32_bits: [u32; 6], bounded_gain_and_ambiguity_f32_bits: [u32; 2],
+    }
+    let p:Exact=serde_json::from_slice(raw)?;
+    if p.schema!="qualia.experimental.contact_lexical_rank1.weights.v1" || p.source_current_sha256!=SOURCE
+        || p.source_actor_plane_sha256!=ACTOR || !p.train_free || !hex(&p.vocabulary_source_sha256)
+        || p.convention.is_empty() { return Err("WSP CUE LATCH lexical source lineage differs".into()); }
+    let mut words=[0u32;32];
+    for (i,row) in p.prototype_f32_bits_3x8.iter().enumerate() { words[8*i..8*(i+1)].copy_from_slice(row); }
+    words[24..30].copy_from_slice(&p.candidate_actual_f9_14_f32_bits);
+    words[30..32].copy_from_slice(&p.bounded_gain_and_ambiguity_f32_bits);
+    Ok(words)
+}
+
+pub(super) fn resolve(root: &Path, raw: &[u8]) -> Result<(Scope, Vec<u8>)> {
+    let m=envelope(raw)?;
+    let a_raw=read_local(root, PERMIT)?;
+    if digest(&a_raw)!=m.admission_sha256 {return Err("WSP CUE LATCH admission digest differs".into());}
+    let a:Admission=serde_json::from_slice(&a_raw)?;
+    if a.schema!="qualia.saved_life.wsp_cue_latch_observer_admission.v1" || !hex(&a.independent_operator_grant_sha256) {
+        return Err("WSP CUE LATCH admission schema differs".into());
+    }
+    validate_binding(&m,&a.binding,now()?)?;
+    let g_raw=read_local(root, GRANT)?;
+    if digest(&g_raw)!=a.independent_operator_grant_sha256 {return Err("WSP CUE LATCH operator grant digest differs".into());}
+    let g:Grant=serde_json::from_slice(&g_raw)?;
+    if g.schema!="qualia.saved_life.wsp_cue_latch_observer_operator_grant.v1" || g.binding!=a.binding {
+        return Err("WSP CUE LATCH grant is not this exact arm".into());
+    }
+    let nested=read_local(root,CELL)?;
+    if digest(&nested)!=m.language_manifest_sha256 {
+        return Err("WSP CUE LATCH nested native language cell differs".into());
+    }
+    // Separate old Rank32 scope from both of these arms; it cannot appear in the same admission room.
+    for forbidden in ["contact211-rank32.weights.v1.json","contact211-f0-admission.v1.json","contact211-stock-reference.v1.json"] {
+        match fs::symlink_metadata(root.join(forbidden)) {
+            Err(e) if e.kind()==std::io::ErrorKind::NotFound => (),
+            _ => return Err("WSP CUE LATCH cannot coexist with Contact211 selected-head admission".into())
+        }
+    }
+    let lexical=match a.binding.arm {
+        Arm::Observe => Some(parse_lexical(&read_local(root,PACKET)?)?),
+        Arm::Control => {
+            match fs::symlink_metadata(root.join(PACKET)) {
+                Err(e) if e.kind()==std::io::ErrorKind::NotFound => (),
+                _ => return Err("WSP CUE LATCH control has an experimental packet".into())
+            }
+            None
+        }
+    };
+    let exe=std::env::current_exe()?;
+    if digest(&read_bounded(&exe,MAX_EXECUTABLE)?)!=a.binding.evaluator_sha256 {
+        return Err("WSP CUE LATCH evaluator does not match exact grant".into());
+    }
+    Ok((Scope{schema:SCOPE,binding:a.binding,admission_sha256:m.admission_sha256,lexical},nested))
+}
+
+impl Scope {
+    pub(super) fn binds(&self, run: &str, source: &str, finalization: Option<u64>) -> Result<()> {
+        if self.binding.run_id!=run || self.binding.current_sha256!=source
+            || finalization.is_none_or(|n|n>self.binding.expires_unix_seconds) {
+            return Err("WSP CUE LATCH same-cell and wall bounds do not match".into());
+        }
+        Ok(())
+    }
+
+    pub(super) fn observing(&self)->bool {self.binding.arm==Arm::Observe}
+
+    pub(super) fn begin(&self, runtime: &mut GpuLiveBrainRuntime, owner: OrganismId, source: &str,
+                        controlled_pressure: Option<u64>) -> Result<()> {
+        if owner.raw()!=OWNER || runtime.world().tick().raw()!=OPENING || source!=SOURCE
+            || controlled_pressure!=Some(0) || now()? >= self.binding.expires_unix_seconds {
+            return Err("WSP CUE LATCH wrong native starting owner/tick/pressure/scope".into());
+        }
+        if let Some(lexical)=self.lexical {
+            runtime.begin_cue_latch_observer(owner, source, lexical, SEED_WORDS, DECISIONS as u8)?;
+        }
+        Ok(())
+    }
+
+    pub(super) fn collect(&self, runtime: &mut GpuLiveBrainRuntime, step: &FoundationTrainingStep,
+                          rows: usize, calls: u64) -> Result<Option<Value>> {
+        let tick=step.frame.tick();
+        let out=step.patch.outcome();
+        if rows >= DECISIONS || calls != rows as u64+1 || tick.raw()!=OPENING + rows as u64
+            || tick.raw().checked_add(1)!=Some(out.outcome_tick.raw()) || out.outcome_tick!=runtime.world().tick()
+            || step.frame.organism_id().raw()!=OWNER || step.frame.organism_id()!=out.organism_id
+            || step.frame.frame_digest()!=step.patch.pre_action().perception().frame_digest()
+            || now()? >= self.binding.expires_unix_seconds {
+            return Err("WSP CUE LATCH capture is not the exact one committed signed cut".into());
+        }
+        let r=runtime.take_cue_latch_observation();
+        if !self.observing() {
+            if r.is_some() {return Err("WSP CUE LATCH control produced observer state".into());}
+            return Ok(None);
+        }
+        let r: CueLatchObserverReceipt=r.ok_or("WSP CUE LATCH missing native authored observer evidence")?;
+        if r.owner!=out.organism_id || r.tick!=tick || r.outcome_tick!=out.outcome_tick
+            || r.frame!=step.frame.frame_digest() || r.world.words==[0;4]
+            || r.native_dispatch_generation!=step.behavior.dispatch_generation || !r.source_only_not_actuation
+            || !(f32::from_bits(r.signed_before).abs()<=1.0 && f32::from_bits(r.signed_after).abs()<=1.0)
+            || r.meaningful_before.is_some()!=(r.signed_before!=0)
+            || (r.held_reset && r.signed_after!=0) {
+            return Err("WSP CUE LATCH native readback has inconsistent bound state".into());
