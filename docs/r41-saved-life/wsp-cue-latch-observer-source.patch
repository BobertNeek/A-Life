+        // Test-only acoustic prototypes from public codebook ordinals, not downloaded weights.
+        for (i, token) in [9_u16,1].into_iter().enumerate() {
+            for j in 0..8 {prototype[8*i+j]=if token&(1<<j)!=0 {1.0} else {-1.0};}
+        }
+        let mut previous = None;
+        let mut history = None;
+        for d in 0..3 {
+            let t=world.tick();
+            let homeostasis=HomeostaticSnapshot::baseline(t);
+            let (draft, binding)=world.perception_frame_draft_with_bindings(
+                owner,t,SensorProfile::GroundedTerrainVisionV1,homeostasis,
+            ).unwrap();
+            let binding=binding.unwrap();
+            let frame=draft.finalize(PerceptionContextBlock::empty()).unwrap();
+            let w=world.cue_latch_world_witness(&frame,&binding).unwrap();
+            assert_eq!((w.tick,w.frame_digest),(t,frame.frame_digest()));
+            assert!(w.hand_empty && w.tracks.len()>=2);
+            let ids=w.tracks.iter().map(|r|(r.observed_track.raw(),r.physical_spawn_key.0)).collect::<Vec<_>>();
+            if let Some(old) = &history { assert_eq!(old,&ids); }
+            history=Some(ids);
+            let (a,s)=verify_atom(&world,&frame,&prototype);
+            if d < 2 {
+                let live=a.unwrap(); assert_eq!(live.id,atom.utterance_id.raw());
+                assert_eq!(live.emitted,started); assert!(s.unwrap()<0.0);
+            } else {
+                assert_eq!((a,s),(None,None));
+            }
+            if let Some((old_frame,old_binding))=&previous {
+                assert!(world.cue_latch_world_witness(old_frame,old_binding).is_err(),"stale real frame must not witness");
+            }
+            previous=Some((frame,binding));
+            if d<2 { world.advance_tick(); }
+        }
+    }
+}
