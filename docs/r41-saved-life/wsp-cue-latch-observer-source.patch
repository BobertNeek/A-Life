+//! Authenticated same-cut World observation. Private studies only; no action selector.
+use super::*;
+use crate::PhysicalTrackingKey;
+use alife_core::{
+    CandidateActionFamily, CandidateObservationRef, PerceptionFrameDigest, TrackedObjectId,
+    MAX_GROUNDED_OBJECT_SLOTS,
+};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct CueLatchTrackWitness {
+    pub observed_track: TrackedObjectId,
+    /// Physical spawn/provenance equality is a read-only authority, not a feature word.
+    pub physical_spawn_key: PhysicalTrackingKey,
+    pub physical_target: WorldEntityId,
+    pub appearance_bits: [u32; 6],
+    pub grounded_distance_bits: u32,
+    pub stock_approach_offered: bool,
+    pub world_grab_legal_pre_motion: bool,
+    pub current_target_free: bool,
+}
+
+#[derive(Clone, Debug)]
+pub struct CueLatchWorldWitness {
+    pub organism: OrganismId,
+    pub tick: Tick,
+    pub frame_digest: PerceptionFrameDigest,
+    pub world_signature: HeadlessWorldSignatureDigest,
+    pub hand_empty: bool,
+    pub tracks: Vec<CueLatchTrackWitness>,
+}
+
+impl HeadlessWorld {
+    /// Bind **all** actually observed slots, including out-of-reach/unoffered
+    /// competitors. This does not query the model or produce an action.
+    pub fn cue_latch_world_witness(
+        &self, frame: &PerceptionFrame, binding: &GroundedCandidateBinding,
+    ) -> Result<CueLatchWorldWitness, ScaffoldContractError> {
+        let bad = || ScaffoldContractError::InvalidDecisionEvidence;
+        frame.validate()?;
+        let owner = frame.organism_id();
+        let tick = frame.tick();
+        let slots = frame.grounded_object_slots();
+        if tick != self.tick() || slots.len() > MAX_GROUNDED_OBJECT_SLOTS || slots.len() > 32 {
+            return Err(bad());
+        }
+        let actor = self.agent_entity_id(owner)?;
+        let body = self.objects.get(&actor.raw()).ok_or_else(bad)?;
+        let resident = self.organism_registry.get(owner).ok_or_else(bad)?;
+        if body.consumed || body.organism_id != Some(owner) || !resident.lifecycle().is_alive()
+            || point_bits(frame.body().pose.translation) != point_bits(body.position) {
+            return Err(bad());
+        }
+        let hand_empty = self.cue_latch_hand_empty(owner);
+        let (mut seen_slots, mut seen_tracks, mut seen_targets, mut seen_spawns) =
+            (BTreeSet::new(), BTreeSet::new(), BTreeSet::new(), BTreeSet::new());
+        let mut tracks = Vec::with_capacity(slots.len());
+        for observed in slots {
+            let slot = observed.slot_index;
+            let (captured, bound) = binding.contact211_transport(owner, tick, slot)?;
+            let id = bound.transport_entity;
+            let target = self.objects.get(&id.raw()).ok_or_else(bad)?;
+            let record = self.tracked_objects.record(owner, observed.tracked_object_id).ok_or_else(bad)?;
+            if observed != captured || observed.confidence.raw() <= 0.0 || target.consumed
+                || record.tracking_key != target.tracking_key
+                || record.tracking_provenance != target.tracking_provenance || record.last_seen_tick != tick
+                || point_bits(target.position) != point_bits(bound.target_position)
+                || !seen_slots.insert(slot) || !seen_tracks.insert(observed.tracked_object_id.raw())
+                || !seen_targets.insert(id.raw()) || !seen_spawns.insert(target.tracking_key)
+            {
+                return Err(bad());
+            }
+            let features = observed.candidate_features()?.0;
+            let mut offered = false;
+            for (index, candidate) in frame.candidates().iter().enumerate().filter(|(_, c)|
+                c.action_id == HeadlessActionIds::APPROACH
+                    && c.observation == CandidateObservationRef::ObjectSlot(slot)) {
+                if offered || candidate.family != CandidateActionFamily::Approach
+                    || usize::from(candidate.candidate_index) != index
+                    || candidate.target.entity != Some(id)
+                    || candidate.target.position.map(point_bits) != Some(point_bits(bound.target_position))
+                    || (9..15).any(|j| candidate.features.0[j].to_bits() != features[j].to_bits())
+                {
+                    return Err(bad());
+                }
+                offered = true;
+            }
+            let free = target.carried_by.is_none() && !target.activity_hold
+                && self.player_held_object() != Some(id);
+            tracks.push(CueLatchTrackWitness {
+                observed_track: observed.tracked_object_id,
+                physical_spawn_key: target.tracking_key,
+                physical_target: id,
+                appearance_bits: std::array::from_fn(|i| features[i+9].to_bits()),
+                grounded_distance_bits: observed.distance.to_bits(),
+                stock_approach_offered: offered,
+                world_grab_legal_pre_motion: free && self.grab_target_is_legal(owner, actor, id),
+                current_target_free: free,
+            });
+        }
+        Ok(CueLatchWorldWitness {
+            organism: owner, tick, frame_digest: frame.frame_digest(),
+            world_signature: self.canonical_signature_digest()?, hand_empty, tracks,
+        })
+    }
+
+    pub fn cue_latch_hand_empty(&self, owner: OrganismId) -> bool {
+        !self.objects.values().any(|o| !o.consumed && o.carried_by == Some(owner))
+    }
+}
+
+fn point_bits(v: Vec3f) -> [u32; 3] { [v.x.to_bits(),v.y.to_bits(),v.z.to_bits()] }
