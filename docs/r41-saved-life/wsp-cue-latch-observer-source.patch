+//! Private, opt-in native witness. Two train-free words, no selector output.
+use super::*;
+use alife_core::{PerceptionFrameDigest, UtteranceSourceKind};
+use alife_world::{
+    ActionPhase, CueLatchTrackWitness, CueLatchWorldWitness, GripTransferKind,
+    HeadlessActionIds, HeadlessWorldSignatureDigest,
+};
+use sha2::{Digest, Sha256};
+
+const SOURCE_CURRENT: &str = "55672f322eadc64e223289d9df9883f62d0cc01aa97c0478119ad6c51d2852ee";
+const OLD_RANK32_F32_WORDS_LE: &str = "3bfb032d8b445caccecbc3a1400935cee21e471c2e333216125f172c4449e1f6";
+const SEED_WORDS: [u32; 2] = [1052770304, 1048576000]; // .375 diagonal and .25 entry, immutable
+const LEAK: f32 = 0.25;
+// No configurable global/recurrent gain change. Local exact 1.0, originally bounded at <=1.4.
+const MICROSTEPS: usize = 4;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct Atom {
+    id: u64,
+    position_bits: [u32; 3],
+    words: [u32; 2],
+    emitted: Tick,
+    expires: Tick,
+}
+
+#[derive(Debug)]
+struct Cut {
+    world: CueLatchWorldWitness,
+    atom: Option<Atom>,
+    /// None = no coherent frame; Some(0) = genuinely empty native hearing.
+    active_drive: Option<f32>,
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct CueLatchObserverReceipt {
+    pub owner: OrganismId,
+    pub tick: Tick,
+    pub outcome_tick: Tick,
+    pub frame: PerceptionFrameDigest,
+    pub world: HeadlessWorldSignatureDigest,
+    pub native_dispatch_generation: u64,
+    pub active_atom_audit: Option<(u64, Tick, Tick)>,
+    pub true_heard_current_cut: bool,
+    pub meaningful_before: Option<CueLatchTrackWitness>,
+    pub signed_before: u32,
+    pub signed_after: u32,
+    pub paid_same_target_grab: bool,
+    pub held_reset: bool,
+    pub source_only_not_actuation: bool,
+}
+
+#[derive(Debug)]
+pub(super) struct CueLatchObserver {
+    owner: OrganismId,
+    handle: GpuBrainHandle,
+    old_words: [f32; 32],
+    pending: Option<Cut>,
+    last_tick: Option<Tick>,
+    // The runtime is process-local and not restored from brain or World saves.
+    remaining: u8,
+    held: Option<(Atom, CueLatchTrackWitness, f32)>,
+    retired: Option<Atom>,
+    receipt: Option<CueLatchObserverReceipt>,
+}
+
+fn verify_atom(world: &HeadlessWorld, f: &PerceptionFrame, w: &[f32; 32]) -> (Option<Atom>, Option<f32>) {
+    let context = &f.sensory().language_context;
+    let t = f.tick().raw();
+    let live = world.audible_utterances().into_iter()
+        .filter(|a| a.emitted_tick.raw() <= t && t <= a.expires_after_tick.raw()).take(2).collect::<Vec<_>>();
+    let [a] = live.as_slice() else { return (None,None); };
+    if context.teacher_channel_marker.is_some() || a.source_kind != UtteranceSourceKind::Player
+        || a.addressee != Some(f.organism_id()) || a.teacher_channel.is_some() || a.speaker_id.is_some()
+        || a.tokens.len()!=2 {
+        return (None,None);
+    }
+    let atom = Atom {
+        id:a.utterance_id.raw(),
+        position_bits: [a.source_position.x,a.source_position.y,a.source_position.z].map(f32::to_bits),
+        words: [u32::from(a.tokens[0].raw()),u32::from(a.tokens[1].raw())],
+        emitted:a.emitted_tick, expires:a.expires_after_tick,
+    };
+    let h = &context.heard_tokens;
+    if h.iter().all(Option::is_none) {
+        // Only an already-held exact same current Atom can use this absence.
+        return (Some(atom), Some(0.0));
+    }
+    if h[2..].iter().any(Option::is_some) {
+        return (Some(atom), None);
+    }
+    let (Some(first),Some(second))=(h[0],h[1]) else { return (Some(atom),None); };
+    for (i, x) in [first,second].iter().enumerate() {
+        if x.utterance_id != a.utterance_id || usize::from(x.sequence_position)!=i
+            || x.source_kind!=a.source_kind || x.addressee!=a.addressee || x.source_position!=a.source_position
+            || x.speaker_id.is_some() || x.source_entity.is_some() || x.teacher_channel.is_some()
+            || x.token_id!=atom.words[i] || !(1..=255).contains(&x.token_id)
+            || !(0.0<x.confidence.raw() && x.confidence.raw()<=1.0) {
+            return (Some(atom),None);
+        }
+    }
+    let r = f.sensory().language_prior_neural_lanes();
+    let hit = |prototype: usize, rail: usize| {
+        (0..8).map(|j|(w[8*prototype+j]*r[8*rail+j]).max(0.0)).fold(1.0_f32, f32::min)
+    };
+    let verb=hit(0,0);
+    let u=verb.min(hit(2,1))-verb.min(hit(1,1));
+    (Some(atom), (u!=0.0).then_some(u))
+}
+
+fn same_track(a: CueLatchTrackWitness,b: CueLatchTrackWitness) -> bool {
+    a.observed_track==b.observed_track && a.physical_spawn_key==b.physical_spawn_key && a.physical_target==b.physical_target
+}
+
+impl CueLatchObserver {
+    fn stop_held(&mut self) {
+        if let Some((a,_,_))=self.held.take() { self.retired=Some(a); }
+    }
+
+    fn top(&self, rows: &[CueLatchTrackWitness], sign: f32) -> Option<CueLatchTrackWitness> {
+        if sign==0.0 || rows.len()<2 || rows.len()>32 { return None; }
+        let mut first: Option<(f32,CueLatchTrackWitness)>=None;
+        let mut next=f32::NEG_INFINITY;
+        for &row in rows {
+            let mut s=0.0_f32;
+            for (j,b) in row.appearance_bits.into_iter().enumerate() {
+                let v=f32::from_bits(b);
+                if !(0.0..=1.0).contains(&v) { return None; }
+                s+=v*self.old_words[24+j];
+            }
+            let s=s*sign.signum();
+            if first.is_none_or(|f| s>f.0) {
+                if let Some((n,_))=first { next = n; }
+                first=Some((s,row));
+            } else { next=next.max(s); }
+        }
+        let (best,row)=first?;
+        let band=self.old_words[31];
+        (best>=band && best-next>=band && row.current_target_free && row.stock_approach_offered).then_some(row)
+    }
+
+    fn compute(&mut self,c: &Cut) -> Option<(CueLatchTrackWitness, f32)> {
+        let t=c.world.tick.raw();
+        let exact_next=self.last_tick.is_none_or(|old| old.raw().checked_add(1)==Some(t));
+        self.last_tick=Some(c.world.tick);
+        let (Some(a),Some(u))=(c.atom,c.active_drive) else { self.stop_held(); return None; };
+        if !exact_next || !c.world.hand_empty || self.retired==Some(a) {
+            self.stop_held();
+            return None;
+        }
+        let s=match self.held {
+            Some((old,track,s)) if old==a
+                && self.top(&c.world.tracks,s).is_some_and(|now|same_track(now,track)) => s,
+            Some(_) => { self.stop_held(); return None; }
+            None if u==0.0 => return None, // cannot install from elapsed silence
+            None => 0.0_f32,
+        };
+        let track=self.top(&c.world.tracks,if s==0.0 {u} else {s})?;
+        let b=f32::from_bits(SEED_WORDS[0]);
+        let e=f32::from_bits(SEED_WORDS[1]);
+        let mut q=s;
+        for _ in 0..MICROSTEPS {
+            q=(1.0-LEAK)*q+LEAK*(b*q+e*u).tanh();
+        }
+        self.held=Some((a,track,q));
+        Some((track,q))
+    }
+}
+
+impl GpuLiveBrainRuntime {
+    /// Not called by existing evaluators. A future private, exact source-admission
+    /// resolver may pass only the fully verified immutable Current hash and word bytes.
+    /// A digest argument is not itself operator authorization.
+    #[allow(dead_code)]
+    pub(crate) fn begin_cue_latch_observer(
+        &mut self, owner: OrganismId, verified_current: &str,
+        old_qualified_words: [u32;32], new_seed_words: [u32;2], decisions: u8,
+    ) -> Result<(), ScaffoldContractError> {
+        let bad=|| ScaffoldContractError::InvalidDecisionEvidence;
+        let handle=*self.handles.get(&owner.raw()).ok_or_else(bad)?;
+        let digest=format!("{:x}",Sha256::digest(old_qualified_words.iter().flat_map(|w|w.to_le_bytes()).collect::<Vec<_>>()));
+        if verified_current!=SOURCE_CURRENT || digest!=OLD_RANK32_F32_WORDS_LE || new_seed_words!=SEED_WORDS
+            || !(1..=16).contains(&decisions) || self.cue_latch_observer.is_some()
+            || self.handles.len()!=1 || self.residents.len()!=1
+            || self.residents.get(&owner.raw()).is_none_or(|r|r.sleep_scheduler.state().phase!=SleepPhase::Awake)
+            || self.training_demonstrator.is_some()
+            || self.training_sampling.is_none_or(|s|s.demonstrator.is_some())
+            || self.sensor_profile!=SensorProfile::GroundedTerrainVisionV1
+            || self.contact211_request.is_some() {
+            return Err(bad());
+        }
+        self.cue_latch_observer=Some(CueLatchObserver{
+            owner,handle,old_words:old_qualified_words.map(f32::from_bits),pending:None,last_tick:None,
+            remaining:decisions,held:None,retired:None,receipt:None,
+        });
+        Ok(())
+    }
+
+    #[allow(dead_code)]
+    pub(crate) fn take_cue_latch_observation(&mut self) -> Option<CueLatchObserverReceipt> {
+        self.cue_latch_observer.as_mut()?.receipt.take()
+    }
+
+    #[allow(dead_code)]
+    pub(crate) fn end_cue_latch_observer(&mut self) {
+        self.cue_latch_observer=None;
+    }
+
+    pub(super) fn cue_latch_before_staged_world(&mut self) {
+        if let Some(s)=&mut self.cue_latch_observer {
+            s.pending=None;
+            s.receipt=None;
+        }
+    }
+
+    pub(super) fn capture_cue_latch_observer(
+        &mut self, frame: &PerceptionFrame, binding: Option<&alife_world::GroundedCandidateBinding>,
+        handle: GpuBrainHandle,
+    ) {
+        let Some(s)=&mut self.cue_latch_observer else {return;};
+        if s.remaining==0 || s.pending.is_some() || s.owner!=frame.organism_id() || s.handle!=handle
+            || self.contact211_request.is_some() || self.training_demonstrator.is_some()
+            || self.training_sampling.is_none_or(|x|x.demonstrator.is_some()) {
+            s.pending=None; return;
+        }
+        if let Some(world)=binding.and_then(|b|self.world.cue_latch_world_witness(frame,b).ok()) {
+            let (atom,active_drive)=verify_atom(&self.world,frame,&s.old_words);
+            s.pending=Some(Cut{world,atom,active_drive});
+        }
+    }
+
+    // This is called after the entire staged World transaction returns. Failed/rolled-back
+    // steps cannot mutate committed observer memory or produce a success receipt.
+    pub(super) fn finish_cue_latch_after_staged_world(
+        &mut self, result: &Result<Vec<LiveBrainTickSummary>, GameAppShellError>,
+    ) {
+        let Some(s)=&mut self.cue_latch_observer else {return;};
+        let Ok(summaries)=result else { s.pending=None; s.held=None; s.remaining=0; return; };
+        if s.remaining==0 {return;}
+        s.remaining-=1;
+        let Some(c)=s.pending.take() else {s.stop_held();return;};
+        let [summary]=summaries.as_slice() else {s.stop_held();return;};
+        let [step]=self.last_foundation_training_steps.as_slice() else {s.stop_held();return;};
+        let outcome=step.patch.outcome();
+        let Some(actual_channels)=outcome.joint.as_ref() else {s.stop_held();return;};
+        let Some(motor)=summary.motor_execution.as_ref() else {s.stop_held();return;};
+        if summary.organism_id!=s.owner || outcome.organism_id!=s.owner || c.world.organism!=s.owner
+           || step.before.handle!=s.handle || step.after_inference.handle!=s.handle
+           || step.frame.frame_digest()!=c.world.frame_digest || step.frame.tick()!=c.world.tick
+           || summary.world_tick_before!=c.world.tick || summary.world_tick_after!=outcome.outcome_tick
+           || self.world.tick()!=outcome.outcome_tick
+           || c.world.tick.raw().checked_add(1)!=Some(outcome.outcome_tick.raw()) {
+            s.stop_held(); return;
+        }
+        let before=s.compute(&c);
+        let mut genuine_pickup=false;
+        if let Some((track,_))=before {
+            let entity=track.physical_target;
+            let phase_receipt=motor.channel_receipts.iter().any(|r|
+                r.command.channel==MotorChannel::Manipulation && r.command.primitive==HeadlessActionIds::GRAB
+                && r.command.target.and_then(|y|y.entity)==Some(entity) && r.phase==ActionPhase::Completed
+                && r.grip_transfers.iter().any(|g|g.kind==GripTransferKind::Acquired && g.object==entity
+                    && g.previous_owner.is_none() && g.new_owner==Some(s.owner))
+            );
+            let paid=actual_channels.channel_outcomes.iter().any(|r|
+                r.channel==MotorChannel::Manipulation && r.physical.energy_cost.raw()>0.0
+                && r.physical.target_entity==Some(entity)
+                && r.execution_evidence.is_some_and(|x|x.succeeded && x.primitive==HeadlessActionIds::GRAB
+                    && x.command_target==Some(entity))
+            );
+            genuine_pickup=c.world.hand_empty && track.current_target_free && phase_receipt && paid
+                && self.world.entity(entity).is_some_and(|x|!x.consumed && x.tracking_key==track.physical_spawn_key
+                    && x.carried_by==Some(s.owner));
+        }
+        let hand_now_occupied=!self.world.cue_latch_hand_empty(s.owner);
+        if genuine_pickup || hand_now_occupied {
+            // A real wrong/new hold is safety reset, not attributed as task success.
+            s.stop_held();
+        }
+        s.receipt=Some(CueLatchObserverReceipt {
+            owner:s.owner,tick:c.world.tick,outcome_tick:outcome.outcome_tick,frame:c.world.frame_digest,
+            world:c.world.world_signature,native_dispatch_generation:step.behavior.dispatch_generation,
+            active_atom_audit:c.atom.map(|a|(a.id,a.emitted,a.expires)),
+            true_heard_current_cut:c.active_drive.is_some_and(|u|u!=0.0),
+            meaningful_before:before.map(|p|p.0),signed_before:before.map_or(0,|p|p.1.to_bits()),
+            signed_after:s.held.map_or(0,|p|p.2.to_bits()),paid_same_target_grab:genuine_pickup,
+            held_reset:genuine_pickup||hand_now_occupied,source_only_not_actuation:true,
+        });
+    }
+}
