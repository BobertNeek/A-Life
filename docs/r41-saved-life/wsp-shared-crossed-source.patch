--- /dev/null
+++ b/crates/alife_game_app/src/foundation_training_cycle/saved_life_retention/wsp_out_of_reach_fixture.rs
@@ -0,0 +1,313 @@
+//! Shared named physical fixture v1, not an evaluator request or action authority.
+//! No speech, actor, sampling, scoring, tick or optional candidate modification.
+//! Its future native callers must separately verify current/ELF and arm grants.
+use super::Result;
+use alife_core::{OrganismId, Tick, Vec3f, WorldEntityId};
+use alife_world::{HeadlessWorld, WorldObjectKind};
+use serde::{Deserialize, Serialize};
+
+const FIXTURE: &str = "qualia.saved_life.wsp_crossed_out_of_reach_geometry.v1";
+const OWNER: OrganismId = OrganismId(3);
+const OPENING: u64 = 3074;
+const WORLD_SEED: u64 = 202612240055;
+const FOOD: WorldEntityId = WorldEntityId(2);
+const BALL: WorldEntityId = WorldEntityId(3);
+const MAX_ORDINARY_STEP: f64 = 0.10000101;
+const MIN_OPEN_RANGE: f64 = 1.51;
+const MAX_OPEN_RANGE: f64 = 1.60;
+const GRAB_RADIUS: f64 = 1.25;
+const HEARING_RADIUS: f64 = 6.0;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum FixtureLayoutV1 {
+    A,
+    B,
+}
+
+#[derive(Clone, Copy, Debug, Serialize)]
+pub(super) struct GeometryWitnessV1 {
+    schema: &'static str,
+    layout: FixtureLayoutV1,
+    owner: OrganismId,
+    tick: Tick,
+    source_world_signature: [u64; 4],
+    staged_world_signature: [u64; 4],
+    body: WorldEntityId,
+    body_position: Vec3f,
+    body_yaw: f32,
+    prop_ids_in_food_ball_order: [WorldEntityId; 2],
+    prop_positions_in_food_ball_order: [Vec3f; 2],
+    measured_center_ranges_m: [f64; 2],
+    visible_world_order: [WorldEntityId; 2],
+    opening_grab_probe: [(bool, bool); 2],
+    rear_edge_source: Vec3f,
+    rear_steady_source: Vec3f,
+    geometry_only: bool,
+}
+
+impl GeometryWitnessV1 {
+    /// Hand these points to the ordinary World emitter under a separate typed
+    /// admission. Geometry must never emit even when the caller names an edge.
+    pub(super) fn acoustic_points(&self) -> (Vec3f, Vec3f) {
+        (self.rear_edge_source, self.rear_steady_source)
+    }
+    pub(super) fn body(&self) -> WorldEntityId { self.body }
+    pub(super) fn prop_ids(&self) -> [WorldEntityId; 2] { self.prop_ids_in_food_ball_order }
+    pub(super) fn prop_positions(&self) -> [Vec3f; 2] { self.prop_positions_in_food_ball_order }
+    pub(super) fn center_range(&self, a: Vec3f, b: Vec3f) -> f64 { range(a,b) }
+    pub(super) fn ordinary_pose_is_safe(&self, point: Vec3f, intervals: u64) -> bool {
+        intervals<=2 && range(self.body_position,point)<=intervals as f64*MAX_ORDINARY_STEP
+            && self.prop_positions_in_food_ball_order.into_iter().all(|p|range(point,p)>GRAB_RADIUS)
+    }
+    pub(super) fn ordinary_interval_is_safe(&self, a: &Vec3f, b: &Vec3f) -> bool {
+        range(*a,*b)<=MAX_ORDINARY_STEP
+    }
+}
+
+/// Actual detached lifted/owned result: parent may inspect, never mutate the
+/// caller's original World here. No serde input or user-chosen coordinates.
+pub(super) struct StagedFixtureV1 {
+    pub(super) world: HeadlessWorld,
+    pub(super) witness: GeometryWitnessV1,
+}
+
+fn offset(body: Vec3f, yaw: f32, front: f32, side: f32) -> Vec3f {
+    let (sn, cs) = yaw.sin_cos();
+    Vec3f::new(
+        body.x + front * cs - side * sn,
+        body.y,
+        body.z + front * sn + side * cs,
+    )
+}
+
+fn range(a: Vec3f, b: Vec3f) -> f64 {
+    (f64::from(a.x) - f64::from(b.x))
+        .hypot(f64::from(a.y) - f64::from(b.y))
+        .hypot(f64::from(a.z) - f64::from(b.z))
+}
+
+fn free_stationary(world: &HeadlessWorld, id: WorldEntityId, kind: WorldObjectKind) -> bool {
+    world.entity(id).is_some_and(|o| {
+        o.kind == kind
+            && o.organism_id.is_none()
+            && !o.consumed
+            && !o.activity_hold
+            && o.carried_by.is_none()
+            && world.player_held_object() != Some(id)
+            && o.teacher_channel.is_none()
+            && o.token_id.is_none()
+            && o.hazard_pain == 0.0
+            && o.grounded_physical.velocity == Vec3f::ZERO
+    })
+}
+
+/// The single shared builder for later schema-specific consumers. Asset and
+/// native action admission are deliberately outside this module. Require the
+/// same exact mature R44 *World* anchors as the private retained fixtures.
+pub(super) fn build_fixed_fixture_v1(
+    world: &HeadlessWorld,
+    owner: OrganismId,
+    layout: FixtureLayoutV1,
+) -> Result<StagedFixtureV1> {
+    if owner != OWNER
+        || world.tick().raw() != OPENING
+        || world.seed() != WORLD_SEED
+        || world.object_snapshots().len() != 10
+        || !world.entity(FOOD).is_some_and(|o| {
+            o.radius.to_bits() == 0.45_f32.to_bits()
+                && o.nutrition.to_bits() == 0.85_f32.to_bits()
+        })
+        || !world.entity(BALL).is_some_and(|o| {
+            o.radius.to_bits() == 0.30_f32.to_bits() && o.nutrition == 0.0
+        })
+    {
+        return Err("out-of-reach fixture requires the unchanged mature opening world".into());
+    }
+    stage_geometry(world, owner, layout, [FOOD, BALL])
+}
+
+fn stage_geometry(
+    world: &HeadlessWorld,
+    owner: OrganismId,
+    layout: FixtureLayoutV1,
+    props: [WorldEntityId; 2],
+) -> Result<StagedFixtureV1> {
+    let tick = world.tick();
+    let snapshots = world.object_snapshots();
+    let body = snapshots
+        .iter()
+        .find(|o| o.organism_id == Some(owner))
+        .ok_or("missing out-of-reach fixture resident body")?;
+    if world.terrain().is_some()
+        || world.player_held_object().is_some()
+        || !world.audible_utterances().is_empty()
+        || snapshots.iter().any(|o| o.carried_by == Some(owner) || o.teacher_channel.is_some())
+        || !world.organism_registry().get(owner).is_some_and(|r| r.lifecycle().is_alive())
+        || !free_stationary(world, props[0], WorldObjectKind::Food)
+        || !free_stationary(world, props[1], WorldObjectKind::Ball)
+    {
+        return Err("out-of-reach fixture requires actual free stationary props and clean ears".into());
+    }
+
+    let p = body.position;
+    let yaw = body.body_yaw;
+    let near = offset(p, yaw, 1.380, 0.621);
+    let far = offset(p, yaw, 1.440, -0.648);
+    let berths = match layout {
+        FixtureLayoutV1::A => [near, far],
+        FixtureLayoutV1::B => [far, near],
+    };
+    let radii = berths.map(|v| range(p, v));
+    let rear_edge_source = offset(p, yaw, -5.980, 0.0);
+    let rear_steady_source = offset(p, yaw, -5.700, 0.0);
+    if radii.iter().any(|&r| {
+        !(MIN_OPEN_RANGE..MAX_OPEN_RANGE).contains(&r)
+            || r - 2.0 * MAX_ORDINARY_STEP <= GRAB_RADIUS
+    }) || !(5.9798..5.9802).contains(&range(p, rear_edge_source))
+        || range(p, rear_steady_source) + 2.0 * MAX_ORDINARY_STEP >= HEARING_RADIUS
+    {
+        return Err("out-of-reach fixture pose breaks the signed two-cut geometry proof".into());
+    }
+
+    let mut staged = world.clone();
+    for (id, to) in props.into_iter().zip(berths) {
+        let mut expected = world.entity(id).ok_or("missing exact loose target")?.clone();
+        expected.position = to;
+        expected.grounded_physical.velocity = Vec3f::ZERO;
+        // Same established world editor setup as legacy retained geometry;
+        // the second same-position call zeros the editor displacement lane.
+        staged.editor_move_object(id, to)?;
+        staged.editor_move_object(id, to)?;
+        if staged.entity(id) != Some(&expected) {
+            return Err("out-of-reach fixture changed more than the stationary berth".into());
+        }
+    }
+    let opening_grab_probe = props.map(|id| staged.retained_language_pilot_grab_probe(owner, id));
+    let mut ecology = staged.ecology().clone();
+    ecology.metrics = world.ecology().metrics.clone();
+    let sensory = staged.sensory_report(owner, tick)?;
+    let seen = sensory.visible_entities.iter().map(|v| v.id).collect::<Vec<_>>();
+    if &ecology != world.ecology()
+        || staged.tick() != tick
+        || staged.organism_registry().get(owner) != world.organism_registry().get(owner)
+        || snapshots.iter().any(|o| !props.contains(&o.id) && staged.entity(o.id) != Some(o))
+        || !staged.audible_utterances().is_empty()
+        || opening_grab_probe != [(false, false); 2]
+        || !sensory.contact_entities.is_empty()
+        || sensory.core_snapshot.language_context.heard_tokens.iter().any(Option::is_some)
+        || seen.len() != 2
+        || !props.iter().all(|id| seen.contains(id))
+    {
+        return Err("out-of-reach fixture changed the resident, audibility, free reach or roster".into());
+    }
+    Ok(StagedFixtureV1 {
+        witness: GeometryWitnessV1 {
+            schema: FIXTURE,
+            layout,
+            owner,
+            tick,
+            source_world_signature: world.canonical_signature_digest()?.words,
+            staged_world_signature: staged.canonical_signature_digest()?.words,
+            body: body.id,
+            body_position: p,
+            body_yaw: yaw,
+            prop_ids_in_food_ball_order: props,
+            prop_positions_in_food_ball_order: berths,
+            measured_center_ranges_m: radii,
+            visible_world_order: [seen[0], seen[1]],
+            opening_grab_probe,
+            rear_edge_source,
+            rear_steady_source,
+            geometry_only: true,
+        },
+        world: staged,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use alife_core::{BiochemistryState, BrainCapacityClass, CreatureGenome, FoundationGeneticIdentity, LanguageTokenId};
+    use alife_world::{HeadlessScenarioBuilder, WorldEditorSpawnSpec, WorldOrganismRecord};
+
+    fn native_world() -> (HeadlessWorld, [WorldEntityId; 2]) {
+        let mut world = HeadlessScenarioBuilder::new(9811)
+            .agent("geometry-listener", OWNER, Vec3f::ZERO)
+            .food("real-food", Vec3f::new(1.8, 0.0, 0.5), 0.85)
+            .build().unwrap();
+        world.editor_spawn_object(WorldEditorSpawnSpec {
+            label: "real-ball".into(), kind: WorldObjectKind::Ball, organism_id: None,
+            position: Vec3f::new(1.9, 0.0, -0.5), nutrition: 0.0, hazard_pain: 0.0, radius: 0.30, token_id: None,
+        }).unwrap();
+        let body = world.entity_id("geometry-listener").unwrap();
+        let tick = world.tick();
+        let founder = FoundationGeneticIdentity::new(10, 1, 7, BrainCapacityClass::N512_ID).unwrap();
+        let genome = CreatureGenome::early_mammal_founder(0xE10_32A1, founder).unwrap();
+        let phenotype = genome.express().unwrap();
+        let biology = BiochemistryState::new(&phenotype, tick).unwrap();
+        world.register_organism_record(
+            WorldOrganismRecord::new(OWNER, body, genome, phenotype, biology, tick).unwrap()
+        ).unwrap();
+        let props = [world.entity_id("real-food").unwrap(), world.entity_id("real-ball").unwrap()];
+        (world, props)
+    }
+
+    #[test]
+    fn real_fixed_berths_cross_without_emitting_advancing_or_touching_resident() {
+        let (world, ids) = native_world();
+        let witness_before = world.canonical_signature_digest().unwrap();
+        let a = stage_geometry(&world, OWNER, FixtureLayoutV1::A, ids).unwrap();
+        let b = stage_geometry(&world, OWNER, FixtureLayoutV1::B, ids).unwrap();
+        assert_eq!(world.canonical_signature_digest().unwrap(), witness_before);
+        assert_eq!(a.witness.source_world_signature, b.witness.source_world_signature);
+        assert_eq!(a.witness.prop_positions_in_food_ball_order, [
+            b.witness.prop_positions_in_food_ball_order[1], b.witness.prop_positions_in_food_ball_order[0],
+        ]);
+        assert_eq!(a.witness.acoustic_points(), b.witness.acoustic_points());
+        assert_ne!(a.witness.staged_world_signature, b.witness.staged_world_signature);
+        assert!(build_fixed_fixture_v1(&world, OWNER, FixtureLayoutV1::A).is_err());
+        for s in [a, b] {
+            assert_eq!(s.world.tick(), world.tick());
+            assert_eq!(s.world.organism_registry().get(OWNER), world.organism_registry().get(OWNER));
+            assert!(s.world.audible_utterances().is_empty());
+            assert_eq!(s.witness.opening_grab_probe, [(false, false); 2]);
+            assert!(s.witness.measured_center_ranges_m.iter().all(|r|
+                (*r - 2.0 * MAX_ORDINARY_STEP) > GRAB_RADIUS
+            ));
+        }
+    }
+
+    #[test]
+    fn separate_test_only_native_emitter_can_use_both_points_without_movement() {
+        let (world, ids) = native_world();
+        let s = stage_geometry(&world, OWNER, FixtureLayoutV1::A, ids).unwrap();
+        let t = s.world.tick();
+        let (edge, steady) = s.witness.acoustic_points();
+        for point in [edge, steady] {
+            // This unit test calls the real speaker separately. The fixture
+            // never emits; the test does not choose actions or advance World.
+            let mut audible = s.world.clone();
+            let words = [9_u16, 14_u16].map(|x| LanguageTokenId::new(x).unwrap());
+            let atom = audible.emit_player_tokens(Some(OWNER), point, words.to_vec()).unwrap();
+            let actual = audible.sensory_report(OWNER, t).unwrap();
+            let tokens = actual.core_snapshot.language_context.heard_tokens.iter().flatten().collect::<Vec<_>>();
+            assert_eq!(tokens.iter().map(|x| x.token_id).collect::<Vec<_>>(), vec![9, 14]);
+            assert!(tokens.iter().all(|x| x.utterance_id == atom.utterance_id && x.confidence.raw() > 0.0));
+            assert_eq!(atom.expires_after_tick.raw(), t.raw() + 1);
+            assert_eq!(audible.tick(), t);
+            assert_eq!(audible.entity(s.witness.body), s.world.entity(s.witness.body));
+            assert_eq!(ids.map(|i| audible.retained_language_pilot_grab_probe(OWNER, i)), [(false, false); 2]);
+        }
+        assert!(s.world.audible_utterances().is_empty());
+    }
+
+    #[test]
+    fn impostor_prop_and_missing_actual_body_fail_before_placement() {
+        let (world, ids) = native_world();
+        let sig = world.canonical_signature_digest().unwrap();
+        assert!(stage_geometry(&world, OWNER, FixtureLayoutV1::A, [ids[1], ids[0]]).is_err());
+        assert!(stage_geometry(&world, OrganismId(4), FixtureLayoutV1::A, ids).is_err());
+        assert_eq!(world.canonical_signature_digest().unwrap(), sig);
+    }
+}
