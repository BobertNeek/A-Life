diff --git a/crates/alife_game_app/src/foundation_training_cycle/saved_life_retention/wsp_out_of_reach_fixture.rs b/crates/alife_game_app/src/foundation_training_cycle/saved_life_retention/wsp_out_of_reach_fixture.rs
