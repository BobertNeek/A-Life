@@ -0,0 +1,246 @@
+//! Optional, strictly observer-only shared geometry admission. Stock policy,
+//! sound producers, selector, saved weights and all legacy grammars are unchanged.
+use super::{digest, now, Result};
+use super::wsp_out_of_reach_fixture::{FixtureLayoutV1, GeometryWitnessV1, build_fixed_fixture_v1};
+use alife_core::{LanguageTokenId, OrganismId, PerceptionFrame, Tick, UtteranceSourceKind, Vec3f, WorldEntityId};
+use alife_world::{AudibleUtterance, HeadlessWorld};
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use std::{fs, io::Read, path::Path};
+
+pub(super) const SCHEMA: u16 = 16;
+pub(super) const CUTS: usize = 3;
+pub(super) const NONCE: u64 = 1794935016;
+const SCOPE: &str = "qualia.saved_life.wsp_crossed_out_of_reach_observer.v1";
+const CURRENT: &str = "55672f322eadc64e223289d9df9883f62d0cc01aa97c0478119ad6c51d2852ee";
+const FIXTURE: &str = "qualia.saved_life.wsp_crossed_out_of_reach_geometry.v1";
+const ADMISSION: &str = "wsp-crossed-out-of-reach-admission.v1.json";
+const GRANT: &str = "wsp-crossed-out-of-reach-independent-grant.v1.json";
+const OPEN: u64 = 3074;
+const OWNER: OrganismId = OrganismId(3);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+enum Stimulus {
+    RearEdgeGetBall, RearSteadyGetBall, Silent, RearEdgeGetOnly, RearEdgeGetFood,
+}
+impl Stimulus {
+    fn terms(self)-> &'static [u16] {
+        match self {
+            Self::RearEdgeGetBall | Self::RearSteadyGetBall => &[9, 14],
+            Self::Silent => &[],
+            Self::RearEdgeGetOnly => &[9],
+            Self::RearEdgeGetFood => &[9, 1],
+        }
+    }
+    fn edge(self) -> bool {
+        matches!(self, Self::RearEdgeGetBall | Self::RearEdgeGetOnly | Self::RearEdgeGetFood)
+    }
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope { schema: u16, scope: String, admission_sha256: String }
+#[derive(Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    scope: String, fixture: String, run_id: String,
+    source_current_sha256: String, evaluator_sha256: String,
+    layout: FixtureLayoutV1, stimulus: Stimulus, owner: u64,
+    max_decisions: u8, max_world_ticks: u8, applied_pressure_ns: u64,
+    deadline_unix_seconds: u64, finalization_deadline_unix_seconds: u64, expires_unix_seconds: u64,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Admission { schema: String, binding: Binding, independent_grant_sha256: String }
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Grant { schema: String, binding: Binding }
+#[derive(Serialize)]
+pub(super) struct Scope { schema: &'static str, binding: Binding, admission_sha256: String }
+
+fn hex(x: &str) -> bool { x.len()==64 && x.bytes().all(|b|matches!(b,b'0'..=b'9'|b'a'..=b'f')) }
+fn bounded(p: &Path, max: u64) -> Result<Vec<u8>> {
+    let mut raw=Vec::new();
+    fs::File::open(p)?.take(max+1).read_to_end(&mut raw)?;
+    if raw.is_empty() || raw.len() as u64>max { return Err("invalid crossed fixture file extent".into()); }
+    Ok(raw)
+}
+fn leaf(root: &Path, name: &str) -> Result<Vec<u8>> {
+    let p=root.join(name);
+    if p.canonicalize()?!=p || !fs::symlink_metadata(&p)?.is_file() {
+        return Err("crossed fixture requires canonical regular admission leaves".into());
+    }
+    bounded(&p, 8192)
+}
+
+pub(super) fn resolve(root: &Path, input: &[u8]) -> Result<Scope> {
+    if input.len()>8192 { return Err("crossed fixture envelope exceeds limit".into()); }
+    let e: Envelope=serde_json::from_slice(input)?;
+    if e.schema!=SCHEMA || e.scope!=SCOPE || !hex(&e.admission_sha256) {
+        return Err("unadmitted crossed fixture envelope".into());
+    }
+    // This observer is never an isolated lineage/archive request. Refuse
+    // before any permit/current/output restore or GPU/backend startup.
+    if std::env::var("ALIFE_EXPLICIT_RETENTION_ARCHIVE_TEST").is_ok_and(|v|v=="1") {
+        return Err("crossed fixture does not admit isolated archives".into());
+    }
+    let a=leaf(root,ADMISSION)?;
+    if digest(&a)!=e.admission_sha256 { return Err("crossed fixture permit digest changed".into()); }
+    let a: Admission=serde_json::from_slice(&a)?;
+    let b=a.binding;
+    let t=now()?;
+    if a.schema!="qualia.saved_life.wsp_crossed_out_of_reach.admission.v1"
+        || b.scope!=SCOPE || b.fixture!=FIXTURE || b.source_current_sha256!=CURRENT
+        || b.owner!=OWNER.raw() || !hex(&b.evaluator_sha256) || !hex(&a.independent_grant_sha256)
+        || b.run_id.is_empty() || b.run_id.len()>64
+        || !b.run_id.bytes().all(|c|c.is_ascii_alphanumeric()||matches!(c,b'_'|b'-'))
+        || usize::from(b.max_decisions)!=CUTS || usize::from(b.max_world_ticks)!=CUTS || b.applied_pressure_ns!=0
+        || b.deadline_unix_seconds<=t || b.deadline_unix_seconds>b.finalization_deadline_unix_seconds
+        || b.finalization_deadline_unix_seconds>b.deadline_unix_seconds.saturating_add(120)
+        || b.finalization_deadline_unix_seconds>b.expires_unix_seconds || b.expires_unix_seconds>t.saturating_add(600)
+    {
+        return Err("crossed fixture clock, source, layout authority or bounds refused".into());
+    }
+    let g=leaf(root,GRANT)?;
+    if digest(&g)!=a.independent_grant_sha256 { return Err("crossed fixture independent grant digest changed".into()); }
+    let g: Grant=serde_json::from_slice(&g)?;
+    if g.schema!="qualia.saved_life.wsp_crossed_out_of_reach.independent_grant.v1" || g.binding!=b {
+        return Err("crossed fixture grant did not bind this exact immutable opening".into());
+    }
+    for name in ["wsp-armed-admission.v1.json","cue-latch-admission.v1.json","contact211-f0-admission.v1.json",
+                 "contact211-rank32.weights.v1.json","wsp-approach-v2-admission.json"] {
+        match fs::symlink_metadata(root.join(name)) {
+            Err(x) if x.kind()==std::io::ErrorKind::NotFound=>(),
+            _=>return Err("legacy treatment or observer admission cannot share crossed fixture".into()),
+        }
+    }
+    if digest(&bounded(&std::env::current_exe()?,256*1024*1024)?)!=b.evaluator_sha256 {
+        return Err("crossed fixture running an unpinned evaluator".into());
+    }
+    Ok(Scope{schema:SCOPE,binding:b,admission_sha256:e.admission_sha256})
+}
+
+#[derive(Serialize)]
+pub(super) struct BearingCutV1 {
+    tick: Tick,
+    world_signature: [u64; 4],
+    listener: Vec3f,
+    props: [(Vec3f,Option<OrganismId>,bool,bool,bool); 2],
+    actual_grab_probe: [(bool, bool); 2],
+    native_live_player_atom: Option<AudibleUtterance>,
+}
+pub(super) struct Opened {
+    witness: GeometryWitnessV1,
+    stimulus: Stimulus,
+    atom: Option<AudibleUtterance>,
+}
+impl Scope {
+    pub(super) fn run_id(&self) -> &str { &self.binding.run_id }
+    pub(super) fn source_current(&self) -> &str { &self.binding.source_current_sha256 }
+    pub(super) fn decision_deadline(&self) -> u64 { self.binding.deadline_unix_seconds }
+    pub(super) fn finalization_deadline(&self) -> u64 { self.binding.finalization_deadline_unix_seconds }
+    pub(super) fn semantic(&self) -> Result<String> {
+        Ok(digest(&serde_json::to_vec(&(SCOPE,FIXTURE,self.binding.source_current_sha256.as_str(),
+            self.binding.layout,self.binding.stimulus,self.binding.owner,CUTS,self.binding.applied_pressure_ns))?))
+    }
+    pub(super) fn open(&self, world: &mut HeadlessWorld, owner: OrganismId) -> Result<(Opened,Value)> {
+        if owner!=OWNER || now()?>=self.binding.expires_unix_seconds { return Err("crossed fixture stale at opening".into()); }
+        let mut s=build_fixed_fixture_v1(world,owner,self.binding.layout)?;
+        let tick=s.world.tick();
+        let before=s.world.sensory_report(owner,tick)?;
+        let words=self.binding.stimulus.terms().iter().copied().map(LanguageTokenId::new).collect::<std::result::Result<Vec<_>,_>>()?;
+        let (rear_edge,rear_steady)=s.witness.acoustic_points();
+        let atom=if words.is_empty() {
+            None
+        } else {
+            let point=if self.binding.stimulus.edge() {rear_edge}else{rear_steady};
+            let a=s.world.emit_player_tokens(Some(owner),point,words)?;
+            if a.source_kind!=UtteranceSourceKind::Player || a.addressee!=Some(owner)
+                || a.source_position!=point || a.emitted_tick!=tick || a.expires_after_tick.raw()!=OPEN+1
+                || a.speaker_id.is_some() || a.teacher_channel.is_some() || a.confidence.raw()!=1.0
+                || s.world.audible_utterances().as_slice()!=std::slice::from_ref(&a) {
+                return Err("expected one authentic bounded native Player atom".into());
+            }
+            Some(a)
+        };
+        let after=s.world.sensory_report(owner,tick)?;
+        if s.world.tick()!=tick || s.world.organism_registry().get(owner)!=world.organism_registry().get(owner)
+            || s.world.entity(s.witness.body())!=world.entity(s.witness.body())
+            || before.visible_entities.iter().map(|x|x.id).ne(after.visible_entities.iter().map(|x|x.id))
+            || before.contact_entities!=after.contact_entities
+            || (atom.is_none() && (before.core_snapshot!=after.core_snapshot || !s.world.audible_utterances().is_empty())) {
+            return Err("crossed fixture emitted sound changed custody, pose, time or declared silence".into());
+        }
+        let setup=json!({"geometry":s.witness,"stimulus":self.binding.stimulus,"actual_native_player_atom":atom,
+            "before_sound_sha256":digest(&serde_json::to_vec(&before.core_snapshot)?),
+            "after_sound_sha256":digest(&serde_json::to_vec(&after.core_snapshot)?),
+            "scope":SCOPE,"actor_or_policy_modified":false,"scorecard_eligible":false});
+        *world=s.world;
+        Ok((Opened{witness:s.witness,stimulus:self.binding.stimulus,atom},setup))
+    }
+}
+
+impl Opened {
+    fn live_player(&self, world: &HeadlessWorld, tick: Tick) -> Result<Option<AudibleUtterance>> {
+        let matches=world.audible_utterances().into_iter().filter(|a|a.source_kind==UtteranceSourceKind::Player)
+            .collect::<Vec<_>>();
+        let expected=self.atom.as_ref().filter(|a|a.emitted_tick<=tick&&tick<=a.expires_after_tick);
+        if matches.as_slice()!=expected.map_or(&[][..],std::slice::from_ref) {
+            return Err("crossed fixture actual pre-World Player atom mismatch".into());
+        }
+        Ok(expected.cloned())
+    }
+    /// Capture actual World geometry at a real boundary, never turn a bound into a selector hint.
+    pub(super) fn cut(&self, world: &HeadlessWorld) -> Result<BearingCutV1> {
+        let tick=world.tick();
+        if !(OPEN..=OPEN+CUTS as u64).contains(&tick.raw()) { return Err("crossed fixture escaped bounded World ticks".into()); }
+        let ids=self.witness.prop_ids();
+        let positions=self.witness.prop_positions();
+        let mut actual=[(Vec3f::ZERO,None,false,false,false);2];
+        for (i,(id,p)) in ids.into_iter().zip(positions).enumerate() {
+            let o=world.entity(id).ok_or("crossed fixture lost real placed object")?;
+            let player=world.player_held_object()==Some(id);
+            if tick.raw()<=OPEN+2 && (o.position!=p || o.grounded_physical.velocity!=Vec3f::ZERO
+                || o.carried_by.is_some() || o.activity_hold || o.consumed || player) {
+                return Err("crossed fixture props did not remain stationary and free before expiry".into());
+            }
+            actual[i]=(o.position,o.carried_by,o.activity_hold,o.consumed,player);
+        }
+        let listener=world.entity(self.witness.body()).ok_or("crossed fixture lost resident body")?.position;
+        let grab=ids.map(|id|world.retained_language_pilot_grab_probe(OWNER,id));
+        if tick.raw()<=OPEN+2 && (grab!=[(false,false);2] || !self.witness.ordinary_pose_is_safe(listener,tick.raw()-OPEN)) {
+            return Err("crossed fixture reach appeared before true native expiry".into());
+        }
+        Ok(BearingCutV1{tick,world_signature:world.canonical_signature_digest()?.words,listener,props:actual,
+             actual_grab_probe:grab,native_live_player_atom:self.live_player(world,tick)?})
+    }
+    pub(super) fn observe(&self, frame: &PerceptionFrame, pre: BearingCutV1, world: &HeadlessWorld) -> Result<Value> {
+        let post=self.cut(world)?;
+        if frame.organism_id()!=OWNER || frame.tick()!=pre.tick || post.tick.raw()!=pre.tick.raw()+1
+            || frame.body().pose.translation!=pre.listener || !self.witness.ordinary_interval_is_safe(&pre.listener,&post.listener) {
+            return Err("crossed fixture native decision and World pose are not the same cut".into());
+        }
+        let lane=&frame.sensory().language_context.heard_tokens;
+        let lines=lane.iter().flatten().collect::<Vec<_>>();
+        let player=lines.iter().filter(|w|w.source_kind==UtteranceSourceKind::Player).copied().collect::<Vec<_>>();
+        let distance=self.atom.as_ref().map(|a|self.witness.center_range(pre.listener,a.source_position));
+        let full=pre.native_live_player_atom.as_ref().is_some_and(|a|
+            !player.is_empty()&&player.len()==a.tokens.len()&&player.iter().enumerate().all(|(i,x)|
+                x.utterance_id==a.utterance_id && x.sequence_position as usize==i
+                && x.token_id==u32::from(a.tokens[i].raw())&&x.confidence.raw()>0.0
+                && x.source_position==a.source_position && x.addressee==a.addressee
+                && x.speaker_id.is_none()&&x.source_entity.is_none()&&x.teacher_channel.is_none())
+        );
+        if pre.native_live_player_atom.is_none() && (!player.is_empty() || (self.atom.is_none()&&!lines.is_empty())) {
+            return Err("crossed fixture produced a Player cue under true absence".into());
+        }
+        let dropout=pre.tick.raw()==OPEN+1 && pre.native_live_player_atom.is_some() && lines.is_empty()
+            && distance.is_some_and(|d|d>6.0);
+        Ok(json!({"schema":SCOPE,"declared_stimulus":self.stimulus,"pre_world":pre,"settled_world":post,"frame":frame.frame_digest(),
+            "actual_sealed_hearing":lane,"measured_acoustic_range_m":distance,"genuine_fully_heard":full,
+            "true_physical_dropout_before_expiry":dropout,"actual_emitted_atom_expired":self.atom.as_ref().is_some_and(|a|
+                frame.tick()>a.expires_after_tick&&pre.native_live_player_atom.is_none()),
+            "never_emitted_atom":self.atom.is_none(),"readback_only":true,"causal_carry_or_movement_credit":false,
+            "scorecard_eligible":false}))
+    }
+}
